_size(256)","fn main(@builtin(workgroup_id) workgroupId: vec3u, @builtin(local_invocation_index) localInvocationIndex: u32) {","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= ELEMENT_COUNT) { return; }","  ranks[index] = 0xffffffffu;","  ids[index] = FIRST_SOURCE_INDEX + index;","}","@group(0) @binding(0) var<storage, read_write> cellCounts: array<u32>;","@group(0) @binding(1) var<storage, read_write> cellCursors: array<u32>;","  cellCounts[index] = 0u;","  cellCursors[index] = 0u;","override POSITIONS_OFFSET: u32;","override WIDTH: u32;","override HEIGHT: u32;","override DEPTH: u32;","override BOUNDS_MINIMUM_0: f32;","override BOUNDS_MAXIMUM_0: f32;","override BOUNDS_MINIMUM_1: f32;","override BOUNDS_MAXIMUM_1: f32;","override CELL_START: u32;","override CELL_LENGTH: u32;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","@group(0) @binding(1) var<storage, read_write> cellCounts: array<atomic<u32>>;","fn isFiniteGridValue(value: f32) -> bool {","  return value == value && abs(value) <= 3.402823466e+38;","// The scaled cross-zero branch avoids overflowing maximum - minimum for valid float32 bounds.","fn getGridCoordinate(value: f32, minimum: f32, maximum: f32, size: u32) -> u32 {","  if (maximum == minimum || value == minimum) { return 0u; }","  if (value == maximum) { return size - 1u; }","  if (minimum < 0.0 && maximum > 0.0) {","    let scale = max(abs(minimum), abs(maximum));","    let scaledValue = value / scale;","    let scaledMinimum = minimum / scale;","    let scaledMaximum = maximum / scale;","    return min(","      u32((scaledValue - scaledMinimum) / (scaledMaximum - scaledMinimum) * f32(size)),","      size - 1u","    );","  }","  return min(u32((value - minimum) / (maximum - minimum) * f32(size)), size - 1u);","  var accepted = false;","  var cellIndex = 0u;","  if (index < ELEMENT_COUNT) {","    let x = positions[POSITIONS_OFFSET + index * 2u];","    let y = positions[POSITIONS_OFFSET + index * 2u + 1u];","    let finiteZ = true;","    let inZ = true;","    let finiteXY = x == x && y == y && abs(x) <= 3.402823466e+38 && abs(y) <= 3.402823466e+38;","    let inX = x >= BOUNDS_MINIMUM_0 && x <= BOUNDS_MAXIMUM_0;","    let inY = y >= BOUNDS_MINIMUM_1 && y <= BOUNDS_MAXIMUM_1;","    if (finiteXY && finiteZ && inX && inY && inZ) {","      accepted = true;","      let column = getGridCoordinate(x, BOUNDS_MINIMUM_0, BOUNDS_MAXIMUM_0, WIDTH);","      let row = getGridCoordinate(y, BOUNDS_MINIMUM_1, BOUNDS_MAXIMUM_1, HEIGHT);","      let layer = 0u;","      cellIndex = (layer * HEIGHT + row) * WIDTH + column;","    }","  ","  if (accepted && cellIndex >= CELL_START && cellIndex - CELL_START < CELL_LENGTH) {","    atomicAdd(&cellCounts[cellIndex - CELL_START], 1u);","enable subgroups;","requires subgroup_id;","override BLOCK_COUNT: u32;","override INPUT_OFFSET: u32;","override OUTPUT_OFFSET: u32;","override SUM_OFFSET: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sumValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let index = workgroupIndex * 256u + lane;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  var inputValue = 0u;","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = blockPrefix;","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","    ","override OFFSETS_OFFSET: u32;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","  @builtin(local_invocation_index) localInvocationIndex: u32,","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];","override LAST_COUNT_INDEX: u32;","override LAST_OFFSET_INDEX: u32;","override COUNT_OFFSET: u32;","override OVERFLOW_OFFSET: u32;","override OBJECT_CAPACITY: u32;","@group(0) @binding(0) var<storage, read> counts: array<u32>;","@group(0) @binding(2) var<storage, read_write> count: array<u32>;","@group(0) @binding(3) var<storage, read_write> overflow: array<u32>;","@compute @workgroup_size(1)","fn main() {","  let total = counts[LAST_COUNT_INDEX] + offsets[LAST_OFFSET_INDEX];","  count[COUNT_OFFSET] = total;","  overflow[OVERFLOW_OFFSET] = select(0u, 1u, total > OBJECT_CAPACITY);","override TERMINAL_OFFSET: u32;","@group(0) @binding(0) var<storage, read> count: array<u32>;","@group(0) @binding(1) var<storage, read_write> terminal: array<u32>;","  terminal[TERMINAL_OFFSET] = count[COUNT_OFFSET];","override CELL_OFFSETS_OFFSET: u32;","@group(0) @binding(1) var<storage, read> cellOffsets: array<u32>;","@group(0) @binding(2) var<storage, read_write> cellCursors: array<atomic<u32>>;","@group(0) @binding(3) var<storage, read_write> ranks: array<u32>;","    let cell = cellIndex - CELL_START;","    ranks[index] = cellOffsets[CELL_OFFSETS_OFFSET + cell] + atomicAdd(&cellCursors[cell], 1u);","override INDEX_COUNT: u32;","override OUTPUT_LENGTH: u32;","override OUTPUT_START: u32;","override WORDS_PER_ROW: u32;","override SOURCE_OFFSET: u32;","override INDEX_OFFSET: u32;","@group(0) @binding(0) var<storage, read> sourceWords: array<u32>;","@group(0) @binding(1) var<storage, read> indices: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputWords: array<u32>;","fn main(","  @builtin(workgroup_id) workgroupId: vec3u,","  @builtin(local_invocation_index) localInvocationIndex: u32","  if (index >= INDEX_COUNT) { return; }","  let destinationIndex = indices[INDEX_OFFSET + index];","  if (destinationIndex < OUTPUT_START || destinationIndex - OUTPUT_START >= OUTPUT_LENGTH) { return; }","  let sourceBase = SOURCE_OFFSET + index * WORDS_PER_ROW;","  let outputBase = OUTPUT_OFFSET + (destinationIndex - OUTPUT_START) * WORDS_PER_ROW;","  for (var word = 0u; word < WORDS_PER_ROW; word++) {","    outputWords[outputBase + word] = sourceWords[sourceBase + word];"],"strings":["cellOffsets","GPUGridIndex","station-grid-counts-chunk-0","read_write","buffer","read","station-grid-ranks-0","compute","station-grid","station-grid-finalize","stations","station-grid-rank-0-0","station-grid-cursors-chunk-0","station-grid-scatter-0","indexedCount","station-grid-ids-0","station-grid-terminal","station-grid-count-0-0","station-grid-initialize-0","station-grid-initialize-ranks-0","station-grid-scan-level-0-add-offsets","station-grid-scan-level-0-block-offsets","station-grid-scan-level-0-block-sums","station-grid-scan-level-0-scan","transient","imported","overflow","station-grid-scan-level-1-scan","stationPositions","level-scan","stationIds","GPUScan","count","gpu-core.scan","outputValues","scan-level","station-grid-scan/levels","unconditional","write","add-offsets","cellCounts","cellCursors","float32x2","inputVa