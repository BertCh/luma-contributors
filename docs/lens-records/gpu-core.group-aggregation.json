ndex], 1u); }","  if (lane < GROUP_COUNT) {","    atomicAdd(&outputCounts[OUTPUT_OFFSET + lane], atomicLoad(&localCounts[lane]));","override VALUES_OFFSET: u32;","override VALUES_STRIDE: u32;","@group(0) @binding(1) var<storage, read> inputValues: array<f32>;","@group(0) @binding(2) var<storage, read_write> outputValues: array<atomic<u32>>;","fn atomicAddFloat(destination: ptr<storage, atomic<u32>, read_write>, value: f32) {","  var oldBits = atomicLoad(destination);","  loop {","    let newBits = bitcast<u32>(bitcast<f32>(oldBits) + value);","    let result = atomicCompareExchangeWeak(destination, oldBits, newBits);","    if (result.exchanged) { break; }","    oldBits = result.old_value;","  var value = 0.0;","    value = inputValues[VALUES_OFFSET + index * VALUES_STRIDE];","    let finiteValue = value == value && abs(value) <= 3.402823466e+38;","    accepted = groupIndex < GROUP_COUNT && finiteValue;","  if (accepted) {","    atomicAddFloat(&outputValues[OUTPUT_OFFSET + groupIndex], value);","@group(0) @binding(3) var<storage, read_write> outputCounts: array<atomic<u32>>;","    atomicAdd(&outputCounts[COUNTS_OFFSET + groupIndex], 1u);","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> outputCounts: array<u32>;","    let count = outputCounts[COUNTS_OFFSET + index];","    if (count == 0u) {","      outputValues[OUTPUT_OFFSET + index] = 0x7fc00000u;","    } else {","      let sum = bitcast<f32>(outputValues[OUTPUT_OFFSET + index]);","      outputValues[OUTPUT_OFFSET + index] = bitcast<u32>(sum / f32(count));","    }"],"strings":["GPUGroupAggregation","rainMeans","means-counts","means-mean","compute","rainTotals","stationCounts","stationState","stations","buffer","means-finalize","means-initialize","read","counts-local","imported","outputCounts","outputValues","rainfall","read_write","totals-sum","counts-clear","gpu-core.group-aggregation","totals-clear","write","groupKeys","means","counts","inputValue