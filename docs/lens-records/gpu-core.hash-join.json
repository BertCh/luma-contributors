oding":{"sourceLines":["","override CAPACITY: u32;","override TABLE_KEYS_OFFSET: u32;","override TABLE_VALUES_OFFSET: u32;","override SOURCE_ROWS_OFFSET: u32;","override STATISTICS_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read_write> tableKeys: array<u32>;","@group(0) @binding(1) var<storage, read_write> tableValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sourceRows: array<u32>;","@group(0) @binding(3) var<storage, read_write> statistics: array<u32>;","@compute @workgroup_size(256) fn main(","  @builtin(workgroup_id) workgroupId: vec3u,","  @builtin(local_invocation_index) localIndex: u32",") {","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  let elementIndex = workgroupIndex * 256u + localIndex;","  if (elementIndex < CAPACITY) {","    tableKeys[TABLE_KEYS_OFFSET + elementIndex] = 4294967295u;","    tableValues[TABLE_VALUES_OFFSET + elementIndex] = 4294967295u;","    sourceRows[SOURCE_ROWS_OFFSET + elementIndex] = 4294967295u;","  }","  if (elementIndex < 6u) {","    statistics[STATISTICS_OFFSET + elementIndex] = 0u;","}","@group(0) @binding(0) var<storage, read_write> statistics: array<u32>;","  @builtin(global_invocation_id) globalId: vec3u","  if (globalId.x < 4u) {","    statistics[STATISTICS_OFFSET + globalId.x] = 0u;","override ELEMENT_COUNT: u32;","override CAPACITY_MASK: u32;","override MAX_PROBES: u32;","override KEYS_OFFSET: u32;","override FIRST_SOURCE_ROW: u32;","@group(0) @binding(0) var<storage, read> inputKeys: array<u32>;","@group(0) @binding(1) var<storage, read_write> tableKeys: array<atomic<u32>>;","@group(0) @binding(2) var<storage, read_write> sourceRows: array<atomic<u32>>;","@group(0) @binding(3) var<storage, read_write> statistics: array<atomic<u32>>;","fn hashUint32(value: u32) -> u32 {","  var x = value;","  x = x ^ (x >> 16u);","  x = x * 0x7feb352du;","  x = x ^ (x >> 15u);","  x = x * 0x846ca68bu;","  return x;","  let inputIndex = workgroupIndex * 256u + localIndex;","  if (inputIndex >= ELEMENT_COUNT) { return; }","  ","  let key = inputKeys[KEYS_OFFSET + inputIndex];","  if (key == 4294967295u) {","    atomicAdd(&statistics[STATISTICS_OFFSET + 3u], 1u);","    return;","  let start = hashUint32(key) & CAPACITY_MASK;","  var probes = 0u;","  var inserted = false;","  var duplicate = false;","  for (var probe = 0u; probe < MAX_PROBES; probe++) {","    probes = probe + 1u;","    let slot = (start + probe) & CAPACITY_MASK;","    var result = atomicCompareExchangeWeak(","      &tableKeys[TABLE_KEYS_OFFSET + slot], 4294967295u, key","    );","    // Bound spurious weak-CAS retries without probing onward and risking a duplicate slot.","    var exchangeAttempt = 1u;","    while (","      !result.exchanged &&","      result.old_value == 4294967295u &&","      exchangeAttempt < 4u","    ) {","      result = atomicCompareExchangeWeak(","        &tableKeys[TABLE_KEYS_OFFSET + slot], 4294967295u, key","      );","      exchangeAttempt++;","    }","    if (!result.exchanged && result.old_value == 4294967295u) {","      break;","    if (result.exchanged || result.old_value == key) {","      atomicMin(&sourceRows[SOURCE_ROWS_OFFSET + slot], FIRST_SOURCE_ROW + inputIndex);","      inserted = result.exchanged;","      duplicate = !result.exchanged;","  atomicAdd(&statistics[STATISTICS_OFFSET + 4u], probes);","  atomicMax(&statistics[STATISTICS_OFFSET + 5u], probes);","  if (inserted) {","    atomicAdd(&statistics[STATISTICS_OFFSET], 1u);","  } else if (duplicate) {","    atomicAdd(&statistics[STATISTICS_OFFSET + 1u], 1u);","  } else {","    atomicAdd(&statistics[STATISTICS_OFFSET + 2u], 1u);","override SOURCE_ROW_COUNT: u32;","override FIRST_VALUE: u32;","@group(0) @binding(0) var<storage, read> tableKeys: array<u32>;","@group(0) @binding(1) var<storage, read> sourceRows: array<u32>;","@group(0) @binding(2) var<storage, read_write> tableValues: array<u32>;","  let slot = workgroupIndex * 256u + localIndex;","  if (slot >= CAPACITY || tableKeys[TABLE_KEYS_OFFSET + slot] == 4294967295u) { return; }","  let sourceRow = sourceRows[SOURCE_ROWS_OFFSET + slot];","  if (sourceRow < FIRST_SOURCE_ROW || sourceRow - FIRST_SOURCE_ROW >= SOURCE_ROW_COUNT) { return; }","  let localSourceRow = sourceRow - FIRST_SOURCE_ROW;","  tableValues[TABLE_VALUES_OFFSET + slot] = FIRST_VALUE + localSourceRow;","override VALUES_OFFSET: u32;","override FOUND_OFFSET: u32;","override PROBES_OFFSET: u32;","@group(0) @binding(0) var<storage, read> queryKeys: array<u32>;","@group(0) @binding(1) var<storage, read> tableKeys: array<u32>;","@group(0) @binding(2) var<storage, read> tableValues: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(4) var<storage, read_write> outputFound: array<u32>;","@group(0) @binding(5) var<storage, read_write> outputProbes: array<u32>;","@group(0) @binding(6) var<storage, read_write> statistics: array<atomic<u32>>;","  let queryIndex = workgroupIndex * 256u + localIndex;","  if (queryIndex >= ELEMENT_COUNT) { return; }","  let key = queryKeys[KEYS_OFFSET + queryIndex];","  var value = 4294967295u;","  var found = false;","  if (key != 4294967295u) {","    let start = hashUint32(key) & CAPACITY_MASK;","    for (var probe = 0u; probe < MAX_PROBES; probe++) {","      probes = probe + 1u;","      let slot = (start + probe) & CAPACITY_MASK;","      let storedKey = tableKeys[TABLE_KEYS_OFFSET + slot];","      if (storedKey == key) {","        value = tableValues[TABLE_VALUES_OFFSET + slot];","        found = true;","        break;","      }","      if (storedKey == 4294967295u) { break; }","  outputValues[VALUES_OFFSET + queryIndex] = value;","  outputFound[FOUND_OFFSET + queryIndex] = select(0u, 1u, found);","  outputProbes[PROBES_OFFSET + queryIndex] = probes;","  atomicAdd(&statistics[STATISTICS_OFFSET + select(1u, 0u, found)], 1u);","  atomicAdd(&statistics[STATISTICS_OFFSET + 2u], probes);","  atomicMax(&statistics[STATISTICS_OFFSET + 3u], probes);","enable subgroups;","requires subgroup_id;","override BLOCK_COUNT: u32;","override INPUT_OFFSET: u32;","override OUTPUT_OFFSET: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + lane;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    ","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","override OUTPUT_START: u32;","override OUTPUT_END: u32;","override MATCHED_ROWS_OFFSET: u32;","override OFFSETS_OFFSET: u32;","override OUTPUT_LEFT_OFFSET: u32;","override OUTPUT_RIGHT_OFFSET: u32;","override FIRST_LEFT_ROW: u32;","@group(0) @binding(0) var<storage, read> matchedRightRows: array<u32>;","@group(0) @binding(1) var<storage, read> found: array<u32>;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputLeftRows: array<u32>;","@group(0) @binding(4) var<storage, read_write> outputRightRows: array<u32>;","  let accepted = min(found[FOUND_OFFSET + inputIndex], 1u);","  let outputIndex = offsets[OFFSETS_OFFSET + inputIndex];","  if (accepted != 0u && outputIndex >= OUTPUT_START && outputIndex < OUTPUT_END) {","    outputLeftRows[OUTPUT_LEFT_OFFSET + outputIndex - OUTPUT_START] = FIRST_LEFT_ROW + inputIndex;","    outputRightRows[OUTPUT_RIGHT_OFFSET + outputIndex - OUTPUT_START] =","      matchedRightRows[MATCHED_ROWS_OFFSET + inputIndex];","override LAST_INDEX: u32;","override OUTPUT_CAPACITY: u32;","override COUNT_OFFSET: u32;","override OVERFLOW_OFFSET: u32;","@group(0) @binding(0) var<storage, read> found: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","@group(0) @binding(2) var<storage, read_write> count: array<u32>;","@group(0) @binding(3) var<storage, read_write> overflow: array<u32>;","@compute @workgroup_size(1) fn main() {","  let requiredCount = offsets[OFFSETS_OFFSET + LAST_INDEX] +","    min(found[FOUND_OFFSET + LAST_INDEX], 1u);","  count[COUNT_OFFSET] = requiredCount;","  overflow[OVERFLOW_OFFSET] = select(0u, 1u, requiredCount > OUTPUT_CAPACITY);","override INDEX_STATISTICS_OFFSET: u32;","@group(0) @binding(0) var<storage, read> indexStatistics: array<u32>;","@group(0) @binding(1) var<storage, read_write> overflow: array<u32>;","  if (indexStatistics[INDEX_STATISTICS_OFFSET + 2u] != 0u) {","    overflow[OVERFLOW_OFFSET] = 1u;"],"strings":["wet-join-lookup-span-0-lookup","tableKeys","buffer","write","read","tableValues","wet-join-found","indexStatistics","station-hash-batch-0-build","imported","station-hash-initialize","station-hash-source-rows","wet-join-count-only","wet-join-source-0-destination-0-scatter","compute","overflow","stations","wet-join-offsets","lookupStatistics","station-hash-batch-0-finalize","wet-