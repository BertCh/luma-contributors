u;","  var count = 0u;","  if (word > 0u) { count += countOneBits(mask.x); }","  if (word > 1u) { count += countOneBits(mask.y); }","  if (word > 2u) { count += countOneBits(mask.z); }","  let lowerBits = (1u << bit) - 1u;","  return count + countOneBits(mask[word] & lowerBits);","  @builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32","  let lane = localInvocationIndex;","  let minimum: f32 = DOMAIN_MINIMUM;","  let maximum: f32 = DOMAIN_MAXIMUM;","  if (lane < BIN_COUNT) { atomicStore(&localCounts[lane], 0u); }","  workgroupBarrier();","  var accepted = false;","  var binIndex = 0u;","  if (index < ELEMENT_COUNT && maximum >= minimum) {","    let value = inputValues[INPUT_OFFSET + index * INPUT_STRIDE];","    if (value == value && abs(value) <= 3.402823466e+38 && value >= minimum && value <= maximum) {","      if (maximum == minimum) {","        accepted = value == minimum;","      } else {","        accepted = true;","        if (value == maximum) {","          binIndex = BIN_COUNT - 1u;","        } else {","          let ratio = (value - minimum) / (maximum - minimum);","          binIndex = min(u32(ratio * f32(BIN_COUNT)), BIN_COUNT - 1u);","          let width = (maximum - minimum) / f32(BIN_COUNT);","          // Subtraction can erase which side of an edge value occupies: for [-1, 8],","          // nextDown(1) - (-1) rounds to 2. Compare the original value against the","          // interval edges, not the rounded difference. Usually no correction is needed.","          if (width > 0.0 && (bitcast<u32>(width) & 0x7f800000u) != 0x7f800000u) {","            var lower = binIndex;","            var upper = binIndex + 1u;","            if (value < minimum + f32(binIndex) * width) {","              lower = 0u;","              upper = binIndex;","            } else if (binIndex + 1u < BIN_COUNT && value >= minimum + f32(binIndex + 1u) * width) {","              lower = binIndex + 1u;","              upper = BIN_COUNT;","            }","            // Binary correction bounds the work even when adjacent f32 edges coincide.","            while (lower + 1u < upper) {","              let middle = lower + (upper - lower) / 2u;","              if (value < minimum + f32(middle) * width) {","                upper = middle;","              } else {","                lower = middle;","              }","            binIndex = lower;","          }","        }","      }","    }","  }","  ","  var subgroupPending = accepted;","  for (var subgroupGroup = 0u; subgroupGroup < BIN_COUNT; subgroupGroup++) {","    let pendingBallot = subgroupBallot(subgroupPending);","    let hasPending = any(pendingBallot != vec4<u32>(0u));","    let leaderInvocation = getFirstBallotLane(pendingBallot);","    let leaderKey = subgroupShuffle(binIndex, leaderInvocation);","    let matchingKey = hasPending && subgroupPending && binIndex == leaderKey;","    let matchingBallot = subgroupBallot(matchingKey);","    if (hasPending && subgroupInvocationId == leaderInvocation) {","      atomicAdd(&localCounts[leaderKey], getBallotLaneCount(matchingBallot));","    subgroupPending = subgroupPending && !matchingKey;","  if (lane < BIN_COUNT) {","    atomicAdd(&outputCounts[OUTPUT_OFFSET + lane], atomicLoad(&localCounts[lane]));"],"strings":["stationsPerBin","rainfall-histogram-local","GPUHistogram","rainfall-histogram-clear","rainfall","buffer","compute","imported","outputCounts","rainfall-histogram","stations"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","datum","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["keySpace"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","datum","formula","source","workgroup