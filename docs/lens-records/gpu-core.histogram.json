r; float uses f32 arithmetic.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"counts","role":"output","binding":"wgsl:outputCounts"},{"id":"mask","role":"input","binding":"wgsl:selectionMask"},{"id":"edges","role":"parameter","binding":"wgsl:edgeValues"}],"derivation":"curated"}],"sources":[{"id":"wgsl:d3c5a514","language":"wgsl","moduleId":"GPUHistogram/clear","hash":"d3c5a514","entryPoint":"main","constants":{"BIN_COUNT":16,"OUTPUT_OFFSET":0,"DISPATCH_X":1,"DISPATCH_Y":1},"textLines":[[0,15]]},{"id":"wgsl:a22621d1","language":"wgsl","moduleId":"GPUHistogram/accumulate/local","hash":"a22621d1","entryPoint":"main","constants":{"ELEMENT_COUNT":1024,"BIN_COUNT":16,"MULTIPLIER_BIT_COUNT":5,"INPUT_OFFSET":0,"INPUT_STRIDE":1,"OUTPUT_OFFSET":0,"DOMAIN_MINIMUM":0,"DOMAIN_MAXIMUM":320,"DISPATCH_X":4,"DISPATCH_Y":1},"textLines":[0,[15,2],1,[17,3],2,[20,2],[3,2],[22,3],0,0,[25,6],14,0,[31,3],14,0,[34,9],14,0,[6,2],[43,2],[9,4],[45,41],77,[86,17],90,103,91,49,[104,2],91,14]}]},"decisions":[],"choices":[],"captures":{"schema":"luma.computation-captures/1","runId":"run-732bbc24","snapshots":[{"id":"gpu-core-histogram-snapshots-rainfall-0","name":"rainfall","iteration":0,"elementType":"f32","values":"b64:MzMTQDMz80AzM+NAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEBAMzOTQDMzjkLNzCxCMzOmQg==","provenance":"gpu-readback","graph":"gpu-core-histogram-compiled","resource":"rainfall","afterNode":"rainfall-histogram-local","role":"input","keySpace":"stations"},{"id":"gpu-core-histogram-snapshots-stationsPerBin-0","name":"stationsPerBin","iteration":0,"elementType":"u32","values":"b64:RAIAAJQAAABJAAAAMQAAAB8AAAAiAAAAHwAAABsAAAARAAAAEgAAAAUAAAACAAAAAwAAAAMAAAABAAAAAgAAAA==","provenance":"gpu-readback","graph":"gpu-core-histogram-compiled","resource":"stationsPerBin","afterNode":"rainfall-histogram-local","role":"output","keySpace":"bins","meaning":"bars edges:0,20,40,60,80,100,120,140,160,180,200,220,240,260,280,300,320","highlight":{"key":0,"label":"modal bin 0