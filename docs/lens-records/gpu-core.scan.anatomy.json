0,0,0,0,0,0]}]}]},"encoding":{"sourceLines":["","override ELEMENT_COUNT: u32;","override OUTPUT_OFFSET: u32;","override INPUT_0_OFFSET: u32;","override INPUT_1_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read> input0: array<u32>;","@group(0) @binding(1) var<storage, read> input1: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputMask: array<u32>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= ELEMENT_COUNT) {","    return;","  }","  outputMask[OUTPUT_OFFSET + index] = select(0u, 1u, (input0[INPUT_0_OFFSET + index] != 0u) && (input1[INPUT_1_OFFSET + index] != 0u));","}","enable subgroups;","requires subgroup_id;","override BLOCK_COUNT: u32;","override INPUT_OFFSET: u32;","override SUM_OFFSET: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sumValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let index = workgroupIndex * 256u + lane;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = min(inputValues[INPUT_OFFSET + index], 1u);","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","    }","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = blockPrefix;","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","override VALUES_PER_ROW: u32;","override WORKGROUP_COUNT: u32;","override VALIDITY_OFFSET: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<f32>;","@group(0) @binding(1) var<storage, read> inputValidity: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputValues: array<f32>;","var<workgroup> firstScratch: array<f32, 256>;","var<workgroup> secondScratch: array<f32, 256>;","var<workgroup> validityScratch: array<u32, 256>;","  if (workgroupIndex >= WORKGROUP_COUNT) {","  ","  let lane = localInvocationIndex;","  var value = 0.0;","  var secondValue = 0.0;","  var valid = 0u;","    if (inputValidity[VALIDITY_OFFSET + index] != 0u) {","      value = inputValues[INPUT_OFFSET + index];","    secondValue = value;","    valid = select(0u, 1u, value == value && abs(value) <= 3.402823466e+38);","    if (valid == 0u) { value = 0.0; secondValue = 0.0; }","  let subgroupValid = subgroupMax(valid);","  let subgroupFirst = subgroupAdd(value);","  let subgroupSecond = subgroupAdd(secondValue);","  if (subgroupInvocationId == 0u) {","    firstScratch[subgroupId] = subgroupFirst;","    secondScratch[subgroupId] = subgroupSecond;","    validityScratch[subgroupId] = subgroupValid;","  if (subgroupCount > 1u) {","    var stride = subgroupCount / 2u;","    loop {","      if (lane < stride) {","        firstScratch[lane] = firstScratch[lane] + firstScratch[lane + stride];","      }","      workgroupBarrier();","      if (stride == 1u) { break; }","      stride = stride / 2u;","    outputValues[OUTPUT_OFFSET + workgroupIndex * VALUES_PER_ROW] = firstScratch[0];","    ","    inputValue = inputValues[INPUT_OFFSET + index];","    sumValues[SUM_OFFSET] = blockPrefix;","@group(0) @binding(1) var<storage, read_write> outputValues: array<f32>;","    value = inputValues[INPUT_OFFSET + index * VALUES_PER_ROW];","    secondValue = inputValues[INPUT_OFFSET + index * VALUES_PER_ROW + 0u];","    valid = 1u;","override OFFSETS_OFFSET: u32;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];","@compute @workgroup_size(1) fn main() {","  outputValues[OUTPUT_OFFSET + 0u] = inputValues[INPUT_OFFSET + 0u];","override FLAGS_OFFSET: u32;","override OUTPUT_START: u32;","override OUTPUT_END: u32;","@group(0) @binding(1) var<storage, read> flags: array<u32>;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","  if (index >= ELEMENT_COUNT) { return; }","  let flag = min(flags[FLAGS_OFFSET + index], 1u);","  let outputIndex = offsets[OFFSETS_OFFSET + index];","  if (flag != 0u && outputIndex >= OUTPUT_START && outputIndex < OUTPUT_END) {","    outputValues[OUTPUT_OFFSET + outputIndex - OUTPUT_START] = inputValues[INPUT_OFFSET + index];"],"strings":["buffer","heavyRainHighStations","read","gpu-mask","gpu-compaction-offsets","gpu-compaction-scatter","write","compute","stations","gpu-compaction-scan-level-1-scan","imported","outputValues","GPUScan","gpu-compaction-scan-level-0-block-offsets","gpu-compaction-scan-level-0-block-sums","gpu-compaction-scan-level-0-scan","gpu-reduction-finalize","gpu-reduction-level-0","gpu-reduc