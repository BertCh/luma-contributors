sourceLines":["","enable subgroups;","requires subgroup_id;","override ELEMENT_COUNT: u32;","override BLOCK_COUNT: u32;","override INPUT_OFFSET: u32;","override OUTPUT_OFFSET: u32;","override SUM_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sumValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + lane;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  }","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","    }","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = blockPrefix;","    outputValues[OUTPUT_OFFSET + index] = blockPrefix;","}","    ","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","override OFFSETS_OFFSET: u32;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","  @builtin(local_invocation_index) localInvocationIndex: u32,","  let index = workgroupIndex * 256u + localInvocationIndex;","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];"],"strings":["rainTotals","rainfall-scan-level-0-scan","GPUScan","rainfall-scan-level-0-block-offsets","rainfall-scan-level-0-block-sums","rainfall-scan-level-0-add-offsets","rainfall-scan-level-1-scan","buffer","level-scan","compute","gpu-core.scan","outputValues","rainfall","rainfall-scan","rainfall-scan/levels","read","stations","unconditional","write","add-offsets","imported","inputValues","subgroups","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","datum","loop","dedupName","formula","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["keySpace"],["id","iteration","phase","maximumIterations"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[["~:2","~g"],["~:3","~e",0,"~h",2],["~:5",[4,1,1],1024,false]]}}
