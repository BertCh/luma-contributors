e];","    }","    workgroupBarrier();","      scratch[lane] = select(addend + scratch[lane], scratch[lane], segmentScratch[lane] != 0u);","      segmentScratch[lane] = addendSegment | segmentScratch[lane];","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = scratch[255u];","    summarySegmentFlags[SUMMARY_SEGMENT_FLAGS_OFFSET + workgroupIndex] = segmentScratch[255u];","    outputValues[OUTPUT_OFFSET + index] = scratch[lane];","    segmentPrefixes[SEGMENT_PREFIXES_OFFSET + index] = segmentScratch[lane];","}","@group(0) @binding(2) var<storage, read> segmentFlags: array<u32>;","@group(0) @binding(3) var<storage, read_write> segmentPrefixes: array<u32>;","    ","    var scannedOutput = 0u;","    if (lane > 0u) {","      scannedOutput = scratch[lane - 1u];","    outputValues[OUTPUT_OFFSET + index] = scannedOutput;","    var segmentPrefix = 0u;","      segmentPrefix = segmentScratch[lane - 1u];","    segmentPrefixes[SEGMENT_PREFIXES_OFFSET + index] = segmentPrefix;","override OFFSETS_OFFSET: u32;","override OFFSET_SEGMENT_PREFIXES_OFFSET: u32;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","@group(0) @binding(2) var<storage, read_write> segmentPrefixes: array<u32>;","@group(0) @binding(3) var<storage, read> offsetSegmentPrefixes: array<u32>;","    let offsetSegmentPrefix = offsetSegmentPrefixes[OFFSET_SEGMENT_PREFIXES_OFFSET + index / 256u];","    let segmentPrefix = segmentPrefixes[SEGMENT_PREFIXES_OFFSET + index];","    if (segmentPrefix == 0u) {","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];","    segmentPrefixes[SEGMENT_PREFIXES_OFFSET + index] = segmentPrefix | offsetSegmentPrefix;"],"strings":["rainfall-scan-level-0-scan","rainfall-scan-level-0-add-offsets","rainfall-scan-level-1-scan","buffer","rainTotals","rainfall-scan-level-0-segment-prefixes","GPUScan","rainfall-scan-level-0