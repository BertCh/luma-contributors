roupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  countsOffset = getChunkParameter(4u);","  counts[countsOffset + index] = 0u;","}","@group(0) @binding(0) var<storage, read> valuesX: array<f32>;","var<private> valuesXOffset: u32;","@group(0) @binding(1) var<storage, read> valuesY: array<f32>;","var<private> valuesYOffset: u32;","@group(0) @binding(2) var<storage, read> breaksX: array<f32>;","var<private> breaksXOffset: u32;","@group(0) @binding(3) var<storage, read> breaksY: array<f32>;","var<private> breaksYOffset: u32;","@group(0) @binding(4) var<storage, read> params: array<f32>;","var<private> paramsOffset: u32;","@group(0) @binding(5) var<storage, read_write> classes: array<u32>;","var<private> classesOffset: u32;","@group(0) @binding(6) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","const MAXIMUM_CLASS_COUNT: u32 = 3u;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn isNanBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u;","fn getOrderedKey(x: f32) -> u32 {","  let bits = bitcast<u32>(x);","  return select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","fn decodeOrderedKey(key: u32) -> f32 {","  return bitcast<f32>(select(~key, key ^ 0x80000000u, (key & 0x80000000u) != 0u));","const NO_CLASS: u32 = 0xffffffffu;","// -0 and +0 compare equal, like d3 bisectRight. The zero test is on bits because a compiler may","// fold a float select on `x == 0.0` back to `x`.","fn getComparisonKey(x: f32) -> u32 {","  if ((bits & 0x7fffffffu) == 0u) {","    return 0x80000000u;","  }","fn signedPower(x: f32, exponent: f32) -> f32 {","  let magnitude = abs(x);","  if (magnitude == 0.0) {","    return 0.0;","  let result = pow(magnitude, exponent);","  return select(result, -result, x < 0.0);","// Scale transform before normalisation. Codes: 0 linear, 1 sqrt, 2 pow, 3 log, 4 symlog.","fn transformValue(x: f32, scale: u32, exponent: f32, logFloor: f32) -> f32 {","  if (scale == 1u) {","    let magnitude = sqrt(abs(x));","    return select(magnitude, -magnitude, x < 0.0);","  if (scale == 2u) {","    return signedPower(x, exponent);","  if (scale == 3u) {","    var positive = x;","    if (!(positive > 0.0)) {","      positive = logFloor;","    }","    if (isNanBits(positive) || !(positive > 0.0)) {","      return getNaN();","    return log(positive);","  if (scale == 4u) {","    let magnitude = log(1.0 + abs(x));","  return x;","// Explicit native log mode keeps the legacy positive-floor transform unchanged.","fn transformColorValue(x: f32, scale: u32, exponent: f32, logFloor: f32, negativeLog: bool) -> f32 {","  if (scale == 9u) {","    if ((bitcast<u32>(x) & 0x7f800000u) == 0x7f800000u || x == 0.0 || (x < 0.0) != negativeLog) {","    return select(log(abs(x)), -log(abs(x)), negativeLog);","  return transformValue(x, scale, exponent, logFloor);","fn normalizeColorValue(value: f32, first: f32, last: f32) -> f32 {","  if (first == last && (bitcast<u32>(first) & 0x7f800000u) != 0x7f800000u) { return 0.5; }","  let magnitude = max(max(abs(first), abs(last)), abs(value));","  // Scale large finite values before subtracting: prevents f32 overflow and subnormal reciprocals.","  let normalization = select(1.0, 1e-20, magnitude > 1e19 && (bitcast<u32>(magnitude) & 0x7f800000u) != 0x7f800000u);","  return (value * normalization - first * normalization) / (last * normalization - first * normalization);","fn unpackChannel(color: u32, channel: u32) -> f32 {","  return f32((color >> (channel * 8u)) & 0xffu);","fn packChannel(value: f32) -> u32 {","  return u32(clamp(floor(value + 0.5), 0.0, 255.0));","fn blendColors(first: u32, second: u32, fraction: f32) -> u32 {","  var result = 0u;","  for (var channel = 0u; channel < 4u; channel++) {","    let a = unpackChannel(first, channel);","    let b = unpackChannel(second, channel);","    result = result | (packChannel(a + (b - a) * fraction) << (channel * 8u));","  return result;","// Number of inner edges edges[1 .. classCount - 1] that are <= value, as a u32 key comparison.","fn getAxisClass(valueKey: u32, classCount: u32, isX: bool) -> u32 {","  var low = 1u;","  var high = classCount;","  while (low < high) {","    let middle = (low + high) / 2u;","    var edge = 0.0;","    if (isX) {","      edge = breaksX[breaksXOffset + middle];","    } else {","      edge = breaksY[breaksYOffset + middle];","    if (getComparisonKey(edge) <= valueKey) {","      low = middle + 1u;","      high = middle;","  return low - 1u;","  valuesXOffset = getChunkParameter(4u);","  valuesYOffset = getChunkParameter(5u);","  breaksXOffset = getChunkParameter(6u);","  breaksYOffset = getChunkParameter(7u);","  paramsOffset = getChunkParameter(8u);","  classesOffset = getChunkParameter(9u);","  classes[classesOffset + index] = NO_CLASS;","  ","  let valueX = valuesX[valuesXOffset + index];","  let valueY = valuesY[valuesYOffset + index];","  let classCountX = min(u32(max(params[paramsOffset], 0.0)), MAXIMUM_CLASS_COUNT);","  let classCountY = min(u32(max(params[paramsOffset + 1u], 0.0)), MAXIMUM_CLASS_COUNT);","  if (isNanBits(valueX) || isNanBits(valueY) || classCountX == 0u || classCountY == 0u) {","    return;","  let classX = getAxisClass(getComparisonKey(valueX), classCountX, true);","  let classY = getAxisClass(getComparisonKey(valueY), classCountY, false);","  classes[classesOffset + index] = classY * classCountX + classX;","@group(0) @binding(0) var<storage, read> classes: array<u32>;","@group(0) @binding(1) var<storage, read> palette: array<u32>;","var<private> paletteOffset: u32;","@group(0) @binding(2) var<storage, read> params: array<f32>;","@group(0) @binding(3) var<storage, read_write> colors: array<u32>;","var<private> colorsOffset: u32;","@group(0) @binding(4) var<storage, read_write> counts: array<atomic<u32>>;","@group(0) @binding(5) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","  classesOffset = getChunkParameter(4u);","  paletteOffset = getChunkParameter(5u);","  paramsOffset = getChunkParameter(6u);","  colorsOffset = getChunkParameter(7u);","  countsOffset = getChunkParameter(8u);","  let classId = classes[classesOffset + index];","  let isValid = classId != NO_CLASS;","  if (isValid) {","    atomicAdd(&counts[countsOffset + classId], 1u);","  let noDataColor = u32(params[paramsOffset + 2u]) | (u32(params[paramsOffset + 3u]) << 16u);","  var color = noDataColor;","    color = palette[paletteOffset + classId];","    ","  colors[colorsOffset + index] = color;"],"strings":["bivariate-classification-classify","bivariate-classification-colorize","classCounts","gpu-dataframe-bivariate-classification-snapshot-tap","buffer","classIds","logical","read","colors","GPUBivariateClassification","imported","bivariate-parameters","bivariate-classification-init","breaksX","breaksY","palette","poverty150Pct","read_write","uninsuredPct","compute","transient","classes","counts","params"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],[],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTexture