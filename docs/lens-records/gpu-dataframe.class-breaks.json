bits, (bits & 0x80000000u) != 0u);","fn decodeOrderedKey(key: u32) -> f32 {","  return bitcast<f32>(select(~key, key ^ 0x80000000u, (key & 0x80000000u) != 0u));","  valuesOffset = getChunkParameter(4u);","  extremesOffset = getChunkParameter(5u);","  let value = values[valuesOffset + index];","  if (isNanBits(value) || !(true)) {","    return;","  atomicAdd(&extremes[extremesOffset + 2u], 1u);","  if ((bitcast<u32>(value) & 0x7f800000u) == 0x7f800000u) {","  let key = getOrderedKey(value);","  atomicAdd(&extremes[extremesOffset + 3u], 1u);","  atomicMin(&extremes[extremesOffset + 0u], key);","  atomicMax(&extremes[extremesOffset + 1u], key);","@group(0) @binding(0) var<storage, read_write> histogram: array<u32>;","var<private> histogramOffset: u32;","@group(0) @binding(1) var<storage, read> gate: array<u32>;","var<private> gateOffset: u32;","  histogramOffset = getChunkParameter(4u);","  gateOffset = getChunkParameter(5u);","  if (gate[gateOffset] == 1u) {","    histogram[histogramOffset + index] = 0u;","@group(0) @binding(1) var<storage, read> state: array<u32>;","@group(0) @binding(2) var<storage, read_write> histogram: array<atomic<u32>>;","@group(0) @binding(3) var<storage, read> gate: array<u32>;","struct ClassificationWorkgroupParameters { words: array<vec4<u32>, 16> }","@group(0) @binding(4) var<uniform> classificationParameters: ClassificationWorkgroupParameters;","fn getChunkParameter(word: u32) -> u32 { return classificationParameters.words[word / 4u][word % 4u]; }","const TARGET_COUNT: u32 = 8u;","const HEADER_LENGTH: u32 = 4u;","const STATE_PREFIX: u32 = 0u;","const STATE_RANK: u32 = 8u;","const STATE_SLOT: u32 = 16u;","const STATE_ACTIVE_PREFIX: u32 = 24u;","const STATE_ACTIVE_COUNT: u32 = 32u;","const STATE_VALID_COUNT: u32 = 33u;","fn isOrderStatisticProbability(p: f32) -> bool {","  // Ordered comparisons with NaN are false, but a compiler may fold them; test the bits.","  let bits = bitcast<u32>(p);","  if ((bits & 0x7f800000u) == 0x7f800000u) {","    return false;","  return p >= 0.0 && p <= 1.0;","fn getOrderStatisticKey(value: f32) -> u32 {","  var bits = bitcast<u32>(value);","  if ((bits & 0x7fffffffu) == 0u) {","    bits = 0u;","// Identity the compiler cannot fold: the bit operation on a runtime zero stops multiply-add","// fusion, so every f32 step rounds exactly like a Math.fround mirror.","fn roundOrderStatisticStep(value: f32, zero: u32) -> f32 {","  return bitcast<f32>(bitcast<u32>(value) | zero);","fn interpolateOrderStatistic(low: f32, high: f32, fraction: f32, zero: u32) -> f32 {","  if (fraction == 0.0 || low == high) {","    return low;","  let difference = roundOrderStatisticStep(high - low, zero);","  if ((bitcast<u32>(difference) & 0x7f800000u) != 0x7f800000u) {","    return low + roundOrderStatisticStep(difference * fraction, zero);","  // high - low overflowed; a convex combination of two finite values cannot.","  return roundOrderStatisticStep(low * (1.0 - fraction), zero) +","    roundOrderStatisticStep(high * fraction, zero);","fn getOrderStatisticMidpoint(low: f32, high: f32, zero: u32) -> f32 {","  if (low == high) {","  let sum = roundOrderStatisticStep(low + high, zero);","  if ((bitcast<u32>(sum) & 0x7f800000u) != 0x7f800000u) {","    return sum * 0.5;","  return roundOrderStatisticStep(low * 0.5, zero) + roundOrderStatisticStep(high * 0.5, zero);","fn isMissingValue(value: f32) -> bool {","  return (bitcast<u32>(value) & 0x7f800000u) == 0x7f800000u;","const LOCAL_SLOT_COUNT: u32 = 8u;","const LOCAL_BIN_COUNT: u32 = 2048u;","var<workgroup> localHistogram: array<atomic<u32>, 2048>;","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>, @builtin(num_workgroups) workgroupCount: vec3<u32>, @builtin(local_invocation_index) localInvocationIndex: u32) {","  if (workgroupIndex >= getChunkParameter(1u) / 256u) { return; }","stateOffset = getChunkParameter(5u);","histogramOffset = getChunkParameter(6u);","gateOffset = getChunkParameter(7u);","  _ = &values;","_ = &state;","_ = &histogram;","_ = &gate;","  for (var bin = localInvocationIndex; bin < LOCAL_BIN_COUNT; bin = bin + 256u) {","    atomicStore(&localHistogram[bin], 0u);","  workgroupBarrier();","  let isEnabled = gate[gateOffset] == 1u;","  if (isEnabled) {","    let phase = getChunkParameter(36u);","    let shift = 24u - 8u * phase;","    let activeCount = select(1u, state[stateOffset + STATE_ACTIVE_COUNT], phase > 0u);","    let rowCount = arrayLength(&values) - valuesOffset;","    for (var row = index; row < rowCount; row = row + getChunkParameter(1u)) {","      let value = values[valuesOffset + row];","      if (isMissingValue(value)) {","        continue;","      }","      ","      let key = getOrderStatisticKey(value);","      var slot = 0u;","      if (phase > 0u) {","        let prefixValue = key >> (shift + 8u);","        var low = 0u;","        var high = activeCount;","        while (low < high) {","          let middle = (low + high) / 2u;","          if (state[stateOffset + STATE_ACTIVE_PREFIX + middle] < prefixValue) { low = middle + 1u; }","          else { high = middle; }","        }","        if (low >= activeCount || state[stateOffset + STATE_ACTIVE_PREFIX + low] != prefixValue) { continue; }","        slot = low;","      let digit = (key >> shift) & 255u;","      if (slot < LOCAL_SLOT_COUNT) {","        atomicAdd(&localHistogram[slot * 256u + digit], 1u);","      } else {","        atomicAdd(&histogram[histogramOffset + slot * 256u + digit], 1u);","    for (var bin = localInvocationIndex; bin < LOCAL_BIN_COUNT; bin = bin + 256u) {","      let count = atomicLoad(&localHistogram[bin]);","      if (count != 0u && bin < 2048u) {","        atomicAdd(&histogram[histogramOffset + bin], count);","@group(0) @binding(2) var<storage, read> params: array<f32>;","// Round half to even; the fraction h - floor(h) is exact in f32.","fn roundHalfEven(h: f32) -> f32 {","  let whole = floor(h);","  let fraction = h - whole;","  if (fraction < 0.5) {","    return whole;","  if (fraction > 0.5) {","    return whole + 1.0;","  return select(whole, whole + 1.0, (u32(whole) & 1u) == 1u);","// The product is correctly rounded in WGSL, so the CPU oracle matches it with Math.fround.","fn getQuantileHeight(validCount: u32, p: f32) -> f32 {","  return f32(validCount - 1u) * p;","fn getQuantileRanks(validCount: u32, p: f32) -> vec2<u32> {","  let h = getQuantileHeight(validCount, p);","  let lower = floor(h);","  let upper = ceil(h);","  let code = u32(params[paramsOffset]);","  var first = lower;","  var second = lower;","  if (code == 1u) {","    first = upper;","    second = upper;","  } else if (code == 2u) {","    first = roundHalfEven(h);","    second = first;","  } else if (code == 3u) {","    second = min(lower + 1.0, f32(validCount - 1u));","  } else if (code == 4u) {","  return vec2<u32>(u32(first), u32(second));","fn getTargetRank(targetIndex: u32, validCount: u32) -> u32 {","  if (validCount == 0u) {","    return 0u;","  if (targetIndex < 2u * QUANTILE_COUNT) {","    let p = params[paramsOffset + HEADER_LENGTH + targetIndex / 2u];","    if (!isOrderStatisticProbability(p)) {","      return 0u;","    let ranks = getQuantileRanks(validCount, p);","    return select(ranks.x, ranks.y, (targetIndex & 1u) == 1u);","  let lastIndex = f32(validCount - 1u);","  if (targetIndex == 2u * QUANTILE_COUNT) {","    let lowerFraction = params[paramsOffset + 1u];","    let fraction = select(clamp(lowerFraction, 0.0, 1.0), 0.0, isNanBits(lowerFraction));","    return u32(clamp(floor(f32(validCount) * fraction), 0.0, lastIndex));","  let upperFraction = params[paramsOffset + 2u];","  let fraction = select(clamp(upperFraction, 0.0, 1.0), 1.0, isNanBits(upperFraction));","  return u32(clamp(ceil(f32(validCount) * fraction) - 1.0, 0.0, lastIndex));","var<workgroup> sharedPrefix: array<u32, 8>;","var<workgroup> sharedFirst: array<u32, 8>;","var<workgroup> sharedValidCount: u32;","paramsOffset = getChunkParameter(6u);","  _ = &histogram;","_ = &params;","  let phase = getChunkParameter(36u);","  let targetIndex = localInvocationIndex;","  if (phase == 0u && targetIndex == 0u) {","    var total = 0u;","    if (isEnabled) {","      for (var bin = 0u; bin < 256u; bin++) { total += histogram[histogramOffset + bin]; }","      state[stateOffset + STATE_VALID_COUNT] = total;","    sharedValidCount = total;","  if (isEnabled && targetIndex < TARGET_COUNT) {","    var prefix = 0u;","    var remaining = 0u;","    var slot = 0u;","    if (phase == 0u) { remaining = getTargetRank(targetIndex, sharedValidCount); }","    else {","      prefix = state[stateOffset + STATE_PREFIX + targetIndex];","      remaining = state[stateOffset + STATE_RANK + targetIndex];","      slot = state[stateOffset + STATE_SLOT + targetIndex];","    var digit = 255u;","    for (var bin = 0u; bin < 256u; bin++) {","      let count = histogram[histogramOffset + slot * 256u + bin];","      if (remaining < count) { digit = bin; break; }","      remaining -= count;","    prefix = (prefix << 8u) | digit;","    sharedPrefix[targetIndex] = prefix;","    state[stateOffset + STATE_PREFIX + targetIndex] = prefix;","    state[stateOffset + STATE_RANK + targetIndex] = remaining;","    for (var cell = targetIndex; cell < 2048u; cell += 256u) {","      histogram[histogramOffset + cell] = 0u;","  if (phase < 3u && isEnabled && targetIndex < TARGET_COUNT) {","    var first = 1u;","    for (var other = 0u; other < targetIndex; other++) {","      if (sharedPrefix[other] == sharedPrefix[targetIndex]) { first = 0u; break; }","    sharedFirst[targetIndex] = first;","    let prefix = sharedPrefix[targetIndex];","    for (var other = 0u; other < TARGET_COUNT; other++) {","      if (sharedFirst[other] == 1u && sharedPrefix[other] < prefix) { slot++; }","    state[stateOffset + STATE_SLOT + targetIndex] = slot;","    if (sharedFirst[targetIndex] == 1u) { state[stateOffset + STATE_ACTIVE_PREFIX + slot] = prefix; }","    if (targetIndex == 0u) {","      var distinct = 0u;","      for (var other = 0u; other < TARGET_COUNT; other++) { distinct += sharedFirst[other]; }","      state[stateOffset + STATE_ACTIVE_COUNT] = distinct;","@group(0) @binding(0) var<storage, read> state: array<u32>;","@group(0) @binding(1) var<storage, read> params: array<f32>;","@group(0) @binding(2) var<storage, read_write> quantilesOut: array<f32>;","var<private> quantilesOutOffset: u32;","@group(0) @binding(3) var<storage, read_write> validCountOut: array<u32>;","var<private> validCountOutOffset: u32;","@group(0) @binding(4) var<storage, read> gate: array<u32>;","@group(0) @binding(5) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","  stateOffset = getChunkParameter(4u);","  paramsOffset = getChunkParameter(5u);","  quantilesOutOffset = getChunkParameter(6u);","  validCountOutOffset = getChunkParameter(7u);","  gateOffset = getChunkParameter(8u);","  if (!(gate[gateOffset] == 1u)) {","  let validCount = state[stateOffset + STATE_VALID_COUNT];","  if (index < QUANTILE_COUNT) {","    var result = getNaN();","    let p = params[paramsOffset + HEADER_LENGTH + index];","    if (validCount > 0u && isOrderStatisticProbability(p)) {","      let first = decodeOrderedKey(state[stateOffset + STATE_PREFIX + 2u * index]);","      let second = decodeOrderedKey(state[stateOffset + STATE_PREFIX + 2u * index + 1u]);","      result = first;","      let code = u32(params[paramsOffset]);","      // validCount is below 2^24, so this is a runtime zero that blocks multiply-add fusion.","      let zero = validCount >> 31u;","      if (code == 3u) {","        let h = getQuantileHeight(validCount, p);","        result = interpolateOrderStatistic(first, second, h - floor(h), zero);","      } else if (code == 4u) {","        result = getOrderStatisticMidpoint(first, second, zero);","    quantilesOut[quantilesOutOffset + index] = result;","  } else {","    validCountOut[validCountOutOffset] = validCount;","    ","@group(0) @binding(2) var<storage, read> extremes: array<u32>;","@group(0) @binding(3) var<storage, read> quantileValues: array<f32>;","var<private> quantileValuesOffset: u32;","@group(0) @binding(4) var<storage, read_write> edges: array<f32>;","var<private> edgesOffset: u32;","@group(0) @binding(5) var<storage, read_write> edgeState: array<u32>;","  quantileValuesOffset = getChunkParameter(7u);","  edgesOffset = getChunkParameter(8u);","  edgeStateOffset = getChunkParameter(9u);","  let method = state[stateOffset + 0u];","  let classCount = state[stateOffset + 1u];","  let minimum = decodeOrderedKey(extremes[extremesOffset + 0u]);","  let maximum = decodeOrderedKey(extremes[extremesOffset + 1u]);","  if (method == 0u) {","    let width = (maximum - minimum) / f32(classCount);","    for (var edge = 1u; edge < classCount; edge = edge + 1u) {","      edges[edgesOffset + edge] = minimum + width * f32(edge);","    edgeState[edgeStateOffset] = classCount;","  if (method == 1u) {","      edges[edgesOffset + edge] = quantileValues[quantileValuesOffset + edge - 1u];","    let hinge = params[paramsOffset + 4u];","    let lowerQuartile = quantileValues[quantileValuesOffset];","    let median = quantileValues[quantileValuesOffset + 1u];","    let upperQuartile = quantileValues[quantileValuesOffset + 2u];","    let spread = upperQuartile - lowerQuartile;","    edges[edgesOffset + 1u] = lowerQuartile - hinge * spread;","    edges[edgesOffset + 2u] = lowerQuartile;","    edges[edgesOffset + 3u] = median;","    edges[edgesOffset + 4u] = upperQuartile;","    edges[edgesOffset + 5u] = upperQuartile + hinge * spread;","    edgeState[edgeStateOffset] = 6u;","  if (method == 7u) {","    for (var edge = 0u; edge <= classCount; edge = edge + 1u) {","      edges[edgesOffset + edge] = params[paramsOffset + HEADER + edge];","@group(0) @binding(1) var<storage, read> extremes: array<u32>;","@group(0) @binding(2) var<storage, read> edges: array<f32>;","@group(0) @binding(3) var<storage, read> edgeState: array<u32>;","@group(0) @binding(4) var<storage, read_write> breaksOut: array<f32>;","var<private> breaksOutOffset: u32;","@group(0) @binding(5) var<storage, read_write> classCountOut: array<u32>;","var<private> classCountOutOffset: u32;","  edgesOffset = getChunkParameter(6u);","  breaksOutOffset = getChunkParameter(8u);","  classCountOutOffset = getChunkParameter(9u);","  let finiteCount = extremes[extremesOffset + 3u];","  var classes = edgeState[edgeStateOffset];","  let isCustom = method == 7u;","  if (method == 4294967295u) {","    classes = 0u;","  } else if (!isCustom && finiteCount == 0u) {","  } else if (!isCustom && minimum == maximum) {","    classes = 1u;","  classes = min(classes, MAXIMUM_CLASS_COUNT);","  // A NaN edge (a hand-written parameter view with a NaN probability, hinge, interval or custom","  // edge) makes the classification undefined: report 0 classes and NaN edges, the no-data result,","  // instead of clamping NaN to an end edge and assigning a silent wrong class.","  for (var edge = 0u; edge <= classes; edge = edge + 1u) {","    let isComputedEnd = !isCustom && (edge == 0u || edge == classes);","    if (!isComputedEnd && isNanBits(edges[edgesOffset + edge])) {","      classes = 0u;","  let nan = getNaN();","  for (var edge = 0u; edge <= MAXIMUM_CLASS_COUNT; edge = edge + 1u) {","    var value = nan;","    if (classes > 0u && edge <= classes) {","      if (isCustom) {","        value = edges[edgesOffset + edge];","      } else if (edge == 0u) {","        value = minimum;","      } else if (edge == classes) {","        value = maximum;","        value = clamp(edges[edgesOffset + edge], minimum, maximum);","    breaksOut[breaksOutOffset + edge] = value;","  classCountOut[classCountOutOffset] = classes;","@group(0) @binding(1) var<storage, read> breaks: array<f32>;","var<private> breaksOffset: u32;","@group(0) @binding(2) var<storage, read> classCountIn: array<u32>;","var<private> classCountInOffset: u32;","@group(0) @binding(3) var<storage, read_write> classCounts: array<atomic<u32>>;","@group(0) @binding(4) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","  breaksOffset = getChunkParameter(5u);","  classCountInOffset = getChunkParameter(6u);","  classCountsOffset = getChunkParameter(7u);","  let classes = classCountIn[classCountInOffset];","  if (classes == 0u || isNanBits(value) || !(true)) {","  // Binary search for the number of inner edges e[1..classes-1] whose key is at or below key.","  var low = 1u;","  var high = classes;","  while (low < high) {","    let middle = (low + high) >> 1u;","    if (getOrderedKey(breaks[breaksOffset + middle]) <= key) {","      low = middle + 1u;","    } else {","      high = middle;","  atomicAdd(&classCounts[classCountsOffset + low - 1u], 1u);"],"strings":["read","class-breaks-quantiles-histogram","class-breaks-quantile-gate","class-breaks-quantiles-state","GPUClassBreaks","class-breaks-prepare","read_write","class-breaks-extremes","class-breaks-quantile-parameters","class-breaks-publish","compute","buffer","logical","poverty150Pct","transient","class-breaks-quantiles-finish","classCounts","state","class-breaks-edge-state","class-breaks-finish","breaks","class-breaks-quantiles-select-1","class-breaks-quantiles-select-2","class-breaks-state","gate","class-breaks-quantiles-select-0","class-breaks-quantiles-select-3","classCount","gpu-dataframe-class-breaks-snapshot-tap","histogram","class-breaks-edges","class-breaks-quantile-values","class-breaks-quantiles-histogram-0","class-breaks-quantiles-histogram-1","class-breaks-quantiles-histogram-2","class-breaks-quantiles-histogram-3","params","atomic<u32>","class-breaks-class-counts","values","class-break-parameters","class-breaks-quantiles-init","extremes","class-breaks-class-counts-clear","class-breaks-quantile-valid-count","wgsl:35a0fc2a","wgsl:6ea72dbd","edgeState","edges","imported"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","wri