ame-color-scale-snapshots-classIndices-0","name":"classIndices","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.color-scale-compiled","resource":"classIndices","meaning":"Palette class per tract; 4294967295 marks a no-data tract.","role":"output","keySpace":"row"},{"id":"gpu-dataframe-color-scale-snapshots-colors-0","name":"colors","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.color-scale-compiled","resource":"colors","meaning":"Packed rgba8 colour per tract: r | g << 8 | b << 16 | a << 24.","role":"output","keySpace":"row"},{"id":"gpu-dataframe-color-scale-snapshots-classCounts-0","name":"classCounts","iteration":0,"elementType":"u32","values":"b64:dQAAALUAAACrAAAAlAAAAKsAAAA=","provenance":"gpu-readback","graph":"gpu-dataframe.color-scale-compiled","resource":"classCounts","meaning":"gpu-dataframe-color-scale-snapshot-tap","role":"output","keySpace":"class"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const countsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> counts: array<u32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &counts;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  counts[countsOffset + index] = 0u;","}","const valuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> values: array<f32>;","const domainOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> domain: array<f32>;","const paramsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> params: array<f32>;","const classesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> classes: array<u32>;","const positionsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> positions: array<f32>;","const DOMAIN_LENGTH: u32 = 6u;","const MAXIMUM_DOMAIN_COUNT: u32 = 6u;","const MAXIMUM_PALETTE_COUNT: u32 = 5u;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn isNanBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u;","fn getOrderedKey(x: f32) -> u32 {","  let bits = bitcast<u32>(x);","  return select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","fn decodeOrderedKey(key: u32) -> f32 {","  return bitcast<f32>(select(~key, key ^ 0x80000000u, (key & 0x80000000u) != 0u));","const NO_CLASS: u32 = 0xffffffffu;","// -0 and +0 compare equal, like d3 bisectRight. The zero test is on bits because a compiler may","// fold a float select on `x == 0.0` back to `x`.","fn getComparisonKey(x: f32) -> u32 {","  if ((bits & 0x7fffffffu) == 0u) {","    return 0x80000000u;","fn signedPower(x: f32, exponent: f32) -> f32 {","  let magnitude = abs(x);","  if (magnitude == 0.0) {","    return 0.0;","  let result = pow(magnitude, exponent);","  return select(result, -result, x < 0.0);","// Scale transform before normalisation. Codes: 0 linear, 1 sqrt, 2 pow, 3 log, 4 symlog.","fn transformValue(x: f32, scale: u32, exponent: f32, logFloor: f32) -> f32 {","  if (scale == 1u) {","    let magnitude = sqrt(abs(x));","    return select(magnitude, -magnitude, x < 0.0);","  if (scale == 2u) {","    return signedPower(x, exponent);","  if (scale == 3u) {","    var positive = x;","    if (!(positive > 0.0)) {","      positive = logFloor;","    }","    if (isNanBits(positive) || !(positive > 0.0)) {","      return getNaN();","    return log(positive);","  if (scale == 4u) {","    let magnitude = log(1.0 + abs(x));","  return x;","// Explicit native log mode keeps the legacy positive-floor transform unchanged.","fn transformColorValue(x: f32, scale: u32, exponent: f32, logFloor: f32, negativeLog: bool) -> f32 {","  if (scale == 9u) {","    if ((bitcast<u32>(x) & 0x7f800000u) == 0x7f800000u || x == 0.0 || (x < 0.0) != negativeLog) {","    return select(log(abs(x)), -log(abs(x)), negativeLog);","  return transformValue(x, scale, exponent, logFloor);","fn normalizeColorValue(value: f32, first: f32, last: f32) -> f32 {","  if (first == last && (bitcast<u32>(first) & 0x7f800000u) != 0x7f800000u) { return 0.5; }","  let magnitude = max(max(abs(first), abs(last)), abs(value));","  // Scale large finite values before subtracting: prevents f32 overflow and subnormal reciprocals.","  let normalization = select(1.0, 1e-20, magnitude > 1e19 && (bitcast<u32>(magnitude) & 0x7f800000u) != 0x7f800000u);","  return (value * normalization - first * normalization) / (last * normalization - first * normalization);","fn unpackChannel(color: u32, channel: u32) -> f32 {","  return f32((color >> (channel * 8u)) & 0xffu);","fn packChannel(value: f32) -> u32 {","  return u32(clamp(floor(value + 0.5), 0.0, 255.0));","fn blendColors(first: u32, second: u32, fraction: f32) -> u32 {","  var result = 0u;","  for (var channel = 0u; channel < 4u; channel++) {","    let a = unpackChannel(first, channel);","    let b = unpackChannel(second, channel);","    result = result | (packChannel(a + (b - a) * fraction) << (channel * 8u));","  return result;","@compute @workgroup_size(256)","  _ = &values;","  _ = &domain;","  _ = &params;","  _ = &classes;","  _ = &positions;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  classes[classesOffset + index] = NO_CLASS;","  positions[positionsOffset + index] = 0.0;","  ","  let paletteCount = min(u32(max(params[paramsOffset + 2u], 0.0)), MAXIMUM_PALETTE_COUNT);","  if (paletteCount == 0u) {","    var domainCount = u32(max(params[paramsOffset + 1u], 0.0));","  domainCount = min(domainCount, min(MAXIMUM_DOMAIN_COUNT, DOMAIN_LENGTH));","  if (domainCount == 0u) {","  let value = values[valuesOffset + index];","  if (isNanBits(value)) {","  let scale = u32(max(params[paramsOffset], 0.0));","  let isClamped = params[paramsOffset + 4u] == 1.0;","  let isExtrapolating = params[paramsOffset + 4u] == 2.0;","  let logFloor = params[paramsOffset + 7u];","  let exponent = params[paramsOffset + 8u];","  var classIndex = NO_CLASS;","  var rampPosition = 0.0;","  if (scale == 6u || scale == 7u) {","    // Threshold and quantile: count the inner edges domain[1 .. domainCount - 2] that are <= value.","    if (domainCount < 2u) {","      return;","    let valueKey = getComparisonKey(value);","    var low = 1u;","    var high = domainCount - 1u;","    while (low < high) {","      let middle = (low + high) / 2u;","      if (getComparisonKey(domain[domainOffset + middle]) <= valueKey) {","        low = middle + 1u;","      } else {","        high = middle;","      }","    classIndex = min(low - 1u, paletteCount - 1u);","  } else if (scale == 5u) {","    let lowEdge = domain[domainOffset];","    let span = domain[domainOffset + domainCount - 1u] - lowEdge;","    var t = select(0.5, (value - lowEdge) / span, span != 0.0);","    if (isNanBits(t) || (!isClamped && (t < 0.0 || t > 1.0))) {","    t = clamp(t, 0.0, 1.0);","    classIndex = min(u32(floor(t * f32(paletteCount))), paletteCount - 1u);","  } else if (scale <= 4u || scale == 9u) {","    let negativeLog = domain[domainOffset] < 0.0;","    let firstStop = transformColorValue(domain[domainOffset], scale, exponent, logFloor, negativeLog);","    let lastStop = transformColorValue(domain[domainOffset + domainCount - 1u], scale, exponent, logFloor, negativeLog);","    let transformed = transformColorValue(value, scale, exponent, logFloor, negativeLog);","    if (isNanBits(firstStop) || isNanBits(lastStop)) { return; }","    // Native finite constant domains normalize to the midpoint, including zero/wrong-sign log inputs.","    let t = normalizeColorValue(transformed, firstStop, lastStop);","    if (isNanBits(t) || (!isClamped && !isExtrapolating && (t < 0.0 || t > 1.0))) {","    if ((isExtrapolating || scale == 9u) &&","        ((bitcast<u32>(value) & 0x7f800000u) == 0x7f800000u ||","         (bitcast<u32>(t) & 0x7f800000u) == 0x7f800000u)) { return; }","    if (domainCount > 2u && paletteCount == domainCount) {","      if (!isExtrapolating && t <= 0.0) {","        rampPosition = 0.0;","      } else if (!isExtrapolating && t >= 1.0) {","        rampPosition = f32(paletteCount - 1u);","        // Select the first/last segment outside the domain, including descending domains.","        var segment = 0u;","        let descending = lastStop < firstStop;","        for (var stopIndex = 1u; stopIndex + 1u < domainCount; stopIndex++) {","          let stop = transformColorValue(domain[domainOffset + stopIndex], scale, exponent, logFloor, negativeLog);","          if (select(stop <= transformed, stop >= transformed, descending)) {","            segment = stopIndex;","          }","        }","        let segmentStart = transformColorValue(domain[domainOffset + segment], scale, exponent, logFloor, negativeLog);","        let segmentEnd = transformColorValue(domain[domainOffset + segment + 1u], scale, exponent, logFloor, negativeLog);","        var fraction = normalizeColorValue(transformed, segmentStart, segmentEnd);","        if (isNanBits(fraction)) { return; }","        if (!isExtrapolating) {","          fraction = clamp(fraction, 0.0, 1.0);","          // Preserve the legacy duplicate-stop choice unless native log was explicitly requested.","          if (segmentStart == segmentEnd && scale != 9u) { fraction = 0.0; }","        rampPosition = f32(segment) + fraction;","      classIndex = u32(clamp(floor(rampPosition), 0.0, f32(paletteCount - 1u)));","    } else {","      let clampedT = clamp(t, 0.0, 1.0);","      rampPosition = select(clampedT, t, isExtrapolating) * f32(paletteCount - 1u);","      classIndex = min(u32(floor(clampedT * f32(paletteCount))), paletteCount - 1u);","  } else {","  if ((isExtrapolating || scale == 9u) &&","      (bitcast<u32>(rampPosition) & 0x7f800000u) == 0x7f800000u) { return; }","  classes[classesOffset + index] = classIndex;","  positions[positionsOffset + index] = rampPosition;","@group(0) @binding(0) var<storage, read> classes: array<u32>;","@group(0) @binding(1) var<storage, read> positions: array<f32>;","const paletteOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> palette: array<u32>;","@group(0) @binding(3) var<storage, read> params: array<f32>;","const colorsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> colors: array<u32>;","@group(0) @binding(5) var<storage, read_write> counts: array<atomic<u32>>;","const IS_ORDINAL: bool = false;","  _ = &palette;","  _ = &colors;","  let classIndex = classes[classesOffset + index];","  let isValid = classIndex != NO_CLASS && classIndex < paletteCount;","  if (isValid) {","    atomicAdd(&counts[countsOffset + classIndex], 1u);","  let noDataColor = u32(params[paramsOffset + 5u]) | (u32(params[paramsOffset + 6u]) << 16u);","  var color = noDataColor;","    color = palette[paletteOffset + classIndex];","    let scale = u32(max(params[paramsOffset], 0.0));","    if (!IS_ORDINAL && (scale <= 4u || scale == 9u) && params[paramsOffset + 3u] == 1.0) {","      let position = positions[positionsOffset + index];","      let lower = u32(clamp(floor(position), 0.0, f32(max(paletteCount, 2u) - 2u)));","      let upper = min(lower + 1u, paletteCount - 1u);","      color = blendColors(","        palette[paletteOffset + lower],","        palette[paletteOffset + upper],","        position - f32(lower)","      );","  colors[colorsOffset + index] = color;"],"strings":["color-scale-colorize","color-scale-classify","classCounts","classIndices","gpu-dataframe-color-scale-snapshot-tap","buffer","color-scale-positions","colors","read","GPUColorScale","color-scale-parameters","read_write","color-scale-init","domain","imported","palette","poverty150Pct","transient","compute","classes","counts","params","positions"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:2",791,4,1],["~:3","~l","~a","~8","f32",0,9],["~:4",[4,1,1],791,false]]}}
