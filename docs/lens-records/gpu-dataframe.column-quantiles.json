Count: vec3<u32>,","  @builtin(local_invocation_index) localInvocationIndex: u32) {","  _ = &histogram;","  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  histogramOffset = getChunkParameter(4u);","  if (true) {","    histogram[histogramOffset + index] = 0u;","  }","}","@group(0) @binding(0) var<storage, read> values: array<f32>;","var<private> valuesOffset: u32;","@group(0) @binding(1) var<storage, read> state: array<u32>;","var<private> stateOffset: u32;","@group(0) @binding(2) var<storage, read_write> histogram: array<atomic<u32>>;","struct ClassificationWorkgroupParameters { words: array<vec4<u32>, 16> }","@group(0) @binding(3) var<uniform> classificationParameters: ClassificationWorkgroupParameters;","fn getChunkParameter(word: u32) -> u32 { return classificationParameters.words[word / 4u][word % 4u]; }","const QUANTILE_COUNT: u32 = 3u;","const TARGET_COUNT: u32 = 8u;","const HEADER_LENGTH: u32 = 4u;","const STATE_PREFIX: u32 = 0u;","const STATE_RANK: u32 = 8u;","const STATE_SLOT: u32 = 16u;","const STATE_ACTIVE_PREFIX: u32 = 24u;","const STATE_ACTIVE_COUNT: u32 = 32u;","const STATE_VALID_COUNT: u32 = 33u;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn isNanBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u;","fn getOrderedKey(x: f32) -> u32 {","  let bits = bitcast<u32>(x);","  return select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","fn decodeOrderedKey(key: u32) -> f32 {","  return bitcast<f32>(select(~key, key ^ 0x80000000u, (key & 0x80000000u) != 0u));","// Numeric equality merges signed zeros; the raw getOrderedKey remains available for bit ordering.","// Test bits because Metal may fold a float select on x == 0.0 back to x.","fn getComparisonKey(x: f32) -> u32 {","  if ((bitcast<u32>(x) & 0x7fffffffu) == 0u) {","    return 0x80000000u;","  return getOrderedKey(x);","fn isOrderStatisticProbability(p: f32) -> bool {","  // Ordered comparisons with NaN are false, but a compiler may fold them; test the bits.","  let bits = bitcast<u32>(p);","  if ((bits & 0x7f800000u) == 0x7f800000u) {","    return false;","  return p >= 0.0 && p <= 1.0;","fn getOrderStatisticKey(value: f32) -> u32 {","  var bits = bitcast<u32>(value);","  if ((bits & 0x7fffffffu) == 0u) {","    bits = 0u;","// Identity the compiler cannot fold: the bit operation on a runtime zero stops multiply-add","// fusion, so every f32 step rounds exactly like a Math.fround mirror.","fn roundOrderStatisticStep(value: f32, zero: u32) -> f32 {","  return bitcast<f32>(bitcast<u32>(value) | zero);","fn interpolateOrderStatistic(low: f32, high: f32, fraction: f32, zero: u32) -> f32 {","  if (fraction == 0.0 || low == high) {","    return low;","  let difference = roundOrderStatisticStep(high - low, zero);","  if ((bitcast<u32>(difference) & 0x7f800000u) != 0x7f800000u) {","    return low + roundOrderStatisticStep(difference * fraction, zero);","  // high - low overflowed; a convex combination of two finite values cannot.","  return roundOrderStatisticStep(low * (1.0 - fraction), zero) +","    roundOrderStatisticStep(high * fraction, zero);","fn getOrderStatisticMidpoint(low: f32, high: f32, zero: u32) -> f32 {","  if (low == high) {","  let sum = roundOrderStatisticStep(low + high, zero);","  if ((bitcast<u32>(sum) & 0x7f800000u) != 0x7f800000u) {","    return sum * 0.5;","  return roundOrderStatisticStep(low * 0.5, zero) + roundOrderStatisticStep(high * 0.5, zero);","fn isMissingValue(value: f32) -> bool {","  return (bitcast<u32>(value) & 0x7f800000u) == 0x7f800000u;","const LOCAL_SLOT_COUNT: u32 = 8u;","const LOCAL_BIN_COUNT: u32 = 2048u;","var<workgroup> localHistogram: array<atomic<u32>, 2048>;","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>, @builtin(num_workgroups) workgroupCount: vec3<u32>, @builtin(local_invocation_index) localInvocationIndex: u32) {","  if (workgroupIndex >= getChunkParameter(1u) / 256u) { return; }","  valuesOffset = getChunkParameter(4u);","stateOffset = getChunkParameter(5u);","histogramOffset = getChunkParameter(6u);","  _ = &values;","_ = &state;","_ = &histogram;","  for (var bin = localInvocationIndex; bin < LOCAL_BIN_COUNT; bin = bin + 256u) {","    atomicStore(&localHistogram[bin], 0u);","  workgroupBarrier();","  let isEnabled = true;","  if (isEnabled) {","    let phase = getChunkParameter(36u);","    let shift = 24u - 8u * phase;","    let activeCount = select(1u, state[stateOffset + STATE_ACTIVE_COUNT], phase > 0u);","    let rowCount = arrayLength(&values) - valuesOffset;","    for (var row = index; row < rowCount; row = row + getChunkParameter(1u)) {","      let value = values[valuesOffset + row];","      if (isMissingValue(value)) {","        continue;","      }","      ","      let key = getOrderStatisticKey(value);","      var slot = 0u;","      if (phase > 0u) {","        let prefixValue = key >> (shift + 8u);","        var low = 0u;","        var high = activeCount;","        while (low < high) {","          let middle = (low + high) / 2u;","          if (state[stateOffset + STATE_ACTIVE_PREFIX + middle] < prefixValue) { low = middle + 1u; }","          else { high = middle; }","        }","        if (low >= activeCount || state[stateOffset + STATE_ACTIVE_PREFIX + low] != prefixValue) { continue; }","        slot = low;","      let digit = (key >> shift) & 255u;","      if (slot < LOCAL_SLOT_COUNT) {","        atomicAdd(&localHistogram[slot * 256u + digit], 1u);","      } else {","        atomicAdd(&histogram[histogramOffset + slot * 256u + digit], 1u);","    }","    for (var bin = localInvocationIndex; bin < LOCAL_BIN_COUNT; bin = bin + 256u) {","      let count = atomicLoad(&localHistogram[bin]);","      if (count != 0u && bin < 2048u) {","        atomicAdd(&histogram[histogramOffset + bin], count);","@group(0) @binding(1) var<storage, read_write> state: array<u32>;","@group(0) @binding(2) var<storage, read> params: array<f32>;","var<private> paramsOffset: u32;","// Round half to even; the fraction h - floor(h) is exact in f32.","fn roundHalfEven(h: f32) -> f32 {","  let whole = floor(h);","  let fraction = h - whole;","  if (fraction < 0.5) {","    return whole;","  if (fraction > 0.5) {","    return whole + 1.0;","  return select(whole, whole + 1.0, (u32(whole) & 1u) == 1u);","// The product is correctly rounded in WGSL, so the CPU oracle matches it with Math.fround.","fn getQuantileHeight(validCount: u32, p: f32) -> f32 {","  return f32(validCount - 1u) * p;","fn getQuantileRanks(validCount: u32, p: f32) -> vec2<u32> {","  let h = getQuantileHeight(validCount, p);","  let lower = floor(h);","  let upper = ceil(h);","  let code = u32(params[paramsOffset]);","  var first = lower;","  var second = lower;","  if (code == 1u) {","    first = upper;","    second = upper;","  } else if (code == 2u) {","    first = roundHalfEven(h);","    second = first;","  } else if (code == 3u) {","    second = min(lower + 1.0, f32(validCount - 1u));","  } else if (code == 4u) {","  return vec2<u32>(u32(first), u32(second));","fn getTargetRank(targetIndex: u32, validCount: u32) -> u32 {","  if (validCount == 0u) {","    return 0u;","  if (targetIndex < 2u * QUANTILE_COUNT) {","    let p = params[paramsOffset + HEADER_LENGTH + targetIndex / 2u];","    if (!isOrderStatisticProbability(p)) {","      return 0u;","    let ranks = getQuantileRanks(validCount, p);","    return select(ranks.x, ranks.y, (targetIndex & 1u) == 1u);","  let lastIndex = f32(validCount - 1u);","  if (targetIndex == 2u * QUANTILE_COUNT) {","    let lowerFraction = params[paramsOffset + 1u];","    let fraction = select(clamp(lowerFraction, 0.0, 1.0), 0.0, isNanBits(lowerFraction));","    return u32(clamp(f