   let code = u32(params[paramsOffset]);","      // validCount is below 2^24, so this is a runtime zero that blocks multiply-add fusion.","      let zero = validCount >> 31u;","      if (code == 3u) {","        let h = getQuantileHeight(validCount, p);","        result = interpolateOrderStatistic(first, second, h - floor(h), zero);","      } else if (code == 4u) {","        result = getOrderStatisticMidpoint(first, second, zero);","    quantilesOut[quantilesOutOffset + index] = result;","  } else {","    validCountOut[validCountOutOffset] = validCount;","    let hasRows = validCount > 0u;","    let lowerBound = decodeOrderedKey(state[stateOffset + STATE_PREFIX + 2u * QUANTILE_COUNT]);","    let upperBound = decodeOrderedKey(state[stateOffset + STATE_PREFIX + 2u * QUANTILE_COUNT + 1u]);","    filterBoundsOut[filterBoundsOutOffset] = select(getNaN(), lowerBound, hasRows);","    filterBoundsOut[filterBoundsOutOffset + 1u] = select(getNaN(), upperBound, hasRows);","@group(0) @binding(2) var<storage, read_write> filterMaskOut: array<u32>;","var<private> filterMaskOutOffset: u32;","@group(0) @binding(3) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","  _ = &filterMaskOut;","  stateOffset = getChunkParameter(5u);","  filterMaskOutOffset = getChunkParameter(6u);","  var inside = 0u;","  let value = values[valuesOffset + index];","  if (state[stateOffset + STATE_VALID_COUNT] > 0u && !isMissingValue(value)) {","    {","      let lowerKey = state[stateOffset + STATE_PREFIX + 2u * QUANTILE_COUNT];","      let upperKey = state[stateOffset + STATE_PREFIX + 2u * QUANTILE_COUNT + 1u];","      inside = select(0u, 1u, key >= lowerKey && key <= upperKey);","  filterMaskOut[filterMaskOutOffset + index] = inside;"],"strings":["column-quantiles-state","column-quantiles-histogram","GPUColumnQuantiles","read_write","read","gpu-dataframe-column-quantiles-snapshot-tap","poverty150Pct","quantile-parameters","compute","state","column-quantiles-finish","histogram","buffer",