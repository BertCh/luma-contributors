AgAAAA==","provenance":"gpu-readback","graph":"gpu-dataframe.coregionalization-fit-compiled","resource":"iteration-count","meaning":"gpu-dataframe.coregionalization-fit-snapshot-tap","role":"output","keySpace":"fit"},{"id":"gpu-dataframe.coregionalization-fit-snapshots-converged-0","name":"converged","iteration":0,"elementType":"u32","values":"same:snapshots.7","provenance":"gpu-readback","graph":"gpu-dataframe.coregionalization-fit-compiled","resource":"converged","meaning":"gpu-dataframe.coregionalization-fit-snapshot-tap","role":"output","keySpace":"fit"},{"id":"gpu-dataframe.coregionalization-fit-snapshots-iterationLimitReached-0","name":"iterationLimitReached","iteration":0,"elementType":"u32","values":"b64:AAAAAA==","provenance":"gpu-readback","graph":"gpu-dataframe.coregionalization-fit-compiled","resource":"iteration-limit-reached","meaning":"gpu-dataframe.coregionalization-fit-snapshot-tap","role":"output","keySpace":"fit"},{"id":"gpu-dataframe.coregionalization-fit-snapshots-invalidCount-0","name":"invalidCount","iteration":0,"elementType":"u32","values":"same:snapshots.7","provenance":"gpu-readback","graph":"gpu-dataframe.coregionalization-fit-compiled","resource":"invalid-count","meaning":"gpu-dataframe.coregionalization-fit-snapshot-tap","role":"output","keySpace":"fit"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const distancesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> distances: array<f32>;","const semivariancesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> semivariances: array<f32>;","const pairCountsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> pairCounts: array<u32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> parameters: array<f32>;","const stateOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> state: array<f32>;","const dispatchOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> dispatch: array<u32>;","const VARIABLE_COUNT: u32 = 2u;","const STRUCTURE_COUNT: u32 = 1u;","const SQUARE_COUNT: u32 = 4u;","const COEFFICIENT_COUNT: u32 = 4u;","const BIN_COUNT: u32 = 4u;","const TRIANGLE_COUNT: u32 = 3u;","const TARGET: u32 = 1u;","const MATRIX: u32 = 5u;","const LOADING: u32 = 9u;","const VALIDITY: u32 = 13u;","const ITERATION: u32 = 14u;","const CONVERGED: u32 = 15u;","const INVALID: u32 = 16u;","const USABLE: u32 = 17u;","const WEIGHT: u32 = 18u;","const CHANGE: u32 = 19u;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","// 1 - exp(-argument) for argument >= 0, by the series","// argument - argument^2/2 + argument^3/6 - argument^4/24 + argument^5/120 below 0.1.","fn getVariogramExponentialShape(argument: f32) -> f32 {","  if (argument < 0.1) {","    return argument * (1.0 - argument * (0.5 - argument * ((1.0 / 6.0) - argument * ((1.0 / 24.0) - argument * (1.0 / 120.0)))));","  }","  return 1.0 - exp(-argument);","fn getVariogramModelShape(modelCode: u32, scaled: f32) -> f32 {","  if (modelCode == 0u) {","    return select(1.5 * scaled - 0.5 * scaled * scaled * scaled, 1.0, scaled >= 1.0);","  if (modelCode == 1u) { return getVariogramExponentialShape(3.0 * scaled); }","  if (modelCode == 2u) { return getVariogramExponentialShape(3.0 * scaled * scaled); }","  if (modelCode == 3u) {","    // 1 - (1 + a) exp(-a) = a^2/2 - a^3/3 + a^4/8 - a^5/30 + a^6/144 - ...","    let argument = 4.749031386012701 * scaled;","    if (argument < 0.1) {","      return argument * argument * (0.5 - argument * ((1.0 / 3.0) - argument * (0.125 - argument * ((1.0 / 30.0) - argument * (1.0 / 144.0)))));","    }","    return 1.0 - (1.0 + argument) * exp(-argument);","  // 1 - (1 + a + a^2/3) exp(-a) = a^2/6 - a^4/24 + a^5/45 - a^6/144 + ...","  let argument = 5.924462618951797 * scaled;","    return argument * argument * ((1.0 / 6.0) - argument * argument * ((1.0 / 24.0) - argument * ((1.0 / 45.0) - argument * (1.0 / 144.0))));","  return 1.0 - (1.0 + argument + argument * argument / 3.0) * exp(-argument);","fn usableBin(bin: u32) -> bool {","  if (!isFiniteValue(distances[distancesOffset + bin]) || distances[distancesOffset + bin] <= 0.0 || pairCounts[pairCountsOffset + bin] == 0u) { return false; }","  for (var entry = 0u; entry < TRIANGLE_COUNT; entry++) {","    if (!isFiniteValue(semivariances[semivariancesOffset + bin * TRIANGLE_COUNT + entry])) { return false; }","  return true;","fn structureShape(structure: u32, lag: f32) -> f32 {","  let start = parametersOffset + 1u + 4u * structure;","  return parameters[start + 1u] + parameters[start + 2u] * getVariogramModelShape(u32(parameters[start]), lag / parameters[start + 3u]);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &distances;","  _ = &semivariances;","  _ = &pairCounts;","  _ = &parameters;","  _ = &state;","  _ = &dispatch;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  ","for (var entry = 0u; entry < 20u; entry++) { state[stateOffset + entry] = 0.0; }","dispatch[dispatchOffset + 0u] = 0u;","for (var bin = 0u; bin < BIN_COUNT; bin++) {","  if (usableBin(bin)) {","    state[stateOffset + USABLE] += 1.0;","    state[stateOffset + WEIGHT] += f32(pairCounts[pairCountsOffset + bin]);","  } else { state[stateOffset + INVALID] += 1.0; }","if (!isFiniteValue(parameters[parametersOffset]) || parameters[parametersOffset] <= 0.0 || parameters[parametersOffset] > 1.0) { return; }","for (var structure = 0u; structure < STRUCTURE_COUNT; structure++) {","  let model = parameters[start];","  let nugget = parameters[start + 1u];","  let sill = parameters[start + 2u];","  let rangeValue = parameters[start + 3u];","  if (!isFiniteValue(model) || model < 0.0 || model > 4.0 || floor(model) != model ||","      !isFiniteValue(nugget) || nugget < 0.0 || !isFiniteValue(sill) || sill < 0.0 ||","      !isFiniteValue(nugget + sill) || nugget + sill <= 0.0 || !isFiniteValue(rangeValue) || rangeValue <= 0.0) { return; }","if (state[stateOffset + USABLE] == 0.0) { return; }","  if (!usableBin(bin)) { continue; }","  let weight = f32(pairCounts[pairCountsOffset + bin]) / state[stateOffset + WEIGHT];","  for (var structure = 0u; structure < STRUCTURE_COUNT; structure++) {","    let shape = structureShape(structure, distances[distancesOffset + bin]);","    for (var other = 0u; other < STRUCTURE_COUNT; other++) {","      state[stateOffset + structure * STRUCTURE_COUNT + other] += weight * shape * structureShape(other, distances[distancesOffset + bin]);","    var triangle = 0u;","    for (var row = 0u; row < VARIABLE_COUNT; row++) {","      for (var column = row; column < VARIABLE_COUNT; column++) {","        let value = weight * shape * semivariances[semivariancesOffset + bin * TRIANGLE_COUNT + triangle];","        state[stateOffset + TARGET + structure * SQUARE_COUNT + row * VARIABLE_COUNT + column] += value;","        if (row != column) { state[stateOffset + TARGET + structure * SQUARE_COUNT + column * VARIABLE_COUNT + row] += value; }","        triangle++;","      }","for (var entry = 0u; entry < MATRIX; entry++) {","  if (!isFiniteValue(state[stateOffset + entry])) { return; }","  if (state[stateOffset + structure * STRUCTURE_COUNT + structure] <= 0.0) { return; }","state[stateOffset + VALIDITY] = 1.0;","dispatch[dispatchOffset + 0u] = 1u;","  dispatch[dispatchOffset + 1u] = 1u;","  dispatch[dispatchOffset + 2u] = 1u;","@group(0) @binding(0) var<storage, read> parameters: array<f32>;","@group(0) @binding(1) var<storage, read_write> state: array<f32>;","struct SymmetricEigen_2 {","  values: array<f32, 2>,","  size: u32,","  status: u32,","  sweeps: u32,","fn getSymmetricEigen_2(","  matrix: ptr<function, array<f32, 4>>,","  vectors: ptr<function, array<f32, 4>>,","  maximumSweeps: u32,","  tolerance: f32",") -> SymmetricEigen_2 {","  var result: SymmetricEigen_2;","  result.size = min(size, 2u);","  result.status = 0u;","  result.sweeps = 0u;","  let count = result.size;","  // Validate first, so a NONFINITE return leaves matrix and vectors untouched.","  var largest = 0.0;","  for (var row = 0u; row < count; row++) {","    for (var column = 0u; column <= row; column++) {","      let value = (*matrix)[row * 2u + column];","      if (!isFiniteValue(value)) {","        result.status = 1u;","        return result;","      largest = max(largest, abs(value));","      (*matrix)[column * 2u + row] = (*matrix)[row * 2u + column];","      (*vectors)[row * 2u + column] = select(0.0, 1.0, row == column);","      (*vectors)[column * 2u + row] = select(0.0, 1.0, row == column);","  // The stopping test runs on entries scaled by the power of two that brings the largest input","  // entry into [0.5, 1): exact, so well-scaled input stops exactly as unscaled, and the squares","  // neither underflow (entries below about 1e-19) nor overflow (above about 1.8e19). Rotations","  // keep the Frobenius norm, so scaled entries stay at most the size.","  let scaleExponent = -frexp(largest).exp;","  for (var sweep = 0u; sweep <= maximumSweeps; sweep++) {","    var offDiagonal = 0.0;","    var diagonal = 0.0;","    for (var row = 0u; row < count; row++) {","      let diagonalValue = ldexp((*matrix)[row * 2u + row], scaleExponent);","      diagonal = diagonal + diagonalValue * diagonalValue;","      for (var column = row + 1u; column < count; column++) {","        let offDiagonalValue = ldexp((*matrix)[row * 2u + column], scaleExponent);","        offDiagonal = offDiagonal + offDiagonalValue * offDiagonalValue;","    if (offDiagonal == 0.0 || offDiagonal <= tolerance * tolerance * diagonal) {","      break;","    if (sweep == maximumSweeps) {","      result.status = 4u;","    result.sweeps = sweep + 1u;","    for (var lower = 0u; lower + 1u < count; lower++) {","      for (var upper = lower + 1u; upper < count; upper++) {","        let coupling = (*matrix)[lower * 2u + upper];","        if (coupling == 0.0) {","          continue;","        }","        let theta = ((*matrix)[upper * 2u + upper] - (*matrix)[lower * 2u + lower]) / (2.0 * coupling);","        let direction = select(-1.0, 1.0, theta >= 0.0);","        let tangent = select(direction / (abs(theta) + sqrt(theta * theta + 1.0)), 0.5 / theta, abs(theta) > 1.0e18);","        let cosine = 1.0 / sqrt(tangent * tangent + 1.0);","        let sine = tangent * cosine;","        for (var k = 0u; k < count; k++) {","          let lowerValue = (*matrix)[k * 2u + lower];","          let upperValue = (*matrix)[k * 2u + upper];","          (*matrix)[k * 2u + lower] = cosine * lowerValue - sine * upperValue;","          (*matrix)[k * 2u + upper] = sine * lowerValue + cosine * upperValue;","          let lowerValue = (*matrix)[lower * 2u + k];","          let upperValue = (*matrix)[upper * 2u + k];","          (*matrix)[lower * 2u + k] = cosine * lowerValue - sine * upperValue;","          (*matrix)[upper * 2u + k] = sine * lowerValue + cosine * upperValue;","        (*matrix)[lower * 2u + upper] = 0.0;","        (*matrix)[upper * 2u + lower] = 0.0;","          let lowerValue = (*vectors)[k * 2u + lower];","          let upperValue = (*vectors)[k * 2u + upper];","          (*vectors)[k * 2u + lower] = cosine * lowerValue - sine * upperValue;","          (*vectors)[k * 2u + upper] = sine * lowerValue + cosine * upperValue;","  for (var index = 0u; index < count; index++) {","    result.values[index] = (*matrix)[index * 2u + index];","  // Selection sort, ascending, moving the vector columns with their values.","  for (var index = 0u; index + 1u < count; index++) {","    var smallest = index;","    for (var other = index + 1u; other < count; other++) {","      if (result.values[other] < result.values[smallest]) {","        smallest = other;","    if (smallest != index) {","      let held = result.values[index];","      result.values[index] = result.values[smallest];","      result.values[smallest] = held;","      for (var k = 0u; k < count; k++) {","        let component = (*vectors)[k * 2u + index];","        (*vectors)[k * 2u + index] = (*vectors)[k * 2u + smallest];","        (*vectors)[k * 2u + smallest] = component;","  return result;","var previous: array<f32, 4>;","for (var entry = 0u; entry < COEFFICIENT_COUNT; entry++) { previous[entry] = state[stateOffset + MATRIX + entry]; }","  var matrix: array<f32, 4>;","  var vectors: array<f32, 4>;","  let denominator = state[stateOffset + structure * STRUCTURE_COUNT + structure];","  for (var entry = 0u; entry < SQUARE_COUNT; entry++) {","    var numerator = state[stateOffset + TARGET + structure * SQUARE_COUNT + entry];","      if (other != structure) { numerator -= state[stateOffset + structure * STRUCTURE_COUNT + other] * state[stateOffset + MATRIX + other * SQUARE_COUNT + entry]; }","    matrix[entry] = numerator / denominator;","  let eigen = getSymmetricEigen_2(&matrix, &vectors, VARIABLE_COUNT, 24u, 1e-7);","  if (eigen.status != 0u) { state[stateOffset + VALIDITY] = 0.0; return; }","  for (var row = 0u; row < VARIABLE_COUNT; row++) {","    for (var column = 0u; column < VARIABLE_COUNT; column++) {","      let loading = vectors[row * VARIABLE_COUNT + column] * sqrt(max(eigen.values[column], 0.0));","      if (!isFiniteValue(loading)) { state[stateOffset + VALIDITY] = 0.0; return; }","      state[stateOffset + LOADING + structure * SQUARE_COUNT + row * VARIABLE_COUNT + column] = loading;","      var value = 0.0;","      for (var component = 0u; component < VARIABLE_COUNT; component++) {","        value += state[stateOffset + LOADING + structure * SQUARE_COUNT + row * VARIABLE_COUNT + component] *","          state[stateOffset + LOADING + structure * SQUARE_COUNT + column * VARIABLE_COUNT + component];","      if (!isFiniteValue(value)) { state[stateOffset + VALIDITY] = 0.0; return; }","      state[stateOffset + MATRIX + structure * SQUARE_COUNT + row * VARIABLE_COUNT + column] = value;","var largest = 0.0;","var change = 0.0;","for (var entry = 0u; entry < COEFFICIENT_COUNT; entry++) {","  let value = state[stateOffset + MATRIX + entry];","  largest = max(largest, max(abs(value), abs(previous[entry])));","  change = max(change, abs(value - previous[entry]));","state[stateOffset + ITERATION] += 1.0;","var relativeChange = 0.0;","if (largest > 0.0) { relativeChange = change / largest; }","state[stateOffset + CHANGE] = relativeChange;","if (change <= parameters[parametersOffset] * largest) { state[stateOffset + CONVERGED] = 1.0; }","@group(0) @binding(0) var<storage, read_write> state: array<f32>;","@group(0) @binding(1) var<storage, read_write> dispatch: array<u32>;","if (state[stateOffset + VALIDITY] == 0.0 || state[stateOffset + CONVERGED] != 0.0) { dispatch[dispatchOffset + 0u] = 0u; }","const matricesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> matrices: array<f32>;","const loadingsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> loadings: array<f32>;","const diagnosticsOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> diagnostics: array<f32>;","  _ = &matrices;","  _ = &loadings;","  _ = &diagnostics;","var residual = 0.0;","if (state[stateOffset + VALIDITY] != 0.0) {","  for (var bin = 0u; bin < BIN_COUNT; bin++) {","    if (!usableBin(bin)) { continue; }","    let weight = f32(pairCounts[pairCountsOffset + bin]) / state[stateOffset + WEIGHT];","        var predicted = 0.0;","        for (var structure = 0u; structure < STRUCTURE_COUNT; structure++) {","          predicted += structureShape(structure, distances[distancesOffset + bin]) * state[stateOffset + MATRIX + structure * SQUARE_COUNT + row * VARIABLE_COUNT + column];","        let difference = predicted - semivariances[semivariancesOffset + bin * TRIANGLE_COUNT + triangle];","        residual += weight * difference * difference * select(2.0, 1.0, row == column);","  if (!isFiniteValue(residual)) { state[stateOffset + VALIDITY] = 0.0; }","let valid = state[stateOffset + VALIDITY] != 0.0;","  matrices[matricesOffset + entry] = select(getNaN(), state[stateOffset + MATRIX + entry], valid);","  loadings[loadingsOffset + entry] = select(getNaN(), state[stateOffset + LOADING + entry], valid);","diagnostics[diagnosticsOffset] = select(getNaN(), residual, valid);","diagnostics[diagnosticsOffset + 1u] = select(getNaN(), state[stateOffset + CHANGE], valid);","diagnostics[diagnosticsOffset + 2u] = state[stateOffset + USABLE];","diagnostics[diagnosticsOffset + 3u] = state[stateOffset + WEIGHT];","const validityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> validity: array<u32>;","const iterationCountOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> iterationCount: array<u32>;","const convergedOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> converged: array<u32>;","const iterationLimitReachedOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> iterationLimitReached: array<u32>;","const invalidCountOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> invalidCount: array<u32>;","  _ = &validity;","  _ = &iterationCount;","  _ = &converged;","  _ = &iterationLimitReached;","  _ = &invalidCount;","validity[validityOffset] = u32(valid);","iterationCount[iterationCountOffset] = u32(state[stateOffset + ITERATION]);","converged[convergedOffset] = u32(valid && state[stateOffset + CONVERGED] != 0.0);","iterationLimitReached[iterationLimitReachedOffset] = u32(valid && state[stateOffset + CONVERGED] == 0.0 && state[stateOffset + ITERATION] >= 8.0);","invalidCount[invalidCountOffset] = u32(state[stateOffset + INVALID]);"],"strings":["coregionalization-fit-state","coregionalization-fit-dispatch","GPUCoregionalizationFit","read_write","parameters","gpu-dataframe.coregionalization-fit-snapshot-tap","compute","state","read","buffer","coregionalization-fit-publish-status","logical","imported","coregionalization-fit-initialize","coregionalization-fit-publish-fit","dispatch","coregionalization-fit-dispatch-0","coregionalization-fit-gate-0","coregionalization-fit-gate-1","coregionalization-fit-gate-2","coregionalization-fit-gate-3","coregionalization-fit-gate-4","coregionalization-fit-gate-5","coregionalization-fit-gate-6","distances","indirect","semivariances","wgsl:6b5c9648","wgsl:ea613cfa","converged","coregionalization-fit-gate-7","diagnostics","loadings","matrices","validity","coregionalization-fit-sweep-0","coregionalization-fit-sweep-1","coregionalization-fit-sweep-2","coregionalization-fit-sweep-3","coregionalization-fit-sweep-4","coregionalization-fit-sweep-5","coregionalization-fit-sweep-6","coregionalization-fit-sweep-7","invalid-count","iteration-count","iteration-limit-reached","pair-counts","pairCounts","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","condition","attrs"],["id","source","mode","resource"],["id","