h N_h},\\quad B_s=L_sL_s^T","ascii":"Pair-weighted Frobenius least squares of complete direct/cross variogram matrices with fixed basic semivariograms g_s(h) = nugget_s + sill_s * shape_s(h/range_s). Off-diagonal errors count twice. Sequential residual fits project each B_s onto the PSD cone from a zero start; a budget exit publishes the current PSD fit. Spherical, exponential, Gaussian and Matern 3/2 and 5/2 use effective ranges; small-argument series preserve Matern shapes.","symbols":[{"id":"matrices","role":"output","binding":"wgsl:matrices"}]}],"sources":[{"id":"wgsl:7565ff83","language":"wgsl","moduleId":"GPUCoregionalizationFit","hash":"7565ff83","bodyHash":"c7e1bcee","entryPoint":"main","textLines":[[0,16],0,[16,16],0,32,0,0,[33,5],0,0,[38,7],37,[45,3],43,[48,9],43,[57,2],41,59,43,60,37,0,[61,4],43,65,37,[66,3],37,0,[69,19],43,[88,8],37,[96,2],67,[98,7],37,105,91,[106,6],55,[112,8],55,43,37,[120,2],37,97,122,37,[123,4],37]},{"id":"wgsl:6b5c9648","language":"wgsl","moduleId":"GPUCoregionalizationFit","hash":"6b5c9648","bodyHash":"af306281","entryPoint":"main","textLines":[[0,4],10,127,12,128,0,[16,16],0,32,0,0,[33,5],0,0,[129,5],37,0,[134,3],131,[137,16],119,153,55,43,[147,2],[154,3],55,43,[157,14],119,55,[171,2],55,[173,2],172,55,[175,17],181,187,[192,4],181,[196,2],187,[198,4],181,119,55,43,[202,2],43,[204,6],119,55,[210,8],119,55,43,218,37,0,0,[69,5],[77,2],[80,8],43,88,[219,2],97,[221,5],110,226,55,227,43,[228,7],55,43,[230,2],[235,4],119,[239,2],55,43,37,[241,6],37,[247,5],37]},{"id":"wgsl:ea613cfa","language":"wgsl","moduleId":"GPUCoregionalizationFit","hash":"ea613cfa","bodyHash":"8d841aa8","entryPoint":"main","textLines":[[0,4],12,252,14,253,0,[16,16],0,32,0,0,[33,5],0,0,[69,5],[78,10],43,88,254,37]},{"id":"wgsl:c7437ca2","language":"wgsl","moduleId":"GPUCoregionalizationFit","hash":"c7437ca2","bodyHash":"7e5c5746","entryPoint":"main","textLines":[[0,14],[255,6],0,[16,16],0,32,0,0,[33,5],0,0,[38,7],37,[45,3],43,[48,9],43,[57,2],41,59,43,60,37,0,[61,4]