 && isFiniteBits(secondValues[secondValuesOffset + row])","    ;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &values;","  _ = &parameters;","  _ = &secondValues;","  _ = &partials;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let focus = index / 2u; let bin = index % 2u;","let maximumDistance = parameters[parametersOffset];","let maximumTime = 1.0;","var sum = 0.0; var count = 0.0;","if (included(focus) && maximumDistance > 0.0 && isFiniteBits(maximumDistance) && maximumTime > 0.0 && isFiniteBits(maximumTime)) {","  for (var neighbor = focus + 1u; neighbor < 4u; neighbor++) {","    if (!included(neighbor)) { continue; }","    let delta = vec2<f32>(positions[positionsOffset + 2u * focus] - positions[positionsOffset + 2u * neighbor], positions[positionsOffset + 2u * focus + 1u] - positions[positionsOffset + 2u * neighbor + 1u]);","    let distance = length(delta);","    let time = 0.0;","    if (!isFiniteBits(distance) || distance > maximumDistance || time > maximumTime) { continue; }","    let spatialBin = min(u32(distance / maximumDistance * 2.0), 1u);","    let temporalBin = min(u32(time / maximumTime * 1.0), 0u);","    if (spatialBin * 1u + temporalBin != bin) { continue; }","    let difference = values[valuesOffset + focus] - values[valuesOffset + neighbor];","    let secondDifference = secondValues[secondValuesOffset + focus] - secondValues[secondValuesOffset + neighbor];","    sum += 0.5 * difference * secondDifference; count += 1.0;","partials[partialsOffset + index * 2u] = sum; partials[partialsOffset + index * 2u + 1u] = count;","@group(0) @binding(0) var<storage, read> partials: array<f32>;","const resultOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> result: array<f32>;","const countsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> counts: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> status: array<u32>;","  _ = &result;","  _ = &counts;","  _ = &status;","  var sum = 0.0; var count = 0u;","for (var row = 0u; row < 4u; row++) { let base = partialsOffset + (row * 2u + index) * 2u; sum += partials[base]; count += u32(partials[base + 1u]); }","let value = sum / f32(count);","result[resultOffset + index] = select(getNaN(), value, count > 0u && isFiniteBits(value));","counts[countsOffset + index] = count;","status[statusOffset + index] = select(select(2u, 0u, isFiniteBits(value)), 1u, count == 0u);"],"strings":["cross-variogram-pairs","cross-variogram-finish","buffer","cross-variogram-partials","read","status","GPUCrossVariogram","imported","pairCounts","parameters","positions","read_write","secondValues","semivariances","transient","values","compute","cross-variogram","partials"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[]}}
