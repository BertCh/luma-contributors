eys;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  boundKeys[boundKeysOffset + index] = select(0u, 0xffffffffu, index < 2u);","}","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const valuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> values: array<f32>;","const secondValuesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> secondValues: array<f32>;","const inclusionOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> inclusion: array<u32>;","@group(0) @binding(4) var<storage, read_write> boundKeys: array<atomic<u32>>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// A runtime operand keeps the quiet-NaN bit pattern out of constant evaluation.","fn getQuietNaN(seed: u32) -> f32 { return bitcast<f32>(0x7fc00000u | (seed & 0u)); }","fn getOrderedFloatKey(value: f32) -> u32 {","  let bits = bitcast<u32>(value);","  return select(bits | 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","fn getOrderedFloatValue(key: u32) -> f32 {","  return bitcast<f32>(select(~key, key & 0x7fffffffu, (key & 0x80000000u) != 0u));","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","  _ = &positions;","  _ = &values;","  _ = &secondValues;","  _ = &inclusion;","  let x = positions[positionsOffset + 2u * index];","let y = positions[positionsOffset + 2u * index + 1u];","let value = values[valuesOffset + index];","let secondValue = secondValues[secondValuesOffset + index];","let time = 0.0;","let included =  isFiniteBits(x) && isFiniteBits(y) && isFiniteBits(value) && isFiniteBits(secondValue) && isFiniteBits(time);","inclusion[inclusionOffset + index] = select(0u, 1u, included);","if (included) {","  atomicMin(&boundKeys[boundKeysOffset], getOrderedFloatKey(x));","  atomicMin(&boundKeys[boundKeysOffset + 1u], getOrderedFloatKey(y));","  atomicMax(&boundKeys[boundKeysOffset + 2u], getOrderedFloatKey(x));","  atomicMax(&boundKeys[boundKeysOffset + 3u], getOrderedFloatKey(y));","@group(0) @binding(0) var<storage, read> boundKeys: array<u32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> parameters: array<f32>;","const gridParametersOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> gridParameters: array<f32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","  _ = &parameters;","  _ = &gridParameters;","  let maximumDistance = parameters[parametersOffset];","let maximumTime = 1.0;","var value = 0.0;","if (index < 4u) { value = getOrderedFloatValue(boundKeys[boundKeysOffset + index]); }","if (index == 4u) { value = select(getNaN(), maximumDistance, maximumTime > 0.0 && isFiniteBits(maximumTime)); }","if (index == 5u) { value = maximumTime; }","gridParameters[gridParametersOffset + index] = value;","@group(0) @binding(0) var<storage, read> values: array<f32>;","@group(0) @binding(1) var<storage, read> secondValues: array<f32>;","const maskOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> mask: array<u32>;","const rowTableOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> rowTable: array<f32>;","  _ = &mask;","  _ = &rowTable;","  rowTable[rowTableOffset + index * 3u] = select(getNaN(), values[valuesOffset + index], mask[maskOffset + index] != 0u);","rowTable[rowTableOffset + index * 3u + 1u] = secondValues[secondValuesOffset + index];","rowTable[rowTableOffset + index * 3u + 2u] = 0.0;","const cellKeysOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> cellKeys: array<u32>;","const rowIdsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> rowIds: array<u32>;","const COLUMNS: u32 = 256u;","const ROWS: u32 = 256u;","const CELL_COUNT: u32 = 65536u;","const CELL_MARGIN: f32 = 1.0009765625;","struct Lattice {","  valid: bool,","  minimumX: f32,","  minimumY: f32,","  maximumX: f32,","  maximumY: f32,","  cellWidth: f32,","  cellHeight: f32,","  columns: u32,","  rows: u32,","  maximumDistance: f32,","  radiusSquared: f32","fn readParameter(slot: u32) -> f32 {","  return parameters[parametersOffset + slot];","fn readLattice() -> Lattice {","  var lattice: Lattice;","  lattice.cellWidth = 1.0;","  lattice.cellHeight = 1.0;","  lattice.columns = 1u;","  lattice.rows = 1u;","  lattice.radiusSquared = 0.0;","  let minimumX = readParameter(0u);","  let minimumY = readParameter(1u);","  let maximumX = readParameter(2u);","  let maximumY = readParameter(3u);","  let radius = readParameter(4u);","  let width = maximumX - minimumX;","  let height = maximumY - minimumY;","  let radiusSquared = radius * radius;","  let cellRadius = radius * CELL_MARGIN;","  lattice.valid =","    isFiniteValue(minimumX) && isFiniteValue(minimumY) && isFiniteValue(maximumX) &&","    isFiniteValue(maximumY) && isFiniteValue(radius) &&","    radius > 0.0 && width >= 0.0 && height >= 0.0;","  if (!lattice.valid) {","    return lattice;","  lattice.minimumX = minimumX;","  lattice.minimumY = minimumY;","  lattice.maximumX = maximumX;","  lattice.maximumY = maximumY;","  lattice.maximumDistance = radius;","  lattice.radiusSquared = radiusSquared;","  // Keep all candidates when a finite-input lattice cannot represent its extent or radius.","  // Single-cell lookups below avoid subtracting the overflowing bounds again.","  if (!isFiniteValue(width) || !isFiniteValue(height) || !isFiniteValue(radiusSquared)) {","  lattice.cellWidth = max(width / f32(COLUMNS), cellRadius);","  lattice.cellHeight = max(height / f32(ROWS), cellRadius);","  lattice.columns = min(COLUMNS - 1u, u32(floor(width / lattice.cellWidth))) + 1u;","  lattice.rows = min(ROWS - 1u, u32(floor(height / lattice.cellHeight))) + 1u;","  return lattice;","fn isPointValid(lattice: Lattice, x: f32, y: f32) -> bool {","  return lattice.valid && isFiniteValue(x) && isFiniteValue(y) &&","    x >= lattice.minimumX && x <= lattice.maximumX &&","    y >= lattice.minimumY && y <= lattice.maximumY;","fn getCellColumn(lattice: Lattice, x: f32) -> u32 {","  if (lattice.columns == 1u) { return 0u; }","  return min(u32(floor((x - lattice.minimumX) / lattice.cellWidth)), lattice.columns - 1u);","fn getCellRow(lattice: Lattice, y: f32) -> u32 {","  if (lattice.rows == 1u) { return 0u; }","  return min(u32(floor((y - lattice.minimumY) / lattice.cellHeight)), lattice.rows - 1u);","  _ = &cellKeys;","  _ = &rowIds;","  let lattice = readLattice();","  let x = positions[positionsOffset + index * 2u];","  let y = positions[positionsOffset + index * 2u + 1u];","  let included = mask[maskOffset + index] != 0u;","  ","  let valid = included &&  isPointValid(lattice, x, y);","  var key = CELL_COUNT;","  if (valid) {","    key = getCellRow(lattice, y) * lattice.columns + getCellColumn(lattice, x);","  cellKeys[cellKeysOffset + index] = key;","  rowIds[rowIdsOffset + index] = index;","const countsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const cellOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> cellOffsets: array<u32>;","const gridCountOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> gridCount: array<u32>;","const gridOverflowOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> gridOverflow: array<u32>;","const LAST_CELL: u32 = 65535u;","  _ = &counts;","  _ = &cellOffsets;","  _ = &gridCount;","  _ = &gridOverflow;","  let count = cellOffsets[cellOffsetsOffset + LAST_CELL] + counts[countsOffset + LAST_CELL];","  cellOffsets[cellOffsetsOffset + LAST_CELL + 1u] = count;","  gridCount[gridCountOffset] = count;","  gridOverflow[gridOverflowOffset] = 0u;","@group(0) @binding(1) var<storage, read> rowTable: array<f32>;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","@group(0) @binding(3) var<storage, read> cellOffsets: array<u32>;","const sortedRowsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> sortedRows: array<u32>;","const sumsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> sums: array<f32>;","@group(0) @binding(6) var<storage, read_write> counts: array<u32>;","const BINS: u32 = 2u;","  _ = &sortedRows;","  _ = &sums;","  var localSums: array<f32, BINS>;","var localCounts: array<u32, BINS>;","let lattice = readLattice();","let focus = index;","let focusX = positions[positionsOffset + 2u * focus];","let focusY = positions[positionsOffset + 2u * focus + 1u];","var focusKey = CELL_COUNT;","if (isPointValid(lattice, focusX, focusY) && isFiniteBits(rowTable[rowTableOffset + focus * 3u])) {","  focusKey = getCellRow(lattice, focusY) * lattice.columns + getCellColumn(lattice, focusX);","let maximumDistance = parameters[parametersOffset + 4u];","let maximumTime = parameters[parametersOffset + 5u];","if (lattice.valid && focusKey < CELL_COUNT) {","  // Literal initializers avoid the GPU back-end's constant-loop integer-array store loss.","  var cursorSlots = array<u32, 9>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);","  var endSlots = array<u32, 9>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);","  var activeCellCount = 0u;","  let focusColumn = i32(focusKey % lattice.columns);","  let focusRow = i32(focusKey / lattice.columns);","  let lastCellRow = min(focusRow + 1, i32(lattice.rows) - 1);","  let lastCellColumn = min(focusColumn + 1, i32(lattice.columns) - 1);","  for (var cellRow = max(focusRow - 1, 0); cellRow <= lastCellRow; cellRow++) {","    for (var cellColumn = max(focusColumn - 1, 0); cellColumn <= lastCellColumn; cellColumn++) {","      let cell = u32(cellRow) * lattice.columns + u32(cellColumn);","      let begin = cellOffsets[cellOffsetsOffset + cell];","      let end = cellOffsets[cellOffsetsOffset + cell + 1u];","      if (begin < end) {","        cursorSlots[activeCellCount] = begin;","        endSlots[activeCellCount] = end;","        activeCellCount++;","      }","    }","  loop {","    var neighbor = 0xffffffffu;","    var selectedCell = 0xffffffffu;","    for (var cellIndex = 0u; cellIndex < activeCellCount; cellIndex++) {","      let cursor = cursorSlots[cellIndex];","      if (cursor < endSlots[cellIndex]) {","        let candidate = sortedRows[sortedRowsOffset + cursor];","        if (candidate < neighbor) {","          neighbor = candidate;","          selectedCell = cellIndex;","        }","    if (selectedCell == 0xffffffffu) { break; }","    cursorSlots[selectedCell]++;","    if (neighbor <= focus) { continue; }","let delta = vec2f(positions[positionsOffset + 2u * focus] - positions[positionsOffset + 2u * neighbor], positions[positionsOffset + 2u * focus + 1u] - positions[positionsOffset + 2u * neighbor + 1u]);","let distance = length(delta);","let time = abs(rowTable[rowTableOffset + focus * 3u + 2u] - rowTable[rowTableOffset + neighbor * 3u + 2u]);","if (!isFiniteBits(distance) || distance > maximumDistance || time > maximumTime) { continue; }","let spatialBin = min(u32(distance / maximumDistance * 2.0), 1u);","let temporalBin = min(u32(time / maximumTime * 1.0), 0u);","let bin = spatialBin * 1u + temporalBin;","let difference = rowTable[rowTableOffset + focus * 3u] - rowTable[rowTableOffset + neighbor * 3u];","let secondDifference = rowTable[rowTableOffset + focus * 3u + 1u] - rowTable[rowTableOffset + neighbor * 3u + 1u];","localSums[bin] += 0.5 * difference * secondDifference;","localCounts[bin] += 1u;","for (var bin = 0u; bin < BINS; bin++) {","  sums[sumsOffset + bin * 4u + focus] = localSums[bin];","  counts[countsOffset + bin * 4u + focus] = localCounts[bin];","@group(0) @binding(0) var<storage, read> entries: array<f32>;","var<private> entriesOffset: u32;","@group(0) @binding(1) var<storage, read_write> totals: array<f32>;","var<private> totalsOffset: u32;","struct GraphChunkGroupParameters { words: array<vec4<u32>, 16> }","@group(0) @binding(2) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","fn getChunkParameter(word: u32) -> u32 { return graphChunkGroupParameters.words[word / 4u][word % 4u]; }","fn readTotalParameter(slot: u32) -> u32 { return getChunkParameter(36u + slot); }","@compute @workgroup_size(256)","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(num_workgroups) workgroupCount: vec3<u32>,","  @builtin(local_invocation_index) localInvocationIndex: u32) {","  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  entriesOffset = getChunkParameter(4u);","  totalsOffset = getChunkParameter(5u);","  let groupCount = readTotalParameter(0u); let entryCount = readTotalParameter(1u);","  let segmentCount = readTotalParameter(2u);","  let segment = index / groupCount; let group = index % groupCount;","  let begin = segment * entryCount + group * 256u;","  let end = segment * entryCount + min((group + 1u) * 256u, entryCount);","  var total = f32(0);","  for (var entry = begin; entry < end; entry++) { total += entries[entriesOffset + entry]; }","  totals[totalsOffset + index] = total; ","@group(0) @binding(0) var<storage, read> entries: array<u32>;","@group(0) @binding(1) var<storage, read_write> totals: array<u32>;","  var total = u32(0);","  var overflow = 0u;","  for (var entry = begin; entry < end; entry++) {","    let value = entries[entriesOffset + entry];","    let exceeds = value > 0xffffffffu - total;","    total = select(total + value, 0xffffffffu, exceeds);","    overflow |= u32(exceeds);","    if (readTotalParameter(3u) != 0u) { overflow |= entries[entriesOffset + segmentCount * entryCount + entry]; }","  totals[totalsOffset + index] = total;","  totals[totalsOffset + (segmentCount * groupCount) + index] = overflow; ","const totalSumsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> totalSums: array<f32>;","const totalCountsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> totalCounts: array<u32>;","const semivariancesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> semivariances: array<f32>;","const pairCountsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> pairCounts: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","  _ = &totalSums;","  _ = &totalCounts;","  _ = &semivariances;","  _ = &pairCounts;","  _ = &status;","  let count = totalCounts[totalCountsOffset + index];","let overflow = totalCounts[totalCountsOffset + 2u + index] != 0u;","let value = totalSums[totalSumsOffset + index] / f32(count);","semivariances[semivariancesOffset + index] = select(getNaN(), value, count > 0u && isFiniteBits(value) && !overflow);","pairCounts[pairCountsOffset + index] = count;","status[statusOffset + index] = select(select(select(2u, 0u, isFiniteBits(value)), 1u, count == 0u), 3u, overflow);"],"strings":["buffer","logical","read","cross-variogram-inclusion","cross-variogram-grid-parameters","cross-variogram-empirical-cell-keys","transient","read_write","GPUCrossVariogram","compute","cross-variogram-empirical-legacy-pairs","cross-variogram-empirical-legacy-rows","cross-variogram-empirical-cell-offsets","cross-variogram-empirical-legacy-finish","cross-variogram-bound-keys","positions","cross-variogram-empirical-cell-counts","cross-variogram-empirical-cell-sort-bitonic-local","cross-variogram-empirical-cell-total","gpu-dataframe.cross-variogram-snapshot-tap","values","cross-variogram-empirical-cell-scan-level-0-scan","cross-variogram-empirical-legacy-counts","cross-variogram-empirical-legacy-sums","cross-vari