ribute; stored sum is zero for empty input; float32 accumulation rounds each addition","symbols":[{"id":"sum","role":"output","binding":"wgsl:outputValues"},{"id":"value","role":"input","binding":"wgsl:inputValues"},{"id":"accepted","role":"input","binding":"wgsl:selectionMask"},{"id":"key","role":"input","binding":"wgsl:groupKeys"}]},{"id":"gpu-core.compaction","tex":"\\term{offsets}{o_i}=\\sum_{j<i}\\term{flags}{f_j}\\bmod2^{32},\\quad\\term{y}{y_{o_i}}=\\term{x}{x_i}\\ (f_i\\ne0),\\quad\\term{count}{c}=o_{n-1}+\\operatorname{min}(f_{n-1},1)","ascii":"o[i]=exclusive uint32 scan(flags); if flags[i]!=0 and o[i] is in output capacity, y[o[i]]=x[i]. count=(o[n-1]+min(flags[n-1],1)) mod 2^32, empty=0. Dense stable compaction requires binary flags; raw nonbinary flags leave gaps.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"y","role":"output","binding":"wgsl:outputValues"},{"id":"flags","role":"input","binding":"wgsl:flags"},{"id":"offsets","role":"intermediate","binding":"wgsl:offsets"},{"id":"count","role":"output","binding":"wgsl:outputCount"}],"derivation":"curated"},{"id":"gpu-core.group-aggregation","tex":"S_g=\\{i:\\term{keys}{k_i}=g,\\term{mask}{m_i}\\ne0\\},\\quad\\term{y}{y_g}=\\operatorname{op}_{i\\in S_g}\\term{x}{x_i},\\quad\\term{counts}{n_g}=|S_g|","ascii":"Dense groups g<groupCount; ignore out-of-range keys and zero mask (missing mask selects all). count counts rows without values; sum|min|max|mean accept only finite f32 values and optional counts count those values. sum[g]=sum(x), mean=sum/count; empty count/sum=0, empty min/max/mean=NaN.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"y","role":"output","binding":"wgsl:outputValues"},{"id":"keys","role":"input","binding":"wgsl:groupKeys"},{"id":"mask","role":"input","binding":"wgsl:selectionMask"},{"id":"counts","role":"output","binding":"wgsl:outputCounts"}],"derivation":"curated"},{"id":"gpu-core.scan","tex":"\\term{y}{y_i}=\\left(\\sum_{j=s(i)}^{i-1+\\delta}\\term{x}{x_j}\\right)\\bmod 2^{32},\\quad s(i)=\\max(\\{0\\}\\cup\\{j\\le i:\\term{heads}{h_j}\\ne0\\})","ascii":"y[i] = sum(x[s(i)..i-1+delta]) mod 2^32; delta=0 exclusive (default), 1 inclusive; s(i) is the last nonzero segment flag or 0.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"y","role":"output","binding":"wgsl:outputValues"},{"id":"heads","role":"input","binding":"wgsl:segmentFlags"}],"derivation":"curated"}],"sources":[{"id":"wgsl:7c829855","language":"wgsl","moduleId":"GPUDataFrameQuery/predicate","hash":"7c829855","bodyHash":"01f2d9c0","entryPoint":"main","textLines":[[0,4],0,[4,12],[15,3]]},{"id":"wgsl:a50fe850","language":"wgsl","moduleId":"GPUGroupAggregation/clear","hash":"a50fe850","entryPoint":"main","constants":{"GROUP_COUNT":10,"OUTPUT_OFFSET":0,"DISPATCH_X":1,"DISPATCH_Y":1},"textLines":[0,[18,5],0,[4,5],23,[10,2],[24,2],14,17]},{"id":"wgsl:7be2ce12","language":"wgsl","moduleId":"GPUGroupAggregation/clear","hash":"7be2ce12","entryPoint":"main","constants":{"GROUP_COUNT":10,"OUTPUT_OFFSET":0,"DISPATCH_X":1,"DISPATCH_Y":1},"textLines":[0,[18,4],[26,2],[6,3],23,[10,2],24,[28,2],14,17]},{"id":"wgsl:8d118777","language":"wgsl","moduleId":"GPUGroupAggregation/initialize","hash":"8d118777","entryPoint":"main","constants":{"GROUP_COUNT":10,"OUTPUT_OFFSET":0,"COUNTS_OFFSET":0,"DISPATCH_X":1,"DISPATCH_Y":1},"textLines":[0,[18,2],30,[20,2],26,31,27,[6,3],23,[10,2],24,28,32,14,17]},{"id":"wgsl:7894ab16","language":"wgsl","moduleId":"GPUCompaction/block-count/subgroups","hash":"7894ab16","entryPoint":"main","constants":{"ELEMENT_COUNT":1500,"BLOCK_COUNT":2,"FLAGS_OFFSET":0,"BLOCK_COUNTS_OFFSET":0,"DISPATCH_X":2,"DISPATCH_Y":1},"textLines":[0,[33,2],0,[35,4],[20,2],[39,3],0,27,[42,3],[7,2],45,23,[46,7],14,[53,7],52,60,14,17]},{"id":"wgsl:b2c969aa","language":"wgsl","moduleId":"GPUGroupAggregation/count/local/subgroups","hash":"b2c969aa","entryPoint":"main","constants":{"ELEMENT_COUNT":1500,"GROUP_COUNT":10,"KEYS_OFFS