s(mask.y); }","  if (word > 2u) { count += countOneBits(mask.z); }","  let lowerBits = (1u << bit) - 1u;","  return count + countOneBits(mask[word] & lowerBits);","  @builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(local_invocation_id) localId: vec3<u32>,","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32","  let index = workgroupIndex * 256u + localId.x;","  let lane = localId.x;","  if (lane < GROUP_COUNT) { atomicStore(&localCounts[lane], 0u); }","  var accepted = false;","  var groupIndex = 0u;","  if (index < ELEMENT_COUNT && selectionMask[MASK_OFFSET + index * MASK_STRIDE] != 0u) {","    groupIndex = groupKeys[KEYS_OFFSET + index * KEYS_STRIDE];","    accepted = groupIndex < GROUP_COUNT;","  var subgroupPending = accepted;","  for (var subgroupGroup = 0u; subgroupGroup < GROUP_COUNT; subgroupGroup++) {","    let pendingBallot = subgroupBallot(subgroupPending);","    let hasPending = any(pendingBallot != vec4<u32>(0u));","    let leaderInvocation = getFirstBallotLane(pendingBallot);","    let leaderKey = subgroupShuffle(groupIndex, leaderInvocation);","    let matchingKey = hasPending && subgroupPending && groupIndex == leaderKey;","    let matchingBallot = subgroupBallot(matchingKey);","    if (hasPending && subgroupInvocationId == leaderInvocation) {","      atomicAdd(&localCounts[leaderKey], getBallotLaneCount(matchingBallot));","    subgroupPending = subgroupPending && !matchingKey;","  if (lane < GROUP_COUNT) {","    atomicAdd(&outputCounts[OUTPUT_OFFSET + lane], atomicLoad(&localCounts[lane]));","override INPUT_OFFSET: u32;","override SUM_OFFSET: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sumValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","  let index = workgroupIndex * 256u + lane;","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = 