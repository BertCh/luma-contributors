FFSET":0,"FLAGS_OFFSET":0,"OUTPUT_OFFSET":0,"BLOCK_OFFSETS_OFFSET":0,"DISPATCH_X":2,"DISPATCH_Y":1},"textLines":[0,[33,2],0,[35,2],111,37,19,156,[20,2],113,[157,3],41,0,27,[42,3],[7,2],45,23,[46,2],[160,2],[48,3],[162,4],52,14,166,[53,4],167,58,[168,3],52,29,14,55,[171,2],49,[173,3],52,14,17]},{"id":"wgsl:dde786e5","language":"wgsl","moduleId":"GPUGroupAggregation/finalize-mean","hash":"dde786e5","entryPoint":"main","constants":{"GROUP_COUNT":10,"OUTPUT_OFFSET":0,"COUNTS_OFFSET":0,"DISPATCH_X":1,"DISPATCH_Y":1},"textLines":[0,[18,2],30,[20,2],[176,2],0,27,[6,3],23,[10,2],24,[178,6],52,14,17]}]},"decisions":[],"choices":[{"stage":"group","name":"groupCount","value":10,"sweepable":false},{"stage":"aggregate","name":"operations","value":"count, sum, mean","sweepable":false,"alternatives":["count","sum","min","max","mean"]}],"captures":{"schema":"luma.computation-captures/1","runId":"run-6681e1a6","snapshots":[{"id":"category","name":"category","keySpace":"row","role":"input","values":"b64:","elementType":"u32","provenance":"gpu-readback"},{"id":"researchGrade","name":"researchGrade","keySpace":"row","role":"input","values":"rle:AAAAAAAAgD8AAIA/AACAPwAAgD8AAIA/AAAAAAAAgD8AAIA/AACAPwAAgD8AAAAAAACAPwAAgD8AAAAAAACAPwAAgD8AAIA/AAAAAAAAgD8AAAAAAACAPwAAAAAAAIA/AACAPwAAgD8AAIA/AAAAAA==,*17:3f800000,,*27:3f800000,,*21:3f800000,AAAAAAAAAAAAAAAAAACAPw==","elementType":"f32","provenance":"gpu-readback"},{"id":"groupKey","name":"groupKey","keySpace":"group","role":"output","values":"b64:AAAAAAEAAAACAAAAAwAAAAQAAAAFAAAABgAAAAcAAAAIAAAACQAAAA==","elementType":"u32","provenance":"gpu-readback"},{"id":"count","name":"count","keySpace":"group","role":"output","values":"b64:+QEAAIABAAB1AQAAgQAAACMAAAAiAAAADAAAAAUAAAAFAAAAEgAAAA==","elementType":"u32","provenance":"gpu-readback"},{"id":"sum","name":"sum","keySpace":"group","role":"output","values":"b64:AAB/QwAAuUMAAGtDAADYQQAAAEIAAEBBAAAwQQAAgD8AAEBAAACgQA==","elementType":"f32","provenance":"gpu-readback"},{"id":"mean","name":"mean","keySpace":"group","role":"output","values":"b64:cEQBP6uqdj9wSSE/WVNWPqEOaj+1tLQ+q6pqP83MTD6amRk/5DiOPg==","elementType":"f32","provenance":"gpu-readback"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","const ELEMENT_COUNT: u32 = 1500u;","const OUTPUT_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> outputMask: array<u32>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 6u + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= ELEMENT_COUNT) {","    return;","  }","  ","  outputMask[OUTPUT_OFFSET + index] = select(0u, 1u, true);","}","override GROUP_COUNT: u32;","override OUTPUT_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read_write> outputCounts: array<atomic<u32>>;","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  if (index < GROUP_COUNT) {","    atomicStore(&outputCounts[OUTPUT_OFFSET + index], 0u);","@group(0) @binding(0) var<storage, read_write> outputValues: array<atomic<u32>>;","@compute @workgroup_size(256) fn main(","    atomicStore(&outputValues[OUTPUT_OFFSET + index], 0u);","    ","override COUNTS_OFFSET: u32;","@group(0) @binding(1) var<storage, read_write> outputCounts: array<atomic<u32>>;","    atomicStore(&outputCounts[COUNTS_OFFSET + index], 0u);","enable subgroups;","requires subgroup_id;","override ELEMENT_COUNT: u32;","override BLOCK_COUNT: u32;","override FLAGS_OFFSET: u32;","override BLOCK_COUNTS_OFFSET: u32;","@group(0) @binding(0) var<storage, read> flags: array<u32>;","@group(0) @binding(1) var<storage, read_write> blockCounts: array<u32>;","var<workgroup> subgroupTotals: array<u32, 64>;","  @builtin(subgroup_invocation_id) subgroupInvocat