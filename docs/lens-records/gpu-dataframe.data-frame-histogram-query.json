u32(((x-min)/(max-min))*B), B-1); max is included, a degenerate domain maps to bin 0; explicit edges use bisect-right with the last edge included; masked, null, nonfinite and out-of-domain rows are skipped","symbols":[{"id":"count","role":"output","binding":"wgsl:outputCounts"},{"id":"accepted","role":"intermediate","binding":"wgsl:accepted"},{"id":"bin","role":"intermediate","binding":"wgsl:binIndex"},{"id":"binCount","role":"parameter","binding":"wgsl:BIN_COUNT"},{"id":"value","role":"input","binding":"wgsl:inputValues"},{"id":"minimum","role":"parameter","binding":"wgsl:minimum"},{"id":"maximum","role":"parameter","binding":"wgsl:maximum"}]},{"id":"gpu-core.compaction","tex":"\\term{offsets}{o_i}=\\sum_{j<i}\\term{flags}{f_j}\\bmod2^{32},\\quad\\term{y}{y_{o_i}}=\\term{x}{x_i}\\ (f_i\\ne0),\\quad\\term{count}{c}=o_{n-1}+\\operatorname{min}(f_{n-1},1)","ascii":"o[i]=exclusive uint32 scan(flags); if flags[i]!=0 and o[i] is in output capacity, y[o[i]]=x[i]. count=(o[n-1]+min(flags[n-1],1)) mod 2^32, empty=0. Dense stable compaction requires binary flags; raw nonbinary flags leave gaps.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"y","role":"output","binding":"wgsl:outputValues"},{"id":"flags","role":"input","binding":"wgsl:flags"},{"id":"offsets","role":"intermediate","binding":"wgsl:offsets"},{"id":"count","role":"output","binding":"wgsl:outputCount"}],"derivation":"curated"},{"id":"gpu-core.mask","tex":"\\term{y}{y_i}=\\mathbf1[\\operatorname{op}(b_{0i},\\ldots,b_{mi})],\\quad b_{ji}=[x_{ji}\\ne0]","ascii":"y[i]=0 or 1 after booleanizing inputs by !=0; op is and, or, xor (odd parity), difference (first AND NOT every remaining input), or not (one input).","symbols":[{"id":"y","role":"output","binding":"wgsl:outputMask"}],"derivation":"curated"},{"id":"gpu-core.histogram","tex":"\\term{counts}{H_b}=\\sum_{i\\in S}\\mathbf1[\\operatorname{bin}(\\term{x}{x_i})=b],\\quad\\operatorname{bin}(v)=\\operatorname{min}(B-1,\\lfloor B(v-a)/(z-a)\\rfloor)","ascii":"H[b]=count of finite, mask-selected values in bin b. Reject outside [a,z]. Uniform bins use floor(B*(v-a)/(z-a)), with z in B-1; a=z sends equal values to bin 0. Explicit strictly increasing finite edges use [e[b],e[b+1]), final bin includes last edge; invalid GPU edges yield zeros. Integer uniform binning uses exact multiply/divide floor; float uses f32 arithmetic.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"counts","role":"output","binding":"wgsl:outputCounts"},{"id":"mask","role":"input","binding":"wgsl:selectionMask"},{"id":"edges","role":"parameter","binding":"wgsl:edgeValues"}],"derivation":"curated"}],"sources":[{"id":"wgsl:23dd0e16","language":"wgsl","moduleId":"GPUDataFrameQuery/predicate","hash":"23dd0e16","bodyHash":"01f2d9c0","entryPoint":"main","textLines":[[0,4],0,[4,12],[15,3]]},{"id":"wgsl:d3c5a514","language":"wgsl","moduleId":"GPUHistogram/clear","hash":"d3c5a514","entryPoint":"main","constants":{"BIN_COUNT":8,"OUTPUT_OFFSET":0,"DISPATCH_X":1,"DISPATCH_Y":1},"textLines":[0,[18,6],[6,3],24,[10,2],25,17]},{"id":"wgsl:7d4355eb","language":"wgsl","moduleId":"GPUCompaction/block-scatter/subgroups","hash":"7d4355eb","entryPoint":"main","constants":{"ELEMENT_COUNT":791,"BLOCK_COUNT":1,"INPUT_OFFSET":0,"FLAGS_OFFSET":0,"OUTPUT_OFFSET":0,"COUNT_OFFSET":0,"DISPATCH_X":1,"DISPATCH_Y":1},"textLines":[0,[26,2],0,[28,4],19,32,[20,2],[33,5],0,23,[38,3],[7,2],41,24,[42,12],14,[54,10],53,64,14,57,[65,2],47,[67,3],53,14,17]},{"id":"wgsl:2f947953","language":"wgsl","moduleId":"GPUMask/and","hash":"2f947953","entryPoint":"main","constants":{"ELEMENT_COUNT":791,"OUTPUT_OFFSET":0,"INPUT_0_OFFSET":0,"INPUT_1_OFFSET":0,"DISPATCH_X":4,"DISPATCH_Y":1},"textLines":[0,28,19,[70,2],[20,2],[72,3],0,[4,5],24,[10,5],75,17]},{"id":"wgsl:b5b3ab87","language":"wgsl","moduleId":"GPUHistogram/accumulate/local","hash":"b5b3ab87","entryPoint":"main","constants":{"ELEMENT_COUNT":791,"BIN_COUNT":8,"MULTIPLIER_BIT_COUNT":4,"INPUT_OFFSET":0,"INPUT_STRIDE":1,"OUTPUT_OFFSET":0,"DOMAIN_MINIMUM":0,"DOMAIN_MAXIMUM":256000,"MASK_OFFSET":0,"MASK_STRIDE":1,"DISPATCH_X":4,"DISPATCH_Y":1},"textLines":[0,26,28,18,76,30,77,19,[78,4],[20,2],[82,4],0,0,[86,6],17,0,[92,3],17,0,[95,9],17,0,23,6,[104,2],8,24,[10,2],[106,4],57,[110,36],137,[146,4],53,[14,2],[150,10],53,160,14,57,[161,2],14,17]}]},"decisions":[],"choices":[{"stage":"aggregate","name":"bins","value":8,"sweepable":true},{"stage":"aggregate","name":"domain","value":"0 to 256000","sweepable":false,"alternatives":["edges: strictly increasing literal boundaries"]}],"captures":{"schema":"luma.computation-captures/1","runId":"run-82974102","snapshots":[{"id":"medianHouseholdIncome","name":"medianHouseholdIncome","keySpace":"row","role":"input","values":"b64:","elementType":"f32","meaning":"NaN marks a suppressed Census estimate (invalid sidecar); histograms skip it.","provenance":"gpu-readback"},{"id":"binId","name":"binId","keySpace":"bin","role":"output","values":"b64:AAAAAAEAAAACAAAAAwAAAAQAAAAFAAAABgAAAAcAAAA=","elementType":"u32","provenance":"gpu-readback"},{"id":"count","name":"count","keySpace":"bin","role":"output","values":"b64:OQAAAAUBAADvAAAAcwAAADoAAAAaAAAADAAAAAQAAAA=","elementType":"u32","provenance":"gpu-readback"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","const ELEMENT_COUNT: u32 = 791u;","const OUTPUT_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> outputMask: array<u32>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 4u + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= ELEMENT_COUNT) {","    return;","  }","  ","  outputMask[OUTPUT_OFFSET + index] = select(0u, 1u, true);","}","override BIN_COUNT: u32;","override OUTPUT_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read_write> outputCounts: array<atomic<u32>>;","@compute @workgroup_size(256) fn main(","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  if (index < BIN_COUNT) { atomicStore(&outputCounts[OUTPUT_OFFSET + index], 0u); }","enable subgroups;","requires subgroup_id;","override ELEMENT_COUNT: u32;","override BLOCK_COUNT: u32;","override INPUT_OFFSET: u32;","override FLAGS_OFFSET: u32;","override COUNT_OFFSET: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read> flags: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputCount: array<u32>;","var<workgroup> subgroupTotals: array<u32, 64>;","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  let firstRow = workgroupIndex * 1024u + lane * 4u;","  var rowFlags: array<u32, 4>;","  var rowValues: array<u32, 4>;","  var rowCount = 0u;","  for (var item = 0u; item < 4u; item++) {","    if (firstRow + item < ELEMENT_COUNT) {","      let flag = min(flags[FLAGS_OFFSET + firstRow + item], 1u);","      rowFlags[item] = flag;","      rowCount += flag;","      if (flag != 0u) { rowValues[item] = inputValues[INPUT_OFFSET + firstRow + item]; }","    }","  let subgroupPrefix = subgroupExclusiveAdd(rowCount);","  let subgroupTotal = subgroupAdd(rowCount);","  if (subgroupInvocationId == 0u) { subgroupTotals[subgroupId] = subgroupTotal; }","  workgroupBarrier();","  if (lane == 0u) {","    var runningTotal = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < 256u / subgroupSize; subgroupIndex++) {","      let total = subgroupTotals[subgroupIndex];","      subgroupTotals[subgroupIndex] = runningTotal;","      runningTotal += total;","    outputCount[COUNT_OFFSET] = runningTotal;","  let rowPrefix = subgroupTotals[subgroupId] + subgroupPrefix;","  var outputIndex = rowPrefix;","    if (rowFlags[item] != 0u) {","      outputValues[OUTPUT_OFFSET + outputIndex] = rowValues[item];","      outputIndex += 1u;","override INPUT_0_OFFSET: u32;","override INPUT_1_OFFSET: u32;","@group(0) @binding(0) var<storage, read> input0: array<u32>;","@group(0) @binding(1) var<storage, read> input1: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputMask: array<u32>;","  outputMask[OUTPUT_OFFSET + index] = select(0u, 1u, (input0[INPUT_0_OFFSET + index] != 0u) && (input1[INPUT_1_OFFSET + index] != 0u));","override MULTIPLIER_BIT_COUNT: u32;","override INPUT_STRIDE: u32;","override DOMAIN_MINIMUM: f32;","override DOMAIN_MAXIMUM: f32;","override MASK_OFFSET: u32;","override MASK_STRIDE: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<f32>;","@group(0) @binding(1) var<storage, read> selectionMask: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputCounts: array<atomic<u32>>;","var<workgroup> localCounts: array<atomic<u32>, 256>;","fn getFirstBallotLane(mask: vec4<u32>) -> u32 {","  if (mask.x != 0u) { return firstTrailingBit(mask.x); }","  if (mask.y != 0u) { return 32u + firstTrailingBit(mask.y); }","  if (mask.z != 0u) { return 64u + firstTrailingBit(mask.z); }","  if (mask.w != 0u) { return 96u + firstTrailingBit(mask.w); }","  return 0u;","fn getBallotLaneCount(mask: vec4<u32>) -> u32 {","  return countOneBits(mask.x) + countOneBits(mask.y) +","    countOneBits(mask.z) + countOneBits(mask.w);","fn getBallotPrefixLaneCount(mask: vec4<u32>, invocation: u32) -> u32 {","  let word = invocation >> 5u;","  let bit = invocation & 31u;","  var count = 0u;","  if (word > 0u) { count += countOneBits(mask.x); }","  if (word > 1u) { count += countOneBits(mask.y); }","  if (word > 2u) { count += countOneBits(mask.z); }","  let lowerBits = (1u << bit) - 1u;","  return count + countOneBits(mask[word] & lowerBits);","  @builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32","  let lane = localInvocationIndex;","  let minimum: f32 = DOMAIN_MINIMUM;","  let maximum: f32 = DOMAIN_MAXIMUM;","  if (lane < BIN_COUNT) { atomicStore(&localCounts[lane], 0u); }","  var accepted = false;","  var binIndex = 0u;","  if (index < ELEMENT_COUNT && maximum >= minimum && selectionMask[MASK_OFFSET + index * MASK_STRIDE] != 0u) {","    let value = inputValues[INPUT_OFFSET + index * INPUT_STRIDE];","    if (value == value && abs(value) <= 3.402823466e+38 && value >= minimum && value <= maximum) {","      if (maximum == minimum) {","        accepted = value == minimum;","      } else {","        accepted = true;","        if (value == maximum) {","          binIndex = BIN_COUNT - 1u;","        } else {","          let ratio = (value - minimum) / (maximum - minimum);","          binIndex = min(u32(ratio * f32(BIN_COUNT)), BIN_COUNT - 1u);","          let width = (maximum - minimum) / f32(BIN_COUNT);","          // Subtraction can erase which side of an edge value occupies: for [-1, 8],","          // nextDown(1) - (-1) rounds to 2. Compare the original value against the","          // interval edges, not the rounded difference. Usually no correction is needed.","          if (width > 0.0 && (bitcast<u32>(width) & 0x7f800000u) != 0x7f800000u) {","            var lower = binIndex;","            var upper = binIndex + 1u;","            if (value < minimum + f32(binIndex) * width) {","              lower = 0u;","              upper = binIndex;","            } else if (binIndex + 1u < BIN_COUNT && value >= minimum + f32(binIndex + 1u) * width) {","              lower = binIndex + 1u;","              upper = BIN_COUNT;","            }","            // Binary correction bounds the work even when adjacent f32 edges coincide.","            while (lower + 1u < upper) {","              let middle = lower + (upper - lower) / 2u;","              if (value < minimum + f32(middle) * width) {","                upper = middle;","              } else {","                lower = middle;","              }","            binIndex = lower;","          }","        }","      }","  var subgroupPending = accepted;","  for (var subgroupGroup = 0u; subgroupGroup < BIN_COUNT; subgroupGroup++) {","    let pendingBallot = subgroupBallot(subgroupPending);","    let hasPending = any(pendingBallot != vec4<u32>(0u));","    let leaderInvocation = getFirstBallotLane(pendingBallot);","    let leaderKey = subgroupShuffle(binIndex, leaderInvocation);","    let matchingKey = hasPending && subgroupPending && binIndex == leaderKey;","    let matchingBallot = subgroupBallot(matchingKey);","    if (hasPending && subgroupInvocationId == leaderInvocation) {","      atomicAdd(&localCounts[leaderKey], getBallotLaneCount(matchingBallot));","    subgroupPending = subgroupPending && !matchingKey;","  if (lane < BIN_COUNT) {","    atomicAdd(&outputCounts[OUTPUT_OFFSET + lane], atomicLoad(&localCounts[lane]));"],"strings":["buffer","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-combine-validity","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-selection-mask","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-visibility-batch-0-compact-scatter","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-chunk-0-local","compute","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-count-vector","imported","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-combined-mask-chunk-0","read","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-predicate-batch-0","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-visibility-batch-0-source-ids","GPUHistogram","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-clear","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-initialize-bins","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-visibility-batch-0-identity","select","write","gpu-dataframe","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-input","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-validity","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-row-indices","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-selected-counts","operation","GPUCompaction","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-histogram-bin-vector","gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-intent:visibility","inputValues","outputCounts","outputMask","read_write","transient","transient-buffer-0","visibility","visibility/gpu-dataframe.data-frame-histogram-query-gpu-dataframe-query-visibility-batch-0"],"shapes":[["id","form","domain","nodes","edges"],["id","op","label","namespace","kind","reads","writes","attrs"],["columns"],[],["from","to","kind"],["id","op","label","namespace","kind","reads","writes","attrs","derivedFrom"],["statement"],["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","datum","derivedFrom","source","workgroupSize","bindings","dispatch","reads","writes","attrs"],["keySpace"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount"],["id","label","namespace","kind","op","derivedFrom","reads","writes","attrs"],["id","label","namespace","kind","reads","writes","attrs"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind"