truct GraphChunkGroupParameters { words: array<vec4<u32>, 16> }","@group(0) @binding(2) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","fn getChunkParameter(word: u32) -> u32 { return graphChunkGroupParameters.words[word / 4u][word % 4u]; }","","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","@compute @workgroup_size(256)","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(num_workgroups) workgroupCount: vec3<u32>,","  @builtin(local_invocation_index) localInvocationIndex: u32) {","  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  bandValuesOffset = getChunkParameter(4u);","  featuresOffset = getChunkParameter(5u);","let bandValuesBase = arrayLength(&bandValues) - getChunkParameter(1u);","let featuresBase = arrayLength(&features) - getChunkParameter(1u);","var value = bandValues[bandValuesBase + index];","features[featuresBase + index] = value;","@group(0) @binding(0) var<storage, read> features: array<f32>;","@group(0) @binding(1) var<storage, read> modelNodes: array<u32>;","var<private> modelNodesOffset: u32;","@group(0) @binding(2) var<storage, read> modelTrees: array<u32>;","var<private> modelTreesOffset: u32;","@group(0) @binding(3) var<storage, read> leafValues: array<f32>;","var<private> leafValuesOffset: u32;","@group(0) @binding(4) var<storage, read> parameters: array<f32>;","var<private> parametersOffset: u32;","@group(0) @binding(5) var<storage, read> rowMask: array<u32>;","var<private> rowMaskOffset: u32;","@group(0) @binding(6) var<storage, read_write> scratch: array<f32>;","var<private> scratchOffset: u32;","@group(0) @binding(7) var<storage, read_write> leafIndices: array<u32>;","var<private> leafIndicesOffset: u32;","@group(0) @binding(8) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","fn isNanValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7fffffffu) > 0x7f800000u; }","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","  featuresOffset = getChunkParameter(4u);","  modelNodesOffset = getChunkParameter(5u);","  modelTreesOffset = getChunkParameter(6u);","  leafValuesOffset = getChunkParameter(7u);","  parametersOffset = getChunkParameter(8u);","  rowMaskOffset = getChunkParameter(9u);","  scratchOffset = getChunkParameter(10u);","  leafIndicesOffset = getChunkParameter(11u);","  let batchRowCount = arrayLength(&scratch) / 4u;","if (index >= batchRowCount) { return; }","let featuresBase = arrayLength(&features) - batchRowCount * 1u;","let rowMaskBase = arrayLength(&rowMask) - batchRowCount;","let leafIndicesBase = arrayLength(&leafIndices) - batchRowCount * 1u;","let nullValue = getNaN();","var valid = rowMask[rowMaskBase + index] != 0u;","var scores: array<f32, 2>;","for (var channel = 0u; channel < 2u; channel++) {","  scores[channel] = parameters[parametersOffset + 1u + channel];","for (var treeIndex = 0u; treeIndex < 1u; treeIndex++) {","  leafIndices[leafIndicesBase + index * 1u + treeIndex] = 0xffffffffu;","  if (!valid) { continue; }","  let treeOffset = modelTreesOffset + treeIndex * 4u;","  let root = modelTrees[treeOffset];","  let end = modelTrees[treeOffset + 1u];","  let weight = bitcast<f32>(modelTrees[treeOffset + 2u]);","  var node = root;","  var foundLeaf = false;","  for (var depth = 0u; depth <= 1u; depth++) {","    if (node < root || node >= end || node >= 3u) { break; }","    let nodeOffset = modelNodesOffset + node * 6u;","    let feature = modelNodes[nodeOffset];","    if (feature == 0xffffffffu) {","      for (var channel = 0u; channel < 2u; channel++) {","        scores[channel] += weight * leafValues[leafValuesOffset + node * 2u + channel];","      }","      leafIndices[leafIndicesBase + index * 1u + treeIndex] = modelNodes[nodeOffset + 5u];","      foundLeaf = true;","      break;","    }","    if (feature >= 1u) { break; }","    var value = features[featuresBase + feature * batchRowCount + index];","    let flags = modelNodes[nodeOffset + 4u];","    if (isNanValue(value) && (flags & 8u) != 0u) { value = 0.0; }","    var goLeft = false;","    if (isNanValue(value) || ((flags & 4u) != 0u && abs(value) <= 1e-35)) {","      if ((flags & 2u) == 0u) { break; }","      goLeft = (flags & 1u) != 0u;","    } else {","      if (!isFiniteValue(value)) { break; }","      let threshold = bitcast<f32>(modelNodes[nodeOffset + 3u]);","      if (isNanValue(threshold)) { break; }","      goLeft = select(value <= threshold, value < threshold, (flags & 16u) != 0u);","    node = select(modelNodes[nodeOffset + 2u], modelNodes[nodeOffset + 1u], goLeft);","  }","  valid = foundLeaf;","for (var channel = 0u; channel < 2u; channel++) { valid = valid && isFiniteValue(scores[channel]); }","var prediction = scores[0];","var bestClass = 0u;","for (var channel = 1u; channel < 2u; channel++) { if (scores[channel] > scores[bestClass]) { bestClass = channel; } }","prediction = f32(bestClass);","let rowOffset = scratchOffset + index * 4u;","for (var channel = 0u; channel < 2u; channel++) { scratch[rowOffset + channel] = select(nullValue, scores[channel], valid); }","scratch[rowOffset + 2u] = select(nullValue, prediction, valid);","scratch[rowOffset + 3u] = select(0.0, 1.0, valid);","if (!valid) {","  for (var treeIndex = 0u; treeIndex < 1u; treeIndex++) { leafIndices[leafIndicesBase + index * 1u + treeIndex] = 0xffffffffu; }","@group(0) @binding(0) var<storage, read> scratch: array<f32>;","@group(0) @binding(1) var<storage, read_write> predictions: array<f32>;","var<private> predictionsOffset: u32;","@group(0) @binding(2) var<storage, read_write> validity: array<u32>;","var<private> validityOffset: u32;","@group(0) @binding(3) 