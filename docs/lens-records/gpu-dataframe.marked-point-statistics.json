 4u; row++) {","  if (!included(row)) { continue; }","  if (isFocus(row)) { focusCount += 1.0; focusMean += (mark(row) - focusMean) / focusCount; }","  if (isNeighbor(row)) { neighborCount += 1.0; neighborMean += (mark(row) - neighborMean) / neighborCount; }","moments[momentsOffset] = focusCount; moments[momentsOffset + 1u] = neighborCount;","moments[momentsOffset + 2u] = focusMean; moments[momentsOffset + 3u] = neighborMean;","const partialsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> partials: array<f32>;","  _ = &partials;","  let focus = index / 2u; let bin = index % 2u;","let width = parameters[parametersOffset + 2u] - parameters[parametersOffset]; let height = parameters[parametersOffset + 3u] - parameters[parametersOffset + 1u]; let area = width * height;","let upper = parameters[parametersOffset + 4u] * f32(bin + 1u) / 2.0; let lower = parameters[parametersOffset + 4u] * f32(bin) / 2.0;","var cumulative = 0.0; var shell = 0.0; var products = 0.0; var shellWeight = 0.0; var count = 0.0;","if (included(focus) && isFocus(focus) && width > 0.0 && height > 0.0 && upper > 0.0 && isFiniteBits(upper) && isFiniteBits(area)) {","  for (var neighbor = 0u; neighbor < 4u; neighbor++) {","    if (neighbor == focus || !included(neighbor) || !isNeighbor(neighbor)) { continue; }","    let delta = abs(vec2<f32>(positions[positionsOffset + focus * 2u] - positions[positionsOffset + neighbor * 2u], positions[positionsOffset + focus * 2u + 1u] - positions[positionsOffset + neighbor * 2u + 1u]));","    let distance = length(delta); if (distance > upper || !isFiniteBits(distance)) { continue; }","    let overlap = (width - delta.x) * (height - delta.y);","    if (!(overlap > 0.0)) { continue; }","    let correction = area / overlap;","    let intensityWeight = 1.0;","    let weight = correction * intensityWeight;","    cumulative += weight; count += 1.0;","    if (distance > lower || bin == 0u) { shell += weight; products += weight * mark(focus) * mark(neighbor); shellWeight += weight; }","let base = partialsOffset + index * 6u;","partials[base] = cumulative; partials[base + 1u] = shell; partials[base + 2u] = products; partials[base + 3u] = shellWeight; partials[base + 4u] = count; partials[base + 5u] = 0.0;","@group(0) @binding(0) var<storage, read> partials: array<f32>;","@group(0) @binding(1) var<storage, read> moments: array<f32>;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","const resultOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> result: array<f32>;","const countsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> counts: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","  _ = &result;","  _ = &counts;","  _ = &status;","  var cumulative = 0.0; var shell = 0.0; var products = 0.0; var shellWeight = 0.0; var count = 0u;","for (var row = 0u; row < 4u; row++) { let base = partialsOffset + (row * 2u + index) * 6u; cumulative += partials[base]; shell += partials[base + 1u]; products += partials[base + 2u]; shellWeight += partials[base + 3u]; count += u32(partials[base + 4u]); }","let upper = parameters[parametersOffset + 4u] * f32(index + 1u) / 2.0; let lower = parameters[parametersOffset + 4u] * f32(index) / 2.0;","let valid = width > 0.0 && height > 0.0 && upper > 0.0 && isFiniteBits(upper) && isFiniteBits(area) && moments[momentsOffset] > 0.0 && moments[momentsOffset + 1u] > 0.0;","let scale = area / moments[momentsOffset] / moments[momentsOffset + 1u];","let estimate = cumulative * scale; let pairCorrelation = shell * scale / (3.141592653589793 * (upper * upper - lower * lower));","let markMean = moments[momentsOffset + 2u] * moments[momentsOffset + 3u];","let base = resultOffset + index * 4u;","result[base] = select(getNaN(), estimate, valid && isFiniteBits(estimate)); result[base + 1u] = select(getNaN(), sqrt(estimate / 3.141592653589793), valid && isFiniteBits(estimate));","result[base + 2u] = select(getNaN(), pairCorrelation, valid && shellWeight > 0.0 && isFiniteBits(pairCorrelation));","let markCorrelation = products / shellWeight / markMean;","result[base + 3u] = select(getNaN(), markCorrelation, valid && shellWeight > 0.0 && markMean != 0.0 && isFiniteBits(markCorrelation));","counts[countsOffset + index] = count; status[statusOffset + index] = select(1u, select(2u, 0u, isFiniteBits(estimate) && isFiniteBits(products)), valid);"],"strings":["marked-point-statistics-moments","marked-point-statistics-finish","parameters","read","buffer","marked-point-statistics-partials","positions","GPUMarkedPointStatistics","marked-point-statistics-pairs","read_write","status","transient","values","pairCounts","statistics","compute","imported","marked-point-statistics","moments","marks","partials"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[["~:2","~2","~2","~3","f32",0,6],["~:2","~6","~6","~3","f32",0,4],["~:2","~j","~c","~3","f32",0,4]]}}
