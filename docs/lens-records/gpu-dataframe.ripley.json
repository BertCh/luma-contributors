"b64:0+cfRezHO0VyQ0BF+PZDRfidSEVMy0xFeL5SRSJ1WEUE42FFNi1nRQ==","provenance":"gpu-readback","graph":"gpu-dataframe.ripley-compiled","resource":"lMinusR","meaning":"L(r) - r: zero under complete spatial randomness.","role":"output","keySpace":"radius"},{"id":"gpu-dataframe.ripley-snapshots-pairCounts-0","name":"pairCounts","iteration":0,"elementType":"u32","values":"b64:lpAAAKRLAACMJAAAfCUAAHIqAAAALAAAxjMAAFw2AAC2RQAA1DsAAA==","provenance":"gpu-readback","graph":"gpu-dataframe.ripley-compiled","resource":"pairCounts","meaning":"Uncorrected ordered pairs in the annulus ending at the radius.","role":"output","keySpace":"radius"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> parameters: array<f32>;","const cellKeysOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> cellKeys: array<u32>;","const rowIdsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> rowIds: array<u32>;","const COLUMNS: u32 = 32u;","const ROWS: u32 = 32u;","const CELL_COUNT: u32 = 1024u;","const CELL_MARGIN: f32 = 1.0009765625;","struct Lattice {","  valid: bool,","  minimumX: f32,","  minimumY: f32,","  maximumX: f32,","  maximumY: f32,","  cellWidth: f32,","  cellHeight: f32,","  columns: u32,","  rows: u32,","  maximumDistance: f32,","  radiusSquared: f32","}","fn readParameter(slot: u32) -> f32 {","  return parameters[parametersOffset + slot];","fn readLattice() -> Lattice {","  var lattice: Lattice;","  lattice.cellWidth = 1.0;","  lattice.cellHeight = 1.0;","  lattice.columns = 1u;","  lattice.rows = 1u;","  lattice.radiusSquared = 0.0;","  let minimumX = readParameter(0u);","  let minimumY = readParameter(1u);","  let maximumX = readParameter(2u);","  let maximumY = readParameter(3u);","  let radius = readParameter(4u);","  let width = maximumX - minimumX;","  let height = maximumY - minimumY;","  let radiusSquared = radius * radius;","  let cellRadius = radius * CELL_MARGIN;","  lattice.valid =","    isFiniteValue(minimumX) && isFiniteValue(minimumY) && isFiniteValue(maximumX) &&","    isFiniteValue(maximumY) && isFiniteValue(radius) && isFiniteValue(width) &&","    isFiniteValue(height) && isFiniteValue(radiusSquared) && isFiniteValue(cellRadius) &&","    radius > 0.0 && width >= 0.0 && height >= 0.0;","  if (!lattice.valid) {","    return lattice;","  }","  lattice.minimumX = minimumX;","  lattice.minimumY = minimumY;","  lattice.maximumX = maximumX;","  lattice.maximumY = maximumY;","  lattice.cellWidth = max(width / f32(COLUMNS), cellRadius);","  lattice.cellHeight = max(height / f32(ROWS), cellRadius);","  lattice.columns = min(COLUMNS - 1u, u32(floor(width / lattice.cellWidth))) + 1u;","  lattice.rows = min(ROWS - 1u, u32(floor(height / lattice.cellHeight))) + 1u;","  lattice.maximumDistance = radius;","  lattice.radiusSquared = radiusSquared;","  return lattice;","fn isPointValid(lattice: Lattice, x: f32, y: f32) -> bool {","  return lattice.valid && isFiniteValue(x) && isFiniteValue(y) &&","    x >= lattice.minimumX && x <= lattice.maximumX &&","    y >= lattice.minimumY && y <= lattice.maximumY;","fn getCellColumn(lattice: Lattice, x: f32) -> u32 {","  return min(u32(floor((x - lattice.minimumX) / lattice.cellWidth)), lattice.columns - 1u);","fn getCellRow(lattice: Lattice, y: f32) -> u32 {","  return min(u32(floor((y - lattice.minimumY) / lattice.cellHeight)), lattice.rows - 1u);","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// A runtime operand keeps the quiet-NaN bit pattern out of constant evaluation.","fn getQuietNaN(seed: u32) -> f32 { return bitcast<f32>(0x7fc00000u | (seed & 0u)); }","fn getOrderedFloatKey(value: f32) -> u32 {","  let bits = bitcast<u32>(value);","  return select(bits | 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","fn getOrderedFloatValue(key: u32) -> f32 {","  return bitcast<f32>(select(~key, key & 0x7fffffffu, (key & 0x80000000u) != 0u));","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &parameters;","  _ = &cellKeys;","  _ = &rowIds;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let lattice = readLattice();","  let x = positions[positionsOffset + index * 2u];","  let y = positions[positionsOffset + index * 2u + 1u];","  let included = true;","  ","  let valid = included &&  isPointValid(lattice, x, y);","  var key = CELL_COUNT;","  if (valid) {","    key = getCellRow(lattice, y) * lattice.columns + getCellColumn(lattice, x);","  cellKeys[cellKeysOffset + index] = key;","  rowIds[rowIdsOffset + index] = index;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","@compute @workgroup_size(128)","  _ = &fillTarget;","  if (workgroupIndex >= 33554432u) { return; }","  let index = workgroupIndex * 128u + localInvocationIndex;","  fillTarget[fillTargetOffset + index] = 0u;","const countsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const cellOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> cellOffsets: array<u32>;","const gridCountOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> gridCount: array<u32>;","const gridOverflowOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> gridOverflow: array<u32>;","const LAST_CELL: u32 = 1023u;","@compute @workgroup_size(32)","  _ = &counts;","  _ = &cellOffsets;","  _ = &gridCount;","  _ = &gridOverflow;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  let count = cellOffsets[cellOffsetsOffset + LAST_CELL] + counts[countsOffset + LAST_CELL];","  cellOffsets[cellOffsetsOffset + LAST_CELL + 1u] = count;","  gridCount[gridCountOffset] = count;","  gridOverflow[gridOverflowOffset] = 0u;","const sortedRowsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> sortedRows: array<u32>;","@group(0) @binding(2) var<storage, read> cellOffsets: array<u32>;","const sortedPointsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> sortedPoints: array<u32>;","  _ = &sortedRows;","  _ = &sortedPoints;","  if (index >= cellOffsets[cellOffsetsOffset + CELL_COUNT]) {","  let row = sortedRows[sortedRowsOffset + index];","  sortedPoints[sortedPointsOffset + index * 3u] = bitcast<u32>(positions[positionsOffset + row * 2u]);","  sortedPoints[sortedPointsOffset + index * 3u + 1u] = bitcast<u32>(positions[positionsOffset + row * 2u + 1u]);","  sortedPoints[sortedPointsOffset + index * 3u + 2u] = row;","@group(0) @binding(0) var<storage, read> parameters: array<f32>;","@group(0) @binding(1) var<storage, read> sortedPoints: array<u32>;","const accumulatorsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> accumulators: array<atomic<u32>>;","const SLOT_COUNT: u32 = 10u;","const CHANNEL_COUNT: u32 = 5u;","const ACCUMULATOR_COUNT: u32 = 50u;","var<workgroup> localLow: array<atomic<u32>, 50>;","var<workgroup> localHigh: array<atomic<u32>, 50>;","// Adds the 64-bit amount (highAmount * 2^32 + amount) to an accumulator. highAmount is at most","// 2^31. A carry out of bit 63 of the workgroup partial sets the global overflow flag.","fn accumulateWide(slot: u32, channel: u32, amount: u32, highAmount: u32) {","  if ((amount == 0u && highAmount == 0u) || slot >= SLOT_COUNT) {","  let word = slot * CHANNEL_COUNT + channel;","  var highAddend = highAmount;","  if (amount != 0u) {","    let previous = atomicAdd(&localLow[word], amount);","    if (previous > 0xffffffffu - amount) {","      highAddend += 1u;","    }","  if (highAddend != 0u) {","    let previousHigh = atomicAdd(&localHigh[word], highAddend);","    if (previousHigh > 0xffffffffu - highAddend) {","      atomicStore(&accumulators[accumulatorsOffset + ACCUMULATOR_COUNT * 2u], 1u);","fn accumulate(slot: u32, channel: u32, amount: u32) {","  accumulateWide(slot, channel, amount, 0u);","// Rounds a non-negative scaled term to a u32 amount; negative or NaN terms give 0.","fn quantizePairAmount(scaledValue: f32) -> u32 {","  return select(0u, u32(min(scaledValue + 0.5, 4294967040.0)), scaledValue > 0.0);","// Accumulates a non-negative scaled term without letting its magnitude set the rounding unit:","// a term up to 2^32 - 256 units is rounded to the nearest unit into smallChannel; a larger","// term (rare: an outlier or sentinel pair) is rounded to a multiple of 2^12 units (relative","// error below 2^-20, plus the f32 ulp) and added as an exact 64-bit amount to largeChannel,","// which readers scale back by 2^12. A term beyond 2^75 units is clamped and","// raises the overflow flag, as does any accumulator sum that carries out of 64 bits.","fn accumulateScaled(slot: u32, smallChannel: u32, largeChannel: u32, scaledValue: f32) {","  if (!(scaledValue > 0.0)) {","  if (scaledValue <= 4294967040.0) {","    accumulateWide(slot, smallChannel, u32(scaledValue + 0.5), 0u);","  var coarse = scaledValue * 0.000244140625;","  if (!(coarse <= 9223372036854775808.0)) {","    atomicStore(&accumulators[accumulatorsOffset + ACCUMULATOR_COUNT * 2u], 1u);","    coarse = 9223372036854775808.0;","  // Exact in f32: scaling by powers of two, and coarse - high * 2^32 has no more bits than coarse.","  let high = floor(coarse * 2.3283064365386963e-10);","  let low = coarse - high * 4294967296.0;","  accumulateWide(slot, largeChannel, u32(min(low + 0.5, 4294967040.0)), u32(high));","const RADIUS_COUNT: u32 = 10u;","const ISOTROPIC_SCALE: f32 = 131072.0;","const WEIGHT_CAP: f32 = 100.0;","// The raw per-annulus pair counts feed K only for the uncorrected estimator, so the other modes","// tally them only when the caller asked for pairCounts.","const RAW_PAIRS: bool = true;","const PI: f32 = 3.14159265358979;","const HALF_PI: f32 = 1.57079632679490;","// Angle of the arc of a circle of radius d (centered at distance h from a side line) outside it.","fn getSideAngle(h: f32, d: f32) -> f32 {","  if (d > h) {","    // A point on the side line: a quarter turn. h can be -0.0 (a coordinate of -0.0 against a","    // bound of 0), and atan2(y, -0.0) is -pi / 2 on some adapters.","    if (h == 0.0) {","      return HALF_PI;","    return atan2(sqrt((d - h) * (d + h)), h);","  return 0.0;","fn getArcOverlap(first: f32, second: f32) -> f32 {","  return max(0.0, first + second - HALF_PI);","// Ripley (1977) weight 1 / (fraction of the circle inside the rectangle), capped.","fn getIsotropicWeight(left: f32, bottom: f32, right: f32, top: f32, d: f32) -> f32 {","  let a = getSideAngle(left, d);","  let b = getSideAngle(bottom, d);","  let c = getSideAngle(right, d);","  let e = getSideAngle(top, d);","  let overlap = getArcOverlap(a, b) + getArcOverlap(b, c) + getArcOverlap(c, e) + getArcOverlap(e, a);","  let inside = 1.0 - (a + b + c + e) / PI + overlap / (2.0 * PI);","  return min(1.0 / max(inside, 1.0 / WEIGHT_CAP), WEIGHT_CAP);","@compute @workgroup_size(64)","  _ = &accumulators;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  for (var word = localInvocationIndex; word < ACCUMULATOR_COUNT; word += 64u) {","    atomicStore(&localLow[word], 0u);","    atomicStore(&localHigh[word], 0u);","  workgroupBarrier();","  let includedCount = cellOffsets[cellOffsetsOffset + CELL_COUNT];","  if (index < INVOCATION_COUNT && index < includedCount && lattice.valid) {","    let focus = sortedPoints[sortedPointsOffset + index * 3u + 2u];","    let x = bitcast<f32>(sortedPoints[sortedPointsOffset + index * 3u]);","    let y = bitcast<f32>(sortedPoints[sortedPointsOffset + index * 3u + 1u]);","    let mode = u32(readParameter(5u) + 0.5);","    let left = x - lattice.minimumX;","    let bottom = y - lattice.minimumY;","    let right = lattice.maximumX - x;","    let top = lattice.maximumY - y;","    var borderCount = 0u;","    // Border estimator: pairs of this focus below its border count, tallied in a register and","    // added once per focus instead of once per pair (integer sums, so the result is identical).","    var borderPairs = 0u;","    if (mode == 1u) {","      let borderDistance = min(min(left, right), min(bottom, top));","      borderCount = min(u32(floor(borderDistance / lattice.maximumDistance * f32(RADIUS_COUNT))), RADIUS_COUNT);","    let column = getCellColumn(lattice, x);","    let row = getCellRow(lattice, y);","    let firstColumn = max(column, 1u) - 1u;","    let lastColumn = min(column + 1u, lattice.columns - 1u);","    let firstRow = max(row, 1u) - 1u;","    let lastRow = min(row + 1u, lattice.rows - 1u);","    for (var cellRow = firstRow; cellRow <= lastRow; cellRow++) {","      let rowBase = cellRow * lattice.columns;","      let begin = cellOffsets[cellOffsetsOffset + rowBase + firstColumn];","      let end = cellOffsets[cellOffsetsOffset + rowBase + lastColumn + 1u];","      for (var candidateSlot = begin; candidateSlot < end; candidateSlot++) {","        let neighbor = sortedPoints[sortedPointsOffset + candidateSlot * 3u + 2u];","        if (neighbor != focus) {","          let neighborX = bitcast<f32>(sortedPoints[sortedPointsOffset + candidateSlot * 3u]);","          let neighborY = bitcast<f32>(sortedPoints[sortedPointsOffset + candidateSlot * 3u + 1u]);","          let deltaX = neighborX - x;","          let deltaY = neighborY - y;","          let distanceSquared = deltaX * deltaX + deltaY * deltaY;","          if (distanceSquared <= lattice.radiusSquared) {","            let pairDistance = sqrt(distanceSquared);","            let scaled = pairDistance / lattice.maximumDistance * f32(RADIUS_COUNT);","            let annulus = min(u32(max(ceil(scaled) - 1.0, 0.0)), RADIUS_COUNT - 1u);","            if (RAW_PAIRS || mode == 0u) {","              accumulate(annulus, 3u, 1u);","            }","            if (mode == 1u) {","              if (annulus < borderCount) {","                accumulate(annulus, 0u, 1u);","                borderPairs++;","              }","            } else if (mode == 2u) {","              accumulate(annulus, 4u, quantizePairAmount(getIsotropicWeight(left, bottom, right, top, pairDistance) * ISOTROPIC_SCALE));","          }","        }","      }","      accumulate(borderCount, 1u, borderPairs);","      accumulate(borderCount, 2u, 1u);","    let low = atomicLoad(&localLow[word]);","    let high = atomicLoad(&localHigh[word]);","    if (low != 0u || high != 0u) {","      let previous = atomicAdd(&accumulators[accumulatorsOffset + word * 2u], low);","      let carry = select(0u, 1u, previous > 0xffffffffu - low);","      let highAddend = high + carry;","      if (highAddend < high) {","        atomicStore(&accumulators[accumulatorsOffset + ACCUMULATOR_COUNT * 2u], 1u);","      if (highAddend != 0u) {","        let previousHigh = atomicAdd(&accumulators[accumulatorsOffset + word * 2u + 1u], highAddend);","        if (previousHigh > 0xffffffffu - highAddend) {","          atomicStore(&accumulators[accumulatorsOffset + ACCUMULATOR_COUNT * 2u], 1u);","@group(0) @binding(0) var<storage, read> accumulators: array<u32>;","@group(0) @binding(1) var<storage, read> cellOffsets: array<u32>;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","const kOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> k: array<f32>;","const pairCountsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> pairCounts: array<u32>;","fn readAccumulator(slot: u32, channel: u32) -> vec2<u32> {","  let word = (slot * 5u + channel) * 2u;","  return vec2<u32>(accumulators[accumulatorsOffset + word], accumulators[accumulatorsOffset + word + 1u]);","fn add64(first: vec2<u32>, second: vec2<u32>) -> vec2<u32> {","  let low = first.x + second.x;","  return vec2<u32>(low, first.y + second.y + select(0u, 1u, low < first.x));","fn subtract64(first: vec2<u32>, second: vec2<u32>) -> vec2<u32> {","  return vec2<u32>(first.x - second.x, first.y - second.y - select(0u, 1u, first.x < second.x));","fn toFloat64(value: vec2<u32>) -> f32 {","  return f32(value.y) * 4294967296.0 + f32(value.x);","// Exact 64-bit prefix sum of one channel over slots [0, last].","fn getPrefix(channel: u32, last: u32) -> vec2<u32> {","  var sum = vec2<u32>(0u, 0u);","  for (var slot = 0u; slot <= last; slot++) {","    sum = add64(sum, readAccumulator(slot, channel));","  return sum;","  _ = &k;","  _ = &pairCounts;","  let n = f32(cellOffsets[cellOffsetsOffset + CELL_COUNT]);","  let area = (parameters[parametersOffset + 2u] - parameters[parametersOffset]) *","    (parameters[parametersOffset + 3u] - parameters[parametersOffset + 1u]);","  let mode = u32(parameters[parametersOffset + 5u] + 0.5);","  var kValue = getQuietNaN(index);","  if (n >= 2.0 && isFiniteValue(area) && area > 0.0) {","      let numerator = subtract64(getPrefix(0u, index), getPrefix(1u, index));","      let borderCount = n - toFloat64(getPrefix(2u, index));","      if (borderCount >= 1.0) {","        // spatstat Kest border: lambda = n / A.","        kValue = area * toFloat64(numerator) / (n * borderCount);","    } else if (mode == 2u) {","      kValue = area / (n * (n - 1.0)) * (toFloat64(getPrefix(4u, index)) / ISOTROPIC_SCALE);","    } else {","      kValue = area / (n * (n - 1.0)) * toFloat64(getPrefix(3u, index));","  k[kOffset + index] = kValue;","  let annulusCount = readAccumulator(index, 3u);","  pairCounts[pairCountsOffset + index] = select(annulusCount.x, 0xffffffffu, annulusCount.y != 0u);","@group(0) @binding(1) var<storage, read> k: array<f32>;","const lOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> l: array<f32>;","const lMinusROffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> lMinusR: array<f32>;","const radiiOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> radii: array<f32>;","  _ = &l;","  _ = &lMinusR;","  _ = &radii;","  let nan = getQuietNaN(index);","  let maximumDistance = parameters[parametersOffset + 4u];","  let radius = maximumDistance * f32(index + 1u) / f32(RADIUS_COUNT);","  let kValue = k[kOffset + index];","  let finite = isFiniteValue(kValue);","  let lValue = select(nan, sqrt(max(kValue, 0.0) / PI), finite);","  l[lOffset + index] = lValue;","  lMinusR[lMinusROffset + index] = select(nan, lValue - radius, finite);","  radii[radiiOffset + index] = radius;"],"strings":["buffer","compute","ripley-cell-keys","ripley-cell-offsets","logical","ripley-cell-sort-radix-digit-0-scatter","ripley-cell-sort-radix-digit-8-scatter","read","ripley-histogram-sorted-points","transient","gpu-dataframe.ripley-snapshot-tap","read_write","ripley-cell-sort-radix-digit-4-scatter","GPURipley","GPUScan","ripley-cell-total","lower-bound","ripley-finish","ripley-histogram-accumulators","unknown","ripley-cell-counts","ripley-cell-sort-radix-digit-4-histogram","ripley-derive","ripley-sorted-keys","ripley-sorted-rows","ripley-cell-sort-radix-digit-0-histogram","ripley-cell-sort-radix-digit-8-histogram","ripley-parameters","lMinusR","pairCounts","radii","ripley-cell-scan-level-0-scan","ripley-histogram-pairs","observations","ripley-cell-counts-global","ripley-cell-scan-level-0-add-offsets","ripley-cell-scan-level-1-scan","ripley-cell-sort-radix-digit-0-scan-level-0-scan","ripley-cell-sort-radix-digit-4-scan-level-0-scan","ripley-cell-sort-radix-digit-8-scan-level-0-scan","ripley-cell-sort-radix-scratch-keys","ripley-row-ids","subgroups","GPUGroupAggregation","cellOffsets","parameters","ripley-cell-counts-clear","ripley-cell-scan-level-0-block-offsets","ripley-cell-scan-level-0-block-sums","ripley-cell-sort-radix-digit-0-offsets","ripley-cell-sort-radix-digit-4-offsets","ripley-cell-sort-radix-digit-8-offsets","ripley-cell-sort-radix-scratch-values","ripley-grid-count","ripley-grid-overflow","ripley-histogram-clear","PointNeighborGridIndex","accumulators","imported","positions","sortedPoints"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","reads","writes","workload","attrs"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:3","~19","~r","~7","f32",0,8],["~:3","~18","~3","~7","u32",0,1025],["~:2",10,1,1],["~:2",1500,6,1],["~:3","~1n","~x","~7","f32",0,1500],["~:4",[1,1,1],10,false],["~:4",[6,1,1],1500,false],["~:5","~e","~16",1,1,256,384,388],["~n","~o"]]}}
