{"formulas":[{"id":"gpu-dataframe:GPUScalarScale","derivation":"curated","tex":"\\term{outputValues}{y}=\\term{firstRange}{r_0}(1-\\term{position}{t})+\\term{secondRange}{r_1}\\,\\term{position}{t},\\quad \\term{position}{t}=\\frac{\\term{transformed}{T(x)}-\\term{first}{T(d_0)}}{\\term{second}{T(d_1)}-\\term{first}{T(d_0)}}","ascii":"y = r0*(1-t) + r1*t with t = (T(x)-T(d0))/(T(d1)-T(d0)); T is identity (linear), signed sqrt, or log|x| (same-sign domain); point uses t = categoryIndex/(domainCount-1); invalid rows write nullValue with validity 0.","symbols":[{"id":"outputValues","role":"output","binding":"wgsl:outputValues"},{"id":"firstRange","role":"input","binding":"wgsl:firstRange"},{"id":"secondRange","role":"input","binding":"wgsl:secondRange"},{"id":"position","role":"intermediate","binding":"wgsl:position"},{"id":"transformed","role":"intermediate","binding":"wgsl:transformed"},{"id":"first","role":"intermediate","binding":"wgsl:first"},{"id":"second","role":"intermediate","binding":"wgsl:second"}]}],"sources":[{"id":"wgsl:1a2bfe9a","language":"wgsl","moduleId":"GPUScalarScale/finite-float32","hash":"1a2bfe9a","bodyHash":"3a2d71e9","entryPoint":"main","textLines":[[0,17],[16,2],16,[18,7],21,[25,8],26,16,[33,87],79,21,[120,3],26]}]},"decisions":[],"choices":[{"stage":"classify","name":"scale","value":"sqrt","sweepable":false,"alternatives":["linear","sqrt","log","identity","point"]},{"stage":"classify","name":"domainCount","value":2,"sweepable":false},{"stage":"derive","name":"nullValue","value":0,"sweepable":false},{"stage":"derive","name":"invert","value":false,"sweepable":false,"alternatives":[false,true]}],"captures":{"schema":"luma.computation-captures/1","runId":"run-d2896503","executionId":"ccfe6f70-6b6e-4af8-8331-f24f46bba8cf","snapshots":[{"id":"gpu-dataframe-scalar-scale-snapshots-values-0","name":"values","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.scalar-scale-compiled","resource":"poverty15