0x7f800000u; }","fn scalarTransform(value: f32, scale: u32) -> f32 {","  if (scale == 1u) {","    return select(sqrt(abs(value)), -sqrt(abs(value)), value < 0.0);","  }","  if (scale == 2u) {","    // For negative log domains d3 uses -log(-x); the sign cancels in normalization.","    return log(abs(value));","  return value;","}","fn scalarInterpolate(first: f32, second: f32, position: f32) -> f32 {","  if (position == 0.0) { return first; }","  if (position == 1.0) { return second; }","  // Same convex interpolation convention as d3; unlike first+(second-first)*t this","  // remains finite for opposite large endpoints when the result is in range.","  return first * (1.0 - position) + second * position;","@compute @workgroup_size(256)","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(num_workgroups) workgroupCount: vec3<u32>,","  @builtin(local_invocation_index) localInvocationIndex: u32) {","  _ = &values;","  _ = &domain;","  _ = &range;","  _ = &parameters;","  _ = &outputValues;","  _ = &outputValidity;","  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  valuesOffset = getChunkParameter(4u);","  domainOffset = getChunkParameter(5u);","  rangeOffset = getChunkParameter(6u);","  parametersOffset = getChunkParameter(7u);","  outputValuesOffset = getChunkParameter(8u);","  outputValidityOffset = getChunkParameter(9u);","  let nullValue = parameters[parametersOffset + 2u];","  outputValues[outputValuesOffset + index] = select(0.0, nullValue, isFiniteValue(nullValue));","  outputValidity[outputValidityOffset + index] = 0u;","  ","  let scaleParameter = parameters[parametersOffset];","  let domainCountParameter = parameters[parametersOffset + 1u];","  if (!isFiniteValue(scaleParameter) || !isFiniteValue(domainCountParameter) || !isFiniteValue(nullValue)) { return; }","  if (scaleParameter < 0.0 || scaleParameter > 4.0 || floor(scaleParameter) != scaleParameter || domainCountParameter < 0.0 || domainCountParameter > f32(MAXIMUM_DOMAIN_COUNT) || floor(domainCountParameter) != domainCountParameter) { return; }","  let invertParameter = parameters[parametersOffset + 3u];","  if (invertParameter != 0.0 && invertParameter != 1.0) { return; }","  if (invertParameter == 1.0 && scaleParameter != 3.0) { return; }","  let scale = u32(scaleParameter);","  let domainCount = u32(domainCountParameter);","  let value = values[valuesOffset + index];","  if (!isFiniteValue(value)) { return; }","  var mapped: f32;","  if (scale == 4u) {","    if (domainCount == 0u) { return; }","    let firstRange = range[rangeOffset];","    let secondRange = range[rangeOffset + 1u];","    if (!isFiniteValue(firstRange) || !isFiniteValue(secondRange)) { return; }","    var categoryIndex = MAXIMUM_DOMAIN_COUNT;","    for (var candidate = 0u; candidate < domainCount; candidate++) {","      let category = domain[domainOffset + candidate];","      if (!isFiniteValue(category)) { return; }","      if (category == value && categoryIndex == MAXIMUM_DOMAIN_COUNT) { categoryIndex = candidate; }","    }","    if (categoryIndex == MAXIMUM_DOMAIN_COUNT) { return; }","    let position = select(0.5, f32(categoryIndex) / f32(max(domainCount - 1u, 1u)), domainCount > 1u);","    mapped = scalarInterpolate(firstRange, secondRange, position);","  } else {","    if (domainCount != 2u) { return; }","    let firstDomain = domain[domainOffset];","    let secondDomain = domain[domainOffset + 1u];","    if (!isFiniteValue(firstDomain) || !isFiniteValue(secondDomain)) { return; }","    if (scale == 2u && !((firstDomain > 0.0 && secondDomain > 0.0) || (firstDomain < 0.0 && secondDomain < 0.0))) { return; }","    if (scale == 3u && invertParameter == 0.0) {","      mapped = select(value, firstDomain, firstDomain == secondDomain);","    } else {","      let firstRange = select(range[rangeOffset], secondDomain, scale == 3u);","      let secondRange = select(range[rangeOffset + 1u], firstDomain, scale == 3u);","      if (!isFiniteValue(firstRange) || !isFiniteValue(secondRange)) { return; }","      if (firstDomain == secondDomain) {","        mapped = select(scalarInterpolate(firstRange, secondRange, 0.5), firstDomain, scale == 3u);","      } else {","        if (scale == 2u && ((value <= 0.0 && firstDomain > 0.0) || (value >= 0.0 && firstDomain < 0.0))) { return; }","        let first = scalarTransform(firstDomain, scale);","        let second = scalarTransform(secondDomain, scale);","        let transformed = scalarTransform(value, scale);","        if (!isFiniteValue(first) || !isFiniteValue(second) || !isFiniteValue(transformed) || first == second) { return; }","        // Normalize large magnitudes before dividing: hardware may flush the reciprocal of","        // a near-maximum f32 denominator to zero even when the quotient is ordinary finite.","        let magnitude = max(max(abs(first), abs(second)), abs(transformed));","        let normalization = select(1.0, 1e-20, magnitude > 1e19);","        let scaledFirst = first * normalization;","        let scaledSecond = second * normalization;","        if (scaledFirst == scaledSecond) { return; }","        let position = (transformed * normalization - scaledFirst) / (scaledSecond - scaledFirst);","        if (!isFiniteValue(position)) { return; }","        if (scale == 3u) {","          // Keep both interpolation operands normalized too: GPU algebraic optimization may","          // form their difference, which overflows for opposite near-maximum f32 endpoints.","          mapped = scalarInterpolate(second * normalization, first * normalization, position) / normalization;","        } else {","          mapped = scalarInterpolate(firstRange, secondRange, position);","        }","      }","  if (!isFiniteValue(mapped)) { return; }","  outputValues[outputValuesOffset + index] = mapped;","  outputValidity[outputValidityOffset + index] = 1u;"],"strings":["scalar-scale-map","gpu-dataframe-scalar-scale-snapshot-tap","buffer","logical","radius","radiusValidity","domain","imported","parameters","poverty150Pct","range","read","GPUScalarScale","read_write","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],[],["name","resource","access","elementType","elementOffset","bindingByteOffset","bindingByteLength","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[]}}
