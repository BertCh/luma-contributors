rame.time-window-filter-compiled","resource":"count","meaning":"count Accepted row total.","role":"output","keySpace":"summary"},{"id":"gpu-dataframe-time-window-filter-snapshots-rows-0","name":"rows","iteration":0,"elementType":"u32","values":"rle:,*912:00000000","provenance":"gpu-readback","graph":"gpu-dataframe.time-window-filter-compiled","resource":"rows","meaning":"compact Accepted source-row indices; unused trailing slots are omitted.","role":"output","keySpace":"compactSlot"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const paramsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> params: array<f32>;","const startHighOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> startHigh: array<f32>;","const startLowOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> startLow: array<f32>;","const outputMaskOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> outputMask: array<u32>;","// Double-single difference (aHigh + aLow) - (bHigh + bLow). High parts are subtracted first so","// nearby large epoch values cancel exactly before the small low parts are added. The result is","// used for fade and clip ratios, where rounding is harmless.","fn timeDifference(aHigh: f32, aLow: f32, bHigh: f32, bLow: f32) -> f32 {","  return (aHigh - bHigh) + (aLow - bLow);","}","// Exact double-single a >= b. Backends with fast-math may reassociate the sum above and drop the","// low parts, so acceptance compares the high parts first and uses the low parts only on ties.","fn isTimeAtLeast(aHigh: f32, aLow: f32, bHigh: f32, bLow: f32) -> bool {","  return aHigh > bHigh || (aHigh == bHigh && aLow >= bLow);","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &params;","  _ = &startHigh;","  _ = &startLow;","  _ = &outputMask;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  ","  let windowStartHigh = params[paramsOffset + 0u];","  let windowStartLow = params[paramsOffset + 1u];","  let windowEndHigh = params[paramsOffset + 2u];","  let windowEndLow = params[paramsOffset + 3u];","  let startFade = params[paramsOffset + 4u];","  let endFade = params[paramsOffset + 5u];","  let rowStartHigh = startHigh[startHighOffset + index];","  let rowStartLow = startLow[startLowOffset + index];","  let rowEndHigh = rowStartHigh;","  let rowEndLow = rowStartLow;","  // Ordered comparisons are false for NaN, so NaN rows are rejected. A reversed window","  // (end < start) accepts nothing, interval rows included (B-13).","  let endAfterWindowStart = timeDifference(rowEndHigh, rowEndLow, windowStartHigh, windowStartLow);","  let startBeforeWindowEnd = timeDifference(windowEndHigh, windowEndLow, rowStartHigh, rowStartLow);","  let accepted =","    isTimeAtLeast(windowEndHigh, windowEndLow, windowStartHigh, windowStartLow) &&","    isTimeAtLeast(rowEndHigh, rowEndLow, windowStartHigh, windowStartLow) &&","    isTimeAtLeast(windowEndHigh, windowEndLow, rowStartHigh, rowStartLow);","  outputMask[outputMaskOffset + index] = select(0u, 1u, accepted);","const totalInOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> totalIn: array<u32>;","const countOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> countOut: array<u32>;","const overflowOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> overflowOut: array<u32>;","override CAPACITY: u32;","@compute @workgroup_size(32)","  _ = &totalIn;","  _ = &countOut;","  _ = &overflowOut;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  let total = totalIn[totalInOffset];","  let count = min(total, CAPACITY);","  if (index == 0u) {","    countOut[countOutOffset] = count;","    overflowOut[overflowOutOffset] = select(0u, 1u, total > CAPACITY);","    "],"strings":["buffer","outputMask","time-window-filter-classify","time-window-filter-visibility-compact-scatter","gpu-dataframe-time-window-filter-snapshot-tap","compute","time-window-filter-publish","time-window-filter-visibility-compact-scan-level-0-scan","logical","time-window-filter-visibility-compact-offsets","GPUScan","count","lower-bound","time-window-filter-visibility-compact-scan-level-0-add-offsets","time-window-filter-visibility-compact-scan-level-1-scan","unknown","time-window-filter-total","time-window-filter-visibility-compact-normalize-0","GPUCompaction","GPUTimeWindowFilter","overflow","read","rows","time-window-filter-visibility-compact-flags","time-window-filter-visibility-compact-scan-level-0-block-offsets","time-window-filter-visibility-compact-scan-level-0-block-sums","time-window-filter-visibility-identity","time-window-filter-visibility-source-ids","timestamps","transient","imported","read_write","time-window","timestampsLow","subgroups"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["id","label","namespace","kind","op","reads","writes","workload","attrs"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","r