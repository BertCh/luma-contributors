VariableStandardization","derivation":"curated","tex":"\\term{output}{z_i}=\\frac{\\term{values}{x_i}-\\term{mean}{\\bar{x}}}{\\term{scale}{s}},\\quad \\term{scale}{s}=\\sqrt{\\frac{\\sum_i(\\term{values}{x_i}-\\term{mean}{\\bar{x}})^2}{\\term{count}{n}-1}}","ascii":"Default sample z-score: output=(value-mean)/sqrt(sum((value-mean)^2)/(n-1)). MAD uses mean absolute deviation / n; range-adjust=value/range; range-standardize=(value-min)/range; deviation=value-mean. Only finite unmasked rows contribute.","symbols":[{"id":"output","role":"output","binding":"wgsl:output"},{"id":"values","role":"input","binding":"wgsl:values"},{"id":"mean","role":"intermediate","binding":"wgsl:mean"},{"id":"scale","role":"intermediate","binding":"wgsl:scale"},{"id":"count","role":"intermediate","binding":"wgsl:countValue"}]}],"sources":[{"id":"wgsl:6478a2c2","language":"wgsl","moduleId":"GPUVariableStandardization/prepare","hash":"6478a2c2","bodyHash":"e62754b9","entryPoint":"main","textLines":[[0,10],0,[10,3],0,0,[13,21],12]},{"id":"wgsl:848b9a1b","language":"wgsl","moduleId":"GPUVariableStandardization/normalized-mean","hash":"848b9a1b","bodyHash":"e316e95f","entryPoint":"main","textLines":[[0,6],8,[34,10],12,0,[13,6],20,[44,2],[21,9],[46,5],30,51,12]},{"id":"wgsl:c3aadee6","language":"wgsl","moduleId":"GPUVariableStandardization/z-score","hash":"c3aadee6","bodyHash":"09fbd98d","entryPoint":"main","textLines":[[0,6],8,34,[52,6],0,0,[13,6],20,[58,3],[21,9],[61,3],12]},{"id":"wgsl:4b5704ed","language":"wgsl","moduleId":"GPUVariableStandardization/z-score","hash":"4b5704ed","bodyHash":"c665d5c1","entryPoint":"main","textLines":[[0,6],8,34,54,[64,3],35,67,52,[68,3],0,[71,4],12,0,[10,3],[39,5],12,0,[13,6],20,59,75,44,58,76,[21,9],[46,5],30,[77,9],12]}]},"decisions":[],"choices":[{"stage":"derive","name":"method","value":"z-score","sweepable":false,"alternatives":["deviation-from-mean","z-score","mad","range-adjust","range-standardize"]},{"stage":"summarise","name":"variance","value":"sample","sweepable":false,"alternatives":["sample","population"]}],"captures":{"schema":"luma.computation-captures/1","runId":"run-a397e3a0","snapshots":[{"id":"gpu-dataframe-variable-standardization-snapshots-values-0","name":"values","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.variable-standardization-compiled","resource":"values","meaning":"Census tract poverty percentage; suppressed estimates are NaN.","role":"input","keySpace":"row"},{"id":"gpu-dataframe-variable-standardization-snapshots-output-0","name":"output","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.variable-standardization-compiled","resource":"output","meaning":"Sample z-score across finite tract poverty percentages.","role":"output","keySpace":"row"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const valuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> values: array<f32>;","const cleanOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> clean: array<f32>;","const validOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> valid: array<u32>;","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &clean;","  _ = &valid;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let value = values[valuesOffset + index];","  let included = isFiniteBits(value);","  clean[cleanOffset + index] = select(0.0, value, included);","  valid[validOffset + index] = select(0u, 1u, included);","@group(0) @binding(1) var<storage, read> valid: array<u32>;","const extentOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> extent: array<f32>;","const normalizedOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> normalized: array<f32>;","fn getRatio(numerator: f32, denominator: f32) -> f32 {","  if (denominator == 0.0) { return 0.0; }","  if (denominator > 1e19) { return (numerator * 1e-19) / (denominator * 1e-19); }","  if (denominator < 1e-19) { return (numerator * 1e19) / (denominator * 1e19); }","  return numerator / denominator;","  _ = &extent;","  _ = &normalized;","  let minimum = extent[extentOffset];","  let maximum = extent[extentOffset + 1u];","  let sameSign = (minimum >= 0.0) == (maximum >= 0.0);","  let origin = select(0.0, minimum, sameSign);","  let radius = max(abs(minimum - origin), abs(maximum - origin));","  normalized[normalizedOffset + index] = select(0.0, getRatio(value - origin, radius), radius > 0.0 && valid[validOffset + index] != 0u);","const sumOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> sum: array<f32>;","const countOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> count: array<u32>;","const termOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> term: array<f32>;","  _ = &sum;","  _ = &count;","  _ = &term;","  let mean = sum[sumOffset] / f32(max(count[countOffset], 1u));","  let difference = values[valuesOffset + index] - mean;","  term[termOffset + index] = select(0.0, difference * difference, valid[validOffset + index] != 0u);","@group(0) @binding(2) var<storage, read> count: array<u32>;","const outputOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> output: array<f32>;","@group(0) @binding(4) var<storage, read> extent: array<f32>;","@group(0) @binding(5) var<storage, read> sum: array<f32>;","const dispersionOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read> dispersion: array<f32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","  _ = &output;","  _ = &dispersion;","  let normalizedValue = select(0.0, getRatio(value - origin, radius), radius > 0.0);","  let countValue = count[countOffset];","  let mean = sum[sumOffset] / f32(max(countValue, 1u));","  var result = getNaN();","  if (valid[validOffset + index] != 0u) { if (countValue > 1u) {","    let scale = sqrt(dispersion[dispersionOffset] / f32(countValue - 1u));","    if (isFiniteBits(scale)) { result = select(0.0, (normalizedValue - mean) / scale, scale > 0.0); }","  } }","  output[outputOffset + index] = select(getNaN(), result, isFiniteBits(result));"],"strings":["buffer","variable-standardization-valid","compute","read","variable-standardization-apply-0","variable-standardization-prepare-0","imported","values","variable-standardization-extent-level-1","transient","variable-standardization-center-0","variable-standardization-clean","variable-standardization-extent-finalize","variable-standardization-normalize-0","variable-standardization-normalized","GPUVariableStandardization","variable-standardization-count","variable-standardization-extent","variable-standardization-extent-level-0","variable-standardization-sum","output","variable-standardization-count-finalize","variable-standardization-mean-sum-finalize","variable-standardization-count-level-1","variable-standardization-dispersion-finalize","variable-standardization-dispersion-level-0","variable-standardization-dispersion-level-1","variable-standardization-mean-sum-level-1","variable-standardization-terms","gpu-dataframe-variable-standardization-snapshot-tap","read_write","variable-standardization-count-level-0","variable-standardization-dispersion","variable-standardization-mean-sum-level-0","valid","variable-standardization-count-level-0-values","variable-standardization-count-level-1-values","variable-standardization-dispersion-level-0-values","variable-standardization-dispersion-level-1-values","variable-standardization-extent-level-0-validity","variable-standardization-extent-level-0-values","variable-standardization-extent-level-1-validity","variable-standardization-extent-level-1-values","variable-standardization-mean-sum-level-0-values","variable-standardization-mean-sum-level-1-values","count","extent","z-score"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:2",791,4,1],["~:4",[4,1,1],791,false],["~:3","~y","~1","~3","u32",0,791],["~14","~13"],["~16","~15"],["~:3","sum","~j","~3","f32",0,1],["~:3","~19","~g","~3","u32",0,1],["~:3","~1a","~h","~3","f32",0,2],["~:3","~7","~7","~3","f32",0,791],["~b","~1"]]}}
