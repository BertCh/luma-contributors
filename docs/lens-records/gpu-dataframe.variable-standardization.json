name":"method","value":"z-score","sweepable":false,"alternatives":["deviation-from-mean","z-score","mad","range-adjust","range-standardize"]},{"stage":"summarise","name":"variance","value":"sample","sweepable":false,"alternatives":["sample","population"]}],"captures":{"schema":"luma.computation-captures/1","runId":"run-14d11352","snapshots":[{"id":"gpu-dataframe-variable-standardization-snapshots-values-0","name":"values","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.variable-standardization-compiled","resource":"values","afterNode":"variable-standardization-apply-0","role":"input","keySpace":"row","meaning":"Census tract poverty percentage; suppressed estimates are NaN."},{"id":"gpu-dataframe-variable-standardization-snapshots-output-0","name":"output","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.variable-standardization-compiled","resource":"output","afterNode":"variable-standardization-apply-0","role":"output","keySpace":"row","meaning":"Sample z-score across finite tract poverty percentages."}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const valuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> values: array<f32>;","const cleanOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> clean: array<f32>;","const validOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> valid: array<u32>;","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &clean;","  _ = &valid;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let value = values[valuesOffset + index];","  let included = isFiniteBits(value);","  clean[cleanOffset + index] = select(0.0, value, included);","  valid[validOffset + index] = select(0u, 1u, included);","enable subgroups;","requires subgroup_id;","override ELEMENT_COUNT: u32;","override VALUES_PER_ROW: u32;","override WORKGROUP_COUNT: u32;","override INPUT_OFFSET: u32;","override OUTPUT_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","var<workgroup> firstScratch: array<u32, 256>;","var<workgroup> secondScratch: array<u32, 256>;","var<workgroup> validityScratch: array<u32, 256>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  if (workgroupIndex >= WORKGROUP_COUNT) {","  ","  let lane = localInvocationIndex;","  var value = 0u;","  var secondValue = 0u;","  var valid = 0u;","  if (index < ELEMENT_COUNT) {","    value = inputValues[INPUT_OFFSET + index];","    secondValue = value;","    valid = select(0u, 1u, true);","  let subgroupValid = subgroupMax(valid);","  let subgroupFirst = subgroupAdd(value);","  let subgroupSecond = subgroupAdd(secondValue);","  if (subgroupInvocationId == 0u) {","    firstScratch[subgroupId] = subgroupFirst;","    secondScratch[subgroupId] = subgroupSecond;","    validityScratch[subgroupId] = subgroupValid;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (subgroupCount > 1u) {","    var stride = subgroupCount / 2u;","    loop {","      if (lane < stride) {","        firstScratch[lane] = firstScratch[lane] + firstScratch[lane + stride];","      }","      workgroupBarrier();","      if (stride == 1u) { break; }","      stride = stride / 2u;","    }","  if (lane == 0u) {","    outputValues[OUTPUT_OFFSET + workgroupIndex * VALUES_PER_ROW] = firstScratch[0];","    ","override VALIDITY_OFFSET: u32;","override OUTPUT_VALIDITY_OFFSET: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<f32>;","@group(0) @binding(1) var<storage, read> inputValidity: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputValues: array<f32>;","@group(0) @binding(3) var<storage, read_write> outputValidity: array<u32>;","var<workgroup> firstScratch: array<f32, 256>;","var<workgroup> secondScratch: array<f32, 256>;","  var value = 0.0;","  var secondValue = 0.0;","    if (inputValidity[VALIDITY_OFFSET + index] != 0u) {","      value = inputValues[INPUT_OFFSET + index];","    valid = select(0u, 1u, value == value && abs(value) <= 3.402823466e+38);","  let subgroupFirst = subgroupMin(select(3.402823466e+38, value, valid != 0u));","  let subgroupSecond = subgroupMax(select(-3.402823466e+38, secondValue, valid != 0u));","        let rightValid = validityScratch[lane + stride];","      if (rightValid != 0u) {","        if (validityScratch[lane] == 0u) {","          firstScratch[lane] = firstScratch[lane + stride];","          secondScratch[lane] = secondScratch[lane + stride];","        } else {","          firstScratch[lane] = min(firstScratch[lane], firstScratch[lane + stride]);","          secondScratch[lane] = max(secondScratch[lane], secondScratch[lane + stride]);","        }","        validityScratch[lane] = 1u;","    outputValues[OUTPUT_OFFSET + workgroupIndex * VALUES_PER_ROW + 1u] = secondScratch[0];","    outputValidity[OUTPUT_VALIDITY_OFFSET + workgroupIndex] = validityScratch[0];","    value = inputValues[INPUT_OFFSET + index * VALU