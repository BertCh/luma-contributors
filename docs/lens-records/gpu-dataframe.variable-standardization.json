"entryPoint":"main","textLines":[[0,2],31,5,75,62,[76,3],33,79,60,[80,2],6,82,[8,2],[83,4],12,[9,4],9,[37,8],12,9,[45,3],[12,6],19,67,87,48,66,88,[20,5],50,[89,5],[53,5],27,[94,9],12]}]},"decisions":[],"choices":[{"stage":"derive","name":"method","value":"z-score","sweepable":false,"alternatives":["deviation-from-mean","z-score","mad","range-adjust","range-standardize"]},{"stage":"summarise","name":"variance","value":"sample","sweepable":false,"alternatives":["sample","population"]}],"captures":{"schema":"luma.computation-captures/1","runId":"run-cb4f4238","executionId":"5abb8332-a725-4ca9-94a6-7d2e016e6a4f","snapshots":[{"id":"gpu-dataframe-variable-standardization-snapshots-values-0","name":"values","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.variable-standardization-compiled","resource":"values","meaning":"Census tract poverty percentage; suppressed estimates are NaN.","role":"input","keySpace":"row","valueCount":791},{"id":"gpu-dataframe-variable-standardization-snapshots-output-0","name":"output","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.variable-standardization-compiled","resource":"output","meaning":"Sample z-score across finite tract poverty percentages.","role":"output","keySpace":"row","valueCount":791}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["@group(0) @binding(0) var<storage, read> values: array<f32>;","var<private> valuesOffset: u32;","@group(0) @binding(1) var<storage, read_write> clean: array<f32>;","var<private> cleanOffset: u32;","@group(0) @binding(2) var<storage, read_write> valid: array<u32>;","var<private> validOffset: u32;","struct GraphChunkGroupParameters { words: array<vec4<u32>, 16> }","@group(0) @binding(3) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","fn getChunkParameter(word: u32) -> u32 { return graphChunkGroupParameters.words[word / 4u][word % 4u]; }","","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","@compute @workgroup_size(256)","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(num_workgroups) workgroupCount: vec3<u32>,","  @builtin(local_invocation_index) localInvocationIndex: u32) {","  _ = &values;","  _ = &clean;","  _ = &valid;","  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  valuesOffset = getChunkParameter(4u);","  cleanOffset = getChunkParameter(5u);","  validOffset = getChunkParameter(6u);","  let value = values[valuesOffset + index];","  let included = isFiniteBits(value);","  clean[cleanOffset + index] = select(0.0, value, included);","  valid[validOffset + index] = select(0u, 1u, included);","@group(0) @binding(1) var<storage, read> valid: array<u32>;","@group(0) @binding(2) var<storage, read> extent: array<f32>;","var<private> extentOffset: u32;","@group(0) @binding(3) var<storage, read_write> normalized: array<f32>;","var<private> normalizedOffset: u32;","@group(0) @binding(4) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","fn getScaledQuotient(value: f32, first: f32, second: f32, power: i32) -> f32 {","  if (value == 0.0) { return value; }","  let numerator = frexp(value);","  let firstDivisor = frexp(first);","  let secondDivisor = frexp(second);","  let quotient = frexp(numerator.fract / (firstDivisor.fract * secondDivisor.fract));","  return ldexp(quotient.fract,","    numerator.exp - firstDivisor.exp - secondDivisor.exp + power + quotient.exp);","fn getRatio(numerator: f32, denominator: f32) -> f32 {","  if (denominator == 0.0) { return 0.0; }","  return getScaledQuotient(numerator, denominator, 1.0, 0);","  _ = &extent;","  _ = &normalized;","  validOffset = getChunkParameter(5u);","  extentOffset = getChunkParameter(6u);","  normalizedOffset = getChunkParameter(7u);","  let minimum = extent[extentOffset];","  let maximum = extent[extentOffset + 1u];","  let sameSign = (minimum >= 0.0) == (maximum >= 0.0);","  let origin = select(0.0, minimum, sameSign);","  let radius = max(abs(minimum - origin), abs(maximum - origin));","  normalized[normalizedOffset + index] = select(0.0, getRatio(value - origin, radius), radius > 0.0 && valid[validOffset + index] != 0u);","@group(0) @binding(2) var<storage, read> sum: array<f32>;","var<private> sumOffset: u32;","@group(0) @binding(3) var<storage, read> count: array<u32>;","var<private> countOffset: u32;","@group(0) @binding(4) var<storage, read_write> term: array<f32>;","var<private> termOffset: u32;","@group(0) @binding(5) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","  _ = &sum;","  _ = &count;","  _ = &term;","  sumOffset = getChunkParameter(6u);","  countOffset = getChunkParameter(7u);","  termOffset = getChunkParameter(8u);","  let mean = sum[sumOffset] / f32(max(count[countOffset], 1u));","  let difference = values[valuesOffset + index] - mean;","  term[termOffset + index] = select(0.0, difference * difference, valid[validOffset + index] != 0u);","@group(0) @binding(2) var<storage, read> count: array<u32>;","@group(0) @binding(3) var<storage, read_write> output: array<f32>;","var<private> outputOffset: u32;","@group(0) @binding(4) var<storage, read> extent: array<f32>;","@group(0) @binding(5) var<storage, read> sum: array<f32>;","@group(0) @binding(6) var<storage, read> dispersion: array<f32>;","var<private> dispersionOffset: u32;","@group(0) @binding(7) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","  _ = &output;","  _ = &dispersion;","  countOffset = getChunkParameter(6u);","  outputOffset = getChunkParameter(7u);","  extentOffset = getChunkParameter(8u);","  sumOffset = getChunkParameter(9u);","  dispersionOffset = getChunkParameter(10u);","  let normalizedValue = select(0.0, getRatio(value - origin, radius), radius > 0.0);","  let countValue = count[countOffset];","  let mean = sum[sumOffset] / f32(max(countValue, 1u));","  var result = getNaN();","  if (valid[validOffset + index] != 0u) { if (countValue > 1u) {","    let scale = sqrt(dispersion[dispersionOffset] / f32(countValue - 1u));","    if (isFiniteBits(scale)) { result = select(0.0, (normalizedValue - mean) / scale, scale > 0.0); }","  } }","  output[outputOffset + index] = select(getNaN(), result, isFiniteBits(result));"],"strings":["buffer","variable-standardization-valid","compute","read","variable-standardization-apply-0","variable-standardization-prepare-0","logical","lower-bound","unknown","values","variable-standardization-extent-level-1","transient","variable-standardization-center","variable-standardization-clean","variable-standardization-extent-finalize","variable-standardization-normalize","variable-standardization-normalized","GPUVariableStandardization","variable-standardization-count","variable-standardization-extent","variable-standardization-extent-level-0","variable-standardization-sum","output","variable-standardization-count-finalize","variable-standardization-mean-sum-finalize","variable-standardization-count-level-1","variable-standardization-dispersion-finalize","variable-standardization-dispersion-level-0","variable-standardization-dispersion-level-1","variable-standardization-mean-sum-level-1","variable-standardization-terms","gpu-dataframe-variable-standardization-snapshot-tap","read_write","variable-standardization-count-level-0","variable-standardization-dispersion","variable-standardization-mean-sum-level-0","valid","variable-standardization-count-level-0-values","variable-standardization-count-level-1-values","variable-standardization-dispersion-level-0-values","variable-standardization-dispersion-level-1-values","variable-standardization-extent-level-0-validity","variable-standardization-extent-level-0-values","variable-standardization-extent-level-1-validity","variable-standardization-extent-level-1-values","variable-standardization-mean-sum-level-0-values","variable-standardization-mean-sum-level-1-values","count","extent","z-score"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],[],["name","resource","access","elementType","elementOffset","bindingByteOffset","bindingByteLength","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:4",[4,1,1],791,false],["~:3","~10","~1","~3","u32",0,0,3164,791],["~16","~15"],["~18","~17"],["~:3","sum","~l","~3","f32",0,0,4,1],["~:3","~1b","~i","~3","u32",0,0,4,1],["~:3","~1c","~j","~3","f32",0,0,8,2],["~:3","~9","~9","~3","f32",0,0,3164,791],["~d","~1"]]}}
