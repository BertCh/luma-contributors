et + row * 4u + 3u] = value[3u]; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","const BIN_COUNT: u32 = 20u;","const MODEL_CODES: array<u32, 3> = array<u32, 3>(0u,1u,2u);","fn readFit(offset: u32) -> vec4f {","  return vec4f(scratch[scratchOffset + offset], scratch[scratchOffset + offset + 1u], scratch[scratchOffset + offset + 2u], scratch[scratchOffset + offset + 3u]);","fn writeFit(offset: u32, value: vec4f) {","  scratch[scratchOffset + offset] = value.x;","  scratch[scratchOffset + offset + 1u] = value.y;","  scratch[scratchOffset + offset + 2u] = value.z;","  scratch[scratchOffset + offset + 3u] = value.w;","var<private> model: u32;","var<private> previous: vec4<f32>;","var<private> reweight: bool;","fn shape(scaled: f32) -> f32 {","  if (model == 0u) { return select(1.5 * scaled - 0.5 * scaled * scaled * scaled, 1.0, scaled >= 1.0); }","  if (model == 1u) { return 1.0 - exp(-3.0 * scaled); }","  return 1.0 - exp(-3.0 * scaled * scaled);","fn usable(bin: u32) -> bool { return pairCounts[pairCountsOffset + bin] > 0u && isFiniteValue(distances[distancesOffset + bin]) && distances[distancesOffset + bin] > 0.0 && isFiniteValue(semivariances[semivariancesOffset + bin]); }","fn weight(bin: u32) -> f32 {","  var value = f32(pairCounts[pairCountsOffset + bin]);","  if (reweight) { let fitted = previous.x + previous.y * shape(distances[distancesOffset + bin] / previous.z); value /= max(fitted * fitted, 1e-20); }","  return value;","fn residual(nugget: f32, sill: f32, range: f32) -> f32 {","  var value = 0.0;","  for (var bin = 0u; bin < BIN_COUNT; bin++) { if (usable(bin)) { let difference = semivariances[semivariancesOffset + bin] - nugget - sill * shape(distances[distancesOffset + bin] / range); value += weight(bin) * difference * difference; } }","fn fitLinear(range: f32) -> vec4<f32> {","  var weightSum = 0.0; var shapeSum = 0.0; var squareSum = 0.0; var valueSum = 0.0; var crossSum = 0.0;","  for (var bin = 0u; bin < BIN_COUNT; bin++) {","    if (!usable(bin)) { continue; }","    let binWeight = weight(bin); let binShape = shape(distances[distancesOffset + bin] / range); let value = semivariances[semivariancesOffset + bin];","    weightSum += binWeight; shapeSum += binWeight * binShape; squareSum += binWeight * binShape * binShape; valueSum += binWeight * value; crossSum += binWeight * binShape * value;","  }","  let nuggetOnly = max(valueSum / weightSum, 0.0);","  let sillOnly = max(crossSum / max(squareSum, 1e-30), 0.0);","  var best = vec4<f32>(nuggetOnly, 0.0, range, residual(nuggetOnly, 0.0, range));","  let sillResidual = residual(0.0, sillOnly, range);","  if (sillResidual < best.w) { best = vec4<f32>(0.0, sillOnly, range, sillResidual); }","  let determinant = weightSum * squareSum - shapeSum * shapeSum;","  if (determinant > 1e-6 * weightSum * squareSum) {","    let nugget = (squareSum * valueSum - shapeSum * crossSum) / determinant;","    let sill = (weightSum * crossSum - shapeSum * valueSum) / determinant;","    if (nugget >= 0.0 && sill >= 0.0) { let error = residual(nugget, sill, range); if (error < best.w) { best = vec4<f32>(nugget, sill, range, error); } }","  return best;","@compute @workgroup_size(2)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &distances;","  _ = &semivariances;","  _ = &pairCounts;","  _ = &scratch;","  _ = &parameters;","  _ = &diagnostics;","  _ = &statuses;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 2147483648u) { return; }","  let index = workgroupIndex * 2u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  ","var minimumLag = 3.402823e38;","var maximumLag = 0.0;","var binCount = 0u;","for (var bin = 0u; bin < BIN_COUNT; bin++) {","  if (usable(bin)) {","    minimumLag = min(minimumLag, distances[distancesOffset + bin]);","    maximumLag = max(maximumLag, distances[distancesOffset + bin]);","    binCount++;","let valid = binCount >= 2u && maximumLag > minimumLag;","writeFit(0u, vec4f(0.0, 0.0, f32(binCount), 0.0));","if (valid) {","  let lowest = log(minimumLag / 10.0);","  let highest = log(3.0 * maximumLag);","  scratch[scratchOffset] = lowest;","  scratch[scratchOffset + 1u] = (highest - lowest) / 199.0;","for (var modelIndex = 0u; modelIndex < 3u; modelIndex++) {","  write_parameters(modelIndex, vec4f(getNaN()));","  write_diagnostics(modelIndex, vec4f(getNaN()));","  statuses[statusesOffset + modelIndex] = select(1u, 0u, valid);","  writeFit(4u + modelIndex * 4u, vec4f(0.0, 0.0, 1.0, 3.402823e38));","@compute @workgroup_size(64)","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","let modelIndex = index / 200u;","if (statuses[statusesOffset + modelIndex] != 0u) { return; }","model = MODEL_CODES[modelIndex];","previous = readFit(4u + modelIndex * 4u);","reweight = false;","let step = index % 200u;","let range = exp(scratch[scratchOffset] + scratch[scratchOffset + 1u] * f32(step));","writeFit(16u + index * 4u, fitLinear(range));","struct FitSums {","  moments: vec4f,","  weightedCross: f32,","var<workgroup> fitSums: array<FitSums, 64>;","var<workgroup> sharedBest: vec4f;","var<workgroup> sharedBestStep: u32;","var<workgroup> sharedValid: u32;","var<workgroup> sharedLimits: vec2f;","fn reduceFitSums(lane: u32) -> FitSums {","  workgroupBarrier();","  for (var stride = 32u; stride > 0u; stride /= 2u) {","    if (lane < stride) {","      fitSums[lane].moments += fitSums[lane + stride].moments;","      fitSums[lane].weightedCross += fitSums[lane + stride].weightedCross;","    }","    workgroupBarrier();","  let total = workgroupUniformLoad(&fitSums[0]);","  return total;","fn fitLinearCooperative(range: f32, lane: u32) -> vec4f {","  // Pass 0: total weight. Cressie weights are 1/max(fitted^2, 1e-20) and can reach 1e20, so the","  // normal-equation products weightSum * squareSum would overflow f32. Every weight is divided by","  // the total, which bounds the normalised weightSum by 1 and the determinant by 1.","  var totalWeight = 0.0;","  for (var bin = lane; bin < BIN_COUNT; bin += 64u) {","    if (usable(bin)) {","      totalWeight += weight(bin);","  fitSums[lane] = FitSums(vec4f(totalWeight, 0.0, 0.0, 0.0), 0.0);","  let weightTotal = reduceFitSums(lane).moments.x;","  let weightScale = select(1.0, 1.0 / weightTotal, weightTotal > 0.0 && weightTotal < 3.0e38);","  var moments = vec4f(0.0);","  var weightedCross = 0.0;","      let binWeight = weight(bin) * weightScale;","      let binShape = shape(distances[distancesOffset + bin] / range);","      let value = semivariances[semivariancesOffset + bin];","      moments += vec4f(binWeight, binWeight * binShape, binWeight * binShape * binShape, binWeight * value);","      weightedCross += binWeight * binShape * value;","  fitSums[lane] = FitSums(moments, weightedCross);","  let sums = reduceFitSums(lane);","  let weightSum = sums.moments.x;","  let shapeSum = sums.moments.y;","  let squareSum = sums.moments.z;","  let valueSum = sums.moments.w;","  let crossSum = sums.weightedCross;","  var nugget = 0.0;","  var sill = 0.0;","  var jointValid = false;","    nugget = (squareSum * valueSum - shapeSum * crossSum) / determinant;","    sill = (weightSum * crossSum - shapeSum * valueSum) / determinant;","    jointValid = nugget >= 0.0 && sill >= 0.0;","  var errors = vec3f(0.0);","      let differences = vec3f(value - nuggetOnly, value - sillOnly * binShape, value - nugget - sill * binShape);","      errors += binWeight * differences * differences;","  fitSums[lane] = FitSums(vec4f(errors, 0.0), 0.0);","  let residuals = reduceFitSums(lane).moments;","  var best = vec4f(nuggetOnly, 0.0, range, residuals.x);","  if (residuals.y < best.w) { best = vec4f(0.0, sillOnly, range, residuals.y); }","  if (jointValid && residuals.z < best.w) { best = vec4f(nugget, sill, range, residuals.z); }","  // Report the residual in the caller's unnormalised weights.","  best.w = best.w / weightScale;","let modelIndex = workgroupIndex;","if (localInvocationIndex == 0u) {","  sharedValid = 0u;","  if (statuses[statusesOffset + modelIndex] == 0u) {","    var selected = previous;","    selected.w = 3.402823e38;","    var selectedStep = 0u;","    for (var step = 0u; step < 200u; step++) {","      let candidate = readFit(16u + (modelIndex * 200u + step) * 4u);","      if (candidate.w < selected.w) { selected = candidate; selectedStep = step; }","    if (selected.w < 3.402823e38) {","      sharedBest = selected;","      sharedBestStep = selectedStep;","      sharedLimits = vec2f(scratch[scratchOffset], scratch[scratchOffset + 1u]);","      sharedValid = 1u;","    } else { statuses[statusesOffset + modelIndex] = 2u; }","if (workgroupUniformLoad(&sharedValid) == 0u) { return; }","var best = workgroupUniformLoad(&sharedBest);","let bestStep = workgroupUniformLoad(&sharedBestStep);","let limits = workgroupUniformLoad(&sharedLimits);","let boundary = bestStep == 0u || bestStep == 199u;","let lowest = limits.x;","let stepSize = limits.y;","var left = lowest + stepSize * f32(select(bestStep - 1u, 0u, bestStep == 0u));","var rightBound = lowest + stepSize * f32(min(bestStep + 1u, 199u));","var inner = rightBound - 0.61803398875 * (rightBound - left);","var outer = left + 0.61803398875 * (rightBound - left);","var innerFit = fitLinearCooperative(exp(inner), localInvocationIndex);","var outerFit = fitLinearCooperative(exp(outer), localInvocationIndex);","for (var iteration = 0u; iteration < 32u; iteration++) {","  if (rightBound - left <= 1e-5) { break; }","  if (innerFit.w <= outerFit.w) {","    rightBound = outer; outer = inner; outerFit = innerFit;","    inner = rightBound - 0.61803398875 * (rightBound - left); innerFit = fitLinearCooperative(exp(inner), localInvocationIndex);","  } else {","    left = inner; inner = outer; innerFit = outerFit;","    outer = left + 0.61803398875 * (rightBound - left); outerFit = fitLinearCooperative(exp(outer), localInvocationIndex);","if (innerFit.w < best.w) { best = innerFit; }","if (outerFit.w < best.w) { best = outerFit; }","if (localInvocationIndex == 0u) { writeFit(4u + modelIndex * 4u, best); }","let bracket = rightBound - left;","if (!isFiniteValue(best.w) || !isFiniteValue(best.x) || !isFiniteValue(best.y) || !isFiniteValue(best.z)) { if (localInvocationIndex == 0u) { statuses[statusesOffset + modelIndex] = 2u; } return; }","var partialUnweighted = 0.0;","for (var bin = localInvocationIndex; bin < BIN_COUNT; bin += 64u) {","    let difference = semivariances[semivariancesOffset + bin] - best.x - best.y * shape(distances[distancesOffset + bin] / best.z);","    partialUnweighted += difference * difference;","fitSums[localInvocationIndex] = FitSums(vec4f(partialUnweighted, 0.0, 0.0, 0.0), 0.0);","let unweighted = reduceFitSums(localInvocationIndex).moments.x;","if (!isFiniteValue(unweighted) || !isFiniteValue(bracket)) { if (localInvocationIndex == 0u) { statuses[statusesOffset + modelIndex] = 2u; } return; }","let binCount = scratch[scratchOffset + 2u];","write_parameters(modelIndex, best);","write_diagnostics(modelIndex, vec4f(binCount, unweighted, binCount * log(max(unweighted / binCount, 1e-30)) + 6.0, bracket));","statuses[statusesOffset + modelIndex] = select(0u, 3u, boundary || bracket > 1e-5);"],"strings":["diagnostics","parameters","statuses","variogram-model-fit-prepare","variogram-model-fit-refine-0","read_write","variogram-model-fit-search","distances","semivariances","variogram-model-fit-candidates-0","read","buffer","pair-counts","GPUVariogramModelFit","imported","compute","pairCounts","scratch","variogram-model-fit"],"shapes":[[