const EDGE_COUNT: u32 = 1411u;","const SOURCES_OFFSET: u32 = 0u;","const TARGETS_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> sourceVertices: array<u32>;","@group(0) @binding(1) var<storage, read> targetVertices: array<u32>;","@group(0) @binding(2) var<storage, read_write> degrees: array<atomic<u32>>;","@group(0) @binding(3) var<storage, read_write> invalidEdges: array<atomic<u32>>;","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 6u + workgroupId.x;","  if (index >= EDGE_COUNT) { return; }","  let sourceVertex = sourceVertices[SOURCES_OFFSET + index];","  let targetVertex = targetVertices[TARGETS_OFFSET + index];","  if (sourceVertex >= VERTEX_COUNT || targetVertex >= VERTEX_COUNT) {","    atomicAdd(&invalidEdges[INVALID_OFFSET], 1u);","    return;","  atomicAdd(&degrees[DEGREES_OFFSET + sourceVertex], 1u);","  ","enable subgroups;","requires subgroup_id;","override ELEMENT_COUNT: u32;","override BLOCK_COUNT: u32;","override INPUT_OFFSET: u32;","override OUTPUT_OFFSET: u32;","override SUM_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sumValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  let index = workgroupIndex * 256u + lane;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","    }","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = blockPrefix;","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","    ","override OFFSETS_OFFSET: u32;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","  @builtin(local_invocation_index) localInvocationIndex: u32,","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];","const CAPACITY: u32 = 1411u;","const SCANNED_OFFSET: u32 = 0u;","const OFFSETS_OFFSET: u32 = 0u;","const COUNT_OFFSET: u32 = 0u;","const OVERFLOW_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> degrees: array<u32>;","@group(0) @binding(1) var<storage, read> scannedOffsets: array<u32>;","@group(0) @binding(2) var<storage, read_write> offsets: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputCount: array<u32>;","@group(0) @binding(4) var<storage, read_write> outputOverflow: array<u32>;","    offsets[OFFSETS_OFFSET + index] = scannedOffsets[SCANNED_OFFSET + index];","  if (index == 0u) {","    var total = 0u;","    if (VERTEX_COUNT > 0u) {","      let last = max(VERTEX_COUNT, 1u) - 1u;","      total = scannedOffsets[SCANNED_OFFSET + last] + degrees[DEGREES_OFFSET + last];","    offsets[OFFSETS_OFFSET + VERTEX_COUNT] = total;","    outputCount[COUNT_OFFSET] = total;","    outputOverflow[OVERFLOW_OFFSET] = select(0u, 1u, total > CAPACITY);","const NEIGHBORS_OFFSET: u32 = 0u;","const OUTPUT_EDGE_IDS_OFFSET: u32 = 0u;","@group(0) @binding(2) var<storage, read> scannedOffsets: array<u32>;","@group(0) @binding(3) var<storage, read_write> cursors: array<atomic<u32>>;","@group(0) @binding(4) var<storage, read_write> neighbors: array<u32>;","@group(0) @binding(5) var<storage, read_write> outputEdgeIds: array<u32>;","  if (sourceVertex >= VERTEX_COUNT || targetVertex >= VERTEX_COUNT) { return; }","  let edgeIdentifier = 0u + index;","  let firstSlot = scannedOffsets[SCANNED_OFFSET + sourceVertex] +","    atomicAdd(&cursors[CURSORS_OFFSET + sourceVertex], 1u);","  if (firstSlot < CAPACITY) {","    neighbors[NEIGHBORS_OFFSET + firstSlot] = targetVertex;","    outputEdgeIds[OUTPUT_EDGE_IDS_OFFSET + firstSlot] = edgeIdentifier;"],"strings":["buffer","read_write","read","imported","compute","rail-topology-forward-degrees","rail-topology-forward-scanned-offsets","topology-forward-degrees","topology-forward-scanned-offsets","GPUScan","topology-forward-scatter-0","rail-topology-forward-finalize","topology-forward-finalize","rail-topology-forward-scatter-0","transient","GPUGraphAlgorithmsTopology","rail-topology-forward-degrees-0","rail-topology-source-vertices","rail-topology-target-vertices","level-scan","rail-topology-forward-initialize","topology-forward-initialize","rail-topology","rail-topology-forward-cursors","rail-topology-invalid-edge-count","topology","topology-forward-cursors","topology-forward-degrees-0","topology-invalid-edge-count","degrees","gpu-core.scan","outputValues","rail-topology-forward-scan-level-0-add-offsets","rail-topology-forward-scan-level-0-block-offsets","rail-topology-forward-scan-level-0-block-sums","rail-topology-forward-scan-level-0-scan","topology-forward-scan-level-0-add-offsets","topology-forward-scan-level-0-block-offsets","topology-forward-scan-level-0-block-sums","topology-fo