{"schema":"luma.lens-record/1","scenarioId":"gpu-network.adjacency-matrix-order","recordedAt":"2026-11-07T14:55:16.648Z","adapterLabel":"apple (unknown)","record":{"schema":"luma.computation/1","id":"gpu-network.adjacency-matrix-order","runId":"run-8da14b65","createdAt":"2026-11-07T14:55:16.647Z","adapter":{"backend":"webgpu","vendor":"apple","architecture":"metal-3","description":""},"domains":["gpu-network"],"graphs":[["~:0","gpu-network.adjacency-matrix-order-compiled","compiled","gpu-network","gpu-network.adjacency-matrix-order",[["~:1","~g","~g","","~2","~t",["~g"],["~g"],["~:2","~t","identity",1,5,1199,0,4796],["~:3"]],["~:1","~r","~r","","~2","~t",["~g","~1c","~s"],["~s"],["~:2","~t","gather-groups",1,5,1199,9592,4796],["~:3"]],["~:4","~o","~o","","~2",["~s"],["~o"],["~:3"]],["~:1","~v","~v","","~2","~b",["~o"],["~14"],"~^0",["~:3"]],["~:4","~d","~d","","~2",["~s","~g","~14"],"~^1",["~:3"]],["~:4","~m","~m","","~2",["~0"],["~m"],["~:3"]],["~:1","~11","~11","","~2","~b",["~m"],["~1a"],"~^0",["~:3"]],["~:4","~f","~f","","~2",["~0","~6","~1a"],"~^2",["~:3"]],["~:4","~n","~n","","~2",["~4"],["~n"],["~:3"]],["~:1","~12","~12","","~2","~b",["~n"],["~1b"],"~^0",["~:3"]],["~:4","~a","~a","","~2",["~4","~5","~1b"],"~^1",["~:3"]],["~:4","~i","~i","","~2",["~0"],["~i"],["~:3"]],["~:1","~w","~w","","~2","~b",["~i"],["~15"],"~^0",["~:3"]],["~:4","~7","~7","","~2",["~0","~6","~15"],"~^2",["~:3"]],["~:4","~j","~j","","~2",["~4"],["~j"],["~:3"]],["~:1","~x","~x","","~2","~b",["~j"],["~16"],"~^0",["~:3"]],["~:4","~8","~8","","~2",["~4","~5","~16"],"~^1",["~:3"]],["~:4","~k","~k","","~2",["~0"],["~k"],["~:3"]],["~:1","~y","~y","","~2","~b",["~k"],["~17"],"~^0",["~:3"]],["~:4","~9","~9","","~2",["~0","~6","~17"],"~^2",["~:3"]],["~:4","~l","~l","","~2",["~4"],["~l"],["~:3"]],["~:1","~z","~z","","~2","~b",["~l"],["~18"],"~^0",["~:3"]],["~:4","~c","~c","","~2",["~4","~5","~18"],"~^1",["~:3"]],["~:4","~p","~p","","~2",["~0"],["~p"],["~:3"]],["~:1","~10","~10","","~2","~b",["~p"],["~19"],"~^0",["~:3"]],["~:4","~e","~e","","~2",["~0","~6","~19"],"~^2",["~:3"]],["~:1","~u","~u","","~2","~t",["~5","~13"],["~13"],["~:2","~t","scatter",1,5,1199,4796,4796],["~:3"]],["~:4","~h","~h","","copy",["~1c","~13","~1f","~1d","~1e"],[],["~:3"]]],[["~:5","~g","~r","raw","~g"],["~:5","~r","~o","raw","~s"],["~:5","~o","~v","raw","~o"],["~:5","~r","~d","raw","~s"],["~:5","~g","~d","raw","~g"],["~:5","~v","~d","raw","~14"],["~:5","~d","~m","raw","~0"],["~:5","~m","~11","raw","~m"],["~:5","~d","~f","raw","~0"],["~:5","~d","~f","raw","~6"],["~:5","~11","~f","raw","~1a"],["~:5","~f","~n","raw","~4"],["~:5","~n","~12","raw","~n"],["~:5","~f","~a","raw","~4"],["~:5","~f","~a","raw","~5"],["~:5","~12","~a","raw","~1b"],["~:5","~m","~a","war","~0"],["~:5","~f","~a","war","~0"],["~:5","~d","~a","waw","~0"],["~:5","~f","~a","war","~6"],["~:5","~d","~a","waw","~6"],["~:5","~a","~i","raw","~0"],["~:5","~i","~w","raw","~i"],["~:5","~a","~7","raw","~0"],["~:5","~a","~7","raw","~6"],["~:5","~w","~7","raw","~15"],["~:5","~n","~7","war","~4"],["~:5","~a","~7","war","~4"],["~:5","~f","~7","waw","~4"],["~:5","~a","~7","war","~5"],["~:5","~f","~7","waw","~5"],["~:5","~7","~j","raw","~4"],["~:5","~j","~x","raw","~j"],["~:5","~7","~8","raw","~4"],["~:5","~7","~8","raw","~5"],["~:5","~x","~8","raw","~16"],["~:5","~i","~8","war","~0"],["~:5","~7","~8","war","~0"],["~:5","~a","~8","waw","~0"],["~:5","~7","~8","war","~6"],["~:5","~a","~8","waw","~6"],["~:5","~8","~k","raw","~0"],["~:5","~k","~y","raw","~k"],["~:5","~8","~9","raw","~0"],["~:5","~8","~9","raw","~6"],["~:5","~y","~9","raw","~17"],["~:5","~j","~9","war","~4"],["~:5","~8","~9","war","~4"],["~:5","~7","~9","waw","~4"],["~:5","~8","~9","war","~5"],["~:5","~7","~9","waw","~5"],["~:5","~9","~l","raw","~4"],["~:5","~l","~z","raw","~l"],["~:5","~9","~c","raw","~4"],["~:5","~9","~c","raw","~5"],["~:5","~z","~c","raw","~18"],["~:5","~k","~c","war","~0"],["~:5","~9","~c","war","~0"],["~:5","~8","~c","waw","~0"],["~:5","~9","~c","war","~6"],["~:5","~8","~c","waw","~6"],["~:5","~c","~p","raw","~0"],["~:5","~p","~10","raw","~p"],["~:5","~c","~e","raw","~0"],["~:5","~c","~e","raw","~6"],["~:5","~10","~e","raw","~19"],["~:5","~l","~e","war","~4"],["~:5","~c","~e","war","~4"],["~:5","~9","~e","waw","~4"],["~:5","~c","~e","war","~5"],["~:5","~9","~e","waw","~5"],["~:5","~e","~u","raw","~5"],["~:5","~u","~h","raw","~13"]],[["~:6","~g","~1","~g","~d",4796,"~3"],["~:6","~1c","~1","~r","~h",4796,"~3"],["~:6","~s","~1","~r","~d",4796,"~3"],["~:6","~o","~1","~o","~v",320,"~3"],["~:6","~14","~1","~v","~d",320,"~3"],["~:6","~0","~1","~d","~e",4796,"~3"],["~:6","~6","~1","~d","~e",4796,"~3"],["~:6","~m","~1","~m","~11",320,"~3"],["~:6","~1a","~1","~11","~f",320,"~3"],["~:6","~4","~1","~f","~e",4796,"~3"],["~:6","~5","~1","~f","~u",4796,"~3"],["~:6","~n","~1","~n","~12",320,"~3"],["~:6","~1b","~1","~12","~a",320,"~3"],["~:6","~i","~1","~i","~w",320,"~3"],["~:6","~15","~1","~w","~7",320,"~3"],["~:6","~j","~1","~j","~x",320,"~3"],["~:6","~16","~1","~x","~8",320,"~3"],["~:6","~k","~1","~k","~y",320,"~3"],["~:6","~17","~1","~y","~9",320,"~3"],["~:6","~l","~1","~l","~z",320,"~3"],["~:6","~18","~1","~z","~c",320,"~3"],["~:6","~p","~1","~p","~10",320,"~3"],["~:6","~19","~1","~10","~e",320,"~3"],["~:6","~13","~1","~u","~h",4796,"~3"],["~:6","~1f","~1","~h","~h",4800,"~3"],["~:6","~1d","~1","~h","~h",11240,"~3"],["~:6","~1e","~1","~h","~h",9592,"~3"]]]],"axes":{"axes":[{"id":"entity","label":"element datum","kind":"data","keySpace":"node"}],"keySpaces":[{"id":"node","label":"network node","indexSpace":"1d","size":1199},{"id":"edge","label":"directed edge","indexSpace":"csr","size":2810},{"id":"sample","label":"shown intersection","indexSpace":"1d","size":12}],"relations":[{"id":"node-out-edges","from":"node","to":"node","cardinality":"1:N","kind":"buffer","timeDependent":false,"ref":{"layout":"csr","resource":"gpu-network.adjacency-matrix-order-neighbors","offsetsResource":"gpu-network.adjacency-matrix-order-offsets","capture":"neighbors"}}]},"refs":{"formulas":[{"id":"gpu-network.service-areas.label","derivation":"curated","tex":"\\term{labels}{L}[\\term{targetNode}{v}]\\leftarrow\\min\\bigl(\\term{labels}{L}[\\term{targetNode}{v}],\\ \\term{sourceLabel}{\\ell_u}\\bigr)\\quad\\text{over tight edges }u\\to v:\\ \\term{tight}{c_u+w_{uv}=c_v}","ascii":"Label phase, after the cost search: on every tight edge u->v (f32 equality costs[u] + w == costs[v], no tolerance, zero-weight edges included) labels[v] = min(labels[v], labels[u]) with an atomic minimum, seeded at the facility nodes. The fixpoint is the smallest facility row among all facilities that reach v at its minimum cost, independent of thread order. Unreached nodes keep NONE (0xffffffff).","symbols":[{"id":"labels","role":"output","label":"facility row per node","binding":"wgsl:labels"},{"id":"targetNode","role":"intermediate","label":"edge target v","binding":"wgsl:targetNode"},{"id":"sourceLabel","role":"intermediate","label":"label of the edge source u","binding":"wgsl:sourceLabel"},{"id":"tight","role":"input","label":"tight-edge bit","binding":"wgsl:tightBits"}]},{"id":"gpu-network.neighborhood.hops","derivation":"curated","tex":"\\term{hopDistances}{h_v}=\\begin{cases}\\operatorname{u32}(\\term{cost}{c_v})&\\term{cost}{c_v}\\le\\term{limit}{k}\\\\\\term{none}{\\mathrm{NONE}}&\\text{otherwise}\\end{cases}","ascii":"hopDistances[v] = cost[v] <= limit ? uint(cost[v]) : NONE, where cost is the unit-weight search cost, limit = min(hops, maximumHops) and NONE = 0xffffffff. NaN and +Infinity costs compare false and stay outside the ego network.","symbols":[{"id":"hopDistances","role":"output","label":"hop distance","binding":"wgsl:hopDistances"},{"id":"cost","role":"input","label":"unit-weight cost","binding":"wgsl:cost"},{"id":"limit","role":"parameter","label":"hop radius","binding":"wgsl:limit"},{"id":"none","role":"constant","label":"outside the ego network","binding":"wgsl:NONE"}]},{"id":"gpu-network.isochrones.cost","derivation":"curated","tex":"\\term{cost}{c}=\\left|\\term{sourceCost}{d_u}+\\term{t}{t}\\,\\term{weight}{w_{uv}}+\\term{walk}{a}\\,\\term{pixelDistance}{r}\\right|,\\qquad \\text{pixel}=\\min c","ascii":"Per edge sample at fraction t along u->v and per pixel within the buffer radius: cost = abs(sourceCost + t*weight + walk*pixelDistance); each pixel keeps the minimum cost over all samples (min mode; atomic minimum on order-preserving f32 bits, so the result does not depend on thread order). Samples are linear along straight segments between node positions, so this is a sampled raster, not an exact polygonal travel-time boundary; pixels no sample reaches stay unreached.","symbols":[{"id":"cost","role":"output","label":"pixel cost candidate","binding":"wgsl:cost"},{"id":"sourceCost","role":"input","label":"cost at edge source","binding":"wgsl:sourceCost"},{"id":"t","role":"intermediate","label":"sample fraction","binding":"wgsl:t"},{"id":"weight","role":"input","label":"edge travel time","binding":"wgsl:weight"},{"id":"walk","role":"parameter","label":"walk cost per metre","binding":"wgsl:walk"},{"id":"pixelDistance","role":"intermediate","label":"sample-to-pixel distance","binding":"wgsl:pixelDistance"}]},{"id":"gpu-network.catchment.band","derivation":"curated","tex":"\\term{band}{b}=\\min\\{k:\\ \\term{time}{t}<\\term{bandBreaks}{B}[\\term{k}{k}]\\}","ascii":"band = first k with time < bandBreaks[k], else 0xffffffff (no band). Upper bounds are strict; unreached, unsnapped or non-finite demand times (>= 3.0e38) get no band. time = min(cost[source] + sourceCost, cost[target] + targetCost) on the snapped edge, from the demand-time kernel.","symbols":[{"id":"band","role":"output","label":"drive-time band","binding":"wgsl:bands"},{"id":"time","role":"input","label":"demand drive time","binding":"wgsl:time"},{"id":"bandBreaks","role":"input","label":"ascending band bounds","binding":"wgsl:bandBreaks"},{"id":"k","role":"intermediate","label":"band index","binding":"wgsl:k"}]},{"id":"gpu-network.snapping.nearest","derivation":"curated","tex":"\\term{bestEdge}{e^*}=\\operatorname*{argmin}_{e}\\ \\term{distance}{d(p,e)}","ascii":"For each point p the scan visits every edge row e in ascending order and keeps the edge with the smallest point-to-segment distance d(p,e): bestEdge = e when bestEdge is NONE or d < bestDistance (strict, so ties go to the smallest edge row; NaN never wins). Distances are in the spatial context length unit (meters for a great-circle longitude/latitude context); with a maximum snap distance, edges beyond it are skipped and an unsnapped point gets NONE.","symbols":[{"id":"bestEdge","role":"output","label":"snapped edge row","binding":"wgsl:bestEdge"},{"id":"distance","role":"intermediate","label":"distance to edge","binding":"wgsl:distance"},{"id":"bestDistance","role":"intermediate","label":"smallest distance so far","binding":"wgsl:bestDistance"}]},{"id":"gpu-network.accessibility.gravity","derivation":"curated","tex":"\\term{gravitySum}{A_j}=\\sum_{i}\\term{weight}{O_i}\\,e^{-\\term{beta}{\\beta}\\,\\term{cost}{c_{ij}}}\\quad\\text{over }c_{ij}\\le\\term{threshold}{T}","ascii":"Exponential-decay variant, opportunity-rows orientation: for every column node j the kernel sums rows i in ascending order and adds weight[i] * exp(-beta * cost[i,j]) for finite costs 0 <= cost <= threshold and finite weights (unreached +Infinity entries and non-finite weights are skipped; the sum is deterministic, no float atomics, and weights are not normalised). The cumulative variant omits the decay and the power variant uses max(cost, minimumCost)^-beta; they are alternative branches of the same kernel.","symbols":[{"id":"gravitySum","role":"output","label":"gravity score","binding":"wgsl:gravitySum"},{"id":"weight","role":"input","label":"opportunity weight","binding":"wgsl:weight"},{"id":"beta","role":"parameter","label":"decay rate","binding":"wgsl:beta"},{"id":"cost","role":"input","label":"matrix cost","binding":"wgsl:cost"},{"id":"threshold","role":"parameter","label":"cost cutoff","binding":"wgsl:threshold"}]},{"id":"gpu-network.analytics.normalize","derivation":"curated","tex":"\\term{normalized}{s}=\\begin{cases}(\\term{degree}{x}-\\term{lowest}{a})/(\\term{highest}{b}-\\term{lowest}{a})&\\term{highest}{b}>\\term{lowest}{a}\\\\0&\\text{otherwise}\\end{cases}","ascii":"normalized = highest > lowest ? (raw - lowest) / (highest - lowest) : 0, in f32. lowest and highest are the two words of the extent reduction (minimum, maximum of the raw column over all nodes); a column with a single value (no range) normalizes to 0 for every node. The raw degree is the outgoing CSR row length from the degree algorithm.","symbols":[{"id":"normalized","role":"output","label":"scaled degree","binding":"wgsl:normalized"},{"id":"degree","role":"input","label":"raw column value","binding":"wgsl:raw"},{"id":"lowest","role":"intermediate","label":"column minimum","binding":"wgsl:lowest"},{"id":"highest","role":"intermediate","label":"column maximum","binding":"wgsl:highest"}]},{"id":"gpu-network.centrality.closeness","derivation":"curated","tex":"\\term{closeness}{C}=\\begin{cases}(\\term{reachedPartial}{r}-1)/\\term{totalCost}{S}&\\term{totalCost}{S}>0\\\\0&\\text{otherwise}\\end{cases}","ascii":"closeness = totalCost > 0 ? (reachedPartial[0] - 1) / totalCost : 0, per pivot. Outward closeness: totalCost is the f32 sum of the search costs of every node the pivot reaches (infinite costs are skipped), added by a fixed 256-lane tree reduction so the value does not depend on thread order. reachedPartial[0] counts the reached nodes including the pivot itself. The Wasserman-Faust factor (r - 1) / (N - 1) is not applied; the unit is 1 / cost (1 / second on travel-time weights).","symbols":[{"id":"closeness","role":"output","label":"outward closeness","binding":"wgsl:closeness"},{"id":"reachedPartial","role":"intermediate","label":"reached nodes, pivot included","binding":"wgsl:reachedPartial"},{"id":"totalCost","role":"intermediate","label":"sum of reached costs","binding":"wgsl:totalCost"}]},{"id":"gpu-network.statistics.degree-histogram","derivation":"curated","tex":"\\term{localHistogram}{H}[\\term{getBin}{b}(\\term{outValue}{d})]\\leftarrow\\term{localHistogram}{H}[\\term{getBin}{b}(\\term{outValue}{d})]+1","ascii":"localHistogram[getBin(outValue)] += 1 (atomic) for every live node, where outValue is its live out-degree and getBin(d) = min(floor(d / binWidth), BIN_COUNT - 1) for the linear rule (the last bin saturates; log2 binning uses bin 0 for d = 0, else min(1 + floor(log2 d), BIN_COUNT - 1)). Each workgroup then adds its non-empty bins to the summary words, so integer addition makes the histogram independent of thread order. The in-degree and total-degree histograms use the same rule.","symbols":[{"id":"localHistogram","role":"intermediate","label":"workgroup histogram","binding":"wgsl:localHistogram"},{"id":"getBin","role":"intermediate","label":"degree bin","binding":"wgsl:getBin"},{"id":"outValue","role":"input","label":"live out-degree","binding":"wgsl:outValue"}]},{"id":"gpu-network.subgraph-filter.range","derivation":"curated","tex":"\\term{live}{m}\\leftarrow\\term{live}{m}\\land\\bigl(\\term{parameters}{p}[\\term{base}{b}]\\le\\term{value}{x}<\\term{parameters}{p}[\\term{base}{b}+1]\\bigr)","ascii":"For every enabled range, live = live && value >= parameters[base] && value < parameters[base + 1]: half-open, so the maximum itself is excluded, and a NaN value never passes. A disabled range (parameters[base + 2] == 0) is skipped. The mask starts at 1 (or at the caller mask), so the result is the AND of all ranges; an edge slot is finally kept only when both of its endpoints are live, and dropIsolated also removes nodes left without a live slot. Integer and comparison arithmetic only, so the result is exact.","symbols":[{"id":"live","role":"output","label":"slot is kept","binding":"wgsl:live"},{"id":"parameters","role":"parameter","label":"range bounds","binding":"wgsl:parameters"},{"id":"base","role":"intermediate","label":"range record offset","binding":"wgsl:base"},{"id":"value","role":"input","label":"column value","binding":"wgsl:value"}]},{"id":"gpu-network.adjacency-matrix.bin","derivation":"curated","tex":"\\term{getBin}{b}(\\term{position}{p},\\term{start}{s},\\term{end}{e})=\\left\\lfloor\\frac{(\\term{position}{p}-\\term{start}{s})\\,\\term{RESOLUTION}{R}}{\\term{end}{e}-\\term{start}{s}}\\right\\rfloor","ascii":"getBin(position, start, end) = (position - start) * RESOLUTION / (end - start) with u32 division (floor). A live slot u -> v adds 1 (atomically) to cell getBin(order[u]) * RESOLUTION + getBin(order[v]): rows are source positions, columns are target positions, and slots whose positions fall outside the window [start, end) are dropped. Counts are exact integers, so the matrix does not depend on thread order; with fewer bins than nodes, each bin covers several consecutive matrix positions.","symbols":[{"id":"getBin","role":"output","label":"matrix bin","binding":"wgsl:getBin"},{"id":"position","role":"input","label":"matrix position","binding":"wgsl:position"},{"id":"start","role":"parameter","label":"window start","binding":"wgsl:start"},{"id":"end","role":"parameter","label":"window end","binding":"wgsl:end"},{"id":"RESOLUTION","role":"parameter","label":"bins per axis","binding":"wgsl:RESOLUTION"}]},{"id":"gpu-network.line-graph.arc-weight","derivation":"curated","tex":"\\term{lineWeights}{w_{ef}}=\\begin{cases}\\term{baseCost}{w_f}+\\max(\\term{getTurnCost}{p_{ef}},0)&\\term{baseCost}{w_f}\\ge0\\\\-1&\\text{otherwise}\\end{cases}","ascii":"lineWeights[arc e -> f] = baseCost >= 0 ? baseCost + max(turnCost, 0) : -1, where baseCost = weights[f] is the cost of the NEXT edge f (not of the entering edge e) and turnCost = getTurnCost(e, f) = angleCost * |angle| plus the left or right extra beyond straightAngle; a turn with |angle| >= uTurnAngle pays uTurnCost instead, and a negative uTurnCost bans it (no arc is emitted). Banned pairs are removed too, so every emitted arc has turnCost >= 0. The angle is between the great-circle arrival bearing of e and the departure bearing of f at the turn node, positive to the left. Arcs of one edge are listed in ascending next-edge order.","symbols":[{"id":"lineWeights","role":"output","label":"arc cost","binding":"wgsl:lineWeights"},{"id":"baseCost","role":"input","label":"cost of the next edge","binding":"wgsl:baseCost"},{"id":"getTurnCost","role":"intermediate","label":"turn cost","binding":"wgsl:getTurnCost"}]},{"id":"gpu-network.cost-table.admission","derivation":"curated","tex":"\\term{isIncluded}{I}=\\mathbf{1}\\bigl[\\operatorname{finite}(\\term{cost}{c})\\wedge \\term{cost}{c}\\ge 0\\bigr]","ascii":"Table admission, after the cutoff search of one source row: isIncluded = isFiniteBits(cost) && cost >= 0, where cost is the f32 reachability fixpoint searched with the cost limit. Unreached nodes are +Infinity and are not stored; the source itself is stored at cost 0. Included targets are packed in ascending node order by an inclusive scan, so slot order is fixed; entries past the capacity are dropped and reported by the overflow status. This is the admission rule, not a second shortest-path formula.","symbols":[{"id":"isIncluded","role":"output","label":"entry is stored","binding":"wgsl:isIncluded"},{"id":"cost","role":"input","label":"network cost from the source","binding":"wgsl:cost"}]},{"id":"gpu-network.cost-weights.decay","derivation":"curated","tex":"\\term{weights}{w}=e^{-\\term{beta}{\\beta}\\,\\term{cost}{c}}\\quad\\text{for finite }0\\le c\\le L","ascii":"Exponential decay, the branch chosen by the decay parameter: weights = exp(-beta * cost) for every finite matrix cost with 0 <= cost <= costLimit; other entries (unreached +Infinity, negative, beyond the limit) are not stored. Slots follow ascending neighbor order within each row. The 'none' branch stores 1, 'power' stores max(cost, minimumCost)^-beta and 'gaussian' stores the truncated, rescaled (exp(-0.5 (c/L)^2) - exp(-0.5)) / (1 - exp(-0.5)); they are alternative branches of the same kernel.","symbols":[{"id":"weights","role":"output","label":"stored decay weight","binding":"wgsl:weights"},{"id":"beta","role":"parameter","label":"decay rate","binding":"wgsl:beta"},{"id":"cost","role":"input","label":"matrix cost","binding":"wgsl:cost"}]},{"id":"gpu-network.k-function.k","derivation":"curated","tex":"\\term{k}{K(d_k)}=2\\,\\term{cumulative}{P(d_k)}\\,\\term{networkLength}{L}\\,/\\,\\term{count}{n}^{2}\\qquad(n\\ge 2,\\ \\text{else }0)","ascii":"K(d_k) = 2 * cumulative * networkLength / (count * count) for count >= 2 snapped events, else 0. cumulative is the number of unordered event pairs whose network distance is strictly below the band threshold d_k = maximumDistance * k / (bandCount - 1) (a prefix sum of the per-band pair histogram); networkLength is the length of every road counted once. The denominator is count squared (the spaghetti GlobalAutoK normalisation), not count * (count - 1). With zero simulations only the observed row exists.","symbols":[{"id":"k","role":"output","label":"K value of the band","binding":"wgsl:k"},{"id":"cumulative","role":"intermediate","label":"pairs closer than the threshold","binding":"wgsl:cumulative"},{"id":"networkLength","role":"parameter","label":"total network length","binding":"wgsl:networkLength"},{"id":"count","role":"input","label":"snapped event count","binding":"wgsl:count"}]},{"id":"gpu-network.flow-aggregation.pair-sum","derivation":"curated","tex":"\\term{rowWeights}{W}=\\sum_{x\\in\\text{pair}}\\term{sortedContributions}{x}","ascii":"rowWeights[row] = fixed_tree_sum(sortedContributions[begin:end]): one workgroup per stored origin-destination pair sums the pair's contributions (the weights of its records, in source row order, 0 for rejected or non-finite weights) with a strided partial sum and a fixed binary tree, so the float sum is bitwise reproducible. It is a sum of the weights (trips), not a mean and not the record count; flowCounts counts the records of the pair separately.","symbols":[{"id":"rowWeights","role":"output","label":"weight sum of the pair","binding":"wgsl:rowWeights"},{"id":"sortedContributions","role":"input","label":"record weights of the pair, sorted","binding":"wgsl:sortedContributions"}]},{"id":"gpu-network.reachability.relax","derivation":"curated","tex":"\\term{costs}{c_v}\\leftarrow\\min(\\term{costs}{c_v},\\operatorname{f32}(\\term{source}{c_u}+\\term{weight}{w_{uv}})),\\quad v<\\term{count}{N},\\ w_{uv}\\ge0,\\ c_u+w_{uv}\\le L;\\qquad c_v^*=\\min_s(c_s^0+d(s,v))\\le L","ascii":"Atomic minimum of non-negative f32 cost bits: c[v] <- min(c[v], f32(c[u] + w[u,v])). Negative/NaN weights are impassable; out-of-range neighbors and non-finite candidates are ignored. With cutoff L, candidates above L stay unreached (+Infinity); without a cutoff L = +Infinity. At convergence c[v] = min_s(c0[s] + d(s,v)), restricted to <= L, with path sums evaluated in f32. Chaotic: a visit may read costs improved earlier in the same round; rounds are not synchronous Bellman-Ford sweeps.","symbols":[{"id":"costs","role":"output","label":"minimum cost (f32 bits)","binding":"wgsl:costBits"},{"id":"source","role":"intermediate","label":"cost read by this visit","binding":"wgsl:sourceCost"},{"id":"weight","role":"input","label":"directed edge weight","binding":"wgsl:weight"},{"id":"count","role":"parameter","label":"node count","binding":"wgsl:NODE_COUNT"}]},{"id":"gpu-network.reachability.bands","derivation":"curated","tex":"\\term{band}{b_v}=\\begin{cases}\\#\\{i:\\term{thresholds}{t_i}<\\term{cost}{c_v}\\}&c_v<\\infty,\\ c_v\\le t_{m-1}\\\\\\term{none}{\\mathrm{NONE}}&\\text{otherwise}\\end{cases}","ascii":"For finite cost <= the last ascending threshold, band = count(threshold < cost); otherwise NONE (0xffffffff). Band 0 includes the first threshold; band i is (threshold[i-1], threshold[i]].","symbols":[{"id":"band","role":"output","label":"band id","binding":"wgsl:bands"},{"id":"thresholds","role":"input","label":"ascending cost breaks","binding":"wgsl:thresholds"},{"id":"cost","role":"input","label":"final cost","binding":"wgsl:cost"},{"id":"none","role":"constant","label":"no band","binding":"wgsl:NONE"}]}],"sources":[]},"decisions":[],"choices":[{"stage":"assignment","name":"groups","value":"4 x 2 grid over the data bounding box","alternatives":["communities","service areas"],"sweepable":false,"label":"input groups computed in the script (data preparation), not a GPU result"},{"stage":"presentation","name":"shown nodes","value":12,"alternatives":[1199],"sweepable":false,"label":"the table shows evenly spaced node ids; the datum rung reads every node"}],"captures":{"schema":"luma.computation-captures/1","runId":"run-8da14b65","snapshots":[{"id":"groups","name":"groups","iteration":0,"elementType":"u32","values":"rle:BAAAAAMAAAAEAAAABAAAAAEAAAABAAAAAQAAAAIAAAACAAAAAgAAAAIAAAADAAAAAwAAAAIAAAACAAAAAgAAAAIAAAABAAAAAgAAAAIAAAABAAAAAgAAAAMAAAADAAAAAgAAAAIAAAACAAAAAgAAAAMAAAADAAAAAwAAAAEAAAABAAAAAgAAAA==,*23:00000007,,*17:00000006,,*23:00000007,,*17:00000000,","provenance":"gpu-readback","graph":"gpu-network.adjacency-matrix-order-compiled","resource":"groups","meaning":"input: group label of every intersection","keySpace":"node"},{"id":"order","name":"order","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-network.adjacency-matrix-order-compiled","resource":"order","meaning":"GPU matrix position of every intersection (order[node] = position)","keySpace":"node"},{"id":"sampleNodes","name":"sampleNodes","elementType":"u32","values":"b64:AAAAAGMAAADGAAAAKQEAAIwBAADvAQAAUgIAALUCAAAYAwAAewMAAN4DAABBBAAA","provenance":"gpu-readback","keySpace":"sample","role":"input","meaning":"input: node id of each shown intersection (evenly spaced)"},{"id":"groupsSample","name":"groupsSample","elementType":"u32","values":"b64:BAAAAAYAAAABAAAABgAAAAAAAAAEAAAABAAAAAYAAAAFAAAAAQAAAAUAAA