9},"gpu-network.adjacency-matrix-snapshot-tap":{"cpuEncodeMs":0.10000000149011612}}}]},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const identityOutOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> identityOut: array<u32>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &identityOut;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  identityOut[identityOutOffset + index] = index;","}","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","@compute @workgroup_size(64)","  _ = &fillTarget;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  fillTarget[fillTargetOffset + index] = 0u;","@compute @workgroup_size(32)","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","const verticesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> vertices: array<u32>;","const orderOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> orderOut: array<u32>;","  _ = &vertices;","  _ = &orderOut;","  orderOut[orderOutOffset + vertices[verticesOffset + index]] = index;","const offsetsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> neighbors: array<u32>;","const orderOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> order: array<u32>;","const countCellsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> countCells: array<atomic<u32>>;","const NODE_COUNT: u32 = 1199u;","const RESOLUTION: u32 = 8u;","const WEIGHT_SCALE: f32 = 1024;","// Rounds the float32 product half up. The product feeds only floor() and comparisons, so no","// compiler can fuse it into an addition, and above 2^23 (where every float32 is an integer and","// adding 0.5 would round to the even neighbour) the product is returned as it is.","fn fixedWeight(weight: f32) -> u32 {","  let scaled = weight * WEIGHT_SCALE;","  if (!(scaled > 0.0)) {","    return 0u;","  if (scaled >= 4294967040.0) {","    return 0xffffffffu;","  let whole = floor(scaled);","  let roundsUp = whole < 8388608.0 && scaled >= whole + 0.5;","  return u32(whole) + select(0u, 1u, roundsUp);","fn getBin(position: u32, start: u32, end: u32) -> u32 {","  return (position - start) * RESOLUTION / (end - start);","  _ = &offsets;","  _ = &neighbors;","  _ = &order;","  _ = &countCells;","  let rowStart = 0u;","  let rowEnd = NODE_COUNT;","  let colStart = 0u;","  let colEnd = NODE_COUNT;","  if (false) {","  let source = order[orderOffset + index];","  // A row contributes only from its own row position, or, when mirrored, from its column","  // position too. Skipping every other row keeps a zoomed window O(window rows), not O(slots).","  if (!((source >= rowStart && source < rowEnd))) {","  let rowBegin = offsets[offsetsOffset + index];","  let rowEnd2 = offsets[offsetsOffset + index + 1u];","  for (var slot = rowBegin; slot < rowEnd2; slot++) {","    let neighbor = neighbors[neighborsOffset + slot];","    if (neighbor >= NODE_COUNT) {","      continue;","    }","    ","    let targetPosition = order[orderOffset + neighbor];","    if (source >= rowStart && source < rowEnd && targetPosition >= colStart && targetPosition < colEnd) {","      let cell = getBin(source, rowStart, rowEnd) * RESOLUTION + getBin(targetPosition, colStart, colEnd);","      atomicAdd(&countCells[countCel