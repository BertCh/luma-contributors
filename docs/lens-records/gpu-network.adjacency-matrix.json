{"schema":"luma.lens-record/1","scenarioId":"gpu-network.adjacency-matrix","recordedAt":"2026-11-15T02:48:49.890Z","adapterLabel":"apple (unknown)","record":{"schema":"luma.computation/1","id":"gpu-network.adjacency-matrix","runId":"run-7bc11870","createdAt":"2026-11-15T02:48:49.880Z","adapter":{"backend":"webgpu","vendor":"apple","architecture":"metal-3","description":""},"domains":["gpu-network"],"graphs":[["~:0","gpu-network.adjacency-matrix-compiled","compiled","gpu-network","gpu-network.adjacency-matrix",[["~:1","~i","~i","","~1","~19","wgsl:c1e5734f",[256,1,1],"~^3",[["~:3","identityOut","~i","~15","u32",0,1199]],"~^4",["~i"],["~i"],["~:5","~19","identity",1,5,1199,0,4796],["~:6"]],["~:7","~r","~r","","~1",["~1m"],["~r"],["~:6"]],["~:1","~1i","~1i","","~1","~t","wgsl:4214f29d",[64,1,1],"~^5",[["~:3","~1p","~g","~15","u32",0,64]],"~^6",["~g"],["~g"],["~:5","~t","~1o",1,1,64,0,256],["~:6"]],["~:1","~1j","~1j","","~1","~t","wgsl:cdc28224",[32,1,1],["~:2",1,1,1],[["~:3","~1p","~p","~15","u32",0,1]],["~:4",[1,1,1],1,false],["~p"],["~p"],["~:5","~t","~1o",1,1,1,0,4],["~:6"]],["~:8","~x","~x","","~1","~b",["~r"],["~1a"],"~^0",["~:6"]],["~:7","~f","~f","","~1",["~1m","~i","~1a"],"~^1",["~:6"]],["~:7","~n","~n","","~1",["~0"],["~n"],["~:6"]],["~:8","~13","~13","","~1","~b",["~n"],["~1g"],"~^0",["~:6"]],["~:7","~e","~e","","~1",["~0","~6","~1g"],"~^2",["~:6"]],["~:7","~o","~o","","~1",["~3"],["~o"],["~:6"]],["~:8","~14","~14","","~1","~b",["~o"],["~1h"],"~^0",["~:6"]],["~:7","~a","~a","","~1",["~3","~5","~1h"],"~^1",["~:6"]],["~:7","~j","~j","","~1",["~0"],["~j"],["~:6"]],["~:8","~y","~y","","~1","~b",["~j"],["~1b"],"~^0",["~:6"]],["~:7","~7","~7","","~1",["~0","~6","~1b"],"~^2",["~:6"]],["~:7","~k","~k","","~1",["~3"],["~k"],["~:6"]],["~:8","~z","~z","","~1","~b",["~k"],["~1c"],"~^0",["~:6"]],["~:7","~8","~8","","~1",["~3","~5","~1c"],"~^1",["~:6"]],["~:7","~l","~l","","~1",["~0"],["~l"],["~:6"]],["~:8","~10","~10","","~1","~b",["~l"],["~1d"],"~^0",["~:6"]],["~:7","~9"