d)) {","      continue;","    }","    let weight = rowWeights[rowWeightsOffset + row];","    if (!isFiniteBits(weight)) {","    cumulativeSum += weight;","    gravitySum += weight * getDecay(cost, decay, beta, minimumCost);","  ","  gravity[gravityOffset + index] = gravitySum;","const demandOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> demand: array<f32>;","@group(0) @binding(1) var<storage, read> nearest: array<f32>;","const coveredOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> covered: array<f32>;","const uncoveredOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> uncovered: array<f32>;","const invalidOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> invalid: array<u32>;","  _ = &demand;","  _ = &covered;","  _ = &uncovered;","  _ = &invalid;","  var coveredTotal = 0.0; var uncoveredTotal = 0.0; var invalidCount = 0u;","for (var row = 0u; row < 4u; row++) {","  let weight = demand[demandOffset + row]; let cost = nearest[nearestOffset + row];","  if (!isFiniteValue(weight) || weight < 0.0) { invalidCount++; continue; }","  if (isFiniteValue(cost) && cost <= parameters[parametersOffset]) { coveredTotal += weight; } else { uncoveredTotal += weight; }","covered[coveredOffset] = coveredTotal; uncovered[uncoveredOffset] = uncoveredTotal; invalid[invalidOffset] = invalidCount;"],"strings":["buffer","facility-scenario-recipe-summary","read","facility-scenario-recipe-accessibility-scores","facility-scenario-recipe-nearest","imported","facility-scenario-recipe-active-supply","facility-scenario-recipe-nearest-costs","facility-scenario-recipe-supply","parameters","read_write","transient","facility-scenario-recipe","facility-scenario-recipe-accessibility","facilityCosts","facilityMask","compute","demand","facility-scenario-recipe-covered","facility-scenario-recipe-invalid","facility-scenario-recipe-nearest-facilities","facility-scenario-recipe-uncovered","supply","GPUNetworkAccessibility","costs","mask","neare