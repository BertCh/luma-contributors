ocalInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &source;","  _ = &mask;","  _ = &destination;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  destination[destinationOffset + index] = select(0.0, source[sourceOffset + index], mask[maskOffset + index] != 0u);","}","const costsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> costs: array<f32>;","const nearestOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> nearest: array<f32>;","const facilityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> facility: array<u32>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","  _ = &costs;","  _ = &nearest;","  _ = &facility;","  var minimum = bitcast<f32>(0x7f800000u | (index & 0u)); var selected = 0xffffffffu;","for (var candidate = 0u; candidate < 2u; candidate++) {","  let cost = costs[costsOffset + candidate * 4u + index];","  if (mask[maskOffset + candidate] != 0u && isFiniteValue(cost) && cost >= 0.0 && cost < minimum) { minimum = cost; selected = candidate; }","nearest[nearestOffset + index] = minimum; facility[facilityOffset + index] = selected;","const rowWeightsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> rowWeights: array<f32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","const gravityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> gravity: array<f32>;","const ROW_COUNT: u32 = 2u;","const COLUMN_COUNT: u32 = 4u;","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","fn isWithinThreshold(cost: f32, threshold: f32) -> bool {","  // Unreached entries are +Infinity; an infinite threshold must still reject them.","  return (bitcast<u32>(cost) & 0x7f800000u) != 0x7f800000u && cost >= 0.0 && cost <= threshold;","fn getDecay(cost: f32, decay: u32, beta: f32, minimumCost: f32) -> f32 {","  if (decay == 1u) {","    return exp(-beta * cost);","  if (decay == 2u) {","    return pow(max(cost, minimumCost), -beta);","  return 1.0;","  _ = &rowWeights;","  _ = &parameters;","  _ = &gravity;","  let threshold = parameters[parametersOffset];","  let decay = u32(max(parameters[parametersOffset + 1u], 0.0));","  let beta = parameters[parametersOffset + 2u];","  let minimumCost = parameters[parametersOffset + 3u];","  var cumulativeSum = 0.0;","  var gravitySum = 0.0;","  for (var row = 0u; row < ROW_COUNT; row++) {","    let cost = costs[costsOffset + row * COLUMN_COUNT + index];","    if (!isWithinThreshold(cost, threshold)) {","      continue;","    }","    let weight = rowWeights[rowWeightsOffset + row];","    if (!isFiniteBits(weight)) {","    cumulativeSum += weight;","    gravitySum += weight * getDecay(cost, decay, beta, minimumCost);","  ","  gravity[gravityOffset + index] = gravitySum;","const demandOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> demand: array<f32>;","@group(0) @binding(1) var<storage, read> nearest: array<f32>;","const coveredOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> covered: array<f32>;","const uncoveredOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> uncovered: array<f32>;","const invalidValuesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> invalidValues: array<u32>;","  _ = &demand;","  _ = &covered;","  _ = &uncovered;","  _ = &invalidValues;","  let weight = demand[demandOffset + index];","let cost = nearest[nearestOffset + index];","let valid = isFiniteValue(weight) && weight >= 0.0;","let reached = isFiniteValue(cost) && cost <= parameters[parametersOffset];","covered[coveredOffset + index] = select(0.0, weight, valid && reached);","uncovered[uncoveredOffset + index] = select(0.0, weight, valid && !reached);","invalidValues[invalidValuesOffset + index] = u32(!valid);"],"strings":["buffer","gpu-network.facility-scenario-recipe-snapshot-tap","imported","facility-scenario-recipe-summary","compute","read","facility-scenario-recipe-nearest","facility-scenario-recipe-nearest-costs","facility-scenario-recipe-accessibility-scores","facility-scenario-recipe-active-supply","facility-scenario-recipe-supply","parameters","read_write","transient","facility-scenario-recipe","facility-scenario-recipe-accessibility","facility-scenario-recipe-covered-values","facility-scenario-recipe-nearest-facilities","facility-scenario-recipe-summary-covered-finalize","facility-scenario-recipe-summary-covered-level-0","facility-scenario-recipe-summary-invalid-sum-finalize","facility-scenario-recipe-summary-invalid-sum-level-0","facility-scenario-recipe-summary-invalid-values","facility-scenario-recipe-summary-uncovered-finalize","facility-scenario-recipe-summary-uncovered-level-0","facility-scenario-recipe-uncovered-values","facilityCosts","facilityMask","demand","facility-scenario-recipe-covered","facility-scenario-recipe-invalid","facility-scenario-recipe-summary-covered-level-0-values","facility-scenario-recipe-summary-invalid-sum-level-0-values","facility-scenario-recipe-summary-uncovered-level-0-values","facility-scenario-recipe-uncovered","supply","GPUNetworkAccessibility","costs","mask","nearest","neighbors","offsets","weights"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maxim