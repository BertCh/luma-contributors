j","raw","~h"],["~:5","~1j","~c","raw","~h"],["~:5","~e","~c","raw","~9"],["~:5","~c","~f","raw","~c"],["~:5","~1k","~f","raw","~1o"],["~:5","~e","~f","raw","~9"],["~:5","~c","~f","war","~9"],["~:5","~f","~g","raw","~9"]],[["~:6","~9","~a","~2o","~g",160,"~b"],["~:6","~j","~a","~2n","~e",4796,"~b"],["~:6","~h","~a","~2m","~c",4796,"~b"],["~:6","~2","~a","~2l","~1j",4796,"~b"],["~:6","~0","~a","~1p","~1k",4,"~b"],["~:6","~6","~a","~5","~g",4800,"~b"],["~:6","~d","~a","~5","~e",4796,"~b"],["~:6","~1n","~a","~5","~1i",32,"~b"],["~:6","~2p","~a","~5","~g",11240,"~b"],["~:6","~4","~a","~5","~i",11240,"~b"],["~:6","~k","~a","~1g","~1h",4796,"~b"],["~:6","~1m","~a","~1g","~1l",32,"~b"],["~:6","~1o","~a","~1k","~f",4,"~b"],["~:6","~c","~a","~c","~f",60,"~b"],["~:6","~2q","~a","~g","~g",9592,"~b"]]]],"axes":{"axes":[{"id":"entity","label":"element datum","kind":"data","keySpace":"degree-bin"}],"keySpaces":[{"id":"node","label":"network node","indexSpace":"1d","size":1199},{"id":"edge","label":"directed edge","indexSpace":"csr","size":2810},{"id":"vertex","label":"graph vertex","indexSpace":"1d","size":1199},{"id":"degree-bin","label":"out-degree bin","indexSpace":"1d","size":8},{"id":"statistic","label":"summary header word","indexSpace":"1d","size":14}],"relations":[{"id":"node-out-edges","from":"node","to":"node","cardinality":"1:N","kind":"buffer","timeDependent":false,"ref":{"layout":"csr","resource":"gpu-network.network-statistics-neighbors","offsetsResource":"gpu-network.network-statistics-offsets","capture":"neighbors"}}]},"refs":{"formulas":[{"id":"gpu-network.statistics.degree-histogram","derivation":"curated","tex":"\\term{localHistogram}{H}[\\term{getBin}{b}(\\term{outValue}{d})]\\leftarrow\\term{localHistogram}{H}[\\term{getBin}{b}(\\term{outValue}{d})]+1","ascii":"localHistogram[getBin(outValue)] += 1 (atomic) for every live node, where outValue is its live out-degree and getBin(d) = min(floor(d / binWidth), BIN_COUNT - 1) for the linear rule (the last bin saturates; log2 binning uses bin 0 for d = 0, else min(1 + floor(log2 d), BIN_COUNT - 1)). Each workgroup then adds its non-empty bins to the summary words, so integer addition makes the histogram independent of thread order. The in-degree and total-degree histograms use the same rule.","symbols":[{"id":"localHistogram","role":"intermediate","label":"workgroup histogram","binding":"wgsl:localHistogram"},{"id":"getBin","role":"intermediate","label":"degree bin","binding":"wgsl:getBin"},{"id":"outValue","role":"input","label":"live out-degree","binding":"wgsl:outValue"}]},{"id":"gpu-network.service-areas.label","derivation":"curated","tex":"\\term{labels}{L}[\\term{targetNode}{v}]\\leftarrow\\min\\bigl(\\term{labels}{L}[\\term{targetNode}{v}],\\ \\term{sourceLabel}{\\ell_u}\\bigr)\\quad\\text{over tight edges }u\\to v:\\ \\term{tight}{c_u+w_{uv}=c_v}","ascii":"Label phase, after the cost search: on every tight edge u->v (f32 equality costs[u] + w == costs[v], no tolerance, zero-weight edges included) labels[v] = min(labels[v], labels[u]) with an atomic minimum, seeded at the facility nodes. The fixpoint is the smallest facility row among all facilities that reach v at its minimum cost, independent of thread order. Unreached nodes keep NONE (0xffffffff).","symbols":[{"id":"labels","role":"output","label":"facility row per node","binding":"wgsl:labels"},{"id":"targetNode","role":"intermediate","label":"edge target v","binding":"wgsl:targetNode"},{"id":"sourceLabel","role":"intermediate","label":"label of the edge source u","binding":"wgsl:sourceLabel"},{"id":"tight","role":"input","label":"tight-edge bit","binding":"wgsl:tightBits"}]},{"id":"gpu-network.neighborhood.hops","derivation":"curated","tex":"\\term{hopDistances}{h_v}=\\begin{cases}\\operatorname{u32}(\\term{cost}{c_v})&\\term{cost}{c_v}\\le\\term{limit}{k}\\\\\\term{none}{\\mathrm{NONE}}&\\text{otherwise}\\end{cases}","ascii":"hopDistances[v] = cost[v] <= limit ? uint(cost[v]) : NONE, where cost is the unit-weight search cost, limit = min(hops, maximumHops) and NONE = 0xffffffff. NaN and +Infinity costs compare false and stay outside the ego network.","symbols":[{"id":"hopDistances","role":"output","label":"hop distance","binding":"wgsl:hopDistances"},{"id":"cost","role":"input","label":"unit-weight cost","binding":"wgsl:cost"},{"id":"limit","role":"parameter","label":"hop radius","binding":"wgsl:limit"},{"id":"none","role":"constant","label":"outside the ego network","binding":"wgsl:NONE"}]},{"id":"gpu-network.isochrones.cost","derivation":"curated","tex":"\\term{cost}{c}=\\left|\\term{sourceCost}{d_u}+\\term{t}{t}\\,\\term{weight}{w_{uv}}+\\term{walk}{a}\\,\\term{pixelDistance}{r}\\right|,\\qquad \\text{pixel}=\\min c","ascii":"Per edge sample at fraction t along u->v and per pixel within the buffer radius: cost = abs(sourceCost + t*weight + walk*pixelDistance); each pixel keeps the minimum cost over all samples (min mode; atomic minimum on order-preserving f32 bits, so the result does not depend on thread order). Samples are linear along straight segments between node positions, so this is a sampled raster, not an exact polygonal travel-time boundary; pixels no sample reaches stay unreached.","symbols":[{"id":"cost","role":"output","label":"pixel cost candidate","binding":"wgsl:cost"},{"id":"sourceCost","role":"input","label":"cost at edge source","binding":"wgsl:sourceCost"},{"id":"t","role":"intermediate","label":"sample fraction","binding":"wgsl:t"},{"id":"weight","role":"input","label":"edge travel time","binding":"wgsl:weight"},{"id":"walk","role":"parameter","label":"walk cost per metre","binding":"wgsl:walk"},{"id":"pixelDistance","role":"intermediate","label":"sample-to-pixel distance","binding":"wgsl:pixelDistance"}]},{"id":"gpu-network.catchment.band","derivation":"curated","tex":"\\term{band}{b}=\\min\\{k:\\ \\term{time}{t}<\\term{bandBreaks}{B}[\\term{k}{k}]\\}","ascii":"band = first k with time < bandBreaks[k], else 0xffffffff (no band). Upper bounds are strict; unreached, unsnapped or non-finite demand times (>= 3.0e38) get no band. time = min(cost[source] + sourceCost, cost[target] + targetCost) on the snapped edge, from the demand-time kernel.","symbols":[{"id":"band","role":"output","label":"drive-time band","binding":"wgsl:bands"},{"id":"time","role":"input","label":"demand drive time","binding":"wgsl:time"},{"id":"bandBreaks","role":"input","label":"ascending band bounds","binding":"wgsl:bandBreaks"},{"id":"k","role":"intermediate","label":"band index","binding":"wgsl:k"}]},{"id":"gpu-network.snapping.nearest","derivation":"curated","tex":"\\term{bestEdge}{e^*}=\\operatorname*{argmin}_{e}\\ \\term{distance}{d(p,e)}","ascii":"For each point p the scan visits every edge row e in ascending order and keeps the edge with the smallest point-to-segment distance d(p,e): bestEdge = e when bestEdge is NONE or d < bestDistance (strict, so ties go to the smallest edge row; NaN never wins). Distances are in the spatial context length unit (meters for a great-circle longitude/latitude context); with a maximum snap distance, edges beyond it are skipped and an unsnapped point gets NONE.","symbols":[{"id":"bestEdge","role":"output","label":"snapped edge row","binding":"wgsl:bestEdge"},{"id":"distance","role":"intermediate","label":"distance to edge","binding":"wgsl:distance"},{"id":"bestDistance","role":"intermediate","label":"smallest distance so far","binding":"wgsl:bestDistance"}]},{"id":"gpu-network.accessibility.gravity","derivation":"curated","tex":"\\term{gravitySum}{A_j}=\\sum_{i}\\term{weight}{O_i}\\,e^{-\\term{beta}{\\beta}\\,\\term{cost}{c_{ij}}}\\quad\\text{over }c_{ij}\\le\\term{threshold}{T}","ascii":"Exponential-decay variant, opportunity-rows orientation: for every column node j the kernel sums rows i in ascending order and adds weight[i] * exp(-beta * cost[i,j]) for finite costs 0 <= cost <= threshold and finite weights (unreached +Infinity entries and non-finite weights are skipped; the sum is deterministic, no float atomics, and weights are not normalised). The cumulative variant omits the decay and the power variant uses max(cost, minimumCost)^-beta; they are alternative branches of the same kernel.","symbols":[{"id":"gravitySum","role":"output","label":"gravity score","binding":"wgsl:gravitySum"},{"id":"weight","role":"input","label":"opportunity weight","binding":"wgsl:weight"},{"id":"beta","role":"parameter","label":"decay rate","binding":"wgsl:beta"},{"id":"cost","role":"input","label":"matrix cost","binding":"wgsl:cost"},{"id":"threshold","role":"parameter","label":"cost cutoff","binding":"wgsl:threshold"}]},{"id":"gpu-network.analytics.normalize","derivation":"curated","tex":"\\term{normalized}{s}=\\begin{cases}(\\term{degree}{x}-\\term{lowest}{a})/(\\term{highest}{b}-\\term{lowest}{a})&\\term{highest}{b}>\\term{lowest}{a}\\\\0&\\text{otherwise}\\end{cases}","ascii":"normalized = highest > lowest ? (raw - lowest) / (highest - lowest) : 0, in f32. lowest and highest are the two words of the extent reduction (minimum, maximum of the raw column over all nodes); a column with a single value (no range) normalizes to 0 for every node. The raw degree is the outgoing CSR row length from the degree algorithm.","symbols":[{"id":"normalized","role":"output","label":"scaled degree","binding":"wgsl:normalized"},{"id":"degree","role":"input","label":"raw column value","binding":"wgsl:raw"},{"id":"lowest","role":"intermediate","label":"column minimum","binding":"wgsl:lowest"},{"id":"highest","role":"intermediate","label":"column maximum","binding":"wgsl:highest"}]},{"id":"gpu-network.centrality.closeness","derivation":"curated","tex":"\\term{closeness}{C}=\\begin{cases}(\\term{reachedPartial}{r}-1)/\\term{totalCost}{S}&\\term{totalCost}{S}>0\\\\0&\\text{otherwise}\\end{cases}","ascii":"closeness = totalCost > 0 ? (reachedPartial[0] - 1) / totalCost : 0, per pivot. Outward closeness: totalCost is the f32 sum of the search costs of every node the pivot reaches (infinite costs are skipped), added by a fixed 256-lane tree reduction so the value does not depend on thread order. reachedPartial[0] counts the reached nodes including the pivot itself. The Wasserman-Faust factor (r - 1) / (N - 1) is not applied; the unit is 1 / cost (1 / second on travel-time weights).","symbols":[{"id":"closeness","role":"output","label":"outward closeness","binding":"wgsl:closeness"},{"id":"reachedPartial","role":"intermediate","label":"reached nodes, pivot included","binding":"wgsl:reachedPartial"},{"id":"totalCost","role":"intermediate","label":"sum of reached costs","binding":"wgsl:totalCost"}]},{"id":"gpu-network.subgraph-filter.range","derivation":"curated","tex":"\\term{live}{m}\\leftarrow\\term{live}{m}\\land\\bigl(\\term{parameters}{p}[\\term{base}{b}]\\le\\term{value}{x}<\\term{parameters}{p}[\\term{base}{b}+1]\\bigr)","ascii":"For every enabled range, live = live && value >= parameters[base] && value < parameters[base + 1]: half-open, so the maximum itself is excluded, and a NaN value never passes. A disabled range (parameters[base + 2] == 0) is skipped. The mask starts at 1 (or at the caller mask), so the result is the AND of all ranges; an edge slot is finally kept only when both of its endpoints are live, and dropIsolated also removes nodes left without a live slot. Integer and comparison arithmetic only, so the result is exact.","symbols":[{"id":"live","role":"output","label":"slot is kept","binding":"wgsl:live"},{"id":"parameters","role":"parameter","label":"range bounds","binding":"wgsl:parameters"},{"id":"base","role":"intermediate","label":"range record offset","binding":"wgsl:base"},{"id":"value","role":"input","label":"column value","binding":"wgsl:value"}]},{"id":"gpu-network.adjacency-matrix.bin","derivation":"curated","tex":"\\term{getBin}{b}(\\term{position}{p},\\term{start}{s},\\term{end}{e})=\\left\\lfloor\\frac{(\\term{position}{p}-\\term{start}{s})\\,\\term{RESOLUTION}{R}}{\\term{end}{e}-\\term{start}{s}}\\right\\rfloor","ascii":"getBin(position, start, end) = (position - start) * RESOLUTION / (end - start) with u32 division (floor). A live slot u -> v adds 1 (atomically) to cell getBin(order[u]) * RESOLUTION + getBin(order[v]): rows are source positions, columns are target positions, and slots whose positions fall outside the window [start, end) are dropped. Counts are exact integers, so the matrix does not depend on thread order; with fewer bins than nodes, each bin covers several consecutive matrix positions.","symbols":[{"id":"getBin","role":"output","label":"matrix bin","binding":"wgsl:getBin"},{"id":"position","role":"input","label":"matrix position","binding":"wgsl:position"},{"id":"start","role":"parameter","label":"window start","binding":"wgsl:start"},{"id":"end","role":"parameter","label":"window end","binding":"wgsl:end"},{"id":"RESOLUTION","role":"parameter","label":"bins per axis","binding":"wgsl:RESOLUTION"}]},{"id":"gpu-network.line-graph.arc-weight","derivation":"curated","tex":"\\term{lineWeights}{w_{ef}}=\\begin{cases}\\term{baseCost}{w_f}+\\max(\\term{getTurnCost}{p_{ef}},0)&\\term{baseCost}{w_f}\\ge0\\\\-1&\\text{otherwise}\\end{cases}","ascii":"lineWeights[arc e -> f] = baseCost >= 0 ? baseCost + max(turnCost, 0) : -1, where baseCost = weights[f] is the cost of the NEXT edge f (not of the entering edge e) and turnCost = getTurnCost(e, f) = angleCost * |angle| plus the left or right extra beyond straightAngle; a turn with |angle| >= uTurnAngle pays uTurnCost instead, and a negative uTurnCost bans it (no arc is emitted). Banned pairs are removed too, so every emitted arc has turnCost >= 0. The angle is between the great-circle arrival bearing of e and the departure bearing of f at the turn node, positive to the left. Arcs of one edge are listed in ascending next-edge order.","symbols":[{"id":"lineWeights","role":"output","label":"arc cost","binding":"wgsl:lineWeights"},{"id":"baseCost","role":"input","label":"cost of the next edge","binding":"wgsl:baseCost"},{"id":"getTurnCost","role":"intermediate","label":"turn cost","binding":"wgsl:getTurnCost"}]},{"id":"gpu-network.cost-table.admission","derivation":"curated","tex":"\\term{isIncluded}{I}=\\mathbf{1}\\bigl[\\operatorname{finite}(\\term{cost}{c})\\wedge \\term{cost}{c}\\ge 0\\bigr]","ascii":"Table admission, after the cutoff search of one source row: isIncluded = isFiniteBits(cost) && cost >= 0, where cost is the f32 reachability fixpoint searched with the cost limit. Unreached nodes are +Infinity and are not stored; the source itself is stored at cost 0. Included targets are packed in ascending node order by an inclusive scan, so slot order is fixed; entries past the capacity are dropped and reported by the overflow status. This is the admission rule, not a second shortest-path formula.","symbols":[{"id":"isIncluded","role":"output","label":"entry is stored","binding":"wgsl:isIncluded"},{"id":"cost","role":"input","label":"network cost from the source","binding":"wgsl:cost"}]},{"id":"gpu-network.cost-weights.decay","derivation":"curated","tex":"\\term{weights}{w}=e^{-\\term{beta}{\\beta}\\,\\term{cost}{c}}\\quad\\text{for finite }0\\le c\\le L","ascii":"Exponential decay, the branch chosen by the decay parameter: weights = exp(-beta * cost) for every finite matrix cost with 0 <= cost <= costLimit; other entries (unreached +Infinity, negative, beyond the limit) are not stored. Slots follow ascending neighbor order within each row. The 'none' branch stores 1, 'power' stores max(cost, minimumCost)^-beta and 'gaussian' stores the truncated, rescaled (exp(-0.5 (c/L)^2) - exp(-0.5)) / (1 - exp(-0.5)); they are alternative branches of the same kernel.","symbols":[{"id":"weights","role":"output","label":"stored decay weight","binding":"wgsl:weights"},{"id":"beta","role":"parameter","label":"decay rate","binding":"wgsl:beta"},{"id":"cost","role":"input","label":"matrix cost","binding":"wgsl:cost"}]},{"id":"gpu-network.k-function.k","derivation":"curated","tex":"\\term{k}{K(d_k)}=2\\,\\term{cumulative}{P(d_k)}\\,\\term{networkLength}{L}\\,/\\,\\term{count}{n}^{2}\\qquad(n\\ge 2,\\ \\text{else }0)","ascii":"K(d_k) = 2 * cumulative * networkLength / (count * count) for count >= 2 snapped events, else 0. cumulative is the number of unordered event pairs whose network distance is strictly below the band threshold d_k = maximumDistance * k / (bandCount - 1) (a prefix sum of the per-band pair histogram); networkLength is the length of every road counted once. The denominator is count squared (the spaghetti GlobalAutoK normalisation), not count * (count - 1). With zero simulations only the observed row exists.","symbols":[{"id":"k","role":"output","label":"K value of the band","binding":"wgsl:k"},{"id":"cumulative","role":"intermediate","label":"pairs closer than the threshold","binding":"wgsl:cumulative"},{"id":"networkLength","role":"parameter","label":"total network length","binding":"wgsl:networkLength"},{"id":"count","role":"input","label":"snapped event count","binding":"wgsl:count"}]},{"id":"gpu-network.flow-aggregation.pair-sum","derivation":"curated","tex":"\\term{rowWeights}{W}=\\sum_{x\\in\\text{pair}}\\term{sortedContributions}{x}","ascii":"rowWeights[row] = fixed_tree_sum(sortedContributions[begin:end]): one workgroup per stored origin-destination pair sums the pair's contributions (the weights of its records, in source row order, 0 for rejected or non-finite weights) with a strided partial sum and a fixed binary tree, so the float sum is bitwise reproducible. It is a sum of the weights (trips), not a mean and not the record count; flowCounts counts the records of the pair separately.","symbols":[{"id":"rowWeights","role":"output","label":"weight sum of the pair","binding":"wgsl:rowWeights"},{"id":"sortedContributions","role":"input","label":"record weights of the pair, sorted","binding":"wgsl:sortedContributions"}]},{"id":"gpu-network.reachability.relax","derivation":"curated","tex":"\\term{costs}{c_v}\\leftarrow\\min(\\term{costs}{c_v},\\operatorname{f32}(\\term{source}{c_u}+\\term{weight}{w_{uv}})),\\quad v<\\term{count}{N},\\ w_{uv}\\ge0,\\ c_u+w_{uv}\\le L;\\qquad c_v^*=\\min_s(c_s^0+d(s,v))\\le L","ascii":"Atomic minimum of non-negative f32 cost bits: c[v] <- min(c[v], f32(c[u] + w[u,v])). Negative/NaN weights are impassable; out-of-range neighbors and non-finite candidates are ignored. With cutoff L, candidates above L stay unreached (+Infinity); without a cutoff L = +Infinity. At convergence c[v] = min_s(c0[s] + d(s,v)), restricted to <= L, with path sums evaluated in f32. Chaotic: a visit may read costs improved earlier in the same round; rounds are not synchronous Bellman-Ford sweeps.","symbols":[{"id":"costs","role":"output","label":"minimum cost (f32 bits)","binding":"wgsl:costBits"},{"id":"source","role":"intermediate","label":"cost read by this visit","binding":"wgsl:sourceCost"},{"id":"weight","role":"input","label":"directed edge weight","binding":"wgsl:weight"},{"id":"count","role":"parameter","label":"node count","binding":"wgsl:NODE_COUNT"}]},{"id":"gpu-network.reachability.bands","derivation":"curated","tex":"\\term{band}{b_v}=\\begin{cases}\\#\\{i:\\term{thresholds}{t_i}<\\term{cost}{c_v}\\}&c_v<\\infty,\\ c_v\\le t_{m-1}\\\\\\term{none}{\\mathrm{NONE}}&\\text{otherwise}\\end{cases}","ascii":"For finite cost <= the last ascending threshold, band = count(threshold < cost); otherwise NONE (0xffffffff). Band 0 includes the first threshold; band i is (threshold[i-1], threshold[i]].","symbols":[{"id":"band","role":"output","label":"band id","binding":"wgsl:bands"},{"id":"thresholds","role":"input","label":"ascending cost breaks","binding":"wgsl:thresholds"},{"id":"cost","role":"input","label":"final cost","binding":"wgsl:cost"},{"id":"none","role":"constant","label":"no band","binding":"wgsl:NONE"}]}],"sources":[]},"decisions":[],"choices":[{"stage":"summary","name":"degreeBinCount","value":8,"alternatives":[4,16],"sweepable":true},{"stage":"summary","name":"degreeBinning","value":"linear","alternatives":["log2"],"sweepable":false},{"stage":"representation","name":"directed","value":true,"alternatives":[false],"sweepable":false}],"captures":{"schema":"luma.computation-captures/1","runId":"run-db13c3c5","snapshots":[{"id":"networkStatistics","name":"networkStatistics","elementType":"u32","values":"b64:rwQAAPoKAAD6CgAAAQAAAK8EAAABAAAAAAAAAAYAAAAGAAAADAAAAAAAAAAAAAAAAAAAAAUAAAA=","provenance":"gpu-readback","resource":"summary","graph":"gpu-network.network-statistics-compiled","keySpace":"statistic","role":"output","meaning":"output: GPU summary words 0-13 as written: 0 liveNodeCount, 1 liveEdgeCount, 2 liveSlotCount, 3 componentCount, 4 largestComponentSize, 5 componentsConverged, 6 isolatedNodeCount, 7 maximumOutDegree, 8 maximumInDegree, 9 maximumTotalDegree, 10 modularity (float32 bits, 0 without communities), 11 modularityValid, 12 intraCommunitySlotCount, 13 selfLoopSlotCount"},{"id":"outDegreeHistogram","name":"outDegreeHistogram","elementType":"u32","values":"b64:AAAAAMEAAAAPAgAAZAEAAHkAAAABAAAAAQAAAAAAAAA=","provenance":"gpu-readback","resource":"summary","graph":"gpu-network.network-statistics-compiled","keySpace":"degree-bin","role":"output","meaning":"output: GPU summary words 16-23, live nodes per out-degree bin; bin b holds out-degree b (linear width 1) and the last bin holds 7 and above"}],"stamps":[],"replays":[]},"metrics":[{"schema":"luma.computation-metrics/1","runId":"run-db13c3c5","graph":"gpu-network.network-statistics-compiled","timebase":"ns","encoding":{"coalesced":false,"timestamped":false,"taps":1,"lensTwin":true,"retained":["summary"]},"nodes":{}}]},"encoding":{"strings":["network-statistics-components-changed","GPUNetworkStatistics","network-statistics-component-labels","compute","network-statistics-masked-neighbors","network-statistics-slots","gpu-network.network-statistics-offsets","fill","component-step","summary","buffer","imported","network-statistics-finish-partials","network-statistics-out-degree","network-statistics-degrees","network-statistics-finish","gpu-network.network-statistics-snapshot-tap","network-statistics-component-size","network-statistics-components-step-31","network-statistics-in-degree","network-statistics-self-loop-counts","network-statistics-components-step-0","network-statistics-components-step-1","network-statistics-components-step-10","network-statistics-components-step-11","network-statistics-components-step-12","network-statistics-components-step-13","network-statistics-components-step-14","network-statistics-components-step-15","network-statistics-components-step-16","network-statistics-components-step-17","network-statistics-components-step-18","network-statistics-components-step-19","network-statistics-components-step-2","network-statistics-components-step-20","network-statistics-components-step-21","network-statistics-components-step-22","network-statistics-components-step-23","network-statistics-components-step-24","network-statistics-components-step-25","network-statistics-components-step-26","network-statistics-components-step-27","network-statistics-components-step-28","network-statistics-components-step-29","network-statistics-components-step-3","network-statistics-components-step-30","network-statistics-components-step-4","network-statistics-components-step-5","network-statistics-components-step-6","network-statistics-components-step-7","network-statistics-components-step-8","network-statistics-components-step-9","network-statistics-self-loops","network-statistics-slots-finalize","network-statistics-slots-fixup","network-statistics-component-sizes","network-statistics-components-converged","network-statistics-self-loops-fixup","network-statistics-self-loops-tile-carries","network-statistics-slots-tile-carries","network-statistics-component-converged","network-statistics-components-clear-0","network-statistics-components-clear-1","network-statistics-components-clear-10","network-statistics-components-clear-11","network-statistics-components-clear-12","network-statistics-components-clear-13","network-statistics-components-clear-14","network-statistics-components-clear-15","network-statistics-components-clear-16","network-statistics-components-clear-17","network-statistics-components-clear-18","network-statistics-components-clear-19","network-statistics-components-clear-2","network-statistics-components-clear-20","network-statistics-components-clear-21","network-statistics-components-clear-22","network-statistics-components-clear-23","network-statistics-components-clear-24","network-statistics-components-clear-25","network-statistics-components-clear-26","network-statistics-components-clear-27","network-statistics-components-clear-28","network-statistics-components-clear-29","network-statistics-components-clear-3","network-statistics-components-clear-30","network-statistics-components-clear-31","network-statistics-components-clear-4","network-statistics-components-clear-5","network-statistics-components-clear-6","network-statistics-components-clear-7","network-statistics-components-clear-8","network-statistics-components-clear-9","network-statistics-components-init","network-statistics-zero-component-size","network-statistics-zero-in-degree","network-statistics-zero-output","gpu-network.network-statistics-neighbors","gpu-network.network-statistics-node-positions","load-balanced-segment-sum-fixup"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","reads","writes","workload","attrs"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"]],"lists":[["~2","~0"],["~6","~4","~2","~0"],["~:2","~1","~7",1,1,1,0,4],["~:2","~1","~8",1,5,1199,16040,4800],["~1m","~k"],["~1n","~d"],["~:2","~1","~2r",1,1,4,0,4828],["~:2","~1","~7",1,5,1199,0,4796]]}}
