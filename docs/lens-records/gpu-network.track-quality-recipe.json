: u32, b: u32) -> bool {","  return timestamps[timestampsOffset + a] >= timestamps[timestampsOffset + b];","fn getStepDistance(row: u32) -> f32 {","  let deltaX = positions[positionsOffset + 2u * row] - positions[positionsOffset + 2u * (row - 1u)];","  let deltaY = positions[positionsOffset + 2u * row + 1u] - positions[positionsOffset + 2u * (row - 1u) + 1u];","  return sqrt(deltaX * deltaX + deltaY * deltaY);","fn getStepDuration(row: u32) -> f32 {","  return timeDifferenceRows(row, row - 1u);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &timestamps;","  _ = &trackOffsets;","  _ = &stepDistances;","  _ = &stepSpeeds;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  ","  var stepDistance = 0.0;","  var stepSpeed = 0.0;","  var runStart = 0u;","  var runEnd = 0u;","  let track = findTrack(index);","  if (track != NO_TRACK) {","    let trackStart = trackOffsets[trackOffsetsOffset + track];","    let trackEnd = trackOffsets[trackOffsetsOffset + track + 1u];","    if (index > trackStart) {","      stepDistance = getStepDistance(index);","      let stepDuration = getStepDuration(index);","      if (stepDuration > 0.0) {","        stepSpeed = stepDistance / stepDuration;","      }","      ","  stepDistances[stepDistancesOffset + index] = stepDistance;","  stepSpeeds[stepSpeedsOffset + index] = stepSpeed;","@group(0) @binding(3) var<storage, read_write> stepSpeeds: array<f32>;","fn guardedAtan2(y: f32, x: f32) -> f32 {","  return select(atan2(y, x), sign(y) * 1.5707963267948966, x == 0.0);","fn getStepSpeed(row: u32) -> f32 {","  let duration = getStepDuration(row);","  if (duration > 0.0) {","    return getStepDistance(row) / duration;","  return 0.0;","  var speed = 0.0;","  var heading = 0.0;","  var acceleration = 0.0;","      speed = getStepSpeed(index);","      let deltaX = positions[positionsOffset + 2u * index] - positions[positionsOffset + 2u * (index - 1u)];","      let deltaY = positions[positionsOffset + 2u * index + 1u] - positions[positionsOffset + 2u * (index - 1u) + 1u];","      if (deltaX != 0.0 || deltaY != 0.0) {","        // deltaX is -0.0 for a due north or south step from x = +0 to x = -0 (FX-17).","        heading = guardedAtan2(deltaY, deltaX);","      let duration = getStepDuration(index);","      if (index - 1u > trackStart && duration > 0.0) {","        acceleration = (speed - getStepSpeed(index - 1u)) / duration;","  stepSpeeds[stepSpeedsOffset + index] = speed;","@group(0) @binding(0) var<storage, read> timestamps: array<f32>;","@group(0) @binding(1) var<storage, read> trackOffsets: array<u32>;","const trackDurationsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> trackDurations: array<f32>;","  _ = &trackDurations;","  let trackStart = trackOffsets[trackOffsetsOffset + index];","  let trackEnd = trackOffsets[trackOffsetsOffset + index + 1u];","  var trackDuration = 0.0;","  if (trackEnd >= trackStart + 2u) {","    trackDuration = timeDifferenceRows(trackEnd - 1u, trackStart);","  trackDurations[trackDurationsOffset + index] = trackDuration;","const flagsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> flags: array<u32>;","  _ = &flags;","  flags[flagsOffset + index] = 0xffffffffu;","const segmentInputOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> segmentInput: array<f32>;","const segmentOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> segmentOffsets: array<u32>;","const segmentOutputOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> segmentOutput: array<f32>;","const INPUT_COUNT: u32 = 4u;","const SEGMENT_COUNT: u32 = 1u;","var<workgroup> partialSums: array<f32, 256>;","@compute @workgroup_size(256)","  _ = &segmentInput;","  _ = &segmentOffsets;","  _ = &segmentOutput;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let firstSegment = index / 256u;","  let segmentStride = INVOCATION_COUNT / 256u;","  // Segment counts beyond one dispatch are reduced in strided passes with a uniform trip count.","  for (var segmentPass = 0u; segmentPass < 1u; segmentPass++) {","  let segment = firstSegment + segmentPass * segmentStride;","  let isInRange = index < INVOCATION_COUNT && segment < SEGMENT_COUNT;","  var partialSum = 0.0;","  var isEmpty = true;","  if (isInRange) {","    let begin = segmentOffsets[segmentOffsetsOffset + segment];","    let end = min(segmentOffsets[segmentOffsetsOffset + segment + 1u], INPUT_COUNT);","    for (var row = begin + localInvocationIndex; row < end; row += 256u) {","      let next = segmentInput[segmentInputOffset + row];","      partialSum = partialSum + next;","    isEmpty = begin >= end;","  partialSums[localInvocationIndex] = partialSum;","  workgroupBarrier();","  for (var stride = 128u; stride > 0u; stride = stride / 2u) {","    if (localInvocationIndex < stride) {","      partialSums[localInvocationIndex] = partialSums[localInvocationIndex] + partialSums[localInvocationIndex + stride];","    workgroupBarrier();","  if (isInRange && localInvocationIndex == 0u) {","    segmentOutput[segmentOutputOffset + segment] = select(partialSums[0], 0.0, isEmpty);","  var partialSum = -3.402823466e+38;","      partialSum = max(partialSum, next);","      partialSums[localInvocationIndex] = max(partialSums[localInvocationIndex], partialSums[localInvocationIndex + stride]);","const offsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","@group(0) @binding(2) var<storage, read> timestamps: array<f32>;","const thresholdsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> thresholds: array<f32>;","const speedsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> speeds: array<f32>;","@group(0) @binding(5) var<storage, read_write> flags: array<u32>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","  _ = &offsets;","  _ = &thresholds;","  _ = &speeds;","  let begin = min(offsets[offsetsOffset + index], 4u); let end = min(offsets[offsetsOffset + index + 1u], 4u);","for (var row = begin; row < end; row++) {","  let position = vec2f(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]); var state = 0u;","  if (!isFiniteValue(position.x) || !isFiniteValue(position.y)) { state |= 1u; }","  if (!isFiniteValue(timestamps[timestampsOffset + row])) { state |= 2u; }","  if (!isFiniteValue(thresholds[thresholdsOffset]) || thresholds[thresholdsOffset] < 0.0 || !isFiniteValue(thresholds[thresholdsOffset + 1u]) || thresholds[thresholdsOffset + 1u] < 0.0) { state |= 16u; }","  if (row > begin) {","    let elapsed = timeDifferenceRows(row, row - 1u);","    if (!isFiniteValue(elapsed) || elapsed <= 0.0) { state |= 2u; }","    if (elapsed > thresholds[thresholdsOffset + 1u]) { state |= 8u; }","    let speed = speeds[speedsOffset + row];","    if (isFiniteValue(elapsed) && elapsed > 0.0 && (!isFiniteValue(speed) || speed > thresholds[thresholdsOffset])) { state |= 4u; }","  flags[flagsOffset + row] = state;","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","@group(0) @binding(1) var<storage, read> flags: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> counts: array<u32>;","  _ = &counts;","  var total = 0u; for (var row = min(offsets[offsetsOffset + index], 4u); row < min(offsets[offsetsOffset + index + 1u], 4u); row++) { total += select(0u, 1u, flags[flagsOffset + row] != 0u); } counts[countsOffset + index] = total;"],"strings":["read","trackOffsets","gpu-network.track-quality-re