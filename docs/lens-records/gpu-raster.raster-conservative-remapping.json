-conservative-remapping-snapshots-sourceValues-0","name":"sourceValues","iteration":0,"elementType":"f32","values":"b64:AAAAAAAAgD8AAABAAABAQAAAgEAAAKBAAADAQAAA4EAAAABBAAAQQQAAIEEAADBBAABAQQAAUEEAAGBBAABwQQ==","provenance":"gpu-readback","graph":"gpu-raster-raster-conservative-remapping-compiled","resource":"sourceValues","meaning":"Intensive source observations on the unshifted grid","role":"input","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"m","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":16},{"id":"gpu-raster-raster-conservative-remapping-snapshots-remappedValues-0","name":"remappedValues","iteration":0,"elementType":"f32","values":"b64:AAAgQAAAYEAAAJBAAACgQAAA0EAAAPBAAAAIQQAAEEEAAChBAAA4QQAASEEAAFBBAABIQQAAWEEAAGhBAABwQQ==","provenance":"gpu-readback","graph":"gpu-raster-raster-conservative-remapping-compiled","resource":"remappedValues","meaning":"Valid-overlap intensive average on the half-cell-shifted destination","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"m","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":16},{"id":"gpu-raster-raster-conservative-remapping-snapshots-coveredArea-0","name":"coveredArea","iteration":0,"elementType":"f32","values":"b64:AACAPwAAgD8AAIA/AAAAPwAAgD8AAIA/AACAPwAAAD8AAIA/AACAPwAAgD8AAAA/AAAAPwAAAD8AAAA/AACAPg==","provenance":"gpu-readback","graph":"gpu-raster-raster-conservative-remapping-compiled","resource":"coveredArea","meaning":"Valid source overlap area for each destination cell","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"m","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":16},{"id":"gpu-raster-raster-conservative-remapping-snapshots-status-0","name":"status","iteration":0,"elementType":"u32","values":"rle:*16:00000000","provenance":"gpu-readback","graph":"gpu-raster-raster-conservative-remapping-compiled","resource":"status","meaning":"Zero identifies a defined conservative average","role":"context","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"m","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":16}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const indicesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> indices: array<u32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> weights: array<f32>;","// Floor of numerator / denominator for a positive denominator (WGSL division truncates).","fn getFloorQuotient(numerator: i32, denominator: i32) -> i32 {","  let quotient = numerator / denominator;","  return select(quotient, quotient - 1, numerator - quotient * denominator < 0);","}","// Exact 64-bit product of two u32 values as (high, low).","fn getUnsignedProduct(left: u32, right: u32) -> vec2<u32> {","  let leftLow = left & 0xffffu;","  let leftHigh = left >> 16u;","  let rightLow = right & 0xffffu;","  let rightHigh = right >> 16u;","  let lowLow = leftLow * rightLow;","  let lowHigh = leftLow * rightHigh;","  let highLow = leftHigh * rightLow;","  let highHigh = leftHigh * rightHigh;","  let middle = (lowLow >> 16u) + (lowHigh & 0xffffu) + (highLow & 0xffffu);","  let low = (lowLow & 0xffffu) | (middle << 16u);","  let high = highHigh + (lowHigh >> 16u) + (highLow >> 16u) + (middle >> 16u);","  return vec2<u32>(high, low);","// Length, in source cells, of the part of [lower, upper] inside the unit cell [0, 1]. Edges are","// given relative to the candidate cell as whole cells plus a fraction in [0, 1], so an edge that","// coincides with a cell boundary is exactly 0 or 1 and a cell that is only touched gets 0.","fn getUnitCellOverlap(lowerWhole: i32, lowerFraction: f32, upperWhole: i32, upperFraction: f32, minimumOverlap: f32) -> f32 {","  let lower = max(f32(lowerWhole) + lowerFraction, 0.0);","  let upper = min(f32(upperWhole) + upperFraction, 1.0);","  let overlap = upper - lower;","  return select(0.0, overlap, overlap > minimumOverlap);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &indices;","  _ = &weights;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let destinationColumn = index % 4u;","let destinationRow = index / 4u;","let xLowerUnits = 1 + i32(destinationColumn) * 2;","let xUpperUnits = xLowerUnits + 2;","let xLowerWhole = getFloorQuotient(xLowerUnits, 2);","let xUpperWhole = getFloorQuotient(xUpperUnits, 2);","let xLowerFraction = f32(xLowerUnits - xLowerWhole * 2) / 2.0;","let xUpperFraction = f32(xUpperUnits - xUpperWhole * 2) / 2.0;","let xMinimumOverlap = 0.0;","let yLowerUnits = 1 + i32(destinationRow) * 2;","let yUpperUnits = yLowerUnits + 2;","let yLowerWhole = getFloorQuotient(yLowerUnits, 2);","let yUpperWhole = getFloorQuotient(yUpperUnits, 2);","let yLowerFraction = f32(yLowerUnits - yLowerWhole * 2) / 2.0;","let yUpperFraction = f32(yUpperUnits - yUpperWhole * 2) / 2.0;","let yMinimumOverlap = 0.0;","let first = vec2<i32>(xLowerWhole, yLowerWhole);","for (var candidate = 0u; candidate < 4u; candidate++) {","  let coordinate = first + vec2<i32>(i32(candidate % 2u), i32(candidate / 2u));","  let slot = index * 4u + candidate;","  indices[indicesOffset + slot] = 0xffffffffu; weights[weightsOffset + slot] = 0.0;","  if (any(coordinate < vec2<i32>(0)) || any(coordinate >= vec2<i32>(4, 4))) { continue; }","  let overlapX = getUnitCellOverlap(xLowerWhole - coordinate.x, xLowerFraction, xUpperWhole - coordinate.x, xUpperFraction, xMinimumOverlap);","  let overlapY = getUnitCellOverlap(yLowerWhole - coordinate.y, yLowerFraction, yUpperWhole - coordinate.y, yUpperFraction, yMinimumOverlap);","  if (!(overlapX > 0.0 && overlapY > 0.0)) { continue; }","  indices[indicesOffset + slot] = u32(coordinate.y) * 4u + u32(coordinate.x);","  weights[weightsOffset + slot] = (overlapX * overlapY) * 1.0;","const valuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> values: array<f32>;","@group(0) @binding(1) var<storage, read> indices: array<u32>;","@group(0) @binding(2) var<storage, read> weights: array<f32>;","const resultOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> result: array<f32>;","const coveredAreaOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> coveredArea: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","fn finite(value: f32) -> bool { return isFiniteBits(value); }","fn missing() -> f32 { return getQuietNaN(); }","  _ = &values;","  _ = &result;","  _ = &coveredArea;","  _ = &status;","  var numerator = 0.0; var support = 0.0;","  let slot = index * 4u + candidate; let sourceIndex = indices[indicesOffset + slot];","  if (sourceIndex == 0xffffffffu) { continue; }","  let value = values[valuesOffset + sourceIndex];","  if (!finite(value) ) { continue; }","  let area = weights[weightsOffset + slot]; numerator += value * area; support += area;","coveredArea[coveredAreaOffset + index] = support;","var value = missing(); var code = 1u;","if (support > 0.0) {","  value = numerator / support;","  code = select(2u, 0u, finite(value));","result[resultOffset + index] = value; status[statusOffset + index] = code;"],"strings":["raster-conservative-remapping-apply","gpu-raster-raster-conservative-remapping-snapshot-tap","coveredArea","raster-conservative-remapping-indices","raster-conservative-remapping-weights","status","buffer","logical","raster-conservative-remapping-prepare","remappedValues","GPURasterConservativeRemapping","read_write","imported","sourceValues","read","compute","indices","transient","weights"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","bindingByteOffset","bindingByteLength","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~3","~4"],["~:2",16,1,1],["~:4",[1,1,1],16,false]]}}
