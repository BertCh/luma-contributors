d-overlap intensive average on the half-cell-shifted destination","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-raster-raster-conservative-remapping-snapshots-coveredArea-0","name":"coveredArea","iteration":0,"elementType":"f32","values":"b64:AACAPwAAgD8AAIA/AAAAPwAAgD8AAIA/AACAPwAAAD8AAIA/AACAPwAAgD8AAAA/AAAAPwAAAD8AAAA/AACAPg==","provenance":"gpu-readback","graph":"gpu-raster-raster-conservative-remapping-compiled","resource":"coveredArea","afterNode":"raster-conservative-remapping-apply","role":"output","meaning":"Valid source overlap area for each destination cell","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-raster-raster-conservative-remapping-snapshots-status-0","name":"status","iteration":0,"elementType":"u32","values":"rle:*16:00000000","provenance":"gpu-readback","graph":"gpu-raster-raster-conservative-remapping-compiled","resource":"status","afterNode":"raster-conservative-remapping-apply","role":"context","meaning":"Zero identifies a defined conservative average","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"coordinateModel":"projected","cellSize":1,"unit":"m"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const indicesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> indices: array<u32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> weights: array<f32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &indices;","  _ = &weights;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let lower = vec2<f32>(0.5, 0.5) + vec2<f32>(f32(index % 4u), f32(index / 4u)) * vec2<f32>(1, 1);","let upper = lower + vec2<f32>(1, 1);","let first = vec2<i32>(floor(lower / vec2<f32>(1, 1)));","for (var candidate = 0u; candidate < 4u; candidate++) {","  let coordinate = first + vec2<i32>(i32(candidate % 2u), i32(candidate / 2u));","  let slot = index * 4u + candidate;","  indices[indicesOffset + slot] = 0xffffffffu; weights[weightsOffset + slot] = 0.0;","  if (any(coordinate < vec2<i32>(0)) || any(coordinate >= vec2<i32>(4, 4))) { continue; }","  let sourceLower = vec2<f32>(coordinate) * vec2<f32>(1, 1);","  let overlap = max(vec2<f32>(0.0), min(upper, sourceLower + vec2<f32>(1, 1)) - max(lower, sourceLower));","  indices[indicesOffset + slot] = u32(coordinate.y) * 4u + u32(coordinate.x);","  weights[weightsOffset + slot] = overlap.x * overlap.y;","}","const valuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> values: array<f32>;","@group(0) @binding(1) var<storage, read> indices: array<u32>;","@group(0) @binding(2) var<storage, read> weights: array<f32>;","const resultOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> result: array<f32>;","const coveredAreaOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> coveredArea: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","fn finite(value: f32) -> bool { return isFiniteBits(value); }","fn missing() -> f32 { return getQuietNaN(); }","  _ = &values;","  _ = &result;","  _ = &coveredArea;","  _ = &status;","  var numerator = 0.0; var support = 0.0;","  let slot = index * 4u + candidate; let sourceIndex = indices[indicesOffset + slot];","  if (sourceIndex == 0xffffffffu) { continue; }","  let value = values[valuesOffset + sourceIndex];","  if (!finite(value) ) { continue; }","  let area = weights[weightsOffset + slot]; numerator += value * area; support += area;","coveredArea[coveredAreaOffset + index] = support;","var value = missing(); var code = 1u;","if (support > 0.0) {","  value = numerator / support;","  code = select(2u, 0u, finite(value));","result[resultOffset + index] = value; status[statusOffset + index] = code;"],"strings":["raster-conservative-remapping-apply","raster-conservative-remapping-indices","raster-conservative-remapping-weights","buffer","raster-conservative-remapping-prepare","GPURasterConservativeRemapping","coveredArea","read_write","status","imported","remappedValues","read","sourceValues","compute","indices","raster-conservative-remapping","transient","weights"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[["~1","~2"],["~:3",[1,1,1],16,false]]}}
