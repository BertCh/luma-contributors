AAAQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAA==","provenance":"gpu-readback","graph":"gpu-raster-raster-contrast-equalization-compiled","resource":"inputValidity","meaning":"Cell zero is missing and excluded from tile histograms","role":"context","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"arbitrary planar units","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":16},{"id":"gpu-raster-raster-contrast-equalization-snapshots-equalizedValues-0","name":"equalizedValues","iteration":0,"elementType":"f32","values":"b64:AADAf6uqqj5WUpU+APz/PquqKj8AAIA/gP9fPwAAgD+A/h8/AP8/P8D+Lz8A/z8/AP8/PwAAgD+A/18/AACAPw==","provenance":"gpu-readback","graph":"gpu-raster-raster-contrast-equalization-compiled","resource":"equalizedValues","meaning":"Normalized CLAHE mapping with reflected two-cell tiles","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"arbitrary planar units","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":16},{"id":"gpu-raster-raster-contrast-equalization-snapshots-equalizedValidity-0","name":"equalizedValidity","iteration":0,"elementType":"u32","values":"same:snapshots.1","provenance":"gpu-readback","graph":"gpu-raster-raster-contrast-equalization-compiled","resource":"equalizedValidity","meaning":"Source validity preserved by contrast mapping","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"arbitrary planar units","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":16},{"id":"gpu-raster-raster-contrast-equalization-snapshots-approximation-0","name":"approximation","iteration":0,"elementType":"u32","values":"b64:AQAAAA==","provenance":"gpu-readback","graph":"gpu-raster-raster-contrast-equalization-compiled","resource":"approximation","meaning":"One because histogram bins quantize the contrast mapping","role":"intermediate","keySpace":"status","valueCount":1}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &fillTarget;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  fillTarget[fillTargetOffset + index] = 0u;","}","@compute @workgroup_size(32)","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","const parametersOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> parameters: array<f32>;","const sourceOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> source: array<f32>;","const sourceValidityOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> sourceValidity: array<u32>;","const histogramOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> histogram: array<atomic<u32>>;","const countsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> counts: array<atomic<u32>>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn getScaledQuotient(value: f32, first: f32, second: f32, power: i32) -> f32 {","  if (value == 0.0) { return value; }","  let numerator = frexp(value);","  let firstDivisor = frexp(first);","  let secondDivisor = frexp(second);","  let quotient = frexp(numerator.fract / (firstDivisor.fract * secondDivisor.fract));","  return ldexp(quotient.fract,","    numerator.exp - firstDivisor.exp - secondDivisor.exp + power + quotient.exp);","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","const BIN_COUNT: u32 = 16u;","fn getBin(value: f32, domain: u32) -> u32 {","  let minimum = parameters[parametersOffset + domain];","  let maximum = parameters[parametersOffset + domain + 1u];","  let normalized = clamp(getScaledQuotient(clamp(value, minimum, maximum) - minimum, maximum - minimum, 1.0, 0), 0.0, 1.0);","  return min(BIN_COUNT - 1u, u32(round(normalized * 16383.0)) / (1u + 16384u / BIN_COUNT));","fn reflectCell(coordinate: u32, extent: u32) -> u32 {","  if (extent == 1u) { return 0u; }","  let period = 2u * (extent - 1u);","  let folded = coordinate % period;","  return min(folded, period - folded);","  _ = &parameters;","  _ = &source;","  _ = &sourceValidity;","  _ = &histogram;","  _ = &counts;","  let column = index % 4u;","let row = index / 4u;","let cell = reflectCell(row, 4u) * 4u + reflectCell(column, 4u);","let value = source[sourceOffset + cell];","if (sourceValidity[sourceValidityOffset + cell] != 0u && isFiniteValue(value)) {","  let tile = (row / 2u) * 2u + column / 2u;","  let bin = getBin(value, 0u);","  atomicAdd(&histogram[histogramOffset + tile * BIN_COUNT + bin], 1u);","  atomicAdd(&counts[countsOffset + tile], 1u);","@group(0) @binding(1) var<storage, read_write> histogram: array<u32>;","@group(0) @binding(2) var<storage, read> counts: array<u32>;","const MAXIMUM_REDISTRIBUTION_SWEEPS: u32 = 65536u;","  ","let start = histogramOffset + index * BIN_COUNT;","let sampleCount = counts[countsOffset + index];","let fraction = parameters[parametersOffset + 4u];","var limit = sampleCount;","if (fraction > 0.0) { limit = max(1u, u32(floor(fraction * f32(sampleCount)))); }","var excess = 0i;","for (var bin = 0u; bin < BIN_COUNT; bin++) {","  let value = histogram[start + bin];","  excess += i32(value - min(value, limit));","  histogram[start + bin] = min(value, limit);","let increment = excess / i32(BIN_COUNT);","let upper = i32(limit) - increment;","  var value = i32(histogram[start + bin]);","  if (value < upper) { value += increment; excess -= increment; }","  if (value >= upper && value < i32(limit)) { excess -= i32(limit) - value; value = i32(limit); }","  histogram[start + bin] = u32(value);","// Each productive sweep reduces excess by at least one; the initial excess is at most the","// bounded tile area. A skewed three-bin histogram can require more sweeps than BIN_COUNT.","for (var sweep = 0u; sweep < MAXIMUM_REDISTRIBUTION_SWEEPS && excess > 0i; sweep++) {","  let previous = excess;","  for (var first = 0u; first < BIN_COUNT && excess > 0i; first++) {","    var available = 0u;","    for (var bin = 0u; bin < BIN_COUNT; bin++) {","      available += u32(histogram[start + bin] < limit);","    }","    let stride = max(1u, available / u32(excess));","    for (var bin = first; bin < BIN_COUNT; bin += stride) {","      if (histogram[start + bin] < limit) { histogram[start + bin]++; excess--; }","  if (excess == previous) { break; }","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const cumulativeOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> cumulative: array<u32>;","const mappingOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> mapping: array<f32>;","fn getCumulative(tile: u32, bin: u32) -> u32 {","  var preceding = 0u;","  if (tile > 0u) { preceding = cumulative[cumulativeOffset + tile * BIN_COUNT - 1u]; }","  return cumulative[cumulativeOffset + tile * BIN_COUNT + bin] - preceding;","  _ = &cumulative;","  _ = &mapping;","  let tile = index / BIN_COUNT;","let count = counts[countsOffset + tile];","var result = getNaN();","if (count > 0u) {","  // Integer division prevents an approximate float division crossing an integer mapping boundary.","  result = f32(min(16383u, (getCumulative(tile, index % BIN_COUNT) * 16383u) / count)) / 16383.0;","mapping[mappingOffset + index] = result;","@group(0) @binding(3) var<storage, read> mapping: array<f32>;","const valuesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> values: array<f32>;","const validityOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> validity: array<u32>;","const approximationOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> approximation: array<u32>;","  _ = &values;","  _ = &validity;","  _ = &approximation;","  let value = source[sourceOffset + index];","if (sourceValidity[sourceValidityOffset + index] != 0u && isFiniteValue(value)) {","  let column = index % 4u + 1u;","  let row = index / 4u + 1u;","  let left = i32(column / 2u) - 1;","  let top = i32(row / 2u) - 1;","  let horizontal = f32(column % 2u) / 2.0;","  let vertical = f32(row % 2u) / 2.0;","  var weighted = 0.0; var weightSum = 0.0;","  for (var corner = 0u; corner < 4u; corner++) {","    let right = corner % 2u; let bottom = corner / 2u;","    let tileColumn = u32(clamp(left + i32(right), 0, 1));","    let tileRow = u32(clamp(top + i32(bottom), 0, 1));","    let mapped = mapping[mappingOffset + (tileRow * 2u + tileColumn) * BIN_COUNT + bin];","    let weight = select(1.0 - horizontal, horizontal, right != 0u) * select(1.0 - vertical, vertical, bottom != 0u);","    if (isFiniteValue(mapped)) { weighted += mapped * weight; weightSum += weight; }","  if (weightSum > 0.0) { result = weighted / weightSum; }","values[valuesOffset + index] = result;","validity[validityOffset + index] = u32(isFiniteValue(result));","if (index == 0u) { approximation[approximationOffset] = 1u; }"],"strings":["raster-contrast-equalization-apply","raster-contrast-equalization-mapping","raster-contrast-equalization-counts","raster-contrast-equalization-histogram","