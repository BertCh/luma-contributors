 column = i32(index % 3u); let row = i32(index / 3u);","  var quadrantDistances = array<i32, 4>(9, 9, 9, 9);","  var quadrantValues: array<f32, 4>;","  for (var step = 0; step <= 2; step++) {","    for (var side = 0; side < 2; side++) {","      if (side == 1 && step == 0) { continue; }","      let sampleColumn = select(max(0, column - step), min(2, column + step), side == 1);","      for (var direction = 0; direction < 2; direction++) {","        let quadrant = u32(side * 2 + direction);","        for (var verticalOffset = direction; verticalOffset <= 2; verticalOffset++) {","          let sampleRow = select(row - verticalOffset, row + verticalOffset, direction == 1);","          if (sampleRow < 0 || sampleRow >= 3) { break; }","          let sampleIndex = u32(sampleRow) * 3u + u32(sampleColumn);","          if (sourceValidity[sourceValidityOffset + sampleIndex] == 0u) { continue; }","          let horizontalOffset = sampleColumn - column;","          let squaredDistance = horizontalOffset * horizontalOffset + verticalOffset * verticalOffset;","          if (squaredDistance > 0 && squaredDistance < quadrantDistances[quadrant]) {","            quadrantDistances[quadrant] = squaredDistance;","            quadrantValues[quadrant] = source[sourceOffset + sampleIndex];","          }","          // Only the closest original donor in this column/direction can win.","          break;","        }","      }","    }","  for (var quadrant = 0u; quadrant < 4u; quadrant++) {","    if (quadrantDistances[quadrant] <= 4) {","      let contribution = inverseSqrt(f32(quadrantDistances[quadrant]));","      total += quadrantValues[quadrant] * contribution;","      weight += contribution;","  valid = weight > 0.0; result = total / max(weight, 1.0e-30);","valid = valid && isFiniteValue(result);","values[valuesOffset + index] = select(bitcast<f32>(0x7fc00000u | (index & 0u)), result, valid);","validity[validityOffset + index] = u32(valid);","filled[filledOffset + index] = u32(valid && !ori