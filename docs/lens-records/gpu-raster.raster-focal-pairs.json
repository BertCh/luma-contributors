alues":"b64:AABAQAAAQEAAAEBAAABAQAAAQEAAAEBAAABAQAAAQEAAAEBA","provenance":"gpu-readback","graph":"gpu-raster-raster-focal-pairs-compiled","resource":"intercept","meaning":"Local regression intercept (expected 3)","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":10,"unit":"m"}},{"id":"gpu-raster-raster-focal-pairs-snapshots-rSquared-0","name":"rSquared","iteration":0,"elementType":"f32","values":"same:snapshots.5","provenance":"gpu-readback","graph":"gpu-raster-raster-focal-pairs-compiled","resource":"rSquared","meaning":"Descriptive coefficient of determination","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":10,"unit":"m"}},{"id":"gpu-raster-raster-focal-pairs-snapshots-residualSumSquares-0","name":"residualSumSquares","iteration":0,"elementType":"f32","values":"same:snapshots.3","provenance":"gpu-readback","graph":"gpu-raster-raster-focal-pairs-compiled","resource":"residualSumSquares","meaning":"Sum of squared fitted residuals","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":10,"unit":"m"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const predictorOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> predictor: array<f32>;","const responseOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> response: array<f32>;","const metricsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> metrics: array<f32>;","const pairedCountOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> pairedCount: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","const WIDTH: i32 = 3;","const HEIGHT: i32 = 3;","const RADIUS: i32 = 1;","fn reflectCoordinate(value: i32, length: i32) -> i32 {","  if (length <= 1) { return 0; }","  let period = (length - 1) * 2;","  let reflected = ((value % period) + period) % period;","  return select(reflected, period - reflected, reflected >= length);","}","fn getSampleIndex(column: i32, row: i32) -> i32 {","  if (column < 0 || column >= WIDTH || row < 0 || row >= HEIGHT) { return -1; }","  return row * WIDTH + column;","fn getPair(sampleIndex: i32) -> vec2<f32> {","  if (sampleIndex < 0) { return vec2<f32>(bitcast<f32>(0x7fc00000u | (u32(sampleIndex) & 0u))); }","  return vec2<f32>(predictor[predictorOffset + u32(sampleIndex)], response[responseOffset + u32(sampleIndex)]);","fn isPairValid(pair: vec2<f32>) -> bool {","  return isFiniteValue(pair.x) && isFiniteValue(pair.y);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &predictor;","  _ = &response;","  _ = &metrics;","  _ = &pairedCount;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  ","let column = i32(index % u32(WIDTH));","let row = i32(index / u32(WIDTH));","let invalid = bitcast<f32>(0x7fc00000u | (index & 0u));","var count = 0u;","var missingPair = false;","var anchor = vec2<f32>(0.0);","var totalDifference = vec2<f32>(0.0);","for (var rowOffset = -RADIUS; rowOffset <= RADIUS; rowOffset++) {","  for (var columnOffset = -RADIUS; columnOffset <= RADIUS; columnOffset++) {","    let pair = getPair(getSampleIndex(column + columnOffset, row + rowOffset));","    if (!isPairValid(pair)) {  continue; }","    if (count == 0u) { anchor = pair; }","    totalDifference += pair - anchor;","    count++;","pairedCount[pairedCountOffset + index] = count;","var code = select(0u, 1u, count < 2u) | select(0u, 2u, missingPair);","var covariance = invalid;","var correlation = invalid;","var slope = invalid;","var intercept = invalid;","var rSquared = invalid;","var residualSumSquares = invalid;","if (code == 0u) {","  let meanDifference = totalDifference / f32(count);","  var predictorSquares = 0.0;","  var responseSquares = 0.0;","  var crossProducts = 0.0;","  var centeredTotals = vec2<f32>(0.0);","  for (var rowOffset = -RADIUS; rowOffset <= RADIUS; rowOffset++) {","    for (var columnOffset = -RADIUS; columnOffset <= RADIUS; columnOffset++) {","      let pair = getPair(getSampleIndex(column + columnOffset, row + rowOffset));","      if (!isPairValid(pair)) { continue; }","      let centered = (pair - anchor) - meanDifference;","      centeredTotals += centered;","      predictorSquares += centered.x * centered.x;","      responseSquares += centered.y * centered.y;","      crossProducts += centered.x * centered.y;","    }","  // A backend may reassociate (pair - anchor) - meanDifference into pair minus a","  // rounded large centroid. Correct its nonzero residual mean using only small values.","  let correctedPredictorSquares = predictorSquares - centeredTotals.x * (centeredTotals.x / f32(count));","  let correctedResponseSquares = responseSquares - centeredTotals.y * (centeredTotals.y / f32(count));","  let correctedCrossProducts = crossProducts - centeredTotals.x * (centeredTotals.y / f32(count));","  if (!isFiniteValue(predictorSquares) || !isFiniteValue(responseSquares) || !isFiniteValue(crossProducts) ||","      !isPairValid(centeredTotals) || !isFiniteValue(correctedPredictorSquares) ||","      !isFiniteValue(correctedResponseSquares) || !isFiniteValue(correctedCrossProducts)) {","    code |= 16u;","  } else {","    predictorSquares = max(0.0, correctedPredictorSquares);","    responseSquares = max(0.0, correctedResponseSquares);","    crossProducts = correctedCrossProducts;","    covariance = crossProducts / f32(count - 1u);","    if (predictorSquares == 0.0) { code |= 4u; }","    if (responseSquares == 0.0) { code |= 8u; }","    if (predictorSquares > 0.0) {","      slope = crossProducts / predictorSquares;","      intercept = (anchor.y - slope * anchor.x) + (meanDifference.y - slope * meanDifference.x);","      residualSumSquares = 0.0;","      var residualTotal = 0.0;","      for (var rowOffset = -RADIUS; rowOffset <= RADIUS; rowOffset++) {","        for (var columnOffset = -RADIUS; columnOffset <= RADIUS; columnOffset++) {","          let pair = getPair(getSampleIndex(column + columnOffset, row + rowOffset));","          if (!isPairValid(pair)) { continue; }","          let centered = (pair - anchor) - meanDifference;","          let residual = centered.y - slope * centered.x;","          residualTotal += residual;","          residualSumSquares += residual * residual;","        }","      }","      // The same centroid rounding adds a constant to every fitted residual.","      // Remove its squared mean without rebuilding any large original-coordinate mean.","      let correctedResidualSquares = residualSumSquares - residualTotal * (residualTotal / f32(count));","      if (!isFiniteValue(residualSumSquares) || !isFiniteValue(correctedResidualSquares)) {","        code |= 16u;","      } else {","        residualSumSquares = max(0.0, correctedResidualSquares);","      if (responseSquares > 0.0) {","        // Divide successively to avoid overflowing the product of the two squared sums.","        correlation = clamp((crossProducts / sqrt(predictorSquares)) / sqrt(responseSquares), -1.0, 1.0);","        rSquared = clamp(1.0 - residualSumSquares / responseSquares, 0.0, 1.0);","      if (!isFiniteValue(slope) || !isFiniteValue(intercept) || !isFiniteValue(residualSumSquares) ||","          (responseSquares > 0.0 && (!isFiniteValue(correlation) || !isFiniteValue(rSquared)))) {","if ((code & 16u) != 0u) {","  covariance = invalid; correlation = invalid; slope = invalid;","  intercept = invalid; rSquared = invalid; residualSumSquares = invalid;","let destination = metricsOffset + index * 6u;","metrics[destination] = covariance;","metrics[destination + 1u] = correlation;","metrics[destination + 2u] = slope;","metrics[destination + 3u] = intercept;","metrics[destination + 4u] = rSquared;","metrics[destination + 5u] = residualSumSquares;","status[statusOffset + index] = code;","@group(0) @binding(0) var<storage, read> metrics: array<f32>;","const covarianceOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> covariance: array<f32>;","const correlationOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> correlation: array<f32>;","const slopeOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> slope: array<f32>;","const interceptOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> intercept: array<f32>;","const rSquaredOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> rSquared: array<f32>;","const residualSumSquaresOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> residualSumSquares: array<f32>;","  _ = &covariance;","  _ = &correlation;","  _ = &slope;","  _ = &intercept;","  _ = &rSquared;","  _ = &residualSumSquares;","  covariance[covarianceOffset + index] = metrics[metricsOffset + index * 6u + 0u];","correlation[correlationOffset + index] = metrics[metricsOffset + index * 6u + 1u];","slope[slopeOffset + index] = metrics[metricsOffset + index * 6u + 2u];","intercept[interceptOffset + index] = metrics[metricsOffset + index * 6u + 3u];","rSquared[rSquaredOffset + index] = metrics[metricsOffset + index * 6u + 4u];","residualSumSquares[residualSumSquaresOffset + index] = metrics[metricsOffset + index * 6u + 5u];"],"strings":["gpu-raster-raster-focal-pairs-snapshot-tap","raster-focal-pairs-outputs","buffer","imported","ra