u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const inputOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> input: array<u32>;","const seedsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> seeds: array<u32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &input;","  _ = &seeds;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  seeds[seedsOffset + index] = u32(input[inputOffset + index] == 0u);","}","const settingsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> settings: array<f32>;","  _ = &settings;","  var value = select(0.0, 1.0, index >= 2u && index <= 5u);","  if (index == 6u) { value = bitcast<f32>(0x7f800000u | (index & 0u)); }","  settings[settingsOffset + index] = value;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","  _ = &fillTarget;","  fillTarget[fillTargetOffset + index] = 0u;","const seedMaskOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> seedMask: array<u32>;","const cellSeedsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> cellSeeds: array<u32>;","  _ = &seedMask;","  _ = &cellSeeds;","  cellSeeds[cellSeedsOffset + index] = seedMask[seedMaskOffset + index] - 1u;","@group(0) @binding(0) var<storage, read> cellSeeds: array<u32>;","const bandSeedsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> bandSeeds: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NONE: u32 = 4294967295u;","fn getAbsoluteDifference(left: u32, right: u32) -> u32 {","  return select(right - left, left - right, left > right);","const BAND_SIZE: u32 = 32u;","const COLUMN_BAND_COUNT: u32 = 1u;","  _ = &bandSeeds;","  let column = index % GRID_WIDTH;","  let rowStart = (index / GRID_WIDTH) * BAND_SIZE;","  let rowEnd = min(rowStart + BAND_SIZE, GRID_HEIGHT);","  var topRow = NONE;","  var topId = NONE;","  var bottomRow = NONE;","  var bottomId = NONE;","  for (var row = rowStart; row < rowEnd; row++) {","    let seedId = cellSeeds[cellSeedsOffset + row * GRID_WIDTH + column];","    if (seedId != NONE) {","      if (topRow == NONE) {","        topRow = row;","        topId = seedId;","      }","      bottomRow = row;","      bottomId = seedId;","    }","  let base = bandSeedsOffset + 4u * index;","  bandSeeds[base] = topRow;","  bandSeeds[base + 1u] = topId;","  bandSeeds[base + 2u] = bottomRow;","  bandSeeds[base + 3u] = bottomId;","@group(0) @binding(0) var<storage, read> bandSeeds: array<u32>;","const bandCarriesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> bandCarries: array<u32>;","@compute @workgroup_size(64)","  _ = &bandCarries;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  let column = index;","  var lastRow = NONE;","  var lastId = NONE;","  for (var band = 0u; band < COLUMN_BAND_COUNT; band++) {","    let base = 4u * (band * GRID_WIDTH + column);","    bandCarries[bandCarriesOffset + base] = lastRow;","    bandCarries[bandCarriesOffset + base + 1u] = lastId;","    let bottomRow = bandSeeds[bandSeedsOffset + base + 2u];","    if (bottomRow != NONE) {","      lastRow = bottomRow;","      lastId = bandSeeds[bandSeedsOffset + base + 3u];","  lastRow = NONE;","  lastId = NONE;","  for (var step = 0u; step < COLUMN_BAND_COUNT; step++) {","    let base = 4u * ((COLUMN_BAND_COUNT - 1u - step) * GRID_WIDTH + column);","    bandCarries[bandCarriesOffset + base + 2u] = lastRow;","    bandCarries[bandCarriesOffset + base + 3u] = lastId;","    let topRow = bandSeeds[bandSeedsOffset + base];","    if (topRow != NONE) {","      lastRow = topRow;","      lastId = bandSeeds[bandSeedsOffset + base + 1u];","@group(0) @binding(1) var<storage, read> bandCarries: array<u32>;","const columnRowsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> columnRows: array<u32>;","const columnIdsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> columnIds: array<u32>;","  _ = &columnRows;","  _ = &columnIds;","  let base = bandCarriesOffset + 4u * index;","  var lastRow = bandCarries[base];","  var lastId = bandCarries[base + 1u];","    let cell = row * GRID_WIDTH + column;","    let seedId = cellSeeds[cellSeedsOffset + cell];","      lastRow = row;","      lastId = seedId;","    columnRows[columnRowsOffset + cell] = lastRow;","    columnIds[columnIdsOffset + cell] = lastId;","  lastRow = bandCarries[base + 2u];","  lastId = bandCarries[base + 3u];","  for (var row = rowEnd; row > rowStart; row--) {","    let cell = (row - 1u) * GRID_WIDTH + column;","      lastRow = row - 1u;","    if (lastRow == NONE) { continue; }","    let forwardRow = columnRows[columnRowsOffset + cell];","    var useBackward = forwardRow == NONE;","    if (!useBackward) {","      let forwardDistance = row - 1u - forwardRow;","      let backwardDistance = lastRow - (row - 1u);","      useBackward = backwardDistance < forwardDistance ||","        (backwardDistance == forwardDistance && lastId < columnIds[columnIdsOffset + cell]);","    if (useBackward) {","      columnRows[columnRowsOffset + cell] = lastRow;","      columnIds[columnIdsOffset + cell] = lastId;","@group(0) @binding(0) var<storage, read> settings: array<f32>;","@group(0) @binding(1) var<storage, read> columnRows: array<u32>;","@group(0) @binding(2) var<storage, read> columnIds: array<u32>;","const entryNextOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> entryNext: array<u32>;","const entryPreviousOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> entryPrevious: array<u32>;","const entryStartsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> entryStarts: array<u32>;","const blockEndsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> blockEnds: array<u32>;","fn isIsotropic() -> bool {","  return settings[settingsOffset + 2u] == settings[settingsOffset + 3u];","fn getAnisotropicKey(dx: u32, dy: u32) -> f32 {","  let groundX = settings[settingsOffset + 2u] * f32(dx);","  let groundY = settings[settingsOffset + 3u] * f32(dy);","  return groundX * groundX + groundY * groundY;","fn isCloser(dxA: u32, dyA: u32, idA: u32, dxB: u32, dyB: u32, idB: u32) -> bool {","  if (isIsotropic()) {","    let keyA = dxA * dxA + dyA * dyA;","    let keyB = dxB * dxB + dyB * dyB;","    if (keyA != keyB) { return keyA < keyB; }","  } else {","    let keyA = getAnisotropicKey(dxA, dyA);","    let keyB = getAnisotropicKey(dxB, dyB);","  return idA < idB;","const ROW_BAND_COUNT: u32 = 1u;","/** Whether the candidate in column q beats the candidate in column v at cell x of this row. */","fn beatsAt(q: u32, qDy: u32, qId: u32, v: u32, vDy: u32, vId: u32, x: u32) -> bool {","  return isCloser(getAbsoluteDifference(x, q), qDy, qId, getAbsoluteDifference(x, v), vDy, vId);","fn getEntrySlot(column: u32, row: u32) -> u32 {","  return column * GRID_HEIGHT + row;","/**"," * Felzenszwalb-Huttenlocher insertion of the candidate in column q into the envelope whose tail is"," * 'tail': pops every tail entry q beats at its start (marking it off the envelope) and returns"," * vec2(new tail, start of q), start GRID_WIDTH when q never wins. The start is the first cell"," * after the tail's start where q wins, found by binary search with isCloser, so ties break exactly"," * on the smallest seed ID."," */","fn insertEntry(q: u32, row: u32, tailIn: u32) -> vec2<u32> {","  let rowBase = row * GRID_WIDTH;","  let qDy = getAbsoluteDifference(columnRows[columnRowsOffset + rowBase + q], row);","  let qId = columnIds[columnIdsOffset + rowBase + q];","  var tail = tailIn;","  loop {","    if (tail == NONE) { return vec2<u32>(NONE, 0u); }","    let tailSlot = getEntrySlot(tail, row);","    let vStart = entryStarts[entryStartsOffset + tailSlot];","    let vDy = getAbsoluteDifference(columnRows[columnRowsOffset + rowBase + tail], row);","    let vId = columnIds[columnIdsOffset + rowBase + tail];","    if (beatsAt(q, qDy, qId, tail, vDy, vId, vStart)) {","      entryStarts[entryStartsOffset + tailSlot] = NONE;","      tail = entryPrevious[entryPreviousOffset + tailSlot];","      continue;","    // First cell in (vStart, GRID_WIDTH) where q wins, or GRID_WIDTH when q never wins.","    var low = vStart + 1u;","    var high = GRID_WIDTH;","    while (low < high) {","      let middle = (low + high) / 2u;","      if (beatsAt(q, qDy, qId, tail, vDy, vId, middle)) {","        high = middle;","      } else {","        low = middle + 1u;","    return vec2<u32>(tail, low);","  _ = &entryNext;","  _ = &entryPrevious;","  _ = &entryStarts;","  _ = &blockEnds;","  let row = index % GRID_HEIGHT;","  let band = index / GRID_HEIGHT;","  let columnStart = band * BAND_SIZE;","  let columnEnd = min(columnStart + BAND_SIZE, GRID_WIDTH);","  var head = NONE;","  var tail = NONE;","  for (var q = columnStart; q < columnEnd; q++) {","    let slot = getEntrySlot(q, row);","    entryStarts[entryStartsOffset + slot] = NONE;","    if (columnRows[columnRowsOffset + rowBase + q] == NONE) { continue; }","    let inserted = insertEntry(q, row, tail);","    tail = inserted.x;","    if (inserted.y < GRID_WIDTH) {","      entryStarts[entryStartsOffset + slot] = inserted.y;","      entryPrevious[entryPreviousOffset + slot] = tail;","      entryNext[entryNextOffset + slot] = NONE;","      if (tail == NONE) {","        head = q;","        entryNext[entryNextOffset + getEntrySlot(tail, row)] = q;","      tail = q;","  blockEnds[blockEndsOffset + 2u * index] = head;","  blockEnds[blockEndsOffset + 2u * index + 1u] = tail;","@group(0) @binding(0) var<storage, read> entryStarts: array<u32>;","const startMarkersOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> startMarkers: array<u32>;","  _ = &startMarkers;","  let start = entryStarts[entryStartsOffset + index];","  if (start == NONE) { return; }","  let column = index / GRID_HEIGHT;","  startMarkers[startMarkersOffset + row * GRID_WIDTH + start] = column + 1u;","@group(0) @binding(0) var<storage, read> startMarkers: array<u32>;","const bandMarkersOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> bandMarkers: array<u32>;","  _ = &bandMarkers;","  let columnStart = (index / GRID_HEIGHT) * BAND_SIZE;","  var maximum = 0u;","  for (var x = columnStart; x < columnEnd; x++) {","    maximum = max(maximum, startMarkers[startMarkersOffset + row * GRID_WIDTH + x]);","  bandMarkers[bandMarkersOffset + index] = maximum;","@group(0) @binding(0) var<storage, read_write> bandMarkers: array<u32>;","  var running = 0u;","  for (var band = 0u; band < ROW_BAND_COUNT; band++) {","    let slot = bandMarkersOffset + band * GRID_HEIGHT + index;","    let bandMaximum = bandMarkers[slot];","    bandMarkers[slot] = running;","    running = max(running, bandMaximum);","@group(0) @binding(0) var<storage, read> columnRows: array<u32>;","@group(0) @binding(1) var<storage, read> columnIds: array<u32>;","@group(0) @binding(2) var<storage, read> startMarkers: array<u32>;","@group(0) @binding(3) var<storage, read> bandMarkers: array<u32>;","const nearestCellsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> nearestCells: array<u32>;","const nearestIdsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> nearestIds: array<u32>;","  _ = &nearestCells;","  _ = &nearestIds;","  var running = bandMarkers[bandMarkersOffset + index];","    let cell = rowBase + x;","    running = max(running, startMarkers[startMarkersOffset + cell]);","    if (running == 0u) {","      nearestCells[nearestCellsOffset + cell] = NONE;","      nearestIds[nearestIdsOffset + cell] = NONE;","    let column = running - 1u;","    nearestCells[nearestCellsOffset + cell] = columnRows[columnRowsOffset + rowBase + column] * GRID_WIDTH + column;","    nearestIds[nearestIdsOffset + cell] = columnIds[columnIdsOffset + rowBase + column];","@group(0) @binding(1) var<storage, read> nearestCells: array<u32>;","@group(0) @binding(2) var<storage, read> nearestIds: array<u32>;","const distanceBitsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> distanceBits: array<u32>;","const nearestCellsOutputOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> nearestCellsOutput: array<u32>;","fn multiplyWide(left: u32, right: u32) -> vec2<u32> {","  let leftLow = left & 0xffffu;","  let leftHigh = left >> 16u;","  let rightLow = right & 0xffffu;","  let rightHigh = right >> 16u;","  let lowLow = leftLow * rightLow;","  let lowHigh = leftLow * rightHigh;","  let highLow = leftHigh * rightLow;","  let middle = (lowLow >> 16u) + (lowHigh & 0xffffu) + (highLow & 0xffffu);","  let low = (lowLow & 0xffffu) | (middle << 16u);","  let high = leftHigh * rightHigh + (lowHigh >> 16u) + (highLow >> 16u) + (middle >> 16u);","  return vec2<u32>(low, high);","/** Whether (candidate + ulp / 2)^2 > mantissa * 2^exponent, for a positive normal candidate. */","fn isUpperMidpointAbove(candidate: f32, mantissa: u32, exponent: i32) -> bool {","  let bits = bitcast<u32>(candidate);","  let candidateExponent = i32((bits >> 23u) & 0xffu);","  let odd = (((bits & 0x7fffffu) | 0x800000u) << 1u) | 1u;","  // Midpoint^2 = odd^2 * 2^(2 * candidateExponent - 302); compare odd^2 with mantissa * 2^shift.","  let square = multiplyWide(odd, odd);","  let shift = exponent - 2 * candidateExponent + 302;","  if (shift < 0) { return true; }","  if (shift >= 64) { return false; }","  var scaled: vec2<u32>;","  if (shift == 0) {","    scaled = vec2<u32>(mantissa, 0u);","  } else if (shift < 32) {","    scaled = vec2<u32>(mantissa << u32(shift), mantissa >> u32(32 - shift));","    let highShift = u32(shift - 32);","    if (highShift > 0u && (mantissa >> (32u - highShift)) != 0u) { return false; }","    scaled = vec2<u32>(0u, mantissa << highShift);","  return square.y > scaled.y || (square.y == scaled.y && square.x > scaled.x);","fn getRoundedSquareRoot(mantissa: u32, exponent: i32) -> f32 {","  if (mantissa == 0u) { return 0.0; }","  var root = sqrt(f32(mantissa) * exp2(f32(exponent)));","  for (var step = 0u; step < 8u; step++) {","    if (!isUpperMidpointAbove(root, mantissa, exponent)) {","      root = bitcast<f32>(bitcast<u32>(root) + 1u);","    } else if (isUpperMidpointAbove(bitcast<f32>(bitcast<u32>(root) - 1u), mantissa, exponent)) {","      root = bitcast<f32>(bitcast<u32>(root) - 1u);","    } else {","      break;","  return root;","  _ = &distanceBits;","  _ = &nearestCellsOutput;","  var nearestCell = nearestCells[nearestCellsOffset + index];","  var seedId = nearestIds[nearestIdsOffset + index];","  var bits = 0x7f800000u;","  if (nearestCell != NONE) {","    let dx = getAbsoluteDifference(index % GRID_WIDTH, nearestCell % GRID_WIDTH);","    let dy = getAbsoluteDifference(index / GRID_WIDTH, nearestCell / GRID_WIDTH);","    var distance: f32;","    if (isIsotropic()) {","      // Exact integer key, so the only roundings are the square root and the scale.","      distance = settings[settingsOffset + 2u] * getRoundedSquareRoot(dx * dx + dy * dy, 0);","      let key = getAnisotropicKey(dx, dy);","      let keyBits = bitcast<u32>(key);","      let keyExponent = (keyBits >> 23u) & 0xffu;","      if (keyExponent == 0u || keyExponent == 0xffu) {","        distance = sqrt(key);","        distance = getRoundedSquareRoot((keyBits & 0x7fffffu) | 0x800000u, i32(keyExponent) - 150);","    if (distance > settings[settingsOffset + 6u]) {","      nearestCell = NONE;","      seedId = NONE;","      bits = bitcast<u32>(distance);","  if (nearestCell == NONE) { seedId = NONE; }","  distanceBits[distanceBitsOffset + index] = bits;","  ","  nearestCellsOutput[nearestCellsOutputOffset + index] = nearestCell;","const nearestOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> nearest: array<u32>;","const radiusOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> radius: array<f32>;","const axisOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> axis: array<u32>;","const WIDTH: u32 = 3u;","const HEIGHT: u32 = 3u;","fn squaredLength(value: vec2<i32>) -> u32 {","  let absolute = vec2<u32>(abs(value));","  return absolute.x * absolute.x + absolute.y * absolute.y;","// Four nearest virtual exterior centers suffice; farther exterior centers cannot win.","fn getBackgroundOffset(cell: u32) -> vec2<i32> {","  let column = i32(cell % WIDTH);","  let row = i32(cell / WIDTH);","  var offset = vec2<i32>(column + 1, 0);","  if (i32(WIDTH) - column < offset.x) { offset = vec2<i32>(column - i32(WIDTH), 0); }","  if (row + 1 < abs(offset.x)) { offset = vec2<i32>(0, row + 1); }","  if (i32(HEIGHT) - row < abs(offset.x) + abs(offset.y)) {","    offset = vec2<i32>(0, row - i32(HEIGHT));","  let background = nearest[nearestOffset + cell];","  if (background != 0xffffffffu) {","    let interior = vec2<i32>(column - i32(background % WIDTH), row - i32(background / WIDTH));","    if (squaredLength(interior) < squaredLength(offset)) { offset = interior; }","  return offset;","fn greatestCommonDivisor(first: u32, second: u32) -> u32 {","  var dividend = first;","  var divisor = second;","    if (divisor == 0u) { return dividend; }","    let remainder = dividend % divisor;","    dividend = divisor;","    divisor = remainder;","  _ = &nearest;","  _ = &radius;","  _ = &axis;","  let column = index % WIDTH;","  let row = index / WIDTH;","  let exteriorRadius = min(min(column + 1u, WIDTH - column), min(row + 1u, HEIGHT - row));","  radius[radiusOffset + index] = min(radius[radiusOffset + index], f32(exteriorRadius));","  let offset = getBackgroundOffset(index);","  let squaredRadius = squaredLength(offset);","  var maximal = squaredRadius > 0u;","  if (maximal) {","    let divisor = greatestCommonDivisor(u32(abs(offset.x)), u32(abs(offset.y)));","    let step = offset / i32(divisor);","    let candidate = vec2<i32>(i32(column), i32(row)) + step;","    if (all(candidate >= vec2<i32>(0)) && candidate.x < i32(WIDTH) && candidate.y < i32(HEIGHT)) {","      let candidateCell = u32(candidate.y) * WIDTH + u32(candidate.x);","      // q and its background b are within [−1, dimension], so the two squares sum to < 2^32.","      maximal = squaredLength(getBackgroundOffset(candidateCell)) != squaredLength(offset + step);","  axis[axisOffset + index] = u32(maximal);"],"strings":["GPUDistanceField","read_write","buffer","logical","read","transient","raster-medial-axis-distance-parameters","compute","raster-medial-axis-distance-row-color","raster-medial-axis-distance-start-markers","raster-medial-axis-distance-row-bands","raster-medial-axis-background","raster-medial-axis-distance-column-fill","raster-medial-axis-distance-finalize","radius","raster-medial-axis-distance-band-markers","raster-medial-axis-distance-cell-seeds","raster-medial-axis-distance-column-ids","raster-medial-axis-distance-column-rows","gpu-raster-raster-medial-axis-snapshot-tap","raster-medial-axis-maximal-disks","GPURasterMedialAxis","raster-medial-axis-distance-column-band-carries","raster-medial-axis-distance-column-band-seeds","raster-medial-axis-distance-entry-starts","raster-medial-axis-distance-nearest-cells","raster-medial-axis-distance-nearest-ids","raster-medial-axis-distance-row-start-markers","raster-medial-axis-distance-seed-clear","raster-medial-axis-nearest-background","medialAxis","raster-medial-axis-distance-column-carry","raster-medial-axis-distance-column-bands","raster-medial-axis-distance-row-marker-bands","foreground","raster-medial-axis-distance-block-ends","raster-medial-axis-distance-entry-next","raster-medial-axis-distance-entry-previous","raster-medial-axis-distance-row-marker-carry","raster-medial-axis-distance-row-marker-clear","bandMarkers","cellSeeds","columnIds","columnRows","imported","input","settings","startMarkers","bandCarries","bandSeeds","entryStarts","nearestCells","nearestIds"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:2",3,1,1],["~:4",[1,1,1],3,false],["~:2",9,1,1],["~:4",[1,1,1],9,false],["~:3","~14","~f","~1","u32",0,3],["~:3","~15","~g","~4","u32",0,9],["~:3","~16","~h","~4","u32",0,9],["~:3","~17","~i","~4","u32",0,9],["~:3","~1a","~6","~4","f32",0,8],["~:3","~1b","~9","~4","u32",0,9]]}}
