  return i32(max(maximumExponentBits, 1u)) - 127 + 1 + i32(headroomBits) - 95;","fn addFixedPoint(a: vec3<u32>, b: vec3<u32>) -> vec3<u32> {","  let low = a.x + b.x;","  let lowCarry = select(0u, 1u, low < a.x);","  let middlePartial = a.y + b.y;","  let middleCarry = select(0u, 1u, middlePartial < a.y);","  let middle = middlePartial + lowCarry;","  let middleRoundCarry = select(0u, 1u, middle < middlePartial);","  return vec3<u32>(low, middle, a.z + b.z + middleCarry + middleRoundCarry);","fn negateFixedPoint(value: vec3<u32>) -> vec3<u32> {","  return addFixedPoint(~value, vec3<u32>(1u, 0u, 0u));","fn shiftFixedPointLeft(value: u32, shift: u32) -> vec3<u32> {","  var words = array<u32, 4>(0u, 0u, 0u, 0u);","  let word = shift / 32u;","  let bit = shift % 32u;","  words[word] = value << bit;","  // (value >> 1) >> (31 - bit) is value >> (32 - bit) without a shift by 32 when bit is 0.","  words[word + 1u] = (value >> 1u) >> (31u - bit);","  return vec3<u32>(words[0], words[1], words[2]);","fn shiftFixedPointRight(value: vec3<u32>, shift: u32) -> u32 {","  var words = array<u32, 4>(value.x, value.y, value.z, 0u);","  return (words[word] >> bit) | ((words[word + 1u] << 1u) << (31u - bit));","fn getFixedPointBit(value: vec3<u32>, position: u32) -> u32 {","  var words = array<u32, 3>(value.x, value.y, value.z);","  return (words[position / 32u] >> (position % 32u)) & 1u;","fn hasFixedPointBitsBelow(value: vec3<u32>, count: u32) -> bool {","  let word = count / 32u;","  var found = (words[word] & ((1u << (count % 32u)) - 1u)) != 0u;","  if (word > 0u) { found = found || words[0] != 0u; }","  if (word > 1u) { found = found || words[1] != 0u; }","  return found;","fn quantizeFixedPoint(value: f32, unitExponent: i32) -> vec3<u32> {","  let bits = bitcast<u32>(value);","  let exponentBits = (bits >> 23u) & 0xffu;","  if (exponentBits == 0xffu) { return vec3<u32>(0u); }","  var significand = bits & 0x7fffffu;","  var exponent = -149;","  if (exponentBits != 0u) {","    significand = significand | 0x800000u;","    exponent = i32(exponentBits) - 150;","  // value = significand * 2^exponent; the term in units is significand * 2^shift.","  let shift = exponent - unitExponent;","  var magnitude = vec3<u32>(0u);","  if (shift >= 0) {","    // The scale bounds shift by 71 - h; the clamp only keeps a misused scale memory-safe.","    magnitude = shiftFixedPointLeft(significand, u32(min(shift, 71)));","  } else if (shift >= -24) {","    let right = u32(-shift);","    var quotient = significand >> right;","    let remainder = significand & ((1u << right) - 1u);","    let half = 1u << (right - 1u);","    if (remainder > half || (remainder == half && (quotient & 1u) != 0u)) {","      quotient = quotient + 1u;","    }","    magnitude = vec3<u32>(quotient, 0u, 0u);","  return select(magnitude, negateFixedPoint(magnitude), (bits >> 31u) != 0u);","fn getFixedPointFloat(value: vec3<u32>, unitExponent: i32) -> f32 {","  let negative = (value.z >> 31u) != 0u;","  let magnitude = select(value, negateFixedPoint(value), negative);","  var leading = 0u;","  if (magnitude.z != 0u) {","    leading = 64u + firstLeadingBit(magnitude.z);","  } else if (magnitude.y != 0u) {","    leading = 32u + firstLeadingBit(magnitude.y);","  } else if (magnitude.x != 0u) {","    leading = firstLeadingBit(magnitude.x);","  } else {","    return 0.0;","  var significand = magnitude.x;","  var exponent = unitExponent;","  if (leading >= 24u) {","    let shift = leading - 23u;","    significand = shiftFixedPointRight(magnitude, shift);","    let roundBit = getFixedPointBit(magnitude, shift - 1u);","    if (roundBit != 0u && (hasFixedPointBitsBelow(magnitude, shift - 1u) || (significand & 1u) != 0u)) {","      significand = significand + 1u;","    exponent = unitExponent + i32(shift);","  // significand <= 2^24, so f32(significand) is exact and the value is significand * 2^exponent.","  var infinityBits = 0x7f800000u;","  var result = bitcast<f32>(infinityBits);","  if (exponent < 104 || (exponent == 104 && significand < 0x1000000u)) {","    // Two steps keep the ldexp exponent in range for normal results below 2^-103.","    let leadingExponent = i32(firstLeadingBit(significand));","    result = ldexp(ldexp(f32(significand), -leadingExponent), exponent + leadingExponent);","  return select(result, -result, negative);","var<workgroup> workgroupExponentBits: atomic<u32>;","@compute @workgroup_size(256)","  _ = &fixedPointValues;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  if (localInvocationIndex == 0u) {","    atomicStore(&workgroupExponentBits, 0u);","  workgroupBarrier();","  if (index < INVOCATION_COUNT) {","    let exponentBits = getFixedPointExponentBits(fixedPointValues[fixedPointValuesOffset + index]);","    if (exponentBits != 0u) {","      atomicMax(&workgroupExponentBits, exponentBits);","    let workgroupMaximum = atomicLoad(&workgroupExponentBits);","    if (workgroupMaximum != 0u) {","      atomicMax(&fixedPointScale[fixedPointScaleOffset], workgroupMaximum);","@group(0) @binding(1) var<storage, read> values: array<f32>;","const scaleOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> scale: array<u32>;","const sumsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> sums: array<atomic<u32>>;","@group(0) @binding(4) var<storage, read_write> counts: array<atomic<u32>>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","fn finite(value: f32) -> bool { return isFiniteBits(value); }","fn missing() -> f32 { return getQuietNaN(); }","fn addFixedPointToSums(cell: u32, value: vec3<u32>) {","  let base = sumsOffset + cell * 3u;","  var lowCarry = 0u;","  if (value.x != 0u) {","    let oldLow = atomicAdd(&sums[base], value.x);","    lowCarry = select(0u, 1u, oldLow + value.x < oldLow);","  let middleAddend = value.y + lowCarry;","  var middleCarry = select(0u, 1u, middleAddend < value.y);","  if (middleAddend != 0u) {","    let oldMiddle = atomicAdd(&sums[base + 1u], middleAddend);","    middleCarry = middleCarry + select(0u, 1u, oldMiddle + middleAddend < oldMiddle);","  let highAddend = value.z + middleCarry;","  if (highAddend != 0u) {","    atomicAdd(&sums[base + 2u], highAddend);","  _ = &scale;","  _ = &sums;","  let label = labels[labelsOffset + index]; let value = values[valuesOffset + index];","if (label >= 4u || !finite(value)) { return; }","let unitExponent = getFixedPointUnitExponent(scale[scaleOffset], 5u);","addFixedPointToSums(label, quantizeFixedPoint(value, unitExponent));","atomicAdd(&counts[countsOffset + label], 1u);","@group(0) @binding(0) var<storage, read> scale: array<u32>;","@group(0) @binding(1) var<storage, read> sums: array<u32>;","const meansOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> means: array<f32>;","@group(0) @binding(3) var<storage, read> counts: array<u32>;","const mappingOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> mapping: array<u32>;","  _ = &means;","  _ = &mapping;","  let count = counts[countsOffset + index];","let words = vec3<u32>(sums[sumsOffset + index * 3u], sums[sumsOffset + index * 3u + 1u], sums[sumsOffset + index * 3u + 2u]);","var mean = getFixedPointFloat(words, unitExponent) / f32(max(count, 1u));","// A sum beyond the f32 range: decode 2^32 times smaller, divide, and scale back.","if (!finite(mean) && count > 0u) { mean = getFixedPointFloat(words, unitExponent - 32) / f32(count) * 4294967296.0; }","means[meansOffset + index] = select(missing(), mean, count > 0u && finite(mean)); mapping[mappingOffset + index] = index;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<u32>;","const originalMeansOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> originalMeans: array<f32>;","const originalCountsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> originalCounts: array<u32>;","const componentMeansOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> componentMeans: array<f32>;","  _ = &source;","  _ = &originalMeans;","  _ = &originalCounts;","  _ = &componentMeans;","  var count = 0u; var mean = 0.0;","for (var region = 0u; region < 4u; region++) {","  let observations = originalCounts[originalCountsOffset + region];","  if (source[sourceOffset + region] != index || observations == 0u) { continue; }","  let combined = count + observations;","  mean = mean * (f32(count) / f32(combined)) + originalMeans[originalMeansOffset + region] * (f32(observations) / f32(combined)); count = combined;","componentMeans[componentMeansOffset + index] = select(missing(), mean, count > 0u);","@group(0) @binding(1) var<storage, read> componentMeans: array<f32>;","@group(0) @binding(2) var<storage, read> adjacency: array<u32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> destination: array<u32>;","  _ = &destination;","  var selectedFirst = 0xffffffffu; var selectedSecond = 0xffffffffu; var selectedWeight: f32 = 1.100000023841858;","for (var first = 0u; first < 4u; first++) {","  let firstRoot = source[sourceOffset + first];","  for (var second = 0u; second < 4u; second++) {","    let secondRoot = source[sourceOffset + second]; let edge = first * 4u + second;","    var weight = missing();","    if (firstRoot != secondRoot && adjacency[adjacencyOffset + edge] > 0u) { weight = abs(componentMeans[componentMeansOffset + firstRoot] - componentMeans[componentMeansOffset + secondRoot]); }","    ","    let lower = min(firstRoot, secondRoot); let upper = max(firstRoot, secondRoot);","    if (finite(weight) && weight <= 1.100000023841858 && (weight < selectedWeight || (weight == selectedWeight && (lower < selectedFirst || (lower == selectedFirst && upper < selectedSecond))))) { selectedWeight = weight; selectedFirst = lower; selectedSecond = upper; }","for (var region