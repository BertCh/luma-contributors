ired-valid pixels in the linear overlap","keySpace":"alignment"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const referenceValuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> referenceValues: array<f32>;","const movingValuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> movingValues: array<f32>;","const movingValidityOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> movingValidity: array<u32>;","const statisticsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> statistics: array<f32>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","fn finite(value: f32) -> bool { return isFiniteBits(value); }","fn missing() -> f32 { return getQuietNaN(); }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &referenceValues;","  _ = &movingValues;","  _ = &movingValidity;","  _ = &statistics;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var referenceMean = 0.0; var movingMean = 0.0; var referenceCount = 0u; var movingCount = 0u;","for (var cell = 0u; cell < 16u; cell++) {","  if (finite(referenceValues[referenceValuesOffset + cell])) { referenceCount++; referenceMean = referenceMean * (1.0 - 1.0 / f32(referenceCount)) + referenceValues[referenceValuesOffset + cell] / f32(referenceCount); }","  if (finite(movingValues[movingValuesOffset + cell]) && movingValidity[movingValidityOffset + cell] != 0u) { movingCount++; movingMean = movingMean * (1.0 - 1.0 / f32(movingCount)) + movingValues[movingValuesOffset + cell] / f32(movingCount); }","statistics[statisticsOffset] = referenceMean; statistics[statisticsOffset + 1u] = movingMean; statistics[statisticsOffset + 2u] = f32(referenceCount); statistics[statisticsOffset + 3u] = f32(movingCount);","@group(0) @binding(3) var<storage, read> statistics: array<f32>;","const referenceOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> reference: array<f32>;","const movingOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> moving: array<f32>;","@compute @workgroup_size(64)","  _ = &reference;","  _ = &moving;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  let column = index % 8u; let row = index / 8u;","var referenceMask = 0.0; var movingMask = 0.0; var referenceValue = 0.0; var movingValue = 0.0;","if (column < 4u && row < 4u) { let cell = row * 4u + column;","  if (finite(referenceValues[referenceValuesOffset + cell])) { referenceMask = 1.0; referenceValue = referenceValues[referenceValuesOffset + cell] - statistics[statisticsOffset]; }","  if (finite(movingValues[movingValuesOffset + cell]) && movingValidity[movingValidityOffset + cell] != 0u) { movingMask = 1.0; movingValue = movingValues[movingValuesOffset + cell] - statistics[statisticsOffset + 1u]; }","let referenceChannels = array<f32, 3>(referenceMask, referenceValue, referenceValue * referenceValue); let movingChannels = array<f32, 3>(movingMask, movingValue, movingValue * movingValue);","for (var channel = 0u; channel < 3u; channel++) { let offset = (channel * 64u + index) * 2u; reference[referenceOffset + offset] = referenceChannels[channel]; reference[referenceOffset + offset + 1u] = 0.0; moving[movingOffset + offset] = movingChannels[channel]; moving[movingOffset + offset + 1u] = 0.0; }","struct GPUFFT2DParameters {","  width: u32,","  height: u32,","  axis: u32,","  passKind: u32,","  transformSize: u32,","  stage: u32,","  directionSign: f32,","  normalizationScale: f32,","  inputOffset: u32,","  outputOffset: u32,","  padding: vec2u,","};","@group(0) @binding(0) var<storage, read> inputValues: array<vec2f>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<vec2f>;","@group(0) @binding(2) var<uniform> parameters: GPUFFT2DParameters;","const GPU_FFT_PI: f32 = 3.14159265358979323846;","fn reverseLowBits(value: u32, bitCount: u32) -> u32 {","  var source = value;","  var reversed = 0u;","  for (var bitIndex = 0u; bitIndex < bitCount; bitIndex++) {","    reversed = (reversed << 1u) | (source & 1u);","    source = source >> 1u;","  return reversed;","fn multiplyComplex(left: vec2f, right: vec2f) -> vec2f {","  return vec2f(","    left.x * right.x - left.y * right.y,","    left.x * right.y + left.y * right.x","  );","fn getLinearIndex(xCoordinate: u32, yCoordinate: u32, batchIndex: u32) -> u32 {","  return batchIndex * parameters.width * parameters.height +","    yCoordinate * parameters.width + xCoordinate;","@compute @workgroup_size(8, 8, 1)","fn main(@builtin(global_invocation_id) globalIdentifier: vec3u) {","  if (globalIdentifier.x >= parameters.width || globalIdentifier.y >= parameters.height) {","  let horizontal = parameters.axis == 0u;","  let coordinate = select(globalIdentifier.y, globalIdentifier.x, horizontal);","  var sourceCoordinate = coordinate;","  if (parameters.passKind == 0u) {","    sourceCoordinate = reverseLowBits(coordinate, parameters.stage);","  } else {","    let butterflySpan = 1u << parameters.stage;","    let butterflyHalfSpan = butterflySpan >> 1u;","    let butterflyOffset = coordinate & (butterflySpan - 1u);","    let twiddleIndex = butterflyOffset & (butterflyHalfSpan - 1u);","    let butterflyStart = coordinate - butterflyOffset;","    let firstCoordinate = butterflyStart + twiddleIndex;","    let secondCoordinate = firstCoordinate + butterflyHalfSpan;","    let firstX = select(globalIdentifier.x, firstCoordinate, horizontal);","    let firstY = select(firstCoordinate, globalIdentifier.y, horizontal);","    let secondX = select(globalIdentifier.x, secondCoordinate, horizontal);","    let secondY = select(secondCoordinate, globalIdentifier.y, horizontal);","    let firstValue = inputValues[parameters.inputOffset + getLinearIndex(firstX, firstY, globalIdentifier.z)];","    let secondValue = inputValues[parameters.inputOffset + getLinearIndex(secondX, secondY, globalIdentifier.z)];","    let angle = parameters.directionSign * 2.0 * GPU_FFT_PI *","      f32(twiddleIndex) / f32(butterflySpan);","    let twiddle = vec2f(cos(angle), sin(angle));","    let rotatedSecondValue = multiplyComplex(secondValue, twiddle);","    let butterflyValue = select(","      firstValue + rotatedSecondValue,","      firstValue - rotatedSecondValue,","      butterflyOffset >= butterflyHalfSpan","    );","    outputValues[parameters.outputOffset + getLinearIndex(globalIdentifier.x, globalIdentifier.y, globalIdentifier.z)] =","      butterflyValue * parameters.normalizationScale;","  let sourceX = select(globalIdentifier.x, sourceCoordinate, horizontal);","  let sourceY = select(sourceCoordinate, globalIdentifier.y, horizontal);","  outputValues[parameters.outputOffset + getLinearIndex(globalIdentifier.x, globalIdentifier.y, globalIdentifier.z)] =","    inputValues[parameters.inputOffset + getLinearIndex(sourceX, sourceY, globalIdentifier.z)] *","      parameters.normalizationScale;","@group(0) @binding(0) var<storage, read> reference: array<f32>;","@group(0) @binding(1) var<storage, read> moving: array<f32>;","const productsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> products: array<f32>;","@compute @workgroup_size(256)","  _ = &products;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let channel = index / 64u; let cell = index % 64u;","let referenceChannels = array<u32, 6>(0u, 1u, 0u, 2u, 0u, 1u); let movingChannels = array<u32, 6>(0u, 0u, 1u, 0u, 2u, 1u);","let firstOffset = (referenceChannels[channel] * 64u + cell) * 2u; let secondOffset = (movingChannels[channel] * 64u + cell) * 2u;","let first = vec2<f32>(reference[referenceOffset + firstOffset], reference[referenceOffset + firstOffset + 1u]); let second = vec2<f32>(moving[movingOffset + secondOffset], moving[movingOffset + secondOffset + 1u]);","products[productsOffset + index * 2u] = dot(first, second); products[productsOffset + index * 2u + 1u] = first.y * second.x - first.x * second.y;","const correlationsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> correlations: array<f32>;","@group(0) @binding(1) var<storage, read> statistics: array<f32>;","const scoresOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> scores: array<f32>;","const supportsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> supports: array<u32>;","  _ = &correlations;","  _ = &scores;","  _ = &supports;","  let shift = vec2<i32>(i32(index % 3u) - 1, i32(index / 3u) - 1);","let coordinate = vec2<u32>((shift + vec2<i32>(8, 8)) % vec2<i32>(8, 8)); let cell = coordinate.y * 8u + coordinate.x;","var moments: array<f32, 6>; for (var channel = 0u; channel < 6u; channel++) { moments[channel] = correlations[correlationsOffset + (channel * 64u + cell) * 2u]; }","let support = max(0.0, floor(moments[0] + 0.5)); supports[supportsOffset + index] = u32(support); var score = missing();","let required = max(3.0, ceil(min(statistics[statisticsOffset + 2u], statistics[statisticsOffset + 3u]) * 0.3));","if (support >= required) { let referenceVariance = moments[3] - moments[1] * moments[1] / support; let movingVariance = moments[4] - moments[2] * moments[2] / support;","  if (referenceVariance > max(1e-12, abs(moments[3]) * 1e-6) && movingVariance > max(1e-12, abs(moments[4]) * 1e-6)) { score = clamp((moments[5] - moments[1] * moments[2] / support) / sqrt(referenceVariance * movingVariance), -1.0, 1.0); }","scores[scoresOffset + index] = score;","@group(0) @binding(0) var<storage, read> scores: array<f32>;","const coarseOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> coarse: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> status: array<u32>;","  _ = &coarse;","  _ = &status;","  var best = -2.0; var selected = 0u;","for (var candidate = 0u; candidate < 9u; candidate++) { let score = scores[scoresOffset + candidate]; if (finite(score) && score > best) { best = score; selected = candidate; } }","let coordinate = vec2<i32>(i32(selected % 3u), i32(selected / 3u)); var secondary = -2.0;","for (var candidate = 0u; candidate < 9u; candidate++) { let position = vec2<i32>(i32(candidate % 3u), i32(candidate / 3u)); if (any(abs(position - coordinate) > vec2<i32>(1))) { let score = scores[scoresOffset + candidate]; if (finite(score)) { secondary = max(secondary, score); } } }","var code = 0u; if (best < 0) { code = 3u; } else if (best - secondary <= max(abs(best), 1e-12) * 0.0001) { code = 2u; }","coarse[coarseOffset] = f32(coordinate.x - 1); coarse[coarseOffset + 1u] = f32(coordinate.y - 1); status[statusOffset] = code;","@group(0) @binding(3) var<storage, read> coarse: array<f32>;","@group(0) @binding(4) var<storage, read> statistics: array<f32>;","const refinedOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> refined: array<f32>;","const refinedSupportOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> refinedSupport: array<u32>;","  _ = &refined;","  _ = &refinedSupport;","  let shift = vec2<f32>(coarse[coarseOffset], coarse[coarseOffset + 1u]) + (vec2<f32>(f32(index % 1u), f32(index / 1u)) - vec2<f32>(0.0)) / 1.0;","refined[refinedOffset + index] = missing(); refinedSupport[refinedSupportOffset + index] = 0u;","if (any(abs(shift) > vec2<f32>(1.0, 1.0))) { return; }","var support = 0u; var referenceMean = 0.0; var movingMean = 0.0; var covariance = 0.0; var referenceVariance = 0.0; var movingVariance = 0.0;","  let referenceValue = reference[referenceOffset + cell] - statistics[statisticsOffset];","  if (!finite(referenceValue) ) { continue; }","  let coordinate = vec2<f32>(f32(cell % 4u), f32(cell / 4u)) - shift;","  if (any(coordinate < vec2<f32>(0.0)) || any(coordinate > vec2<f32>(3.0, 3.0))) { continue; }","  let lower = vec2<i32>(floor(coordinate)); let fraction = fract(coordinate); var movingValue = 0.0; var valid = true;","  for (var corner = 0u; corner < 4u; corner++) {","    let offset = vec2<i32>(i32(corner % 2u), i32(corner / 2u));","    let weight = select(1.0 - fraction.x, fraction.x, offset.x != 0) * select(1.0 - fraction.y, fraction.y, offset.y != 0);","    if (weight <= 0.0) { continue; }","    let position = lower + offset;","    if (any(position < vec2<i32>(0)) || any(position >= vec2<i32>(4, 4))) { valid = false; break; }","    let source = u32(position.y) * 4u + u32(position.x); let value = moving[movingOffset + source];","    if (!finite(value) || movingValidity[movingValidityOffset + source] == 0u) { valid = false; break; }","    movingValue += weight * (value - statistics[statisticsOffset + 1u]);","  if (!valid) { continue; }","  support++; let referenceDifference = referenceValue - referenceMean; let movingDifference = movingValue - movingMean;","  referenceMean += referenceDifference / f32(support); movingMean += movingDifference / f32(support);","  covariance += referenceDifference * (movingValue - movingMean); referenceVariance += referenceDifference * (referenceValue - referenceMean); movingVariance += movingDifference * (movingValue - movingMean);","refinedSupport[refinedSupportOffset + index] = support;","if (f32(support) >= required && referenceVariance > 1e-12 && movingVariance > 1e-12) { refined[refinedOffset + index] = clamp(covariance / sqrt(referenceVariance * movingVariance), -1.0, 1.0); }","@group(0) @binding(0) var<storage, read> refined: array<f32>;","@group(0) @binding(1) var<storage, read> refinedSupport: array<u32>;","@group(0) @binding(2) var<storage, read> coarse: array<f32>;","@group(0) @binding(3) var<storage, read_write> status: array<u32>;","const shiftOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> shift: array<f32>;","const peakOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> peak: array<f32>;","const overlapOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> overlap: array<u32>;","  _ = &shift;","  _ = &peak;","  _ = &overlap;","  var best = -2.0; var selected = 0u; var bestDistance = 0xffffffffu;","for (var candidate = 0u; candidate < 1u; candidate++) {","  let score = refined[refinedOffset + candidate]; let offset = vec2<i32>(i32(candidate % 1u) - 0, i32(candidate / 1u) - 0); let distance = u32(offset.x * offset.x + offset.y * offset.y);","  if (finite(score) && (score > best || (score == best && distance < bestDistance))) { best = score; selected = candidate; bestDistance = distance; }","var code = status[statusOffset]; if (code == 0u && best < 0) { code = 3u; }","let valid = code == 0u; let result = vec2<f32>(coarse[coarseOffset], coarse[coarseOffset + 1u]) + (vec2<f32>(f32(selected % 1u), f32(selected / 1u)) - vec2<f32>(0.0)) / 1.0;","shift[shiftOffset] = select(missing(), result.x, valid); shift[shiftOffset + 1u] = select(missing(), result.y, valid); peak[peakOffset] = select(missing(), best, valid); status[statusOffset] = code;","overlap[overlapOffset] = select(0u, refinedSupport[refinedSupportOffset + selected], valid);"],"strings":["float32x2","read","compute","raster-registration","raster-registration-masked-correlations","raster-registration-masked-inverse-fft-scratch","raster-registration-masked-moving-fft-scratch","raster-registration-masked-moving-spectrum","raster-registration-masked-reference-fft-scratch","raster-registration-masked-reference-spectrum","GPUFFT2D","gpu-core.fft2d","inputValues","outputValues","unconditional","wgsl:9db6a