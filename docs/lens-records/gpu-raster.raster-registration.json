"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const referenceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> reference: array<f32>;","const movingOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> moving: array<f32>;","const movingValidityOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> movingValidity: array<u32>;","const partialsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> partials: array<u32>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","fn finite(value: f32) -> bool { return isFiniteBits(value); }","fn missing() -> f32 { return getQuietNaN(); }","struct RasterMeans { referenceCount: u32, movingCount: u32, referenceMean: f32, movingMean: f32 }","fn combineMeans(first: RasterMeans, second: RasterMeans) -> RasterMeans {","  var result: RasterMeans;","  result.referenceCount = first.referenceCount + second.referenceCount;","  result.movingCount = first.movingCount + second.movingCount;","  if (result.referenceCount > 0u) {","    result.referenceMean = first.referenceMean * (f32(first.referenceCount) / f32(result.referenceCount)) + second.referenceMean * (f32(second.referenceCount) / f32(result.referenceCount));","  }","  if (result.movingCount > 0u) {","    result.movingMean = first.movingMean * (f32(first.movingCount) / f32(result.movingCount)) + second.movingMean * (f32(second.movingCount) / f32(result.movingCount));","  return result;","var<workgroup> sharedMeans: array<RasterMeans, 256>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &reference;","  _ = &moving;","  _ = &movingValidity;","  _ = &partials;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  var state: RasterMeans;","if (index < 16u) {","  let referenceValue = reference[referenceOffset + index]; let movingValue = moving[movingOffset + index];","  if (finite(referenceValue) ) { state.referenceCount = 1u; state.referenceMean = referenceValue; }","  if (finite(movingValue) && movingValidity[movingValidityOffset + index] != 0u) { state.movingCount = 1u; state.movingMean = movingValue; }","sharedMeans[localInvocationIndex] = state;","workgroupBarrier();","for (var stride = 128u; stride > 0u; stride >>= 1u) {","  if (localInvocationIndex < stride) { sharedMeans[localInvocationIndex] = combineMeans(sharedMeans[localInvocationIndex], sharedMeans[localInvocationIndex + stride]); }","  workgroupBarrier();","if (localInvocationIndex == 0u) { let result = sharedMeans[0]; let slot = partialsOffset + workgroupIndex * 4u;","  partials[slot] = result.referenceCount; partials[slot + 1u] = result.movingCount;","  partials[slot + 2u] = bitcast<u32>(result.referenceMean); partials[slot + 3u] = bitcast<u32>(result.movingMean);","@group(0) @binding(0) var<storage, read> partials: array<u32>;","const statisticsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> statistics: array<f32>;","  _ = &statistics;","for (var group = localInvocationIndex; group < 1u; group += 256u) {","  let slot = partialsOffset + group * 4u;","  state = combineMeans(state, RasterMeans(partials[slot], partials[slot + 1u], bitcast<f32>(partials[slot + 2u]), bitcast<f32>(partials[slot + 3u])));","if (localInvocationIndex == 0u) { let result = sharedMeans[0];","  statistics[statisticsOffset] = result.referenceMean; statistics[statisticsOffset + 1u] = result.movingMean;","  // Counts are at most 512 squared, exactly representable in this existing float32 layout.","  statistics[statisticsOffset + 2u] = f32(result.referenceCount); statistics[statisticsOffset + 3u] = f32(result.movingCount);","const referenceValuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> referenceValues: array<f32>;","const movingValuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> movingValues: array<f32>;","@group(0) @binding(3) var<storage, read> statistics: array<f32>;","@group(0) @binding(4) var<storage, read_write> reference: array<f32>;","@group(0) @binding(5) var<storage, read_write> moving: array<f32>;","@compute @workgroup_size(64)","  _ = &referenceValues;","  _ = &movingValues;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let column = index % 8u; let row = index / 8u;","var referenceMask = 0.0; var movingMask = 0.0; var referenceValue = 0.0; var movingValue = 0.0;","if (column < 4u && row < 4u) { let cell = row * 4u + column;","  if (finite(referenceValues[referenceValuesOffset + cell])) { referenceMask = 1.0; referenceValue = referenceValues[referenceValuesOffset + cell] - statistics[statisticsOffset]; }","  if (finite(movingValues[movingValuesOffset + cell]) && movingValidity[movingValidityOffset + cell] != 0u) { movingMask = 1.0; movingValue = movingValues[movingValuesOffset + cell] - statistics[statisticsOffset + 1u]; }","let referenceChannels = array<f32, 3>(referenceMask, referenceValue, referenceValue * referenceValue); let movingChannels = array<f32, 3>(movingMask, movingValue, movingValue * movingValue);","for (var channel = 0u; channel < 3u; channel++) { let offset = (channel * 64u + index) * 2u; reference[referenceOffset + offset] = referenceChannels[channel]; reference[referenceOffset + offset + 1u] = 0.0; moving[movingOffset + offset] = movingChannels[channel]; moving[movingOffset + offset + 1u] = 0.0; }","const productsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> products: array<f32>;","  _ = &products;","  let channel = index / 64u; let cell = index % 64u;","let referenceChannels = array<u32, 6>(0u, 1u, 0u, 2u, 0u, 1u); let movingChannels = array<u32, 6>(0u, 0u, 1u, 0u, 2u, 1u);","let firstOffset = (referenceChannels[channel] * 64u + cell) * 2u; let secondOffset = (movingChannels[channel] * 64u + cell) * 2u;","let first = vec2<f32>(reference[referenceOffset + firstOffset], reference[referenceOffset + firstOffset + 1u]); let second = vec2<f32>(moving[movingOffset + secondOffset], moving[movingOffset + secondOffset + 1u]);","products[productsOffset + index * 2u] = dot(first, second); products[productsOffset + index * 2u + 1u] = first.y * second.x - first.x * second.y;","const correlationsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> correlations: array<f32>;","@group(0) @binding(1) var<storage, read> statistics: array<f32>;","const scoresOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> scores: array<f32>;","const supportsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> supports: array<u32>;","@compute @workgroup_size(32)","  _ = &correlations;","  _ = &scores;","  _ = &supports;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  let shift = vec2<i32>(i32(index % 3u) - 1, i32(index / 3u) - 1);","let coordinate = vec2<u32>((shift + vec2<i32>(8, 8)) % vec2<i32>(8, 8)); let cell = coordinate.y * 8u + coordinate.x;","var moments: array<f32, 6>; for (var channel = 0u; channel < 6u; channel++) { moments[channel] = correlations[correlationsOffset + (channel * 64u + cell) * 2u]; }","let support = max(0.0, floor(moments[0] + 0.5)); supports[supportsOffset + index] = u32(support); var score = missing();","let required = max(3.0, ceil(min(statistics[statisticsOffset + 2u], statistics[statisticsOffset + 3u]) * 0.30000001192092896));","if (support >= required) { let referenceVariance = moments[3] - moments[1] * moments[1] / support; let movingVariance = moments[4] - moments[2] * moments[2] / support;","  if (referenceVariance > max(1e-12, abs(moments[3]) * 1e-6) && movingVariance > max(1e-12, abs(moments[4]) * 1e-6)) { score = clamp((moments[5] - moments[1] * moments[2] / support) / sqrt(referenceVariance * movingVariance), -1.0, 1.0); }","scores[scoresOffset + index] = score;","@group(0) @binding(0) var<storage, read> scores: array<f32>;","const groupValuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> groupValues: array<f32>;","const groupIndicesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> groupIndices: array<u32>;","var<workgroup> argmaxSharedValues: array<f32, 256>;","var<workgroup> argmaxSharedIndices: array<u32, 256>;","  _ = &groupValues;","  _ = &groupIndices;","  var argmaxBestValue = -2.0;","  var argmaxBestIndex = 0xffffffffu;","  if (index < INVOCATION_COUNT) {","    var candidateValue = -2.0;","    var candidateEligible = false;","    candidateValue = scores[scoresOffset + index]; candidateEligible = finite(candidateValue);","    if (candidateEligible && candidateValue > -2.0) {","      argmaxBestValue = candidateValue;","      argmaxBestIndex = index;","    }","  argmaxSharedValues[localInvocationIndex] = argmaxBestValue;","  argmaxSharedIndices[localInvocationIndex] = argmaxBestIndex;","  for (var argmaxStride = 128u; argmaxStride > 0u; argmaxStride = argmaxStride >> 1u) {","    if (localInvocationIndex < argmaxStride) {","      let argmaxOtherValue = argmaxSharedValues[localInvocationIndex + argmaxStride];","      let argmaxOtherIndex = argmaxSharedIndices[localInvocationIndex + argmaxStride];","      let argmaxValue = argmaxSharedValues[localInvocationIndex];","      if (argmaxOtherValue > argmaxValue || (argmaxOtherValue == argmaxValue && argmaxOtherIndex < argmaxSharedIndices[localInvocationIndex])) {","        argmaxSharedValues[localInvocationIndex] = argmaxOtherValue;","        argmaxSharedIndices[localInvocationIndex] = argmaxOtherIndex;","      }","    workgroupBarrier();","  if (localInvocationIndex == 0u && workgroupIndex < 1u) {","    groupValues[groupValuesOffset + workgroupIndex] = argmaxSharedValues[0];","    groupIndices[groupIndicesOffset + workgroupIndex] = argmaxSharedIndices[0];","@group(0) @binding(0) var<storage, read> groupValues: array<f32>;","@group(0) @binding(1) var<storage, read> groupIndices: array<u32>;","const outputValueOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> outputValue: array<f32>;","const outputIndexOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> outputIndex: array<u32>;","  _ = &outputValue;","  _ = &outputIndex;","  for (var argmaxGroup = localInvocationIndex; argmaxGroup < 1u; argmaxGroup += 256u) {","    let argmaxValue = groupValues[groupValuesOffset + argmaxGroup];","    let argmaxGroupIndex = groupIndices[groupIndicesOffset + argmaxGroup];","    if (argmaxValue > argmaxBestValue || (argmaxValue == argmaxBestValue && argmaxGroupIndex < argmaxBestIndex)) {","      argmaxBestValue = argmaxValue;","      argmaxBestIndex = argmaxGroupIndex;","  if (localInvocationIndex == 0u) {","    outputValue[outputValueOffset] = argmaxSharedValues[0];","    outputIndex[outputIndexOffset] = select(argmaxSharedIndices[0], 0u, argmaxSharedIndices[0] == 0xffffffffu);","const bestIndexOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> bestIndex: array<u32>;","@group(0) @binding(2) var<storage, read_write> groupValues: array<f32>;","@group(0) @binding(3) var<storage, read_write> groupIndices: array<u32>;","  _ = &bestIndex;","    let selected = bestIndex[bestIndexOffset]; let coordinate = vec2<i32>(i32(selected % 3u), i32(selected / 3u));","    let position = vec2<i32>(i32(index % 3u), i32(index / 3u));","    candidateValue = scores[scoresOffset + index]; candidateEligible = finite(candidateValue) && any(abs(position - coordinate) > vec2<i32>(1));","const bestScoreOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> bestScore: array<f32>;","const secondaryScoreOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> secondaryScore: array<f32>;","const coarseOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> coarse: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","  _ = &bestScore;","  _ = &secondaryScore;","  _ = &coarse;","  _ = &status;","  let best = bestScore[bestScoreOffset]; let secondary = secondaryScore[secondaryScoreOffset]; let selected = bestIndex[bestIndexOffset];","let coordinate = vec2<i32>(i32(selected % 3u), i32(selected / 3u));","var code = 0u; if (best < 0.0) { code = 3u; } else if (best - secondary <= max(abs(best), 1e-12) * 0.00009999999747378752) { code = 2u; }","coarse[coarseOffset] = f32(coordinate.x - 1); coarse[coarseOffset + 1u] = f32(coordinate.y - 1); status[statusOffset] = code;","@group(0) @binding(3) var<storage, read> coarse: array<f32>;","@group(0) @binding(4) var<storage, read> statistics: array<f32>;","@group(0) @binding(5) var<storage, read_write> partials: array<u32>;","struct RasterMoments { count: u32, referenceMean: f32, movingMean: f32, covariance: f32, referenceVariance: f32, movingVariance: f32 }","// Chan's pairwise form of Welford: fixed tree order, with exact uint32 support throughout.","fn combineMoments(first: RasterMoments, second: RasterMoments) -> RasterMoments {","  if (first.count == 0u) { return second; }","  if (second.count == 0u) { return first; }","  let count = first.count + second.count;","  let fraction = f32(second.count) / f32(count);","  let weight = f32(first.count) * fraction;","  let referenceDifference = second.referenceMean - first.referenceMean;","  let movingDifference = second.movingMean - first.movingMean;","  return RasterMoments(count,","    first.referenceMean + referenceDifference * fraction,","    first.movingMean + movingDifference * fraction,","    first.covariance + second.covariance + referenceDifference * movingDifference * weight,","    first.referenceVariance + second.referenceVariance + referenceDifference * referenceDifference * weight,","    first.movingVariance + second.movingVariance + movingDifference * movingDifference * weight);","var<workgroup> sharedMoments: array<RasterMoments, 256>;","fn sampleMoments(cell: u32, candidate: u32) -> RasterMoments {","  var result: RasterMoments;","  if (cell >= 16u) { return result; }","  let shift = vec2<f32>(coarse[coarseOffset], coarse[coarseOffset + 1u]) + (vec2<f32>(f32(candidate % 1u), f32(candidate / 1u)) - vec2<f32>(0.0)) / 1.0;","  if (any(abs(shift) > vec2<f32>(1.0, 1.0))) { return result; }","  let referenceValue = reference[referenceOffset + cell] - statistics[statisticsOffset];","  if (!finite(referenceValue) ) { return result; }","  let coordinate = vec2<f32>(f32(cell % 4u), f32(cell / 4u)) - shift;","  if (any(coordinate < vec2<f32>(0.0)) || any(coordinate > vec2<f32>(3.0, 3.0))) { return result; }","  let lower = vec2<i32>(floor(coordinate)); let fraction = fract(coordinate); var movingValue = 0.0;","  for (var corner = 0u; corner < 4u; corner++) {","    let offset = vec2<i32>(i32(corner % 2u), i32(corner / 2u));","    let weight = select(1.0 - fraction.x, fraction.x, offset.x != 0) * select(1.0 - fraction.y, fraction.y, offset.y != 0);","    if (weight <= 0.0) { continue; }","    let position = lower + offset;","    if (any(position < vec2<i32>(0)) || any(position >= vec2<i32>(4, 4))) { return result; }","    let source = u32(position.y) * 4u + u32(position.x); let value = moving[movingOffset + source];","    if (!finite(value) || movingValidity[movingValidityOffset + source] == 0u) { return result; }","    movingValue += weight * (value - statistics[statisticsOffset + 1u]);","  result.count = 1u; result.referenceMean = referenceValue; result.movingMean = movingValue;","  if (workgroupIndex >= 1u) { return; }","let candidate = workgroupIndex / 1u;","let cell = (workgroupIndex % 1u) * 256u + localInvocationIndex;","sharedMoments[localInvocationIndex] = sampleMoments(cell, candidate);","  if (localInvocationIndex < stride) { sharedMoments[localInvocationIndex] = combineMoments(sharedMoments[localInvocationIndex], sharedMoments[localInvocationIndex + stride]); }","if (localInvocationIndex == 0u) { let result = sharedMoments[0]; let slot = partialsOffset + workgroupIndex * 6u;","  partials[slot] = result.count; partials[slot + 1u] = bitcast<u32>(result.referenceMean); partials[slot + 2u] = bitcast<u32>(result.movingMean);","  partials[slot + 3u] = bitcast<u32>(result.covariance); partials[slot + 4u] = bitcast<u32>(result.referenceVariance); partials[slot + 5u] = bitcast<u32>(result.movingVariance);","const refinedOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> refined: array<f32>;","const refinedSupportOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> refinedSupport: array<u32>;","  _ = &refined;","  _ = &refinedSupport;","  var state: RasterMoments;","  let slot = partialsOffset + (workgroupIndex * 1u + group) * 6u;","  state = combineMoments(state, RasterMoments(partials[slot], bitcast<f32>(partials[slot + 1u]), bitcast<f32>(partials[slot + 2u]), bitcast<f32>(partials[slot + 3u]), bitcast<f32>(partials[slot + 4u]), bitcast<f32>(partials[slot + 5u])));","sharedMoments[localInvocationIndex] = state;","if (localInvocationIndex == 0u) { let result = sharedMoments[0]; var score = missing();","  let required = max(3.0, ceil(min(statistics[statisticsOffset + 2u], statistics[statisticsOffset + 3u]) * 0.30000001192092896));","  if (f32(result.count) >= required && result.referenceVariance > 1e-12 && result.movingVariance > 1e-12) { score = clamp(result.covariance / sqrt(result.referenceVariance * result.movingVariance), -1.0, 1.0); }","  refined[refinedOffset + workgroupIndex] = score; refinedSupport[refinedSupportOffset + workgroupIndex] = result.count;","@group(0) @binding(0) var<storage, read> refined: array<f32>;","@group(0) @binding(1) var<storage, read> refinedSupport: array<u32>;","@group(0) @binding(2) var<storage, read> coarse: array<f32>;","@group(0) @binding(3) var<storage, read_write> status: array<u32>;","const shiftOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> shift: array<f32>;","const peakOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> peak: array<f32>;","const overlapOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> overlap: array<u32>;","  _ = &shift;","  _ = &peak;","  _ = &overlap;","  var best = -2.0; var selected = 0u; var bestDistance = 0xffffffffu;","for (var candidate = 0u; candidate < 1u; candidate++) {","  let score = refined[refinedOffset + candidate]; let offset = vec2<i32>(i32(candidate % 1u) - 0, i32(candidate / 1u) - 0); let distance = u32(offset.x * offset.x + offset.y * offset.y);","  if (finite(score) && (score > best || (score == best && distance < bestDistance))) { best = score; selected = candidate; bestDistance = distance; }","var code = status[statusOffset]; if (code == 0u && best < 0.0) { code = 3u; }","let valid = code == 0u; let result = vec2<f32>(coarse[coarseOffset], coarse[coarseOffset + 1u]) + (vec2<f32>(f32(selected % 1u), f32(selected / 1u)) - vec2<f32>(0.0)) / 1.0;","shift[shiftOffset] = select(missing(), result.x, valid); shift[shiftOffset + 1u] = select(missing(), result.y, valid); peak[peakOffset] = select(missing(), best, valid); status[statusOffset] = code;","overlap[overlapOffset] = select(0u, refinedSupport[refinedSupportOffset + selected], valid);"],"strings":["compute","buffer","read","logical","GPURasterRegistration","raster-registration-masked-statistics","read_write","raster-registration-masked-coarse","transient","raster-registration-masked-correlations","raster-registration-masked-moving-spectrum","raster-registration-masked-reference-spectrum","raster-registration-masked-inverse-fft-scratch","raster-registration-masked-moving-fft-scratch","raster-registr