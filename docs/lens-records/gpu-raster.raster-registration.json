]) * 1e-6)) { score = clamp((moments[5] - moments[1] * moments[2] / support) / sqrt(referenceVariance * movingVariance), -1.0, 1.0); }","scores[scoresOffset + index] = score;","@group(0) @binding(0) var<storage, read> scores: array<f32>;","const groupValuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> groupValues: array<f32>;","const groupIndicesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> groupIndices: array<u32>;","var<workgroup> argmaxSharedValues: array<f32, 256>;","var<workgroup> argmaxSharedIndices: array<u32, 256>;","  _ = &groupValues;","  _ = &groupIndices;","  ","  var argmaxBestValue = -2.0;","  var argmaxBestIndex = 0xffffffffu;","  if (index < INVOCATION_COUNT) {","    var candidateValue = -2.0;","    var candidateEligible = false;","    candidateValue = scores[scoresOffset + index]; candidateEligible = finite(candidateValue);","    if (candidateEligible && candidateValue > -2.0) {","      argmaxBestValue = candidateValue;","      argmaxBestIndex = index;","    }","  argmaxSharedValues[localInvocationIndex] = argmaxBestValue;","  argmaxSharedIndices[localInvocationIndex] = argmaxBestIndex;","  workgroupBarrier();","  for (var argmaxStride = 128u; argmaxStride > 0u; argmaxStride = argmaxStride >> 1u) {","    if (localInvocationIndex < argmaxStride) {","      let argmaxOtherValue = argmaxSharedValues[localInvocationIndex + argmaxStride];","      let argmaxOtherIndex = argmaxSharedIndices[localInvocationIndex + argmaxStride];","      let argmaxValue = argmaxSharedValues[localInvocationIndex];","      if (argmaxOtherValue > argmaxValue || (argmaxOtherValue == argmaxValue && argmaxOtherIndex < argmaxSharedIndices[localInvocationIndex])) {","        argmaxSharedValues[localInvocationIndex] = argmaxOtherValue;","        argmaxSharedIndices[localInvocationIndex] = argmaxOtherIndex;","      }","    workgroupBarrier();","  if (localInvocationIndex == 0u && workgroupIndex < 1u) {","    groupValues[groupValuesOffset + workgroupIndex] = argmaxSharedValues[0];","    groupIndices[groupIndicesOffset + workgroupIndex] = argmaxSharedIndices[0];","@group(0) @binding(0) var<storage, read> groupValues: array<f32>;","@group(0) @binding(1) var<storage, read> groupIndices: array<u32>;","const outputValueOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> outputValue: array<f32>;","const outputIndexOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> outputIndex: array<u32>;","  _ = &outputValue;","  _ = &outputIndex;","  for (var argmaxGroup = localInvocationIndex; argmaxGroup < 1u; argmaxGroup += 256u) {","    let argmaxValue = groupValues[groupValuesOffset + argmaxGroup];","    let argmaxGroupIndex = groupIndices[groupIndicesOffset + argmaxGroup];","    if (argmaxValue > argmaxBestValue || (argmaxValue == argmaxBestValue && argmaxGroupIndex < argmaxBestIndex)) {","      argmaxBestValue = argmaxValue;","      argmaxBestIndex = argmaxGroupIndex;","  if (localInvocationIndex == 0u) {","    outputValue[outputValueOffset] = argmaxSharedValues[0];","    outputIndex[outputIndexOffset] = select(argmaxSharedIndices[0], 0u, argmaxSharedIndices[0] == 0xffffffffu);","const bestIndexOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> bestIndex: array<u32>;","@group(0) @binding(2) var<storage, read_write> groupValues: array<f32>;","@group(0) @binding(3) var<storage, read_write> groupIndices: array<u32>;","  _ = &bestIndex;","    let selected = bestIndex[bestIndexOffset]; let coordinate = vec2<i32>(i32(selected % 3u), i32(selected / 3u));","    let position = vec2<i32>(i32(index % 3u), i32(index / 3u));","    candidateValue = scores[scoresOffset + index]; candidateEligible = finite(candidateValue) && any(abs(position - coordinate) > vec2<i32>(1));","const bestScoreOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> bestScore: array<f32>;","const secondaryScoreOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> secondaryScore: array<f32>;","const coarseO