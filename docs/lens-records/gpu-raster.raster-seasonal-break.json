g() -> f32 { return getQuietNaN(); }","struct LeastSquaresResult { coefficients: array<f32, 6>, residual: f32, valid: bool }","fn leastSquares(design: array<f32, 144>, response: array<f32, 24>, columnCount: u32) -> LeastSquaresResult {","  var basis = design;","  var upper: array<f32, 36>;","  var projected: array<f32, 6>;","  var result: LeastSquaresResult;","  result.valid = false;","  var maximumNorm = 0.0;","  for (var column = 0u; column < columnCount; column++) {","    // Original norm, orthogonal projections and final norm have disjoint lifetimes.","    var columnAccumulator = 0.0;","    for (var row = 0u; row < 24u; row++) { columnAccumulator += basis[column * 24u + row] * basis[column * 24u + row]; }","    maximumNorm = max(maximumNorm, sqrt(columnAccumulator));","    for (var orthogonalizationRound = 0u; orthogonalizationRound < 2u; orthogonalizationRound++) {","      for (var previous = 0u; previous < column; previous++) {","        columnAccumulator = 0.0;","        for (var row = 0u; row < 24u; row++) { columnAccumulator += basis[previous * 24u + row] * basis[column * 24u + row]; }","        upper[previous * 6u + column] += columnAccumulator;","        for (var row = 0u; row < 24u; row++) { basis[column * 24u + row] -= columnAccumulator * basis[previous * 24u + row]; }","      }","    }","    columnAccumulator = 0.0;","    columnAccumulator = sqrt(columnAccumulator);","    if (!finite(columnAccumulator) || columnAccumulator <= maximumNorm * 1e-6) { return result; }","    upper[column * 6u + column] = columnAccumulator;","    for (var row = 0u; row < 24u; row++) {","      basis[column * 24u + row] /= columnAccumulator;","      projected[column] += basis[column * 24u + row] * response[row];","  }","  for (var reverse = 0u; reverse < columnCount; reverse++) {","    let column = columnCount - 1u - reverse;","    var value = projected[column];","    for (var following = column + 1u; following < columnCount; following++) { value -= upper[column * 6u + following] * result.coefficients[following]; }","    result.coefficients[column] = value / upper[column * 6u + column];","    if (!finite(result.coefficients[column])) { return result; }","  result.residual = 0.0;","  for (var row = 0u; row < 24u; row++) {","    var prediction = 0.0;","    for (var column = 0u; column < columnCount; column++) { prediction += design[column * 24u + row] * result.coefficients[column]; }","    result.residual += (prediction - response[row]) * (prediction - response[row]);","  result.valid = finite(result.residual);","  return result;","fn isObserved(cell: u32, slice: u32) -> bool {","  let source = cell * 36u + slice;","  return finite(values[valuesOffset + source]) ;","fn seasonalBasis(slice: u32, column: u32) -> f32 { return select(0.0, 1.0, slice % 4u == column - 1u); }","struct ModelFit { coefficients: array<f32, 6>, residual: f32, valid: bool, converged: bool, iterations: u32 }","fn fitModel(design: array<f32, 144>, response: array<f32, 24>, columnCount: u32) -> ModelFit {","  var result: ModelFit;","  // Rank certification is independent of the bounded iterative trajectory.","  let certified = leastSquares(design, response, columnCount);","  if (!certified.valid) { return result; }","  result.coefficients = certified.coefficients; result.residual = certified.residual; result.valid = true; result.converged = true; result.iterations = 1u;","@compute @workgroup_size(2)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &coefficients;","  _ = &components;","  _ = &breakIndex;","  _ = &improvement;","  _ = &status;","  _ = &diagnostics;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 2147483648u) { return; }","  let index = workgroupIndex * 2u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var training: array<u32, 1>;","var response: array<f32, 24>; var design: array<f32, 144>;","var rejected = false;","for (var slice = 0u; slice < 36u; slice++) {","  let source = index * 36u + slice; let value = values[valuesOffset + source];","  let observed = isObserved(index, slice);","  if (slice < 24u) {","    if (observed) { training[slice / 32u] |= 1u << (slice % 32u); } rejected = rejected || !observed;","    if (observed) { response[slice] = value; }","var count = 0u; var energy = 0.0;","for (var slice = 0u; slice < 24u; slice++) {","  if ((training[slice / 32u] & (1u << (slice % 32u))) == 0u) { continue; } count++; energy += response[slice] * response[slice];","  design[slice] = 1.0; design[24u + slice] = f32(slice) / 36.0;","  for (var column = 2u; column < 5u; column++) { design[column * 24u + slice] = seasonalBasis(slice, column); }","var chosen: array<f32, 6>; var boundary = 0xffffffffu; var gain = 0.0;","var code = 1u; var iterations = 0u; var converged = true; var selectedResidual = 0.0; var selectedColumns = 5u;","if (false) { code = 4u; }","else if (!finite(energy)) { code = 2u; }","else if (count >= 16u) {","  let baseline = fitModel(design, response, 5u); code = 2u;","  iterations = baseline.iterations; converged = baseline.converged;","  if (baseline.valid) {","    code = 0u; chosen = baseline.coefficients; selectedResidual = baseline.residual;","    let residualFloor = max(1e-20, energy * 1e-12);","    let baselineScore = f32(count) * log(max(baseline.residual, residualFloor) / f32(count)) + 5.0 * log(f32(count));","    for (var split = 8u; split <= 16u; split++) {","      var before = 0u; var after = 0u;","      for (var slice = 0u; slice < 24u; slice++) {","        design[120u + slice] = 0.0;","        if ((training[slice / 32u] & (1u << (slice % 32u))) != 0u) { if (slice < split) { before++; } else { after++; design[120u + slice] = 1.0; } }","      if (before < 8u || after < 8u) { continue; }","      let candidate = fitModel(design, response, 6u);","      iterations = max(iterations, candidate.iterations);","      if (!candidate.valid) { continue; }","      converged = converged && candidate.converged;","      let candidateGain = baselineScore - (f32(count) * log(max(candidate.residual, residualFloor) / f32(count)) + 7.0 * log(f32(count)));","      if (candidateGain > max(gain, 0.0)) {","        chosen = candidate.coefficients; gain = candidateGain; boundary = split; selectedResidual = candidate.residual; selectedColumns = 6u;","    if (!converged) { code = 8u; }","let fitted = code == 0u || code == 8u;","var residualScale = missing(); var alarm = -1.0; var maximumScore = 0.0; var consecutive = 0u; var previousSign = 0.0;","if (fitted) { residualScale = sqrt(max(selectedResidual, max(1e-20, energy * 1e-12)) / f32(max(1u, count - selectedColumns))); }","for (var column = 0u; column < 6u; column++) { coefficients[coefficientsOffset + index * 6u + column] = select(missing(), chosen[column], fitted); }","  let destination = (index * 36u + slice) * 3u;","  var trend = missing(); var seasonal = missing(); var error = missing();","  if (fitted) {","    trend = chosen[0] + chosen[1] * f32(slice) / 36.0 + select(0.0, chosen[5], slice >= boundary);","    seasonal = 0.0; for (var column = 2u; column < 5u; column++) { seasonal += chosen[column] * seasonalBasis(slice, column); }","    if (isObserved(index, slice)) { error = values[valuesOffset + index * 36u + slice] - trend - seasonal; }","    ","    if (slice >= 24u) {","      if (!isObserved(index, slice)) { consecutive = 0u; previousSign = 0.0; }","      else {","        let score = error / residualScale;","        if (!finite(score)) { code = 2u; }","        else {","          maximumScore = max(maximumScore, abs(score));","          if (abs(score) >= 4.0) {","            let direction = sign(score); consecutive = select(1u, consecutive + 1u, direction == previousSign); previousSign = direction;","            if (alarm < 0.0 && consecutive >= 2u) { alarm = f32(slice + 1u - 2u); }","          } else { consecutive = 0u; previousSign = 0.0; }","        }","  components[componentsOffset + destination] = trend; components[componentsOffset + destination + 1u] = seasonal; components[componentsOffset + destination + 2u] = error;","breakIndex[breakIndexOffset + index] = boundary; improvement[improvementOffset + index] = select(missing(), gain, fitted); status[statusOffset + index] = code;","let diagnosticOffset = diagnosticsOffset + index * 6u;","diagnostics[diagnosticOffset] = f32(iterations); diagnostics[diagnosticOffset + 1u] = select(0.0, 1.0, fitted && converged && code != 2u); diagnostics[diagnosticOffset + 2u] = f32(count);","diagnostics[diagnosticOffset + 3u] = residualScale; diagnostics[diagnosticOffset + 4u] = alarm; diagnostics[diagnosticOffset + 5u] = maximumScore;"],"strings":["gpu-raster-raster-seasonal-break-snapshot-tap","raster-seasonal-break","breakIndex","buffer","coefficients","components","diagnostics","imported","logical","status","bicImprovement","read_write","seasonalObservations","GPURasterSeasonalBreak"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextur