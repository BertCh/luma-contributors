const endmembersOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> endmembers: array<f32>;","const abundancesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> abundances: array<f32>;","const residualOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> residual: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","const iterationCountsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> iterationCounts: array<u32>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","fn finite(value: f32) -> bool { return isFiniteBits(value); }","fn missing() -> f32 { return getQuietNaN(); }","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &endmembers;","  _ = &abundances;","  _ = &residual;","  _ = &status;","  _ = &iterationCounts;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var design: array<f32, 6>; var response: array<f32, 3>; var coefficients: array<f32, 2>; var count = 0u;","for (var band = 0u; band < 3u; band++) {","  let source = index * 3u + band; let value = values[valuesOffset + source];","  if (!finite(value) ) { continue; }","  var valid = true;","  for (var member = 0u; member < 2u; member++) { valid = valid && finite(endmembers[endmembersOffset + member * 3u + band]); }","  if (!valid) { continue; }","  response[band] = value; count++;","  for (var member = 0u; member < 2u; member++) { design[member * 3u + band] = endmembers[endmembersOffset + member * 3u + band]; }","var code = 1u; var residualValue = missing(); var performed = 0u;","if (count >= 2u) {","  var lipschitz = 0.0; var gradientScale = 0.0;","  for (var member = 0u; member < 2u; member++) {","    var gradient = 0.0;","    for (var band = 0u; band < 3u; band++) { let value = design[member * 3u + band]; lipschitz += value * value; gradient += value * response[band]; }","    gradientScale = max(gradientScale, abs(gradient));","    coefficients[member] = 1.0 / 2.0;","  code = 2u;","  if (lipschitz > 0.0 && finite(lipschitz)) {","    code = 4u;","    for (var iteration = 0u; iteration < 256u; iteration++) {","      var errors: array<f32, 3>;","      for (var band = 0u; band < 3u; band++) { errors[band] = -response[band]; for (var member = 0u; member < 2u; member++) { errors[band] += design[member * 3u + band] * coefficients[member]; } }","      var candidate: array<f32, 2>;","      for (var member = 0u; member < 2u; member++) {","        var gradient = 0.0; for (var band = 0u; band < 3u; band++) { gradient += design[member * 3u + band] * errors[band]; }","        candidate[member] = coefficients[member] - gradient / lipschitz;","      }","      var sorted = candidate;","      for (var member = 1u; member < 2u; member++) { let value = sorted[member]; var position = member; loop { if (position == 0u) { break; } if (sorted[position - 1u] >= value) { break; } sorted[position] = sorted[position - 1u]; position--; } sorted[position] = value; }","      var sum = 0.0; var threshold = 0.0;","      for (var member = 0u; member < 2u; member++) { sum += sorted[member]; let trial = (sum - 1.0) / f32(member + 1u); if (sorted[member] > trial) { threshold = trial; } }","      for (var member = 0u; member < 2u; member++) { candidate[member] = max(candidate[member] - threshold, 0.0); }","      var mapping = 0.0;","      for (var member = 0u; member < 2u; member++) { mapping = max(mapping, abs(candidate[member] - coefficients[member]) * lipschitz); }","      coefficients = candidate; performed = iteration + 1u;","      if (mapping <= 0.000001 * max(1.0, gradientScale)) { code = 0u; break; }","    }","    residualValue = 0.0;","    for (var band = 0u; band < 3u; band++) { var error = -response[band]; for (var member = 0u; member < 2u; member++) { error += design[member * 3u + band] * coefficients[member]; } residualValue += error * error; }","    if (!finite(residualValue)) { code = 2u; }","for (var member = 0u; member < 2u; member++) { abundances[abundancesOffset + index * 2u + member] = select(missing(), coefficients[member], code == 0u || code == 4u); }","residual[residualOffset + index] = residualValue; status[statusOffset + index] = code; iterationCounts[iterationCountsOffset + index] = performed;"],"strings":["raster-spectral-unmixing","buffer","imported","abundances","status","endmembers","iterations","read_write","squaredResidual","GPURasterSpectralUnmixing","spectra","read"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","kind","bytes","ownership","firstNode","lastNode"]],"lists":[]}}
