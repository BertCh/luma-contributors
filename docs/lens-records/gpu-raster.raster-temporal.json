, 3>, residual: f32, valid: bool }","fn leastSquares(design: array<f32, 21>, response: array<f32, 7>) -> LeastSquaresResult {","  var basis = design;","  var upper: array<f32, 9>;","  var projected: array<f32, 3>;","  var result: LeastSquaresResult;","  result.valid = false;","  var maximumNorm = 0.0;","  for (var column = 0u; column < 3u; column++) {","    var originalNorm = 0.0;","    for (var row = 0u; row < 7u; row++) { originalNorm += basis[column * 7u + row] * basis[column * 7u + row]; }","    maximumNorm = max(maximumNorm, sqrt(originalNorm));","    for (var orthogonalizationRound = 0u; orthogonalizationRound < 2u; orthogonalizationRound++) {","      for (var previous = 0u; previous < column; previous++) {","        var projection = 0.0;","        for (var row = 0u; row < 7u; row++) { projection += basis[previous * 7u + row] * basis[column * 7u + row]; }","        upper[previous * 3u + column] += projection;","        for (var row = 0u; row < 7u; row++) { basis[column * 7u + row] -= projection * basis[previous * 7u + row]; }","      }","    }","    var norm = 0.0;","    for (var row = 0u; row < 7u; row++) { norm += basis[column * 7u + row] * basis[column * 7u + row]; }","    norm = sqrt(norm);","    if (!finite(norm) || norm <= maximumNorm * 1e-6) { return result; }","    upper[column * 3u + column] = norm;","    for (var row = 0u; row < 7u; row++) {","      basis[column * 7u + row] /= norm;","      projected[column] += basis[column * 7u + row] * response[row];","  }","  for (var reverse = 0u; reverse < 3u; reverse++) {","    let column = 3u - 1u - reverse;","    var value = projected[column];","    for (var following = column + 1u; following < 3u; following++) { value -= upper[column * 3u + following] * result.coefficients[following]; }","    result.coefficients[column] = value / upper[column * 3u + column];","    if (!finite(result.coefficients[column])) { return result; }","  result.residual = 0.0;","  for (var row = 0u; row < 7u; row++) {","    var prediction = 0.0;","    for (var column = 0u; column < 3u; column++) { prediction += design[column * 7u + row] * result.coefficients[column]; }","    result.residual += (prediction - response[row]) * (prediction - response[row]);","  result.valid = finite(result.residual);","  return result;","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &mask;","  _ = &outputvalues;","  _ = &outputcounts;","  _ = &outputchosenSlice;","  _ = &outputstatus;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let cell = index / 9u; let center = i32(index % 9u);","let first = clamp(center - 3, 0, 2);","var design: array<f32, 21>; var response: array<f32, 7>; var count = 0u;","for (var position = 0u; position < 7u; position++) {","  let slice = first + i32(position); if (slice < 0 || slice >= 9) { continue; }","  let source = cell * 9u + u32(slice); let value = values[valuesOffset + source];","  if (!finite(value) || mask[maskOffset + source] == 0u) { continue; }","  let coordinate = f32(slice - center) / 7.0; var power = 1.0;","  for (var column = 0u; column < 3u; column++) { design[column * 7u + position] = power; power *= coordinate; }","  response[position] = value; count++;","outputcounts[outputcountsOffset + index] = count; outputchosenSlice[outputchosenSliceOffset + index] = 0xffffffffu;","var value = missing(); var status = 1u;","if (count >= 3u) { let fit = leastSquares(design, response); status = 2u; if (fit.valid) { value = fit.coefficients[0]; status = 0u; } }","outputvalues[outputvaluesOffset + index] = value; outputstatus[outputstatusOffset + index] = status;"],"strings":