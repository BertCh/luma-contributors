des":{}}],"captures":{"schema":"luma.computation-captures/1","runId":"run-da704869","snapshots":[{"id":"gpu-raster-raster-texture-snapshots-checkerboard-0","name":"checkerboard","iteration":0,"elementType":"f32","values":"b64:AAAAAAAAgD8AAAAAAACAPwAAgD8AAAAAAACAPwAAAAAAAAAAAACAPwAAAAAAAIA/AACAPwAAAAAAAIA/AAAAAA==","provenance":"gpu-readback","graph":"gpu-raster-raster-texture-compiled","resource":"checkerboard","afterNode":"raster-texture","role":"input","meaning":"Binary checkerboard observations before quantization","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-raster-raster-texture-snapshots-features-0","name":"features","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-raster-raster-texture-compiled","resource":"features","afterNode":"raster-texture","role":"output","meaning":"Contrast, dissimilarity, homogeneity, ASM, energy, correlation and entropy","components":7,"keySpace":"cells"},{"id":"gpu-raster-raster-texture-snapshots-pairCount-0","name":"pairCount","iteration":0,"elementType":"u32","values":"b64:BAAAAAgAAAAIAAAABAAAAAYAAAAMAAAADAAAAAYAAAAGAAAADAAAAAwAAAAGAAAABAAAAAgAAAAIAAAABAAAAA==","provenance":"gpu-readback","graph":"gpu-raster-raster-texture-compiled","resource":"pairCount","afterNode":"raster-texture","role":"output","meaning":"Directed paired-valid observations, including symmetric reverse pairs","keySpace":"cells","geometry":{"kind":"raster","shape":[4,4],"coordinateModel":"projected","cellSize":1,"unit":"m"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const valuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> values: array<f32>;","const featuresOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> features: array<f32>;","const pairCountOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> pairCount: array<u32>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","fn finite(value: f32) -> bool { return isFiniteBits(value); }","fn missing() -> f32 { return getQuietNaN(); }","fn quantize(value: f32) -> u32 { return u32(clamp(floor((value - 0) / 1 * 2.0), 0.0, 1.0)); }","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &features;","  _ = &pairCount;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var histogram: array<u32, 4>;","let center = vec2<i32>(i32(index % 4u), i32(index / 4u));","let lower = max(center - vec2<i32>(1), vec2<i32>(0));","let upper = min(center + vec2<i32>(1), vec2<i32>(3, 3));","var count = 0u;","for (var row = lower.y; row <= upper.y; row++) {","  for (var column = lower.x; column <= upper.x; column++) {","    let following = vec2<i32>(column, row) + vec2<i32>(1, 0);","    if (any(following < lower) || any(following > upper)) { continue; }","    let firstIndex = u32(row) * 4u + u32(column);","    let secondIndex = u32(following.y) * 4u + u32(following.x);","    let firstValue = values[valuesOffset + firstIndex]; let secondValue = values[valuesOffset + secondIndex];","    if (!finite(firstValue) || !finite(secondValue) ) { continue; }","    let first = quantize(firstValue); let second = quantize(secondValue);","    histogram[first * 2u + second]++; count++;","    histogram[second * 2u + first]++; count++;","pairCount[pairCountOffset + index] = count;","for (var metric = 0u; metric < 7u; metric++) { features[featuresOffset + index * 7u + metric] = missing(); }","if (count == 0u) { return; }","var contrast = 0.0; var dissimilarity = 0.0; var homogeneity = 0.0; var angular = 0.0; var entropy = 0.0; var firstMean = 0.0; var secondMean = 0.0;","for (var cell = 0u; cell < 4u; cell++) {","  let probability = f32(histogram[cell]) / f32(count); let first = f32(cell / 2u); let second = f32(cell % 2u); let difference = first - second;","  contrast += probability * difference * difference; dissimilarity += probability * abs(difference); homogeneity += probability / (1.0 + difference * difference); angular += probability * probability;","  if (probability > 0.0) { entropy -= probability * log(probability); }","  firstMean += probability * first; secondMean += probability * second;","var covariance = 0.0; var firstVariance = 0.0; var secondVariance = 0.0;","  let probability = f32(histogram[cell]) / f32(count); let first = f32(cell / 2u) - firstMean; let second = f32(cell % 2u) - secondMean;","  covariance += probability * first * second; firstVariance += probability * first * first; secondVariance += probability * second * second;","var correlation = 1.0;","if (firstVariance > 1e-15 && secondVariance > 1e-15) { correlation = covariance / sqrt(firstVariance * secondVariance); }","let result = array<f32, 7>(contrast, dissimilarity, homogeneity, angular, sqrt(angular), correlation, entropy);","for (var metric = 0u; metric < 7u; metric++) { features[featuresOffset + index * 7u + metric] = result[metric]; }"],"strings":["raster-texture","features","pairCount","GPURasterTexture","buffer","checkerboard","imported","read_write"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","kind","bytes","ownership","firstNode","lastNode"]],"lists":[]}}
