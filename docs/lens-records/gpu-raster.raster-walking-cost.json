ride WGSL_KERNEL_DISPATCH_Y: u32;","const statusOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> status: array<u32>;","const dispatchOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> dispatch: array<u32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &status;","  _ = &dispatch;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  status[statusOffset + 0u] = 0u;","  status[statusOffset + 1u] = 1u;","  status[statusOffset + 2u] = 0u;","  status[statusOffset + 3u] = 0u;","  dispatch[dispatchOffset + 0u] = 1u;","  dispatch[dispatchOffset + 1u] = 1u;","  dispatch[dispatchOffset + 2u] = 1u;","}","const slotTableOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> slotTable: array<u32>;","  _ = &slotTable;","  slotTable[slotTableOffset + index * 64u] = index;","const elevationOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> elevation: array<f32>;","const elevationValidityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> elevationValidity: array<u32>;","const frictionOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> friction: array<f32>;","const frictionValidityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> frictionValidity: array<u32>;","const sourcesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> sources: array<u32>;","const surfaceOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> surface: array<f32>;","const firstOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> first: array<f32>;","  _ = &elevation;","  _ = &elevationValidity;","  _ = &friction;","  _ = &frictionValidity;","  _ = &sources;","  _ = &surface;","  _ = &first;","  let valid = elevationValidity[elevationValidityOffset + index] != 0u","    && frictionValidity[frictionValidityOffset + index] != 0u","    && friction[frictionOffset + index] >= 0.0;","  // Invalid cells carry NaN elevation, so no neighbor relaxes through them.","  surface[surfaceOffset + index * 2u] = select(","    bitcast<f32>(0x7fc00000u | (index & 0u)),","    elevation[elevationOffset + index],","    valid","  );","  surface[surfaceOffset + index * 2u + 1u] = friction[frictionOffset + index];","  first[firstOffset + index] = select(","    bitcast<f32>(0x7f800000u | (index & 0u)),","    0.0,","    valid && sources[sourcesOffset + index] != 0u","@group(0) @binding(0) var<storage, read> surface: array<f32>;","const previousOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> previous: array<f32>;","const nextOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> next: array<f32>;","@group(0) @binding(3) var<storage, read_write> status: array<atomic<u32>>;","const settingsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> settings: array<f32>;","const roundSlotOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read> roundSlot: array<u32>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","const WIDTH: u32 = 3u;","const HEIGHT: u32 = 3u;","fn parametersMatchModel() -> bool {","  return settings[settingsOffset + 8u] == 0.0 && settings[settingsOffset + 9u] == 0.0 && settings[settingsOffset + 10u] == 0.0 &&","    settings[settingsOffset + 11u] == 0.0 && settings[settingsOffset + 12u] == 0.0;","// Ground length of the step from a cell in this row to the neighbor at (columnOffset, rowOffset).","fn getStepDistance(row: i32, columnOffset: i32, rowOffset: i32) -> f32 {","  let columnStep = f32(columnOffset);","  let rowStep = f32(rowOffset);","  var worldStep = vec2<f32>(","    settings[settingsOffset + 0u] * columnStep + settings[settingsOffset + 1u] * rowStep,","    settings[settingsOffset + 2u] * columnStep + settings[settingsOffset + 3u] * rowStep","  ","  return length(worldStep);","// Cost of stepping from the neighbor to this cell: movement energy plus averaged friction.","fn getTransitionCost(","  elevation: f32,","  friction: f32,","  neighborElevation: f32,","  neighborFriction: f32,","  groundDistance: f32",") -> f32 {","  let rise = elevation - neighborElevation;","  let slope = rise / groundDistance;","  let energy = groundDistance * 0.6 * exp(3.5 * abs(slope + 0.05));","  return energy + settings[settingsOffset + 6u] * 0.5 * (friction + neighborFriction) * groundDistance;","  _ = &previous;","  _ = &next;","  _ = &settings;","  _ = &roundSlot;","  let elevation = surface[surfaceOffset + index * 2u];","  let friction = surface[surfaceOffset + index * 2u + 1u];","  let original = previous[previousOffset + index];","  var best = original;","  if (isFiniteValue(elevation) && parametersMatchModel()) {","    let column = i32(index % WIDTH);","    let row = i32(index / WIDTH);","    for (var rowOffset = -1; rowOffset <= 1; rowOffset++) {","      for (var columnOffset = -1; columnOffset <= 1; columnOffset++) {","        if (columnOffset == 0 && rowOffset == 0) { continue; }","        let neighborColumn = column + columnOffset;","        let neighborRow = row + rowOffset;","        if (neighborColumn < 0 || neighborRow < 0 || neighborColumn >= i32(WIDTH) || neighborRow >= i32(HEIGHT)) { continue; }","        let neighbor = u32(neighborRow) * WIDTH + u32(neighborColumn);","        let neighborElevation = surface[surfaceOffset + neighbor * 2u];","        if (!isFiniteValue(neighborElevation)) { continue; }","        let groundDistance = getStepDistance(row, columnOffset, rowOffset);","        if (groundDistance <= 0.0) { continue; }","        let cost = getTransitionCost(","          elevation,","          friction,","          neighborElevation,","          surface[surfaceOffset + neighbor * 2u + 1u],","          groundDistance","        );","        if (cost >= 0.0 && isFiniteValue(cost)) {","          best = min(best, previous[previousOffset + neighbor] + cost);","        }","      }","    }","  next[nextOffset + index] = best;","  if (best < original) { atomicOr(&status[statusOffset], 1u << roundSlot[roundSlotOffset]); }","const groupSizeOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> groupSize: array<u32>;","  _ = &groupSize;","  if (status[statusOffset + 1u] == 0u) { return; }","  let changedBits = status[statusOffset + 0u];","  let size = groupSize[groupSizeOffset];","  var executed = size;","  var converged = false;","  for (var round = 0u; round < size; round++) {","    if (((changedBits >> round) & 1u) == 0u) {","      executed = round + 1u;","      converged = true;","      break;","  let iterationCount = status[statusOffset + 2u] + executed;","  status[statusOffset + 2u] = iterationCount;","  if (converged) {","    status[statusOffset + 1u] = 0u;","    status[statusOffset + 3u] = 1u;","    dispatch[dispatchOffset + 0u] = 0u;","  if (iterationCount >= 13u) {","@group(0) @binding(0) var<storage, read> previous: array<f32>;","@group(0) @binding(1) var<storage, read> surface: array<f32>;","const costsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> costs: array<f32>;","const validityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> validity: array<u32>;","  _ = &costs;","  _ = &validity;","  // The current iterate is always published; status.converged says whether it is final.","  let valid = isFiniteValue(surface[surfaceOffset + index * 2u]);","  costs[costsOffset + index] = select(","    previous[previousOffset + index],","  validity[validityOffset + index] = u32(valid);","@group(0) @binding(0) var<storage, read> status: array<u32>;","const convergedOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> converged: array<u32>;","  _ = &converge