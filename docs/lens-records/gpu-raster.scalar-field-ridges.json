nterior rows 1 through 5","role":"output","highlight":{"key":24,"label":"half-cell tie selects column 3"},"keySpace":"cells","geometry":{"kind":"raster","shape":[7,7],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-raster-scalar-field-ridges-snapshots-ridgeValidity-0","name":"ridgeValidity","iteration":0,"elementType":"u32","values":"b64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABAAAAAQAAAAEAAAABAAAAAQAAAAAAAAAAAAAAAQAAAAEAAAABAAAAAQAAAAEAAAAAAAAAAAAAAAEAAAABAAAAAQAAAAEAAAABAAAAAAAAAAAAAAABAAAAAQAAAAEAAAAAAAAAAAAAAAAAAAAAAAAAAQAAAAEAAAABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==","provenance":"gpu-readback","graph":"gpu-raster-scalar-field-ridges-compiled","resource":"ridgeValidity","meaning":"finite interior stencils without a missing sample","role":"intermediate","keySpace":"cells","geometry":{"kind":"raster","shape":[7,7],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-raster-scalar-field-ridges-snapshots-ridgeStrength-0","name":"ridgeStrength","iteration":0,"elementType":"f32","values":"b64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABAAAAAQAAAAEAAAABAAAAAQAAAAAAAAAAAAAAAQAAAAEAAAABAAAAAQAAAAEAAAAAAAAAAAAAAAEAAAABAAAAAQAAAAEAAAABAAAAAAAAAAAAAAABAAAAAQAAAAEAAAAAAAAAAAAAAAAAAAAAAAAAAQAAAAEAAAABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==","provenance":"gpu-readback","graph":"gpu-raster-scalar-field-ridges-compiled","resource":"ridgeStrength","meaning":"downward normal curvature: 2 at every valid stencil","role":"intermediate","keySpace":"cells","geometry":{"kind":"raster","shape":[7,7],"coordinateModel":"projected","cellSize":1,"unit":"m"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const valuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> values: array<f32>;","const inputValidityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> inputValidity: array<u32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","const ridgesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> ridges: array<u32>;","const validityOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> validity: array<u32>;","const strengthOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> strength: array<f32>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","struct SmallestSymmetricEigen2 {","  value: f32,","  vector: vec2<f32>,","}","fn getSmallestSymmetricEigen2(first: f32, cross: f32, second: f32) -> SmallestSymmetricEigen2 {","  if (cross == 0.0) {","    return SmallestSymmetricEigen2(min(first, second),","      select(vec2<f32>(1.0, 0.0), vec2<f32>(0.0, 1.0), second < first));","  }","  let exponent = frexp(max(abs(first), max(abs(cross), abs(second)))).exp;","  let scaledFirst = ldexp(first, -exponent);","  let scaledSecond = ldexp(second, -exponent);","  let scaledCross = abs(ldexp(cross, -exponent));","  let halfGap = 0.5 * abs(scaledFirst - scaledSecond);","  var tangent = 1.0;","  if (halfGap > 0.0) {","    // Either the gap or coupling is large enough to square safely. If the gap is zero,","    // the tangent is exactly one, including when scaledCross underflows.","    let radius = length(vec2<f32>(halfGap, scaledCross));","    tangent = scaledCross / (halfGap + radius);","  let correction = abs(cross) * tangent;","  let crossSign = select(-1.0, 1.0, cross > 0.0);","  let direction = select(vec2<f32>(1.0, -crossSign * tangent),","    vec2<f32>(tangent, -crossSign), second < first);","  return SmallestSymmetricEigen2(min(first, second) - correction,","    direction / sqrt(1.0 + tangent * tangent));","fn getScaledQuotient(value: f32, first: f32, second: f32, power: i32) -> f32 {","  if (value == 0.0) { return value; }","  let numerator = frexp(value);","  let firstDivisor = frexp(first);","  let secondDivisor = frexp(second);","  let quotient = frexp(numerator.fract / (firstDivisor.fract * secondDivisor.fract));","  return ldexp(quotient.fract,","    numerator.exp - firstDivisor.exp - secondDivisor.exp + power + quotient.exp);","const WIDTH: u32 = 7u;","const HEIGHT: u32 = 7u;","fn getGroundCellSize(row: u32) -> vec2<f32> {","  let cellSize = vec2<f32>(parameters[parametersOffset + 0u], parameters[parametersOffset + 1u]);","  return cellSize;","fn readValue(column: u32, row: u32) -> f32 { return values[valuesOffset + row * WIDTH + column]; }","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &inputValidity;","  _ = &parameters;","  _ = &ridges;","  _ = &validity;","  _ = &strength;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  ","  let column = index % WIDTH;","  let row = index / WIDTH;","  ridges[ridgesOffset + index] = 0u;","  validity[validityOffset + index] = 0u;","  strength[strengthOffset + index] = 0.0;","  if (column == 0u || row == 0u || column + 1u == WIDTH || row + 1u == HEIGHT) { return; }","  for (var rowOffset = -1; rowOffset <= 1; rowOffset++) {","    for (var columnOffset = -1; columnOffset <= 1; columnOffset++) {","      let neighbor = u32(i32(row) + rowOffset) * WIDTH + u32(i32(column) + columnOffset);","      if (inputValidity[inputValidityOffset + neighbor] == 0u || !isFiniteValue(values[valuesOffset + neighbor])) { return; }","    }","  let spacing = getGroundCellSize(row);","  if (!all(spacing > vec2<f32>(0.0)) || !isFiniteValue(spacing.x) || !isFiniteValue(spacing.y)) { return; }","  let center = readValue(column, row);","  let west = readValue(column - 1u, row);","  let east = readValue(column + 1u, row);","  let previousRow = readValue(column, row - 1u);","  let nextRow = readValue(column, row + 1u);","  let gradient = vec2<f32>(getScaledQuotient(east - west, spacing.x, 1.0, -1),","    getScaledQuotient(nextRow - previousRow, spacing.y, 1.0, -1));","  let columnCurvature = getScaledQuotient((east - center) + (west - center), spacing.x, spacing.x, 0);","  let rowCurvature = getScaledQuotient((nextRow - center) + (previousRow - center), spacing.y, spacing.y, 0);","  let crossCurvature = getScaledQuotient((readValue(column + 1u, row + 1u) - readValue(column - 1u, row + 1u)) -","    (readValue(column + 1u, row - 1u) - readValue(column - 1u, row - 1u)), spacing.x, spacing.y, -2);","  if (!isFiniteValue(columnCurvature) || !isFiniteValue(rowCurvature) ||","      !isFiniteValue(crossCurvature) || !isFiniteValue(gradient.x) || !isFiniteValue(gradient.y)) { return; }","  // Keep the smaller diagonal in its original units: a common Hessian scale can underflow","  // it even when the final eigenvalue is normal. Only the bounded eigenvector tangent is scaled.","  let eigensystem = getSmallestSymmetricEigen2(columnCurvature, crossCurvature, rowCurvature);","  let smallest = eigensystem.value;","  if (!isFiniteValue(smallest)) { return; }","  validity[validityOffset + index] = 1u;","  strength[strengthOffset + index] = max(0.0, -smallest);","  if (!(smallest < 0.0) || -smallest < parameters[parametersOffset + 5u] || center < parameters[parametersOffset + 4u]) { return; }","  var normal = eigensystem.vector;","  if (normal.x < 0.0 || (normal.x == 0.0 && normal.y < 0.0)) { normal = -normal; }","  let displacement = -dot(gradient, normal) / smallest;","  let pixelOffset = displacement * normal / spacing;","  if (all(pixelOffset >= vec2<f32>(-0.5)) && all(pixelOffset < vec2<f32>(0.5))) {","    ridges[ridgesOffset + index] = 1u;"],"strings":["scalar-field-ridges-ridges","gpu-raster-scalar-field-ridges-snapshot-tap","buffer","imported","logical","ridgeMask","ridgeStrength","ridgeValidity","scalarFieldValidity","scalarFieldValues","read","read_write","scalar-field-ridges-parameters","GPUScalarFieldRidges"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[]}}
