ty(index);","    if (slot != 0xffffffffu) { assignment = selection[slot]; }","  assignments[assignmentsOffset + index] = assignment;"],"strings":["bounded-facility-allocation-reduce-0","read","gpu-spatial-analysis-bounded-facility-allocation-snapshot-tap","bounded-facility-allocation-assign","bounded-facility-allocation-choose","buffer","GPUBoundedFacilityAllocation","bounded-facility-allocation-score","bounded-facility-allocation-scores","imported","input-3","input-4","input-5","output-6","output-7","output-8","output-9","read_write","compute","capacities","costs","demand","transient","winner"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:3","~j","~c","~1","f32",0,3],["~:3","~k","~a","~1","f32",0,9],["~:3","~l","~b","~1","f32",0,3],["~:3","~n","~0","~1","u32",0,4]]}}
