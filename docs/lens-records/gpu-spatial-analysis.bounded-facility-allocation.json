 break; }","      rank -= suffixCount;","    }","  }","}","fn chooseFacility(row: u32) -> u32 {","  let weight = demand[demandOffset + row]; var best = 0xffffffffu; var bestCost = infiniteCost();","    let cost = costs[costsOffset + row * FACILITY_COUNT + selection[slot]];","    if (cost >= 0.0 && cost < bestCost && (!CAPACITATED || remaining[slot] >= weight)) { best = slot; bestCost = cost; }","  if (best != 0xffffffffu && CAPACITATED) { remaining[best] -= weight; }","  return best;","fn isFiniteNonnegative(value: f32) -> bool { return value >= 0.0 && (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","var<workgroup> partialMissing: array<u32, 64>;","var<workgroup> partialMaximum: array<f32, 64>;","var<workgroup> partialInvalid: array<u32, 64>;","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &costs;","  _ = &demand;","  _ = &capacities;","  _ = &scores;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  ","  if (localInvocationIndex == 0u && workgroupIndex < 3u) { initializeSubset(workgroupIndex); }","  workgroupBarrier();","  var missing = 0u; var maximum = 0.0; var invalid = 0u;","  if (workgroupIndex < 3u) {","    for (var row = localInvocationIndex; row < DEMAND_COUNT; row += 64u) {","      if (!isFiniteNonnegative(demand[demandOffset + row])) { missing++; invalid = 1u; continue; }","      let slot = chooseFacility(row);","      if (slot == 0xffffffffu) { missing++; continue; }","      maximum = max(maximum, costs[costsOffset + row * FACILITY_COUNT + selection[slot]]);","  partialMissing[localInvocationIndex] = missing;","  partialMaximum[localInvocationIndex] = maximum;","  partialInvalid[localInvocationIndex] = inv