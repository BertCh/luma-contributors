"  if (left.x > right.x || (left.x == right.x && left.y > right.y)) { return 1; }","  _ = &canonical;","  let first = ringOffsets[ringOffsetsOffset + index];","let total = ringOffsets[ringOffsetsOffset + index + 1u] - first;","var closed = 0u;","if (total > 1u && all(point(first) == point(first + total - 1u))) { closed = 1u; }","let length = total - closed;","var bestStart = 0u; var bestReverse = 0u;","for (var candidate = 0u; candidate < length; candidate++) {","  for (var reverse = 0u; reverse < 1u; reverse++) {","    for (var element = 0u; element < length; element++) {","      let left = point(first + (candidate + select(element, length - element, reverse == 1u)) % length);","      let right = point(first + (bestStart + select(element, length - element, bestReverse == 1u)) % length);","      let comparison = comparePoints(left, right);","      if (comparison < 0) { bestStart = candidate; bestReverse = reverse; }","      if (comparison != 0) { break; }","canonical[canonicalOffset + index * 4u] = bestStart;","canonical[canonicalOffset + index * 4u + 1u] = length;","canonical[canonicalOffset + index * 4u + 2u] = bestReverse;","canonical[canonicalOffset + index * 4u + 3u] = closed;","const featureOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> featureOffsets: array<u32>;","@group(0) @binding(4) var<storage, read> canonical: array<u32>;","const outPositionsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> outPositions: array<f32>;","const outRingOffsetsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> outRingOffsets: array<u32>;","const outPolygonOffsetsOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> outPolygonOffsets: array<u32>;","fn canonicalPoint(ring: u32, element: u32) -> vec2f {","  let base = canonicalOffset + ring * 4u;","  let length = canonical[base + 1u];","  let offset = canonical[base] + select(element, length - element, canonical[base + 2u] == 1u);","  return point(ringOffsets[ringOffsetsOffset + ring] + offset % length);","fn compareRings(left: u32, right: u32) -> i32 {","  let leftLength = canonical[canonicalOffset + left * 4u + 1u];","  let rightLength = canonical[canonicalOffset + right * 4u + 1u];","  let leftCount = leftLength + canonical[canonicalOffset + left * 4u + 3u];","  let rightCount = rightLength + canonical[canonicalOffset + right * 4u + 3u];","  if (leftCount != rightCount) { return select(1, -1, leftCount < rightCount); }","  for (var element = 0u; element < min(leftLength, rightLength); element++) {","    let comparison = comparePoints(canonicalPoint(left, element), canonicalPoint(right, element));","    if (comparison != 0) { return comparison; }","  if (leftLength != rightLength) { return select(1, -1, leftLength < rightLength); }","  let leftClosed = canonical[canonicalOffset + left * 4u + 3u];","  let rightClosed = canonical[canonicalOffset + right * 4u + 3u];","  return select(select(1, -1, leftClosed < rightClosed), 0, leftClosed == rightClosed);","fn sortedRing(polygon: u32, slot: u32) -> u32 {","  let first = polygonOffsets[polygonOffsetsOffset + polygon];","  let last = polygonOffsets[polygonOffsetsOffset + polygon + 1u];","  if (slot == 0u) { return first; }","  for (var candidate = first + 1u; candidate < last; candidate++) {","    var rank = 1u;","    for (var other = first + 1u; other < last; other++) {","      let comparison = compareRings(other, candidate);","      if (comparison > 0 || (comparison == 0 && other < candidate)) { rank++; }","    if (rank == slot) { return candidate; }","  return first;","fn comparePolygons(left: u32, right: u32) -> i32 {","  let leftLength = polygonOffsets[polygonOffsetsOffset + left + 1u] - polygonOffsets[polygonOffsetsOffset + left];","  let rightLength = polygonOffsets[polygonOffsetsOffset + right + 1u] - polygonOffsets[polygonOffsetsOffset + right];","  for (var slot = 0u; slot < min(leftLength, rightLength); slot++) {","    let comparison = compareRings(sortedRing(left, s