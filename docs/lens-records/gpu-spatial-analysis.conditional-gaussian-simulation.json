32 = 0u;","@group(0) @binding(2) var<storage, read> queries: array<f32>;","const scratchOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> scratch: array<f32>;","const momentsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> moments: array<f32>;","fn read_positions(row: u32) -> vec2<f32> { return vec2<f32>(positions[positionsOffset + row * 2u + 0u], positions[positionsOffset + row * 2u + 1u]); }","fn read_observations(row: u32) -> vec4<f32> { return vec4<f32>(observations[observationsOffset + row * 4u + 0u], observations[observationsOffset + row * 4u + 1u], observations[observationsOffset + row * 4u + 2u], observations[observationsOffset + row * 4u + 3u]); }","fn read_queries(row: u32) -> vec2<f32> { return vec2<f32>(queries[queriesOffset + row * 2u + 0u], queries[queriesOffset + row * 2u + 1u]); }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn covariance(first: vec2<f32>, second: vec2<f32>) -> f32 {","    let scaled = distance(first, second) / 3.0;","    return 2.0 * (exp(-3.0 * scaled)) + select(0.0, 0.10000000149011612, all(first == second));","  }","fn point(row: u32) -> vec2<f32> { return vec2<f32>(scratch[scratchOffset + 102u + row * 2u], scratch[scratchOffset + 103u + row * 2u]); }","fn factor(row: u32, column: u32) -> f32 { return scratch[scratchOffset + 2u + row * 10u + column]; }","fn writeFactor(row: u32, column: u32, value: f32) { scratch[scratchOffset + 2u + row * 10u + column] = value; }","@compute @workgroup_size(2)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &observations;","  _ = &queries;","  _ = &scratch;","  _ = &moments;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 2147483648u) { return; }","  let index = workgroupIndex * 2u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  ","scratch[scratchOffset] = 1.0; scratch[scratchOffset + 1u] = 0.0;","for (var query = 0u; query < 4u; query++) { moments[momentsOffset + query * 2u] = getNaN(); moments[momentsOffset + query * 2u + 1u] = getNaN(); }","var observedCount = 0u;","for (var sample = 0u; sample < 6u; sample++) {","  let observation = read_observations(sample); if (!(observation.w > 0.0)) { continue; }","  let position = read_positions(sample);","  if (!isFiniteValue(observation.x) || !isFiniteValue(observation.y) || observation.y < 0.0 || !isFiniteValue(position.x) || !isFiniteValue(position.y)) { return; }","  scratch[scratchOffset + 102u + observedCount * 2u] = position.x;","  scratch[scratchOffset + 103u + observedCount * 2u] = position.y;","  let centered = observation.x - 2.0;","  if (!isFiniteValue(centered)) { scratch[scratchOffset] = 2.0; return; }","  scratch[scratchOffset + 122u + observedCount] = centered;","  scratch[scratchOffset + 132u + observedCount] = observation.y;","  observedCount++;","scratch[scratchOffset + 1u] = f32(observedCount);","for (var query = 0u; query < 4u; query++) {","  let position = read_queries(query); if (!isFiniteValue(position.x) || !isFiniteValue(position.y)) { return; }","  let row = observedCount + query;","  scratch[scratchOffset + 102u + row * 2u] = position.x;","  scratch[scratchOffset + 103u + row * 2u] = position.y;","  scratch[scratchOffset + 132u + row] = 0.0;","scratch[scratchOffset] = 0.0;","var<workgroup> failed: atomic<u32>;","@compute @workgroup_size(64)","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","if (localInvocationIndex == 0u) { atomicStore(&failed, select(1u, 0u, scratch[scratchOffset] == 0.0)); }","workg