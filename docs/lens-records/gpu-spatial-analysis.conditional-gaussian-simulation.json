EL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const observationsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> observations: array<f32>;","const queriesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> queries: array<f32>;","const scratchOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> scratch: array<f32>;","const momentsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> moments: array<f32>;","fn read_positions(row: u32) -> vec2<f32> { return vec2<f32>(positions[positionsOffset + row * 2u + 0u], positions[positionsOffset + row * 2u + 1u]); }","fn read_observations(row: u32) -> vec4<f32> { return vec4<f32>(observations[observationsOffset + row * 4u + 0u], observations[observationsOffset + row * 4u + 1u], observations[observationsOffset + row * 4u + 2u], observations[observationsOffset + row * 4u + 3u]); }","fn read_queries(row: u32) -> vec2<f32> { return vec2<f32>(queries[queriesOffset + row * 2u + 0u], queries[queriesOffset + row * 2u + 1u]); }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn covariance(first: vec2<f32>, second: vec2<f32>) -> f32 {","    let scaled = distance(first, second) / 3.0;","    ","    return 2.0 * (exp(-3.0 * scaled)) + select(0.0, 0.10000000149011612, all(first == second));","  }","fn point(row: u32) -> vec2<f32> { return vec2<f32>(scratch[scratchOffset + 102u + row * 2u], scratch[scratchOffset + 103u + row * 2u]); }","fn factor(row: u32, column: u32) -> f32 { return scratch[scratchOffset + 2u + row * 10u + column]; }","fn writeFactor(row: u32, column: u32, value: f32) { scratch[scratchOffset + 2u + row * 10u + column] = value; }","@compute @workgroup_size(2)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &observations;","  _ = &queries;","  _ = &scratch;","  _ = &moments;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 2147483648u) { return; }","  let index = workgroupIndex * 2u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  ","scratch[scratchOffset] = 1.0; scratch[scratchOffset + 1u] = 0.0;","for (var query = 0u; query < 4u; query++) { moments[momentsOffset + query * 2u] = getNaN(); moments[momentsOffset + query * 2u + 1u] = getNaN(); }","var observedCount = 0u;","for (var sample = 0u; sample < 6u; sample++) {","  let observation = read_observations(sample); if (!(observation.w > 0.0)) { continue; }","  let position = read_positions(sample);","  if (!isFiniteValue(observation.x) || !isFiniteValue(observation.y) || observation.y < 0.0 || !isFiniteValue(position.x) || !isFiniteValue(position.y)) { return; }","  scratch[scratchOffset + 102u + observedCount * 2u] = position.x;","  scratch[scratchOffset + 103u + observedCount * 2u] = position.y;","  let centered = observation.x - 2.0;","  if (!isFiniteValue(centered)) { scratch[scratchOffset] = 2.0; return; }","  scratch[scratchOffset + 122u + observedCount] = centered;","  scratch[scratchOffset + 132u + observedCount] = observation.y;","  observedCount++;","scratch[scratchOffset + 1u] = f32(observedCount);","for (var query = 0u; query < 4u; query++) {","  let position = read_queries(query); if (!isFiniteValue(position.x) || !isFiniteValue(position.y)) { return; }","  let row = observedCount + query;","  scratch[scratchOffset + 102u + row * 2u] = position.x;","  scratch[scratchOffset + 103u + row * 2u] = position.y;","  scratch[scratchOffset + 132u + row] = 0.0;","scratch[scratchOffset] = 0.0;","var<workgroup> failed: atomic<u32>;","@compute @workgroup_size(64)","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","if (localInvocationIndex == 0u) { atomicStore(&failed, select(1u, 0u, scratch[scratchOffset] == 0.0)); }","workgroupBarrier();","let observedCount = u32(scratch[scratchOffset + 1u]);","let size = observedCount + 4u;","let tolerance = 0.000002100000074278796;","// Every lane reaches every barrier, including inactive rows and failed factorizations.","for (var column = 0u; column < 10u; column++) {","  if (localInvocationIndex == 0u && column < size && atomicLoad(&failed) == 0u) {","    var value = covariance(point(column), point(column)) + scratch[scratchOffset + 132u + column];","    for (var component = 0u; component < column; component++) { let loading = factor(column, component); value -= loading * loading; }","    if (!isFiniteValue(value) || value < -tolerance || (column < observedCount && value <= tolerance)) { atomicStore(&failed, 1u); }","    else { writeFactor(column, column, sqrt(max(value, 0.0))); }","  storageBarrier();","  workgroupBarrier();","  if (atomicLoad(&failed) == 0u) {","    for (var row = column + 1u + localInvocationIndex; row < size; row += 64u) {","      var value = covariance(point(row), point(column));","      for (var component = 0u; component < column; component++) { value -= factor(row, component) * factor(column, component); }","      let diagonal = factor(column, column);","      if (diagonal == 0.0) {","        if (abs(value) > tolerance) { atomicStore(&failed, 1u); }","        else { writeFactor(row, column, 0.0); }","      } else {","        let loading = value / diagonal;","        if (!isFiniteValue(loading)) { atomicStore(&failed, 1u); }","        else { writeFactor(row, column, loading); }","      }","    }","  // Storage factors and the workgroup failure flag have separate memory classes.","if (localInvocationIndex == 0u && atomicLoad(&failed) != 0u && scratch[scratchOffset] == 0.0) {","  scratch[scratchOffset] = 2.0;","if (scratch[scratchOffset] != 0.0) { return; }","scratch[scratchOffset] = 2.0;","for (var row = 0u; row < observedCount; row++) {","  var value = scratch[scratchOffset + 122u + row];","  for (var column = 0u; column < row; column++) { value -= factor(row, column) * scratch[scratchOffset + 142u + column]; }","  let whitened = value / factor(row, row);","  if (!isFiniteValue(whitened)) { return; }","  scratch[scratchOffset + 142u + row] = whitened;","var expectations: array<f32, 4>;","var variances: array<f32, 4>;","  let row = observedCount + query; var expectation = 2.0; var variance = 0.0;","  for (var column = 0u; column < observedCount; column++) { expectation += factor(row, column) * scratch[scratchOffset + 142u + column]; }","  for (var component = 0u; component <= query; component++) { let loading = factor(row, observedCount + component); variance += loading * loading; }","  if (!isFiniteValue(expectation) || !isFiniteValue(variance)) { return; }","  expectations[query] = expectation; variances[query] = variance;","  moments[momentsOffset + query * 2u] = expectations[query]; moments[momentsOffset + query * 2u + 1u] = variances[query];","@group(0) @binding(0) var<storage, read> scratch: array<f32>;","@group(0) @binding(1) var<storage, read> moments: array<f32>;","const valuesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> values: array<f32>;","const statusesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> statuses: array<u32>;","fn philoxMulHiLo(a: u32, b: u32) -> vec2<u32> {","  let aLow = a & 0xffffu;","  let aHigh = a >> 16u;","  let bLow = b & 0xffffu;","  let bHigh = b >> 16u;","  let lowLow = aLow * bLow;","  let highLow = aHigh * bLow;","  let lowHigh = aLow * bHigh;","  let highHigh = aHigh * bHigh;","  let middle = (lowLow >> 16u) + (highLow & 0xffffu) + (lowHigh & 0xffffu);","  let high = highHigh + (highLow >> 16u) + (lowHigh >> 16u) + (middle >> 16u);","  return vec2<u32>(high, a * b);","fn philoxRound(counter: vec4<u32>, key: vec2<u32>) -> vec4<u32> {","  let product0 = philoxMulHiLo(3528531795u, counter.x);","  let product1 = philoxMulHiLo(3449720151u, counter.z);","  return vec4<u32>(","    product1.x ^ counter.y ^ key.x,","    product1.y,","    product0.x ^ counter.w ^ key.y,","    product0.y","  );","fn philox4x32(counterIn: vec4<u32>, keyIn: vec2<u32>) -> vec4<u32> {","  var counter = counterIn;","  var key = keyIn;","  for (var roundIndex = 0u; roundIndex < 9u; roundIndex = roundIndex + 1u) {","    counter = philoxRound(counter, key);","    key = key + vec2<u32>(2654435769u, 3144134277u);","  return philoxRound(counter, key);","fn philoxUnitFloat(word: u32) -> f32 {","  return f32(word >> 8u) * (1.0 / 16777216.0);","// Uniform in the open interval (0, 1), for log() and inverse-CDF draws. The top 23 bits plus one","// half are exact in f32, so the result lies in [2^-24, 1 - 2^-24] and neither end is reachable.","// (The 24-bit form (f32(word >> 8u) + 0.5) / 16777216.0 rounds to exactly 1.0 for the largest word.)","fn philoxOpenUnitFloat(word: u32) -> f32 {","  return (f32(word >> 9u) + 0.5) * (1.0 / 8388608.0);","@compute @workgroup_size(32)","  _ = &values;","  _ = &statuses;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","statuses[statusesOffset + index] = u32(scratch[scratchOffset]);","if (scratch[scratchOffset] != 0.0) {","  for (var query = 0u; query < 4u; query++) { values[valuesOffset + index * 4u + query] = getNaN(); }","  return;","var normal: array<f32, 4>;","  let random = philox4x32(vec4<u32>(index + 0u, query, 0u, 0u), vec2<u32>(347u, 1128747849u));","  // Box-Muller. The radius uniform is open, (0, 1): the 24-bit form rounds to exactly 1.0 for the","  // largest word, which made that draw exactly zero. The blocked path draws the same way.","  normal[query] = sqrt(-2.0 * log(philoxOpenUnitFloat(random.x))) * cos(6.28318530718 * (f32(random.y >> 8u) + 0.5) / 16777216.0);","  var realization = moments[momentsOffset + query * 2u];","  for (var component = 0u; component <= query; component++) { realization += scratch[scratchOffset + 2u + (observedCount + query) * 10u + observedCount + component] * normal[component]; }","  values[valuesOffset + index * 4u + query] = realization;","  if (!isFiniteValue(realization)) { statuses[statusesOffset + index] = 2u; }","if (statuses[statusesOffset + index] != 0u) {","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index * 1u];"],"strings":["moments","conditional-gaussian-simulation-factor","gpu-spatial-analysis-conditional-gaussian-simulation-snapshot-tap","read","observations","positions","queries","conditional-gaussian-simulation","values","buffer","conditional-gaussian-simulation-prepare-conditioning","read_write","GPUConditionalGaussianSimulation","logical","conditional-gaussian-simulation-conditional-moments","statuses","conditional-gaussian-simulation-cooperative-factor","predictions","capture-predictions","compute","transient","scratch","imported","InterpolationLensPredictionCapture","sample-values"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","bindingByteOffset","bindingByteLength","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["operation","commandCount","maximumWorkgroupCount","maximumInvoca