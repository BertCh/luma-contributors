ow; column++) { value -= factor(row, column) * scratch[scratchOffset + 142u + column]; }","  let whitened = value / factor(row, row);","  if (!isFiniteValue(whitened)) { return; }","  scratch[scratchOffset + 142u + row] = whitened;","var expectations: array<f32, 4>;","var variances: array<f32, 4>;","  let row = observedCount + query; var expectation = 2.0; var variance = 0.0;","  for (var column = 0u; column < observedCount; column++) { expectation += factor(row, column) * scratch[scratchOffset + 142u + column]; }","  for (var component = 0u; component <= query; component++) { let loading = factor(row, observedCount + component); variance += loading * loading; }","  if (!isFiniteValue(expectation) || !isFiniteValue(variance)) { return; }","  expectations[query] = expectation; variances[query] = variance;","  moments[momentsOffset + query * 2u] = expectations[query]; moments[momentsOffset + query * 2u + 1u] = variances[query];","@group(0) @binding(0) var<storage, read> scratch: array<f32>;","@group(0) @binding(1) var<storage, read> moments: array<f32>;","const valuesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> values: array<f32>;","const statusesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> statuses: array<u32>;","fn philoxMulHiLo(a: u32, b: u32) -> vec2<u32> {","  let aLow = a & 0xffffu;","  let aHigh = a >> 16u;","  let bLow = b & 0xffffu;","  let bHigh = b >> 16u;","  let lowLow = aLow * bLow;","  let highLow = aHigh * bLow;","  let lowHigh = aLow * bHigh;","  let highHigh = aHigh * bHigh;","  let middle = (lowLow >> 16u) + (highLow & 0xffffu) + (lowHigh & 0xffffu);","  let high = highHigh + (highLow >> 16u) + (lowHigh >> 16u) + (middle >> 16u);","  return vec2<u32>(high, a * b);","fn philoxRound(counter: vec4<u32>, key: vec2<u32>) -> vec4<u32> {","  let product0 = philoxMulHiLo(3528531795u, counter.x);","  let product1 = philoxMulHiLo(3449720151u, counter.z);","  return vec4<u32>(","    product1.x ^ counter.y ^ key.x,","    product1.y,","    product0.x ^ counter.w ^ key.y,","    product0.y","  );","fn philox4x32(counterIn: vec4<u32>, keyIn: vec2<u32>) -> vec4<u32> {","  var counter = counterIn;","  var key = keyIn;","  for (var roundIndex = 0u; roundIndex < 9u; roundIndex = roundIndex + 1u) {","    counter = philoxRound(counter, key);","    key = key + vec2<u32>(2654435769u, 3144134277u);","  return philoxRound(counter, key);","fn philoxUnitFloat(word: u32) -> f32 {","  return f32(word >> 8u) * (1.0 / 16777216.0);","@compute @workgroup_size(32)","  _ = &values;","  _ = &statuses;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","statuses[statusesOffset + index] = u32(scratch[scratchOffset]);","if (scratch[scratchOffset] != 0.0) {","  for (var query = 0u; query < 4u; query++) { values[valuesOffset + index * 4u + query] = getNaN(); }","  return;","var normal: array<f32, 4>;","  let random = philox4x32(vec4<u32>(index + 0u, query, 0u, 0u), vec2<u32>(347u, 1128747849u));","  normal[query] = sqrt(-2.0 * log((f32(random.x >> 8u) + 0.5) / 16777216.0)) * cos(6.28318530718 * (f32(random.y >> 8u) + 0.5) / 16777216.0);","  var realization = moments[momentsOffset + query * 2u];","  for (var component = 0u; component <= query; component++) { realization += scratch[scratchOffset + 2u + (observedCount + query) * 10u + observedCount + component] * normal[component]; }","  values[valuesOffset + index * 4u + query] = realization;","  if (!isFiniteValue(realization)) { statuses[statusesOffset + index] = 2u; }","if (statuses[statusesOffset + index] != 0u) {","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index * 1u];"],"strings":["moments","conditional-gaussian-simulation-factor",