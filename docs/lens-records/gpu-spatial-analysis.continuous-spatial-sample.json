-continuous-spatial-sample-snapshots-provenance-0","name":"provenance","iteration":0,"elementType":"u32","values":"b64:AQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAQAAAAAAAAABAAAAAAAAAAMAAAAAAAAAAQAAAAAAAAAEAAAAAAAAAAEAAAABAAAAAAAAAAEAAAAAAAAAAQAAAAEAAAABAAAAAQAAAAEAAAADAAAAAQAAAAEAAAABAAAABAAAAAEAAAA=","provenance":"gpu-readback","graph":"gpu-spatial-analysis-continuous-spatial-sample-compiled","resource":"provenance","meaning":"gpu-spatial-analysis-continuous-spatial-sample-snapshot-tap","components":4,"role":"output","keySpace":"entry","valueCount":32},{"id":"gpu-spatial-analysis-continuous-spatial-sample-snapshots-status-0","name":"status","iteration":0,"elementType":"u32","values":"b64:BAAAAAQAAAAEAAAAAAAAAAQAAAAEAAAABAAAAAAAAAA=","provenance":"gpu-readback","graph":"gpu-spatial-analysis-continuous-spatial-sample-compiled","resource":"status","meaning":"gpu-spatial-analysis-continuous-spatial-sample-snapshot-tap","components":4,"role":"output","keySpace":"entry","valueCount":8}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const framePositionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> framePositions: array<f32>;","const positionsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> positions: array<f32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> weights: array<f32>;","const provenanceOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> provenance: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","fn philoxMulHiLo(a: u32, b: u32) -> vec2<u32> {","  let aLow = a & 0xffffu;","  let aHigh = a >> 16u;","  let bLow = b & 0xffffu;","  let bHigh = b >> 16u;","  let lowLow = aLow * bLow;","  let highLow = aHigh * bLow;","  let lowHigh = aLow * bHigh;","  let highHigh = aHigh * bHigh;","  let middle = (lowLow >> 16u) + (highLow & 0xffffu) + (lowHigh & 0xffffu);","  let high = highHigh + (highLow >> 16u) + (lowHigh >> 16u) + (middle >> 16u);","  return vec2<u32>(high, a * b);","}","fn philoxRound(counter: vec4<u32>, key: vec2<u32>) -> vec4<u32> {","  let product0 = philoxMulHiLo(3528531795u, counter.x);","  let product1 = philoxMulHiLo(3449720151u, counter.z);","  return vec4<u32>(","    product1.x ^ counter.y ^ key.x,","    product1.y,","    product0.x ^ counter.w ^ key.y,","    product0.y","  );","fn philox4x32(counterIn: vec4<u32>, keyIn: vec2<u32>) -> vec4<u32> {","  var counter = counterIn;","  var key = keyIn;","  for (var roundIndex = 0u; roundIndex < 9u; roundIndex = roundIndex + 1u) {","    counter = philoxRound(counter, key);","    key = key + vec2<u32>(2654435769u, 3144134277u);","  }","  return philoxRound(counter, key);","fn philoxUnitFloat(word: u32) -> f32 {","  return f32(word >> 8u) * (1.0 / 16777216.0);","// Uniform in the open interval (0, 1), for log() and inverse-CDF draws. The top 23 bits plus one","// half are exact in f32, so the result lies in [2^-24, 1 - 2^-24] and neither end is reachable.","// (The 24-bit form (f32(word >> 8u) + 0.5) / 16777216.0 rounds to exactly 1.0 for the largest word.)","fn philoxOpenUnitFloat(word: u32) -> f32 {","  return (f32(word >> 9u) + 0.5) * (1.0 / 8388608.0);","const SAMPLE_SPACING: f32 = 0.5;","const SAMPLE_CAPACITY: u32 = 4u;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn samplePosition(row:u32)->vec2f{let offset=framePositionsOffset+2u*row;return vec2f(framePositions[offset],framePositions[offset+1u]);}","fn sampleCross(first:vec2f,second:vec2f)->f32{return first.x*second.y-first.y*second.x;}","fn samplePrimitive(point:vec2f)->u32 {","for(var triangle=0u;triangle<2u;triangle++){"," let first=samplePosition(triangle*3u);let second=samplePosition(triangle*3u+1u);let third=samplePosition(triangle*3u+2u);"," let orientation=sign(sampleCross(second-first,third-first));"," if(sampleCross(second-first,point-first)*orientation>=0.0&&sampleCross(third-second,point-second)*orientation>=0.0&&sampleCross(first-third,point-third)*orientation>=0.0){return triangle;}"," return 0xffffffffu;","fn sampleLine(measure:f32)->vec3f {"," var consumed=0.0;"," for(var segment=0u;segment<5u;segment++){","  let first=samplePosition(segment);let second=samplePosition(segment+1u);let extent=distance(first,second);","  if(extent>0.0&&measure<=consumed+extent){return vec3f(mix(first,second,clamp((measure-consumed)/extent,0.0,1.0)),f32(segment));}consumed+=extent;"," }"," return vec3f(samplePosition(5u),f32(4u));","fn sampleWrite(wave:u32,slot:u32,point:vec2f,weight:f32,source:u32,replicate:u32,ordinal:u32,role:u32){"," if(slot>=SAMPLE_CAPACITY){return;}let row=wave*SAMPLE_CAPACITY+slot;"," positions[positionsOffset+row*2u]=point.x;positions[positionsOffset+row*2u+1u]=point.y;weights[weightsOffset+row]=weight;"," provenance[provenanceOffset+row*4u]=source;provenance[provenanceOffset+row*4u+1u]=replicate;provenance[provenanceOffset+row*4u+2u]=ordinal;provenance[provenanceOffset+row*4u+3u]=role;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &framePositions;","  _ = &positions;","  _ = &weights;","  _ = &provenance;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var failure=0u;var required=0u;var randomAccepted=0u;var measure=0.0;","let seed=43u;let initialReplicate=0u;","if(initialReplicate>0xffffffffu-index){failure=1u;}","let replicate=initialReplicate+index;","let words=philox4x32(vec4u(replicate,0u,0u,0u),vec2u(seed,1129534288u));","let phase=vec2f(philoxUnitFloat(words.x),philoxUnitFloat(words.y))*SAMPLE_SPACING;","for(var vertex=0u;vertex<6u;vertex++){"," let point=samplePosition(vertex);if(!isFiniteValue(point.x)||!isFiniteValue(point.y)||max(abs(point.x),abs(point.y))*0.00000095367431640625>SAMPLE_SPACING){failure=1u;}"," if(any(point<vec2f(0.0,0.0))||any(point>vec2f(1.0,1.0))){failure=1u;}","for(var triangle=0u;triangle<2u;triangle++){let first=samplePosition(triangle*3u);let determinant=sampleCross(samplePosition(triangle*3u+1u)-first,samplePosition(triangle*3u+2u)-first);if(!isFiniteValue(determinant)||determinant==0.0){failure=1u;}}","if(failure==0u){"," "," var candidate=0u;"," loop {","  if(candidate>=9u){break;}","  if(candidate>=65536u){failure|=4u;break;}","  let point=vec2f(0.0,0.0)+phase+vec2f(f32(candidate%3u),f32(candidate/3u))*SAMPLE_SPACING;"," let source=samplePrimitive(point);var accepted=source!=0xffffffffu&&all(point<vec2f(1.0,1.0));","  if(accepted){sampleWrite(index,required,point,0.25,source,replicate,candidate,select(1u,0u,index==0u));required++;randomAccepted++;}","  candidate++;","if(required>SAMPLE_CAPACITY){failure|=2u;}","let written=min(required,SAMPLE_CAPACITY);","for(var slot=written;slot<SAMPLE_CAPACITY;slot++){sampleWrite(index,slot,vec2f(0.0),0.0,0xffffffffu,replicate,0xffffffffu,0xffffffffu);}","status[statusOffset+index*4u]=written;status[statusOffset+index*4u+1u]=required;status[statusOffset+index*4u+2u]=randomAccepted;status[statusOffset+index*4u+3u]=failure;"],"strings":["continuous-spatial-sample","gpu-spatial-analysis-continuous-spatial-sample-snapshot-tap","positions","provenance","status","designWeights","buffer","imported","logical","frame","read_write","GPUContinuousSpatialSample"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KER