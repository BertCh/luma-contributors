texIndex);","    if (any((bitcast<vec2u>(current) & vec2u(0x7f800000u)) == vec2u(0x7f800000u))) { flags |= 8u; }","    let tangent = next - current;","    for (var otherVertexIndex = 0u; otherVertexIndex < count; otherVertexIndex++) {","      // The edge endpoints are on its own supporting line by definition. With","      // slanted float32 edges, recomputing that cross product can round slightly","      // negative and falsely reject an otherwise strictly convex polygon.","      if (otherVertexIndex == vertex || otherVertexIndex == nextVertexIndex) { continue; }","      if (cross(tangent, point(first + otherVertexIndex) - current) * orientation < 0.0) { flags |= 1u; }","    }","    let following = point(first + (vertex + 2u) % count) - next;","    if (cross(tangent, following) * orientation <= 0.0) { flags |= 1u; }","    let normal = orientation * vec2f(-tangent.y, tangent.x) / length(tangent);","    edges[vertex] = vec3f(normal, dot(normal, current)); edgeIds[vertex] = first + vertex; births[vertex] = current;","var time = 0.0; var iterations = 0u;","loop {","  if (flags != 0u || count < 3u) { break; }","  var eventTimes: array<f32, MAXIMUM_VERTICES>;","  var eventPositions: array<vec2f, MAXIMUM_VERTICES>;","  var nextTime = 3.0e38;","    let previous = (vertex + count - 1u) % count; let next = (vertex + 1u) % count;","    let currentPoint = intersection(edges[previous], edges[vertex], time);","    let nextPoint = intersection(edges[vertex], edges[next], time);","    let currentVelocity = intersection(vec3f(edges[previous].xy, 0.0), vec3f(edges[vertex].xy, 0.0), 1.0);","    let nextVelocity = intersection(vec3f(edges[vertex].xy, 0.0), vec3f(edges[next].xy, 0.0), 1.0);","    let tangent = orientation * vec2f(edges[vertex].y, -edges[vertex].x);","    let shrinkRate = dot(nextVelocity - currentVelocity, tangent);","    eventTimes[vertex] = 3.0e38;","    if (shrinkRate < 0.0) { eventTimes[vertex] = max(time, time - dot(nextPoint - currentPoint, tangent) / shrinkRate); }","    nextTime = min(nextTime, eventTimes[vertex]);","  if (nextTime == 3.0e38) { flags |= 8u; break; }","  if (!offsetWritten && REQUESTED_DISTANCE < nextTime) {","    offsetCount = count; offsetWritten = true;","    for (var vertex = 0u; vertex < count; vertex++) {","      let current = intersection(edges[(vertex + count - 1u) % count], edges[vertex], REQUESTED_DISTANCE);","      let destination = (index * MAXIMUM_VERTICES + vertex) * 2u;","      offsetPositions[offsetPositionsOffset + destination] = current.x; offsetPositions[offsetPositionsOffset + destination + 1u] = current.y;","  if (iterations >= 8u) { flags |= 4u; break; }","  let epsilon = EVENT_TOLERANCE * max(1.0, abs(nextTime));","  var removed: array<u32, MAXIMUM_VERTICES>; var survivors = 0u;","    removed[vertex] = select(0u, 1u, eventTimes[vertex] <= nextTime + epsilon);","    if (removed[vertex] == 0u) { survivors++; }","    eventPositions[vertex] = intersection(edges[(vertex + count - 1u) % count], edges[vertex], nextTime);","    let previous = (vertex + count - 1u) % count;","    if (removed[previous] != 0u || removed[vertex] != 0u || survivors < 3u) {","      if (distance(births[vertex], eventPositions[vertex]) > epsilon) {","        writeArc(index, required, births[vertex], eventPositions[vertex], edgeIds[previous], edgeIds[vertex]); required++;","      }","  if (survivors < 3u) {","    // Simultaneous opposing collapses leave a terminal ridge (e.g. a rectangle).","    var left = eventPositions[0]; var right = left; var longest = 0.0;","      for (var other = vertex + 1u; other < count; other++) {","        let separation = distance(eventPositions[vertex], eventPositions[other]);","        if (separation > longest) { longest = separation; left = eventPositions[vertex]; right = eventPositions[other]; }","    if (longest > epsilon) { writeArc(index, required, left, right, 0xffffffffu, 0xffffffffu); required++; }","    count = 0u; time = nextTime; break;","  var retained: array<u32, MAXIMUM_VERTICES>; var kept = 0u;","  for (var vertex = 0u; vertex < count; vertex++) { if (removed[vertex] == 0u) { retained[kept] = vertex; kept++; } }","  // Event positions are no longer needed after arc emission. Reuse them for the next","  // births before compacting edges in place; ascending retained IDs never read an overwritten edge.","  for (var vertex = 0u; vertex < survivors; vertex++) {","    let current = retained[vertex]; let previous = retained[(vertex + survivors - 1u) % survivors];","    if ((previous + 1u) % count == current) { eventPositions[vertex] = births[current]; }","    else { eventPositions[vertex] = intersection(edges[previous], edges[current], nextTime); }","    edges[vertex] = edges[retained[vertex]]; edgeIds[vertex] = edgeIds[retained[vertex]]; births[vertex] = eventPositions[vertex];","  count = survivors; time = nextTime; iterations++;","if (required > SEGMENT_CAPACITY) { flags |= 2u; }","status[statusOffset + index * 4u] = min(required, SEGMENT_CAPACITY); status[statusOffset + index * 4u + 1u] = required;","status[statusOffset + index * 4u + 2u] = offsetCount; status[statusOffset + index * 4u + 3u] = flags;"],"strings":["convex-straight-skeleton-events","gpu-spatial-analysis-convex-straight-skeleton-snapshot-tap","segments","status","buffer","imported","offset-positions","source-edges","positions","read_write","ring-offsets","GPUConvexStraightSkeleton","read"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","k