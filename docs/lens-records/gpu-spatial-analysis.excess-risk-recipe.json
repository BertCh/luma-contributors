is-excess-risk-recipe-snapshots-populations-0","name":"populations","iteration":0,"elementType":"f32","values":"b64:AADIQgAAoEEAAMhC","provenance":"gpu-readback","graph":"gpu-spatial-analysis-excess-risk-recipe-compiled","resource":"populations","meaning":"gpu-spatial-analysis-excess-risk-recipe-snapshot-tap","role":"input","valueCount":3},{"id":"gpu-spatial-analysis-excess-risk-recipe-snapshots-rates-0","name":"rates","iteration":0,"elementType":"f32","values":"b64:AACwPwEAMD8AADA/","provenance":"gpu-readback","graph":"gpu-spatial-analysis-excess-risk-recipe-compiled","resource":"rates","meaning":"Dimensionless pooled excess risk","role":"output","valueCount":3}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const eventsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> events: array<f32>;","const populationsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> populations: array<f32>;","const partialsAOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> partialsA: array<f32>;","const countPartialsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> countPartials: array<u32>;","const ROWS: u32 = 3u;","const LANES: u32 = 256u;","const GROUPS: u32 = 1u;","fn isFiniteFloat(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn addUint64(left: vec2<u32>, right: vec2<u32>) -> vec2<u32> {","  let low = left.y + right.y;","  return vec2<u32>(left.x + right.x + select(0u, 1u, low < left.y), low);","}","fn subtractUint64(left: vec2<u32>, right: vec2<u32>) -> vec2<u32> {","  return vec2<u32>(left.x - right.x - select(0u, 1u, left.y < right.y), left.y - right.y);","fn negateInt64(value: vec2<u32>) -> vec2<u32> {","  return subtractUint64(vec2<u32>(0u, 0u), value);","fn compareUint64(left: vec2<u32>, right: vec2<u32>) -> i32 {","  if (left.x != right.x) {","    return select(-1i, 1i, left.x > right.x);","  }","  if (left.y != right.y) {","    return select(-1i, 1i, left.y > right.y);","  return 0i;","fn isLessUint64(left: vec2<u32>, right: vec2<u32>) -> bool {","  return left.x < right.x || (left.x == right.x && left.y < right.y);","fn isLessOrEqualUint64(left: vec2<u32>, right: vec2<u32>) -> bool {","  return left.x < right.x || (left.x == right.x && left.y <= right.y);","// Signed order: flipping the sign bit of the high words makes them compare as unsigned.","fn compareInt64(left: vec2<u32>, right: vec2<u32>) -> i32 {","  return compareUint64(vec2<u32>(left.x ^ 0x80000000u, left.y), vec2<u32>(right.x ^ 0x80000000u, right.y));","fn shiftLeftUint64(value: vec2<u32>, bits: u32) -> vec2<u32> {","  if (bits == 0u) {","    return value;","  if (bits >= 64u) {","    return vec2<u32>(0u, 0u);","  if (bits >= 32u) {","    return vec2<u32>(value.y << (bits - 32u), 0u);","  return vec2<u32>((value.x << bits) | (value.y >> (32u - bits)), value.y << bits);","fn shiftRightUint64(value: vec2<u32>, bits: u32) -> vec2<u32> {","    return vec2<u32>(0u, value.x >> (bits - 32u));","  return vec2<u32>(value.x >> bits, (value.y >> bits) | (value.x << (32u - bits)));","// Exact 32 x 32 -> 64 bit product from 16-bit limbs; no partial sum exceeds 2^32.","fn multiplyUint32Wide(left: u32, right: u32) -> vec2<u32> {","  let leftLow = left & 0xffffu;","  let leftHigh = left >> 16u;","  let rightLow = right & 0xffffu;","  let rightHigh = right >> 16u;","  let lowLow = leftLow * rightLow;","  let lowHigh = leftLow * rightHigh;","  let highLow = leftHigh * rightLow;","  let middle = (lowLow >> 16u) + (lowHigh & 0xffffu) + (highLow & 0xffffu);","  return vec2<u32>(","    leftHigh * rightHigh + (lowHigh >> 16u) + (highLow >> 16u) + (middle >> 16u),","    (lowLow & 0xffffu) | (middle << 16u)","  );","fn multiplyUint64ByUint32(left: vec2<u32>, right: u32) -> vec2<u32> {","  let wide = multiplyUint32Wide(left.y, right);","  return vec2<u32>(wide.x + left.x * right, wide.y);","fn multiplyUint64(left: vec2<u32>, right: vec2<u32>) -> vec2<u32> {","  let wide = multiplyUint32Wide(left.y, right.y);","  return vec2<u32>(wide.x + left.y * right.x + left.x * right.y, wide.y);","struct Uint64Division {","  quotient: vec2<u32>,","  remainder: u32,","// Restoring division one bit at a time. The running remainder stays below the divisor, so after a","// shift it is below 2^33; the bit shifted out of the u32 is carried in overflowBit.","fn divideUint64ByUint32(value: vec2<u32>, divisor: u32) -> Uint64Division {","  if (divisor == 0u) {","    return Uint64Division(vec2<u32>(0xffffffffu, 0xffffffffu), 0u);","  var quotient = vec2<u32>(0u, 0u);","  var remainder = 0u;","  for (var bit = 0u; bit < 64u; bit++) {","    let position = 63u - bit;","    let word = select(value.y, value.x, position >= 32u);","    let incoming = (word >> (position & 31u)) & 1u;","    let overflowBit = remainder >> 31u;","    remainder = (remainder << 1u) | incoming;","    if (overflowBit != 0u || remainder >= divisor) {","      remainder = remainder - divisor;","      if (position >= 32u) {","        quotient.x = quotient.x | (1u << (position - 32u));","      } else {","        quotient.y = quotient.y | (1u << position);","      }","    }","  return Uint64Division(quotient, remainder);","fn uint64ToFloat(value: vec2<u32>) -> f32 {","  return f32(value.x) * 4294967296.0 + f32(value.y);","fn int64ToFloat(value: vec2<u32>) -> f32 {","  if ((value.x & 0x80000000u) != 0u) {","    return -uint64ToFloat(negateInt64(value));","  return uint64ToFloat(value);","fn roundSpatialCountValue(magnitude: vec2<u32>, exponentScale: i32, negative: u32, sticky: bool) -> f32 {","  let bitLength = select(32u - countLeadingZeros(magnitude.y), 64u - countLeadingZeros(magnitude.x), magnitude.x != 0u);","  if (bitLength == 0u) { return bitcast<f32>(negative); }","  let subnormal = exponentScale + i32(bitLength) - 1i < -126i;","  let shift = select(i32(bitLength) - 24i, -149i - exponentScale, subnormal);","  if (shift >= 64i) { return bitcast<f32>(negative); }","  var rounded = 0u;","  if (shift <= 0i) {","    rounded = shiftLeftUint64(magnitude, u32(-shift)).y;","  } else {","    let quotient = shiftRightUint64(magnitude, u32(shift));","    let discarded = subtractUint64(magnitude, shiftLeftUint64(quotient, u32(shift)));","    let halfway = shiftLeftUint64(vec2<u32>(0u, 1u), u32(shift - 1i));","    let comparison = compareUint64(discarded, halfway);","    rounded = quotient.y + u32(comparison > 0i || (comparison == 0i && (sticky || (quotient.y & 1u) != 0u)));","  if (subnormal) { return bitcast<f32>(negative | rounded); }","  var exponent = exponentScale + shift + 150i;","  if (rounded >= 0x1000000u) { rounded = rounded >> 1u; exponent++; }","  if (exponent >= 255i) { return bitcast<f32>(negative | 0x7f800000u); }","  return bitcast<f32>(negative | (u32(exponent) << 23u) | (rounded & 0x7fffffu));","fn divideBySpatialCount(value: f32, count: u32) -> f32 {","  if (count <= 16777216u) { return value / f32(count); }","  let bits = bitcast<u32>(value);","  let exponent = (bits >> 23u) & 255u;","  let significand = (bits & 0x7fffffu) | select(0u, 0x800000u, exponent != 0u);","  if (exponent == 255u || significand == 0u) { return value; }","  let division = divideUint64ByUint32(vec2<u32>(significand, 0u), count);","  var quotient = division.quotient;","  // With no discarded integer bits, the division remainder supplies the rounding decision.","  if (quotient.x == 0u && quotient.y < 0x1000000u && exponent > 32u) {","    let complement = count - division.remainder;","    quotient.y += u32(division.remainder > complement ||","      (division.remainder == complement && (quotient.y & 1u) != 0u));","  return roundSpatialCountValue(quotient, i32(max(exponent, 1u)) - 182i,","    bits & 0x80000000u, division.remainder != 0u && !(quotient.y <= 0x1000000u && exponent > 32u));","fn multiplyBySpatialCount(value: f32, count: u32) -> f32 {","  if (count <= 16777216u) { return value * f32(count); }","  return roundSpatialCountValue(multiplyUint32Wide(significand, count), i32(max(exponent, 1u)) - 150i,","    bits & 0x80000000u, false);","fn divideSpatialCountByValue(count: u32, value: f32) -> f32 {","  if (count <= 16777216u) { return f32(count) / value; }","  let fraction = bits & 0x7fffffu;","  let negative = bits & 0x80000000u;","  if (exponent == 255u) { return select(bitcast<f32>(negative), value, fraction != 0u); }","  let significand = fraction | select(0u, 0x800000u, exponent != 0u);","  if (significand == 0u) { return bitcast<f32>(negative | 0x7f800000u); }","  let division = divideUint64ByUint32(vec2<u32>(count, 0u), significand);","  return roundSpatialCountValue(division.quotient, 118i - i32(max(exponent, 1u)),","    negative, division.remainder != 0u);","fn divideSpatialCounts(numerator: u32, denominator: u32) -> f32 {","  if (numerator <= 16777216u && denominator <= 16777216u) { return f32(numerator) / f32(denominator); }","  if (numerator == 0u) { return 0.0; }","  let shift = 31u + countLeadingZeros(numerator);","  let division = divideUint64ByUint32(shiftLeftUint64(vec2<u32>(0u, numerator), shift), denominator);","  return roundSpatialCountValue(division.quotient, -i32(shift), 0u, division.remainder != 0u);","// A runtime operand keeps the quiet-NaN bit pattern out of constant evaluation.","fn getQuietNaN(seed: u32) -> f32 { return bitcast<f32>(0x7fc00000u | (seed & 0u)); }","// Two-sided normal p-value erfc(|z| / sqrt(2)) through the shared erfcValue (Numerical Recipes","// erfcc Chebyshev fit, fractional error below 1.2e-7), so tiny p-values keep relative accuracy.","fn erfcValue(x: f32) -> f32 {","  let z = abs(x);","  let t = 1.0 / (1.0 + 0.5 * z);","  let r = t * exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 +","    t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 +","    t * (-0.82215223 + t * 0.17087277)))))))));","  return select(2.0 - r, r, x >= 0.0);","// Floor of every analytic (normal) p-value: the smallest normal f32. f32 exp underflows beyond","// |z| of about 13, where erfc would read exactly 0; a floor keeps such p-values positive, so they","// stay ordered against larger ones in a multiple-testing correction and safe under log(). One","// rule for the global, local, hot-spot and emerging-hot-spot statistics.","const ANALYTIC_P_VALUE_FLOOR: f32 = 1.17549435e-38;","fn getTwoSidedPValue(z: f32) -> f32 {","  return clamp(erfcValue(abs(z) * 0.70710678118654752), ANALYTIC_P_VALUE_FLOOR, 1.0);","var<workgroup> scratch: array<f32, 256>;","// Fixed-order tree sum of one value per lane. Every lane of the workgroup must call it together.","fn reduceSum(value: f32, lane: u32) -> f32 {","  workgroupBarrier();","  scratch[lane] = value;","  for (var stride = LANES / 2u; stride > 0u; stride = stride / 2u) {","    if (lane < stride) {","      scratch[lane] += scratch[lane + stride];","    workgroupBarrier();","  return scratch[0];","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &events;","  _ = &populations;","  _ = &partialsA;","  _ = &countPartials;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  if (INVOCATION_COUNT == 0u) { return; }","if (workgroupIndex >= (INVOCATION_COUNT - 1u) / 256u + 1u) { return; }","let lane = localInvocationIndex;","  let group = (index - lane) / LANES;","  var e = 0.0;","  var b = 0.0;","  var included = false;","  if (index < ROWS) {","    e = events[eventsOffset + index];","    b = populations[populationsOffset + index];","    included = isFiniteFloat(e) && e >= 0.0 && isFiniteFloat(b) && b > 0.0;","  let count = reduceSum(select(0.0, 1.0, included), lane);","  let eventSum = reduceSum(select(0.0, e, included), lane);","  let populationSum = reduceSum(select(0.0, b, included), lane);","  if (lane == 0u) {","    countPartials[countPartialsOffset + group] = u32(count);","    partialsA[partialsAOffset + group] = count;","    partialsA[partialsAOffset + GROUPS + group] = eventSum;","    partialsA[partialsAOffset + 2u * GROUPS + group] = populationSum;","@group(0) @binding(0) var<storage, read> partialsA: array<f32>;","const totalsAOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> totalsA: array<f32>;","  _ = &totalsA;","  let column = index / LANES;","  var sum = 0.0;","  for (var group = lane; group < GROUPS; group += LANES) {","    sum += partialsA[partialsAOffset + column * GROUPS + group];","  let total = reduceSum(sum, lane);","    totalsA[totalsAOffset + column] = total;","@group(0) @binding(2) var<storage, read> totalsA: array<f32>;","const partialsBOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> partialsB: array<f32>;","  _ = &partialsB;","  let pooledRate = totalsA[totalsAOffset + 1u] / totalsA[totalsAOffset + 2u];","  let deviation = e / b - pooledRate;","  let total = reduceSum(select(0.0, b * deviation * deviation, included), lane);","    partialsB[partialsBOffset + group] = total;","@group(0) @binding(0) var<storage, read> totalsA: array<f32>;","const exactCountOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> exactCount: array<u32>;","@group(0) @binding(2) var<storage, read> partialsB: array<f32>;","const summaryOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> summary: array<f32>;","  _ = &exactCount;","  _ = &summary;","    sum += partialsB[partialsBOffset + group];","  let deviationSum = reduceSum(sum, lane);","    let count = exactCount[exactCountOffset];","    let eventSum = totalsA[totalsAOffset + 1u];","    let populationSum = totalsA[totalsAOffset + 2u];","    let pooledRate = eventSum / populationSum;","    let weightedVariance = deviationSum / populationSum;","    summary[summaryOffset + 0u] = f32(count);","    summary[summaryOffset + 1u] = eventSum;","    summary[summaryOffset + 2u] = populationSum;","    summary[summaryOffset + 3u] = pooledRate;","    summary[summaryOffset + 4u] = weightedVariance;","    let priorVariance = weightedVariance - pooledRate / (divideBySpatialCount(populationSum, count));","    summary[summaryOffset + 5u] = priorVariance;","    summary[summaryOffset + 6u] = max(priorVariance, 0.0);","    for (var field = 7u; field < 8u; field++) {","      summary[summaryOffset + field] = 0.0;","@group(0) @binding(2) var<storage, read> summary: array<f32>;","const excessRiskOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> excessRisk: array<f32>;","@compute @workgroup_size(32)","  _ = &excessRisk;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let e = events[eventsOffset + index];","  let b = populations[populationsOffset + index];","  let nan = getQuietNaN(index);","  if (!(isFiniteFloat(e) && e >= 0.0 && isFiniteFloat(b) && b > 0.0)) {","    excessRisk[excessRiskOffset + index] = nan;","  let pooledRate = summary[summaryOffset + 3u];","  let priorVariance = summary[summaryOffset + 5u];","  let rate = e / b;","  let noise = pooledRate / b;","  let rawVariance = priorVariance + noise;","  let variance = select(rawVariance, noise, rawVariance < 0.0);","  let standardized = (rate - pooledRate) / sqrt(variance);","  let clampedVariance = summary[summaryOffset + 6u];","  let clampedDenominator = clampedVariance + noise;","  let weight = select(0.0, clampedVariance / clampedDenominator, clampedDenominator > 0.0);","  let smoothed = weight * rate + (1.0 - weight) * pooledRate;","  excessRisk[excessRiskOffset + index] = select(nan, e / (b * pooledRate), b * pooledRate > 0.0);","@group(0) @binding(0) var<storage, read> excessRisk: array<f32>;","const invalidValuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> invalidValues: array<u32>;","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","  _ = &invalidValues;","invalidValues[invalidValuesOffset + index] = u32(!isFiniteBits(excessRisk[excessRiskOffset + index]));"],"strings":["excess-risk-summary","excess-risk-totals-a","excess-risk-partials-a","buffer","read","excess-risk-partials-b","events","populations","GPUEmpiricalBayesRates","compute","logical","rates","excess-risk-rates","read_write","transient","excess-risk-count-partials","excess-risk-exact-count-finalize","excess-risk-exact-count-level-0","excess-risk-invalid-rows-invalid-sum-finalize","excess-risk-invalid-rows-invalid-sum-level-0","excess-risk-invalid-rows-invalid-values","gpu-spatial-analysis-excess-risk-recipe-snapshot-tap","excess-risk-count","excess-risk-invalid-rows","excess-risk-exact-count-level-0-values","excess-risk-invalid-rows-invalid-sum-level-0-values","imported","lower-bound","summary","totalsA","unknown","addExcessRiskRecipe","excess-risk-invalid","excessRisk","partialsA","partialsB"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","bindingByteOffset","bindingByteLength","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes",