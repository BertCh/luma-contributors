0,13,0,0,14,0,15,0,0,[16,2],0,[18,8],0,0,[26,2],25,0,[28,5],31,[33,7],25,0,114,[41,6],93,115,[48,4],[116,4],38,[120,5],119,38,[125,12],25]}]},"decisions":[],"choices":[],"captures":{"schema":"luma.computation-captures/1","runId":"run-da55d177","snapshots":[{"id":"gpu-spatial-analysis-excess-risk-recipe-snapshots-events-0","name":"events","iteration":0,"elementType":"f32","values":"b64:AACgQQAAAEAAACBB","provenance":"gpu-readback","graph":"gpu-spatial-analysis-excess-risk-recipe-compiled","resource":"events","afterNode":"excess-risk-rates","role":"input"},{"id":"gpu-spatial-analysis-excess-risk-recipe-snapshots-populations-0","name":"populations","iteration":0,"elementType":"f32","values":"b64:AADIQgAAoEEAAMhC","provenance":"gpu-readback","graph":"gpu-spatial-analysis-excess-risk-recipe-compiled","resource":"populations","afterNode":"excess-risk-rates","role":"input"},{"id":"gpu-spatial-analysis-excess-risk-recipe-snapshots-rates-0","name":"rates","iteration":0,"elementType":"f32","values":"b64:AACwPwEAMD8AADA/","provenance":"gpu-readback","graph":"gpu-spatial-analysis-excess-risk-recipe-compiled","resource":"rates","afterNode":"excess-risk-rates","role":"output","meaning":"Dimensionless pooled excess risk"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const eventsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> events: array<f32>;","const populationsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> populations: array<f32>;","const partialsAOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> partialsA: array<f32>;","const ROWS: u32 = 3u;","const LANES: u32 = 256u;","const GROUPS: u32 = 1u;","fn isFiniteFloat(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// A runtime operand keeps the quiet-NaN bit pattern out of constant evaluation.","fn getQuietNaN(seed: u32) -> f32 { return bitcast<f32>(0x7fc00000u | (seed & 0u)); }","// Two-sided normal p-value erfc(|z| / sqrt(2)) through the shared erfcValue (Numerical Recipes","// erfcc Chebyshev fit, fractional error below 1.2e-7), so tiny p-values keep relative accuracy.","fn erfcValue(x: f32) -> f32 {","  let z = abs(x);","  let t = 1.0 / (1.0 + 0.5 * z);","  let r = t * exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 +","    t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 +","    t * (-0.82215223 + t * 0.17087277)))))))));","  return select(2.0 - r, r, x >= 0.0);","}","fn getTwoSidedPValue(z: f32) -> f32 {","  return min(erfcValue(abs(z) * 0.70710678118654752), 1.0);","var<workgroup> scratch: array<f32, 256>;","// Fixed-order tree sum of one value per lane. Every lane of the workgroup must call it together.","fn reduceSum(value: f32, lane: u32) -> f32 {","  workgroupBarrier();","  scratch[lane] = value;","  for (var stride = LANES / 2u; stride > 0u; stride = stride / 2u) {","    if (lane < stride) {","      scratch[lane] += scratch[lane + stride];","    }","    workgroupBarrier();","  }","  return scratch[0];","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &events;","  _ = &populations;","  _ = &partialsA;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  let lane = localInvocationIndex;","  let group = (index - lane) / LANES;","  var e = 0.0;","  var b = 0.0;","  var included = false;","  if (index < ROWS) {","    e = events[eventsOffset + index];","    b = populations[populationsOffset + index];","    included = isFiniteFloat(e) && isFiniteFloat(b) && b > 0.0;","  let count = reduceSum(select(0.0, 1.0, included), lane);","  let eventSum = reduceSum(select(0.0, e, included), lane);","  let populationSum = reduceSum(select(0.0, b, included), lane);","  if (lane == 0u) {","    partialsA[partialsAOffset + group] = count;","    partialsA[partialsAOffset + GROUPS + group] = eventSum;","    partialsA[partialsAOffset + 2u * GROUPS + group] = populationSum;","@group(0) @binding(0) var<storage, read> partialsA: array<f32>;","const totalsAOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> totalsA: array<f32>;","  _ = &totalsA;","  let column = index / LANES;","  var sum = 0.0;","  for (var group = lane; group < GROUPS; group += LANES) {","    sum += partialsA[partialsAOffset + column * GROUPS + group];","  let total = reduceSum(sum, lane);","    totalsA[totalsAOffset + column] = total;","@group(0) @binding(2) var<storage, read> totalsA: array<f32>;","const partialsBOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> partialsB: array<f32>;","  _ = &partialsB;","  let pooledRate = totalsA[totalsAOffset + 1u] / totalsA[totalsAOffset + 2u];","  let deviation = e / b - pooledRate;","  let total = reduceSum(select(0.0, b * deviation * deviation, included), lane);","    partialsB[partialsBOffset + group] = total;","@group(0) @binding(0) var<storage, read> totalsA: array<f32>;","@group(0) @binding(1) var<storage, read> partialsB: array<f32>;","const summaryOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> summary: array<f32>;","  _ = &summary;","    sum += partialsB[partialsBOffset + group];","  let deviationSum = reduceSum(sum, lane);","    let count = totalsA[totalsAOffset];","    let eventSum = totalsA[totalsAOffset + 1u];","    let populationSum = totalsA[totalsAOffset + 2u];","    let pooledRate = eventSum / populationSum;","    let weightedVariance = deviationSum / populationSum;","    summary[summaryOffset + 0u] = count;","    summary[summaryOffset + 1u] = eventSum;","    summary[summaryOffset + 2u] = populationSum;","    summary[summaryOffset + 3u] = pooledRate;","    summary[summaryOffset + 4u] = weightedVariance;","    let priorVariance = weightedVariance - pooledRate / (populationSum / count);","    summary[summaryOffset + 5u] = priorVariance;","    summary[summaryOffset + 6u] = max(priorVariance, 0.0);","    for (var field = 7u; field < 8u; field++) {","      summary[summaryOffset + field] = 0.0;","@group(0) @binding(2) var<storage, read> summary: array<f32>;","const excessRiskOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> excessRisk: array<f32>;","@compute @workgroup_size(32)","  _ = &excessRisk;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let e = events[eventsOffset + index];","  let b = populations[populationsOffset + index];","  let nan = getQuietNaN(index);","  if (!(isFiniteFloat(e) && isFiniteFloat(b) && b > 0.0)) {","    excessRisk[excessRiskOffset + index] = nan;","  let pooledRate = summary[summaryOffset + 3u];","  let priorVariance = summary[summaryOffset + 5u];","  let rate = e / b;","  let noise = pooledRate / b;","  let rawVariance = priorVariance + noise;","  let variance = select(rawVariance, noise, rawVariance < 0.0);","  let standardized = (rate - pooledRate) / sqrt(variance);","  let clampedVariance = summary[summaryOffset + 6u];","  let clampedDenominator = clampedVariance + noise;","  let weight = select(0.0, clampedVariance / clampedDenominator, clampedDenominator > 0.0);","  let smoothed = weight * rate + (1.0 - weight) * pooledRate;","  excessRisk[excessRiskOffset + index] = select(nan, e / (b * pooledRate), b * pooledRate > 0.0);"],"strings":["excess-risk-totals-a","excess-risk-summary","excess-risk-partials-a","excess-risk-partials-b","read","GPUEmpiricalBayesRates","events","populations","excess-risk-rates","buffer","compute","excess-risk","rates","read_write","transient","imported","summary","tot