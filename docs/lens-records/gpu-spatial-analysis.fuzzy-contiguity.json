sis-fuzzy-contiguity-snapshot-tap","role":"output"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const featuresOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> features: array<u32>;","const polygonsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> polygons: array<u32>;","const ringsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> rings: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","const featureMinimaOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> featureMinima: array<f32>;","const featureMaximaOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> featureMaxima: array<f32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","fn position(vertex:u32)->vec2<f32>{return vec2<f32>(positions[positionsOffset+vertex*2u],positions[positionsOffset+vertex*2u+1u]);}","fn cross(first:vec2<f32>,second:vec2<f32>)->f32{return first.x*second.y-first.y*second.x;}","fn pointDistance(point:vec2<f32>,first:vec2<f32>,second:vec2<f32>)->f32{let direction=second-first;let square=dot(direction,direction);var fraction=0.0;if(square>0.0){fraction=clamp(dot(point-first,direction)/square,0.0,1.0);}return distance(point,first+fraction*direction);}","fn segmentDistance(first:vec2<f32>,second:vec2<f32>,third:vec2<f32>,fourth:vec2<f32>)->f32{"," let direction=second-first;let other=fourth-third;let determinant=cross(direction,other);"," if(determinant!=0.0){let firstFraction=cross(third-first,other)/determinant;let secondFraction=cross(third-first,direction)/determinant;if(firstFraction>=0.0&&firstFraction<=1.0&&secondFraction>=0.0&&secondFraction<=1.0){return 0.0;}}"," return min(min(pointDistance(first,third,fourth),pointDistance(second,third,fourth)),min(pointDistance(third,first,second),pointDistance(fourth,first,second)));","fn contains(feature:u32,point:vec2<f32>)->bool{"," for(var polygon=features[featuresOffset+feature];polygon<features[featuresOffset+feature+1u];polygon++){var inside=false;"," for(var ring=polygons[polygonsOffset+polygon];ring<polygons[polygonsOffset+polygon+1u];ring++){let begin=rings[ringsOffset+ring];let end=rings[ringsOffset+ring+1u];for(var vertex=begin;vertex<end;vertex++){let next=select(vertex+1u,begin,vertex+1u==end);let first=position(vertex);let second=position(next);if((first.y>point.y)!=(second.y>point.y)){let intersection=first.x+(point.y-first.y)*(second.x-first.x)/(second.y-first.y);if(point.x<intersection){inside=!inside;}}}}"," if(inside){return true;}}"," return false;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &features;","  _ = &polygons;","  _ = &rings;","  _ = &status;","  _ = &featureMinima;","  _ = &featureMaxima;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let first=features[featuresOffset+index];let last=features[featuresOffset+index+1u];var code=0u;","if(first>last||last>=5u){code=2u;}else if(first==last){code=1u;}else{","for(var polygon=first;polygon<last;polygon++){let firstRing=polygons[polygonsOffset+polygon];let lastRing=polygons[polygonsOffset+polygon+1u];if(firstRing>=lastRing||lastRing>=5u){code=2u;break;}","for(var ring=firstRing;ring<lastRing;ring++){let begin=rings[ringsOffset+ring];let end=rings[ringsOffset+ring+1u];if(begin>end||end>16u||end-begin<3u){code=2u;break;}for(var vertex=begin;vertex<end;vertex++){let value=position(vertex);if(!isFiniteBits(value.x)||!isFiniteBits(value.y)){code=2u;break;}}}}","}status[statusOffset+index]=code;","var minimum=vec2<f32>(3.402823e38);var maximum=vec2<f32>(-3.402823e38);","if(code==0u){for(var polygon=first;polygon<last;polygon++){for(var ring=polygons[polygonsOffset+polygon];ring<polygons[polygonsOffset+polygon+1u];ring++){for(var vertex=rings[ringsOffset+ring];vertex<rings[ringsOffset+ring+1u];vertex++){let value=position(vertex);minimum=min(minimum,value);maximum=max(maximum,value);}}}}","featureMinima[featureMinimaOffset+index*2u]=minimum.x;featureMinima[featureMinimaOffset+index*2u+1u]=minimum.y;","featureMaxima[featureMaximaOffset+index*2u]=maximum.x;featureMaxima[featureMaximaOffset+index*2u+1u]=maximum.y;","const pairKeysOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> pairKeys: array<u32>;","  _ = &pairKeys;","  pairKeys[pairKeysOffset+index]=0xffffffffu;","const segmentMinimaOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> segmentMinima: array<f32>;","const segmentMaximaOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> segmentMaxima: array<f32>;","const boundsOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> boundsOut: array<f32>;","const ITEM_COUNT: u32 = 4u;","const FLOAT32_MAXIMUM: f32 = 3.402823466e+38;","const PARTIAL_COUNT: u32 = 1u;","const WORKGROUP_THREADS: u32 = 256u;","const SEGMENT_COUNT: u32 = 4u;","fn readCenter(row: u32) -> vec3f {","  // (center.x, center.y, valid). Skipped segments have inverted bounds.","  let minimum = vec2f(segmentMinima[segmentMinimaOffset + row * 2u], segmentMinima[segmentMinimaOffset + row * 2u + 1u]);","  let maximum = vec2f(segmentMaxima[segmentMaximaOffset + row * 2u], segmentMaxima[segmentMaximaOffset + row * 2u + 1u]);","  let valid = minimum.x <= maximum.x && minimum.y <= maximum.y;","  let center = minimum * 0.5 + maximum * 0.5;","  return vec3f(center, select(0.0, 1.0, valid));","fn readItem(row: u32) -> vec4f {","  let center = readCenter(row);","  return vec4f(center.xy, center.z, 0.0);","var<workgroup> sharedMinima: array<vec2f, 256>;","var<workgroup> sharedMaxima: array<vec2f, 256>;","@compute @workgroup_size(256)","  _ = &segmentMinima;","  _ = &segmentMaxima;","  _ = &boundsOut;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  // Exactly one workgroup is dispatched, so index == localInvocationIndex.","  var localMinimum = vec2f(FLOAT32_MAXIMUM);","  var localMaximum = vec2f(-FLOAT32_MAXIMUM);","  // Grid-stride loop: consecutive threads read consecutive items on every trip.","  for (var row = index; row < ITEM_COUNT; row += PARTIAL_COUNT * WORKGROUP_THREADS) {","    let item = readItem(row);","    if (item.z > 0.5) {","      localMinimum = min(localMinimum, item.xy);","      localMaximum = max(localMaximum, item.xy);","    }","  sharedMinima[localInvocationIndex] = localMinimum;","  sharedMaxima[localInvocationIndex] = localMaximum;","  workgroupBarrier();","  for (var stride = 128u; stride > 0u; stride = stride >> 1u) {","    if (localInvocationIndex < stride) {","      sharedMinima[localInvocationIndex] = min(sharedMinima[localInvocationIndex], sharedMinima[localInvocationIndex + stride]);","      sharedMaxima[localInvocationIndex] = max(sharedMaxima[localInvocationIndex], sharedMaxima[localInvocationIndex + stride]);","    workgroupBarrier();","  if (localInvocationIndex == 0u) {","    let minimum = sharedMinima[0];","    let maximum = sharedMaxima[0];","    let hasValid = minimum.x <= maximum.x && minimum.y <= maximum.y;","    boundsOut[boundsOutOffset] = select(0.0, minimum.x, hasValid);","    boundsOut[boundsOutOffset + 1u] = select(0.0, minimum.y, hasValid);","    boundsOut[boundsOutOffset + 2u] = select(0.0, maximum.x, hasValid);","    boundsOut[boundsOutOffset + 3u] = select(0.0, maximum.y, hasValid);","const sceneBoundsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> sceneBounds: array<f32>;","const sortKeysOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> sortKeys: array<u32>;","const sortRowsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> sortRows: array<u32>;","fn spreadBits(value: u32) -> u32 {","  var x = value & 0xffffu;","  x = (x | (x << 8u)) & 0x00ff00ffu;","  x = (x | (x << 4u)) & 0x0f0f0f0fu;","  x = (x | (x << 2u)) & 0x33333333u;","  x = (x | (x << 1u)) & 0x55555555u;","  return x;","fn quantizeAxis(value: f32, minimum: f32, maximum: f32) -> u32 {","  let extent = maximum - minimum;","  if (!(extent > 0.0) || extent > FLOAT32_MAXIMUM) { return 0u; }","  let normalized = clamp((value - minimum) / extent, 0.0, 1.0);","  return min(u32(normalized * 65535.0 + 0.5), 65535u);","  _ = &sceneBounds;","  _ = &sortKeys;","  _ = &sortRows;","  sortRows[sortRowsOffset + index] = index;","  let center = readCenter(index);","  var key = 0xffffffffu;","  if (center.z > 0.5) {","    let quantizedX = quantizeAxis(center.x, sceneBounds[sceneBoundsOffset], sceneBounds[sceneBoundsOffset + 2u]);","    let quantizedY = quantizeAxis(center.y, sceneBounds[sceneBoundsOffset + 1u], sceneBounds[sceneBoundsOffset + 3u]);","    key = spreadBits(quantizedX) | (spreadBits(quantizedY) << 1u);","  sortKeys[sortKeysOffset + index] = key;","const sortedRowsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> sortedRows: array<u32>;","const sortedMinimaOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> sortedMinima: array<f32>;","const sortedMaximaOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> sortedMaxima: array<f32>;","  _ = &sortedRows;","  _ = &sortedMinima;","  _ = &sortedMaxima;","  let row = min(sortedRows[sortedRowsOffset + index], SEGMENT_COUNT - 1u);","  sortedMinima[sor