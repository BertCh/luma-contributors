=(max(max(abs(boxMinimum.x),abs(boxMinimum.y)),max(abs(boxMaximum.x),abs(boxMaximum.y)))+TOLERANCE)*1.0e-5;","  let queryMinimum=boxMinimum-vec2f(TOLERANCE+slack);let queryMaximum=boxMaximum+vec2f(TOLERANCE+slack);","  var node=0u;","  loop{","   if(nodeOverlaps(node,queryMinimum,queryMaximum)){","    if(node<INTERNAL_NODE_COUNT){node=node*2u+1u;continue;}","    let slot=node-INTERNAL_NODE_COUNT;","    var other=ROWS;if(slot<ROWS){other=leafIds[leafIdsOffset+slot];}","    if(other<ROWS&&other!=index){let distance=getFeatureDistance(index,other);if(distance<=TOLERANCE){count++;}}","   }","   loop{if(node==0u||(node&1u)==1u){break;}node=(node-1u)/2u;}","   if(node==0u){break;}","   node=node+1u;"," }","  counts[countsOffset + index] = count;","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","const totalOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> total: array<u32>;","override ROW_COUNT: u32;","override TOTAL_ROW: u32;","  _ = &offsets;","  _ = &total;","  var sum = 0u;","  if (ROW_COUNT > 0u) {","    sum = offsets[offsetsOffset + ROW_COUNT - 1u] + counts[countsOffset + ROW_COUNT - 1u];","  total[totalOffset + TOTAL_ROW] = sum;","@group(0) @binding(2) var<storage, read_write> total: array<atomic<u32>>;","  let offset = offsets[offsetsOffset + index];","  if (offset + counts[countsOffset + index] < offset) {","    atomicStore(&total[totalOffset + TOTAL_ROW], 4294967295u);","const scanTotalOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> scanTotal: array<u32>;","const startsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> starts: array<u32>;","const outOffsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> outOffsets: array<u32>;","const overflowOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> overflow: array<u32>;","const totalNeighborsOffset: u32 = 0u;","@group(0) @binding(4) va