 -> vec2<u32> {","  let aLow = a & 0xffffu;","  let aHigh = a >> 16u;","  let bLow = b & 0xffffu;","  let bHigh = b >> 16u;","  let lowLow = aLow * bLow;","  let highLow = aHigh * bLow;","  let lowHigh = aLow * bHigh;","  let highHigh = aHigh * bHigh;","  let middle = (lowLow >> 16u) + (highLow & 0xffffu) + (lowHigh & 0xffffu);","  let high = highHigh + (highLow >> 16u) + (lowHigh >> 16u) + (middle >> 16u);","  return vec2<u32>(high, a * b);","fn philoxRound(counter: vec4<u32>, key: vec2<u32>) -> vec4<u32> {","  let product0 = philoxMulHiLo(3528531795u, counter.x);","  let product1 = philoxMulHiLo(3449720151u, counter.z);","  return vec4<u32>(","    product1.x ^ counter.y ^ key.x,","    product1.y,","    product0.x ^ counter.w ^ key.y,","    product0.y","  );","fn philox4x32(counterIn: vec4<u32>, keyIn: vec2<u32>) -> vec4<u32> {","  var counter = counterIn;","  var key = keyIn;","  for (var roundIndex = 0u; roundIndex < 9u; roundIndex = roundIndex + 1u) {","    counter = philoxRound(counter, key);","    key = key + vec2<u32>(2654435769u, 3144134277u);","  return philoxRound(counter, key);","fn philoxUnitFloat(word: u32) -> f32 {","  return f32(word >> 8u) * (1.0 / 16777216.0);","// Uniform in the open interval (0, 1), for log() and inverse-CDF draws. The top 23 bits plus one","// half are exact in f32, so the result lies in [2^-24, 1 - 2^-24] and neither end is reachable.","// (The 24-bit form (f32(word >> 8u) + 0.5) / 16777216.0 rounds to exactly 1.0 for the largest word.)","fn philoxOpenUnitFloat(word: u32) -> f32 {","  return (f32(word >> 9u) + 0.5) * (1.0 / 8388608.0);","fn randomBlock(row: u32, tag: u32) -> vec4<u32> {","  return philox4x32(vec4<u32>(row, bitcast<u32>(params[paramsOffset + 10u]), tag, 0u),","    vec2<u32>(bitcast<u32>(params[paramsOffset + 9u]), 1196574257u));","fn normalPair(words: vec4<u32>) -> vec2<f32> {","  let radius = sqrt(-2.0 * log(philoxOpenUnitFloat(words.x)));","  let angle = 6.283185307179586 * philoxUnitFloat(words.y);","  return radius * vec2<f32>(cos(angle), sin(angle));","@compute @workgroup_size(64)","  _ = &modes;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","// Clear every frame, including when an unused or unrepresentable mode exits early.","let modeOffset = modesOffset + index * 4u;","modes[modeOffset] = 0.0;","modes[modeOffset + 1u] = 0.0;","modes[modeOffset + 2u] = 0.0;","modes[modeOffset + 3u] = 0.0;","if (params[paramsOffset + 6u] == 0.0) { return; }","let words = randomBlock(index, 1u);","let radialUniform = philoxOpenUnitFloat(words.x);","let angle = 6.283185307179586 * philoxUnitFloat(words.y);","let model = u32(params[paramsOffset + 4u]);","var radius = sqrt(-12.0 * log(radialUniform)) / params[paramsOffset + 7u];","if (model != 2u) {","  var smoothness = 0.5;","  var factor = 3.0;","  if (model == 3u) { smoothness = 1.5; factor = 4.749031386012701; }","  if (model == 4u) { smoothness = 2.5; factor = 5.924462618951797; }","  radius = factor * sqrt(pow(radialUniform, -1.0 / smoothness) - 1.0) / params[paramsOffset + 7u];","if (!isFiniteValue(radius)) {","  modes[modeOffset] = getNaN();","  modes[modeOffset + 1u] = getNaN();","  return;","let amplitudes = normalPair(vec4<u32>(words.z, words.w, 0u, 0u));","modes[modesOffset + index * 4u] = radius * cos(angle);","modes[modesOffset + index * 4u + 1u] = radius * sin(angle);","modes[modesOffset + index * 4u + 2u] = amplitudes.x;","modes[modesOffset + index * 4u + 3u] = amplitudes.y;","const massOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> mass: array<f32>;","  _ = &mass;","  mass[massOffset] = 0.0;","@group(0) @binding(1) var<storage, read> modes: array<f32>;","@group(0) @binding(2) var<storage, read> positions: array<f32>;","const fieldOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> field: array<f32>;","  _ = &field;","let position = vec2<f32>(positions[positionsOffset + index * 2u], positions[positionsOffset + index * 2u + 1u]);","if (!isFiniteValue(position.x) || !isFiniteValue(position.y)) {","  field[fieldOffset + index] = getNaN();","var total = 0.0;","if (params[paramsOffset + 6u] > 0.0) {","  for (var mode = 0u; mode < 64u; mode++) {","    let base = modesOffset + mode * 4u;","    let frequency = vec2<f32>(modes[base], modes[base + 1u]);","    if (!isFiniteValue(frequency.x) || !isFiniteValue(frequency.y)) {","      field[fieldOffset + index] = getNaN();","      return;","    }","    let phase = dot(position, frequency);","    if (!isFiniteValue(phase)) {","    total += modes[base + 2u] * cos(phase) + modes[base + 3u] * sin(phase);","let nugget = normalPair(randomBlock(index, 2u)).x * sqrt(params[paramsOffset + 5u]);","field[fieldOffset + index] = params[paramsOffset + 8u] + sqrt(params[paramsOffset + 6u] / 64.0) * total + nugget;","if (params[paramsOffset + 4u] == 0.0) { field[fieldOffset + index] = getNaN(); }","@group(0) @binding(1) var<storage, read> mass: array<f32>;","const approximationOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> approximation: array<u32>;","  _ = &approximation;","  approximation[approximationOffset] = select(0u, 1u, true);","@group(0) @binding(1) var<storage, read> field: array<f32>;","const valuesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> values: array<f32>;","const validityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> validity: array<u32>;","  _ = &values;","  _ = &validity;","var value = getNaN();","if (index < 16u && params[paramsOffset] > 0.0) {","  value = field[fieldOffset + index];","values[valuesOffset + index] = value;","validity[validityOffset + index] = select(0u, 1u, isFiniteValue(value));"],"strings":["parameters","GPUGaussianRandomField","gpu-spatial-analysis-gaussian-random-field-snapshot-tap","read","GPUGaussianRandomField-publish","clippedEigenvalueMass","GPUGaussianRandomField-spectral-field","approximation","buffer","logical","GPUGaussianRandomField-field","GPUGaussianR