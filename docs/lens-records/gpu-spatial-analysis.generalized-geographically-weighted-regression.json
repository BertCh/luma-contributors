L_KERNEL_DISPATCH_Y: u32;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> parameters: array<f32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &source;","  _ = &parameters;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  parameters[parametersOffset] = 4.0; parameters[parametersOffset + 1u] = source[sourceOffset + 1u];","}","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const predictorsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> predictors: array<f32>;","const responseOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> response: array<f32>;","@group(0) @binding(3) var<storage, read> parameters: array<f32>;","const fitsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> fits: array<f32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","const ROW_COUNT: u32 = 6u;","fn getIsBisquare() -> bool { return false; }","fn queryValid(row: u32) -> bool {","  ","  if (!(isFiniteBits(positions[positionsOffset + 2u * row]) && isFiniteBits(positions[positionsOffset + 2u * row + 1u]))) { return false; }","  for (var column = 0u; column < 1u; column++) { if (!isFiniteBits(predictors[predictorsOffset + row * 1u + column])) { return false; } }","  return true;","fn included(row: u32) -> bool {","  if (!isFiniteBits(response[responseOffset + row]) || !(isFiniteBits(positions[positionsOffset + 2u * row]) && isFiniteBits(positions[positionsOffset + 2u * row + 1u]))) { return false; }","fn predictor(row: u32, column: u32) -> f32 {","  if (column == 0u) { return 1.0; }","  return predictors[predictorsOffset + row * 1u + column - 1u];","fn getPosition(row: u32) -> vec2f {","  return vec2f(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","fn getDistance(pointA: vec2f, pointB: vec2f) -> f32 {","  let delta = pointB - pointA;","  return sqrt(dot(delta, delta));","fn getSquaredDistance(pointA: vec2f, pointB: vec2f) -> f32 {","  return dot(delta, delta);","fn getLocalKernelWeight(distance: f32, bandwidth: f32, isBisquare: bool) -> f32 {","  let ratio = distance / bandwidth;","  if (isBisquare) {","    if (distance >= bandwidth) {","      return 0.0;","    }","    let t = 1.0 - ratio * ratio;","    return t * t;","  return exp(-0.5 * ratio * ratio);","fn spatialWeight(focus: u32, row: u32, bandwidth: f32) -> f32 {","  if (focus == row) { return 0.0; }","  return getLocalKernelWeight(getDistance(getPosition(focus), getPosition(row)), bandwidth, getIsBisquare());","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","struct DenseCholesky_2 {","  scale: array<f32, 2>,","  size: u32,","  status: u32,","  smallestPivotRatio: f32,","fn factorDenseCholesky_2(","  matrix: ptr<function, array<f32, 4>>,","  equilibrate: bool,","  minimumPivotRatio: f32",") -> DenseCholesky_2 {","  var result: DenseCholesky_2;","  result.size = min(size, 2u);","  result.status = 0u;","  result.smallestPivotRatio = 1.0;","  let count = result.size;","  for (var row = 0u; row < count; row++) {","    for (var column = 0u; column <= row; column++) {","      if (!isFiniteValue((*matrix)[row * 2u + column])) {","        result.status = 1u;","        return result;","      }","  for (var column = 0u; column < count; column++) {","    let diagonal = (*matrix)[column * 2u + column];","    if (!(diagonal > 0.0)) {","      result.status = 2u;","      return result;","    result.scale[column] = select(1.0, 1.0 / sqrt(diagonal), equilibrate);","  if (equilibrate) {","    for (var row = 0u; row < count; row++) {","      for (var column = 0u; column <= row; column++) {","        (*matrix)[row * 2u + column] = (*matrix)[row * 2u + column] * result.scale[row] * result.scale[column];","    let original = (*matrix)[column * 2u + column];","    var diagonal = original;","    for (var k = 0u; k < column; k++) {","      let value = (*matrix)[column * 2u + k];","      diagonal = diagonal - value * value;","    if (!isFiniteValue(diagonal)) {","      result.status = 1u;","    if (!(diagonal > 0.0) || !(original > 0.0)) {","      result.smallestPivotRatio = 0.0;","    result.smallestPivotRatio = min(result.smallestPivotRatio, diagonal / original);","    let pivot = sqrt(diagonal);","    (*matrix)[column * 2u + column] = pivot;","    for (var row = column + 1u; row < count; row++) {","      var value = (*matrix)[row * 2u + column];","      for (var k = 0u; k < column; k++) {","        value = value - (*matrix)[row * 2u + k] * (*matrix)[column * 2u + k];","      (*matrix)[row * 2u + column] = value / pivot;","  if (result.smallestPivotRatio < minimumPivotRatio) {","    result.status = 3u;","  return result;","fn solveDenseCholesky_2(","  factorization: ptr<function, DenseCholesky_2>,","  vector: ptr<function, array<f32, 2>>",") -> bool {","  let count = (*factorization).size;","    (*vector)[row] = (*vector)[row] * (*factorization).scale[row];","    var value = (*vector)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*matrix)[row * 2u + k] * (*vector)[k];","    (*vector)[row] = value / (*matrix)[row * 2u + row];","  for (var offset = 0u; offset < count; offset++) {","    let row = count - 1u - offset;","    for (var k = row + 1u; k < count; k++) {","      value = value - (*matrix)[k * 2u + row] * (*vector)[k];","  var finite = true;","    finite = finite && isFiniteValue((*vector)[row]);","  return finite;","fn getDenseCholeskyInverseDiagonal_2(","  column: u32",") -> f32 {","  var unit: array<f32, 2>;","  unit[column] = 1.0;","  solveDenseCholesky_2(matrix, factorization, &unit);","  return unit[column];","fn invertDenseCholesky_2(","  inverse: ptr<function, array<f32, 4>>","    var unit: array<f32, 2>;","    unit[column] = 1.0;","    finite = solveDenseCholesky_2(matrix, factorization, &unit) && finite;","      (*inverse)[row * 2u + column] = unit[row];","fn getDenseCholeskyLogDeterminant_2(","  factorization: ptr<function, DenseCholesky_2>","  var total = 0.0;","  for (var row = 0u; row < (*factorization).size; row++) {","    total = total + 2.0 * (log((*matrix)[row * 2u + row]) - log((*factorization).scale[row]));","  return total;","fn choleskyFactor_2(a: ptr<function, array<f32, 4>>) -> bool {","  return factorDenseCholesky_2(a, 2u, false, 0.0).status == 0u;","// The factorization record of a successful unequilibrated factor: unit scale, full size.","fn getCholeskyFactorization_2() -> DenseCholesky_2 {","  return DenseCholesky_2(array<f32, 2>(1.0, 1.0), 2u, 0u, 1.0);","fn choleskySolve_2(a: ptr<function, array<f32, 4>>, b: ptr<function, array<f32, 2>>) {","  var factorization = getCholeskyFactorization_2();","  solveDenseCholesky_2(a, &factorization, b);","fn choleskyInverseDiagonal_2(a: ptr<function, array<f32, 4>>, column: u32) -> f32 {","  return getDenseCholeskyInverseDiagonal_2(a, &factorization, column);","fn factorEquilibrated_2(a: ptr<function, array<f32, 4>>, scale: ptr<function, array<f32, 2>>) -> bool {","  let factorization = factorDenseCholesky_2(a, 2u, true, 9.999999974752427e-7);","  *scale = factorization.scale;","  return factorization.status == 0u;","fn solveEquilibrated_2(a: ptr<function, array<f32, 4>>, scale: ptr<function, array<f32, 2>>, vector: ptr<function, array<f32, 2>>) {","  var factorization = DenseCholesky_2(*scale, 2u, 0u, 1.0);","  solveDenseCholesky_2(a, &factorization, vector);","fn inverseDiagonalEquilibrated_2(a: ptr<function, array<f32, 4>>, scale: ptr<function, array<f32, 2>>, column: u32) -> f32 {","  return choleskyInverseDiagonal_2(a, column) * (*scale)[column] * (*scale)[column];","fn responseValid(row: u32) -> bool {","  let responseValue = response[responseOffset + row];","  return responseValue >= 0.0 && floor(responseValue) == responseValue;","// IRLS runs in a design basis centered on the focal row and scaled by the largest in-bandwidth","// deviation, so large mean-to-spread predictors (years, dollars, projected coordinates) keep the","// information matrix well conditioned in float32. Coefficients are mapped back at the end.","var<private> centerValues: array<f32, 2>;","var<private> scaleValues: array<f32, 2>;","fn designValue(row: u32, column: u32) -> f32 {","  return (predictor(row, column) - centerValues[column]) / scaleValues[column];","fn linearPredictor(row: u32, coefficients: ptr<function, array<f32, 2>>) -> f32 {","  var value = 0.0;","  for (var column = 0u; column < 2u; column++) { value += (*coefficients)[column] * designValue(row, column); }","  return value;","// Symmetric diagonal equilibration of the lower-triangular information, then Cholesky (shared with GWR).","fn factorInformation(information: ptr<function, array<f32, 4>>, equilibration: ptr<function, array<f32, 2>>) -> bool {","  return factorEquilibrated_2(information, equilibration);","fn solveInformation(information: ptr<function, array<f32, 4>>, equilibration: ptr<function, array<f32, 2>>, vector: ptr<function, array<f32, 2>>) {","  solveEquilibrated_2(information, equilibration, vector);","fn meanResponse(linear: f32) -> f32 {","  return exp(linear);","fn logLikelihood(focus: u32, bandwidth: f32, coefficients: ptr<function, array<f32, 2>>) -> f32 {","  var likelihood = 0.0;","  let origin = getPosition(focus);","  {","for (var row = 0u; row < ROW_COUNT; row++) {","    if (!(included(row) && responseValid(row))) {","      continue;","    let weight = spatialWeight(focus, row, bandwidth); if (!(weight > 0.0)) { continue; }","    let linear = linearPredictor(row, coefficients);","    if (!isFiniteBits(linear) || abs(linear) > 30.0) { return getNaN(); }","    let responseValue = response[responseOffset + row];","    likelihood += weight * (responseValue * linear - exp(linear));","  return likelihood;","const FOCAL_START: u32 = 0u;","  _ = &positions;","  _ = &predictors;","  _ = &response;","  _ = &fits;","  let focus = index + FOCAL_START;","let base = fitsOffset + index * 5u;","for (var column = 0u; column < 5u; column++) { fits[base + column] = getNaN(); }","fits[base + 3u] = 1.0; fits[base + 4u] = 0.0;","if (!included(focus) || !responseValid(focus)) { return; }","var bandwidth = parameters[parametersOffset]; let tolerance = parameters[parametersOffset + 1u];","if (!(bandwidth > 0.0) || !isFiniteBits(bandwidth) || !(tolerance > 0.0) || !isFiniteBits(tolerance)) { fits[base + 3u] = 4.0; return; }","if (floor(bandwidth) != bandwidth || bandwidth > 6.0) { fits[base + 3u] = 4.0; return; }","let neighborCount = u32(bandwidth);","var distances: array<f32, 6>;","for (var neighbor = 0u; neighbor < neighborCount; neighbor++) { distances[neighbor] = 3.402823e38; }","var eligibleCount = 0u;","for (var row = 0u; row < 6u; row++) {","  if (!included(row) || !responseValid(row) || row == focus) { continue; }","  let distance = getDistance(getPosition(focus), getPosition(row));","  if (!isFiniteBits(distance)) { fits[base + 3u] = 4.0; return; }","  eligibleCount++;","  var candidateDistance = distance;","  for (var neighbor = 0u; neighbor < neighborCount; neighbor++) {","    if (candidateDistance < distances[neighbor]) { let previous = distances[neighbor]; distances[neighbor] = candidateDistance; candidateDistance = previous; }","if (eligibleCount < neighborCount) { fits[base + 3u] = 2.0; return; }","bandwidth = distances[neighborCount - 1u] * 1.00001;","// A zero kth distance has no positive distance scale; never invent a coordinate-unit floor.","if (!(bandwidth > 0.0)) { fits[base + 3u] = 2.0; return; }","if (!isFiniteBits(bandwidth)) { fits[base + 3u] = 4.0; return; }","var positiveCount = 0u; var responseSum = 0.0;","let origin = getPosition(focus);","for (var column = 1u; column < 2u; column++) { centerValues[column] = predictor(focus, column); scaleValues[column] = 0.0; }","{","    if (!(spatialWeight(focus, row, bandwidth) > 0.0)) { continue; }","  positiveCount++; responseSum += response[responseOffset + row];","  for (var column = 1u; column < 2u; column++) { scaleValues[column] = max(scaleValues[column], abs(predictor(row, column) - centerValues[column])); }","for (var column = 1u; column < 2u; column++) { if (!(scaleValues[column] > 0.0) || !isFiniteBits(scaleValues[column])) { scaleValues[column] = 1.0; } }","if (positiveCount < 2u) { fits[base + 3u] = 2.0; return; }","if (responseSum == 0.0 ) { fits[base + 3u] = 5.0; return; }","var coefficients: array<f32, 2>;","var state = 3u; var completed = 0u;","for (var iteration = 0u; iteration < 32u; iteration++) {","  var information: array<f32, 4>; var gradient: array<f32, 2>;","  var equilibration: array<f32, 2>;","  var observations = 0u; var finite = true;","    if (!finite) { continue; }","    let spatial = spatialWeight(focus, row, bandwidth); if (!(spatial > 0.0)) { continue; }","    let linear = linearPredictor(row, &coefficients);","    if (!isFiniteBits(linear) || abs(linear) > 30.0) { finite = false; continue; }","    let mean = meanResponse(linear); let variance = mean;","    observations++;","    var design: array<f32, 2>;","    for (var column = 0u; column < 2u; column++) { design[column] = designValue(row, column); }","    for (var column = 0u; column < 2u; column++) {","      gradient[column] += spatial * design[column] * (response[responseOffset + row] - mean);","      for (var other = 0u; other <= column; other++) { information[column * 2u + other] += spatial * variance * design[column] * design[other]; }","  completed = iteration + 1u;","  if (!finite) { state = 4u; break; }","  if (observations < 2u || !factorInformation(&information, &equilibration)) { state = 2u; break; }","  solveInformation(&information, &equilibration, &gradient);","  let previousLikelihood = logLikelihood(focus, bandwidth, &coefficients);","  var step = 1.0; var accepted = false; var candidate: array<f32, 2>;","  for (var attempt = 0u; attempt < 16u; attempt++) {","    for (var column = 0u; column < 2u; column++) { candidate[column] = coefficients[column] + step * gradient[column]; }","    let likelihood = logLikelihood(focus, bandwidth, &candidate);","    if (isFiniteBits(likelihood) && likelihood >= previousLikelihood - 1.0e-6 * max(1.0, abs(previousLikelihood))) { accepted = true; break; }","    step *= 0.5;","  if (!accepted) { state = 4u; break; }","  var change = 0.0;","  for (var column = 0u; column < 2u; column++) { change = max(change, abs(candidate[column] - coefficients[column]) / max(1.0, abs(coefficients[column]))); coefficients[column] = candidate[column]; }","  if (change <= tolerance) { state = 0u; break; }","if (state == 0u) {","  // Map the centered, scaled coefficients back to the raw predictor basis.","  fits[base + 2u] = meanResponse(linearPredictor(focus, &coefficients));","  var intercept = coefficients[0];","  for (var column = 1u; column < 2u; column++) {","    fits[base + column] = coefficients[column] / scaleValues[column];","    intercept -= fits[base + column] * centerValues[column];","  fits[base] = intercept;","fits[base + 3u] = f32(state); fits[base + 4u] = f32(completed);","@group(0) @binding(0) var<storage, read> fits: array<f32>;","const coefficientsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> coefficients: array<f32>;","const fittedOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> fitted: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> status: array<u32>;","const iterationsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> iterations: array<u32>;","  _ = &coefficients;","  _ = &fitted;","  _ = &status;","  _ = &iterations;","  let row = index + 0u;","for (var column = 0u; column < 2u; column++) { coefficients[coefficientsOffset + row * 2u + column] = fits[base + column]; }","fitted[fittedOffset + row] = fits[base + 2u]; status[statusOffset + row] = u32(fits[base + 3u]); iterations[iterationsOffset + row] = u32(fits[base + 4u]);","  parameters[parametersOffset] = 5.0; parameters[parametersOffset + 1u] = source[sourceOffset + 1u];","@group(0) @binding(0) var<storage, read> response: array<f32>;","@group(0) @binding(1) var<storage, read> fitted: array<f32>;","const codesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> codes: array<u32>;","const scoresOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> scores: array<f32>;","  _ = &codes;","  _ = &scores;","  scores[scoresOffset + index] = getNaN(); if (codes[codesOffset + index] != 0u) { return; } let observed = response[responseOffset + index]; let mean = fitted[fittedOffset + index]; if (!isFiniteBits(mean) || !(mean > 0.0)) { return; } scores[scoresOffset + index] = 2.0 * (select(0.0, observed * log(max(observed, 1.0e-30) / mean), observed > 0.0) - observed + mean);","const rowScoresOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> rowScores: array<f32>;","@group(0) @binding(5) var<storage, read_write> scores: array<f32>;","  _ = &rowScores;","  var total = 0.0; var count = 0u; var valid = true; for (var row = 0u; row < 6u; row++) { if (!included(row)) { continue; } let observed = response[responseOffset + row]; if (!(observed >= 0.0 && floor(observed) == observed)) { continue; } let score = rowScores[rowScoresOffset + row]; if (!isFiniteBits(score)) { valid = false; } total += score; count++; } scores[scoresOffset + 0u] = getNaN(); if (valid && count > 0u) { scores[scoresOffset + 0u] = total / f32(count); }","  var total = 0.0; var count = 0u; var valid = true; for (var row = 0u; row < 6u; row++) { if (!included(row)) { continue; } let observed = response[responseOffset + row]; if (!(observed >= 0.0 && floor(observed) == observed)) { continue; } let score = rowScores[rowScoresOffset + row]; if (!isFiniteBits(score)) { valid = false; } total += score; count++; } scores[scoresOffset + 1u] = getNaN(); if (valid && count > 0u) { scores[scoresOffset + 1u] = total / f32(count); }","@group(0) @binding(0) var<storage, read> scores: array<f32>;","const bandwidthOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> bandwidth: array<f32>;","@group(0) @binding(2) var<storage, read_write> status: array<u32>;","@group(0) @binding(3) var<storage, read_write> parameters: array<f32>;","  _ = &bandwidth;","  var best = 3.402823e38; var chosen = getNaN(); if (isFiniteBits(scores[scoresOffset + 0u]) && scores[scoresOffset + 0u] < best) { best = scores[scoresOffset + 0u]; chosen = 4.0; }","if (isFiniteBits(scores[scoresOffset + 1u]) && scores[scoresOffset + 1u] < best) { best = scores[scoresOffset + 1u]; chosen = 5.0; } bandwidth[bandwidthOffset] = chosen; parameters[parametersOffset] = chosen; status[statusOffset] = select(1u, 0u, isFiniteBits(chosen));","let base = fitsOffset + index * 8u;","for (var column = 0u; column < 8u; column++) { fits[base + column] = getNaN(); }","  if (!included(row) || !responseValid(row) ) { continue; }","  var finalInformation: array<f32, 4>;","  var finalEquilibration: array<f32, 2>;","    let mean = meanResponse(linearPredictor(row, &coefficients));","    let variance = mean;","      for (var other = 0u; other <= column; other++) { finalInformation[column * 2u + other] += spatial * variance * designValue(row, column) * designValue(row, other); }","  if (factorInformation(&finalInformation, &finalEquilibration)) {","    // Raw coefficient c is row c of the affine map A from the centered basis, so its variance","    // solves with A^T e_c and projects each row on its centered design vector.","      var inverseColumn: array<f32, 2>;","      if (column == 0u) {","        inverseColumn[0] = 1.0;","        for (var other = 1u; other < 2u; other++) { inverseColumn[other] = -centerValues[other] / scaleValues[other]; }","      } else {","        inverseColumn[column] = 1.0 / scaleValues[column];","      solveInformation(&finalInformation, &finalEquilibration, &inverseColumn);","      var coefficientVariance = 0.0;","      {","        let mean = meanResponse(linearPredictor(row, &coefficients));","        let variance = mean;","        var projection = 0.0;","        for (var other = 0u; other < 2u; other++) { projection += inverseColumn[other] * designValue(row, other); }","        coefficientVariance += spatial * spatial * variance * projection * projection;","      fits[base + 5u + column] = sqrt(max(0.0, coefficientVariance));","    // The focal design vector is (1, 0, ..., 0), so the leverage is the first inverse entry.","    var focalColumn: array<f32, 2>;","    focalColumn[0] = 1.0;","    solveInformation(&finalInformation, &finalEquilibration, &focalColumn);","    let focusMean = fits[base + 2u];","    fits[base + 7u] = focalColumn[0] * spatialWeight(focus, focus, bandwidth) * focusMean;","const standardErrorsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> standardErrors: array<f32>;","const influenceOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> influence: array<f32>;","  _ = &standardErrors;","  _ = &influence;","for (var column = 0u; column < 2u; column++) { standardErrors[standardErrorsOffset + row * 2u + column] = fits[base + 5u + column]; } influence[influenceOffset + row] = fits[base + 7u];"],"strings":["read","GPUGeneralizedGeographicallyWeightedRegression","read_write","generalized-geographically-weighted-regression-selected-parameters","buffer","gpu-spatial-analysis-generali