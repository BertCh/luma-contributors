,"iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-great-circle-arcs-compiled","resource":"arcs","meaning":"GPU-emitted spherical great-circle arcs (mean-radius sphere); GPU offsets exclude unused capacity","components":2,"role":"output","geometry":{"kind":"lines","coordinateModel":"geographic","offsetsCapture":"arcOffsets"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const sourcesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> sources: array<f32>;","const targetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> targets: array<f32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","const countsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> counts: array<u32>;","const GEODESIC_PI: f32 = 3.14159265358979;","const GEODESIC_DEGREES_TO_RADIANS: f32 = 0.0174532925199433;","const GEODESIC_RADIANS_TO_DEGREES: f32 = 57.2957795130823;","fn geodesicWrapLongitudeDelta(delta: f32) -> f32 {","  return delta - 360.0 * round(delta / 360.0);","}","// Subtract near the shared antimeridian before forming the small angular separation.","// Wrapping (destination - source) afterward cannot recover bits lost by that large subtraction:","// 179.341 -> -179.877 loses about 1.6 meters on the OpenFlights sphere fixture.","fn geodesicLongitudeDelta(source: f32, destination: f32) -> f32 {","  // WGSL permits floating-point reassociation: the two seam-relative subtractions below","  // can become (destination - source) - 2 * halfTurn, restoring the cancellation.","  // For opposite seam quadrants, every f32 endpoint is exactly a multiple of 2^-17","  // degrees (the smallest ulp on [90, 180]). Scale by that power of two and wrap in","  // i32: magnitudes stay below 2^26, with no quantization or integer overflow. Only","  // the final, small difference is converted back to f32, so reassociation cannot","  // reintroduce a large floating-point subtraction.","  if (abs(source) > 90.0 && abs(source) <= 180.0 &&","      abs(destination) > 90.0 && abs(destination) <= 180.0 &&","      ((source < 0.0) != (destination < 0.0))) {","    let sourceUnits = i32(source * 131072.0);","    let destinationUnits = i32(destination * 131072.0);","    let turnUnits = select(-47185920, 47185920, source > 0.0);","    return f32(destinationUnits - sourceUnits + turnUnits) * 0.00000762939453125;","  }","  let halfTurn = 180.0 * round((destination - source) / 360.0);","  return (destination - halfTurn) - (source + halfTurn);","// cos(latitude) as sin(colatitude): 90 - |lat| is exact in f32, so the cosine keeps its relative","// precision near the poles where cos(lat * pi / 180) would not.","fn geodesicCosLatitude(latitudeDegrees: f32) -> f32 {","  return sin((90.0 - abs(latitudeDegrees)) * GEODESIC_DEGREES_TO_RADIANS);","fn geodesicUnitVector(lngLat: vec2<f32>) -> vec3<f32> {","  let lambda = lngLat.x * GEODESIC_DEGREES_TO_RADIANS;","  let phi = lngLat.y * GEODESIC_DEGREES_TO_RADIANS;","  let cosPhi = geodesicCosLatitude(lngLat.y);","  return vec3<f32>(cosPhi * cos(lambda), cosPhi * sin(lambda), sin(phi));","fn geodesicFromUnitVector(vector: vec3<f32>) -> vec2<f32> {","  let horizontal = sqrt(vector.x * vector.x + vector.y * vector.y);","  return vec2<f32>(","    atan2(vector.y, vector.x) * GEODESIC_RADIANS_TO_DEGREES,","    atan2(vector.z, horizontal) * GEODESIC_RADIANS_TO_DEGREES","  );","fn geodesicHaversineTerm(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let deltaPhi = (b.y - a.y) * GEODESIC_DEGREES_TO_RADIANS;","  let deltaLambda = geodesicLongitudeDelta(a.x, b.x) * GEODESIC_DEGREES_TO_RADIANS;","  let sinHalfPhi = sin(0.5 * deltaPhi);","  let sinHalfLambda = sin(0.5 * deltaLambda);","  let term = sinHalfPhi * sinHalfPhi +","    geodesicCosLatitude(a.y) * geodesicCosLatitude(b.y) *","    sinHalfLambda * sinHalfLambda;","  return clamp(term, 0.0, 1.0);","fn geodesicCentralAngle(a: vec2<f32>, b: vec2<f32>) -> f32 {","  // Vincenty's special case for the sphere: well conditioned from a millimeter to antipodal,","  // unlike the haversine form whose sqrt(1 - h) loses precision near antipodes.","  let phi1 = a.y * GEODESIC_DEGREES_TO_RADIANS;","  let phi2 = b.y * GEODESIC_DEGREES_TO_RADIANS;","  let sinPhi1 = sin(phi1);","  let cosPhi1 = geodesicCosLatitude(a.y);","  let cosPhi2 = geodesicCosLatitude(b.y);","  let halfVersine = 2.0 * sinHalfLambda * sinHalfLambda;","  let east = cosPhi2 * sin(deltaLambda);","  let north = sin(deltaPhi) + sinPhi1 * cosPhi2 * halfVersine;","  let up = sinPhi1 * sin(phi2) + cosPhi1 * cosPhi2 * (1.0 - halfVersine);","  return atan2(sqrt(east * east + north * north), up);","fn geodesicInitialBearingDegrees(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let y = sin(deltaLambda) * cosPhi2;","  // cos(phi1) sin(phi2) - sin(phi1) cos(phi2) cos(deltaLambda), without cancellation.","  let x = sin(deltaPhi) + 2.0 * sin(phi1) * cosPhi2 * sinHalfLambda * sinHalfLambda;","  // Coincident points have no azimuth. Pin the conventional zero bearing instead of","  // evaluating atan2(0, 0), whose result is unbounded by WGSL (and can be NaN).","  if (x == 0.0 && y == 0.0) {","    return 0.0;","  return atan2(y, x) * GEODESIC_RADIANS_TO_DEGREES;","fn geodesicDestination(origin: vec2<f32>, bearingDegrees: f32, angle: f32) -> vec2<f32> {","  let phi1 = origin.y * GEODESIC_DEGREES_TO_RADIANS;","  let theta = bearingDegrees * GEODESIC_DEGREES_TO_RADIANS;","  let cosPhi1 = geodesicCosLatitude(origin.y);","  let sinHalfAngle = sin(0.5 * angle);","  // sin(phi2) - sin(phi1), from the half-angle form so short moves keep their precision.","  let sinDelta = -2.0 * sinPhi1 * sinHalfAngle * sinHalfAngle + cosPhi1 * sin(angle) * cos(theta);","  let sinPhi2 = clamp(sinPhi1 + sinDelta, -1.0, 1.0);","  let roughPhi2 = asin(sinPhi2);","  // sin(phi2) - sin(phi1) = 2 cos((phi1 + phi2) / 2) sin((phi2 - phi1) / 2); the midpoint cosine","  // is insensitive to the rough phi2, so the latitude change is recovered to relative precision.","  let midpointCosine = cos(0.5 * (phi1 + roughPhi2));","  var deltaPhi = roughPhi2 - phi1;","  if (abs(midpointCosine) > 1e-3) {","    deltaPhi = 2.0 * asin(clamp(sinDelta / (2.0 * midpointCosine), -1.0, 1.0));","  let deltaLambda = atan2(","    sin(theta) * sin(angle) * cosPhi1,","    cos(angle) - sinPhi1 * sinPhi2","    origin.x + deltaLambda * GEODESIC_RADIANS_TO_DEGREES,","    origin.y + deltaPhi * GEODESIC_RADIANS_TO_DEGREES","fn geodesicInterpolate(a: vec2<f32>, b: vec2<f32>, angle: f32, fraction: f32) -> vec2<f32> {","  let unitA = geodesicUnitVector(a);","  let unitB = geodesicUnitVector(b);","  var vector: vec3<f32>;","  if (angle < 1e-6) {","    vector = normalize(mix(unitA, unitB, fraction));","  } else {","    let sinAngle = sin(angle);","    vector = unitA * (sin((1.0 - fraction) * angle) / sinAngle) +","      unitB * (sin(fraction * angle) / sinAngle);","  let lngLat = geodesicFromUnitVector(vector);","  // Keep longitudes continuous with the start point (unwrapped across the antimeridian).","  return vec2<f32>(a.x + geodesicWrapLongitudeDelta(lngLat.x - a.x), lngLat.y);","fn geodesicSinLatitudeDelta(latitudeDegrees: f32, originLatitudeDegrees: f32) -> f32 {","  let halfSum = 0.5 * (latitudeDegrees + originLatitudeDegrees) * GEODESIC_DEGREES_TO_RADIANS;","  let halfDifference = 0.5 * (latitudeDegrees - originLatitudeDegrees) * GEODESIC_DEGREES_TO_RADIANS;","  return 2.0 * cos(halfSum) * sin(halfDifference);","fn geodesicHaversineDistance(a: vec2<f32>, b: vec2<f32>, radius: f32) -> f32 {","  return radius * geodesicCentralAngle(a, b);","// Offset of position from origin in the local equirectangular frame at origin, in degrees of","// latitude (east offsets scaled by cos(latitude of origin), longitudes wrapped at +-180).","fn geodesicLocalOffset(origin: vec2<f32>, position: vec2<f32>) -> vec2<f32> {","    geodesicLongitudeDelta(origin.x, position.x) * geodesicCosLatitude(origin.y),","    position.y - origin.y","// Fraction in [0, 1] of the point of segment start-end closest to point, in the local","// equirectangular frame at point: exact to first order for segments of road length.","fn geodesicSegmentFraction(point: vec2<f32>, start: vec2<f32>, end: vec2<f32>) -> f32 {","  // Pin coincident endpoints before projection: contracting a scaled offset subtraction","  // into an FMA can leave a nonzero residual even when both endpoints are identical.","  if (all(start == end)) {","  let startOffset = geodesicLocalOffset(point, start);","  let segment = geodesicLocalOffset(point, end) - startOffset;","  let denominator = dot(segment, segment);","  if (denominator > 0.0) {","    return clamp(-dot(startOffset, segment) / denominator, 0.0, 1.0);","  return 0.0;","// Great-circle distance (units of radius) from point to the position at fraction along the","// segment, built from coordinate differences so short distances keep their precision near +-180.","fn geodesicSegmentDistance(","  point: vec2<f32>,","  start: vec2<f32>,","  end: vec2<f32>,","  fraction: f32,","  radius: f32",") -> f32 {","  // Use the same seam-preserving differences as edge lengths and local projection. Mixing","  // rounded seam offsets with precise edge lengths biases map-matching likelihoods.","  let startOffset = vec2<f32>(geodesicLongitudeDelta(point.x, start.x), start.y - point.y);","  let delta = vec2<f32>(geodesicLongitudeDelta(start.x, end.x), end.y - start.y);","  let offset = startOffset + fraction * delta;","  let sinHalfLatitude = sin(0.5 * offset.y * GEODESIC_DEGREES_TO_RADIANS);","  let sinHalfLongitude = sin(0.5 * offset.x * GEODESIC_DEGREES_TO_RADIANS);","  let term = sinHalfLatitude * sinHalfLatitude +","    geodesicCosLatitude(point.y) * geodesicCosLatitude(point.y + offset.y) *","    sinHalfLongitude * sinHalfLongitude;","  return 2.0 * radius * asin(sqrt(clamp(term, 0.0, 1.0)));","const RADIUS: f32 = 6371009.0;","const MAXIMUM_SEGMENTS: u32 = 256u;","fn getSource(row: u32) -> vec2<f32> {","  return vec2<f32>(sources[sourcesOffset + 2u * row], sources[sourcesOffset + 2u * row + 1u]);","fn getTarget(row: u32) -> vec2<f32> {","  return vec2<f32>(targets[targetsOffset + 2u * row], targets[targetsOffset + 2u * row + 1u]);","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &sources;","  _ = &targets;","  _ = &parameters;","  _ = &counts;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let distance = geodesicCentralAngle(getSource(index), getTarget(index)) * RADIUS;","  let maximumLength = parameters[parametersOffset];","  let minimumSegments = parameters[parametersOffset + 1u];","  var segments = 1.0;","  if (maximumLength > 0.0 && distance > 0.0) {","    ","    segments = ceil(min(distance / maximumLength, f32(MAXIMUM_SEGMENTS)));","  if (minimumSegments > segments) {","    segments = min(round(minimumSegments), f32(MAXIMUM_SEGMENTS));","  counts[countsOffset + index] = clamp(u32(segments), 1u, MAXIMUM_SEGMENTS) + 1u;","const countOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> count: array<u32>;","const LINE_CAPACITY: u32 = 40u;","@compute @workgroup_size(32)","  _ = &count;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  let total = LINE_CAPACITY;","  count[countOffset] = min(total, LINE_CAPACITY);","  ","const sourceLineIndicesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> sourceLineIndices: array<u32>;","  _ = &sourceLineIndices;","  sourceLineIndices[sourceLineIndicesOffset + index] = index;","@group(0) @binding(2) var<storage, read> counts: array<u32>;","const startsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> starts: array<u32>;","const outputPositionsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> outputPositions: array<f32>;","const CAPACITY: u32 = 1320u;","const BALANCED_ROWS: u32 = 40u;","const BALANCED_LANES: u32 = 128u;","const BALANCED_NONE: u32 = 0xffffffffu;","var<workgroup> balancedWindow: array<u32, 2>;","// Last row in [low, high] whose output range starts at or before the slot.","fn balancedLastAtMost(slot: u32, lowRow: u32, highRow: u32) -> u32 {","  var low = lowRow;","  var high = highRow;","  while (low < high) {","    let middle = (low + high + 1u) >> 1u;","    if (balancedStart(middle) <= slot) {","      low = middle;","    } else {","      high = middle - 1u;","    }","  return low;","fn findBalancedOwner(slot: u32, firstSlot: u32, lane: u32) -> u32 {","  if (lane == 0u) {","    let lowRow = balancedLastAtMost(firstSlot, 0u, BALANCED_ROWS - 1u);","    balancedWindow[0] = lowRow;","    balancedWindow[1] = balancedLastAtMost(firstSlot + (BALANCED_LANES - 1u), lowRow, BALANCED_ROWS - 1u);","  let windowLow = workgroupUniformLoad(&balancedWindow[0]);","  let windowHigh = workgroupUniformLoad(&balancedWindow[1]);","  let total = balancedStart(BALANCED_ROWS - 1u) + balancedCount(BALANCED_ROWS - 1u);","  if (slot >= total) {","    return BALANCED_NONE;","  return balancedLastAtMost(slot, windowLow, windowHigh);","fn balancedStart(row: u32) -> u32 { return starts[startsOffset + row]; }","fn balancedCount(row: u32) -> u32 { return counts[countsOffset + row]; }","fn writeVertex(outputRow: u32, vertex: vec2<f32>, measure: f32, sourceRow: u32) {","  if (outputRow >= CAPACITY) {","  outputPositions[outputPositionsOffset + 2u * outputRow] = vertex.x;","  outputPositions[outputPositionsOffset + 2u * outputRow + 1u] = vertex.y;","@compute @workgroup_size(128)","  _ = &starts;","  _ = &outputPositions;","  if (workgroupIndex >= 33554432u) { return; }","  let index = workgroupIndex * 128u + localInvocationIndex;","  let pair = findBalancedOwner(index, workgroupIndex * BALANCED_LANES, localInvocationIndex);","  if (pair == BALANCED_NONE) {","  let segments = counts[countsOffset + pair] - 1u;","  let vertex = index - starts[startsOffset + pair];","  let source = getSource(pair);","  if (vertex == 0u) {","    writeVertex(index, source, 0.0, pair);","  let destination = getTarget(pair);","  // Measure and interpolate from the original endpoints. Reconstructing an unwrapped","  // target first rounds away short antimeridian separations even with a stable angle.","  let angle = geodesicCentralAngle(source, destination);","  if (vertex == segments) {","    let unwrapped = vec2<f32>(source.x + geodesicLongitudeDelta(source.x, destination.x), destination.y);","    writeVertex(index, unwrapped, angle * RADIUS, pair);","  let fraction = f32(vertex) / f32(segments);","  writeVertex(","    index,","    geodesicInterpolate(source, destination, angle, fraction),","    angle * RADIUS * fraction,","    pair","@group(0) @binding(0) var<storage, read> counts: array<u32>;","@group(0) @binding(1) var<storage, read> starts: array<u32>;","const outputLineOffsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> outputLineOffsets: array<u32>;","const overflowOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> overflowOut: array<u32>;","const vertexCountOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> vertexCountOut: array<u32>;","const ROW_COUNT: u32 = 40u;","  _ = &outputLineOffsets;","  _ = &overflowOut;","  _ = &vertexCountOut;","  let total = starts[startsOffset + ROW_COUNT - 1u] + counts[countsOffset + ROW_COUNT - 1u];","  let row = min(index, ROW_COUNT);","  var start = total;","  if (row < ROW_COUNT) {","    start = starts[startsOffset + row];","  outputLineOffsets[outputLineOffsetsOffset + index] = min(start, CAPACITY);","  if (index == 0u) {","    overflowOut[overflowOutOffset] = select(0u, 1u, total > CAPACITY);","    vertexCountOut[vertexCountOutOffset] = min(total, CAPACITY);"],"strings":["gpu-spatial-analysis-great-circle-arcs-snapshot-tap","buffer","great-circle-arcs-counts","great-circle-arcs-publish","GPUGreatCircleArcs","great-circle-arcs-count","read","count","great-circle-arcs-starts","targets","transient","great-circle-arcs-emit","read_write","sources","arcOffsets","arcSources","arcs","compute","great-circle-arcs-scan-level-0-scan","overflow","vertexCount","great-circle-arcs-line-count","great-circle-arcs-source-line-indexs","imported","parameters","counts","GPUScan","starts"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","reads","writes","workload","attrs"],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:2",40,1,1],["~:3","~9","~9","~6","f32",0,40],["~:3","~d","~d","~6","f32",0,40],["~:3","~p","~2","~6","u32",0,40],["~:3","~r","~8","~6","u32",0,40],["~:4",[1,1,1],40,false]]}}
