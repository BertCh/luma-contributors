;","@group(0) @binding(1) var<storage, read> instruments: array<f32>;","const tilePartialOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> tilePartial: array<f32>;","override ROW_COUNT: u32;","override TILE_ROWS: u32;","const TERM_COUNT: u32 = 6u;","const SUM_COUNT: u32 = 5u;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","fn getColumn(row: u32, column: u32) -> f32 {","  if (column < 2u) { return design[designOffset + row * 2u + column]; }","  return instruments[instrumentsOffset + row * 3u + column - 2u];","fn accumulateRow(row: u32, terms: ptr<function, array<f32, TERM_COUNT>>) {","  for (var column = 0u; column < SUM_COUNT; column++) {","    let value = getColumn(row, column);","    (*terms)[column] += value;","    if (!isFiniteBits(value)) { (*terms)[SUM_COUNT] = 1.0; }","  }","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &design;","  _ = &instruments;","  _ = &tilePartial;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let firstRow = index * TILE_ROWS;","  let lastRow = min(firstRow + TILE_ROWS, ROW_COUNT);","  var terms: array<f32, 6>;","  for (var row = firstRow; row < lastRow; row++) {","    accumulateRow(row, &terms);","  for (var term = 0u; term < TERM_COUNT; term++) {","    tilePartial[tilePartialOffset + index * TERM_COUNT + term] = terms[term];","const offsetsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> neighbors: array<u32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> weights: array<f32>;","const kernelStatusOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> kernelStatus: array<u32>;","@compute @workgroup_size(32)","  _ = &offsets;","  _ = &neighbors;","  _ = &weights;","  _ = &kernelStatus;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  let begin = offsets[offsetsOffset + index]; let end = offsets[offsetsOffset + index + 1u]; var invalid = begin > end || end > 24u ; var diagonal = 0.0;","if (!invalid) { for (var slot = begin; slot < end; slot++) {"," let neighbor = neighbors[neighborsOffset + slot]; let weight = weights[weightsOffset + slot];"," if (neighbor >= 24u || !isFiniteBits(weight) || weight < 0.0) { invalid = true; continue; }"," if (neighbor == index) { diagonal += weight; }"," let reverseBegin = offsets[offsetsOffset + neighbor]; let reverseEnd = offsets[offsetsOffset + neighbor + 1u];"," if (reverseBegin > reverseEnd || reverseEnd > 24u) { invalid = true; continue; }"," var reverse = 0.0; var forward = 0.0;"," for (var other = reverseBegin; other < reverseEnd; other++) { if (neighbors[neighborsOffset + other] == index) { reverse += weights[weightsOffset + other]; } }"," for (var other = begin; other < end; other++) { if (neighbors[neighborsOffset + other] == neighbor) { forward += weights[weightsOffset + other]; } }"," invalid = invalid || abs(reverse - forward) > 1e-5 * max(1.0, abs(forward));","} }","invalid = invalid || abs(diagonal - 1.0) > 1e-5;","kernelStatus[kernelStatusOffset + index] = select(0u, 4u, invalid);","@group(0) @binding(0) var<storage, read> tilePartial: array<f32>;","const tileTotalOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> tileTotal: array<f32>;","override TILE_COUNT: u32;","const OUTPUT_SLOT: u32 = 0u;","  _ = &tileTotal;","  if (index < SUM_COUNT) {","    var sumLevels: array<f32, 32>;","  var sumDepth = 0u;","  for (var sumItem = 0u; sumItem < TILE_COUNT; sumItem++) {","    ","    var sumBlock = tilePartial[tilePartialOffset + sumItem * TERM_COUNT + index];","    // One merge per trailing one bit of the number of terms already taken.","    var sumCarry = sumItem;","    for (var level = 0u; level < 32u; level++) {","      if ((sumCarry & 1u) == 0u) {","        break;","      }","      sumDepth--;","      sumBlock = sumLevels[sumDepth] + sumBlock;","      sumCarry = sumCarry >> 1u;","    }","    sumLevels[sumDepth] = sumBlock;","    sumDepth++;","  var sum = 0.0;","  for (var level = 0u; level < 32u; level++) {","    if (sumDepth == 0u) {","      break;","    sumDepth--;","    sum = sumLevels[sumDepth] + sum;","    tileTotal[tileTotalOffset + OUTPUT_SLOT + index] = sum;","  var largest = 0.0;","  for (var tile = 0u; tile < TILE_COUNT; tile++) {","    largest = max(largest, tilePartial[tilePartialOffset + tile * TERM_COUNT + index]);","  tileTotal[tileTotalOffset + OUTPUT_SLOT + index] = largest;","const workspaceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> workspace: array<f32>;","  _ = &workspace;","  workspace[workspaceOffset + index] = workspace[workspaceOffset + index] / 24.0;","@group(0) @binding(2) var<storage, read> workspace: array<f32>;","@group(0) @binding(3) var<storage, read_write> tilePartial: array<f32>;","const TERM_COUNT: u32 = 14u;","const SUM_COUNT: u32 = 14u;","  var centered: array<f32, 5>;","  for (var column = 0u; column < 5u; column++) {","    centered[column] = getColumn(row, column) - workspace[workspaceOffset + column];","  var slot = 0u;","  for (var first = 0u; first < 3u; first++) {","    for (var second = first; second < 3u; second++) {","      (*terms)[slot] += centered[2u + first] * centered[2u + second];","      slot++;","    for (var column = 0u; column < 2u; column++) {","      (*terms)[slot] += centered[2u + first] * centered[column];","  for (var column = 0u; column < 2u; column++) {","    (*terms)[slot] += centered[column] * centered[column];","    slot++;","  var terms: array<f32, 14>;","const OUTPUT_SLOT: u32 = 6u;","@group(0) @binding(0) var<storage, read> workspace: array<f32>;","const projectionOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> projection: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> status: array<u32>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","struct DenseCholesky_3 {","  scale: array<f32, 3>,","  size: u32,","  status: u32,","  smallestPivotRatio: f32,","fn factorDenseCholesky_3(","  matrix: ptr<function, array<f32, 9>>,","  equilibrate: bool,","  minimumPivotRatio: f32",") -> DenseCholesky_3 {","  var result: DenseCholesky_3;","  result.size = min(size, 3u);","  result.status = 0u;","  result.smallestPivotRatio = 1.0;","  let count = result.size;","  for (var row = 0u; row < count; row++) {","    for (var column = 0u; column <= row; column++) {","      if (!isFiniteValue((*matrix)[row * 3u + column])) {","        result.status = 1u;","        return result;","  for (var column = 0u; column < count; column++) {","    let diagonal = (*matrix)[column * 3u + column];","    if (!(diagonal > 0.0)) {","      result.status = 2u;","      return result;","    result.scale[column] = select(1.0, 1.0 / sqrt(diagonal), equilibrate);","  if (equilibrate) {","    for (var row = 0u; row < count; row++) {","      for (var column = 0u; column <= row; column++) {","        (*matrix)[row * 3u + column] = (*matrix)[row * 3u + column] * result.scale[row] * result.scale[column];","    let original = (*matrix)[column * 3u + column];","    var diagonal = original;","    for (var k = 0u; k < column; k++) {","      let value = (*matrix)[column * 3u + k];","      diagonal = diagonal - value * value;","    if (!isFiniteValue(diagonal)) {","      result.status = 1u;","    if (!(diagonal > 0.0) || !(original > 0.0)) {","      result.smallestPivotRatio = 0.0;","    result.smallestPivotRatio = min(result.smallestPivotRatio, diagonal / original);","    let pivot = sqrt(diagonal);","    (*matrix)[column * 3u + column] = pivot;","    for (var row = column + 1u; row < count; row++) {","      var value = (*matrix)[row * 3u + column];","      for (var k = 0u; k < column; k++) {","        value = value - (*matrix)[row * 3u + k] * (*matrix)[column * 3u + k];","      (*matrix)[row * 3u + column] = value / pivot;","  if (result.smallestPivotRatio < minimumPivotRatio) {","    result.status = 3u;","  return result;","fn solveDenseCholesky_3(","  factorization: ptr<function, DenseCholesky_3>,","  vector: ptr<function, array<f32, 3>>",") -> bool {","  let count = (*factorization).size;","    (*vector)[row] = (*vector)[row] * (*factorization).scale[row];","    var value = (*vector)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*matrix)[row * 3u + k] * (*vector)[k];","    (*vector)[row] = value / (*matrix)[row * 3u + row];","  for (var offset = 0u; offset < count; offset++) {","    let row = count - 1u - offset;","    for (var k = row + 1u; k < count; k++) {","      value = value - (*matrix)[k * 3u + row] * (*vector)[k];","  var finite = true;","    finite = finite && isFiniteValue((*vector)[row]);","  return finite;","fn getDenseCholeskyInverseDiagonal_3(","  column: u32",") -> f32 {","  var unit: array<f32, 3>;","  unit[column] = 1.0;","  solveDenseCholesky_3(matrix, factorization, &unit);","  return unit[column];","fn invertDenseCholesky_3(","  inverse: ptr<function, array<f32, 9>>","    var unit: array<f32, 3>;","    unit[column] = 1.0;","    finite = solveDenseCholesky_3(matrix, factorization, &unit) && finite;","      (*inverse)[row * 3u + column] = unit[row];","fn getDenseCholeskyLogDeterminant_3(","  factorization: ptr<function, DenseCholesky_3>","  var total = 0.0;","  for (var row = 0u; row < (*factorization).size; row++) {","    total = total + 2.0 * (log((*matrix)[row * 3u + row]) - log((*factorization).scale[row]));","  return total;","fn choleskyFactor_3(a: ptr<function, array<f32, 9>>) -> bool {","  return factorDenseCholesky_3(a, 3u, false, 0.0).status == 0u;","// The factorization record of a successful unequilibrated factor: unit scale, full size.","fn getCholeskyFactorization_3() -> DenseCholesky_3 {","  return DenseCholesky_3(array<f32, 3>(1.0, 1.0, 1.0), 3u, 0u, 1.0);","fn choleskySolve_3(a: ptr<function, array<f32, 9>>, b: ptr<function, array<f32, 3>>) {","  var factorization = getCholeskyFactorization_3();","  solveDenseCholesky_3(a, &factorization, b);","fn choleskyInverseDiagonal_3(a: ptr<function, array<f32, 9>>, column: u32) -> f32 {","  return getDenseCholeskyInverseDiagonal_3(a, &factorization, column);","struct DenseCholesky_2 {","  scale: array<f32, 2>,","fn factorDenseCholesky_2(","  matrix: ptr<function, array<f32, 4>>,",") -> DenseCholesky_2 {","  var result: DenseCholesky_2;","  result.size = min(size, 2u);","      if (!isFiniteValue((*matrix)[row * 2u + column])) {","    let diagonal = (*matrix)[column * 2u + column];","        (*matrix)[row * 2u + column] = (*matrix)[row * 2u + column] * result.scale[row] * result.scale[column];","    let original = (*matrix)[column * 2u + column];","      let value = (*matrix)[column * 2u + k];","    (*matrix)[column * 2u + column] = pivot;","      var value = (*matrix)[row * 2u + column];","        value = value - (*matrix)[row * 2u + k] * (*matrix)[column * 2u + k];","      (*matrix)[row * 2u + column] = value / pivot;","fn solveDenseCholesky_2(","  factorization: ptr<function, DenseCholesky_2>,","  vector: ptr<function, array<f32, 2>>","      value = value - (*matrix)[row * 2u + k] * (*vector)[k];","    (*vector)[row] = value / (*matrix)[row * 2u + row];","      value = value - (*matrix)[k * 2u + row] * (*vector)[k];","fn getDenseCholeskyInverseDiagonal_2(","  var unit: array<f32, 2>;","  solveDenseCholesky_2(matrix, factorization, &unit);","fn invertDenseCholesky_2(","  inverse: ptr<function, array<f32, 4>>","    var unit: array<f32, 2>;","    finite = solveDenseCholesky_2(matrix, factorization, &unit) && finite;","      (*inverse)[row * 2u + column] = unit[row];","fn getDenseCholeskyLogDeterminant_2(","  factorization: ptr<function, DenseCholesky_2>","    total = total + 2.0 * (log((*matrix)[row * 2u + row]) - log((*factorization).scale[row]));","fn choleskyFactor_2(a: ptr<function, array<f32, 4>>) -> bool {","  return factorDenseCholesky_2(a, 2u, false, 0.0).status == 0u;","fn getCholeskyFactorization_2() -> DenseCholesky_2 {","  return DenseCholesky_2(array<f32, 2>(1.0, 1.0), 2u, 0u, 1.0);","fn choleskySolve_2(a: ptr<function, array<f32, 4>>, b: ptr<function, array<f32, 2>>) {","  var factorization = getCholeskyFactorization_2();","  solveDenseCholesky_2(a, &factorization, b);","fn choleskyInverseDiagonal_2(a: ptr<function, array<f32, 4>>, column: u32) -> f32 {","  return getDenseCholeskyInverseDiagonal_2(a, &factorization, column);","  _ = &projection;","  _ = &status;","  status[statusOffset] = 0u;","for (var slot = 0u; slot < 6u; slot++) { projection[projectionOffset + slot] = getNaN(); }","if (24u <= 3u) { status[statusOffset] = 2u; return; }","var nonfinite = workspace[workspaceOffset + 5u] != 0.0;","for (var column = 0u; column < 5u; column++) { nonfinite = nonfinite || !isFiniteBits(workspace[workspaceOffset + column]); }","if (nonfinite) { status[statusOffset] = 3u; return; }","var instrumentGram: array<f32, 9>;","var crossGram: array<f32, 6>;","var designScale: array<f32, 2>;","var slot = 6u;","for (var first = 0u; first < 3u; first++) { for (var second = first; second < 3u; second++) {"," let value = workspace[workspaceOffset + slot]; slot++;"," instrumentGram[first * 3u + second] = value; instrumentGram[second * 3u + first] = value;","for (var first = 0u; first < 3u; first++) { for (var column = 0u; column < 2u; column++) { crossGram[first * 2u + column] = workspace[workspaceOffset + slot]; slot++; } }","for (var column = 0u; column < 2u; column++) { designScale[column] = workspace[workspaceOffset + slot]; slot++; }","var instrumentScale: array<f32, 3>;","for (var instrument = 0u; instrument < 3u; instrument++) { let diagonal = instrumentGram[instrument * 4u]; if (!(diagonal > 0.0)) { status[statusOffset] = 1u; return; } instrumentScale[instrument] = inverseSqrt(diagonal); }","for (var column = 0u; column < 2u; column++) { if (!(designScale[column] > 0.0)) { status[statusOffset] = 1u; return; } designScale[column] = inverseSqrt(designScale[column]); }","for (var first = 0u; first < 3u; first++) { for (var second = 0u; second < 3u; second++) { instrumentGram[first * 3u + second] *= instrumentScale[first] * instrumentScale[second]; } }","if (!choleskyFactor_3(&instrumentGram)) { status[statusOffset] = 1u; return; }","var projected: array<f32, 6>;","for (var column = 0u; column < 2u; column++) {"," var right: array<f32, 3>;"," for (var instrument = 0u; instrument < 3u; instrument++) { right[instrument] = crossGram[instrument * 2u + column] * instrumentScale[instrument] * designScale[column]; }"," choleskySolve_3(&instrumentGram, &right);"," for (var instrument = 0u; instrument < 3u; instrument++) { projected[instrument * 2u + column] = right[instrument];"," projection[projectionOffset + 6u + column * 3u + instrument] = right[instrument] * instrumentScale[instrument] / designScale[column]; }","var normal: array<f32, 4>;","for (var first = 0u; first < 2u; first++) { for (var second = 0u; second < 2u; second++) {"," var sum = 0.0; for (var instrument = 0u; instrument < 3u; instrument++) { sum += crossGram[instrument * 2u + first] * instrumentScale[instrument] * designScale[first] * projected[instrument * 2u + second]; }"," normal[first * 2u + second] = sum;","if (!choleskyFactor_2(&normal)) { status[statusOffset] = 1u; return; }","for (var instrument = 0u; instrument < 3u; instrument++) { var right: array<f32, 2>;"," for (var column = 0u; column < 2u; column++) { right[column] = projected[instrument * 2u + column]; }"," choleskySolve_2(&normal, &right);"," for (var column = 0u; column < 2u; column++) { projection[projectionOffset + column * 3u + instrument] = right[column] * designScale[column] * instrumentScale[instrument]; }","@group(0) @binding(0) var<storage, read> instruments: array<f32>;","@group(0) @binding(1) var<storage, read> workspace: array<f32>;","@group(0) @binding(2) var<storage, read> projection: array<f32>;","const residualsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> residuals: array<f32>;","const scoresOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> scores: array<f32>;","const rowStatusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> rowStatus: array<f32>;","  _ = &residuals;","  _ = &scores;","  _ = &rowStatus;","  var residual = residuals[residualsOffset + index]; var intercept = 1.0 / 24.0;","var influences: array<f32, 2>;","var leverage = 1.0 / 24.0;","for (var column = 0u; column < 2u; column++) { var influence = 0.0;"," var fitted = 0.0;"," for (var instrument = 0u; instrument < 3u; instrument++) {","  let centered = instruments[instrumentsOffset + index * 3u + instrument] - workspace[workspaceOffset + 2u + instrument];","  influence += projection[projectionOffset + column * 3u + instrument] * centered;","  "," }"," influences[column] = influence;"," leverage += fitted * influence;"," intercept -= workspace[workspaceOffset + column] * influence;","var code = 0.0;","rowStatus[rowStatusOffset + index] = code;","for (var column = 0u; column < 2u; column++) { scores[scoresOffset + index * 3u + column + 1u] = residual * influences[column]; }","scores[scoresOffset + index * 3u] = residual * intercept;","@group(0) @binding(0) var<storage, read> rowStatus: array<f32>;","@group(0) @binding(1) var<storage, read_write> tilePartial: array<f32>;","const TERM_COUNT: u32 = 1u;","const SUM_COUNT: u32 = 0u;","        (*terms)[0] = max((*terms)[0], rowStatus[rowStatusOffset + row]);","  var terms: array<f32, 1>;","@group(0) @binding(0) var<storage, read> scores: array<f32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","@group(0) @binding(2) var<storage, read> neighbors: array<u32>;","@group(0) @binding(3) var<storage, read> weights: array<f32>;","const smoothedOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> smoothed: array<f32>;","  _ = &smoothed;","  var right: array<f32, 3>;","let begin = offsets[offsetsOffset + index]; let end = offsets[offsetsOffset + index + 1u];","if (begin <= end && end <= 24u) { for (var slot = begin; slot < end; slot++) { let neighbor = neighbors[neighborsOffset + slot]; if (neighbor < 24u) {"," let weight = weights[weightsOffset + slot];"," for (var second = 0u; second < 3u; second++) { right[second] += weight * scores[scoresOffset + neighbor * 3u + second]; } } } }","for (var second = 0u; second < 3u; second++) { smoothed[smoothedOffset + index * 3u + second] = right[second]; }","const OUTPUT_SLOT: u32 = 30u;","@group(0) @binding(1) var<storage, read> smoothed: array<f32>;","@group(0) @binding(2) var<storage, read> kernelStatus: array<u32>;","const TERM_COUNT: u32 = 10u;","const SUM_COUNT: u32 = 9u;","    let left = scores[scoresOffset + row * 3u + first];","    for (var second = 0u; second < 3u; second++) {","      (*terms)[first * 3u + second] += left * smoothed[smoothedOffset + row * 3u + second];","  if (kernelStatus[kernelStatusOffset + row] != 0u) { (*terms)[SUM_COUNT] = 1.0; }","  var terms: array<f32, 10>;","const OUTPUT_SLOT: u32 = 20u;","const covarianceOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> covariance: array<f32>;","  _ = &covariance;","  var code = status[statusOffset];","if (workspace[workspaceOffset + 29u] != 0.0) { code = 4u; }","if (code == 0u) { code = u32(workspace[workspaceOffset + 30u]); }","let scale = 1.0;","var matrix: array<f32, 9>;","var magnitude = 0.0;","