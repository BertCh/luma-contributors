neighbor = neighbors[neighborsOffset + slot]; let weight = weights[weightsOffset + slot];"," if (neighbor >= 24u || !isFiniteBits(weight) || weight < 0.0) { invalid = true; continue; }"," if (neighbor == index) { diagonal += weight; }"," let reverseBegin = offsets[offsetsOffset + neighbor]; let reverseEnd = offsets[offsetsOffset + neighbor + 1u];"," if (reverseBegin > reverseEnd || reverseEnd > 24u) { invalid = true; continue; }"," var reverse = 0.0; var forward = 0.0;"," for (var other = reverseBegin; other < reverseEnd; other++) { if (neighbors[neighborsOffset + other] == index) { reverse += weights[weightsOffset + other]; } }"," for (var other = begin; other < end; other++) { if (neighbors[neighborsOffset + other] == neighbor) { forward += weights[weightsOffset + other]; } }"," invalid = invalid || abs(reverse - forward) > 1e-5 * max(1.0, abs(forward));","} }","invalid = invalid || abs(diagonal - 1.0) > 1e-5;","kernelStatus[kernelStatusOffset + index] = select(0u, 4u, invalid);","@group(0) @binding(2) var<storage, read> means: array<f32>;","const projectionOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> projection: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","fn choleskyFactor_3(a: ptr<function, array<f32, 9>>) -> bool {","  for (var column = 0u; column < 3u; column++) {","    var diagonal = (*a)[column * 3u + column];","    for (var k = 0u; k < column; k++) {","      let value = (*a)[column * 3u + k];","      diagonal = diagonal - value * value;","    }","    if (!(diagonal > 0.0) || diagonal > 3.0e38) {","      return false;","    let pivot = sqrt(diagonal);","    (*a)[column * 3u + column] = pivot;","    for (var row = column + 1u; row < 3u; row++) {","      var value = (*a)[row * 3u + column];","      for (var k = 0u; k < column; k++) {","        value = value - (*a)[row * 3u + k] * (*a)[column * 3u + k];","      }","      (*a)[row * 3u + column] = value / pivot;","  retu