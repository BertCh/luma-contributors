put-23","meaning":"gpu-spatial-analysis-interpolation-diagnostics-recipe-snapshot-tap","role":"output"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &fillTarget;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  fillTarget[fillTargetOffset + index] = 0u;","}","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const sampleValuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> sampleValues: array<f32>;","const paramsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> params: array<f32>;","const cellOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> cellOffsets: array<u32>;","const sortedIdsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> sortedIds: array<u32>;","const valuesOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> valuesOut: array<f32>;","const varianceOutOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> varianceOut: array<f32>;","const cellStatusOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> cellStatus: array<u32>;","const WIDTH: u32 = 4u;","const HEIGHT: u32 = 1u;","const INDEX_WIDTH: u32 = 2u;","const INDEX_HEIGHT: u32 = 1u;","const MAX_NEIGHBORS: u32 = 4u;","const SYSTEM_STRIDE: u32 = 17u;","const DOMAIN_MIN: vec2f = vec2f(-1.0, -1.0);","const DOMAIN_MAX: vec2f = vec2f(4.0, 1.0);","const RELATIVE_PIVOT_TOLERANCE: f32 = 9.999999974752427e-7;","const PIVOT_RATIO_TOLERANCE: f32 = 0.00009999999747378752;","const NEGATIVE_VARIANCE_TOLERANCE: f32 = 0.00009999999747378752;","const STATUS_OK: u32 = 0u;","const STATUS_INVALID: u32 = 1u;","const STATUS_UNCERTAIN: u32 = 2u;","const ORIGIN: vec2f = DOMAIN_MIN;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn isNanBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn getCoordinate(value: f32, minimum: f32, maximum: f32, size: u32) -> u32 {","  if (maximum == minimum || value == minimum) { return 0u; }","  if (value == maximum) { return size - 1u; }","  if (minimum < 0.0 && maximum > 0.0) {","    let scale = max(abs(minimum), abs(maximum));","    let scaledValue = value / scale;","    let scaledMinimum = minimum / scale;","    let scaledMaximum = maximum / scale;","    return min(","      u32((scaledValue - scaledMinimum) / (scaledMaximum - scaledMinimum) * f32(size)),","      size - 1u","    );","  return min(u32((value - minimum) / (maximum - minimum) * f32(size)), size - 1u);","struct QueryBox { minimum: vec2f, maximum: vec2f, }","fn getSeparationKey(position: vec2f, query: vec2f) -> f32 {","  let delta = position - query;","  return dot(delta, delta);","fn getRadiusKey(radius: f32) -> f32 { return radius * radius; }","fn getSeparationMeters(key: f32) -> f32 { return sqrt(key); }","fn getSquaredMeters(key: f32) -> f32 { return key; }","fn getPairMeters(a: vec2f, b: vec2f) -> f32 {","  let separation = b - a;","  return sqrt(dot(separation, separation));","fn isExactHit(key: f32, position: vec2f, query: vec2f) -> bool { return key == 0.0; }","fn getQueryBox(center: vec2f, radius: f32) -> QueryBox {","  return QueryBox(center - vec2f(radius), center + vec2f(radius));","struct KrigingEstimate {","  value: f32,","  variance: f32,","  status: u32,","// 1 - exp(-argument) for argument >= 0, by the series","// argument - argument^2/2 + argument^3/6 - argument^4/24 + argument^5/120 below 0.1.","fn getVariogramExponentialShape(argument: f32) -> f32 {","  if (argument < 0.1) {","    return argument * (1.0 - argument * (0.5 - argument * ((1.0 / 6.0) - argument * ((1.0 / 24.0) - argument * (1.0 / 120.0)))));","  return 1.0 - exp(-argument);","fn getVariogramModelShape(modelCode: u32, scaled: f32) -> f32 {","  if (modelCode == 0u) {","    return select(1.5 * scaled - 0.5 * scaled * scaled * scaled, 1.0, scaled >= 1.0);","  if (modelCode == 1u) { return getVariogramExponentialShape(3.0 * scaled); }","  if (modelCode == 2u) { return getVariogramExponentialShape(3.0 * scaled * scaled); }","  if (modelCode == 3u) {","    // 1 - (1 + a) exp(-a) = a^2/2 - a^3/3 + a^4/8 - a^5/30 + a^6/144 - ...","    let argument = 4.749031386012701 * scaled;","    if (argument < 0.1) {","      return argument * argument * (0.5 - argument * ((1.0 / 3.0) - argument * (0.125 - argument * ((1.0 / 30.0) - argument * (1.0 / 144.0)))));","    }","    return 1.0 - (1.0 + argument) * exp(-argument);","  // 1 - (1 + a + a^2/3) exp(-a) = a^2/6 - a^4/24 + a^5/45 - a^6/144 + ...","  let argument = 5.924462618951797 * scaled;","    return argument * argument * ((1.0 / 6.0) - argument * argument * ((1.0 / 24.0) - argument * ((1.0 / 45.0) - argument * (1.0 / 144.0))));","  return 1.0 - (1.0 + argument + argument * argument / 3.0) * exp(-argument);","// Variogram normalized by its total sill; gamma(0) = 0. The shape is the shared float32","// definition, which keeps its digits at lags that are a small fraction of the range.","fn evaluateVariogram(distance: f32, modelCode: u32, nugget: f32, sill: f32, range: f32) -> f32 {","  if (distance <= 0.0) { return 0.0; }","  let shape = getVariogramModelShape(modelCode, distance / range);","  return (nugget + sill * shape) / (nugget + sill);","// The bordered system is solved by the shared LU with partial pivoting of analysis-core","// (factorDenseLU_17), without equilibration. It is rejected when a pivot is","// negligible against the largest entry (RELATIVE_PIVOT_TOLERANCE) or the pivot ratio (a condition","// estimate) is below PIVOT_RATIO_TOLERANCE.","struct DenseLU_17 {","  rowScale: array<f32, 17>,","  columnScale: array<f32, 17>,","  pivots: array<u32, 17>,","  size: u32,","  pivotRatio: f32,","  logAbsDeterminant: f32,","  determinantSign: f32,","fn factorDenseLU_17(","  matrix: ptr<function, array<f32, 289>>,","  equilibrationPasses: u32,","  pivotTolerance: f32,","  minimumPivotRatio: f32",") -> DenseLU_17 {","  var result: DenseLU_17;","  result.size = min(size, 17u);","  result.status = 0u;","  result.pivotRatio = 0.0;","  result.logAbsDeterminant = 0.0;","  result.determinantSign = 1.0;","  let count = result.size;","  for (var row = 0u; row < count; row++) {","    result.rowScale[row] = 1.0;","    result.columnScale[row] = 1.0;","    result.pivots[row] = row;","    for (var column = 0u; column < count; column++) {","      if (!isFiniteValue((*matrix)[row * 17u + column])) {","        result.status = 1u;","        return result;","      }","  for (var equilibrationPass = 0u; equilibrationPass < equilibrationPasses; equilibrationPass++) {","    var rowMaximum: array<f32, 17>;","    var columnMaximum: array<f32, 17>;","    for (var row = 0u; row < count; row++) {","      for (var column = 0u; column < count; column++) {","        let magnitude = abs((*matrix)[row * 17u + column]) * result.rowScale[row] * result.columnScale[column];","        rowMaximum[row] = max(rowMaximum[row], magnitude);","        columnMaximum[column] = max(columnMaximum[column], magnitude);","    for (var index = 0u; index < count; index++) {","      if (!(rowMaximum[index] > 0.0) || !(columnMaximum[index] > 0.0)) {","        result.status = 2u;","      result.rowScale[index] = result.rowScale[index] / sqrt(rowMaximum[index]);","      result.columnScale[index] = result.columnScale[index] / sqrt(columnMaximum[index]);","  var largestEntry = 0.0;","      let value = (*matrix)[row * 17u + column] * result.rowScale[row] * result.columnScale[column];","      (*matrix)[row * 17u + column] = value;","      largestEntry = max(largestEntry, abs(value));","  var smallestPivot = 3.402823e38;","  var largestPivot = 0.0;","  for (var column = 0u; column < count; column++) {","    var pivotRow = column;","    for (var row = column + 1u; row < count; row++) {","      if (abs((*matrix)[row * 17u + column]) > abs((*matrix)[pivotRow * 17u + column])) {","        pivotRow = row;","    let pivotMagnitude = abs((*matrix)[pivotRow * 17u + column]);","    if (!isFiniteValue(pivotMagnitude)) {","      result.status = 1u;","      return result;","    if (!(pivotMagnitude > pivotTolerance * largestEntry) || !(pivotMagnitude > 0.0)) {","      result.status = 2u;","    result.pivots[column] = pivotRow;","    if (pivotRow != column) {","      result.determinantSign = -result.determinantSign;","      for (var entry = 0u; entry < count; entry++) {","        let held = (*matrix)[column * 17u + entry];","        (*matrix)[column * 17u + entry] = (*matrix)[pivotRow * 17u + entry];","        (*matrix)[pivotRow * 17u + entry] = held;","    let pivot = (*matrix)[column * 17u + column];","    smallestPivot = min(smallestPivot, pivotMagnitude);","    largestPivot = max(largestPivot, pivotMagnitude);","    result.logAbsDeterminant = result.logAbsDeterminant + log(pivotMagnitude);","    if (pivot < 0.0) {","      let factor = (*matrix)[row * 17u + column] / pivot;","      (*matrix)[row * 17u + column] = factor;","      for (var entry = column + 1u; entry < count; entry++) {","        (*matrix)[row * 17u + entry] = (*matrix)[row * 17u + entry] - factor * (*matrix)[column * 17u + entry];","  for (var index = 0u; index < count; index++) {","    result.logAbsDeterminant = result.logAbsDeterminant - log(result.rowScale[index]) - log(result.columnScale[index]);","  result.pivotRatio = select(1.0, smallestPivot / largestPivot, count > 0u);","  if (result.pivotRatio < minimumPivotRatio) {","    result.status = 3u;","  return result;","fn solveDenseLU_17(","  factorization: ptr<function, DenseLU_17>,","  vector: ptr<function, array<f32, 17>>",") -> bool {","  let count = (*factorization).size;","    (*vector)[row] = (*vector)[row] * (*factorization).rowScale[row];","    let pivotRow = (*factorization).pivots[column];","      let held = (*vector)[column];","      (*vector)[column] = (*vector)[pivotRow];","      (*vector)[pivotRow] = held;","    var value = (*vector)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*matrix)[row * 17u + k] * (*vector)[k];","    (*vector)[row] = value;","  var finite = true;","  for (var offset = 0u; offset < count; offset++) {","    let row = count - 1u - offset;","    for (var k = row + 1u; k < count; k++) {","    (*vector)[row] = value / (*matrix)[row * 17u + row];","    (*vector)[row] = (*vector)[row] * (*factorization).columnScale[row];","    finite = finite && isFiniteValue((*vector)[row]);","  return finite;","fn invertDenseLU_17(","  inverse: ptr<function, array<f32, 289>>","    var unit: array<f32, 17>;","    unit[column] = 1.0;","    finite = solveDenseLU_17(matrix, factorization, &unit) && finite;","      (*inverse)[row * 17u + column] = unit[row];","// Ordinary kriging estimate at one query point. center is the absolute position (used only to","// find index cells); localCenter and origin give the same point as an offset from origin, and","// every distance is a difference of offsets. excludeRow removes one sample (leave-one-out).","fn estimateKriging(center: vec2f, localCenter: vec2f, origin: vec2f, excludeRow: u32) -> KrigingEstimate {","  let radius = params[paramsOffset + 4u];","  let neighborLimitValue = params[paramsOffset + 5u];","  let modelCode = u32(clamp(params[paramsOffset + 6u], 0.0, 4.0));","  let nugget = params[paramsOffset + 7u];","  let sill = params[paramsOffset + 8u];","  let range = params[paramsOffset + 9u];","  let minimumNeighborValue = params[paramsOffset + 10u];","  let neighborLimit = u32(clamp(select(0.0, neighborLimitValue, isFiniteValue(neighborLimitValue)), 0.0, f32(MAX_NEIGHBORS)));","  let minimumNeighbors = max(u32(clamp(select(1.0, minimumNeighborValue, isFiniteValue(minimumNeighborValue)), 0.0, 4294967040.0)), 1u);","  let radiusKey = getRadiusKey(radius);","  let queryBox = getQueryBox(center, radius);","  let queryMin = queryBox.minimum;","  let queryMax = queryBox.maximum;","  let variogramValid = nugget >= 0.0 && sill >= 0.0 && nugget + sill > 0.0 && range > 0.0 && isFiniteValue(range);","  let valid = variogramValid && neighborLimit > 0u && isFiniteValue(center.x) && isFiniteValue(center.y) &&","    radius >= 0.0 && all(queryMax >= DOMAIN_MIN) && all(queryMin <= DOMAIN_MAX);","  var estimate = KrigingEstimate(getNaN(), getNaN(), STATUS_INVALID);","  var nearDistances: array<f32, MAX_NEIGHBORS>;","  var nearRows: array<u32, MAX_NEIGHBORS>;","  var nearCount = 0u;","  if (valid) {","    let clampedMin = max(queryMin, DOMAIN_MIN);","    let clampedMax = min(queryMax, DOMAIN_MAX);","    var columnLow = getCoordinate(clampedMin.x, DOMAIN_MIN.x, DOMAIN_MAX.x, INDEX_WIDTH);","    var rowLow = getCoordinate(clampedMin.y, DOMAIN_MIN.y, DOMAIN_MAX.y, INDEX_HEIGHT);","    columnLow = columnLow - min(columnLow, 1u);","    rowLow = rowLow - min(rowLow, 1u);","    let columnHigh = min(getCoordinate(clampedMax.x, DOMAIN_MIN.x, DOMAIN_MAX.x, INDEX_WIDTH) + 1u, INDEX_WIDTH - 1u);","    let rowHigh = min(getCoordinate(clampedMax.y, DOMAIN_MIN.y, DOMAIN_MAX.y, INDEX_HEIGHT) + 1u, INDEX_HEIGHT - 1u);","    ","    let cellExtent = (DOMAIN_MAX - DOMAIN_MIN) / vec2f(f32(INDEX_WIDTH), f32(INDEX_HEIGHT));","    let cellSlack = min(cellExtent.x, cellExtent.y);","    let centerPoint = clamp(center, DOMAIN_MIN, DOMAIN_MAX);","    let lowColumn = i32(columnLow);","    let highColumn = i32(columnHigh);","    let lowRow = i32(rowLow);","    let highRow = i32(rowHigh);","    let centerColumn = clamp(i32(getCoordinate(centerPoint.x, DOMAIN_MIN.x, DOMAIN_MAX.x, INDEX_WIDTH)), lowColumn, highColumn);","    let centerRow = clamp(i32(getCoordinate(centerPoint.y, DOMAIN_MIN.y, DOMAIN_MAX.y, INDEX_HEIGHT)), lowRow, highRow);","    let lastRing = max(max(centerColumn - lowColumn, highColumn - centerColumn), max(centerRow - lowRow, highRow - centerRow));","    for (var ring = 0; ring <= lastRing; ring++) {","      let ringColumnLow = max(centerColumn - ring, lowColumn);","      let ringColumnHigh = min(centerColumn + ring, highColumn);","      for (var cellRow = max(centerRow - ring, lowRow); cellRow <= min(centerRow + ring, highRow); cellRow++) {","        let isEdgeRow = cellRow == centerRow - ring || cellRow == centerRow + ring;","        for (var side = 0; side < 2; side++) {","          var firstColumn = ringColumnLow;","          var lastColumn = ringColumnHigh;","          if (isEdgeRow) {","            // Top and bottom rows of the ring are one contiguous slot range.","            if (side == 1) { continue; }","          } else {","            // Interior rows of the ring touch only its left and right cells.","            let column = select(centerColumn + ring, centerColumn - ring, side == 0);","            if (column < lowColumn || column > highColumn) { continue; }","            firstColumn = column;","            lastColumn = column;","          }","          let rowBase = u32(cellRow) * INDEX_WIDTH;","          let start = cellOffsets[cellOffsetsOffset + rowBase + u32(firstColumn)];","          let end = cellOffsets[cellOffsetsOffset + rowBase + u32(lastColumn) + 1u];","          for (var slot = start; slot < end; slot++) {","            let sample = sortedIds[sortedIdsOffset + slot];","            if (sample == excludeRow) {","          continue;","        }","        let value = sampleValues[sampleValuesOffset + sample];","        if (isNanBits(value)) {","        let position = vec2f(positions[positionsOffset + 2u * sample], positions[positionsOffset + 2u * sample + 1u]);","        let distanceSquared = getSeparationKey(position - origin, localCenter);","        if (!(distanceSquared <= radiusKey)) {","        let last = neighborLimit - 1u;","        let isFull = nearCount >= neighborLimit;","        if (!isFull || distanceSquared < nearDistances[last] ||","            (distanceSquared == nearDistances[last] && sample < nearRows[last])) {","          var slotPosition = select(nearCount, last, isFull);","          loop {","            if (slotPosition == 0u) { break; }","            let previousDistance = nearDistances[slotPosition - 1u];","            let previousRow = nearRows[slotPosition - 1u];","            if (previousDistance < distanceSquared ||","                (previousDistance == distanceSquared && previousRow < sample)) {","              break;","            }","            nearDistances[slotPosition] = previousDistance;","            nearRows[slotPosition] = previousRow;","            slotPosition -= 1u;","          nearDistances[slotPosition] = distanceSquared;","          nearRows[slotPosition] = sample;","          nearCount = min(nearCount + 1u, neighborLimit);","      if (nearCount >= neighborLimit) {","        // Distance from the center to the nearest border of the visited block that still has","        // unvisited cells behind it.","        var gap = 3.0e38;","        if (centerColumn - ring > lowColumn) {","          gap = min(gap, center.x - (DOMAIN_MIN.x + f32(centerColumn - ring) * cellExtent.x));","        if (centerColumn + ring < highColumn) {","          gap = min(gap, DOMAIN_MIN.x + f32(centerColumn + ring + 1) * cellExtent.x - center.x);","        if (centerRow - ring > lowRow) {","          gap = min(gap, center.y - (DOMAIN_MIN.y + f32(centerRow - ring) * cellExtent.y));","        if (centerRow + ring < highRow) {","          gap = min(gap, DOMAIN_MIN.y + f32(centerRow + ring + 1) * cellExtent.y - center.y);","        gap = gap - cellSlack;","        if (gap > 0.0 && nearDistances[neighborLimit - 1u] < gap * gap) {","          break;","  if (nearCount == 0u) {","    return estimate;","  // Coalesce samples at identical positions into one kriging point carrying their mean value.","  // Identical positions have identical distances, and the list order is deterministic, so the","  // sums are too.","  var uniqueCount = 0u;","  var uniquePositions: array<vec2f, MAX_NEIGHBORS>;","  var uniqueDistances: array<f32, MAX_NEIGHBORS>;","  var uniqueValueSums: array<f32, MAX_NEIGHBORS>;","  var uniqueMultiplicities: array<f32, MAX_NEIGHBORS>;","  for (var i = 0u; i < nearCount; i++) {","    let row = nearRows[i];","    let localPosition = vec2f(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]) - origin;","    let value = sampleValues[sampleValuesOffset + row];","    var matched = false;","    for (var j = 0u; j < uniqueCount; j++) {","      if (all(uniquePositions[j] == localPosition)) {","        uniqueValueSums[j] += value;","        uniqueMultiplicities[j] += 1.0;","        matched = true;","        break;","    if (!matched) {","      uniquePositions[uniqueCount] = localPosition;","      uniqueDistances[uniqueCount] = nearDistances[i];","      uniqueValueSums[uniqueCount] = value;","      uniqueMultiplicities[uniqueCount] = 1.0;","      uniqueCount += 1u;","  // Exact hit: the nearest distinct position coincides with the query.","  if (isExactHit(uniqueDistances[0], uniquePositions[0], localCenter)) {","    return KrigingEstimate(uniqueValueSums[0] / uniqueMultiplicities[0], 0.0, STATUS_OK);","  if (uniqueCount < minimumNeighbors) {","  let n = uniqueCount + 1u;","  var system: array<f32, 289>;","  // The right-hand side, then the weights and the Lagrange multiplier.","  var solution: array<f32, 17>;","  var targetGamma: array<f32, MAX_NEIGHBORS>;","  for (var i = 0u; i < uniqueCount; i++) {","    system[i * SYSTEM_STRIDE + i] = 0.0;","    // The variogram matrix is symmetric: one evaluation fills both triangles.","    for (var j = i + 1u; j < uniqueCount; j++) {","      let gamma = evaluateVariogram(getPairMeters(uniquePositions[i], uniquePositions[j]), modelCode, nugget, sill, range);","      system[i * SYSTEM_STRIDE + j] = gamma;","      system[j * SYSTEM_STRIDE + i] = gamma;","    system[i * SYSTEM_STRIDE + uniqueCount] = 1.0;","    system[uniqueCount * SYSTEM_STRIDE + i] = 1.0;","    targetGamma[i] = evaluateVariogram(getSeparationMeters(uniqueDistances[i]), modelCode, nugget, sill, range);","    solution[i] = targetGamma[i];","  system[uniqueCount * SYSTEM_STRIDE + uniqueCount] = 0.0;","  solution[uniqueCount] = 1.0;","  var factorization = factorDenseLU_17(&system, n, 0u, RELATIVE_PIVOT_TOLERANCE, PIVOT_RATIO_TOLERANCE);","  if (factorization.status != 0u) {","    estimate.status = STATUS_UNCERTAIN;","  solveDenseLU_17(&system, &factorization, &solution);","  let baseValue = uniqueValueSums[0] / uniqueMultiplicities[0];","  var prediction = 0.0;","  var predictionVariance = solution[uniqueCount];","    let weight = solution[i];","    prediction += weight * (uniqueValueSums[i] / uniqueMultiplicities[i] - baseValue);","    predictionVariance += weight * targetGamma[i];","  // Variance is in units of the total sill and nonnegative for a valid model. Only f32 rounding","  // is clamped; a materially negative value means the weights are unreliable.","  if (!(predictionVariance >= -NEGATIVE_VARIANCE_TOLERANCE) || !isFiniteValue(prediction)) {","  return KrigingEstimate(baseValue + prediction, max(predictionVariance, 0.0) * (nugget + sill), STATUS_OK);","@compute @workgroup_size(64)","  _ = &positions;","  _ = &sampleValues;","  _ = &params;","  _ = &cellOffsets;","  _ = &sortedIds;","  _ = &valuesOut;","  _ = &varianceOut;","  _ = &cellStatus;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  let column = index % WIDTH;","  let rasterRow = index / WIDTH;","  let gridStart = vec2f(params[paramsOffset], params[paramsOffset + 1u]);","  let gridEnd = vec2f(params[paramsOffset + 2u], params[paramsOffset + 3u]);","  let cellSize = (gridEnd - gridStart) / vec2f(f32(WIDTH), f32(HEIGHT));","  // Planar offsets from the grid start corner stay small whatever the absolute coordinates are;","  // great-circle distances take absolute lon/lat, so the origin is zero.","  let origin = gridStart;","  let cellOffset = (vec2f(f32(column), f32(rasterRow)) + vec2f(0.5)) * cellSize;","  let center = gridStart + cellOffset;","  let estimate = estimateKriging(center, cellOffset, origin, 0xffffffffu);","  valuesOut[valuesOutOffset + index] = estimate.value;","  varianceOut[varianceOutOffset + index] = estimate.variance;","  cellStatus[cellStatusOffset + index] = estimate.status;","const predictionOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> predictionOut: array<f32>;","const predictionVarianceOutOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> predictionVarianceOut: array<f32>;","  _ = &predictionOut;","  _ = &predictionVarianceOut;","  let value = sampleValues[sampleValuesOffset + index];","  let position = vec2f(positions[positionsOffset + 2u * index], positions[positionsOffset + 2u * index + 1u]);","  var prediction = getNaN();","  var predictionVariance = getNaN();","  if (!isNanBits(value) && isFiniteValue(position.x) && isFiniteValue(position.y)) {","    // Kriged from every OTHER sample: the row itself is excluded from the neighbor search.","    let estimate = estimateKriging(position, position - ORIGIN, ORIGIN, index);","    prediction = estimate.value;","    predictionVariance = estimate.variance;","  predictionOut[predictionOutOffset + index] = prediction;","  predictionVarianceOut[predictionVarianceOutOffset + index] = predictionVariance;","@group(0) @binding(0) var<storage, read> cellStatus: array<u32>;","const invalidCountOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> invalidCountOut: array<atomic<u32>>;","const uncertainCountOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> uncertainCountOut: array<atomic<u32>>;","  _ = &invalidCountOut;","  _ = &uncertainCountOut;","  let status = cellStatus[cellStatusOffset + index];","  if (status == STATUS_INVALID) { atomicAdd(&invalidCountOut[invalidCountOutOffset], 1u); }","  if (status == STATUS_UNCERTAIN) { atomicAdd(&uncertainCountOut[uncertainCountOutOffset], 1u); }","const observedOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> observed: array<f32>;","const predictedOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> predicted: array<f32>;","const varianceOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> variance: array<f32>;","const residualOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> residual: array<f32>;","const standardizedOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> standardized: array<f32>;","  _ = &observed;","  _ = &predicted;","  _ = &variance;","  _ = &residual;","  _ = &standardized;","  let observedValue = observed[observedOffset + index];","let predictedValue = predicted[predictedOffset + index];","let varianceValue = variance[varianceOffset + index];","let difference = observedValue - predictedValue;","let valid = isFiniteValue(observedValue) && isFiniteValue(predictedValue) && isFiniteValue(difference);","let missing = bitcast<f32>(0x7fc00000u | (index & 0u));","residual[residualOffset + index] = select(missing, difference, valid);","var score = missing;","if (valid && isFiniteValue(varianceValue) && varianceValue > 0.0) {","  let candidate = difference / sqrt(varianceValue);","  if (isFiniteValue(candidate)) { score = candidate; }","standardized[standardizedOffset + index] = score;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index];","const residualsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> residuals: array<f32>;","@group(0) @binding(1) var<storage, read> standardized: array<f32>;","const validCountOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> validCount: array<u32>;","const standardizedCountOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> standardizedCount: array<u32>;","const biasOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> bias: array<f32>;","const absoluteErrorOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> absoluteError: array<f32>;","const rootErrorOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> rootError: array<f32>;","const invalidCountOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> invalidCount: array<u32>;","  _ = &residuals;","  _ = &validCount;","  _ = &standardizedCount;","  _ = &bias;","  _ = &absoluteError;","  _ = &rootError;","  _ = &invalidCount;","  var count = 0u; var scoreCount = 0u; var mean = 0.0; var absoluteMean = 0.0;","var scale = 0.0; var squares = 0.0;","for (var row = 0u; row < 4u; row++) {","  let value = residuals[residualsOffset + row];","  scoreCount += select(0u, 1u, isFiniteValue(standardized[standardizedOffset + row]));","  if (!isFiniteValue(value)) { continue; }","  count++; let fraction = 1.0 / f32(count); let magnitude = abs(value);","  mean = mean * (1.0 - fraction) + value * fraction;","  absoluteMean = absoluteMean * (1.0 - fraction) + magnitude * fraction;","  if (magnitude > scale) { let ratio = scale / magnitude; squares = 1.0 + squares * ratio * ratio; scale = magnitude; }","  else if (scale > 0.0) { let ratio = magnitude / scale; squares += ratio * ratio; }","validCount[validCountOffset] = count; standardizedCount[standardizedCountOffset] = scoreCount;","invalidCount[invalidCountOffset] = 4u - count;","bias[biasOffset] = select(missing, mean, count > 0u);","absoluteError[absoluteErrorOffset] = select(missing, absoluteMean, count > 0u);","rootError[rootErrorOffset] = select(missing, scale * sqrt(squares / max(1.0, f32(count))), count > 0u);","@group(0) @binding(0) var<storage, read> source: array<u32>;","@group(0) @binding(1) var<storage, read_write> destination: array<u32>;"],"strings":["buffer","read_write","read","compute","gpu-spatial-analysis-interpolation-diagnostics-recipe-snapshot-tap","lens-output-copy","interpolation-diagnostics-recipe-residuals","imported","transient","interpolation-diagnostics-recipe-kriging-cell-offsets","interpolation-diagnostics-recipe-summary","interpolation-diagnostics-recipe-kriging-cross-validation","interpolation-diagnostics-recipe-kriging-solve","destination","source","GPUKriging","interpolation-diagnostics-recipe-kriging-index-counts-chunk-0","interpolation-diagnostics-recipe-kriging-index-finalize","interpolation-diagnostics-recipe-prediction-variance","interpolation-diagnostics-recipe-predictions","interpolation-diagnostics-recipe-standardized","interpolation-diagnostics-recipe-kriging-index-scatter-0","interpolation-diagnostics-recipe-kriging-index-terminal","interpolation-diagnostics-recipe-kriging-object-ids","positions","wgsl:723c4097","interpolation-diagnostics-recipe-invalid","interpolation-diagnostics-recipe-kriging-count-status","interpolation-diagnostics-recipe-kriging-index-ranks-0","interpolation-diagnostics-recipe-uncertain","interpolation-diagnostics-recipe-absolute-error","interpolation-diagnostics-recipe-bias","interpolation-diagnostics-recipe-kriging-cell-status","interpolation-diagnostics-recipe-kriging-index-rank-0-0","interpolation-diagnostics-recipe-root-error","interpolation-diagnostics-recipe-standardized-count","interpolation-diagnostics-recipe-valid-count","in