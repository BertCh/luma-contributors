 * normalizer; closer = closer || dot(normalized, normalized) < dot(bestNormalized, bestNormalized); }"," return closer;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &offsets;","  _ = &attachment;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var nearest = NO_ATTACHMENT; var bestDifference = vec2<f32>(0.0);","let position = vec2<f32>(positions[positionsOffset + 2u * index], positions[positionsOffset + 2u * index + 1u]);","if (offsets[offsetsOffset + index] == offsets[offsetsOffset + index + 1u] && isFiniteBits(position.x) && isFiniteBits(position.y)) {","for (var other = 0u; other < 24u; other++) { let candidate = vec2<f32>(positions[positionsOffset + 2u * other], positions[positionsOffset + 2u * other + 1u]);"," if (other != index && isFiniteBits(candidate.x) && isFiniteBits(candidate.y)) {"," let difference = position * 0.5 - candidate * 0.5;"," if (isCloserDifference(difference, bestDifference, nearest == NO_ATTACHMENT)) { bestDifference = difference; nearest = other; }"," }","attachment[attachmentOffset + index] = nearest;","@group(0) @binding(0) var<storage, read> attachment: array<u32>;","const slotKeysOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> slotKeys: array<u32>;","const slotIndicesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> slotIndices: array<u32>;","  _ = &slotKeys;","  _ = &slotIndices;","  let attachedRow = attachment[attachmentOffset + index];","slotKeys[slotKeysOffset + index] = select(24u, attachedRow, attachedRow < 24u);","slotIndices[slotIndicesOffset + index] = index;","const sortedKeysOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> sortedKeys: array<u32>;","const segmentOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> segmentOffsets: array<u32>;","fn lowerBoundSortedKeys(first: u32, last: u32, key: u32) -> u32 {","  var low = first;","  var high = max(first, last);","  while (low < high) {","    let middle = low + (high - low) / 2u;","    let value = sortedKeys[sortedKeysOffset + middle];","    if (value < key) {","      low = middle + 1u;","    } else {","      high = middle;","    }","  return low;","fn upperBoundSortedKeys(first: u32, last: u32, key: u32) -> u32 {","    if (value <= key) {","  _ = &sortedKeys;","  _ = &segmentOffsets;","  segmentOffsets[segmentOffsetsOffset + index] = lowerBoundSortedKeys(0u, 24u, index);","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> neighbors: array<u32>;","@group(0) @binding(2) var<storage, read> attachment: array<u32>;","const inverseOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> inverseOffsets: array<u32>;","const inverseIslandsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> inverseIslands: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> counts: array<u32>;","const ROWS: u32 = 24u;","const CAPACITY: u32 = 128u;","const NO_SLOT: u32 = 0xffffffffu;","  _ = &neighbors;","  _ = &inverseOffsets;","  _ = &inverseIslands;","  _ = &counts;","  var count = 0u;","  var originalNext = offsets[offsetsOffset + index];","let originalEnd = offsets[offsetsOffset + index + 1u];","var attached = attachment[attachmentOffset + index];","var inverseNext = inverseOffsets[inverseOffsetsOffset + index];","let inverseEnd = inverseOffsets[inverseOffsetsOffset + index + 1u];","loop {"," var originalId = NO_SLOT; if (originalNext < originalEnd) { originalId = neighbors[neighborsOffset + originalNext]; }"," var inve