 u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","const attachmentOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> attachment: array<u32>;","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","const NO_ATTACHMENT: u32 = 0xffffffffu;","fn isCloserDifference(difference: vec2<f32>, bestDifference: vec2<f32>, isFirst: bool) -> bool {"," let scale = max(max(abs(difference.x), abs(difference.y)), max(abs(bestDifference.x), abs(bestDifference.y)));"," var closer = isFirst;"," if (scale > 0.0) { let exponent = clamp(i32((bitcast<u32>(scale) >> 23u) & 255u) - 127, -120, 120); let normalizer = bitcast<f32>(u32(127 - exponent) << 23u); let normalized = difference * normalizer; let bestNormalized = bestDifference * normalizer; closer = closer || dot(normalized, normalized) < dot(bestNormalized, bestNormalized); }"," return closer;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &offsets;","  _ = &attachment;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var nearest = NO_ATTACHMENT; var bestDifference = vec2<f32>(0.0);","let position = vec2<f32>(positions[positionsOffset + 2u * index], positions[positionsOffset + 2u * index + 1u]);","if (offsets[offsetsOffset + index] == offsets[offsetsOffset + index + 1u] && isFiniteBits(position.x) && isFiniteBits(position.y)) {","for (var other = 0u; other < 24u; other++) { let candidate = vec2<f32>(positions[positionsOffset + 2u * other], positions[positionsOffset + 2u * other + 1u]);"," if (other != index && isFiniteBits(candidate.x) && isFiniteBits(candidate.y)) {"," let difference = position * 0.5 - candidate * 0.5;"," if (isCloserDifference(difference, bestDifference, nearest == NO_ATTACHMENT)) { bestDifference = difference; nearest = other; }"," }","attachment[attachmentOffset + index] = nearest;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","  _ = &fillTarget;","  fillTarget[fillTargetOffset + index] = 0u;","@group(0) @binding(0) var<storage, read> attachment: array<u32>;","const slotKeysOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> slotKeys: array<u32>;","const slotIndicesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> slotIndices: array<u32>;","  _ = &slotKeys;","  _ = &slotIndices;","  let attachedRow = attachment[attachmentOffset + index];","slotKeys[slotKeysOffset + index] = select(24u, attachedRow, attachedRow < 24u);","slotIndices[slotIndicesOffset + index] = index;","const sortedKeysOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> sortedKeys: array<u32>;","const segmentOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> segmentOffsets: array<u32>;","fn lowerBoundSortedKeys(first: u32, last: u32, key: u32) -> u32 {","  var low = first;","  var high = max(first, last);","  while (low < high) {","    let middle = low + (high - low) / 2u;","    let value = sortedKeys[sortedKeysOffset + middle];","    if (value < key) {","      low = middle + 1u;","    } else {","      high = middle;","    }","  return low;","fn upperBoundSortedKeys(first: u32, last: u32, key: u32) -> u32 {","    if (value <= key) {","  _ = &sortedKeys;","  _ = &segmentOffsets;","  segmentOffsets[segmentOffsetsOffset + index] = lowerBoundSortedKeys(0u, 24u, index);","@group(