let position = vec2<f32>(positions[positionsOffset + 2u * index], positions[positionsOffset + 2u * index + 1u]);","if (offsets[offsetsOffset + index] == offsets[offsetsOffset + index + 1u] && isFiniteBits(position.x) && isFiniteBits(position.y)) {"," for (var other = 0u; other < 24u; other++) { let candidate = vec2<f32>(positions[positionsOffset + 2u * other], positions[positionsOffset + 2u * other + 1u]);"," if (other != index && isFiniteBits(candidate.x) && isFiniteBits(candidate.y)) {"," // Halving before subtraction prevents overflow for opposite finite coordinates. Compare both"," // distances at their shared scale so squared norms neither overflow nor collapse to zero."," // Keep the scale multiplier normal even on devices that flush subnormal factors."," let difference = position * 0.5 - candidate * 0.5;"," let scale = max(max(abs(difference.x), abs(difference.y)), max(abs(bestDifference.x), abs(bestDifference.y)));"," var closer = nearest == 0xffffffffu;"," if (scale > 0.0) { let exponent = clamp(i32((bitcast<u32>(scale) >> 23u) & 255u) - 127, -120, 120); let normalizer = bitcast<f32>(u32(127 - exponent) << 23u); let normalized = difference * normalizer; let bestNormalized = bestDifference * normalizer; closer = closer || dot(normalized, normalized) < dot(bestNormalized, bestNormalized); }"," if (closer) { bestDifference = difference; nearest = other; }"," }","attachment[attachmentOffset + index] = nearest;","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> neighbors: array<u32>;","@group(0) @binding(2) var<storage, read> attachment: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> counts: array<u32>;","fn addedEdge(row: u32, other: u32) -> bool { return row != other && (attachment[attachmentOffset + row] == other || attachment[attachmentOffset + other] == row); }","fn findEdge(row: u32, other: u32) -> u32 {"," var begin = offsets[offsetsOffset + row]; var end = offsets[offsetsOffset + row + 1u];"," while (begin < end) { let middle = begin + (end - begin) / 2u; let candidate = neighbors[neighborsOffset + middle]; if (candidate == other) { return middle; } if (candidate < other) { begin = middle + 1u; } else { end = middle; } }"," return 0xffffffffu;","  _ = &neighbors;","  _ = &counts;","  var count = 0u;","for (var other = 0u; other < 24u; other++) { if (findEdge(index, other) != 0xffffffffu || addedEdge(index, other)) { count++; } }","counts[countsOffset + index] = count;","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const outputOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> outputOffsets: array<u32>;","const overflowOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> overflow: array<u32>;","const requiredOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> required: array<u32>;","  _ = &outputOffsets;","  _ = &overflow;","  _ = &required;","  var total = 0u;","for (var row = 0u; row < 24u; row++) { outputOffsets[outputOffsetsOffset + row] = min(total, 128u); total += counts[countsOffset + row]; }","outputOffsets[outputOffsetsOffset + 24u] = min(total, 128u);","overflow[overflowOffset] = select(0u, 1u, total > 128u);","required[requiredOffset] = total;","const weightsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> weights: array<f32>;","@group(0) @binding(4) var<storage, read> outputOffsets: array<u32>;","const outputNeighborsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> outputNeighbors: array<u32>;","const outputWeightsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> outputWeights: array<f32>;","const addedOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> added: array<u32>;","  _ = &weights;","  _ = &outputNeighbors;","  _ = &outputWeights;","  _ = &added;","  var destination = outputOffsets[outputOffsetsOffset + index]; let end = outputOffsets[outputOffsetsOffset + index + 1u];","for (var other = 0u; other < 24u && destination < end; other++) { let original = findEdge(index, other);"," if (original != 0xffffffffu || addedEdge(index, other)) { var weight = 1.0; if (original != 0xffffffffu) { weight = weights[weightsOffset + original]; }"," outputNeighbors[outputNeighborsOffset + destination] = other; outputWeights[outputWeightsOffset + destination] = weight; added[addedOffset + destination] = select(0u, 1u, original == 0xffffffffu); destination++; }"],"strings":["island-attachment-write","island-attachment-counts","buffer","imported","read","island-attachment-offsets","statistics-output-4","GPUIslandAttachment","island-attachment-nearest","read_write","statistics-output-1","statistics-weights-offsets","statistics-weights-neighbors","compute","island-attachment","offsets","statistics-output-2","statistics-output-3","statistics-output-5","statistics-output-6","statistics-output-7","attachment","counts","statistics-input-0","statistics-weights-values","neighbors","outputOffsets"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[["~:2","~f","~b","~4","u32",0,25],["~:3",[1,1,1],24,false],["~:2","~l","~6","~4","u32",0,24],["~:2","~p","~c","~4","u32",0,92]]}}
