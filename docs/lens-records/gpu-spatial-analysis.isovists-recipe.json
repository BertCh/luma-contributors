n:vec2<f32>,maximum:f32,segmentIndex:u32)->vec2<f32>{"," let segment=readSegment(segmentIndex);let edge=segment.zw-segment.xy;let displacement=segment.xy-origin;let denominator=crossVectors(direction,edge);var candidate=maximum;var intersects=false;"," if(distanceToSegment(origin,segment)<=9.999999974752427e-7){candidate=0.0;intersects=true;}"," else if(abs(denominator)>9.999999974752427e-7){","  let rayDistance=crossVectors(displacement,edge)/denominator;let fraction=crossVectors(displacement,direction)/denominator;","  if(rayDistance>=0.0&&fraction>=0.0&&fraction<=1.0){candidate=rayDistance;intersects=true;}"," }else if(abs(crossVectors(displacement,direction))<=9.999999974752427e-7){","  let first=dot(displacement,direction);let second=dot(segment.zw-origin,direction);","  if(max(first,second)>=0.0){candidate=max(0.0,min(first,second));intersects=true;}"," }"," return vec2<f32>(candidate,f32(intersects));","fn castRay(origin:vec2<f32>,direction:vec2<f32>,maximum:f32)->vec2<f32>{"," var nearest=maximum;var hit=-1.0;"," for(var segmentIndex=0u;segmentIndex<4u;segmentIndex++){","  let blocked=getSegmentCandidate(origin,direction,maximum,segmentIndex);","  if(blocked.y>0.0&&blocked.x<=nearest&&(blocked.x<nearest||hit<0.0)){nearest=blocked.x;hit=f32(segmentIndex);}"," return vec2<f32>(nearest,hit);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &segments;","  _ = &classifications;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let point=vec2<f32>(positions[positionsOffset+2u*index],positions[positionsOffset+2u*index+1u]);","var valid=isFiniteValue(point.x)&&isFiniteValue(point.y);","var boundary=false;","var winding=0;","for(var segmentIndex=0u;segmentIndex<4u;segmentIndex++){","  let segment=readSegment(segmentIndex);","  valid=valid&&isFiniteValue(segment.x)&&isFiniteValue(segment.y)&&isFiniteValue(segment.z)&&isFiniteValue(segment.w);","  boundary=boundary||distanceToSegment(point,segment)<=0.000001;","  let cross=crossVectors(segment.zw-segment.xy,point-segment.xy);","  if(segment.y<=point.y&&segment.w>point.y&&cross>0.0){winding++;}","  if(segment.y>point.y&&segment.w<=point.y&&cross<0.0){winding--;}","let inside=(abs(winding)%2)==1;","let allowed=inside;","classifications[classificationsOffset+index]=select(select(select(1u,0u,allowed),2u,boundary),3u,!valid);","const anglesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> angles: array<f32>;","fn guardedAtan2(y: f32, x: f32) -> f32 {","  return select(atan2(y, x), sign(y) * 1.5707963267948966, x == 0.0);","@compute @workgroup_size(2)","  _ = &angles;","  if (workgroupIndex >= 2147483648u) { return; }","  let index = workgroupIndex * 2u + localInvocationIndex;","  for(var ray=0u;ray<8u;ray++){","  angles[anglesOffset+index*8u+ray]=6.283185307179586*f32(ray)/8.0;","@group(0) @binding(0) var<storage, read> angles: array<f32>;","@group(0) @binding(1) var<storage, read> positions: array<f32>;","@group(0) @binding(2) var<storage, read> segments: array<f32>;","const distancesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> distances: array<f32>;","const hitsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> hits: array<u32>;","  _ = &distances;","  _ = &hits;","  let viewpoint=index/8u;","let angle=angles[anglesOffset+index];","let direction=vec2<f32>(cos(angle),sin(angle));","let origin=vec2<f32>(positions[positionsOffset+2u*viewpoint],positions[positionsOffset+2u*viewpoint+1u]);","let hit=castRay(origin,direction,10);","distances[distancesOffset+index]=hit.x;","hits[hitsOffset+index]=select(0xffffffffu,u3