*side;","let maximum=2.0*cells - 2.0*side-select(0.0,select(2.0,1.0,remainder<=side),remainder>0.0);","var aggregate=missing;if(maximum>0.0){aggregate=100.0*likeSides/(2.0*maximum);}","writeOutput(index,vec4<f32>(area,perimeter,mesh,cohesion));aggregation[aggregationOffset+index]=aggregate;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index];","@group(0) @binding(0) var<storage, read> source: array<u32>;","@group(0) @binding(1) var<storage, read_write> destination: array<u32>;","@group(0) @binding(0) var<storage, read> classes: array<f32>;","const adjacencyOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> adjacency: array<u32>;","fn readClasses(row:u32)->vec4<f32>{return vec4<f32>(classes[classesOffset+row*4u+0u],classes[classesOffset+row*4u+1u],classes[classesOffset+row*4u+2u],classes[classesOffset+row*4u+3u]);}","  _ = &adjacency;","  var area=0.0;var mesh=0.0;var present=0.0;","for(var category=0u;category<2u;category++){let values=readClasses(category);area+=values.x;mesh+=values.z;present+=f32(values.x>0.0);}","var entropy=0.0;var adjacencyComplete=true;var totalAdjacency=0.0;for(var pair=0u;pair<4u;pair++){totalAdjacency+=f32(adjacency[adjacencyOffset+pair]);}","for(var sourceClass=0u;sourceClass<2u;sourceClass++){"," var total=0.0;for(var targetClass=0u;targetClass<2u;targetClass++){total+=f32(adjacency[adjacencyOffset+sourceClass*2u+targetClass]);}"," let proportion=readClasses(sourceClass).x/area;"," if(proportion>0.0&&total==0.0){adjacencyComplete=false;}"," for(var targetClass=0u;targetClass<2u;targetClass++){let probability=proportion*f32(adjacency[adjacencyOffset+sourceClass*2u+targetClass])/total;if(probability>0.0){entropy+=probability*log(probability);}}","var contagion=bitcast<f32>(0x7fc00000u | (index & 0u));if(present>1.0&&adjacencyComplete){contagion=100.0*(1.0+entropy/(2.0*log(present)));}","writeOutput(0u,vec4<f32>(contagion,mesh,area,present));","const patchClassesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> patchClasses: array<u32>;","@group(0) @binding(2) var<storage, read> classes: array<f32>;","@group(0) @binding(3) var<storage, read> aggregation: array<f32>;","const landscapeAggregationOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> landscapeAggregation: array<f32>;","const landscapeCohesionOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> landscapeCohesion: array<f32>;","  _ = &patchClasses;","  _ = &landscapeAggregation;","  _ = &landscapeCohesion;","  var cells=0.0;var perimeter=0.0;var weightedPerimeter=0.0;"," let category=patchClasses[patchClassesOffset+patchIndex];if(category>=2u||category==4294967295u){continue;}"," let patchCells=patches[patchesOffset+4u*patchIndex+2u];let patchPerimeter=patches[patchesOffset+4u*patchIndex+1u];cells+=patchCells;perimeter+=patchPerimeter;weightedPerimeter+=patchPerimeter*sqrt(patchCells);","var weightedAggregation=0.0;var area=0.0;","for(var category=0u;category<2u;category++){"," let classArea=classes[classesOffset+4u*category];let aggregate=aggregation[aggregationOffset+category];area+=classArea;"," // The pinned landscapemetrics landscape convention omits undefined single-cell class indices."," if(classArea>0.0&&aggregate>=0.0){weightedAggregation+=classArea*aggregate;}","let missing=bitcast<f32>(0x7fc00000u | (index & 0u));var aggregate=missing;var cohesion=missing;","if(area>0.0){aggregate=weightedAggregation/area;}","if(cells>1.0&&weightedPerimeter>0.0){cohesion=100.0*(1.0-perimeter/weightedPerimeter)/(1.0-inverseSqrt(cells));}","landscapeAggregation[landscapeAggregationOffset]=aggregate;landscapeCohesion[landscapeCohesionOffset]=cohesion;"],"strings":["read","buffer","lens-output-copy","read_write","landscape-metrics-classes","