ffset+index];","labels[labelsOffset+index]=select(0u,owner+1u,owner<2u);","}","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","  _ = &fillTarget;","  fillTarget[fillTargetOffset + index] = 0u;","@group(0) @binding(0) var<storage, read> labels: array<u32>;","const keysOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> keys: array<u32>;","  _ = &keys;","  let label = labels[labelsOffset + index];","  let accepted = label != 0u && label <= 2u;","  keys[keysOffset + index] = select(0u, label, accepted);","@group(0) @binding(0) var<storage, read> keys: array<u32>;","const classesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> classes: array<u32>;","const patchLikeSidesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> patchLikeSides: array<atomic<u32>>;","const classCellsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> classCells: array<atomic<u32>>;","const classLikeSidesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> classLikeSides: array<atomic<u32>>;","const adjacencyOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> adjacency: array<atomic<u32>>;","const WIDTH:u32=4u;","fn getClass(key:u32)->u32 {","  if(key==0u){return 0xffffffffu;}","  let category=classes[classesOffset+key-1u];","  return select(category,0xffffffffu,category==4294967295u);","  _ = &classes;","  _ = &patchLikeSides;","  _ = &classCells;","  _ = &classLikeSides;","  _ = &adjacency;","  let segmentsPerRow = 1u;","  let row = index / segmentsPerRow;","  let segmentStart = (index % segmentsPerRow) * 16u;","  let segmentEnd = min(segmentStart + 16u, WIDTH);","  let rowBase = row * WIDTH;","  var runKey = 0u;","  var runStart = segmentStart;","  var likeSides=0u;var sides=vec2<u32>(0u);","  // The extra iteration at segmentEnd sees a sentinel key that flushes the last run.","  for (var column = segmentStart; column <= segmentEnd; column++) {","    var key = 0xffffffffu;","    if (column < segmentEnd) {","      key = keys[keysOffset + rowBase + column];","    }","    if (key != runKey) {","      if (runKey != 0u) {","        let runEnd = column;","        let owner=runKey-1u;","atomicAdd(&patchLikeSides[patchLikeSidesOffset+owner],likeSides);","let category=getClass(runKey);","if(category<2u){","  atomicAdd(&classCells[classCellsOffset+category],runEnd-runStart);","  atomicAdd(&classLikeSides[classLikeSidesOffset+category],likeSides);","  atomicAdd(&adjacency[adjacencyOffset+category*2u+category],likeSides);","      }","      runKey = key;","      runStart = column;","      likeSides=0u;sides=vec2<u32>(0u);","    if (column < segmentEnd && key != 0u) {","      let category=getClass(key);","let directions=array<vec2<i32>,4>(vec2<i32>(-1,0),vec2<i32>(1,0),vec2<i32>(0,-1),vec2<i32>(0,1));","for(var direction=0u;direction<4u;direction++){","  let adjacent=vec2<i32>(i32(column),i32(row))+directions[direction];","  let exterior=any(adjacent < vec2<i32>(0))||adjacent.x>=4||adjacent.y>=2;","  var neighbor=0u;","  if(!exterior){neighbor=keys[keysOffset+u32(adjacent.y)*WIDTH+u32(adjacent.x)];}","  let neighborClass=getClass(neighbor);","  likeSides+=u32(neighborClass==category);","  if(category<2u&&neighborClass<2u&&neighborClass!=category){","    atomicAdd(&adjacency[adjacencyOffset+category*2u+neighborClass],1u);","  ","const pixelCountsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> pixelCounts: array<atomic<u32>>;","const WIDTH: u32 = 4u;","const HEIGHT: u32 = 2u;","  _ = &pixelCounts;","        atomicAdd(&pixelCounts[pixelCountsOffset + runKey - 1u], runEnd - runStart);","      ","    ","const acrossRowsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> acrossRows: array<atomic<u32>>;","const acrossColumnsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> acrossColumns: array<atomic<u32>>;","const COUNT_BORDER: bool = true;","// Whether the neighbor at (column + d