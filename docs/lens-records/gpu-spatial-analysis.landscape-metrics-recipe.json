) var<storage, read_write> output: array<f32>;","fn getPatch(column: i32, row: i32) -> u32 {","  if(column<0 || row<0 || column>=4 || row>=2){return 0xffffffffu;}","  return patches[patchesOffset+u32(row)*4u+u32(column)];","}","fn getClass(patchIndex: u32) -> u32 {","  if(patchIndex>=2u){return 0xffffffffu;}","  let category=classes[classesOffset+patchIndex];","  return select(category,0xffffffffu,category==4294967295u);","fn readOutput(row:u32)->vec4<f32>{return vec4<f32>(output[outputOffset+row*4u+0u],output[outputOffset+row*4u+1u],output[outputOffset+row*4u+2u],output[outputOffset+row*4u+3u]);}","fn writeOutput(row:u32,value:vec4<f32>){output[outputOffset+row*4u+0u]=value[0u];output[outputOffset+row*4u+1u]=value[1u];output[outputOffset+row*4u+2u]=value[2u];output[outputOffset+row*4u+3u]=value[3u];}","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &patches;","  _ = &classes;","  _ = &output;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var cells=0.0;var perimeter=0.0;var likeSides=0.0;","for(var cell=0u;cell<8u;cell++){"," if(patches[patchesOffset+cell]!=index){continue;}"," cells+=1.0;let column=i32(cell%4u);let row=i32(cell/4u);"," let neighbors=array<u32,4>(getPatch(column - 1,row),getPatch(column+1,row),getPatch(column,row - 1),getPatch(column,row+1));"," for(var direction=0u;direction<4u;direction++){","  let exterior=(direction==0u&&column==0)||(direction==1u&&column==3)||(direction==2u&&row==0)||(direction==3u&&row==1);","  let background=getClass(neighbors[direction])>=2u;","  let countContact=select(select(true,true,background),true,exterior);","  if(ne