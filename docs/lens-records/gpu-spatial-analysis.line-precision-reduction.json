5535u) + (low >> 16u);","  let middleSecond = (first & 65535u) * (second >> 16u) + (middleFirst & 65535u);","  return vec2u((middleSecond << 16u) | (low & 65535u),","    (first >> 16u) * (second >> 16u) + (middleFirst >> 16u) + (middleSecond >> 16u));","fn gridRoundAdd(words: ptr<function, array<u32, 10>>, index: u32, value: u32) {","  var carry = value;","  for (var slot = index; slot < 10u && carry != 0u; slot++) {","    let previous = (*words)[slot];","    let sum = previous + carry;","    (*words)[slot] = sum;","    carry = select(0u, 1u, sum < previous);","  }","fn gridRoundTerm(positive: ptr<function, array<u32, 10>>, negative: ptr<function, array<u32, 10>>, value: f32, multiplier: i32) {","  let bits = bitcast<u32>(value);","  let exponent = (bits >> 23u) & 255u;","  let significand = (bits & 8388607u) | select(8388608u, 0u, exponent == 0u);","  let product = gridRoundMultiply(significand, u32(abs(multiplier)));","  // All terms are integer multiples of 2^-149, including subnormal coordinates/spacing.","  let shift = select(exponent - 1u, 0u, exponent == 0u);","  let word = shift / 32u;","  let remainder = shift % 32u;","  var parts = vec3u(product, 0u);","  if (remainder != 0u) {","    parts = vec3u(product.x << remainder,","      (product.y << remainder) | (product.x >> (32u - remainder)),","      product.y >> (32u - remainder));","  let subtract = ((bits & 0x80000000u) != 0u) != (multiplier < 0);","  for (var part = 0u; part < 3u; part++) {","    if (subtract) { gridRoundAdd(negative, word + part, parts[part]); }","    else { gridRoundAdd(positive, word + part, parts[part]); }","fn gridRoundCompare(value: f32, origin: f32, spacing: f32, twiceBoundary: i32) -> i32 {","  var positive: array<u32, 10>;","  var negative: array<u32, 10>;","  // Sign of 2*(value-origin) - twiceBoundary*spacing, without rounded products/differences.","  gridRoundTerm(&positive, &negative, value, 2);","  gridRoundTerm(&positive, &negative, origin, -2);","  gridRoundTerm(&positive, &negative, spacing, -twiceBoundary);","  for (var word = 9; word >= 0; word--) {","    if (positive[u32(word)] > negative[u32(word)]) { return 1; }","    if (positive[u32(word)] < negative[u32(word)]) { return -1; }","  return 0;","fn roundGridHalfUp(value: f32, origin: f32, spacing: f32) -> f32 {","  let steps = (value - origin) / spacing;","  let candidate = roundHalfUp(steps);","  // Beyond the documented exact cell range retain the old bounded/uncertain route.","  if ((bitcast<u32>(steps) & 0x7fffffffu) >= 0x4b800000u ||","      (bitcast<u32>(value) & 0x7f800000u) == 0x7f800000u ||","      (bitcast<u32>(origin) & 0x7f800000u) == 0x7f800000u) { return candidate; }","  var cell = i32(candidate);","  // A rounded difference and reciprocal product put the candidate within four cells for","  // |steps| < 2^24. Exact boundary tests decide half-up ties, including negative coordinates.","  for (var correction = 0u; correction < 4u; correction++) {","    if (gridRoundCompare(value, origin, spacing, 2 * cell - 1) < 0) { cell--; }","    else if (gridRoundCompare(value, origin, spacing, 2 * cell + 1) >= 0) { cell++; }","    else { break; }","  return f32(cell);","fn oddFloatSignificand(value: f32) -> vec2i {","  let biased = (bits >> 23u) & 255u;","  var significand = (bits & 8388607u) | select(8388608u, 0u, biased == 0u);","  var exponent = select(i32(biased) - 150, -149, biased == 0u);","  for (var shift = 0u; shift < 24u && significand != 0u && (significand & 1u) == 0u; shift++) {","    significand = significand >> 1u; exponent++;","  return vec2i(i32(significand), exponent);","fn isExactGridMultiple(value: f32, step: f32) -> bool {","  if (value == 0.0) { return true; }","  let numerator = oddFloatSignificand(value);","  let denominator = oddFloatSignificand(step);","  return u32(numerator.x) % u32(denominator.x) == 0u && numerator.y >= denominator.y;","fn roundLineGridCoordinate(value: f32, step: f32) -> f32 {","  let large = (bitcast<u32>(value / step) & 0x7fffffffu) >= 0x4b800000u;","  if (large && (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u && isExactGridMultiple(value, step)) {","    return value;","  return roundGridHalfUp(value, 0.0, step) * step;","const GRID: f32 = 1.0;","fn point(row: u32) -> vec2f { return vec2f(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]); }","fn writePoint(vertex: u32, value: vec2f) { outPositions[outPositionsOffset + vertex * 2u] = value.x; outPositions[outPositionsOffset + vertex * 2u + 1u] = value.y; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &offsets;","  _ = &outPositions;","  _ = &keptCounts;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  if (index == 1u) { keptCounts[keptCountsOffset + index] = 0u; return; }","let line = index;","let first = min(offsets[offsetsOffset + line], 2u);","let last = min(offsets[offsetsOffset + line + 1u], 2u);","var kept = 0u; var previous = vec2f(0.0); var invalid = false;","for (var vertex = first; vertex < last; vertex++) {","  let value = point(vertex);","  if (any((bitcast<vec2u>(value) & vec2u(0x7f800000u)) == vec2u(0x7f800000u))) { invalid = true; }","  // Round half up from the exact fraction. floor(scaled + 0.5) is wrong in f32 wherever the sum","  // is inexact: odd integers from 2^23 move to the even neighbour, and 0.49999997 rounds to 1.","  let rounded = vec2f(roundLineGridCoordinate(value.x, GRID), roundLineGridCoordinate(value.y, GRID));","  if (any((bitcast<vec2u>(rounded) & vec2u(0x7f800000u)) == vec2u(0x7f800000u))) { invalid = true; }","  if (kept == 0u || any(rounded != previous)) { writePoint(first + kept, rounded); previous = rounded; kept++; }","var resultStatus = 0u;","if (invalid) { kept = 0u; resultStatus = 3u; }","else if (kept == 1u) {","  if (last - first >= 2u) { writePoint(first + 1u, previous); kept = 2u; resultStatus = 2u; } else { kept = 0u; resultStatus = 1u; }","keptCounts[keptCountsOffset + line] = kept; status[statusOffset + line] = resultStatus;","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","const stagedOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> staged: array<f32>;","@group(0) @binding(2) var<storage, read> keptCounts: array<u32>;","const outOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> outOffsets: array<u32>;","@group(0) @binding(4) var<storage, read_write> outPositions: array<f32>;","  _ = &staged;","  _ = &outOffsets;","  let first = min(offsets[offsetsOffset + index], 2u);","let destination = outOffsets[outOffsetsOffset + index];","for (var vertex = 0u; vertex < keptCounts[keptCountsOffset + index]; vertex++) {","  outPositions[outPositionsOffset + (destination + vertex) * 2u] = staged[stagedOffset + (first + vertex) * 2u];","  outPositions[outPositionsOffset + (destination + vertex) * 2u + 1u] = staged[stagedOffset + (first + vertex) * 2u + 1u];"],"strings":["line-precision-reduction-reduce","gpu-spatial-analysis-line-precision-reduction-snapshot-tap","line-precision-reduction-compact","line-precision-reduction-kept-counts","buffer","line-precision-reduction-staged","logical","rounded-offsets","status","line-offsets","line-precision-reduction-scan-level-0-scan","read","rounded-positions","imported","positions","GPULinePrecisionReduction","read_write","compute","GPUScan","keptCounts","offsets","outPositions","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUN