TION_COUNT) {","    return;","  }","  if (index == 1u) { keptCounts[keptCountsOffset + index] = 0u; return; }","let line = index;","let first = min(offsets[offsetsOffset + line], 2u);","let last = min(offsets[offsetsOffset + line + 1u], 2u);","var kept = 0u; var previous = vec2f(0.0); var invalid = false;","for (var vertex = first; vertex < last; vertex++) {","  let value = point(vertex);","  if (any((bitcast<vec2u>(value) & vec2u(0x7f800000u)) == vec2u(0x7f800000u))) { invalid = true; }","  // Round half up from the exact fraction. floor(scaled + 0.5) is wrong in f32 wherever the sum","  // is inexact: odd integers from 2^23 move to the even neighbour, and 0.49999997 rounds to 1.","  let scaled = value / GRID;","  let lower = floor(scaled);","  let rounded = (lower + step(vec2f(0.5), scaled - lower)) * GRID;","  if (any((bitcast<vec2u>(rounded) & vec2u(0x7f800000u)) == vec2u(0x7f800000u))) { invalid = true; }","  if (kept == 0u || any(rounded != previous)) { writePoint(first + kept, rounded); previous = rounded; kept++; }","}","var resultStatus = 0u;","if (invalid) { kept = 0u; resultStatus = 3u; }","else if (kept == 1u) {","  if (last - first >= 2u) { writePoint(first + 1u, previous); kept = 2u; resultStatus = 2u; } else { kept = 0u; resultStatus = 1u; }","keptCounts[keptCountsOffset + line] = kept; status[statusOffset + line] = resultStatus;","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","const stagedOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> staged: array<f32>;","@group(0) @binding(2) var<storage, read> keptCounts: array<u32>;","const outOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> outOffsets: array<u32>;","@group(0) @binding(4) var<storage, read_write> outPositions: array<f32>;","  _ = &staged;","  _ = &outOffsets;","  let first = min(offsets[offsetsOffset + index], 2u);","let destination = outOffsets[outOffsetsOffset + index];","for (var vertex = 0u; vertex < keptCounts[keptCountsOffset + index]; vertex++) {","  outPositions[outPositionsOffset + (destination + vertex) * 2u] = staged[stagedOffset + (first + vertex) * 2u];","  outPositions[outPositionsOffset + (destination + vertex) * 2u + 1u] = staged[stagedOffset + (first + vertex) * 2u + 1u];"],"strings":["line-precision-reduction-reduce","gpu-spatial-analysis-line-precision-reduction-snapshot-tap","line-precision-reduction-compact","line-precision-reduction-kept-counts","buffer","line-precision-reduction-staged","rounded-offsets","status","line-offsets","line-precision-reduction-scan-level-0-scan","read","rounded-positions","imported","positions","GPULinePrecisionReduction","read_write","compute","GPUScan","keptCounts","offsets","outPositions","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","reads","writes","workload","attrs"],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:3","~j","~8","~a","u32",0,2]]}}
