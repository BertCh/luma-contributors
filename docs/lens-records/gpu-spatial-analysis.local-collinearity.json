al = (*factor)[column * 2u + column];","    let radius = sqrt(diagonal * diagonal + value * value);","    let cosine = diagonal / radius;","    let sine = value / radius;","    for (var entry = column; entry < 2u; entry++) {","      let held = (*factor)[column * 2u + entry];","      let incoming = (*row)[entry];","      (*factor)[column * 2u + entry] = cosine * held + sine * incoming;","      (*row)[entry] = cosine * incoming - sine * held;","  }","// Diagonal entry of (R^T R)^-1 = R^-1 R^-T, the variance inflation factor when the design columns","// have unit norm. R is upper triangular and must be nonsingular.","fn getDesignFactorInverseDiagonal_2(factor: ptr<function, array<f32, 4>>, column: u32) -> f32 {","  var total = 0.0;","  for (var last = column; last < 2u; last++) {","    // Solve R x = e_target by back substitution; only x[column] is accumulated.","    var solution: array<f32, 2>;","    solution[last] = 1.0 / (*factor)[last * 2u + last];","    for (var offset = 1u; offset <= last; offset++) {","      let row = last - offset;","      var value = 0.0;","      for (var other = row + 1u; other <= last; other++) {","        value += (*factor)[row * 2u + other] * solution[other];","      }","      solution[row] = -value / (*factor)[row * 2u + row];","    total += solution[column] * solution[column];","  return total;","// One-sided Jacobi on the factor columns. vectors is column-major (right singular vectors);","// returns false when the sweeps are exhausted.","fn getDesignSingularValues_2(","  factor: ptr<function, array<f32, 4>>,","  vectors: ptr<function, array<f32, 4>>,","  values: ptr<function, array<f32, 2>>",") -> bool {","  var columns: array<f32, 4>;","    for (var row = 0u; row < 2u; row++) {","      columns[column * 2u + row] = (*factor)[row * 2u + column];","      (*vectors)[column * 2u + row] = select(0.0, 1.0, row == column);","  var converged = false;","  for (var sweep = 0u; sweep < 64u; sweep++) {","    var rotated = false;","    for (var first = 0u; first + 1u < 2u; first++) {","      for (var second = first + 1u; second < 2u; second++) {","        var normFirst = 0.0;","        var normSecond = 0.0;","        var product = 0.0;","        for (var row = 0u; row < 2u; row++) {","          let x = columns[first * 2u + row];","          let y = columns[second * 2u + row];","          normFirst += x * x;","          normSecond += y * y;","          product += x * y;","        }","        if (!(abs(product) > 1.0e-6 * sqrt(normFirst * normSecond))) {","          continue;","        rotated = true;","        let zeta = (normSecond - normFirst) / (2.0 * product);","        let tangent = select(-1.0, 1.0, zeta >= 0.0) / (abs(zeta) + sqrt(1.0 + zeta * zeta));","        let cosine = inverseSqrt(1.0 + tangent * tangent);","        let sine = cosine * tangent;","          columns[first * 2u + row] = cosine * x - sine * y;","          columns[second * 2u + row] = sine * x + cosine * y;","          let vectorFirst = (*vectors)[first * 2u + row];","          let vectorSecond = (*vectors)[second * 2u + row];","          (*vectors)[first * 2u + row] = cosine * vectorFirst - sine * vectorSecond;","          (*vectors)[second * 2u + row] = sine * vectorFirst + cosine * vectorSecond;","    if (!rotated) {","      converged = true;","      break;","    var norm = 0.0;","      norm += columns[column * 2u + row] * columns[column * 2u + row];","    (*values)[column] = sqrt(norm);","  return converged;","fn included(row: u32) -> bool {","  if (row >= 24u) { return false; }","  if (mask[maskOffset + row] == 0u) { return false; }","    if (!isFiniteBits(predictors[predictorsOffset + row * 2u + column])) { return false; }","  return true;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &offsets;","  _ = &neighbors;","  _ = &weights;","  _ = &predictors;","  _ = &mask;","  _ = &inflation;","  _ = &condition;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  status[statusOffset + index] = 1u;","condition[conditionOffset + index] = getNaN();","for (var column = 0u; column < 2u; column++) {","  inflation[inflationOffset + index * 2u + column] = getNaN();","let slotBegin = offsets[offsetsOffset + index];","let slotEnd = offsets[offsetsOffset + index + 1u];","var means: array<f32, 2>;","var total = 0.0;","var count = 0u;","for (var slot = slotBegin; slot < slotEnd; slot++) {","  let neighbor = neighbors[neighborsOffset + slot];","  let weight = weights[weightsOffset + slot];","  if (!included(neighbor) || !(weight > 0.0)) { continue; }","  total += weight;","  count++;","    means[column] += weight / total * (predictors[predictorsOffset + neighbor * 2u + column] - means[column]);","if (count <= 2u) { return; }","status[statusOffset + index] = 2u;","var correlation: array<f32, 4>;","  for (var first = 0u; first < 2u; first++) {","    let firstValue = predictors[predictorsOffset + neighbor * 2u + first] - means[first];","    for (var second = 0u; second < 2u; second++) {","      correlation[first * 2u + second] += weight * firstValue * (predictors[predictorsOffset + neighbor * 2u + second] - means[second]);","var scale: array<f32, 2>;","  let diagonal = correlation[column * 3u];","  if (!(diagonal > 0.0) || !isFiniteBits(diagonal)) { return; }","  scale[column] = inverseSqrt(diagonal);","// Condition number from the singular values of the scaled, weighted, centered design (streaming QR).","var factor: array<f32, 4>;","  var designRow: array<f32, 2>;","    designRow[column] = sqrt(weight) * (predictors[predictorsOffset + neighbor * 2u + column] - means[column]) * scale[column];","  updateDesignFactor_2(&factor, &designRow);","var vectors: array<f32, 4>;","var singularValues: array<f32, 2>;","if (!getDesignSingularValues_2(&factor, &vectors, &singularValues)) { status[statusOffset + index] = 3u; return; }","var smallest = 3.402823e38;","var largest = 0.0;","  smallest = min(smallest, singularValues[column]);","  largest = max(largest, singularValues[column]);","if (!(smallest > largest * 1e-7) || !isFiniteBits(largest)) {","  condition[conditionOffset + index] = 3e+38;","  return;","condition[conditionOffset + index] = largest / smallest;","// Columns of the scaled design have unit norm, so the inflation is the inverse diagonal of R^T R.","  inflation[inflationOffset + index * 2u + column] = getDesignFactorInverseDiagonal_2(&factor, column);","status[statusOffset + index] = 0u;","@group(0) @binding(5) var<storage, read_write> condition: array<f32>;","const proportionsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> proportions: array<f32>;","fn updateDesignFactor_3(factor: ptr<function, array<f32, 9>>, row: ptr<function, array<f32, 3>>) {","  for (var column = 0u; column < 3u; column++) {","    let diagonal = (*factor)[column * 3u + column];","    for (var entry = column; entry < 3u; entry++) {","      let held = (*factor)[column * 3u + entry];","      (*factor)[column * 3u + entry] = cosine * held + sine * incoming;","fn getDesignFactorInverseDiagonal_3(factor: ptr<function, array<f32, 9>>, column: u32) -> f32 {","  for (var last = column; last < 3u; last++) {","    var solution: array<f32, 3>;","    solution[last] = 1.0 / (*factor)[last * 3u + last];","        value += (*factor)[row * 3u + other] * solution[other];","      solution[row] = -value / (*factor)[row * 3u + row];","fn getDesignSingularValues_3(","  factor: ptr<function, array<f32, 9>>,","  vectors: ptr<function, array<f32, 9>>,","  values: ptr<function, array<f32, 3>>","  var columns: array<f32, 9>;","    for (var row = 0u; row < 3u; row++) {","      columns[column * 3u + row] = (*factor)[row * 3u + column];","      (*vectors)[column * 3u + row] = select(0.0, 1.0, row == column);","    for (var first = 0u; first + 1u < 3u; first++) {","      for (var second = first + 1u; second < 3u; second++) {","        for (var row = 0u; row < 3u; row++) {","          let x = columns[first * 3u + row];","          let y = columns[second * 3u + row];","          columns[first * 3u + row] = cosine * x - sine * y;","          columns[second * 3u + row] = sine * x + cosine * y;","          let vectorFirst = (*vectors)[first * 3u + row];","          let vectorSecond = (*vectors)[second * 3u + row];","          (*vectors)[first * 3u + row] = cosine * vectorFirst - sine * vectorSecond;","          (*vectors)[second * 3u + row] = sine * vectorFirst + cosine * vectorSecond;","      norm += columns[column * 3u + row] * columns[column * 3u + row];","fn getDesignRow(neighbor: u32, values: ptr<function, array<f32, 3>>) -> bool {","  if (neighbor >= 24u) { return false; }","  if (mask[maskOffset + neighbor] == 0u) { return false; }","  (*values)[0] = 1.0;","    let value = predictors[predictorsOffset + neighbor * 2u + column];","    if (!isFiniteBits(value)) { return false; }","    (*values)[column + 1u] = value;","  _ = &proportions;","  condition[conditionOffset + index] = getNaN();","for (var column = 0u; column < 3u; column++) {","  proportions[proportionsOffset + index * 3u + column] = getNaN();","if (status[statusOffset + index] != 0u) { return; }","// mgwr weights each design row by w (not sqrt(w)); columns are scaled to unit norm.","var scale: array<f32, 3>;","  var values: array<f32, 3>;","  if (!(weight > 0.0) || !getDesignRow(neighbors[neighborsOffset + slot], &values)) { continue; }","  for (var column = 0u; column < 3u; column++) { scale[column] += weight * weight * values[column] * values[column]; }","  if (!(scale[column] > 0.0) || !isFiniteBits(scale[column])) { status[statusOffset + index] = 2u; return; }","  scale[column] = inverseSqrt(scale[column]);","var factor: array<f32, 9>;","  for (var column = 0u; column < 3u; column++) { values[column] *= weight * scale[column]; }","  updateDesignFactor_3(&factor, &values);","var vectors: array<f32, 9>;","var singularValues: array<f32, 3>;","if (!getDesignSingularValues_3(&factor, &vectors, &singularValues)) { status[statusOffset + index] = 3u; return; }","var smallest = 0u;","  if (singularValues[column] < singularValues[smallest]) { smallest = column; }","let minimum = singularValues[smallest];","if (!(minimum > largest * 1e-7) || !isFiniteBits(largest)) {","  status[statusOffset + index] = 2u;","condition[conditionOffset + index] = largest / minimum;","// Belsley proportions of each coefficient's variance at the smallest singular value.","  for (var component = 0u; component < 3u; component++) {","    let value = vectors[component * 3u + column];","    total += value * value / (singularValues[component] * singularValues[component]);","  let loading = vectors[smallest * 3u + column];","  proportions[proportionsOffset + index * 3u + column] = (loading * loading / (minimum * minimum)) / total;"],"strings":["local-collinearity-fit","local-collinearity-variance-decomposition","buffer","imported","read","statistics-output-6","read_write","statistics-input-0","statistics-input-1","statistics-weights-neighbors","statistics-weights-offsets","statistics-weights-values","GPULocalCollinearity","statistics-output-2","statistics-output-3","statistics-output-4","statistics-output-5","compute","condition","local-collinearity","mask","neighbors","offsets","predictors","status","weights"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","read