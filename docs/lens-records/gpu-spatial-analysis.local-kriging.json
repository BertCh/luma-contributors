32 = 0u;","@group(0) @binding(4) var<storage, read_write> statuses: array<u32>;","fn read_positions(row: u32) -> vec2<f32> { return vec2<f32>(positions[positionsOffset + row * 2u + 0u], positions[positionsOffset + row * 2u + 1u]); }","fn read_observations(row: u32) -> vec4<f32> { return vec4<f32>(observations[observationsOffset + row * 4u + 0u], observations[observationsOffset + row * 4u + 1u], observations[observationsOffset + row * 4u + 2u], observations[observationsOffset + row * 4u + 3u]); }","fn read_supports(row: u32) -> vec2<f32> { return vec2<f32>(supports[supportsOffset + row * 2u + 0u], supports[supportsOffset + row * 2u + 1u]); }fn write_results(row: u32, value: vec4<f32>) { results[resultsOffset + row * 4u + 0u] = value[0u]; results[resultsOffset + row * 4u + 1u] = value[1u]; results[resultsOffset + row * 4u + 2u] = value[2u]; results[resultsOffset + row * 4u + 3u] = value[3u]; }","const SEARCH_RADIUS: f32 = 3.4028230607370965e+38;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn isUsableSample(sample: u32) -> bool {","  let observation = read_observations(sample);","  let position = read_positions(sample);","  if (!(observation.w > 0.0) || !isFiniteValue(observation.x) || !isFiniteValue(observation.y) || observation.y < 0.0 || !isFiniteValue(position.x) || !isFiniteValue(position.y)) { return false; }","  ","  return true;","const SYSTEM_CAPACITY: u32 = 9u;","const SYSTEM_PIVOT_TOLERANCE: f32 = 1e-6;","const SYSTEM_PIVOT_RATIO_TOLERANCE: f32 = 0.00009999999747378752;","var<private> matrix: array<f32, 81>;","var<private> right: array<f32, 9>;","var<private> solution: array<f32, 9>;","var<private> systemScale: array<f32, 9>;","var<private> pivotRatio: f32;","fn solveSystem(size: u32) -> bool {","  pivotRatio = 0.0;","  for (var row = 0u; row < size; row++) { systemScale[row] = 1.0; }","  for (var equilibrationPass = 0u; equilibrationPass < 4u; equilibrationPass++) {","    for (var row = 0u; row < size; row++) {","      var rowMaximum = 0.0;","      for (var column = 0u; column < size; column++) {","        rowMaximum = max(rowMaximum, abs(matrix[row * SYSTEM_CAPACITY + column]) * systemScale[row] * systemScale[column]);","      }","      if (!(rowMaximum > 0.0) || !isFiniteValue(rowMaximum)) { return false; }","      systemScale[row] *= inverseSqrt(rowMaximum);","    }","  }","  var largestEntry = 0.0;","  for (var row = 0u; row < size; row++) {","    for (var column = 0u; column < size; column++) {","      matrix[row * SYSTEM_CAPACITY + column] *= systemScale[row] * systemScale[column];","      largestEntry = max(largestEntry, abs(matrix[row * SYSTEM_CAPACITY + column]));","    right[row] *= systemScale[row];","  var smallestPivot = 3.402823e38;","  var largestPivot = 0.0;","  for (var column = 0u; column < size; column++) {","    var pivotRow = column;","    for (var row = column + 1u; row < size; row++) {","      if (abs(matrix[row * SYSTEM_CAPACITY + column]) > abs(matrix[pivotRow * SYSTEM_CAPACITY + column])) { pivotRow = row; }","    let pivotMagnitude = abs(matrix[pivotRow * SYSTEM_CAPACITY + column]);","    if (!(pivotMagnitude > SYSTEM_PIVOT_TOLERANCE * largestEntry)) { return false; }","    smallestPivot = min(smallestPivot, pivotMagnitude);","    largestPivot = max(largestPivot, pivotMagnitude);","    for (var entry = column; entry < size; entry++) {","      let held = matrix[column * SYSTEM_CAPACITY + entry];","      matrix[column * SYSTEM_CAPACITY + entry] = matrix[pivotRow * SYSTEM_CAPACITY + entry];","      matrix[pivotRow * SYSTEM_CAPACITY + entry] = held;","    let heldRight = right[column];","    right[column] = right[pivotRow];","    right[pivotRow] = heldRight;","      let factor = matrix[row * SYSTEM_CAPACITY + column] / matrix[column * SYSTEM_CAPACITY + column];","      for (var entry = column + 1u; entry < size; entry++) {","        matrix[row * SYSTEM_CAPACITY + entry] -= factor * matrix[column * SYSTEM_CAPACITY + entry];","      right[row] -= factor * right[column];","  pivotRatio = smallestPivot / largestPivot;","  if (!(pivotRatio >= SYSTEM_PIVOT_RATIO_TOLERANCE)) { return false; }","  for (var reverse = 0u; reverse < size; reverse++) {","    let row = size - reverse - 1u;","    var value = right[row];","    for (var column = row + 1u; column < size; column++) {","      value -= matrix[row * SYSTEM_CAPACITY + column] * solution[column];","    solution[row] = value / matrix[row * SYSTEM_CAPACITY + row];","    if (!isFiniteValue(solution[row])) { return false; }","  // Undo the equilibration: x = S y.","  for (var row = 0u; row < size; row++) { solution[row] *= systemScale[row]; }","fn covariance(first: vec2<f32>, second: vec2<f32>) -> f32 {","    let scaled = distance(first, second) / 3.0;","    ","    return 2.0 * (exp(-3.0 * scaled)) + select(0.0, 0.10000000149011612, all(first == second));","const NEIGHBOR_COUNT: u32 = 6u;","const DRIFT_COUNT: u32 = 3u;","const SUPPORT_COUNT: u32 = 1u;","const SAMPLE_COUNT: u32 = 6u;","const TARGET_VARIABLE: u32 = 0u;","const MEANS: array<f32, 1> = array<f32, 1>(0.0);","const COVARIANCE_SCALE: f32 = 2.0999999046325684;","fn crossCovariance(first: vec2<f32>, second: vec2<f32>, firstVariable: u32, secondVariable: u32) -> f32 {","  return covariance(first, second);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &observations;","  _ = &supports;","  _ = &results;","  _ = &statuses;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","write_results(index, vec4<f32>(getNaN(), getNaN(), 0.0, 0.0));","statuses[statusesOffset + index] = 1u;","let covarianceScale = COVARIANCE_SCALE;","var center = vec2<f32>(0.0);","var supportWeightSum = 0.0;","var supportWeights: array<f32, 1>;","for (var support = 0u; support < SUPPORT_COUNT; support++) {","  let supportValue = read_supports(index * SUPPORT_COUNT + support);","  let point = supportValue.xy;","  let weight = 1.0;","  if (!isFiniteValue(weight) || weight < 0.0) { return; }","  supportWeights[support] = weight; supportWeightSum += weight;","  if (!isFiniteValue(point.x) || !isFiniteValue(point.y)) { return; }","  center += point * weight;","if (!(supportWeightSum > 0.0) || !isFiniteValue(supportWeightSum)) { return; }","center /= supportWeightSum;","for (var support = 0u; support < SUPPORT_COUNT; support++) { supportWeights[support] /= supportWeightSum; }","var neighbors: array<u32, 6>;","var distances: array<f32, 6>;","var retained = 0u;","for (var candidate = 0u; candidate < SAMPLE_COUNT; candidate++) {","  let sample = candidate;","  if (sample < SAMPLE_COUNT && isUsableSample(sample)) {","  let separation = distance(position, center);","  if (separation <= SEARCH_RADIUS) {","    var insertion = retained;","    for (var neighbor = 0u; neighbor < retained; neighbor++) { if (separation < distances[neighbor]) { insertion = neighbor; break; } }","    if (insertion < NEIGHBOR_COUNT) {","      var shift = min(retained, NEIGHBOR_COUNT - 1u);","      loop { if (shift <= insertion) { break; } neighbors[shift] = neighbors[shift - 1u]; distances[shift] = distances[shift - 1u]; shift--; }","      neighbors[insertion] = sample; distances[insertion] = separation; retained = min(retained + 1u, NEIGHBOR_COUNT);","let driftColumnCount = DRIFT_COUNT;","if (retained == 0u || retained < driftColumnCount) { return; }","let coordinateScale = max(distances[retained - 1u], 1e-20);","var crossValues: array<f32, 6>;","var queryDesign: array<f32, 3>;","for (var row = 0u; row < retained; row++) {","  let position = read_positions(neighbors[row]);","  let observation = read_observations(neighbors[row]);","  let variable = 0u;","  for (var column = 0u; column < retained; column++) {","    let otherObservation = read_observations(neighbors[column]);","    matrix[row * SYSTEM_CAPACITY + column] = crossCovariance(position, read_positions(neighbors[column]), variable, 0u) / covarianceScale;","  matrix[row * SYSTEM_CAPACITY + row] += observation.y / covarianceScale;","  var crossValue = 0.0;","  for (var support = 0u; support < SUPPORT_COUNT; support++) { crossValue += crossCovariance(position, read_supports(index * SUPPORT_COUNT + support).xy, variable, TARGET_VARIABLE) * supportWeights[support]; }","  crossValues[row] = crossValue; right[row] = crossValue / covarianceScale;","  for (var column = 0u; column < driftColumnCount; column++) {","    let value = select((read_positions(neighbors[row]) - center)[min(column - 1u, 1u)] / coordinateScale, 1.0, column == 0u);","    matrix[row * SYSTEM_CAPACITY + retained + column] = value;","    matrix[(retained + column) * SYSTEM_CAPACITY + row] = value;","for (var column = 0u; column < driftColumnCount; column++) {","  let value = select(0.0, 1.0, column == 0u);","  if (!isFiniteValue(value)) { return; }","  queryDesign[column] = value; right[retained + column] = value;","  for (var other = 0u; other < driftColumnCount; other++) { matrix[(retained + column) * SYSTEM_CAPACITY + retained + other] = 0.0; }","statuses[statusesOffset + index] = 2u;","if (!solveSystem(retained + driftColumnCount)) { results[resultsOffset + index * 4u + 2u] = pivotRatio; return; }","var prediction = 0.0;","var variance = 0.0;","for (var first = 0u; first < SUPPORT_COUNT; first++) {","  for (var second = 0u; second < SUPPORT_COUNT; second++) {","    variance += crossCovariance(read_supports(index * SUPPORT_COUNT + first).xy, read_supports(index * SUPPORT_COUNT + second).xy, TARGET_VARIABLE, TARGET_VARIABLE) * supportWeights[first] * supportWeights[second];","let varianceScale = max(variance, 1e-20);","  prediction += solution[row] * (observation.x );","  variance -= solution[row] * crossValues[row];","for (var column = 0u; column < driftColumnCount; column++) { variance -= solution[retained + column] * queryDesign[column] * covarianceScale; }","if (!isFiniteValue(prediction) || !isFiniteValue(variance) || variance < -1e-4 * varianceScale) { return; }","write_results(index, vec4<f32>(prediction, max(variance, 0.0), pivotRatio, f32(retained)));","statuses[statusesOffset + index] = 0u;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index * 4u];"],"strings":["gpu-spatial-analysis-local-kriging-snapshot-tap","local-kriging","results","buffer","statuses","predictions","capture-predictions","observations","positions","imported","queries","read","read_write","transient","GPULocalKriging","InterpolationLensPredictionCapture","compute","sample-values"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","by