2u + 0u], supports[supportsOffset + row * 2u + 1u]); }fn write_results(row: u32, value: vec4<f32>) { results[resultsOffset + row * 4u + 0u] = value[0u]; results[resultsOffset + row * 4u + 1u] = value[1u]; results[resultsOffset + row * 4u + 2u] = value[2u]; results[resultsOffset + row * 4u + 3u] = value[3u]; }","","const SEARCH_RADIUS: f32 = 3.4028230607370965e+38;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn isUsableSample(sampleIndex: u32) -> bool {","  let observation = read_observations(sampleIndex);","  let position = read_positions(sampleIndex);","  if (!(observation.w > 0.0) || !isFiniteValue(observation.x) || !isFiniteValue(observation.y) || observation.y < 0.0 || !isFiniteValue(position.x) || !isFiniteValue(position.y)) { return false; }","  ","  return true;","struct DenseLU_9 {","  rowScale: array<f32, 9>,","  columnScale: array<f32, 9>,","  pivots: array<u32, 9>,","  size: u32,","  status: u32,","  pivotRatio: f32,","  logAbsDeterminant: f32,","  determinantSign: f32,","fn factorDenseLU_9(","  matrix: ptr<function, array<f32, 81>>,","  equilibrationPasses: u32,","  pivotTolerance: f32,","  minimumPivotRatio: f32",") -> DenseLU_9 {","  var result: DenseLU_9;","  result.size = min(size, 9u);","  result.status = 0u;","  result.pivotRatio = 0.0;","  result.logAbsDeterminant = 0.0;","  result.determinantSign = 1.0;","  let count = result.size;","  for (var row = 0u; row < count; row++) {","    result.rowScale[row] = 1.0;","    result.columnScale[row] = 1.0;","    result.pivots[row] = row;","    for (var column = 0u; column < count; column++) {","      if (!isFiniteValue((*matrix)[row * 9u + column])) {","        result.status = 1u;","        return result;","      }","    }","  }","  for (var equilibrationPass = 0u; equilibrationPass < equilibrationPasses; equilibrationPass++) {","    var rowMaximum: array<f32, 9>;","    var columnMaximum: array<f32, 9>;","    for (var row = 0u; row < count; row++) {","      for (var column = 0u; column < count; column++) {","        let magnitude = abs((*matrix)[row * 9u + column]) * result.rowScale[row] * result.columnScale[column];","        rowMaximum[row] = max(rowMaximum[row], magnitude);","        columnMaximum[column] = max(columnMaximum[column], magnitude);","    for (var index = 0u; index < count; index++) {","      if (!(rowMaximum[index] > 0.0) || !(columnMaximum[index] > 0.0)) {","        result.status = 2u;","      result.rowScale[index] = result.rowScale[index] / sqrt(rowMaximum[index]);","      result.columnScale[index] = result.columnScale[index] / sqrt(columnMaximum[index]);","  var largestEntry = 0.0;","      let value = (*matrix)[row * 9u + column] * result.rowScale[row] * result.columnScale[column];","      (*matrix)[row * 9u + column] = value;","      largestEntry = max(largestEntry, abs(value));","  var smallestPivot = 3.402823e38;","  var largestPivot = 0.0;","  for (var column = 0u; column < count; column++) {","    var pivotRow = column;","    for (var row = column + 1u; row < count; row++) {","      if (abs((*matrix)[row * 9u + column]) > abs((*matrix)[pivotRow * 9u + column])) {","        pivotRow = row;","    let pivotMagnitude = abs((*matrix)[pivotRow * 9u + column]);","    if (!isFiniteValue(pivotMagnitude)) {","      result.status = 1u;","      return result;","    if (!(pivotMagnitude > pivotTolerance * largestEntry) || !(pivotMagnitude > 0.0)) {","      result.status = 2u;","    result.pivots[column] = pivotRow;","    if (pivotRow != column) {","      result.determinantSign = -result.determinantSign;","      for (var entry = 0u; entry < count; entry++) {","        let held = (*matrix)[column * 9u + entry];","        (*matrix)[column * 9u + entry] = (*matrix)[pivotRow * 9u + entry];","        (*matrix)[pivotRow * 9u + entry] = held;","    let pivot = (*matrix)[column * 9u + column];","    smallestPivot = min(smallestPivot, pivotMagnitude);","    largestPivot = max(largestPivot, pivotMagnitude);","    result.logAbsDeterminant = result.logAbsDeterminant + log(pivotMagnitude);","    if (pivot < 0.0) {","      let factor = (*matrix)[row * 9u + column] / pivot;","      (*matrix)[row * 9u + column] = factor;","      for (var entry = column + 1u; entry < count; entry++) {","        (*matrix)[row * 9u + entry] = (*matrix)[row * 9u + entry] - factor * (*matrix)[column * 9u + entry];","  for (var index = 0u; index < count; index++) {","    result.logAbsDeterminant = result.logAbsDeterminant - log(result.rowScale[index]) - log(result.columnScale[index]);","  result.pivotRatio = select(1.0, smallestPivot / largestPivot, count > 0u);","  if (result.pivotRatio < minimumPivotRatio) {","    result.status = 3u;","  return result;","fn solveDenseLU_9(","  factorization: ptr<function, DenseLU_9>,","  vector: ptr<function, array<f32, 9>>",") -> bool {","  let count = (*factorization).size;","    (*vector)[row] = (*vector)[row] * (*factorization).rowScale[row];","    let pivotRow = (*factorization).pivots[column];","      let held = (*vector)[column];","      (*vector)[column] = (*vector)[pivotRow];","      (*vector)[pivotRow] = held;","    var value = (*vector)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*matrix)[row * 9u + k] * (*vector)[k];","    (*vector)[row] = value;","  var finite = true;","  for (var offset = 0u; offset < count; offset++) {","    let row = count - 1u - offset;","    for (var k = row + 1u; k < count; k++) {","    (*vector)[row] = value / (*matrix)[row * 9u + row];","    (*vector)[row] = (*vector)[row] * (*factorization).columnScale[row];","    finite = finite && isFiniteValue((*vector)[row]);","  return finite;","fn invertDenseLU_9(","  inverse: ptr<function, array<f32, 81>>","    var unit: array<f32, 9>;","    unit[column] = 1.0;","    finite = solveDenseLU_9(matrix, factorization, &unit) && finite;","      (*inverse)[row * 9u + column] = unit[row];","const SYSTEM_CAPACITY: u32 = 9u;","const SYSTEM_PIVOT_TOLERANCE: f32 = 1e-6;","const SYSTEM_PIVOT_RATIO_TOLERANCE: f32 = 0.00009999999747378752;","var<private> matrix: array<f32, 81>;","var<private> right: array<f32, 9>;","var<private> solution: array<f32, 9>;","var<private> systemScale: array<f32, 9>;","var<private> pivotRatio: f32;","fn solveSystem(size: u32) -> bool {","  pivotRatio = 0.0;","  for (var row = 0u; row < size; row++) { systemScale[row] = 1.0; }","  for (var equilibrationPass = 0u; equilibrationPass < 4u; equilibrationPass++) {","    for (var row = 0u; row < size; row++) {","      var rowMaximum = 0.0;","      for (var column = 0u; column < size; column++) {","        rowMaximum = max(rowMaximum, abs(matrix[row * SYSTEM_CAPACITY + column]) * systemScale[row] * systemScale[column]);","      if (!(rowMaximum > 0.0) || !isFiniteValue(rowMaximum)) { return false; }","      systemScale[row] *= inverseSqrt(rowMaximum);","  // The core API takes function-local arrays; prediction kernels fill private arrays.","  var factorMatrix: array<f32, 81>;","  var factorRight: array<f32, 9>;","  for (var row = 0u; row < size; row++) {","    for (var column = 0u; column < size; column++) {","      factorMatrix[row * SYSTEM_CAPACITY + column] = matrix[row * SYSTEM_CAPACITY + column] * (systemScale[row] * systemScale[column]);","    factorRight[row] = right[row] * systemScale[row];","  // Scaling already happened above: disable core equilibration to retain the prediction policy.","  var factorization = factorDenseLU_9(&factorMatrix, size, 0u, SYSTEM_PIVOT_TOLERANCE, SYSTEM_PIVOT_RATIO_TOLERANCE);","  pivotRatio = factorization.pivotRatio;","  if (factorization.status != 0u) { return false; }","  if (!solveDenseLU_9(&factorMatrix, &factorization, &factorRight)) { return false; }","  for (var row = 0u; row < size; row++) { solution[row] = factorRight[row]; }","  // Undo the equilibration: x = S y.","    solution[row] *= systemScale[row];","    if (!isFiniteValue(solution[row])) { return false; }","var<private> covarianceStructures: array<vec4<f32>, 1>;","fn covarianceCorrelation(modelCode: u32, scaled: f32) -> f32 {","  switch modelCode {","    case 0u {  return select(1.0 - 1.5 * scaled + 0.5 * scaled * scaled * scaled, 0.0, scaled >= 1.0); }","    case 1u {  return exp(-3.0 * scaled); }","    case 2u {  return exp(-3.0 * scaled * scaled); }","    case 3u { let maternArgument = 4.7490315437316895 * scaled; return select((1.0 + maternArgument) * exp(-maternArgument), 1.0 - maternArgument * maternArgument * (0.5 - maternArgument * (0.3333333432674408 - maternArgument * (0.125 - maternArgument * (0.03333333507180214 - maternArgument * 0.0069444444961845875)))), maternArgument < 0.10000000149011612); }","    default { let maternArgument = 5.924462795257568 * scaled; return select((1.0 + maternArgument + maternArgument * maternArgument * 0.3333333432674408) * exp(-maternArgument), 1.0 - maternArgument * maternArgument * (0.1666666716337204 - maternArgument * maternArgument * (0.0416666679084301 - maternArgument * (0.02222222276031971 - maternArgument * 0.0069444444961845875))), maternArgument < 0.10000000149011612); }","fn structureCovariance(structure: u32, first: vec2<f32>, second: vec2<f32>) -> f32 {","  let values = covarianceStructures[structure];","  let scaled = distance(first, second) / values.w;","  return values.z * covarianceCorrelation(u32(values.x), scaled) + select(0.0, values.y, all(first == second));","fn loadCovarianceParameters() -> bool {","  if (!(params[paramsOffset] > 0.0)) { return false; }","  for (var structure = 0u; structure < 1u; structure++) {","    let base = paramsOffset + 4u + structure * 4u;","    let values = vec4<f32>(params[base], params[base + 1u], params[base + 2u], params[base + 3u]);","    if (!(values.x >= 0.0 && values.x <= 4.0) || !(values.y >= 0.0) || !(values.z >= 0.0) || !(values.w > 0.0)) { return false; }","    covarianceStructures[structure] = values;","fn crossCovariance(first: vec2<f32>, second: vec2<f32>, firstVariable: u32, secondVariable: u32) -> f32 {","  return structureCovariance(0u, first, second);","const NEIGHBOR_COUNT: u32 = 6u;","const DRIFT_COUNT: u32 = 3u;","const SUPPORT_COUNT: u32 = 1u;","const SAMPLE_COUNT: u32 = 6u;","const TARGET_VARIABLE: u32 = 0u;","const MEANS: array<f32, 1> = array<f32, 1>(0.0);","@compute @workgroup_size(32)","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(num_workgroups) workgroupCount: vec3<u32>,","  @builtin(local_invocation_index) localInvocationIndex: u32) {","  _ = &positions;","  _ = &observations;","  _ = &supports;","  _ = &results;","  _ = &statuses;","  _ = &params;","  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  positionsOffset = getChunkParameter(4u);","  observationsOffset = getChunkParameter(5u);","  supportsOffset = getChunkParameter(6u);","  resultsOffset = getChunkParameter(7u);","  statusesOffset = getChunkParameter(8u);","  paramsOffset = getChunkParameter(9u);","  let queryIndex = getChunkParameter(0u) + index;","write_results(index, vec4<f32>(getNaN(), getNaN(), 0.0, 0.0));","statuses[statusesOffset + index] = 1u;","if (!loadCovarianceParameters()) { return; }","let covarianceScale = params[paramsOffset];","var center = vec2<f32>(0.0);","var supportWeightSum = 0.0;","var supportWeights: array<f32, 1>;","for (var support = 0u; support < SUPPORT_COUNT; support++) {","  let supportValue = read_supports(index * SUPPORT_COUNT + support);","  let point = supportValue.xy;","  let weight = 1.0;","  if (!isFiniteValue(weight) || weight < 0.0) { return; }","  supportWeights[support] = weight; supportWeightSum += weight;","  if (!isFiniteValue(point.x) || !isFiniteValue(point.y)) { return; }","  center += point * weight;","if (!(supportWeightSum > 0.0) || !isFiniteValue(supportWeightSum)) { return; }","center /= supportWeightSum;","for (var support = 0u; support < SUPPORT_COUNT; support++) { supportWeights[support] /= supportWeightSum; }","var neighbors: array<u32, 6>;","var distances: array<f32, 6>;","var retained = 0u;","for (var candidate = 0u; candidate < SAMPLE_COUNT; candidate++) {","  let sampleIndex = candidate;","  if (sampleIndex < SAMPLE_COUNT && isUsableSample(sampleIndex)) {","  let separation = distance(position, center);","  if (separation <= SEARCH_RADIUS) {","    var insertion = retained;","    for (var neighbor = 0u; neighbor < retained; neighbor++) { if (separation < distances[neighbor] || (separation == distances[neighbor] && sampleIndex < neighbors[neighbor])) { insertion = neighbor; break; } }","    if (insertion < NEIGHBOR_COUNT) {","      var shift = min(retained, NEIGHBOR_COUNT - 1u);","      loop { if (shift <= insertion) { break; } neighbors[shift] = neighbors[shift - 1u]; distances[shift] = distances[shift - 1u]; shift--; }","      neighbors[insertion] = sampleIndex; distances[insertion] = separation; retained = min(retained + 1u, NEIGHBOR_COUNT);","let driftColumnCount = DRIFT_COUNT;","if (retained == 0u || retained < driftColumnCount) { return; }","let coordinateScale = max(distances[retained - 1u], 1e-20);","var crossValues: array<f32, 6>;","var queryDesign: array<f32, 3>;","for (var row = 0u; row < retained; row++) {","  let position = read_positions(neighbors[row]);","  let observation = read_observations(neighbors[row]);","  let variable = 0u;","  for (var column = 0u; column < retained; column++) {","    let otherObservation = read_observations(neighbors[column]);","    matrix[row * SYSTEM_CAPACITY + column] = crossCovariance(position, read_positions(neighbors[column]), variable, 0u) / covarianceScale;","  matrix[row * SYSTEM_CAPACITY + row] += observation.y / covarianceScale;","  var crossValue = 0.0;","  for (var support = 0u; support < SUPPORT_COUNT; support++) { crossValue += crossCovariance(position, read_supports(index * SUPPORT_COUNT + support).xy, variable, TARGET_VARIABLE) * supportWeights[support]; }","  crossValues[row] = crossValue; right[row] = crossValue / covarianceScale;","  for (var column = 0u; column < driftColumnCount; column++) {","    let value = select((read_positions(neighbors[row]) - center)[min(column - 1u, 1u)] / coordinateScale, 1.0, column == 0u);","    matrix[row * SYSTEM_CAPACITY + retained + column] = value;","    matrix[(retained + column) * SYSTEM_CAPACITY + row] = value;","for (var column = 0u; column < driftColumnCount; column++) {","  let value = select(0.0, 1.0, column == 0u);","  if (!isFiniteValue(value)) { return; }","  queryDesign[column] = value; right[retained + column] = value;","  for (var other = 0u; other < driftColumnCount; other++) { matrix[(retained + column) * SYSTEM_CAPACITY + retained + other] = 0.0; }","statuses[statusesOffset + index] = 2u;","if (!solveSystem(retained + driftColumnCount)) { results[resultsOffset + index * 4u + 2u] = pivotRatio; return; }","var prediction = 0.0;","var variance = 0.0;","for (var first = 0u; first < SUPPORT_COUNT; first++) {","  for (var second = 0u; second < SUPPORT_COUNT; second++) {","    variance += crossCovariance(read_supports(index * SUPPORT_COUNT + first).xy, read_supports(index * SUPPORT_COUNT + second).xy, TARGET_VARIABLE, TARGET_VARIABLE) * supportWeights[first] * supportWeights[second];","let varianceScale = max(variance, 1e-20);","  prediction += solution[row] * (observation.x );","  variance -= solution[row] * crossValues[row];","for (var column = 0u; column < driftColumnCount; column++) { variance -= solution[retained + column] * queryDesign[column] * covarianceScale; }","if (!isFiniteValue(prediction) || !isFiniteValue(variance) || variance < -1e-4 * varianceScale) { return; }","write_results(index, vec4<f32>(prediction, max(variance, 0.0), pivotRatio, f32(retained)));","statuses[statusesOffset + index] = 0u;","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &source;","  _ = &destination;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (index >= INVOCATION_COUNT) {","    return;","  destination[destinationOffset + index] = source[sourceOffset + index * 4u];"],"strings":["gpu-spatial-analysis-local-kriging-snapshot-tap","local-kriging","results","buffer","logical","statuses","predictions","capture-predictions","local-kriging-covariance","observations","positions","read","GPULocalKriging","local-kriging-upload-covariance","queries","transient","imported","read_write","InterpolationLensPredictionCapture","compute","copy","sample-values"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","reads","writes","workload","attrs"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","bindingByteOffset","bindingByteLength","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["id","label","namespace","k