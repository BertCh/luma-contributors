es[queriesOffset + row * 2u + 0u], queries[queriesOffset + row * 2u + 1u]); }fn write_results(row: u32, value: vec4<f32>) { results[resultsOffset + row * 4u + 0u] = value[0u]; results[resultsOffset + row * 4u + 1u] = value[1u]; results[resultsOffset + row * 4u + 2u] = value[2u]; results[resultsOffset + row * 4u + 3u] = value[3u]; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn getScaledQuotient(value: f32, first: f32, second: f32, power: i32) -> f32 {","  if (value == 0.0) { return value; }","  let numerator = frexp(value);","  let firstDivisor = frexp(first);","  let secondDivisor = frexp(second);","  let quotient = frexp(numerator.fract / (firstDivisor.fract * secondDivisor.fract));","  return ldexp(quotient.fract,","    numerator.exp - firstDivisor.exp - secondDivisor.exp + power + quotient.exp);","struct DenseLU_9 {","  rowScale: array<f32, 9>,","  columnScale: array<f32, 9>,","  pivots: array<u32, 9>,","  size: u32,","  status: u32,","  pivotRatio: f32,","  logAbsDeterminant: f32,","  determinantSign: f32,","fn factorDenseLU_9(","  matrix: ptr<function, array<f32, 81>>,","  equilibrationPasses: u32,","  pivotTolerance: f32,","  minimumPivotRatio: f32",") -> DenseLU_9 {","  var result: DenseLU_9;","  result.size = min(size, 9u);","  result.status = 0u;","  result.pivotRatio = 0.0;","  result.logAbsDeterminant = 0.0;","  result.determinantSign = 1.0;","  let count = result.size;","  for (var row = 0u; row < count; row++) {","    result.rowScale[row] = 1.0;","    result.columnScale[row] = 1.0;","    result.pivots[row] = row;","    for (var column = 0u; column < count; column++) {","      if (!isFiniteValue((*matrix)[row * 9u + column])) {","        result.status = 1u;","        return result;","      }","    }","  }","  for (var equilibrationPass = 0u; equilibrationPass < equilibrationPasses; equilibrationPass++) {","    var rowMaximum: array<f32, 9>;","    var columnMaximum: array<f32, 9>;","    for (var row = 0u; row < count; row++) {","      for (var column = 0u; column < count; column++) {","        let magnitude = abs((*matrix)[row * 9u + column]) * result.rowScale[row] * result.columnScale[column];","        rowMaximum[row] = max(rowMaximum[row], magnitude);","        columnMaximum[column] = max(columnMaximum[column], magnitude);","    for (var index = 0u; index < count; index++) {","      if (!(rowMaximum[index] > 0.0) || !(columnMaximum[index] > 0.0)) {","        result.status = 2u;","      result.rowScale[index] = result.rowScale[index] / sqrt(rowMaximum[index]);","      result.columnScale[index] = result.columnScale[index] / sqrt(columnMaximum[index]);","  var largestEntry = 0.0;","      let value = (*matrix)[row * 9u + column] * result.rowScale[row] * result.columnScale[column];","      (*matrix)[row * 9u + column] = value;","      largestEntry = max(largestEntry, abs(value));","  var smallestPivot = 3.402823e38;","  var largestPivot = 0.0;","  for (var column = 0u; column < count; column++) {","    var pivotRow = column;","    for (var row = column + 1u; row < count; row++) {","      if (abs((*matrix)[row * 9u + column]) > abs((*matrix)[pivotRow * 9u + column])) {","        pivotRow = row;","    let pivotMagnitude = abs((*matrix)[pivotRow * 9u + column]);","    if (!isFiniteValue(pivotMagnitude)) {","      result.status = 1u;","      return result;","    if (!(pivotMagnitude > pivotTolerance * largestEntry) || !(pivotMagnitude > 0.0)) {","      result.status = 2u;","    result.pivots[column] = pivotRow;","    if (pivotRow != column) {","      result.determinantSign = -result.determinantSign;","      for (var entry = 0u; entry < count; entry++) {","        let held = (*matrix)[column * 9u + entry];","        (*matrix)[column * 9u + entry] = (*matrix)[pivotRow * 9u + entry];","        (*matrix)[pivotRow * 9u + entry] = held;","    let pivot = (*matrix)[column * 9u + column];","    smallestPivot = min(smallestPivot, pivotMagnitude);","    largestPivot = max(largestPivot, pivotMagnitude);","    result.logAbsDeterminant = result.logAbsDeterminant + log(pivotMagnitude);","    if (pivot < 0.0) {","      let factor = (*matrix)[row * 9u + column] / pivot;","      (*matrix)[row * 9u + column] = factor;","      for (var entry = column + 1u; entry < count; entry++) {","        (*matrix)[row * 9u + entry] = (*matrix)[row * 9u + entry] - factor * (*matrix)[column * 9u + entry];","  for (var index = 0u; index < count; index++) {","    result.logAbsDeterminant = result.logAbsDeterminant - log(result.rowScale[index]) - log(result.columnScale[index]);","  result.pivotRatio = select(1.0, smallestPivot / largestPivot, count > 0u);","  if (result.pivotRatio < minimumPivotRatio) {","    result.status = 3u;","  return result;","fn solveDenseLU_9(","  factorization: ptr<function, DenseLU_9>,","  vector: ptr<function, array<f32, 9>>",") -> bool {","  let count = (*factorization).size;","    (*vector)[row] = (*vector)[row] * (*factorization).rowScale[row];","    let pivotRow = (*factorization).pivots[column];","      let held = (*vector)[column];","      (*vector)[column] = (*vector)[pivotRow];","      (*vector)[pivotRow] = held;","    var value = (*vector)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*matrix)[row * 9u + k] * (*vector)[k];","    (*vector)[row] = value;","  var finite = true;","  for (var offset = 0u; offset < count; offset++) {","    let row = count - 1u - offset;","    for (var k = row + 1u; k < count; k++) {","    (*vector)[row] = value / (*matrix)[row * 9u + row];","    (*vector)[row] = (*vector)[row] * (*factorization).columnScale[row];","    finite = finite && isFiniteValue((*vector)[row]);","  return finite;","fn invertDenseLU_9(","  inverse: ptr<function, array<f32, 81>>","    var unit: array<f32, 9>;","    unit[column] = 1.0;","    finite = solveDenseLU_9(matrix, factorization, &unit) && finite;","      (*inverse)[row * 9u + column] = unit[row];","const SYSTEM_CAPACITY: u32 = 9u;","const SYSTEM_PIVOT_TOLERANCE: f32 = 1e-6;","const SYSTEM_PIVOT_RATIO_TOLERANCE: f32 = 0.00009999999747378752;","var<private> matrix: array<f32, 81>;","var<private> right: array<f32, 9>;","var<private> solution: array<f32, 9>;","var<private> systemScale: array<f32, 9>;","var<private> pivotRatio: f32;","fn solveSystem(size: u32) -> bool {","  pivotRatio = 0.0;","  for (var row = 0u; row < size; row++) { systemScale[row] = 1.0; }","  for (var equilibrationPass = 0u; equilibrationPass < 4u; equilibrationPass++) {","    for (var row = 0u; row < size; row++) {","      var rowMaximum = 0.0;","      for (var column = 0u; column < size; column++) {","        rowMaximum = max(rowMaximum, abs(matrix[row * SYSTEM_CAPACITY + column]) * systemScale[row] * systemScale[column]);","      if (!(rowMaximum > 0.0) || !isFiniteValue(rowMaximum)) { return false; }","      systemScale[row] *= inverseSqrt(rowMaximum);","  // The core API takes function-local arrays; prediction kernels fill private arrays.","  var factorMatrix: array<f32, 81>;","  var factorRight: array<f32, 9>;","  for (var row = 0u; row < size; row++) {","    for (var column = 0u; column < size; column++) {","      factorMatrix[row * SYSTEM_CAPACITY + column] = matrix[row * SYSTEM_CAPACITY + column] * (systemScale[row] * systemScale[column]);","    factorRight[row] = right[row] * systemScale[row];","  // Scaling already happened above: disable core equilibration to retain the prediction policy.","  var factorization = factorDenseLU_9(&factorMatrix, size, 0u, SYSTEM_PIVOT_TOLERANCE, SYSTEM_PIVOT_RATIO_TOLERANCE);","  pivotRatio = factorization.pivotRatio;","  if (factorization.status != 0u) { return false; }","  if (!solveDenseLU_9(&factorMatrix, &factorization, &factorRight)) { return false; }","  for (var row = 0u; row < size; row++) { solution[row] = factorRight[row]; }","  // Undo the equilibration: x = S y.","    solution[row] *= systemScale[row];","    if (!isFiniteValue(solution[row])) { return false; }","  return true;","var<private> radialScale: f32 = 1.0;","fn radial(first: vec2<f32>, second: vec2<f32>) -> f32 {","  let separation = distance(first, second) * 1.0 * radialScale;","  return select(0.0, separation * separation * log(max(separation, 1e-30)), separation > 0.0);","fn scaleSmoothing(smoothing: f32, coordinateScale: f32) -> f32 {","  // Repeated divisions can reassociate into smoothing * pow(1 / scale, degree) on Metal.","  // Keep the power in integer exponents and a bounded [1/32, 1] mantissa instead.","  let divisor = frexp(coordinateScale);","  return getScaledQuotient(smoothing, pow(divisor.fract, 2.0), 1.0, -2 * divisor.exp);","fn polynomial(position: vec2<f32>, column: u32) -> f32 {","  switch column { case 0u: { return 1.0; } case 1u: { return position.x; } case 2u: { return position.y; } case 3u: { return position.x * position.x; } case 4u: { return position.x * position.y; } default: { return position.y * position.y; } }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &values;","  _ = &queries;","  _ = &results;","  _ = &statuses;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  ","write_results(index, vec4<f32>(getNaN(), 0.0, 0.0, 0.0));","statuses[statusesOffset + index] = 1u;","let query = read_queries(index);","if (!isFiniteValue(query.x) || !isFiniteValue(query.y)) { return; }","var neighbors: array<u32, 6>;","var distances: array<f32, 6>;","var retained = 0u;","for (var candidate = 0u; candidate < 6u; candidate++) {","  let sample = candidate;","  if (sample >= 6u) { continue; }","  let position = read_positions(sample);","  if (!isFiniteValue(values[valuesOffset + sample]) || !isFiniteValue(position.x) || !isFiniteValue(position.y)) { continue; }","  let separation = distance(position, query);","  if (!(separation <= 3.4028230607370965e+38)) { continue; }","  var insertion = retained;","  for (var neighbor = 0u; neighbor < retained; neighbor++) { if (separation < distances[neighbor] || (separation == distances[neighbor] && sample < neighbors[neighbor])) { insertion = neighbor; break; } }","  if (insertion >= 6u) { continue; }","  var shift = min(retained, 5u);","  loop { if (shift <= insertion) { break; } neighbors[shift] = neighbors[shift - 1u]; distances[shift] = distances[shift - 1u]; shift--; }","  neighbors[insertion] = sample; distances[insertion] = separation; retained = min(retained + 1u, 6u);","if (retained == 0u || retained < 3u) { return; }","let coordinateScale = max(distances[retained - 1u], 1e-20);","radialScale = 1.0 / coordinateScale;","for (var row = 0u; row < retained; row++) {","  let position = read_positions(neighbors[row]);","  for (var column = 0u; column < retained; column++) { matrix[row * SYSTEM_CAPACITY + column] = radial(position, read_positions(neighbors[column])); }","  matrix[row * SYSTEM_CAPACITY + row] += scaleSmoothing(0.019999999552965164, coordinateScale);","  right[row] = values[valuesOffset + neighbors[row]];","  for (var column = 0u; column < 3u; column++) {","    let value = polynomial((position - query) / coordinateScale, column);","    matrix[row * SYSTEM_CAPACITY + retained + column] = value;","    matrix[(retained + column) * SYSTEM_CAPACITY + row] = value;","for (var row = 0u; row < 3u; row++) {","  right[retained + row] = 0.0;","  for (var column = 0u; column < 3u; column++) { matrix[(retained + row) * SYSTEM_CAPACITY + retained + column] = 0.0; }","statuses[statusesOffset + index] = 2u;","if (!solveSystem(retained + 3u)) { results[resultsOffset + index * 4u + 1u] = pivotRatio; return; }","var prediction = solution[retained];","for (var row = 0u; row < retained; row++) { prediction += solution[row] * radial(query, read_positions(neighbors[row])); }","if (!isFiniteValue(prediction)) { return; }","write_results(index, vec4<f32>(prediction, pivotRatio, f32(retained), 0.0));","statuses[statusesOffset + index] = 0u;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index * 4u];"],"strings":["gpu-spatial-analysis-local-rbf-snapshot-tap","local-rbf","results","statuses","buffer","logical","predictions","capture-predictions","positions","queries","read","sample-values","imported","read_write","transient","GPULocalRBF","InterpolationLensPredictionCapture","compute"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalT