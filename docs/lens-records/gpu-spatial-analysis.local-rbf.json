meaning":"0 success; 1 invalid; 2 degenerate; natural neighbor also uses 3 for capacity","role":"output","keySpace":"query"},{"id":"gpu-spatial-analysis-local-rbf-snapshots-predictions-0","name":"predictions","iteration":0,"elementType":"f32","values":"b64:AQAIQM3MHED+/wdAzcwcQA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-local-rbf-compiled","resource":"predictions","meaning":"Predicted scalar response","role":"output","keySpace":"query"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const valuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> values: array<f32>;","const queriesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> queries: array<f32>;","const resultsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> results: array<f32>;","const statusesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> statuses: array<u32>;","fn read_positions(row: u32) -> vec2<f32> { return vec2<f32>(positions[positionsOffset + row * 2u + 0u], positions[positionsOffset + row * 2u + 1u]); }","fn read_queries(row: u32) -> vec2<f32> { return vec2<f32>(queries[queriesOffset + row * 2u + 0u], queries[queriesOffset + row * 2u + 1u]); }fn write_results(row: u32, value: vec4<f32>) { results[resultsOffset + row * 4u + 0u] = value[0u]; results[resultsOffset + row * 4u + 1u] = value[1u]; results[resultsOffset + row * 4u + 2u] = value[2u]; results[resultsOffset + row * 4u + 3u] = value[3u]; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","const SYSTEM_CAPACITY: u32 = 9u;","const SYSTEM_PIVOT_TOLERANCE: f32 = 1e-6;","const SYSTEM_PIVOT_RATIO_TOLERANCE: f32 = 0.00009999999747378752;","var<private> matrix: array<f32, 81>;","var<private> right: array<f32, 9>;","var<private> solution: array<f32, 9>;","var<private> systemScale: array<f32, 9>;","var<private> pivotRatio: f32;","fn solveSystem(size: u32) -> bool {","  pivotRatio = 0.0;","  for (var row = 0u; row < size; row++) { systemScale[row] = 1.0; }","  for (var equilibrationPass = 0u; equilibrationPass < 4u; equilibrationPass++) {","    for (var row = 0u; row < size; row++) {","      var rowMaximum = 0.0;","      for (var column = 0u; column < size; column++) {","        rowMaximum = max(rowMaximum, abs(matrix[row * SYSTEM_CAPACITY + column]) * systemScale[row] * systemScale[column]);","      }","      if (!(rowMaximum > 0.0) || !isFiniteValue(rowMaximum)) { return false; }","      systemScale[row] *= inverseSqrt(rowMaximum);","    }","  }","  var largestEntry = 0.0;","  for (var row = 0u; row < size; row++) {","    for (var column = 0u; column < size; column++) {","      matrix[row * SYSTEM_CAPACITY + column] *= systemScale[row] * systemScale[column];","      largestEntry = max(largestEntry, abs(matrix[row * SYSTEM_CAPACITY + column]));","    right[row] *= systemScale[row];","  var smallestPivot = 3.402823e38;","  var largestPivot = 0.0;","  for (var column = 0u; column < size; column++) {","    var pivotRow = column;","    for (var row = column + 1u; row < size; row++) {","      if (abs(matrix[row * SYSTEM_CAPACITY + column]) > abs(matrix[pivotRow * SYSTEM_CAPACITY + column])) { pivotRow = row; }","    let pivotMagnitude = abs(matrix[pivotRow * SYSTEM_CAPACITY + column]);","    if (!(pivotMagnitude > SYSTEM_PIVOT_TOLERANCE * largestEntry)) { return false; }","    smallestPivot = min(smallestPivot, pivotMagnitude);","    largestPivot = max(largestPivot, pivotMagnitude);","    for (var entry = column; entry < size; entry++) {","      let held = matrix[column * SYSTEM_CAPACITY + entry];","      matrix[column * SYSTEM_CAPACITY + entry] = matrix[pivotRow * SYSTEM_CAPACITY + entry];","      matrix[pivotRow * SYSTEM_CAPACITY + entry] = held;","    let heldRight = right[column];","    right[column] = right[pivotRow];","    right[pivotRow] = heldRight;","      let factor = matrix[row * SYSTEM_CAPACITY + column] / matrix[column * SYSTEM_CAPACITY + column];","      for (var entry = column + 1u; entry < size; entry++) {","        matrix[row * SYSTEM_CAPACITY + entry] -= factor * matrix[column * SYSTEM_CAPACITY + entry];","      right[row] -= factor * right[column];","  pivotRatio = smallestPivot / largestPivot;","  if (!(pivotRatio >= SYSTEM_PIVOT_RATIO_TOLERANCE)) { return false; }","  for (var reverse = 0u; reverse < size; reverse++) {","    let row = size - reverse - 1u;","    var value = right[row];","    for (var column = row + 1u; column < size; column++) {","      value -= matrix[row * SYSTEM_CAPACITY + column] * solution[column];","    solution[row] = value / matrix[row * SYSTEM_CAPACITY + row];","    if (!isFiniteValue(solution[row])) { return false; }","  // Undo the equilibration: x = S y.","  for (var row = 0u; row < size; row++) { solution[row] *= systemScale[row]; }","  return true;","var<private> radialScale: f32 = 1.0;","fn radial(first: vec2<f32>, second: vec2<f32>) -> f32 {","  let separation = distance(first, second) * 1.0 * radialScale;","  return select(0.0, separation * separation * log(max(separation, 1e-30)), separation > 0.0);","fn polynomial(position: vec2<f32>, column: u32) -> f32 {","  switch column { case 0u: { return 1.0; } case 1u: { return position.x; } case 2u: { return position.y; } case 3u: { return position.x * position.x; } case 4u: { return position.x * position.y; } default: { return position.y * position.y; } }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &values;","  _ = &queries;","  _ = &results;","  _ = &statuses;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  ","write_results(index, vec4<f32>(getNaN(), 0.0, 0.0, 0.0));","statuses[statusesOffset + index] = 1u;","let query = read_queries(index);","if (!isFiniteValue(query.x) || !isFiniteValue(query.y)) { return; }","var neighbors: array<u32, 6>;","var distances: array<f32, 6>;","var retained = 0u;","for (var candidate = 0u; candidate < 6u; candidate++) {","  let sample = candidate;","  if (sample >= 6u) { continue; }","  let position = read_positions(sample);","  if (!isFiniteValue(values[valuesOffset + sample]) || !isFiniteValue(position.x) || !isFiniteValue(position.y)) { continue; }","  let separation = distance(position, query);","  if (!(separation <= 3.4028230607370965e+38)) { continue; }","  var insertion = retained;","  for (var neighbor = 0u; neighbor < retained; neighbor++) { if (separation < distances[neighbor] || (separation == distances[neighbor] && sample < neighbors[neighbor])) { insertion = neighbor; break; } }","  if (insertion >= 6u) { continue; }","  var shift = min(retained, 5u);","  loop { if (shift <= insertion) { break; } neighbors[shift] = neighbors[shift - 1u]; distances[shift] = distances[shift - 1u]; shift--; }","  neighbors[insertion] = sample; distances[insertion] = separation; retained = min(retained + 1u, 6u);","if (retained == 0u || retained < 3u) { return; }","let coordinateScale = max(distances[retained - 1u], 1e-20);","radialScale = 1.0 / coordinateScale;","let smoothingScale = 1.0 / pow(coordinateScale, 2.0);","for (var row = 0u; row < retained; row++) {","  let position = read_positions(neighbors[row]);","  for (var column = 0u; column < retained; column++) { matrix[row * SYSTEM_CAPACITY + column] = radial(position, read_positions(neighbors[column])); }","  matrix[row * SYSTEM_CAPACITY + row] += smoothingScale * 0.019999999552965164;","  right[row] = values[valuesOffset + neighbors[row]];","  for (var column = 0u; column < 3u; column++) {","    let value = polynomial((position - query) / coordinateScale, column);","    matrix[row * SYSTEM_CAPACITY + retained + column] = value;","    matrix[(retained + column) * SYSTEM_CAPACITY + row] = value;","for (var row = 0u; row < 3u; row++) {","  right[retained + row] = 0.0;","  for (var column = 0u; column < 3u; column++) { matrix[(retained + row) * SYSTEM_CAPACITY + retained + column] = 0.0; }","statuses[statusesOffset + index] = 2u;","if (!solveSystem(retained + 3u)) { results[resultsOffset + index * 4u + 1u] = pivotRatio; return; }","var prediction = solution[retained];","for (var row = 0u; row < retained; row++) { prediction += solution[row] * radial(query, read_positions(neighbors[row])); }","if (!isFiniteValue(prediction)) { return; }","write_results(index, vec4<f32>(prediction, pivotRatio, f32(retained), 0.0));","statuses[statusesOffset + index] = 0u;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index * 4u];"],"strings":["gpu-spatial-analysis-local-rbf-snapshot-tap","local-rbf","results","statuses","buffer","predictions","capture-predictions","positions","queries","read","sample-values","imported","read_write","transient","GPULocalRBF","InterpolationLensPredictionCapture","compute"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_K