x >= INVOCATION_COUNT) {","    return;","  var result = getNaN();","if (included(index)) {","  var weighted = 0.0;","  var total = 0.0;","  for (var slot = offsets[offsetsOffset + index]; slot < min(offsets[offsetsOffset + index + 1u], SLOTS); slot++) {","    let neighbor = neighbors[neighborsOffset + slot]; let weight = weights[weightsOffset + slot];","    if (neighbor == index || !included(neighbor) || !(weight > 0.0) || !isFiniteBits(weight)) { continue; }","    weighted += weight * values[valuesOffset + neighbor]; total += weight;","  if (total > 0.0) {","    let deviation = abs(values[valuesOffset + index] - weighted / total);","    result = deviation * deviation;","residuals[residualsOffset + index] = result;","@group(0) @binding(0) var<storage, read> residuals: array<f32>;","const meanOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> mean: array<f32>;","  _ = &mean;","  var count = 0.0; var average = 0.0;","for (var row = 0u; row < 4u; row++) {","  let value = residuals[residualsOffset + row];","  if (isFiniteBits(value)) { count += 1.0; average += (value - average) / count; }","mean[meanOffset] = select(getNaN(), average, count > 0.0);","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","@group(0) @binding(1) var<storage, read> neighbors: array<u32>;","@group(0) @binding(2) var<storage, read> weights: array<f32>;","@group(0) @binding(3) var<storage, read> residuals: array<f32>;","@group(0) @binding(4) var<storage, read> mean: array<f32>;","const resultOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> result: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","  _ = &result;","  _ = &status;","  var resultValue = getNaN(); var state = 1u;","if (isFiniteBits(residuals[residualsOffset + index])) {","  var total = 0.0; var weighted = 0.0;","  let rowBegin = offsets[offsetsOffset + index];","  let rowEnd = offsets[offsetsOffset + index + 1u];","  for (var slot = rowBegin; slot < min(rowEnd, 6u); slot++) {","    if (neighbor >= 4u || neighbor == index || !(weight > 0.0) || !isFiniteBits(weight)) { continue; }","    let residual = residuals[residualsOffset + neighbor];","    if (isFiniteBits(residual)) { weighted += weight * residual; total += weight; }","  state = 2u;","  if (total > 0.0 && mean[meanOffset] > 0.0) { resultValue = weighted / total / mean[meanOffset]; state = 0u; }","if (!isFiniteBits(resultValue) && state == 0u) { state = 2u; }","result[resultOffset + index] = resultValue; status[statusOffset + index] = state;"],"strings":["local-spatial-heteroscedasticity-residuals","local-spatial-heteroscedasticity-finish","local-spatial-heteroscedasticity-mean","read","buffer","GPULocalSpatialHeteroscedasticity","gpu-spatial-analysis-local-spatial-heteroscedasticity-snapshot-tap","imported","output-4","output-5","input-0","input-1","input-2","read_write","residuals","compute","input-3","mean","neighbors","offsets","transient","weights"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~8","~9"],["~:2",4,1,1],["~:3","~e","~0","~3","f32",0,4],["~:3","~i","~b","~3","u32",0,6]