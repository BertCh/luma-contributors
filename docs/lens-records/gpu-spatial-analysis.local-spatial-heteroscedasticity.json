{\\sum_{k\\in V}e_k^a/|V|},\\quad e_i=|x_i-\\sum_jw_{ij}x_j/\\sum_jw_{ij}|","ascii":"H_i = weightedMean_j(e_j^a) / mean_k(e_k^a), e_i = abs(x_i - weightedMean_j(x_j)), a in {1,2}. V contains finite residual rows; positive usable neighbors are renormalized. Undefined means retain status.","symbols":[{"id":"statistic","role":"output","binding":"wgsl:result"},{"id":"values","role":"input","binding":"wgsl:values"},{"id":"weights","role":"input","binding":"wgsl:weights"}]}],"sources":[{"id":"wgsl:870f6a21","language":"wgsl","moduleId":"GPULocalSpatialHeteroscedasticity/residuals","hash":"870f6a21","bodyHash":"4ac0fa50","entryPoint":"main","textLines":[[0,23],17,17,[23,2],22,17,25,17,[26,3],[28,5],22,17,[33,11],31,[44,11],43,31,[55,7],43,31,[62,6],43,31,[68,14],22,17,17,82,[34,2],[83,7],43,31,[90,7],43,31,[97,15],43,31,[112,8],31,[120,6],22,17,17,[126,2],22,17,[128,50],61,[178,2],31,[180,10],31,22,190,31,22]},{"id":"wgsl:8f54746b","language":"wgsl","moduleId":"GPULocalSpatialHeteroscedasticity/finite-residuals","hash":"8f54746b","bodyHash":"77b0b40f","entryPoint":"main","textLines":[17,[191,9],17,[23,2],22,17,17,[200,5],137,[205,10],31,[215,4],22]},{"id":"wgsl:fea42b3d","language":"wgsl","moduleId":"GPULocalSpatialHeteroscedasticity/scale-residuals","hash":"fea42b3d","bodyHash":"d02a539f","entryPoint":"main","textLines":[17,[191,3],196,[219,3],17,[222,8],22,17,17,[200,6],230,[207,8],31,[231,5],22,236,22]},{"id":"wgsl:b1ab0120","language":"wgsl","moduleId":"GPULocalSpatialHeteroscedasticity/mean","hash":"b1ab0120","bodyHash":"a06606c7","entryPoint":"main","textLines":[17,[191,3],220,[237,7],[17,6],17,17,17,[244,3],22,17,[247,2],22,17,[249,2],22,17,[251,3],31,[254,2],31,256,22,17,[257,2],22,17,[259,2],22,17,[261,3],22,17,[264,3],31,[267,2],31,[269,2],31,271,22,17,272,[265,2],31,[267,2],31,269,273,31,274,22,17,[275,14],22,17,[289,3],22,17,[292,3],22,17,[295,3],22,17,[298,5],31,[303,15],61,31,318,22,17,[319,2],22,17,[321,3],31,324,22,17,17,[325,15],31,[340,5],22,17,[345,13],31,[358,2],22,17,[360,2],[347,4],[362,2],22,17,[364,2],[347,2],[366,8],22,17,[374,6],22,17,17,[380,2],17,[200,5],230,[382,3],[207,8],31,[385,7],22]},{"id":"wgsl:dc834cb4","language":"wgsl","moduleId":"GPULocalSpatialHeteroscedasticity/finish","hash":"dc834cb4","bodyHash":"7dc184bf","entryPoint":"main","textLines":[392,3,393,5,394,7,395,11,[396,6],12,402,[14,9],17,17,[23,2],22,17,17,[222,8],22,17,17,[128,4],[133,3],137,384,[403,2],[138,4],[405,7],[148,3],[412,6],161,[418,3],31,[421,6],61,427,31,22,17,[428,2],31,22]}]},"decisions":[],"choices":[],"captures":{"schema":"luma.computation-captures/1","runId":"run-3fba21a6","executionId":"aa1902a5-d866-4ae0-8194-1e956944ef02","snapshots":[{"id":"gpu-spatial-analysis-local-spatial-heteroscedasticity-snapshots-statistic-0","name":"statistic","iteration":0,"elementType":"f32","values":"b64:OHBgPThwYD758eM/OHBgPg==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-local-spatial-heteroscedasticity-compiled","resource":"output-4","meaning":"gpu-spatial-analysis-local-spatial-heteroscedasticity-snapshot-tap","role":"output","valueCount":4},{"id":"gpu-spatial-analysis-local-spatial-heteroscedasticity-snapshots-status-0","name":"status","iteration":0,"elementType":"u32","values":"b64:AAAAAAAAAAAAAAAAAAAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-local-spatial-heteroscedasticity-compiled","resource":"output-5","meaning":"gpu-spatial-analysis-local-spatial-heteroscedasticity-snapshot-tap","role":"output","valueCount":4}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["@group(0) @binding(0) var<storage, read> values: array<f32>;","var<private> valuesOffset: u32;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","var<private> offsetsOffset: u32;","@group(0) @binding(2) var<storage, read> neighbors: array<u32>;","var<private> neighborsOffset: u32;","@group(0) @binding(3) var<storage, read> weights: array<f32>;","var<private> weightsOffset: u32;","@group(0) @binding(4) var<storage, read> parameters: array<f32>;","var<private> parametersOffset: u32;","@group(0) @binding(5) var<storage, read_write> residuals: array<f32>;","var<private> residualsOffset: u32;","struct GraphChunkGroupParameters { words: array<vec4<u32>, 16> }","@group(0) @binding(6) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","fn getChunkParameter(word: u32) -> u32 { return graphChunkGroupParameters.words[word / 4u][word % 4u]; }","var<private> CAPACITY: u32;","var<private> WEIGHTS_ROW_START: u32;","","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","const ROWS: u32 = 4u;","fn included(row: u32) -> bool {","  if (row >= ROWS) { return false; }","  ","  for (var column = 0u; column < 1u; column++) {","    if (!isFiniteBits(values[valuesOffset + row * 1u + column])) { return false; }","  }","  return true;","fn getAdditionRoundingError(first: f32, second: f32, sum: f32) -> f32 {","  let firstBits = bitcast<u32>(first);","  let secondBits = bitcast<u32>(second);","  let sumBits = bitcast<u32>(sum);","  let firstMagnitude = firstBits & 0x7fffffffu;","  let secondMagnitude = secondBits & 0x7fffffffu;","  let sumMagnitude = sumBits & 0x7fffffffu;","  // A zero operand makes the addition exact; an infinity or a NaN has no rounding error to report.","  if (firstMagnitude == 0u || secondMagnitude == 0u ||","      max(max(firstMagnitude, secondMagnitude), sumMagnitude) >= 0x7f800000u) {","    return 0.0;","  let firstIsLarger = firstMagnitude >= secondMagnitude;","  let largerBits = select(secondBits, firstBits, firstIsLarger);","  let smallerBits = select(firstBits, secondBits, firstIsLarger);","  let largerMagnitude = largerBits & 0x7fffffffu;","  let smallerMagnitude = smallerBits & 0x7fffffffu;","  // Biased exponents (1 for subnormals) and 24-bit significands: |value| = significand * 2^(exponent - 150).","  let largerExponent = max(largerMagnitude >> 23u, 1u);","  let smallerExponent = max(smallerMagnitude >> 23u, 1u);","  let sumExponent = max(sumMagnitude >> 23u, 1u);","  // Below 2^-103 the error would be subnormal, where ldexp is not dependable: report none.","  if (smallerExponent < 24u) {","  let gap = largerExponent - smallerExponent;","  if (gap > 25u) {","    // The smaller operand is below a quarter of the larger one's last place: the sum is the larger","    // operand and the whole smaller operand is the error.","    if (sumBits == largerBits) {","      return bitcast<f32>(smallerBits);","    }","  // The sum's last place, as a left shift from the smaller operand's last place. A rounded sum has","  // the larger operand's exponent, the next one (a carry) or the one below (a borrow). Anything","  // lower is a cancellation, which is exact, and so is a sum whose last place is finer than the","  // smaller operand's.","  if (sumMagnitude == 0u || sumExponent + 1u < largerExponent || sumExponent > largerExponent + 1u ||","      sumExponent < smallerExponent) {","  let sumShift = sumExponent - smallerExponent;","  let largerSignificand = (largerMagnitude & 0x7fffffu) | select(0u, 0x800000u, largerMagnitude >= 0x800000u);","  let smallerSignificand = (smallerMagnitude & 0x7fffffu) | select(0u, 0x800000u, smallerMagnitude >= 0x800000u);","  let sumSignificand = (sumMagnitude & 0x7fffffu) | select(0u, 0x800000u, sumMagnitude >= 0x800000u);","  // Signed integers in units of the smaller operand's last place, modulo 2^32. Each term can pass","  // 2^32, but their combination is at most 2^25 in magnitude, so the wrapped result is exact.","  let largerUnits = largerSignificand << gap;","  let sumUnits = sumSignificand << sumShift;","  let signedLarger = select(largerUnits, 0u - largerUnits, (largerBits & 0x80000000u) != 0u);","  let signedSmaller = select(smallerSignificand, 0u - smallerSignificand, (smallerBits & 0x80000000u) != 0u);","  let signedSum = select(sumUnits, 0u - sumUnits, (sumBits & 0x80000000u) != 0u);","  let errorUnits = bitcast<i32>(signedLarger + signedSmaller - signedSum);","  // The rounding error of an addition is an f32, so the conversion and the scaling are exact.","  return ldexp(f32(errorUnits), i32(smallerExponent) - 150);","fn getMultiplicationRoundingError(first: f32, second: f32, product: f32) -> f32 {","  let productBits = bitcast<u32>(product);","  // Biased exponents: |value| = significand * 2^(exponent - 150) for a normal value.","  let firstExponent = (firstBits >> 23u) & 0xffu;","  let secondExponent = (secondBits >> 23u) & 0xffu;","  let productExponent = (productBits >> 23u) & 0xffu;","  if (firstExponent == 0u || secondExponent == 0u || productExponent == 0u ||","      firstExponent == 255u || secondExponent == 255u || productExponent == 255u) {","  // The exact product is exactSignificand * 2^(firstExponent + secondExponent - 300), with a","  // significand of 47 or 48 bits. The error is scaled by one ldexp whose exponent is kept at","  // -126 or above, where ldexp is dependable: operands whose binary exponents sum to less than","  // -80 report no error (every product below 2^-80, and those below 2^-79 whose significands","  // multiply to 2 or more).","  let exponentSum = firstExponent + secondExponent;","  if (exponentSum < 174u) {","  let firstSignificand = (firstBits & 0x7fffffu) | 0x800000u;","  let secondSignificand = (secondBits & 0x7fffffu) | 0x800000u;","  // 48-bit product of the two 24-bit significands, as two 24-bit limbs.","  let firstHigh = firstSignificand >> 12u;","  let firstLow = firstSignificand & 0xfffu;","  let secondHigh = secondSignificand >> 12u;","  let secondLow = secondSignificand & 0xfffu;","  let middle = firstHigh * secondLow + firstLow * secondHigh;","  let lowSum = firstLow * secondLow + ((middle & 0xfffu) << 12u);","  let exactLow = lowSum & 0xffffffu;","  let exactHigh = firstHigh * secondHigh + (middle >> 12u) + (lowSum >> 24u);","  // The significand of the rounded product sits 23, 24 or 25 bits above the last place of the","  // exact product (25 when the rounding carried into the next binade).","  let shift = productExponent + 150u - exponentSum;","  if (shift < 23u || shift > 25u) {","  let productSignificand = (productBits & 0x7fffffu) | 0x800000u;","  var roundedHigh = productSignificand;","  var roundedLow = 0u;","  if (shift == 23u) {","    roundedHigh = productSignificand >> 1u;","    roundedLow = (productSignificand & 1u) << 23u;","  } else if (shift == 25u) {","    roundedHigh = productSignificand << 1u;","  // Exact as an integer. Its conversion to f32 is exact for a correctly rounded product (at","  // most 2^24 units); for a product one or two steps off it can need 25 bits and is rounded.","  let errorUnits = (i32(exactHigh) - i32(roundedHigh)) * 16777216 + (i32(exactLow) - i32(roundedLow));","  let magnitude = ldexp(f32(errorUnits), i32(exponentSum) - 300);","  // The exact product has the sign of the operands' signs combined; so has its error's scale.","  return select(magnitude, -magnitude, ((firstBits ^ secondBits) & 0x80000000u) != 0u);","fn getRoundedDifference(minuend: f32, subtrahend: f32, runtimeZero: u32) -> f32 {","  return bitcast<f32>(bitcast<u32>(minuend - subtrahend) ^ runtimeZero);","@compute @workgroup_size(256)","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(num_workgroups) workgroupCount: vec3<u32>,","  @builtin(local_invocation_index) localInvocationIndex: u32) {","  _ = &values;","  _ = &offsets;","  _ = &neighbors;","  _ = &weights;","  _ = &parameters;","  _ = &residuals;","  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  valuesOffset = getChunkParameter(4u);","  offsetsOffset = getChunkParameter(5u);","  neighborsOffset = getChunkParameter(6u);","  weightsOffset = getChunkParameter(7u);","  parametersOffset = getChunkParameter(8u);","  residualsOffset = getChunkParameter(9u);","  CAPACITY = arrayLength(&neighbors) - neighborsOffset;","  WEIGHTS_ROW_START = getChunkParameter(36u);","  { let index = index + getChunkParameter(0u);","  var result = getNaN();","if (included(index)) {","  let focus = values[valuesOffset + index];","  var weighted = 0.0;","  var weightedError = 0.0;","  var weightedErrorLow = 0.0;","  let runtimeZero = bitcast<u32>(parameters[parametersOffset]) >> 31u;","  var total = 0.0;","  var constantNeighborhood = true;","  for (var slot = offsets[offsetsOffset + index - WEIGHTS_ROW_START]; slot < min(offsets[offsetsOffset + index - WEIGHTS_ROW_START + 1u], CAPACITY); slot++) {","    let neighbor = neighbors[neighborsOffset + slot]; let weight = weights[weightsOffset + slot];","    if (neighbor == index || !included(neighbor) || !(weight > 0.0) || !isFiniteBits(weight)) { continue; }","    let difference = getRoundedDifference(values[valuesOffset + neighbor], focus, runtimeZero);","    // The rounded subtraction can lose the entire harmonic residual before multiplication.","    // Carry its low part as well as the product and running-sum rounding errors.","    let differenceError = getAdditionRoundingError(values[valuesOffset + neighbor], -focus, difference);","    let term = getRoundedDifference(weight * difference, 0.0, runtimeZero);","    let next = getRoundedDifference(weighted + term, 0.0, runtimeZero);","    let scaledDifferenceError = getRoundedDifference(weight * differenceError, 0.0, runtimeZero);","    weightedErrorLow += getMultiplicationRoundingError(weight, differenceError, scaledDifferenceError);","    // The corrections are themselves summed with compensation: their own rounding can be as","    // large as a harmonic residual's last place (review B1, R19 W5-16).","    for (var part = 0u; part < 3u; part++) {","      let correction = select(select(scaledDifferenceError, getMultiplicationRoundingError(weight, difference, term), part == 1u), getAdditionRoundingError(weighted, term, next), part == 0u);","      let nextError = getRoundedDifference(weightedError + correction, 0.0, runtimeZero);","      weightedErrorLow += getAdditionRoundingError(weightedError, correction, nextError);","      weightedError = nextError;","    weighted = next; total += weight;","    constantNeighborhood = constantNeighborhood && values[valuesOffset + neighbor] == values[valuesOffset + index];","  if (total > 0.0) {","    // weighted + weightedError + weightedErrorLow, adding the two leading parts with their error.","    let leading = getRoundedDifference(weighted + weightedError, 0.0, runtimeZero);","    let trailing = getAdditionRoundingError(weighted, weightedError, leading) + weightedErrorLow;","    var deviation = abs((leading + trailing) / total);","    // Equal finite values have exactly zero residual. An approximate GPU reciprocal in the","    // weighted mean must not create a residual field that later gets normalized into a pattern.","    // The weighted differences also preserve harmonic zero residuals with unequal neighbors.","    if (constantNeighborhood) { deviation = 0.0; }","    result = select(deviation * deviation, deviation, parameters[parametersOffset] == 1.0);","residuals[residualsOffset + index] = result;","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const residualsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> residuals: array<f32>;","const finiteResidualsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> finiteResiduals: array<f32>;","const residualCountsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> residualCounts: array<u32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &finiteResiduals;","  _ = &residualCounts;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let value = residuals[residualsOffset + index];","let finite = isFiniteBits(value);","finiteResiduals[finiteResidualsOffset + index] = select(0.0, value, finite);","residualCounts[residualCountsOffset + index] = u32(finite);","@group(0) @binding(0) var<storage, read_write> finiteResiduals: array<f32>;","const maximumResidualOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> maximumResidual: array<f32>;","fn getScaledQuotient(value: f32, first: f32, second: f32, power: i32) -> f32 {","  if (value == 0.0) { return value; }","  let numerator = frexp(value);","  let firstDivisor = frexp(first);","  let secondDivisor = frexp(second);","  let quotient = frexp(numerator.fract / (firstDivisor.fract * secondDivisor.fract));","  return ldexp(quotient.fract,","    numerator.exp - firstDivisor.exp - secondDivisor.exp + power + quotient.exp);","  _ = &maximumResidual;","  let maximum = maximumResidual[maximumResidualOffset];","var scaled = 0.0;","if (maximum > 0.0) {","  // A direct division can flush the reciprocal of a large maximum to zero.","  scaled = getScaledQuotient(finiteResiduals[finiteResidualsOffset + index], maximum, 1.0, 0);","finiteResiduals[finiteResidualsOffset + index] = scaled;","@group(0) @binding(0) var<storage, read> maximumResidual: array<f32>;","const normalizedSumOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> normalizedSum: array<f32>;","const residualCountOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> residualCount: array<u32>;","const meanOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> mean: array<f32>;","fn addUint64(left: vec2<u32>, right: vec2<u32>) -> vec2<u32> {","  let low = left.y + right.y;","  return vec2<u32>(left.x + right.x + select(0u, 1u, low < left.y), low);","fn subtractUint64(left: vec2<u32>, right: vec2<u32>) -> vec2<u32> {","  return vec2<u32>(left.x - right.x - select(0u, 1u, left.y < right.y), left.y - right.y);","fn negateInt64(value: vec2<u32>) -> vec2<u32> {","  return subtractUint64(vec2<u32>(0u, 0u), value);","fn compareUint64(left: vec2<u32>, right: vec2<u32>) -> i32 {","  if (left.x != right.x) {","    return select(-1i, 1i, left.x > right.x);","  if (left.y != right.y) {","    return select(-1i, 1i, left.y > right.y);","  return 0i;","fn isLessUint64(left: vec2<u32>, right: vec2<u32>) -> bool {","  return left.x < right.x || (left.x == right.x && left.y < right.y);","fn isLessOrEqualUint64(left: vec2<u32>, right: vec2<u32>) -> bool {","  return left.x < right.x || (left.x == right.x && left.y <= right.y);","// Signed order: flipping the sign bit of the high words makes them compare as unsigned.","fn compareInt64(left: vec2<u32>, right: vec2<u32>) -> i32 {","  return compareUint64(vec2<u32>(left.x ^ 0x80000000u, left.y), vec2<u32>(right.x ^ 0x80000000u, right.y));","fn shiftLeftUint64(value: vec2<u32>, bits: u32) -> vec2<u32> {","  if (bits == 0u) {","    return value;","  if (bits >= 64u) {","    return vec2<u32>(0u, 0u);","  if (bits >= 32u) {","    return vec2<u32>(value.y << (bits - 32u), 0u);","  return vec2<u32>((value.x << bits) | (value.y >> (32u - bits)), value.y << bits);","fn shiftRightUint64(value: vec2<u32>, bits: u32) -> vec2<u32> {","    return vec2<u32>(0u, value.x >> (bits - 32u));","  return vec2<u32>(value.x >> bits, (value.y >> bits) | (value.x << (32u - bits)));","// Exact 32 x 32 -> 64 bit product from 16-bit limbs; no partial sum exceeds 2^32.","fn multiplyUint32Wide(left: u32, right: u32) -> vec2<u32> {","  let leftLow = left & 0xffffu;","  let leftHigh = left >> 16u;","  let rightLow = right & 0xffffu;","  let rightHigh = right >> 16u;","  let lowLow = leftLow * rightLow;","  let lowHigh = leftLow * rightHigh;","  let highLow = leftHigh * rightLow;","  let middle = (lowLow >> 16u) + (lowHigh & 0xffffu) + (highLow & 0xffffu);","  return vec2<u32>(","    leftHigh * rightHigh + (lowHigh >> 16u) + (highLow >> 16u) + (middle >> 16u),","    (lowLow & 0xffffu) | (middle << 16u)","  );","fn multiplyUint64ByUint32(left: vec2<u32>, right: u32) -> vec2<u32> {","  let wide = multiplyUint32Wide(left.y, right);","  return vec2<u32>(wide.x + left.x * right, wide.y);","fn multiplyUint64(left: vec2<u32>, right: vec2<u32>) -> vec2<u32> {","  let wide = multiplyUint32Wide(left.y, right.y);","  return vec2<u32>(wide.x + left.y * right.x + left.x * right.y, wide.y);","struct Uint64Division {","  quotient: vec2<u32>,","  remainder: u32,","// Restoring division one bit at a time. The running remainder stays below the divisor, so after a","// shift it is below 2^33; the bit shifted out of the u32 is carried in overflowBit.","fn divideUint64ByUint32(value: vec2<u32>, divisor: u32) -> Uint64Division {","  if (divisor == 0u) {","    return Uint64Division(vec2<u32>(0xffffffffu, 0xffffffffu), 0u);","  var quotient = vec2<u32>(0u, 0u);","  var remainder = 0u;","  for (var bit = 0u; bit < 64u; bit++) {","    let position = 63u - bit;","    let word = select(value.y, value.x, position >= 32u);","    let incoming = (word >> (position & 31u)) & 1u;","    let overflowBit = remainder >> 31u;","    remainder = (remainder << 1u) | incoming;","    if (overflowBit != 0u || remainder >= divisor) {","      remainder = remainder - divisor;","      if (position >= 32u) {","        quotient.x = quotient.x | (1u << (position - 32u));","      } else {","        quotient.y = quotient.y | (1u << position);","      }","  return Uint64Division(quotient, remainder);","fn uint64ToFloat(value: vec2<u32>) -> f32 {","  return f32(value.x) * 4294967296.0 + f32(value.y);","fn int64ToFloat(value: vec2<u32>) -> f32 {","  if ((value.x & 0x80000000u) != 0u) {","    return -uint64ToFloat(negateInt64(value));","  return uint64ToFloat(value);","fn roundSpatialCountValue(magnitude: vec2<u32>, exponentScale: i32, negative: u32, sticky: bool) -> f32 {","  let bitLength = select(32u - countLeadingZeros(magnitude.y), 64u - countLeadingZeros(magnitude.x), magnitude.x != 0u);","  if (bitLength == 0u) { return bitcast<f32>(negative); }","  let subnormal = exponentScale + i32(bitLength) - 1i < -126i;","  let shift = select(i32(bitLength) - 24i, -149i - exponentScale, subnormal);","  if (shift >= 64i) { return bitcast<f32>(negative); }","  var rounded = 0u;","  if (shift <= 0i) {","    rounded = shiftLeftUint64(magnitude, u32(-shift)).y;","  } else {","    let quotient = shiftRightUint64(magnitude, u32(shift));","    let discarded = subtractUint64(magnitude, shiftLeftUint64(quotient, u32(shift)));","    let halfway = shiftLeftUint64(vec2<u32>(0u, 1u), u32(shift - 1i));","    let comparison = compareUint64(discarded, halfway);","    rounded = quotient.y + u32(comparison > 0i || (comparison == 0i && (sticky || (quotient.y & 1u) != 0u)));","  if (subnormal) { return bitcast<f32>(negative | rounded); }","  var exponent = exponentScale + shift + 150i;","  if (rounded >= 0x1000000u) { rounded = rounded >> 1u; exponent++; }","  if (exponent >= 255i) { return bitcast<f32>(negative | 0x7f800000u); }","  return bitcast<f32>(negative | (u32(exponent) << 23u) | (rounded & 0x7fffffu));","fn divideBySpatialCount(value: f32, count: u32) -> f32 {","  if (count <= 16777216u) { return value / f32(count); }","  let bits = bitcast<u32>(value);","  let exponent = (bits >> 23u) & 255u;","  let significand = (bits & 0x7fffffu) | select(0u, 0x800000u, exponent != 0u);","  if (exponent == 255u || significand == 0u) { return value; }","  let division = divideUint64ByUint32(vec2<u32>(significand, 0u), count);","  var quotient = division.quotient;","  // With no discarded integer bits, the division remainder supplies the rounding decision.","  if (quotient.x == 0u && quotient.y < 0x1000000u && exponent > 32u) {","    let complement = count - division.remainder;","    quotient.y += u32(division.remainder > complement ||","      (division.remainder == complement && (quotient.y & 1u) != 0u));","  return roundSpatialCountValue(quotient, i32(max(exponent, 1u)) - 182i,","    bits & 0x80000000u, division.remainder != 0u && !(quotient.y <= 0x1000000u && exponent > 32u));","fn multiplyBySpatialCount(value: f32, count: u32) -> f32 {","  if (count <= 16777216u) { return value * f32(count); }","  return roundSpatialCountValue(multiplyUint32Wide(significand, count), i32(max(exponent, 1u)) - 150i,","    bits & 0x80000000u, false);","fn divideSpatialCountByValue(count: u32, value: f32) -> f32 {","  if (count <= 16777216u) { return f32(count) / value; }","  let fraction = bits & 0x7fffffu;","  let negative = bits & 0x80000000u;","  if (exponent == 255u) { return select(bitcast<f32>(negative), value, fraction != 0u); }","  let significand = fraction | select(0u, 0x800000u, exponent != 0u);","  if (significand == 0u) { return bitcast<f32>(negative | 0x7f800000u); }","  let division = divideUint64ByUint32(vec2<u32>(count, 0u), significand);","  return roundSpatialCountValue(division.quotient, 118i - i32(max(exponent, 1u)),","    negative, division.remainder != 0u);","fn divideSpatialCounts(numerator: u32, denominator: u32) -> f32 {","  if (numerator <= 16777216u && denominator <= 16777216u) { return f32(numerator) / f32(denominator); }","  if (numerator == 0u) { return 0.0; }","  let shift = 31u + countLeadingZeros(numerator);","  let division = divideUint64ByUint32(shiftLeftUint64(vec2<u32>(0u, numerator), shift), denominator);","  return roundSpatialCountValue(division.quotient, -i32(shift), 0u, division.remainder != 0u);","// 2^126 is finite; splitting larger exponents avoids an overflowing ldexp scale.","const MAXIMUM_MEAN_SCALE_EXPONENT: i32 = 126;","  _ = &normalizedSum;","  _ = &residualCount;","  _ = &mean;","  let count = residualCount[residualCountOffset];","let maximum = frexp(maximumResidual[maximumResidualOffset]);","// Keep the maximum's exponent out of float products, including compiler reassociation.","let fraction = maximum.fract * divideBySpatialCount(normalizedSum[normalizedSumOffset], count);","let firstExponent = min(maximum.exp, MAXIMUM_MEAN_SCALE_EXPONENT);","let average = ldexp(ldexp(fraction, firstExponent), maximum.exp - firstExponent);","mean[meanOffset] = select(getNaN(), average, count > 0u);","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","@group(0) @binding(1) var<storage, read> neighbors: array<u32>;","@group(0) @binding(2) var<storage, read> weights: array<f32>;","@group(0) @binding(3) var<storage, read> residuals: array<f32>;","@group(0) @binding(4) var<storage, read> mean: array<f32>;","var<private> meanOffset: u32;","@group(0) @binding(5) var<storage, read_write> result: array<f32>;","var<private> resultOffset: u32;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","var<private> statusOffset: u32;","@group(0) @binding(7) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","  _ = &result;","  _ = &status;","  offsetsOffset = getChunkParameter(4u);","  neighborsOffset = getChunkParameter(5u);","  weightsOffset = getChunkParameter(6u);","  residualsOffset = getChunkParameter(7u);","  meanOffset = getChunkParameter(8u);","  resultOffset = getChunkParameter(9u);","  statusOffset = getChunkParameter(10u);","  var resultValue = getNaN(); var state = 1u;","if (isFiniteBits(residuals[residualsOffset + index])) {","  var total = 0.0; var weighted = 0.0;","  let rowBegin = offsets[offsetsOffset + index - WEIGHTS_ROW_START];","  let rowEnd = offsets[offsetsOffset + index - WEIGHTS_ROW_START + 1u];","  for (var slot = rowBegin; slot < min(rowEnd, CAPACITY); slot++) {","    if (neighbor >= 4u || neighbor == index || !(weight > 0.0) || !isFiniteBits(weight)) { continue; }","    let residual = residuals[residualsOffset + neighbor];","    if (isFiniteBits(residual)) { weighted += weight * residual; total += weight; }","  state = 2u;","  if (total > 0.0 && mean[meanOffset] > 0.0) {","    if (isFiniteBits(weighted) && isFiniteBits(total) && isFiniteBits(mean[meanOffset])) {","      resultValue = getScaledQuotient(weighted, total, mean[meanOffset], 0);","    } else {","      resultValue = weighted / total / mean[meanOffset];","    state = 0u;","if (!isFiniteBits(resultValue) && state == 0u) { state = 2u; }","result[resultOffset + index] = resultValue; status[statusOffset + index] = state;"],"strings":["local-spatial-heteroscedasticity-residuals","local-spatial-heteroscedasticity-finite-residuals","buffer","local-spatial-heteroscedasticity-mean","read","logical","local-spatial-heteroscedasticity-finish","compute","GPULocalSpatialHeteroscedasticity","local-spatial-heteroscedasticity-maximum-residual-finalize","local-spatial-heteroscedasticity-maximum-residual","local-spatial-heteroscedasticity-maximum-residual-level-0","transient","read_write","gpu-spatial-analysis-local-spatial-heteroscedasticity-snapshot-tap","imported","local-spatial-heteroscedasticity-normalized-sum-finalize","local-spatial-heteroscedasticity-normalized-sum-level-0","local-spatial-heteroscedasticity-residual-count-finalize","local-spatial-heteroscedasticity-residual-count-level-0","local-spatial-heteroscedasticity-residual-counts","local-spatial-heteroscedasticity-scale-residuals","output-4","output-5","input-0","input-1","input-2","local-spatial-heteroscedasticity-normalized-sum","local-spatial-heteroscedasticity-parameters","local-spatial-heteroscedasticity-residual-count","local-spatial-heteroscedasticity-maximum-residual-level-0-validity","local-spatial-heteroscedasticity-maximum-residual-level-0-values","local-spatial-heteroscedasticity-normalized-sum-level-0-values","local-spatial-heteroscedasticity-parameters-upload","local-spatial-heteroscedasticity-residual-count-level-0-values","lower-bound