rage, read> values: array<f32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> neighbors: array<u32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> weights: array<f32>;","const residualsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> residuals: array<f32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","const ROWS: u32 = 4u; const SLOTS: u32 = 6u;","fn included(row: u32) -> bool {","  if (row >= ROWS) { return false; }","  ","  for (var column = 0u; column < 1u; column++) {","    if (!isFiniteBits(values[valuesOffset + row * 1u + column])) { return false; }","  }","  return true;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &offsets;","  _ = &neighbors;","  _ = &weights;","  _ = &residuals;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var result = getNaN();","if (included(index)) {","  var weighted = 0.0;","  var total = 0.0;","  for (var slot = offsets[offsetsOffset + index]; slot < min(offsets[offsetsOffset + index + 1u], SLOTS); slot++) {","    let neighbor = neighbors[neighborsOffset + slot]; let weight = weights[weightsOffset + slot];","    if (neighbor == index || !included(neighbor) || !(weight > 0.0) || !isFiniteBits(weight)) { continue; }","    weighted += weight * values[valuesOffset + neighbor]; total += weight;","  if (total > 0.0) {","    let deviation = abs(values[valuesOffset + index] - weighted / total);","    result = deviation * deviation;","residuals[residualsOffset + index] = result;","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","@group(0) @binding(1) var<storage, read> neighbors: array<u32>;","@group(0) @binding(2) var<storage, read> weights: array<f32>;","@group(0) @binding(3) var<storage, read> values: array<f32>;","const rowStatesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> rowStates: array<u32>;","fn isFiniteFloat(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// A runtime operand keeps the quiet-NaN bit pattern out of constant evaluation.","fn getQuietNaN(seed: u32) -> f32 { return bitcast<f32>(0x7fc00000u | (seed & 0u)); }","// Two-sided normal p-value erfc(|z| / sqrt(2)) through the shared erfcValue (Numerical Recipes","// erfcc Chebyshev fit, fractional error below 1.2e-7), so tiny p-values keep relative accuracy.","fn erfcValue(x: f32) -> f32 {","  let z = abs(x);","  let t = 1.0 / (1.0 + 0.5 * z);","  let r = t * exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 +","    t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 +","    t * (-0.82215223 + t * 0.17087277)))))))));","  return select(2.0 - r, r, x >= 0.0);","// Floor of every analytic (normal) p-value: the smallest normal f32. f32 exp underflows beyond","// |z| of about 13, where erfc would read exactly 0; a floor keeps such p-values positive, so they","// stay ordered against larger ones in a multiple-testing correction and safe under log(). One","// rule for the global, local, hot-spot and emerging-hot-spot statistics.","const ANALYTIC_P_VALUE_FLOOR: f32 = 1.17549435e-38;","fn getTwoSidedPValue(z: f32) -> f32 {","  return clamp(erfcValue(abs(z) * 0.70710678118654752), ANALYTIC_P_VALUE_FLOOR, 1.0);","const ROWS: u32 = 4u;","const CAPACITY: u32 = 6u;","fn isRawRowValid(row: u32) -> bool {","  return isFiniteFloat(values[valuesOffset + row]);","  _ = &rowStates;","  if (!isRawRowValid(index)) {","    rowStates[rowStatesOffset + index] = 0u;","  var hasNeighbor = false;","  {","    let activeRow = index;","    let activeBegin = min(offsets[offsetsOffset + activeRow], CAPACITY);","    let activeEnd = min(offsets[offsetsOffset + activeRow + 1u], CAPACITY);","    for (var slot = activeBegin; slot < activeEnd; slot++) {","      let neighbor = neighbors[neighborsOffset + slot];","      if (neighbor >= ROWS || neighbor == activeRow) {","        continue;","      }","      let weight = weights[weightsOffset + slot];","      if (!(weight > 0.0) || !(isRawRowValid(neighbor))) {","      hasNeighbor = true; break;","    }","  rowStates[rowStatesOffset + index] = select(2u, 1u, hasNeighbor);","@group(0) @binding(0) var<storage, read> residuals: array<f32>;","const meanOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> mean: array<f32>;","  _ = &mean;","  var count = 0.0; var average = 0.0;","for (var row = 0u; row < 4u; row++) {","  let value = residuals[residualsOffset + row];","  if (isFiniteBits(value)) { count += 1.0; average += (value - average) / count; }","mean[meanOffset] = select(getNaN(), average, count > 0.0);","@group(0) @binding(1) var<storage, read> rowStates: array<u32>;","const valuePartialsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> valuePartials: array<f32>;","const countPartialsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> countPartials: array<u32>;","const islandPartialsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> islandPartials: array<u32>;","const MOMENTS: u32 = 4u;","const ROW_COUNT: u32 = 4u;","const BLOCK_ROWS: u32 = 4096u;","const WORKGROUP_SIZE: u32 = 256u;","fn isRowValid(row: u32) -> bool {","  let state = rowStates[rowStatesOffset + row];","  return state == 1u || (state == 2u && false);","var<workgroup> partialSums: array<f32, 256>;","var<workgroup> partialCounts: array<u32, 256>;","var<workgroup> partialIslands: array<u32, 256>;","@compute @workgroup_size(256)","  _ = &valuePartials;","  _ = &countPartials;","  _ = &islandPartials;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let block = index / WORKGROUP_SIZE;","  let isInRange = index < INVOCATION_COUNT;","  var sum = 0.0;","  var count = 0u;","  var islands = 0u;","  if (isInRange) {","    let end = min((block + 1u) * BLOCK_ROWS, ROW_COUNT);","    for (var row = block * BLOCK_ROWS + localInvocationIndex; row < end; row += WORKGROUP_SIZE) {","      if (isRowValid(row)) {","        sum += values[valuesOffset + row];","        count++;","      islands += select(0u, 1u, rowStates[rowStatesOffset + row] == 2u);","  partialSums[localInvocationIndex] = sum;","  partialCounts[localInvocationIndex] = count;","  partialIslands[localInvocationIndex] = islands;","  workgroupBarrier();","  for (var stride = WORKGROUP_SIZE / 2u; stride > 0u; stride = stride / 2u) {","    if (localInvocationIndex < stride) {","      partialSums[localInvocationIndex] += partialSums[localInvocationIndex + stride];","      partialCounts[localInvocationIndex] += partialCounts[localInvocationIndex + stride];","      partialIslands[localInvocationIndex] += partialIslands[localInvocationIndex + stride];","    workgroupBarrier();","  if (isInRange && localInvocationIndex == 0u) {","    valuePartials[valuePartialsOffset + block] = partialSums[0];","    countPartials[countPartialsOffset + block] = partialCounts[0];","    islandPartials[islandPartialsOffset + block] = partialIslands[0];","@group(0) @binding(3) var<storage, read> residuals: array<f32>;","@group(0) @binding(4) var<storage, read> mean: array<f32>;","const resultOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> result: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","  _ = &result;","  _ = &status;","  var resultValue = getNaN(); var state = 1u;","if (isFiniteBits(residuals[residualsOffset + index])) {","  var total = 0.0; var weighted = 0.0;","  let rowBegin = offsets[offsetsOffset + index];","  let rowEnd = offsets[offsetsOffset + index + 1u];","  for (var slot = rowBegin; slot < min(rowEnd, 6u); slot++) {","    if (neighbor >= 4u || neighbor == index || !(weight > 0.0) || !isFiniteBits(weight)) { continue; }","    let residual = residuals[residualsOffset + neighbor];","    if (isFiniteBits(residual)) { weighted += weight * residual; total += weight; }","  state = 2u;","  if (total > 0.0 && mean[meanOffset] > 0.0) { resultValue = weighted / total / mean[meanOffset]; state = 0u; }","if (!isFiniteBits(resultValue) && state == 0u) { state = 2u; }","result[resultOffset + index] = resultValue; status[statusOffset + index] = state;","@group(0) @binding(0) var<storage, read> valuePartials: array<f32>;","@group(0) @binding(1) var<storage, read> countPartials: array<u32>;","@group(0) @binding(2) var<storage, read> islandPartials: array<u32>;","const statisticsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> statistics: array<f32>;","const BLOCK_COUNT: u32 = 1u;","  _ = &statistics;","  for (var block = localInvocationIndex; block < BLOCK_COUNT; block += WORKGROUP_SIZE) {","    sum += valuePartials[valuePartialsOffset + block];","    count += countPartials[countPartialsOffset + block];","    islands += islandPartials[islandPartialsOffset + block];","  if (localInvocationIndex == 0u) {","    // The count is exact in u32 and converted to f32 only here. The mean is provisional: the","    // deviation pass corrects it.","    let total = f32(partialCounts[0]);","    statistics[statisticsOffset + MOMENTS] = total;","    statistics[statisticsOffset + MOMENTS + 1u] = select(getQuietNaN(index), partialSums[0] / total, total >= 1.0);","    statistics[statisticsOffset + MOMENTS + 4u] = f32(partialIslands[0]);","@group(0) @binding(2) var<storage, read_write> statistics: array<f32>;","const deviationPartialsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> deviationPartials: array<f32>;","  _ = &deviationPartials;","    let provisionalMean = statistics[statisticsOffset + MOMENTS + 1u];","      let valid = isRowValid(row);","      let deviation = values[valuesOffset + row] - provisionalMean;","      statistics[statisticsOffset + row] = select(getQuietNaN(row), deviation, valid);","      sum += select(0.0, deviation, valid);","    deviationPartials[deviationPartialsOffset + block] = partialSums[0];","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index];","@group(0) @binding(0) var<storage, read> source: array<u32>;","@group(0) @binding(1) var<storage, read_write> destination: array<u32>;","@group(0) @binding(0) var<storage, read> deviationPartials: array<f32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> parameters: array<f32>;","fn readParameter(slot: u32) -> f32 {","  return parameters[parametersOffset + slot];","  _ = &parameters;","    sum += deviationPartials[deviationPartialsOffset + block];","    var total = statistics[statisticsOffset + MOMENTS];","    var mean = statistics[statisticsOffset + MOMENTS + 1u];","    // Mean of the first-pass deviations: what the center pass subtracts from each stored deviation.","    var residualMean = 0.0;","    if (total >= 1.0) {","      residualMean = partialSums[0] / total;","    if (readParameter(1u) != 0.0) {","      // Fixed moments: center on the given mean, again through the stored deviations.","      residualMean = readParameter(3u) - mean;","      total = readParameter(2u);","      mean = readParameter(3u);","    } else {","      mean += residualMean;","    ","    statistics[statisticsOffset + MOMENTS + 1u] = mean;","    statistics[statisticsOffset + MOMENTS + 5u] = residualMean;","const squarePartialsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> squarePartials: array<f32>;","  _ = &squarePartials;","    let residualMean = statistics[statisticsOffset + MOMENTS + 5u];","      // The stored first-pass deviation minus the mean of those deviations. It is read back from","      // memory, not recomputed as (x - mean1) - mean2, which a shader compiler may reassociate to","      // x - (mean1 + mean2).","      let centered = statistics[statisticsOffset + row] - residualMean;","      // Rows outside the analysis store quiet NaN, which every later kernel reads as \"not a focus","      // row and not a neighbor\".","      statistics[statisticsOffset + row] = select(getQuietNaN(row), centered, valid);","      sum += select(0.0, centered * centered, valid);","    squarePartials[squarePartialsOffset + block] = partialSums[0];","@group(0) @binding(0) var<storage, read> squarePartials: array<f32>;","    sum += squarePartials[squarePartialsOffset + block];","    let count = statistics[statisticsOffset + MOMENTS];","    let mean = statistics[statisticsOffset + MOMENTS + 1u];","    var sumOfSquares = partialSums[0];","    var variance = select(getQuietNaN(index), sumOfSquares / count, count >= 1.0);","      variance = readParameter(4u);","      sumOfSquares = variance * count;","    statistics[statisticsOffset + MOMENTS + 2u] = variance;","    statistics[statisticsOffset + MOMENTS + 3u] = sumOfSquares;","@group(0) @binding(3) var<storage, read> statistics: array<f32>;","const zScoresOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> zScores: array<f32>;","const localIOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> localI: array<f32>;","@group(0) @binding(6) var<storage, read> parameters: array<f32>;","const quadrantsOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> quadrants: array<u32>;","const pValuesOffset: u32 = 0u;","@group(0) @binding(8) var<storage, read_write> pValues: array<f32>;","const adjustedPValuesOffset: u32 = 0u;","@group(0) @binding(9) var<storage, read_write> adjustedPValues: array<f32>;","const MINIMUM_NEIGHBORS: u32 = 1u;","const STANDARDIZE: bool = false;","  _ = &zScores;","  _ = &localI;","  _ = &quadrants;","  _ = &pValues;","  _ = &adjustedPValues;","  let centered = statistics[statisticsOffset + index];","  var zScore = getQuietNaN(index);","  var lag = getQuietNaN(index);","  var neighborCount = 0u;","  if (isFiniteFloat(centered)) {","    var neighborSum = 0.0;","    var weightSum = 0.0;","    var squareSum = 0.0;","    {","      if (!(weight > 0.0) || !(isFiniteFloat(statistics[statisticsOffset + neighbor]))) {","      neighborSum += weight * statistics[statisticsOffset + neighbor];","      weightSum += weight;","      squareSum += weight * weight;","      neighborCount++;","    if (STANDARDIZE && weightSum > 0.0) {","      // Row-standardized weights are divided by what remains of their row sum.","      neighborSum = neighborSum / weightSum;","      squareSum = squareSum / (weightSum * weightSum);","      weightSum = 1.0;","    lag = neighborSum;","    let others = statistics[statisticsOffset + MOMENTS] - 1.0;","    let sumOfSquares = statistics[statisticsOffset + MOMENTS + 3u];","    let otherMean = -centered / others;","    let otherVariance = (sumOfSquares - centered * centered) / others - otherMean * otherMean;","    let lagVariance = otherVariance * (others * squareSum - weightSum * weightSum) / (others - 1.0);","    if (others >= 2.0 && centered != 0.0 && neighborCount >= MINIMUM_NEIGHBORS &&","        lagVariance > 0.0 && isFiniteFloat(lagVariance)) {","      let lagZ = (neighborSum - weightSum * otherMean) / sqrt(lagVariance);","      zScore = select(lagZ, -lagZ, centered < 0.0);","  zScores[zScoresOffset + index] = zS