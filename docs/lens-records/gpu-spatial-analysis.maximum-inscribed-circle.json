override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const ringOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> ringOffsets: array<u32>;","const polygonOffsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> polygonOffsets: array<u32>;","const featureOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> featureOffsets: array<u32>;","const circlesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> circles: array<f32>;","const witnessesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> witnesses: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","const cellsOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> cells: array<f32>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn loadCell(base: u32, cell: u32) -> vec4f {","  let address = cellsOffset + base + cell * 4u;","  return vec4f(cells[address], cells[address + 1u], cells[address + 2u], cells[address + 3u]);","}","fn storeCell(base: u32, cell: u32, value: vec4f) {","  cells[address] = value.x; cells[address + 1u] = value.y;","  cells[address + 2u] = value.z; cells[address + 3u] = value.w;","const CELL_CAPACITY: u32 = 128u;","const MAXIMUM_ITERATIONS: u32 = 128u;","const TOLERANCE: f32 = 0.009999999776482582;","const VERTEX_COUNT: u32 = 4u;","const RING_COUNT: u32 = 1u;","const POLYGON_COUNT: u32 = 1u;","fn point(row: u32) -> vec2f { return vec2f(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]); }","fn closestSegmentPoint(query: vec2f, start: vec2f, end: vec2f) -> vec2f {","  let edge = end - start;","  let denominator = dot(edge, edge);","  if (!(denominator > 0.0)) { return start; }","  let fromStart = dot(query - start, edge);","  if (fromStart <= 0.0) { return start; }","  let fromEnd = dot(end - query, edge);","  if (fromEnd <= 0.0) { return end; }","  if (edge.y == 0.0) { return vec2f(query.x, start.y); }","  if (edge.x == 0.0) { return vec2f(start.x, query.y); }","  if (fromStart <= fromEnd) { return start + (fromStart / denominator) * edge; }","  return end - (fromEnd / denominator) * edge;","fn signedDistance(query: vec2f, firstRing: u32, lastRing: u32, origin: vec2f) -> vec3f {","  var inside = false;","  var distanceSquared = 3.4028234663852886e38;","  var witness = query;","  for (var ring = firstRing; ring < lastRing; ring++) {","    let firstVertex = min(ringOffsets[ringOffsetsOffset + ring], VERTEX_COUNT);","    let lastVertex = min(ringOffsets[ringOffsetsOffset + ring + 1u], VERTEX_COUNT);","    if (lastVertex <= firstVertex) { continue; }","    var previous = point(lastVertex - 1u) - origin;","    for (var vertex = firstVertex; vertex < lastVertex; vertex++) {","      let current = point(vertex) - origin;","      let edge = current - previous;","      let denominator = dot(edge, edge);","      if ((bitcast<u32>(denominator) & 0x7f800000u) == 0x7f800000u) { return vec3f(getQuietNaN()); }","      // Project from the nearer endpoint: a long edge's rounded fraction displaces the witness.","      let candidate = closestSegmentPoint(query, previous, current);","      let candidateSquared = dot(query - candidate, query - candidate);","      if ((bitcast<u32>(candidateSquared) & 0x7f800000u) == 0x7f800000u) { return vec3f(getQuietNaN()); }","      if (candidateSquared < distanceSquared) { distanceSquared = candidateSquared; witness = candidate; }","      if ((current.y > query.y) != (previous.y > query.y)) {","        if (query.x < previous.x + (query.y - previous.y) * (current.x - previous.x) / (current.y - previous.y)) { inside = !inside; }","      }","      previous = current;","    }","  }","  return vec3f(witness, select(-sqrt(distanceSquared), sqrt(distanceSquared), inside));","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &ringOffsets;","  _ = &polygonOffsets;","  _ = &featureOffsets;","  _ = &circles;","  _ = &witnesses;","  _ = &status;","  _ = &cells;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let firstPolygon = min(featureOffsets[featureOffsetsOffset + index], POLYGON_COUNT);","let lastPolygon = min(featureOffsets[featureOffsetsOffset + index + 1u], POLYGON_COUNT);","let firstRing = min(polygonOffsets[polygonOffsetsOffset + firstPolygon], RING_COUNT);","let lastRing = min(polygonOffsets[polygonOffsetsOffset + lastPolygon], RING_COUNT);","var minimum = vec2f(3.0e38);","var maximum = vec2f(-3.0e38);","var vertexCount = 0u;","var invalid = false;","var bestPoint = vec2f(0.0);","for (var ring = firstRing; ring < lastRing; ring++) {","  for (var vertex = min(ringOffsets[ringOffsetsOffset + ring], VERTEX_COUNT); vertex < min(ringOffsets[ringOffsetsOffset + ring + 1u], VERTEX_COUNT); vertex++) {","    let current = point(vertex);","    if (any((bitcast<vec2u>(current) & vec2u(0x7f800000u)) == vec2u(0x7f800000u))) { invalid = true; }","    minimum = min(minimum, current); maximum = max(maximum, current);","    bestPoint = current; vertexCount++;","let nan = getQuietNaN();","var bestRadius = 0.0;","var bestWitness = bestPoint;","var error = 0.0;","var resultStatus = 0u;","if (invalid || vertexCount == 0u) {","  bestPoint = vec2f(nan); bestRadius = nan; bestWitness = vec2f(nan); error = nan;","  resultStatus = select(2u, 3u, invalid);","} else {","  // Search in a local frame so sub-ULP interior points survive until publication.","  let searchOrigin = minimum;","  maximum = maximum - searchOrigin; minimum = vec2f(0.0);","  bestPoint = bestPoint - searchOrigin; bestWitness = bestPoint;","  let cellBase = index * CELL_CAPACITY * 4u;","  let center = 0.5 * minimum + 0.5 * maximum;","  let halfSize = 0.5 * max(maximum.x - minimum.x, maximum.y - minimum.y);","  let seed = signedDistance(center, firstRing, lastRing, searchOrigin);","  if (seed.z > bestRadius) { bestRadius = seed.z; bestPoint = center; bestWitness = seed.xy; }","  storeCell(cellBase, 0u, vec4f(center, halfSize, seed.z + 1.4142135623730951 * halfSize));","  var cellCount = 1u;","  var iterations = 0u;","  loop {","    if ((bitcast<u32>(seed.z) & 0x7f800000u) == 0x7f800000u) { resultStatus = 3u; break; }","    var winner = 0u;","    for (var cell = 1u; cell < cellCount; cell++) { if (loadCell(cellBase, cell).w > loadCell(cellBase, winner).w) { winner = cell; } }","    let parent = loadCell(cellBase, winner);","    error = max(0.0, parent.w - bestRadius);","    if (error <= TOLERANCE) { break; }","    if (iterations >= MAXIMUM_ITERATIONS || cellCount + 3u > CELL_CAPACITY || parent.z * 0.5 == parent.z) { resultStatus = 1u; break; }","    storeCell(cellBase, winner, loadCell(cellBase, cellCount - 1u)); cellCount--;","    let childHalfSize = parent.z * 0.5;","    for (var child = 0u; child < 4u; child++) {","      let childCenter = parent.xy + childHalfSize * vec2f(select(-1.0, 1.0, (child & 1u) != 0u), select(-1.0, 1.0, (child & 2u) != 0u));","      let distance = signedDistance(childCenter, firstRing, lastRing, searchOrigin);","      if ((bitcast<u32>(distance.z) & 0x7f800000u) == 0x7f800000u) { resultStatus = 3u; break; }","      if (distance.z > bestRadius) { bestRadius = distance.z; bestPoint = childCenter; bestWitness = distance.xy; }","      storeCell(cellBase, cellCount, vec4f(childCenter, childHalfSize, distance.z + 1.4142135623730951 * childHalfSize)); cellCount++;","    if (resultStatus == 3u) { break; }","    // Compact cells already dominated by the best lower bound, but retain one.","    var kept = 0u;","    for (var cell = 0u; cell < cellCount; cell++) {","      if (loadCell(cellBase, cell).w > bestRadius) { storeCell(cellBase, kept, loadCell(cellBase, cell)); kept++; }","    if (kept == 0u) { error = 0.0; break; }","    cellCount = kept; iterations++;","  bestPoint = searchOrigin + bestPoint; bestWitness = searchOrigin + bestWitness;","// Arithmetic overflow cannot provide a geometric bound or a usable witness.","if (resultStatus == 3u) { bestPoint = vec2f(nan); bestRadius = nan; bestWitness = vec2f(nan); error = nan; }","circles[circlesOffset + index * 4u] = bestPoint.x;","circles[circlesOffset + index * 4u + 1u] = bestPoint.y;","circles[circlesOffset + index * 4u + 2u] = bestRadius;","circles[circlesOffset + index * 4u + 3u] = error;","witnesses[witnessesOffset + index * 2u] = bestWitness.x;","witnesses[witnessesOffset + index * 2u + 1u] = bestWitness.y;","status[statusOffset + index] = resultStatus;","const publicationOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> publication: array<f32>;","const EXACT_SUM_WORDS: u32 = 12u;","fn exactLowestExponent(value: f32) -> i32 {","  let biased = (bitcast<u32>(value) >> 23u) & 255u;","  return select(i32(biased) - 150, -149, biased == 0u);","fn exactSignificand(value: f32) -> u32 {","  let bits = bitcast<u32>(value);","  return (bits & 8388607u) | select(8388608u, 0u, ((bits >> 23u) & 255u) == 0u);","fn exactMultiply(first: u32, second: u32) -> vec2u {","  let low = (first & 65535u) * (second & 65535u);","  let middleFirst = (first >> 16u) * (second & 65535u) + (low >> 16u);","  let middleSecond = (first & 65535u) * (second >> 16u) + (middleFirst & 65535u);","  return vec2u((middleSecond << 16u) | (low & 65535u),","    (first >> 16u) * (second >> 16u) + (middleFirst >> 16u) + (middleSecond >> 16u));","fn exactAdd(words: ptr<function, array<u32, 12>>, index: u32, value: u32) {","  var carry = value;","  for (var slot = index; slot < EXACT_SUM_WORDS && carry != 0u; slot++) {","    let previous = (*words)[slot];","    let sum = previous + carry;","    (*words)[slot] = sum;","    carry = select(0u, 1u, sum < previous);","fn exactProductSumSign(values: ptr<function, array<f32, 16>>, count: u32) -> i32 {","  var base = 2147483647;","  for (var term = 0u; term < count; term++) {","    let first = (*values)[term * 2u]; let second = (*values)[term * 2u + 1u];","    if (first != 0.0 && second != 0.0) { base = min(base, exactLowestExponent(first) + exactLowestExponent(second)); }","  if (base == 2147483647) { return 0; }","  var positive: array<u32, 12>;","  var negative: array<u32, 12>;","    if (first == 0.0 || second == 0.0) { continue; }","    let shift = exactLowestExponent(first) + exactLowestExponent(second) - base;","    if (shift > i32(EXACT_SUM_WORDS * 32u) - 49) { return 2; }","    let product = exactMultiply(exactSignificand(first), exactSignificand(second));","    let word = u32(shift) / 32u;","    let remainder = u32(shift) % 32u;","    var parts = vec3u(product, 0u);","    if (remainder != 0u) {","      parts = vec3u(product.x << remainder,","        (product.y << remainder) | (product.x >> (32u - remainder)),","        product.y >> (32u - remainder));","    let subtract = (first < 0.0) != (second < 0.0);","    for (var part = 0u; part < 3u; part++) {","      if (word + part >= EXACT_SUM_WORDS) { continue; }","      if (subtract) { exactAdd(&negative, word + part, parts[part]); }","      else { exactAdd(&positive, word + part, parts[part]); }","  for (var word = i32(EXACT_SUM_WORDS) - 1; word >= 0; word--) {","    if (positive[u32(word)] > negative[u32(word)]) { return 1; }","    if (positive[u32(word)] < negative[u32(word)]) { return -1; }","  return 0;","// Sign of dot(c - a, b - a).","fn exactDotSign(c: vec2f, a: vec2f, b: vec2f) -> i32 {","  var values = array<f32, 16>(c.x, b.x, -c.x, a.x, -a.x, b.x, a.x, a.x,","    c.y, b.y, -c.y, a.y, -a.y, b.y, a.y, a.y);","  return exactProductSumSign(&values, 8u);","// The stored witness w is the exact closest point of segment a-b to center c.","fn isExactClosestPoint(w: vec2f, c: vec2f, a: vec2f, b: vec2f) -> bool {","  if (all(w == a)) { return exactDotSign(c, a, b) <= 0; }","  if (all(w == b)) { return exactDotSign(c, b, a) <= 0; }","  if (exactDotSign(c, a, b) != 1 || exactDotSign(c, b, a) != 1) { return false; }","  // On the line: cross(b - a, w - a) == 0.","  var line = array<f32, 16>(b.x, w.y, -b.x, a.y, -a.x, w.y, -b.y, w.x, b.y, a.x, a.y, w.x,","    0.0, 0.0, 0.0, 0.0);","  if (exactProductSumSign(&line, 6u) != 0) { return false; }","  // Perpendicular foot: dot(w - c, b - a) == 0.","  var foot = array<f32, 16>(w.x, b.x, -w.x, a.x, -c.x, b.x, c.x, a.x,","    w.y, b.y, -w.y, a.y, -c.y, b.y, c.y, a.y);","  return exactProductSumSign(&foot, 8u) == 0;","struct Nearest { absolute: vec2f, relative: vec2f, start: vec2f, end: vec2f, distance: f32, exact: f32 }","fn nearestBoundary(center: vec2f, firstRing: u32, lastRing: u32) -> Nearest {","  var result = Nearest(center, vec2f(0.0), center, center, 3.4028234663852886e38, 0.0);","    let first = min(ringOffsets[ringOffsetsOffset + ring], VERTEX_COUNT);","    let last = min(ringOffsets[ringOffsetsOffset + ring + 1u], VERTEX_COUNT);","    if (last <= first) { continue; }","    var previousPoint = point(last - 1u);","    var previous = previousPoint - center;","    for (var vertex = first; vertex < last; vertex++) {","      let currentPoint = point(vertex);","      let current = currentPoint - center;","      // Center-relative coordinates keep sub-ULP clearance; the projection starts from the","      // nearer endpoint (stable on long edges). Vertices and axis-aligned feet are exact.","      let relative = closestSegmentPoint(vec2f(0.0), previous, current);","      let squared = dot(relative, relative);","      if (squared < distanceSquared) {","        distanceSquared = squared;","        let edge = currentPoint - previousPoint;","        var absolute = center + relative;","        var exactWitness = false;","        if (all(relative == previous)) { absolute = previousPoint; exactWitness = true; }","        else if (all(relative == current)) { absolute = currentPoint; exactWitness = true; }","        else if (edge.y == 0.0) { absolute = vec2f(center.x, previousPoint.y); exactWitness = true; }","        else if (edge.x == 0.0) { absolute = vec2f(previousPoint.x, center.y); exactWitness = true; }","        var published = relative;","        if (exactWitness) { published = absolute - center; }","        result = Nearest(absolute, published, previousPoint, currentPoint, 0.0, select(0.0, 1.0, exactWitness));","      if ((current.y > 0.0) != (previous.y > 0.0)) {","        if (0.0 < previous.x - previous.y * (current.x - previous.x) / (current.y - previous.y)) { inside = !inside; }","      previousPoint = currentPoint;","  result.distance = select(-sqrt(distanceSquared), sqrt(distanceSquared), inside);","  return result;","  _ = &publication;","  let address = circlesOffset + index * 4u;","var center = vec2f(circles[address], circles[address + 1u]);","let searchRadius = circles[address + 2u];","var relative = vec2f(searchRadius);","var clearance = searchRadius;","var limited = 0.0;","if (!any((bitcast<vec2u>(center) & vec2u(0x7f800000u)) == vec2u(0x7f800000u))) {","  let lastPolygon = min(featureOffsets[featureOffsetsOffset + index + 1u], POLYGON_COUNT);","  let firstRing = min(polygonOffsets[polygonOffsetsOffset + firstPolygon], RING_COUNT);","  let lastRing = min(polygonOffsets[polygonOffsetsOffset + lastPolygon], RING_COUNT);","  var nearest = nearestBoundary(center, firstRing, lastRing);","  if (nearest.distance < 0.0) {","    // A stored source vertex is a representable boundary fallback, including with empty rings.","    for (var ring = firstRing; ring < lastRing; ring++) {","      let first = min(ringOffsets[ringOffsetsOffset + ring], VERTEX_COUNT);","      let last = min(ringOffsets[ringOffsetsOffset + ring + 1u], VERTEX_COUNT);","     