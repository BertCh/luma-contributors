ite> cells: array<f32>;","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn loadCell(base: u32, cell: u32) -> vec4f {","  let address = cellsOffset + base + cell * 4u;","  return vec4f(cells[address], cells[address + 1u], cells[address + 2u], cells[address + 3u]);","}","fn storeCell(base: u32, cell: u32, value: vec4f) {","  cells[address] = value.x; cells[address + 1u] = value.y;","  cells[address + 2u] = value.z; cells[address + 3u] = value.w;","const CELL_CAPACITY: u32 = 128u;","const MAXIMUM_ITERATIONS: u32 = 128u;","const TOLERANCE: f32 = 0.009999999776482582;","const VERTEX_COUNT: u32 = 4u;","const RING_COUNT: u32 = 1u;","const POLYGON_COUNT: u32 = 1u;","fn point(row: u32) -> vec2f { return vec2f(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]); }","fn signedDistance(query: vec2f, firstRing: u32, lastRing: u32) -> vec3f {","  var inside = false;","  var distanceSquared = 3.4028234663852886e38;","  var witness = query;","  for (var ring = firstRing; ring < lastRing; ring++) {","    let firstVertex = min(ringOffsets[ringOffsetsOffset + ring], VERTEX_COUNT);","    let lastVertex = min(ringOffsets[ringOffsetsOffset + ring + 1u], VERTEX_COUNT);","    if (lastVertex <= firstVertex) { continue; }","    var previous = point(lastVertex - 1u);","    for (var vertex = firstVertex; vertex < lastVertex; vertex++) {","      let current = point(vertex);","      let edge = current - previous;","      let denominator = dot(edge, edge);","      if ((bitcast<u32>(denominator) & 0x7f800000u) == 0x7f800000u) { return vec3f(getQuietNaN()); }","      var fraction = 0.0;","      if (denominator > 0.0) { fraction = clamp(dot(query - previous, edge) / denominator, 0.0, 1.0); }","      let candidate = previous + fraction * edge;","      let candidateSquared = dot(query - candidate, query - candidate);","      if ((bitcast<u32>(candidateSquared) & 0x7f800000u) == 0x7f800000u) { return vec3f(getQuietNaN()); }","      if (candidateSquared < distanceSquared) { distanceSquared = candidateSquared; witness = candidate; }","      if ((current.y > query.y) != (previous.y > query.y)) {","        if (query.x < previous.x + (query.y - previous.y) * (current.x - previous.x) / (current.y - previous.y)) { inside = !inside; }","      }","      previous = current;","    }","  }","  return vec3f(witness, select(-sqrt(distanceSquared), sqrt(distanceSquared), inside));","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &ringOffsets;","  _ = &polygonOffsets;","  _ = &featureOffsets;","  _ = &circles;","  _ = &witnesses;","  _ = &status;","  _ = &cells;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let firstPolygon = min(featureOffsets[featureOffsetsOffset + index], POLYGON_COUNT);","let lastPolygon = min(featureOffsets[featureOffsetsOffset + index + 1u], POLYGON_COUNT);","let firstRing = min(polygonOffsets[polygonOffsetsOffset + firstPolygon], RING_COUNT);","let lastRing = min(polygonOffsets[polygonOffsetsOffset + lastPolygon], RING_COUNT);","var minimum = vec2f(3.0e38);","var maximum = vec2f(-3.0e38);","var vertexCount = 0u;","var invalid = false;","var bestPoint = vec2f(0.0);","for (var ring = firstRing; ring < lastRing; ring++) {","  for (var vertex = min(ringOffsets[ringOffsetsOffset + ring], VERTEX_COUNT); vertex < min(ringOffsets[ringOffsetsOffset + ring + 1u], VERTEX_COUNT); vertex++) {","    let current = point(vertex);","    if (any((bitcast<vec2u>(current) & vec2u(0x7f800000u)) == vec2u(0x7f800000u))) { invalid = true; }","    minimum = min(minimum, current); maximum = max(maximum, current);","    bestPoint = current; vertexCount++;","let nan = getQuietNaN();","var bestRadius = 0.0;","var bestWitness = bestPoint;","var error = 0.0;","var resultStatus = 0u;","if (invalid || vertexCount == 0u) {","  bestPoint = vec2f(nan); bestRadius = nan; bestWitness = vec2f(nan); error = nan;","  resultStatus = select(2u, 3u, invalid);","} else {","  let cellBase = index * CELL_CAPACITY * 4u;","  let center = 0.5 * minimum + 0.5 * maximum;","  let halfSize = 0.5 * max(maximum.x - minimum.x, maximum.y - minimum.y);","  let seed = signedDistance(center, firstRing, lastRing);","  if (seed.z > bestRadius) { bestRadius = seed.z; bestPoint = center; bestWitness = seed.xy; }","  storeCell(cellBase, 0u, vec4f(center, halfSize, seed.z + 1.4142135623730951 * halfSize));","  var cellCount = 1u;","  var iterations = 0u;","  loop {","    if ((bitcast<u32>(seed.z) & 0x7f800000u) == 0x7f800000u) { resultStatus = 3u; break; }","    var winner = 0u;","    for (var cell = 1u; cell < cellCount; cell++) { if (loadCell(cellBase, cell).w > loadCell(cellBase, winner).w) { winner = cell; } }","    let parent = loadCell(cellBase, winner);","    error = max(0.0, parent.w - bestRadius);","    if (error <= TOLERANCE) { break; }","    if (iterations >= MAXIMUM_ITERATIONS || cellCount + 3u > CELL_CAPACITY || parent.z * 0.5 == parent.z) { resultStatus = 1u; break; }","    storeCell(cellBase, winner, loadCell(cellBase, cellCount - 1u)); cellCount--;","    let childHalfSize = parent.z * 0.5;","    for (var child = 0u; child < 4u; child++) {","      let childCenter = parent.xy + childHalfSize * vec2f(select(-1.0, 1.0, (child & 1u) != 0u), select(-1.0, 1.0, (child & 2u) != 0u));","      let distance = signedDistance(childCenter, firstRing, lastRing);","      if ((bitcast<u32>(distance.z) & 0x7f800000u) == 0x7f800000u) { resultStatus = 3u; break; }","      if (distance.z > bestRadius) { bestRadius = distance.z; bestPoint = childCenter; bestWitness = distance.xy; }","      storeCell(cellBase, cellCount, vec4f(childCenter, childHalfSize, distance.z + 1.4142135623730951 * childHalfSize)); cellCount++;","    if (resultStatus == 3u) { break; }","    // Compact cells already dominated by the best lower bound, but retain one.","    var kept = 0u;","    for (var cell = 0u; cell < cellCount; cell++) {","      if (loadCell(cellBase, cell).w > bestRadius) { storeCell(cellBase, kept, loadCell(cellBase, cell)); kept++; }","    if (kept == 0u) { error = 0.0; break; }","    cellCount = kept; iterations++;","// Arithmetic overflow cannot provide a geometric bound or a usable witness.","if (resultStatus == 3u) { bestPoint = vec2f(nan); bestRadius = nan; bestWitness = vec2f(nan); error = nan; }","circles[circlesOffset + index * 4u] = bestPoint.x;","circles[circlesOffset + index * 4u + 1u] = bestPoint.y;","circles[circlesOffset + index * 4u + 2u] = bestRadius;","circles[circlesOffset + index * 4u + 3u] = error;","witnesses[witnessesOffset + index * 2u] = bestWitness.x;","witnesses[witnessesOffset + index * 2u + 1u] = bestWitness.y;","status[statusOffset + index] = resultStatus;"],"strings":["maximum-inscribed-circle-search","gpu-spatial-analysis-maximum-inscribed-circle-snapshot-tap","buffer","logical","circles","imported","status","witnesses","input-feature-offsets","input-polygon-offsets","input-positions","input-ring-offsets","maximum-inscribed-circle-cells","read","read_write","GPUMaximumInscribedCircle"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","a