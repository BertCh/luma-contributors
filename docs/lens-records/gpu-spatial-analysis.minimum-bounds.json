m{points}{h_j}\\cdot\\term{normal}{n_e}-\\min_{\\term{index}{j}}\\term{points}{h_j}\\cdot\\term{normal}{n_e}\\right)\\\\\\term{best}{B_e}&=\\begin{cases}\\term{area}{A_e}&\\term{area}{A_e}<(1-10^{-6})\\term{best}{B_{e-1}}\\\\\\term{best}{B_{e-1}}&\\text{otherwise}\\end{cases},\\quad\\term{best}{B_0}=\\term{area}{A_0},\\quad\\term{output}{A_{\\rm rect}}=\\term{best}{B_{\\rm last}}\\end{aligned}","ascii":"For each nonzero hull edge e, use its unit direction u and left normal n. Candidate area A[e]=(max dot(h,u)-min dot(h,u))*(max dot(h,n)-min dot(h,n)). Start B at the first candidate; replace it only when A[e] < (1-1e-6)*B. rectangleSizes.area is the last B. Hull points are anchor-relative; one-point/collinear rectangles have zero area, empty or overflowing hulls report NaN. This formula describes the rectangle selection; circles use shuffled Welzl with a recomputed covering radius.","symbols":[{"id":"area","role":"intermediate","label":"Hull-edge-aligned rectangle area","binding":"wgsl:area"},{"id":"index","role":"index","label":"Hull vertex"},{"id":"points","role":"input","label":"Anchor-relative hull points","binding":"wgsl:loadPoint"},{"id":"direction","role":"intermediate","label":"Unit hull-edge direction","binding":"wgsl:direction"},{"id":"normal","role":"intermediate","label":"Left normal","binding":"wgsl:normal"},{"id":"best","role":"intermediate","label":"Best area so far","binding":"wgsl:bestArea"},{"id":"output","role":"output","label":"rectangleSizes area component","binding":"wgsl:sizes"}]}],"sources":[]},"decisions":[],"choices":[{"stage":"operator","name":"maximumHullVertices","sweepable":true,"value":256},{"name":"coordinateModel","stage":"presentation","sweepable":false,"value":"projected"},{"name":"crs","stage":"presentation","sweepable":false,"value":"EPSG:32616"},{"name":"falseOrigin","stage":"presentation","sweepable":false,"value":"440000, 4630000"}],"captures":{"schema":"luma.computation-captures/1","runId":"run-97592aa5","snapshots":[{"id":"gp