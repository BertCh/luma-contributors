+ index * 2u + column]); }","valid[validOffset + index] = select(0u, 1u, included);","@group(0) @binding(1) var<storage, read> valid: array<u32>;","const standardizedOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> standardized: array<f32>;","  _ = &standardized;","  var count = 0u; var mean = 0.0; var squares = 0.0;","for (var row = 0u; row < 24u; row++) { if (valid[validOffset + row] != 0u) { count++; let value = values[valuesOffset + row * 2u + index]; let difference = value - mean; mean += difference / f32(count); squares += difference * (value - mean); } }","for (var row = 0u; row < 24u; row++) { var value = getNaN(); if (count > 1u && squares > 0.0 && isFiniteBits(squares) && isFiniteBits(mean) && valid[validOffset + row] != 0u) { value = (values[valuesOffset + row * 2u + index] - mean) * sqrt(f32(count) / squares); } standardized[standardizedOffset + row * 2u + index] = value; }","@group(0) @binding(0) var<storage, read> standardized: array<f32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> neighbors: array<u32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> weights: array<f32>;","const observedOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> observed: array<f32>;","const simulationsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> simulations: array<f32>;","fn philoxMulHiLo(a: u32, b: u32) -> vec2<u32> {","  let aLow = a & 0xffffu;","  let aHigh = a >> 16u;","  let bLow = b & 0xffffu;","  let bHigh = b >> 16u;","  let lowLow = aLow * bLow;","  let highLow = aHigh * bLow;","  let lowHigh = aLow * bHigh;","  let highHigh = aHigh * bHigh;","  let middle = (lowLow >> 16u) + (highLow & 0xffffu) + (lowHigh & 0xffffu);","  let high = highHigh + (highLow >> 16u) + (lowHigh >> 16u) + (middle >> 16u);","  return vec2<u32>(high, a * b);","fn philoxRound(counter: vec4<u32>, key: vec2<u32>) -> vec4<u32> {","  let product0 = philoxMulHiLo(3528531795u, counter.x);","  let product1 = philoxMulHiLo(3449720151u, counter.z);","  return vec4<u32>(","    product1.x ^ counter.y ^ key.x,","    product1.y,","    product0.x ^ counter.w ^ key.y,","    product0.y","  );","fn philox4x32(counterIn: vec4<u32>, keyIn: vec2<u32>) -> vec4<u32> {","  var counter = counterIn;","  var key = keyIn;","  for (var roundIndex = 0u; roundIndex < 9u; roundIndex = roundIndex + 1u) {","    counter = philoxRound(counter, key);","    key = key + vec2<u32>(2654435769u, 3144134277u);","  return philoxRound(counter, key);","fn philoxUnitFloat(word: u32) -> f32 {","  return f32(word >> 8u) * (1.0 / 16777216.0);","fn getPhiloxMultiplyHigh(a: u32, b: u32) -> u32 {","  return philoxMulHiLo(a, b).x;","fn getPhilox4x32(counter: vec4<u32>, key: vec2<u32>) -> vec4<u32> {","  return philox4x32(counter, key);","struct PhiloxStream {","  key: vec2<u32>,","  words: vec3<u32>,","  block: u32,","  lane: u32,","  buffer: vec4<u32>","fn createPhiloxStream(key: vec2<u32>, a: u32, b: u32, c: u32) -> PhiloxStream {","  var stream: PhiloxStream;","  stream.key = key;","  stream.words = vec3<u32>(a, b, c);","  stream.block = 0u;","  stream.lane = 4u;","  stream.buffer = vec4<u32>(0u);","  return stream;","fn nextPhiloxUint32(stream: ptr<function, PhiloxStream>) -> u32 {","  if ((*stream).lane == 4u) {","    (*stream).buffer = getPhilox4x32(","      vec4<u32>((*stream).block, (*stream).words.x, (*stream).words.y, (*stream).words.z),","      (*stream).key","    );","    (*stream).block = (*stream).block + 1u;","    (*stream).lane = 0u;","  let word = (*stream).buffer[(*stream).lane];","  (*stream).lane = (*stream).lane + 1u;","  return word;","fn nextPhiloxBelow(stream: ptr<function, PhiloxStream>, bound: u32) -> u32 {","  var value = nextPhiloxUint32(stream);","  var low = value * bound;","  if (low < bound) {","    let threshold = (0u - bound) % bound;","    while (low < threshold) {","      value = nextPhiloxUint32(stream);","      low = value * bound;","    }","  return getPhiloxMultiplyHigh(value, bound);","@compute @workgroup_size(256)","  _ = &offsets;","  _ = &neighbors;","  _ = &weights;","  _ = &observed;","  _ = &simulations;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let row = index / 20u; let replicate = index % 20u;","var candidates: array<u32, 24>; var count = 0u;","for (var other = 0u; other < 24u; other++) { if (other != row && valid[validOffset + other] != 0u) { candidates[count] = other; count++; } }","var value = getNaN();","if (valid[validOffset + row] != 0u && count > 0u) {"," var total = 0.0; var weightSum = 0.0; var chosen = 0u;"," var stream = createPhiloxStream(vec2<u32>(0u, 0u), row, replicate, 68769u);"," for (var slot = offsets[offsetsOffset + row]; slot < offsets[offsetsOffset + row + 1u]; slot++) {","  let neighbor = neighbors[neighborsOffset + slot]; let weight = weights[weightsOffset + slot];","  if (neighbor >= 24u || neighbor == row || !(weight > 0.0)) { continue; }","  if (valid[validOffset + neighbor] == 0u) { continue; }","  var candidate = neighbor;","  if (replicate > 0u) { let selection = chosen + nextPhiloxBelow(&stream, count - chosen); candidate = candidates[selection]; candidates[selection] = candidates[chosen]; candidates[chosen] = candidate; chosen++; }","  var distance = 0.0;","  for (var column = 0u; column < 2u; column++) { let difference = standardized[standardizedOffset + row * 2u + column] - standardized[standardizedOffset + candidate * 2u + column]; distance += difference * difference; }","  total += weight * distance / 2.0; weightSum += weight;"," }"," if (weightSum > 0.0) { value = total / weightSum; }","if (replicate == 0u) { observed[observedOffset + row] = value; } else { simulations[simulationsOffset + row * 19u + replicate - 1u] = value; }","@group(0) @binding(0) var<storage, read> observed: array<f32>;","@group