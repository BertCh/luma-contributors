"// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","const ROWS: u32 = 4u; const SLOTS: u32 = 6u;","fn included(row: u32) -> bool {","  if (row >= ROWS) { return false; }","  ","  for (var column = 0u; column < 2u; column++) {","    if (!isFiniteBits(values[valuesOffset + row * 2u + column])) { return false; }","  }","  return true;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &variance;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var count = 0.0; var mean = 0.0; var squared = 0.0;","for (var row = 0u; row < 4u; row++) {","  if (!included(row)) { continue; }","  let value = values[valuesOffset + row * 2u + index];","  count += 1.0; let difference = value - mean; mean += difference / count; squared += difference * (value - mean);","variance[varianceOffset + index] = select(getNaN(), squared / count, count > 0.0);","const offsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> neighbors: array<u32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> weights: array<f32>;","@group(0) @binding(4) var<storage, read> variance: array<f32>;","const resultOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> result: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","  _ = &offsets;","  _ = &neighbors;","  _ = &weights;","  _ = &result;","  _ = &status;","  var state = 1u; var resultValue = getNaN();","if (included(index)) {","  var sum = 0.0; var total = 0.0; var defined = true;","  for (var column = 0u; column < 2u; column++) { defined = defined && variance[varianceOffset + column] > 0.0 && isFiniteBits(variance[varianceOffset + column]); }","  if (defined) {","    for (var slot = offsets[offsetsOffset + index]; slot < min(offsets[offsetsOffset + index + 1u], SLOTS); slot++) {","    let neighbor = neighbors[neighborsOffset + slot]; let weight = weights[weightsOffset + slot];","    if (neighbor == index || !included(neighbor) || !(weight > 0.0) || !isFiniteBits(weight)) { continue; }","    var distance = 0.0;","      for (var column = 0u; column < 2u; column++) {","        let difference = values[valuesOffset + index * 2u + column] - values[valuesOffset + neighbor * 2u + column];","        distance += difference * difference / variance[varianceOffset + column];","      }","      sum += weight * distance; total += weight;","  state = 2u;","  if (defined && total > 0.0) { resultValue = sum / total / 2.0; state = select(2u, 0u, isFiniteBits(resultValue)); }","result[resultOffset + index] = resultValue; status[statusOffset + index] = state;"],"strings":["multivariate-local-geary-statistic","buffer","multivariate-local-geary-variance","imported","read","input-3","multivariate-local-geary-moments","GPUMultivariateLocalGeary","output-4","output-5","input-0","input-1","input-2","read_write","compute","multivariate-local-geary","values","variance"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvoc