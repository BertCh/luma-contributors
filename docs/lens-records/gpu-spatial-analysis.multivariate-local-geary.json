n ldexp(f32(errorUnits), i32(smallerExponent) - 150);","  _ = &variance;","  var count = 0u; var mean = 0.0; var squares = 0.0; var correction = 0.0;","for (var blockIndex = 0u; blockIndex < 1u; blockIndex++) {"," let source = partialsOffset + (index * 1u + blockIndex) * 3u;"," let blockCount = u32(partials[source]); if (blockCount == 0u) { continue; }"," // The empty aggregate has no mean: avoid squaring a large first block mean."," if (count == 0u) { count = blockCount; mean = partials[source + 1u]; squares = partials[source + 2u]; continue; }"," let combined = count + blockCount; let delta = partials[source + 1u] - mean;"," let ratio = divideSpatialCounts(blockCount, combined);"," let term = partials[source + 2u] + multiplyBySpatialCount(delta * delta * ratio, count);"," let next = squares + term; correction += getAdditionRoundingError(squares, term, next); squares = next;"," mean += delta * ratio; count = combined;","variance[varianceOffset + index] = select(getNaN(), divideBySpatialCount(squares + correction, count), count > 0u);","var<private> valuesOffset: u32;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","var<private> offsetsOffset: u32;","@group(0) @binding(2) var<storage, read> neighbors: array<u32>;","var<private> neighborsOffset: u32;","@group(0) @binding(3) var<storage, read> weights: array<f32>;","var<private> weightsOffset: u32;","@group(0) @binding(4) var<storage, read> variance: array<f32>;","var<private> varianceOffset: u32;","@group(0) @binding(5) var<storage, read_write> result: array<f32>;","var<private> resultOffset: u32;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","var<private> statusOffset: u32;","struct GraphChunkGroupParameters { words: array<vec4<u32>, 16> }","@group(0) @binding(7) var<uniform> graphChunkGroupParameters: GraphChunkGroupParameters;","fn getChunkParameter(word: u32) -> u32 { return graphChunkGroupParameters.words[word / 4u][word % 4u]; }","var<private> CAPACITY: u32;","var<privat