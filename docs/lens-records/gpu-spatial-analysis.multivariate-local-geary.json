r == index || !included(neighbor) || !(weight > 0.0) || !isFiniteBits(weight)) { continue; }","    var distance = 0.0;","      for (var column = 0u; column < 2u; column++) {","        let difference = values[valuesOffset + index * 2u + column] - values[valuesOffset + neighbor * 2u + column];","        // Normalize before squaring: the squared raw difference can overflow although the","        // variance and the dimensionless Geary statistic are finite. Exponent scaling also","        // prevents Metal's reciprocal lowering from flushing a large denominator to zero.","        let standardized = getScaledQuotient(difference, sqrt(variance[varianceOffset + column]), 1.0, 0);","        distance += standardized * standardized;","      sum += weight * distance; total += weight;","  state = 2u;","  if (defined && total > 0.0) { resultValue = sum / total / 2.0; state = select(2u, 0u, isFiniteBits(resultValue)); }","result[resultOffset + index] = resultValue; status[statusOffset + index] = state;"],"strings":["multivariate-local-geary-statistic","buffer","logical","multivariate-local-geary-partials","multivariate-local-geary-variance","read","GPUMultivariateLocalGeary","gpu-spatial-analysis-multivariate-local-geary-snapshot-tap","imported","multivariate-local-geary-merge","output-4","output-5","input-3","multivariate-local-geary-blocks","read_write","compute","input-0","input-1","input-2","partials","transient","values","variance"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind"