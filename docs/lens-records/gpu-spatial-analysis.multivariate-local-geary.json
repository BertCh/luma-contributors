nt != 0u);","  if (significand == 0u) { return bitcast<f32>(negative | 0x7f800000u); }","  let division = divideUint64ByUint32(vec2<u32>(count, 0u), significand);","  return roundSpatialCountValue(division.quotient, 118i - i32(max(exponent, 1u)),","    negative, division.remainder != 0u);","fn divideSpatialCounts(numerator: u32, denominator: u32) -> f32 {","  if (numerator <= 16777216u && denominator <= 16777216u) { return f32(numerator) / f32(denominator); }","  if (numerator == 0u) { return 0.0; }","  let shift = 31u + countLeadingZeros(numerator);","  let division = divideUint64ByUint32(shiftLeftUint64(vec2<u32>(0u, numerator), shift), denominator);","  return roundSpatialCountValue(division.quotient, -i32(shift), 0u, division.remainder != 0u);","fn getAdditionRoundingError(first: f32, second: f32, sum: f32) -> f32 {","  let firstBits = bitcast<u32>(first);","  let secondBits = bitcast<u32>(second);","  let sumBits = bitcast<u32>(sum);","  let firstMagnitude = firstBits & 0x7fffffffu;","  let secondMagnitude = secondBits & 0x7fffffffu;","  let sumMagnitude = sumBits & 0x7fffffffu;","  // A zero operand makes the addition exact; an infinity or a NaN has no rounding error to report.","  if (firstMagnitude == 0u || secondMagnitude == 0u ||","      max(max(firstMagnitude, secondMagnitude), sumMagnitude) >= 0x7f800000u) {","    return 0.0;","  let firstIsLarger = firstMagnitude >= secondMagnitude;","  let largerBits = select(secondBits, firstBits, firstIsLarger);","  let smallerBits = select(firstBits, secondBits, firstIsLarger);","  let largerMagnitude = largerBits & 0x7fffffffu;","  let smallerMagnitude = smallerBits & 0x7fffffffu;","  // Biased exponents (1 for subnormals) and 24-bit significands: |value| = significand * 2^(exponent - 150).","  let largerExponent = max(largerMagnitude >> 23u, 1u);","  let smallerExponent = max(smallerMagnitude >> 23u, 1u);","  let sumExponent = max(sumMagnitude >> 23u, 1u);","  // Below 2^-103 the error would be subnormal, where ld