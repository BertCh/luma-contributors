 lattice.rows = 1u;","  lattice.bounded = false;","  lattice.radiusDegrees = 0.0;","  lattice.periodic = false;","  let minimumX = readParameter(0u);","  let minimumY = readParameter(1u);","  let maximumX = readParameter(2u);","  let maximumY = readParameter(3u);","  let radius = readParameter(4u);","  let width = maximumX - minimumX;","  let height = maximumY - minimumY;","  let radiusSquared = radius * radius;","  lattice.minimumX = minimumX;","  lattice.minimumY = minimumY;","  lattice.maximumX = maximumX;","  lattice.maximumY = maximumY;","  lattice.radius = radius;","  lattice.radiusSquared = radiusSquared;","  lattice.valid =","    isFiniteFloat(minimumX) && isFiniteFloat(minimumY) && isFiniteFloat(maximumX) &&","    isFiniteFloat(maximumY) && isFiniteFloat(width) && isFiniteFloat(height) &&","    width >= 0.0 && height >= 0.0;","  if (!lattice.valid) {","    return lattice;","  lattice.cellWidth = select(1.0, width / f32(COLUMNS), width > 0.0);","  lattice.cellHeight = select(1.0, height / f32(ROWS), height > 0.0);","  lattice.columns = COLUMNS;","  lattice.rows = ROWS;","  lattice.bounded = isFiniteFloat(radius) && isFiniteFloat(radiusSquared) && radius > 0.0;","  return lattice;","// Finite and inside the bounds, independent of whether the radius or bounds form a usable lattice.","fn isPointInBounds(lattice: Lattice, x: f32, y: f32) -> bool {","  return isFiniteFloat(x) && isFiniteFloat(y) &&","    x >= lattice.minimumX && x <= lattice.maximumX &&","    y >= lattice.minimumY && y <= lattice.maximumY;","fn isPointValid(lattice: Lattice, x: f32, y: f32) -> bool {","  return lattice.valid && isPointInBounds(lattice, x, y);","// A cross-join query. Planar queries need only finite coordinates: the cell lookups clamp to the","// lattice and every cell bound below is measured from the true position, so a query outside the","// bounds still finds its exact neighbors. Great-circle queries keep the bounds rule, because the","// longitude wrap is defined by them.","fn isCrossJoinQueryInBounds(lattice: Lattice, x: f32, y: f32) -> bool {","  return isFiniteFloat(x) && isFiniteFloat(y);","fn isCrossJoinQueryValid(lattice: Lattice, x: f32, y: f32) -> bool {","  return lattice.valid && isCrossJoinQueryInBounds(lattice, x, y);","// Both clamp a position outside the lattice (a planar cross-join query) to the nearest edge cell.","fn getCellColumn(lattice: Lattice, x: f32) -> u32 {","  return u32(clamp(floor((x - lattice.minimumX) / lattice.cellWidth), 0.0, f32(lattice.columns - 1u)));","fn getCellRow(lattice: Lattice, y: f32) -> u32 {","  return u32(clamp(floor((y - lattice.minimumY) / lattice.cellHeight), 0.0, f32(lattice.rows - 1u)));","// Distance along one axis from position (in cell queryCell) to the near edge of cell; zero","// for the query cell itself. A lower bound of the distance to any point of that cell, up to the","// rounding slack the callers subtract.","fn getAxisGap(position: f32, minimum: f32, cellSize: f32, queryCell: i32, cell: i32) -> f32 {","  if (cell < queryCell) {","    return position - (minimum + f32(cell + 1) * cellSize);","  if (cell > queryCell) {","    return (minimum + f32(cell) * cellSize) - position;","  return 0.0;","fn getGridUnitPosition(lattice: Lattice, x: f32, y: f32) -> vec2f {","  let width = max(lattice.maximumX, lattice.minimumX + lattice.cellWidth * f32(COLUMNS)) - lattice.minimumX;","  let height = max(lattice.maximumY, lattice.minimumY + lattice.cellHeight * f32(ROWS)) - lattice.minimumY;","  return vec2f((x - lattice.minimumX) / width, (y - lattice.minimumY) / height);","  _ = &gridPositions;","  let lattice = readLattice();","  let x = positions[positionsOffset + index * 2u];","  let y = positions[positionsOffset + index * 2u + 1u];","  let included = true && isPointValid(lattice, x, y);","  let invalid = bitcast<f32>(0x7fc00000u | (index & 0u));","  let unit = getGridUnitPosition(lattice, x, y);","  gridPositions[gridPositionsOffset + index * 2u] = select(invalid, unit.x, included);","  gridPositions[gridPositionsOffset + index * 2u + 1u] = select(invalid, unit.y, included);","const countsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> counts: array<u32>;","  _ = &counts;","  let included = true;","  counts[countsOffset + index] = select(0u, 1u, included && isPointValid(lattice, x, y));","const sortedRowsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> sortedRows: array<u32>;","const gridCountOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> gridCount: array<u32>;","const sortedTargetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> sortedTargets: array<u32>;","  _ = &sortedRows;","  _ = &gridCount;","  _ = &sortedTargets;","  if (index >= gridCount[gridCountOffset]) {","  let row = sortedRows[sortedRowsOffset + index];","  sortedTargets[sortedTargetsOffset + index * 3u] = bitcast<u32>(positions[positionsOffset + row * 2u]);","  sortedTargets[sortedTargetsOffset + index * 3u + 1u] = bitcast<u32>(positions[positionsOffset + row * 2u + 1u]);","  sortedTargets[sortedTargetsOffset + index * 3u + 2u] = row;","@group(0) @binding(0) var<storage, read> sortedTargets: array<u32>;","const cellOffsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> cellOffsets: array<u32>;","@group(0) @binding(3) var<storage, read> gridCount: array<u32>;","@group(0) @binding(4) var<storage, read_write> counts: array<u32>;","const knnIdsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> knnIds: array<u32>;","const knnDistancesOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> knnDistances: array<f32>;","const K: u32 = 1u;","fn isNeighborBefore(leftDistance: f32, leftId: u32, rightDistance: f32, rightId: u32) -> bool {","  return leftDistance < rightDistance || (leftDistance == rightDistance && leftId < rightId);","fn insertNeighbor(","  bestDistances: ptr<function, array<f32, 1>>,","  bestIds: ptr<function, array<u32, 1>>,","  found: ptr<function, u32>,","  distanceSquared: f32,","  neighbor: u32","  if (*found == K &&","      !isNeighborBefore(distanceSquared, neighbor, (*bestDistances)[K - 1u], (*bestIds)[K - 1u])) {","  var slot = min(*found, K - 1u);","  loop {","    if (slot == 0u) {","      break;","    let previous = slot - 1u;","    if (isNeighborBefore((*bestDistances)[previous], (*bestIds)[previous], distanceSquared, neighbor)) {","    (*bestDistances)[slot] = (*bestDistances)[previous];","    (*bestIds)[slot] = (*bestIds)[previous];","    slot = previous;","  (*bestDistances)[slot] = distanceSquared;","  (*bestIds)[slot] = neighbor;","  *found = min(*found + 1u, K);","  _ = &cellOffsets;","  _ = &knnIds;","  _ = &knnDistances;","  let queryIndex = sortedTargets[sortedTargetsOffset + index * TARGET_WORDS + 2u];","  let x = bitcast<f32>(sortedTargets[sortedTargetsOffset + index * TARGET_WORDS]);","  let y = bitcast<f32>(sortedTargets[sortedTargetsOffset + index * TARGET_WORDS + 1u]);","  var found = 0u;","  var bestDistances: array<f32, 1>;","  var bestIds: array<u32, 1>;","  if (counts[countsOffset + queryIndex] != 0u) {","    let lattice = readLattice();","    ","  let queryColumn = i32(getCellColumn(lattice, x));","  let queryRow = i32(getCellRow(lattice, y));","  let lastColumn = i32(lattice.columns) - 1;","  let lastRow = i32(lattice.rows) - 1;","  let maximumRing = max(lattice.columns, lattice.rows);","  let slack = (lattice.cellWidth + lattice.cellHeight) * 0.0009765625 +","    (abs(lattice.minimumX) + abs(lattice.maximumX) + abs(lattice.minimumY) + abs(lattice.maximumY)) * 0.00000095367431640625;","  for (var ringIndex = 0u; ringIndex < maximumRing; ringIndex++) {","    let ring = i32(ringIndex);","    let firstColumn = max(queryColumn - ring, 0);","    let endColumn = min(queryColumn + ring, lastColumn);","    let firstRow = max(queryRow - ring, 0);","    let endRow = min(queryRow + ring, lastRow);","    for (var cellRow = firstRow; cellRow <= endRow; cellRow++) {","      let rowBase = u32(cellRow) * COLUMNS;","      // Cell-level pruning once K candidates are held: a cell whose near edges are farther than","      // the k-th best cannot contribute (strict test, so k-th distance ties are still visited).","      let rowGap = max(getAxisGap(y, lattice.minimumY, lattice.cellHeight, queryRow, cellRow) - slack, 0.0);","      let rowGapSquared = rowGap * rowGap;","      if (found == K && bestDistances[K - 1u] < rowGapSquared) {","        continue;","      }","      if (abs(cellRow - queryRow) == ring) {","        // A full row of the ring: only the columns within reach of the k-th best are visited.","        var rangeFirst = firstColumn;","        var rangeEnd = endColumn;","        // Not narrowed while the k-th squared distance has overflowed to infinity (queries beyond","        // about 1e19): the reach would be inf - inf = NaN and skip tied lower IDs in other columns.","        if (found == K && bestDistances[K - 1u] < 3.0e38) {","          let reach = sqrt(max(bestDistances[K - 1u] - rowGapSquared, 0.0)) + slack;","          let lowColumn = floor((x - reach - lattice.minimumX) / lattice.cellWidth);","          let highColumn = floor((x + reach - lattice.minimumX) / lattice.cellWidth);","          rangeFirst = max(firstColumn, i32(clamp(lowColumn, -1.0, f32(lastColumn))));","          rangeEnd = min(endColumn, i32(clamp(highColumn, -1.0, f32(lastColumn))));","        }","        if (rangeFirst <= rangeEnd) {","          let cellBegin = cellOffsets[cellOffsetsOffset + rowBase + u32(rangeFirst)];","          let cellEnd = cellOffsets[cellOffsetsOffset + rowBase + u32(rangeEnd) + 1u];","          for (var cellSlot = cellBegin; cellSlot < cellEnd; cellSlot++) {","          let neighbor = sortedTargets[sortedTargetsOffset + cellSlot * TARGET_WORDS + 2u];","          if (neighbor != queryIndex) {","            let deltaX = bitcast<f32>(sortedTargets[sortedTargetsOffset + cellSlot * TARGET_WORDS]) - x;","            let deltaY = bitcast<f32>(sortedTargets[sortedTargetsOffset + cellSlot * TARGET_WORDS + 1u]) - y;","            let distanceSquared = deltaX * deltaX + deltaY * deltaY;","            if ((!lattice.bounded || distanceSquared <= lattice.radiusSquared)) {","              insertNeighbor(&bestDistances, &bestIds, &found, distanceSquared, neighbor);","            }","          }","      } else {","        if (queryColumn - ring >= 0) {","          let columnGap = max(getAxisGap(x, lattice.minimumX, lattice.cellWidth, queryColumn, queryColumn - ring) - slack, 0.0);","          if (!(found == K && bestDistances[K - 1u] < columnGap * columnGap + rowGapSquared)) {","            let cell = rowBase + u32(queryColumn - ring);","            let cellBegin = cellOffsets[cellOffsetsOffset + cell];","            let cellEnd = cellOffsets[cellOffsetsOffset + cell + 1u];","            for (var cellSlot = cellBegin; cellSlot < cellEnd; cellSlot++) {","        if (queryColumn + ring <= lastColumn) {","          let columnGap = max(getAxisGap(x, lattice.minimumX, lattice.cellWidth, queryColumn, queryColumn + ring) - slack, 0.0);","            let cell = rowBase + u32(queryColumn + ring);","    // Clearance of the visited box on each side; a side at the lattice edge has nothing beyond it.","    var clearance = 3.0e38;","    var open = false;","    if (queryColumn - ring > 0) {","      clearance = min(clearance, x - (lattice.minimumX + f32(queryColumn - ring) * lattice.cellWidth));","      open = true;","    if (queryColumn + ring < lastColumn) {","      clearance = min(clearance, lattice.minimumX + f32(queryColumn + ring + 1) * lattice.cellWidth - x);","    if (queryRow - ring > 0) {","      clearance = min(clearance, y - (lattice.minimumY + f32(queryRow - ring) * lattice.cellHeight));","    if (queryRow + ring < lastRow) {","      clearance = min(clearance, lattice.minimumY + f32(queryRow + ring + 1) * lattice.cellHeight - y);","    if (!open) {","    let safeClearance = max(clearance - slack, 0.0);","    let safeSquared = safeClearance * safeClearance;","    if (found == K && bestDistances[K - 1u] < safeSquared) {","    if (lattice.bounded && lattice.radiusSquared < safeSquared) {","  // Re-sort the selected neighbors by ID (insertion sort over at most K entries).","  for (var slot = 1u; slot < found; slot++) {","    let neighborId = bestIds[slot];","    let distanceSquared = bestDistances[slot];","    var destination = slot;","    while (destination > 0u && bestIds[destination - 1u] > neighborId) {","      bestIds[destination] = bestIds[destination - 1u];","      bestDistances[destination] = bestDistances[destination - 1u];","      destination--;","    bestIds[destination] = neighborId;","    bestDistances[destination] = distanceSquared;","  for (var slot = 0u; slot < found; slot++) {","    knnIds[knnIdsOffset + queryIndex * K + slot] = bestIds[slot];","    knnDistances[knnDistancesOffset + queryIndex * K + slot] = sqrt(bestDistances[slot]);","  counts[countsOffset + queryIndex] = found;","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const startsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> starts: array<u32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> offsets: array<u32>;","const overflowOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> overflow: array<u32>;","const QUERY_ROWS: u32 = 4u;","const CAPACITY: u32 = 4u;","  _ = &starts;","  _ = &offsets;","  _ = &overflow;","  if (index < QUERY_ROWS) {","    offsets[offsetsOffset + index] = min(starts[startsOffset + index], CAPACITY);","  } else {","    let total = starts[startsOffset + QUERY_ROWS - 1u] + counts[countsOffset + QUERY_ROWS - 1u];","    offsets[offsetsOffset + QUERY_ROWS] = min(total, CAPACITY);","    overflow[overflowOffset] = select(0u, 1u, total > CAPACITY);","@group(0) @binding(0) var<storage, read> knnIds: array<u32>;","@group(0) @binding(1) var<storage, read> knnDistances: array<f32>;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> neighbors: array<u32>;","const distancesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> distances: array<f32>;","  _ = &neighbors;","  _ = &distances;","  let begin = offsets[offsetsOffset + index];","  let end = offsets[offsetsOffset + index + 1u];","  for (var slot = begin; slot < end; slot++) {","    let source = index * K + slot - begin;","    neighbors[neighborsOffset + slot] = knnIds[knnIdsOffset + source];","    distances[distancesOffset + slot] = knnDistances[knnDistancesOffset + source];","@group(0) @binding(0) var<storage, read> parameters: array<f32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","@group(0) @binding(2) var<storage, read> distances: array<f32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> weights: array<f32>;","fn getNeighborWeight(distance: f32, bandwidth: f32) -> f32 {","  let weightKind = u32(readParameter(5u));","  var weight = 1.0;","  if (weightKind == 1u) {","    weight = pow(max(distance, readParameter(7u)), -readParameter(6u));","  } else if (weightKind == 2u) {","    let z = select(0.0, distance / bandwidth, bandwidth > 0.0);","    // 1 - z from the difference of the distances: for the adaptive k-th neighbor the bandwidth is","    // d_k * 1.0000001, and 1 - d / bandwidth rounds to 0 in f32 for some rows, which would drop the","    // slot (zero weights are not neighbors). The difference stays positive and accurate.","    let oneMinusZ = select(1.0, (bandwidth - distance) / bandwidth, bandwidth > 0.0);","    let kernel = u32(readParameter(8u));","    if (kernel == 0u) {","      weight = exp(-0.5 * z * z) * 0.3989422804014327;","    } else if (kernel == 1u) {","      weight = max(oneMinusZ, 0.0);","    } else if (kernel == 2u) {","      weight = 0.75 * max(oneMinusZ * (1.0 + z), 0.0);","    } else if (kernel == 3u) {","      let base = max(oneMinusZ * (1.0 + z), 0.0);","      weight = 0.9375 * base * base;","    } else {","      weight = 0.5;","  return select(0.0, weight, isFiniteFloat(weight) && weight >= 0.0);","  _ = &weights;","  var bandwidth = 0.0;","    bandwidth = max(bandwidth, distances[distancesOffset + slot]);","  bandwidth = bandwidth * 1.0000001192092896;","  var sum = 0.0;","    let weight = getNeighborWeight(distances[distancesOffset + slot], bandwidth);","    weights[weightsOffset + slot] = weight;","    sum += weight;","  if (readParameter(9u) != 0.0 && sum > 0.0 && isFiniteFloat(sum)) {","    for (var slot = begin; slot < end; slot++) {","      weights[weightsOffset + slot] = weights[weightsOffset + slot] / sum;","const neighborOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> neighborOffsets: array<u32>;","const neighborDistancesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> neighborDistances: array<f32>;","const coreOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> core: array<f32>;","  _ = &neighborOffsets;","  _ = &neighborDistances;","  _ = &core;","  var coreDistance = bitcast<f32>(0x7f800000u | (index & 0u));","  if (validPoint(index)) {","    let begin = neighborOffsets[neighborOffsetsOffset + index];","    let end = neighborOffsets[neighborOffsetsOffset + index + 1u];","    if (end - begin + 1u >= 2u) {","      coreDistance = 0.0;","      for (var slot = begin; slot < end; slot++) {","        coreDistance = max(coreDistance, neighborDistances[neighborDistancesOffset + slot]);","  core[coreOffset + index] = coreDistance;","@group(0) @binding(1) var<storage, read> core: array<f32>;","@group(0) @binding(2) var<storage, read_write> ordering: array<u32>;","@group(0) @binding(3) var<storage, read_write> reachability: array<f32>;","@group(0) @binding(4) var<storage, read_write> predecessors: array<u32>;","@group(0) @binding(5) var<storage, read_write> processed: array<u32>;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","var<workgroup> candidateRows: array<u32, 256>;","var<workgroup> candidateDistances: array<f32, 256>;","var<workgroup> visited: u32;","  if (index == 0u) { visited = status[statusOffset]; }","  for (var iteration = 0u; iteration < 4u; iteration++) {","    var selected = 0xffffffffu; var best = infinity;","    for (var row = index; row < ROWS; row += 256u) {","      let candidate = reachability[reachabilityOffset + row];","      if (processed[processedOffset + row] == 0u && (candidate < best || (candidate == best && row < selected))) {","        selected = row; best = candidate;","    candidateRows[index] = selected; candidateDistances[index] = best;","    for (var stride = 128u; stride > 0u; stride /= 2u) {","      if (index < stride) {","        let otherDistance = candidateDistances[index + stride]; let otherRow = candidateRows[index + stride];","        if (otherDistance < candidateDistances[index] || (otherDistance == candidateDistances[index] && otherRow < candidateRows[index])) {","          candidateDistances[index] = otherDistance; candidateRows[index] = otherRow;","      workgroupBarrier();","    let focus = workgroupUniformLoad(&candidateRows[0]);","    if (focus == 0xffffffffu) { break; }","    if (index == 0u) { ordering[orderingOffset + visited] = focus; visited++; processed[processedOffset + focus] = 1u; }","    storageBarrier(); workgroupBarrier();","    let coreDistance = core[coreOffset + focus];","    if (isFiniteFloat(coreDistance)) {","      for (var row = index; row < ROWS; row += 256u) {","        if (processed[processedOffset + row] != 0u) { continue; }","        let pairDistance = getPointDistance(point(focus), point(row));","        if (pairDistance > MAXIMUM_DISTANCE) { continue; }","        let candidate = max(coreDistance, pairDistance);","        if (candidate < reachability[reachabilityOffset + row]) {","          reachability[reachabilityOffset + row] = candidate; predecessors[predecessorsOffset + row] = focus;","    status[statusOffset] = visited;","    status[statusOffset + 1u] = select(0u, 1u, visited + status[statusOffset + 2u] == ROWS);","@group(0) @binding(0) var<storage, read> core: array<f32>;","@group(0) @binding(1) var<storage, read> ordering: array<u32>;","@group(0) @binding(2) var<storage, read> reachability: array<f32>;","@group(0) @binding(3) var<storage, read> status: array<u32>;","@group(0) @binding(4) var<storage, read_write> starts: array<u32>;","  var startsCluster = false;","  if (status[statusOffset + 1u] != 0u && index < status[statusOffset]) {","    let row = ordering[orderingOffset + index];","    startsCluster = reachability[reachabilityOffset + row] > 1.5f && core[coreOffset + row] <= 1.5f;","  starts[startsOffset + index] = u32(startsCluster);","@group(0) @binding(0) var<storage, read> starts: array<u32>;","@group(0) @binding(1) var<storage, read> counts: array<u32>;","@group(0) @binding(2) var<storage, read> ordering: array<u32>;","@group(0) @binding(3) var<storage, read> reachability: array<f32>;","@group(0) @binding(4) var<storage, read> status: array<u32>;","@group(0) @binding(5) var<storage, read_write> labels: array<u32>;","  if (status[statusOffset + 1u] == 0u || index >= status[statusOffset]) { return; }","  let row = ordering[orderingOffset + index];","  if (starts[startsOffset + index] != 0u || reachability[reachabilityOffset + row] <= 1.5f) {","    labels[labelsOffset + row] = counts[countsOffset + index] - 1u;"],"strings":["read","buffer","read_write","optics-core-neighbors-setup-parameters","compute","positions","ordering","reachability","status","optics-frontier-0","transient","optics-cluster-starts","optics-core-neighbors-knn","gpu-spatial-analysis-optics-snapshot-tap","GPUNeighborSearch","GPUOPTICS","optics-core-neighbors-grid-positions","optics-core-neighbors-sorted-targets","optics-initialize","optics-core-neighbor-offsets","optics-core-neighbors-cell-offsets","optics-core-neighbors-counts","coreDistances","imported","labels","optics-core-neighbors-emit","optics-core-neighbors-grid-index-fi