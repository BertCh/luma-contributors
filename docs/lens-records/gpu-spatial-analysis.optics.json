terNode":"optics-extract","role":"output","keySpace":"entry"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const coreOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> core: array<f32>;","fn isFiniteFloat(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn getPointDistance(first: vec2<f32>, second: vec2<f32>) -> f32 { return distance(first, second); }","const ROWS = 4u;","const MAXIMUM_DISTANCE = 2f;","fn point(row: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","}","fn validPoint(row: u32) -> bool {","  let value = point(row);","  return isFiniteFloat(value.x) && isFiniteFloat(value.y);","var<private> nearestDistances: array<f32, 2>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &core;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let infinity = bitcast<f32>(0x7f800000u | (index & 0u));","  var selectedCount = 0u;","  if (validPoint(index)) {","    for (var row = 0u; row < ROWS; row++) {","      if (!validPoint(row)) { continue; }","      let candidateDistance = getPointDistance(point(index), point(row));","      if (!(candidateDistance <= MAXIMUM_DISTANCE)) { continue; }","      if (selectedCount < 2u) {","        var slot = selectedCount;","        selectedCount++;","        loop {","          if (slot == 0u) { break; }","          let parent = (slot - 1u) / 2u;","          if (nearestDistances[parent] >= candidateDistance) { break; }","          nearestDistances[slot] = nearestDistances[parent];","          slot = parent;","        }","        nearestDistances[slot] = candidateDistance;","      } else if (candidateDistance < nearestDistances[0]) {","        var slot = 0u;","          var child = slot * 2u + 1u;","          if (child >= selectedCount) { break; }","          if (child + 1u < selectedCount && nearestDistances[child + 1u] > nearestDistances[child]) { child++; }","          if (nearestDistances[child] <= candidateDistance) { break; }","          nearestDistances[slot] = nearestDistances[child];","          slot = child;","      }","    }","  // Equal distances count separately, as do their distinct source rows in the rank-order path.","  core[coreOffset + index] = select(infinity, nearestDistances[0], selectedCount == 2u);","const orderingOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> ordering: array<u32>;","const reachabilityOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> reachability: array<f32>;","const predecessorsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> predecessors: array<u32>;","const processedOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> processed: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","const labelsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> labels: array<u32>;","var<workgroup> invalidCounts: array<u32, 256>;","@compute @workgroup_size(256)","  _ = &ordering;","  _ = &reachability;","  _ = &predecessors;","  _ = &processed;","  _ = &status;","  _ = &labels;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  var invalidCount = 0u;","  for (var row = index; row < ROWS; row += 256u) {","    let invalid = !validPoint(row);","    invalidCount += u32(invalid);","    processed[processedOffset + row] = u32(invalid);","    ordering[orderingOffset + row] = 0xffffffffu;","    predecessors[predecessorsOffset + row] = 0xffffffffu;","    reachability[reachabilityOffset + row] = infinity;","    labels[labelsOffset + row] = 0xffffffffu;","  invalidCounts[index] = invalidCount;","  workgroupBarrier();","  for (var stride = 128u; stride > 0u; stride /= 2u) {","    if (index < stride) { invalidCounts[index] += invalidCounts[index + stride]; }","    workgroupBarrier();","  if (index == 0u) {","    status[statusOffset] = 0u;","    status[statusOffset + 1u] = 0u;","    status[statusOffset + 2u] = invalidCounts[0];","@group(0) @binding(1) var<storage, read> core: array<f32>;","@group(0) @binding(2) var<storage, read_write> ordering: array<u32>;","@group(0) @binding(3) var<storage, read_write> reachability: array<f32>;","@group(0) @binding(4) var<storage, read_write> predecessors: array<u32>;","@group(0) @binding(5) var<storage, read_write> processed: array<u32>;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","var<workgroup> candidateRows: array<u32, 256>;","var<workgroup> candidateDistances: array<f32, 256>;","var<workgroup> visited: u32;","  if (index == 0u) { visited = status[statusOffset]; }","  for (var iteration = 0u; iteration < 4u; iteration++) {","    var selected = 0xffffffffu; var best = infinity;","    for (var row = index; row < ROWS; row += 256u) {","      let candidate = reachability[reachabilityOffset + row];","      if (processed[processedOffset + row] == 0u && (candidate < best || (candidate == best && row < selected))) {","        selected = row; best = candidate;","    candidateRows[index] = selected; candidateDistances[index] = best;","    for (var stride = 128u; stride > 0u; stride /= 2u) {","      if (index < stride) {","        let otherDistance = candidateDistances[index + stride]; let otherRow = candidateRows[index + stride];","        if (otherDistance < candidateDistances[index] || (otherDistance == candidateDistances[index] && otherRow < candidateRows[index])) {","          candidateDistances[index] = otherDistance; candidateRows[index] = otherRow;","      workgroupBarrier();","    let focus = workgroupUniformLoad(&candidateRows[0]);","    if (focus == 0xffffffffu) { break; }","    if (index == 0u) { ordering[orderingOffset + visited] = focus; visited++; processed[processedOffset + focus] = 1u; }","    storageBarrier(); workgroupBarrier();","    let coreDistance = core[coreOffset + focus];","    if (isFiniteFloat(coreDistance)) {","      for (var row = index; row < ROWS; row += 256u) {","        if (processed[processedOffset + row] != 0u) { continue; }","        let pairDistance = getPointDistance(point(focus), point(row));","        if (pairDistance > MAXIMUM_DISTANCE) { continue; }","        let candidate = max(coreDistance, pairDistance);","        if (candidate < reachability[reachabilityOffset + row]) {","          reachability[reachabilityOffset + row] = candidate; predecessors[predecessorsOffset + row] = focus;","    status[statusOffset] = visited;","    status[statusOffset + 1u] = select(0u, 1u, visited + status[statusOffset + 2u] == ROWS);","@group(0) @binding(0) var<storage, read> core: array<f32>;","@group(0) @binding(1) var<storage, read> ordering: array<u32>;","@group(0) @binding(2) var<storage, read> reachability: array<f32>;","@group(0) @binding(3) var<storage, read> status: array<u32>;","const startsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> starts: array<u32>;","  _ = &starts;","  var startsCluster = false;","  if (status[statusOffset + 1u] != 0u && index < status[statusOffset]) {","    let row = ordering[orderingOffset + index];","    startsCluster = reachability[reachabilityOffset + row] > 1.5f && core[coreOffset + row] <= 1.5f;","  starts[startsOffset + index] = u32(startsCluster);","enable subgroups;","requires subgroup_id;","override ELEMENT_COUNT: u32;","override BLOCK_COUNT: u32;","override INPUT_OFFSET: u32;","override OUTPUT_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  let index = workgroupIndex * 256u + lane;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    ","    outputValues[OUTPUT_OFFSET + index] = blockPrefix;","@group(0) @binding(0) var<storage, read> starts: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> counts: array<u32>;","@group(0) @binding(2) var<storage, read> ordering: array<u32>;","@group(0) @binding(3) var<storage, read> reachability: array<f32>;","@group(0) @binding(4) var<storage, read> status: array<u32>;","@group(0) @binding(5) var<storage, read_write> labels: array<u32>;","  _ = &counts;","  if (status[statusOffset + 1u] == 0u || index >= status[statusOffset]) { return; }","  let row = ordering[orderingOffset + index];","  if (starts[startsOffset + index] != 0u || reachability[reachabilityOffset + row] <= 1.5f) {","    labels[labelsOffset + row] = counts[countsOffset + index] - 1u;"],"strings":["optics-cluster-starts","ordering","reachability","status","optics-frontier-0","optics-extract","optics-initialize","read","read_write","GPUOPTICS","buffer","coreDistances","labels","positions","predecessors","optics-processed","imported","compute","optics","optics-cluster-counts","optics-core","core","optics-cluster-scan-level-0-scan","transient","GPUScan","level-scan","processed","starts","transient-buffer-0"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","loop","dedupName","formula","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["id","iteration","phase","maximumIterations"],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[["~:3",[1,1,1],4,false],["~:2","~d","~d","~7","f32",0,4],["~:2","~1","~1","~7","u32",0,4],["~:2","~1","~1","~8","u32",0,4],["~:2","~2","~2","~7","f32",0,4],["~:2","~2","~2","~8","f32",0,4],["~:2","~3","~3","~7","u32",0,3],["~:2","~3","~3","~8","u32",0,3],["~:2","~c","~c","~8","u32",0,4],["~:2","~e","~e","~8","u32",0,4],["~:2","~l","~b","~7","f32",0,4],["~:2","~q","~f","~8","u32",0,4],["~:3",[1,1,1],256,false