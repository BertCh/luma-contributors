rn vec4f(x, y, select(0.0, 1.0, isFiniteFloat(x) && isFiniteFloat(y)), 0.0);","}","var<workgroup> sharedMinima: array<vec2f, 256>;","var<workgroup> sharedMaxima: array<vec2f, 256>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &boundsOut;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  // Exactly one workgroup is dispatched, so index == localInvocationIndex.","  var localMinimum = vec2f(FLOAT32_MAXIMUM);","  var localMaximum = vec2f(-FLOAT32_MAXIMUM);","  // Grid-stride loop: consecutive threads read consecutive items on every trip.","  for (var row = index; row < ITEM_COUNT; row += PARTIAL_COUNT * WORKGROUP_THREADS) {","    let item = readItem(row);","    if (item.z > 0.5) {","      localMinimum = min(localMinimum, item.xy);","      localMaximum = max(localMaximum, item.xy);","    }","  }","  sharedMinima[localInvocationIndex] = localMinimum;","  sharedMaxima[localInvocationIndex] = localMaximum;","  workgroupBarrier();","  for (var stride = 128u; stride > 0u; stride = stride >> 1u) {","    if (localInvocationIndex < stride) {","      sharedMinima[localInvocationIndex] = min(sharedMinima[localInvocationIndex], sharedMinima[localInvocationIndex + stride]);","      sharedMaxima[localInvocationIndex] = max(sharedMaxima[localInvocationIndex], sharedMaxima[localInvocationIndex + stride]);","    workgroupBarrier();","  if (localInvocationIndex == 0u) {","    let minimum = sharedMinima[0];","    let maximum = sharedMaxima[0];","    let hasValid = minimum.x <= maximum.x && minimum.y <= maximum.y;","    boundsOut[boundsOutOffset] = select(0.0, minimum.x, hasValid);","    boundsOut[boundsOutOffset + 1u] = select(0.0, minimum.y, hasValid);","    boundsOut[boundsOutOffset + 2u] = select(0.0, maximum.x, hasValid);","    boundsOut[boundsOutOffset + 3u] = select(0.0, maximum.y, hasValid);","const orderingOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> ordering: array<u32>;","const reachabilityOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> reachability: array<f32>;","const predecessorsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> predecessors: array<u32>;","const processedOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> processed: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","const labelsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> labels: array<u32>;","fn getPointDistance(first: vec2<f32>, second: vec2<f32>) -> f32 { return distance(first, second); }","const ROWS = 4u;","const MAXIMUM_DISTANCE = 2f;","fn point(row: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","fn validPoint(row: u32) -> bool {","  let value = point(row);","  return isFiniteFloat(value.x) && isFiniteFloat(value.y);","var<workgroup> invalidCounts: array<u32, 256>;","  _ = &ordering;","  _ = &reachability;","  _ = &predecessors;","  _ = &processed;","  _ = &status;","  _ = &labels;","  let infinity = bitcast<f32>(0x7f800000u | (index & 0u));","  var invalidCount = 0u;","  for (var row = index; row < ROWS; row += 256u) {","    let invalid = !validPoint(row);","    invalidCount += u32(invalid);","    processed[processedOffset + row] = u32(invalid);","    ordering[orderingOffset + row] = 0xffffffffu;","    predecessors[predecessorsOffset + row] = 0xffffffffu;","    reachability[reachabilityOffset + row] = infinity;","    labels[labelsOffset + row] = 0xffffffffu;","  invalidCounts[index] = invalidCount;","  for (var stride = 128u; stride > 0u; stride /= 2u) {","  