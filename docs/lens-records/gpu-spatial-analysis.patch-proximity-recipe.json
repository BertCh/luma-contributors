00000u)==0x7f800000u){return scale;}","  let normalized=vec2<f32>(getScaledQuotient(displacement.x,scale,1.0,0),getScaledQuotient(displacement.y,scale,1.0,0));","  return scale*length(normalized);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &patches;","  _ = &output;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let owner=patches[patchesOffset+index];let position=vec2<f32>(f32(index%5u)+0.5,f32(index/5u)+0.5)*vec2<f32>(1.0,1.0);","var distance=min(min(position.x,5.0-position.x),min(position.y,1.0-position.y));","let column=i32(index%5u);let row=i32(index/5u);","for(var offsetRow=-1;offsetRow<=1;offsetRow++){","for(var offsetColumn=-1;offsetColumn<=1;offsetColumn++){"," let otherColumn=column+offsetColumn;let otherRow=row+offsetRow;if(otherColumn<0||otherColumn>=5||otherRow<0||otherRow>=1){continue;}let cell=u32(otherRow)*5u+u32(otherColumn);"," if(patches[patchesOffset+cell]==owner){continue;}"," let other=vec2<f32>(f32(cell%5u)+0.5,f32(cell/5u)+0.5)*vec2<f32>(1.0,1.0);"," distance=min(distance,getPatchProximityDistance(max(abs(position-other) - 0.5*vec2<f32>(1.0,1.0),vec2<f32>(0.0))));","output[outputOffset+index]=u32(owner<2u&&distance>0.4000000059604645);","@group(0) @binding(1) var<storage, read_write> output: array<f32>;","  let owner=index/5u;let cell=index%5u;let row=cell/5u;let column=cell%5u;var best=bitcast<f32>(0x7f800000u | (index & 0u));","for(var candidate=0u;candidate<5u;candidate++){if(patches[patchesOffset+row*5u+candidate]==owner){best=min(best,max(abs(f32(column)-f32(candidate))-1.0,0.0)*1.0);}}output[outputOffset+index]=best;","const horizontalOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> horizontal: array<f32>;","  _ = &horizontal;","for(var candidate=0u;candidate<1u;candidate++){let horizontalDistance=horizontal[horizontalOffset+owner*5u+candidate*5u+column];let verticalDistance=max(abs(f32(row)-f32(candidate))-1.0,0.0)*1.0;best=min(best,getPatchProximityDistance(vec2<f32>(horizontalDistance,verticalDistance)));}output[outputOffset+index]=best;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<u32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<u32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index];","const fieldsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> fields: array<f32>;","@group(0) @binding(2) var<storage, read_write> output: array<f32>;","  _ = &fields;","  let source=index/2u;let targetPatch=index%2u;var distance=bitcast<f32>(0x7f800000u | (index & 0u));","if(source!=targetPatch){for(var cell=0u;cell<5u;cell++){if(patches[patchesOffset+cell]==targetPatch){distance=min(distance,fields[fieldsOffset+source*5u+cell]);}}}","output[outputOffset+index]=distance;","const classesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> classes: array<u32>;","const coreOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> core: array<u32>;","const distancesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> distances: array<f32>;","@group(0) @binding(4) var<storage, read_write> output: array<f32>;","fn readOutput(row:u32)->vec4<f32>{return vec4<f32>(output[outputOffset+row*4u+0u],output[outputOffset+row*4u+1u],output[outputOffset+row*4u+2u],output[outputOffset+row*4u+3u]);}","fn writeOutput(row:u32,value:vec4<f32>){output[outputOffset+row*4u+0u]=value[0u];output[outputOffset+row*4u+1u]=value[1u];output[outputOffset+row*4u+2u]=value[2u];output[outputOffset+row*4u+3u]=value[3u];}","  _ = &classes;","  _ = &core;","  _ = &distances;","  var coreArea=0.0;var area=0.0;var nearest=bitcast<f32>(0x7f800000u | (index & 0u));var proximity=0.0;","for(var cell=0u;cell<5u;cell++){if(patches[patchesOffset+cell]==index){area+=1.0;coreArea+=f32(core[coreOffset+cell])*1.0;}}","for(var other=0u;other<2u;other++){"," if(other==index||classes[classesOffset+other]!=classes[classesOffset+index]){continue;}"," let distance=distances[distancesOffset+index*2u+other];nearest=min(nearest,distance);"," if(distance<=2.0){","  var otherArea=0.0;for(var cell=0u;cell<5u;cell++){otherArea+=f32(patches[patchesOffset+cell]==other)*1.0;}","  if(distance==0.0){proximity+=otherArea/(distance*distance);}else{proximity+=getScaledQuotient(otherArea,distance,distance,0);}"," }","writeOutput(index,vec4<f32>(area,coreArea,nearest,proximity));","@group(0) @binding(0) var<storage, read> source: array<f32>;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;"],"strings":["read","buffer","gpu-spatial-analysis-patch-proximity-recipe-snapshot-tap","logical","patch-proximity","patch-proximity-core","patch-proximity-distances","urban-ecology-patches-0","compute","patch-proximity-patch-summary","read_write","patch-proximity-boundary-distances","patch-proximity-distance-fields","patch-proximity-horizontal-distances","patch-proximity-metrics","lens-output-copy","patch-proximity-core-distance","patch-proximity-vertical-transform","urban-ecology-capture-2","urban-ecology-capture-4","urban-ecology-capture-6","urban-ecology-copy-5","urban-ecology-copy-7","imported","output","transient","urban-ecology-copy-3","patch-proximity-horizontal-transform","patches","urban-ecology-patch-classes-1","destination","source","wgsl:723c4097"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNE