e","role":"output","keySpace":"entry"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const observedOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> observed: array<f32>;","const simulationsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> simulations: array<f32>;","const referenceOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> reference: array<f32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> weights: array<f32>;","const deviationsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> deviations: array<f32>;","fn isFiniteFloat(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &observed;","  _ = &simulations;","  _ = &reference;","  _ = &weights;","  _ = &deviations;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var statistic = 0.0;","  var valid = true;","  for (var radius = 0u; radius < 2u; radius++) {","    var value = observed[observedOffset + radius];","    if (index < 3u) { value = simulations[simulationsOffset + index * 2u + radius]; }","    let center = reference[referenceOffset + radius];","    let weight = weights[weightsOffset + radius];","    valid = valid && isFiniteFloat(value) && isFiniteFloat(center) && isFiniteFloat(weight) && weight > 0.0;","    let deviation = abs(value - center);","    statistic += weight * deviation * deviation;","  deviations[deviationsOffset + index] = select(bitcast<f32>(0x7fc00000u | (index & 0u)), statistic, valid && isFiniteFloat(statistic));","}","@group(0) @binding(0) var<storage, read> deviations: array<f32>;","const statisticsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> statistics: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> status: array<u32>;","  _ = &statistics;","  _ = &status;","  let observed = deviations[deviationsOffset + 3u];","  var valid = isFiniteFloat(observed);","  var exceedances = 0u;","  for (var replicate = 0u; replicate < 3u; replicate++) {","    let value = deviations[deviationsOffset + replicate];","    valid = valid && isFiniteFloat(value);","    exceedances += select(0u, 1u, value >= observed);","  let invalid = bitcast<f32>(0x7fc00000u | (index & 0u));","  statistics[statisticsOffset] = select(invalid, observed, valid);","  statistics[statisticsOffset + 1u] = select(invalid, f32(exceedances + 1u) / 4.0, valid);","  statistics[statisticsOffset + 2u] = 1.0 / 4.0;","  statistics[statisticsOffset + 3u] = 3.0;","  status[statusOffset] = select(1u, 0u, valid);","@group(0) @binding(0) var<storage, read> simulations: array<f32>;","@group(0) @binding(1) var<storage, read> status: array<u32>;","const lowerOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> lower: array<f32>;","const upperOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> upper: array<f32>;","fn getOrderedFloatKey(value: f32) -> u32 {","  let bits = bitcast<u32>(value);","  return select(bits | 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","fn selectOrderedValue(column: u32, order: u32) -> f32 {","  var answer = 0u;","  for (var bit = 32u; bit > 0u; bit--) {","    let trial = answer | (1u << (bit - 1u));","    var below = 0u;","    for (var other = 0u; other < 3u; other++) {","      below += select(0u, 1u, getOrderedFloatKey(simulations[simulationsOffset + other * 2u + column]) < trial);","    }","    if (below <= order) { answer = trial; }","  return bitcast<f32>(select(~answer, answer ^ 0x80000000u, (answer & 0x80000000u) != 0u));","  _ = &lower;","  _ = &upper;","  var lowerValue = bitcast<f32>(0x7fc00000u | (index & 0u));","  var upperValue = lowerValue;","  if (status[statusOffset] == 0u) {","    lowerValue = selectOrderedValue(index, 0u);","    upperValue = selectOrderedValue(index, 2u);","  lower[lowerOffset + index] = lowerValue;","  upper[upperOffset + index] = upperValue;"],"strings":["point-pattern-envelope-deviations","buffer","point-pattern-envelope-pointwise","status","imported","point-pattern-envelope-test","read","simulations","GPUPointPatternEnvelope","lower","read_write","statistics","upper","observed","reference","compute","integrationWeights","point-pattern-envelope","deviations"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[["~:2","~7","~7","~6","f32",0,6]]}}
