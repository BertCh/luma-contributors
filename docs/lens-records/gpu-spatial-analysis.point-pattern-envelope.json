ol { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn getAdditionRoundingError(first: f32, second: f32, sum: f32) -> f32 {","  let firstBits = bitcast<u32>(first);","  let secondBits = bitcast<u32>(second);","  let sumBits = bitcast<u32>(sum);","  let firstMagnitude = firstBits & 0x7fffffffu;","  let secondMagnitude = secondBits & 0x7fffffffu;","  let sumMagnitude = sumBits & 0x7fffffffu;","  // A zero operand makes the addition exact; an infinity or a NaN has no rounding error to report.","  if (firstMagnitude == 0u || secondMagnitude == 0u ||","      max(max(firstMagnitude, secondMagnitude), sumMagnitude) >= 0x7f800000u) {","    return 0.0;","  }","  let firstIsLarger = firstMagnitude >= secondMagnitude;","  let largerBits = select(secondBits, firstBits, firstIsLarger);","  let smallerBits = select(firstBits, secondBits, firstIsLarger);","  let largerMagnitude = largerBits & 0x7fffffffu;","  let smallerMagnitude = smallerBits & 0x7fffffffu;","  // Biased exponents (1 for subnormals) and 24-bit significands: |value| = significand * 2^(exponent - 150).","  let largerExponent = max(largerMagnitude >> 23u, 1u);","  let smallerExponent = max(smallerMagnitude >> 23u, 1u);","  let sumExponent = max(sumMagnitude >> 23u, 1u);","  // Below 2^-103 the error would be subnormal, where ldexp is not dependable: report none.","  if (smallerExponent < 24u) {","  let gap = largerExponent - smallerExponent;","  if (gap > 25u) {","    // The smaller operand is below a quarter of the larger one's last place: the sum is the larger","    // operand and the whole smaller operand is the error.","    if (sumBits == largerBits) {","      return bitcast<f32>(smallerBits);","    }","  // The sum's last place, as a left shift from the smaller operand's last place. A rounded sum has","  // the larger operand's exponent, the next one (a carry) or the one below (a borrow). Anything","  // lower is a cancellation, which is exact, and so is a sum whose last place is finer than the","  // smaller operand's.","  if (sumMagnitude == 0u || sumExponent + 1u < largerExponent || sumExponent > largerExponent + 1u ||","      sumExponent < smallerExponent) {","  let sumShift = sumExponent - smallerExponent;","  let largerSignificand = (largerMagnitude & 0x7fffffu) | select(0u, 0x800000u, largerMagnitude >= 0x800000u);","  let smallerSignificand = (smallerMagnitude & 0x7fffffu) | select(0u, 0x800000u, smallerMagnitude >= 0x800000u);","  let sumSignificand = (sumMagnitude & 0x7fffffu) | select(0u, 0x800000u, sumMagnitude >= 0x800000u);","  // Signed integers in units of the smaller operand's last place, modulo 2^32. Each term can pass","  // 2^32, but their combination is at most 2^25 in magnitude, so the wrapped result is exact.","  let largerUnits = largerSignificand << gap;","  let sumUnits = sumSignificand << sumShift;","  let signedLarger = select(largerUnits, 0u - largerUnits, (largerBits & 0x80000000u) != 0u);","  let signedSmaller = select(smallerSignificand, 0u - smallerSignificand, (smallerBits & 0x80000000u) != 0u);","  let signedSum = select(sumUnits, 0u - sumUnits, (sumBits & 0x80000000u) != 0u);","  let errorUnits = bitcast<i32>(signedLarger + signedSmaller - signedSum);","  // The rounding error of an addition is an f32, so the conversion and the scaling are exact.","  return ldexp(f32(errorUnits), i32(smallerExponent) - 150);","}","fn addCompensatedValue(accumulator: vec2<f32>, value: f32) -> vec2<f32> {","  let previous = accumulator.x;","  let total = previous + value;","  let correction = accumulator.y + getAdditionRoundingError(previous, value, total);","  return vec2<f32>(total, correction);","fn addCompensated(accumulator: ptr<function, vec2<f32>>, value: f32) {","  *accumulator = addCompensatedValue(*accumulator, value);","fn getCompensated(accumulator: vec2<f32>) -> f32 {","  return accumulator.x + accumulator.y;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &observed;","  _ = &simulations;","  _ = &reference;","  _ = &weights;","  _ = &residuals;","  _ = &deviations;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var statistic = 0.0;","  var accumulator = vec2f(0.0);","  var valid = true;","  for (var radius = 0u; radius < 2u; radius++) {","    var value = observed[observedOffset + radius];","    if (index < 3u) { value = simulations[simulationsOffset + index * 2u + radius]; }","    let center = reference[referenceOffset + radius];","    valid = valid && isFiniteFloat(value) && isFiniteFloat(center);","    let weight = weights[weightsOffset + radius];","    valid = valid && (bitcast<u32>(weight) > 0u && bitcast<u32>(weight) < 0x7f800000u);","    let deviation = abs(value - center);","    accumulator = addCompensatedValue(accumulator, weight * deviation * deviation); statistic = accumulator.x;","  residuals[residualsOffset + index] = accumulator.y;","  deviations[deviationsOffset + index] = select(bitcast<f32>(0x7fc00000u | (index & 0u)), statistic, valid && isFiniteFloat(statistic));","@group(0) @binding(4) var<storage, read> deviations: array<f32>;","const flagsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> flags: array<f32>;","const CURVE_ROWS: u32 = 2u;","const SIMULATION_COUNT: u32 = 3u;","fn addEnvelopeProduct(accumulator: ptr<function, array<u32, 28>>, firstBits: u32, secondBits: u32, weightBits: u32, negative: bool, extraExponent: i32) {","  let magnitudes = vec3u(firstBits, secondBits, weightBits) & vec3u(0x7fffffffu);","  if (any(magnitudes == vec3u(0u)) || any(magnitudes >= vec3u(0x7f800000u))) { return; }","  let biased = magnitudes >> vec3u(23u);","  let significands = (magnitudes & vec3u(0x7fffffu)) | select(vec3u(0u), vec3u(0x800000u), biased != vec3u(0u));","  let exponents = select(vec3i(-149), vec3i(biased) - vec3i(150), biased != vec3u(0u));","  // Base-256 convolution: at most seven products of three bytes occupy a digit,","  // so each unnormalized digit is below 7*255^3 < 2^27, safely within u32.","  var digits = array<u32, 9>();","  for (var first = 0u; first < 3u; first++) {","    for (var second = 0u; second < 3u; second++) {","      for (var third = 0u; third < 3u; third++) {","        digits[first + second + third] += ((significands.x >> (8u * first)) & 255u) * ((significands.y >> (8u * second)) & 255u) * ((significands.z >> (8u * third)) & 255u);","      }","  for (var digit = 0u; digit < 8u; digit++) { digits[digit + 1u] += digits[digit] >> 8u; digits[digit] &= 255u; }","  let product = array<u32, 3>(digits[0] | (digits[1] << 8u) | (digits[2] << 16u) | (digits[3] << 24u), digits[4] | (digits[5] << 8u) | (digits[6] << 16u) | (digits[7] << 24u), digits[8]);","  let shift = u32(exponents.x + exponents.y + exponents.z + extraExponent + 447);","  let firstWord = shift / 32u;","  let bit = shift % 32u;","  var carry = 0u;","  for (var word = firstWord; word < 28u; word++) {","    let part = word - firstWord;","    var term = 0u;","    if (part < 3u) { term = product[part] << bit; }","    if (bit > 0u && part > 0u && part <= 3u) { term |= product[part - 1u] >> (32u - bit); }","    let previous = (*accumulator)[word];","    if (negative) {","      let partial = previous - term;","      (*accumulator)[word] = partial - carry;","      carry = select(0u, 1u, previous < term || partial < carry);","    } else {","      let partial = previous + term;","      let next = partial + carry;","      (*accumulator)[word] = next;","      carry = select(0u, 1u, partial < previous || next < partial);","    if (part >= 3u && carry == 0u) { break; }","fn getEnvelopeExactStatistic(curve: u32) -> array<u32, 28> {","  var accumulator = array<u32, 28>();","  for (var row = 0u; row < CURVE_ROWS; row++) {","    var value = observed[observedOffset + row];","    if (curve < SIMULATION_COUNT) { value = simulations[simulationsOffset + curve * CURVE_ROWS + row]; }","    let valueBits = bitcast<u32>(value);","    let centerBits = bitcast<u32>(reference[referenceOffset + row]);","    let weightBits = bitcast<u32>(weights[weightsOffset + row]);","    addEnvelopeProduct(&accumulator, valueBits, valueBits, weightBits, false, 0);","    addEnvelopeProduct(&accumulator, centerBits, centerBits, weightBits, false, 0);","    addEnvelopeProduct(&accumulator, valueBits, centerBits, weightBits, ((valueBits ^ centerBits) >> 31u) == 0u, 1);","  return accumulator;","fn envelopeExactAtLeast(first: array<u32, 28>, second: array<u32, 28>) -> bool {","  for (var remaining = 28u; remaining > 0u; remaining--) {","    let word = remaining - 1u;","    if (first[word] != second[word]) { return first[word] > second[word]; }","  return true;","  _ = &flags;","  let observed = deviations[deviationsOffset + 3u];","  let value = deviations[deviationsOffset + index];","  let exceeds = envelopeExactAtLeast(getEnvelopeExactStatistic(index), getEnvelopeExactStatistic(SIMULATION_COUNT));","  flags[flagsOffset + index] = select(bitcast<f32>(0x7fc00000u | (index & 0u)), select(0.0, 1.0, exceeds), isFiniteFloat(value) && isFiniteFloat(observed));","@group(0) @binding(0) var<storage, read> deviations: array<f32>;","const statisticsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> statistics: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> status: array<u32>;","  _ = &statistics;","  _ = &status;","  var valid = isFiniteFloat(observed);","  var exceedances = 0u;","  for (var replicate = 0u; replicate < 3u; replicate++) {","    let value = deviations[deviationsOffset + replicate];","    valid = valid && isFiniteFloat(value);","    exceedances += select(0u, 1u, value >= observed);","  let invalid = bitcast<f32>(0x7fc00000u | (index & 0u));","  statistics[statisticsOffset] = select(invalid, observed, valid);","  statistics[statisticsOffset + 1u] = select(invalid, f32(exceedances + 1u) / 4.0, valid);","  statistics[statisticsOffset + 2u] = 1.0 / 4.0;","  statistics[statisticsOffset + 3u] = 3.0;","  status[statusOffset] = select(1u, 0u, valid);","@group(0) @binding(1) var<storage, read> residuals: array<f32>;","@group(0) @binding(2) var<storage, read> status: array<u32>;","@group(0) @binding(3) var<storage, read_write> statistics: array<f32>;","  if (status[statusOffset] == 0u) { statistics[statisticsOffset] = deviations[deviationsOffset + 3u] + residuals[residualsOffset + 3u]; }","@group(0) @binding(0) var<storage, read> simulations: array<f32>;","@group(0) @binding(1) var<storage, read> status: array<u32>;","const lowerOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> lower: array<f32>;","const upperOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> upper: array<f32>;","fn getOrderedFloatKey(value: f32) -> u32 {","  let bits = bitcast<u32>(value);","  return select(bits | 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","fn selectOrderedValue(column: u32, order: u32) -> f32 {","  var answer = 0u;","  for (var bit = 32u; bit > 0u; bit--) {","    let trial = answer | (1u << (bit - 1u));","    var below = 0u;","    for (var other = 0u; other < 3u; other++) {","      below += select(0u, 1u, getOrderedFloatKey(simulations[simulationsOffset + other * 2u + column]) < trial);","    if (below <= order) { answer = trial; }","  return bitcast<f32>(select(~answer, answer ^ 0x80000000u, (answer & 0x80000000u) != 0u));","  _ = &lower;","  _ = &upper;","  var lowerValue = bitcast<f32>(0x7fc00000u | (index & 0u));","  var upperValue = lowerValue;","  if (status[statusOffset] == 0u) {","    lowerValue = selectOrderedValue(index, 0u);","    upperValue = selectOrderedValue(index, 2u);","  lower[lowerOffset + index] = lowerValue;","  upper[upperOffset + index] = upperValue;"],"strings":["point-pattern-envelope-deviations","read","status","gpu-spatial-analysis-point-pattern-envelope-snapshot-tap","statistics","buffer","logical","simulations","GPUPointPatternEnvelope","point-pattern-envelope-test","point-pattern-envelope-observed-statistic","imported","observed","read_write","reference","lower","point-pattern-envelope-comparison-flags","point-pattern-envelope-pointwise","point-pattern-envelope-residuals","upper","integrationWeights","compute","point-pattern-envelope-compare","deviations","transient","residuals","weights"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","bindingByteOffset","bindingByteLength","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:3","~7","~7","~1","f32",0,0,24,6],["~:2",1,1,1],["~:2",4,1,1],["~:3","~2","~2","~1","u32",0,0,4,1],["~:3","~4","~4","~d","f32",0,0,16,4],["~:3","~c","~c","~1","f32",0,0,8,2],["~:3","~e","~e","~1","f32",0,0,8,2],["~:3","~n","~0","~1","f32",0,0,16,4],["~:3","~q","~k","~1","f32",0,0,8,2],["~:4",[1,1,1],1,false],["~:4",[1,1,1],4,false]]}}
