"const CLASSES: u32 = 8u;","const CONDITIONS: u32 = 1u;","const CELLS: u32 = 64u;","@compute @workgroup_size(64)","  _ = &counts;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  counts[countsOffset + index] = 0u;","  ","@group(0) @binding(1) var<storage, read> valid: array<u32>;","const ranksOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> ranks: array<u32>;","  _ = &ranks;","  let row = index % 8u; let base = index - row; var rank = 0xffffffffu;","if (valid[validOffset + row] != 0u) { rank = 0u; let value = values[valuesOffset + index];","  for (var other = 0u; other < 8u; other++) { let candidate = values[valuesOffset + base + other];","    if (valid[validOffset + other] != 0u && (candidate > value || (candidate == value && other > row))) { rank++; }","ranks[ranksOffset + index] = rank;","@group(0) @binding(0) var<storage, read> ranks: array<u32>;","const classesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> classes: array<u32>;","  _ = &classes;","  let rank = index % 8u; let base = index - rank; var occupant = 0xffffffffu;","for (var row = 0u; row < 8u; row++) { if (ranks[ranksOffset + base + row] == rank) { occupant = row; break; } }","classes[classesOffset + index] = occupant;","const mobilityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> mobility: array<f32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","  _ = &mobility;","  var count = 0u; var displacement = 0.0;","for (var row = 0u; row < 8u; row++) { let first = ranks[ranksOffset + index * 8u + row]; let second = ranks[ranksOffset + (index + 1u) * 8u + row];","if (first < 8u && second < 8u) { count++; displacement += abs(f32(first) - f32(second)); } }","mobility[mobilityOffset + index] = select(getNaN(), displacement / f32(count), count > 1u);","@group(0) @binding(0) var<storage, read> classes: array<u32>;","@group(0) @binding(1) var<storage, read_write> counts: array<atomic<u32>>;","const TRANSITIONS: u32 = 16u;","const ITEMS: u32 = 16u;","const TILE_SIZE: u32 = 256u;","// Slot CELLS counts the transitions that are not counted.","var<workgroup> tile: array<atomic<u32>, 65>;","@compute @workgroup_size(256)","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  for (var cell = localInvocationIndex; cell <= CELLS; cell += TILE_SIZE) {","    atomicStore(&tile[cell], 0u);","  workgroupBarrier();","  let tileStart = (index - localInvocationIndex) * ITEMS;","  for (var item = 0u; item < ITEMS; item++) {","    let transition = tileStart + item * TILE_SIZE + localInvocationIndex;","    if (transition < TRANSITIONS) {","      let period = transition / ROWS;","      let row = transition - period * ROWS;","      let fromClass = classes[classesOffset + transition];","      let toClass = classes[classesOffset + transition + 1u * ROWS];","      let condition = 0u;","      let selected = true;","      if (selected && fromClass < CLASSES && toClass < CLASSES && condition < CONDITIONS) {","        atomicAdd(&tile[(condition * CLASSES + fromClass) * CLASSES + toClass], 1u);","      } else {","        atomicAdd(&tile[CELLS], 1u);","      }","    }","    let value = atomicLoad(&tile[cell]);","    if (value > 0u) {","      if (cell < CELLS) {","        atomicAdd(&counts[countsOffset + cell], value);","        ","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const probabilitiesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> probabilities: array<f32>;","  _ = &probabilities;","  var total = 0u;","  for (var to = 0u; to < CLASSES; to++) {","    total += counts[countsOffset + index * CLASSES + to];","    probabilities[probabilitiesOffset + index * CLASSES + to] = select(0.0, f32(counts[countsOffset + index * CLASSES + to]) / f32(total), total > 0u);"],"strings":["ra