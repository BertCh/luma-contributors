GSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  valid[validOffset + index] = 1u;","}","const classesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> classes: array<u32>;","  _ = &classes;","  classes[classesOffset + index] = 0xffffffffu;","const countsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> counts: array<u32>;","const ROWS: u32 = 8u;","const CLASSES: u32 = 8u;","const CONDITIONS: u32 = 1u;","const CELLS: u32 = 64u;","@compute @workgroup_size(64)","  _ = &counts;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  counts[countsOffset + index] = 0u;","  ","const offsetsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> offsets: array<u32>;","  _ = &offsets;","  offsets[offsetsOffset + index] = index * 8u;","@group(0) @binding(1) var<storage, read_write> valid: array<atomic<u32>>;","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","  if (!isFiniteBits(values[valuesOffset + index])) { atomicStore(&valid[validOffset + index % 8u], 0u); }","@group(0) @binding(1) var<storage, read> valid: array<u32>;","const ranksOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> ranks: array<u32>;","  _ = &ranks;","  let row = index % 8u; let base = index - row; var rank = 0xffffffffu;","if (valid[validOffset + row] != 0u) { rank = 0u; let value = values[valuesOffset + index];","  for (var other = 0u; other < 8u; other++) { let candidate = values[valuesOffset + base + other];","    if (valid[validOffset + other] != 0u && (candidate > value || (candidate == value && other > row))) { rank++; }","ranks[ranksOffset + index] = rank;","@group(0) @binding(0) var<storage, read> ranks: array<u32>;","@group(0) @binding(1) var<storage, read_write> classes: array<u32>;","  let row = index % 8u; let rank = ranks[ranksOffset + index];","if (rank < 8u) { classes[classesOffset + index - row + rank] = row; }","const loadBalancedOffsetsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> loadBalancedOffsets: array<u32>;","const loadBalancedOutputOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> loadBalancedOutput: array<u32>;","const loadBalancedCarriesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> loadBalancedCarries: array<u32>;","@group(0) @binding(3) var<storage, read> ranks: array<u32>;","override LOAD_BALANCED_ROW_COUNT: u32;","override LOAD_BALANCED_ITEM_CAPACITY: u32;","override LOAD_BALANCED_LANE_COUNT: u32;","override LOAD_BALANCED_TILES_PER_LANE: u32;","var<workgroup> loadBalancedTileRowEnds: array<u32, 1025>;","var<workgroup> loadBalancedTileBounds: array<u32, 2>;","/** End of row `row` relative to `itemBase`, clamped to the items `[itemBase, itemLimit)`. */","fn getLoadBalancedRowEnd(row: u32, itemBase: u32, itemLimit: u32) -> u32 {","  return clamp(loadBalancedOffsets[loadBalancedOffsetsOffset + row + 1u], itemBase, itemLimit) - itemBase;","/** Rows consumed at merge step `diagonal` (Merrill-Garland merge-path search). */","fn searchLoadBalancedPath(diagonal: u32, itemBase: u32, itemLimit: u32) -> u32 {","  let itemCount = itemLimit - itemBase;","  var low = select(0u, diagonal - itemCount, diagonal > itemCount);","  var high = min(diagonal, LOAD_BALANCED_ROW_COUNT);","  loop {","    if (low >= high) { break; }","    let pivot = (low + high) / 2u;","    if (getLoadBalancedRowEnd(pivot, itemBase, itemLimit) <= diagonal - pivot - 1u) {","      low = pivot + 1u;","    } else {","      high = pivot;","    }","  return low;","var<workgroup> loadBalancedCarryRows: array<u32, 256>;","var<workgroup> loadBalancedCarryValues: array<vec2<u32>, 256>;","fn getLoadBalancedContribution(period: u32, item: u32, lane: u32) -> vec2<u32> {","  let first = ranks[ranksOffset + item];","  let second = ranks[ranksOffset + item + 8u];","  let included = first < 8u && second < 8u;","  return select(vec2<u32>(0u), vec2<u32>(max(first, second) - min(first, second), 1u), included);","@compute @workgroup_size(256)","  _ = &loadBalancedOffsets;","  _ = &loadBalancedOutput;","  _ = &loadBalancedCarries;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  var loadBalancedRunning = vec2<u32>();","  var loadBalancedFirstValue = vec2<u32>();","  var loadBalancedHasEmitted = false;","  let loadBalancedIsActive =","    workgroupIndex < LOAD_BALANCED_LANE_COUNT * LOAD_BALANCED_TILES_PER_LANE;","  let loadBalancedLane = workgroupIndex / LOAD_BALANCED_TILES_PER_LANE;","  let loadBalancedTile = workgroupIndex % LOAD_BALANCED_TILES_PER_LANE;","  let loadBalancedItemBase = min(","    loadBalancedOffsets[loadBalancedOffsetsOffset],","    LOAD_BALANCED_ITEM_CAPACITY","  );","  let loadBalancedItemLimit = clamp(","    loadBalancedOffsets[loadBalancedOffsetsOffset + LOAD_BALANCED_ROW_COUNT],","    loadBalancedItemBase,","  let loadBalancedMergeCount =","    LOAD_BALANCED_ROW_COUNT + loadBalancedItemLimit - loadBalancedItemBase;","  let loadBalancedTileBegin = select(","    loadBalancedMergeCount,","    min(loadBalancedTile * 1024u, loadBalancedMergeCount),","    loadBalancedIsActive","  let loadBalancedTileEnd = min(loadBalancedTileBegin + 1024u, loadBalancedMergeCount);","  let loadBalancedTileLength = loadBalancedTileEnd - loadBalancedTileBegin;","  if (localInvocationIndex < 2u) {","    loadBalancedTileBounds[localInvocationIndex] = searchLoadBalancedPath(","      select(loadBalancedTileBegin, loadBalancedTileEnd, localInvocationIndex == 1u),","      loadBalancedItemBase,","      loadBalancedItemLimit","    );","  workgroupBarrier();","  let loadBalancedTileRowBegin = loadBalancedTileBounds[0];","  let loadBalancedTileRowCount = loadBalancedTileBounds[1] - loadBalancedTileRowBegin;","  // Item coordinates are relative to loadBalancedItemBase; rows at or past ROW_COUNT never end.","  let loadBalancedTileItemBegin = loadBalancedTileBegin - loadBalancedTileRowBegin;","  let loadBalancedTileItemCount =","    loadBalancedTileEnd - loadBalancedTileBounds[1] - loadBalancedTileItemBegin;","  for (var entry = localInvocationIndex; entry <= loadBalancedTileRowCount; entry += 256u) {","    let entryRow = loadBalancedTileRowBegin + entry;","    var rowEnd = 0xffffffffu;","    if (entryRow < LOAD_BALANCED_ROW_COUNT) {","      rowEnd = getLoadBalancedRowEnd(entryRow, loadBalancedItemBase, loadBalancedItemLimit);","    loadBalancedTileRowEnds[entry] = rowEnd;","  let loadBalancedDiagonal = min(","    localInvocationIndex * 4u,","    loadBalancedTileLength","  var loadBalancedLow = select(","    0u,","    loadBalancedDiagonal - loadBalancedTileItemCount,","    loadBalancedDiagonal > loadBalancedTileItemCount","  var loadBalancedHigh = min(loadBalancedDiagonal, loadBalancedTileRowCount);","    if (loadBalancedLow >= loadBalancedHigh) { break; }","    let pivot = (loadBalancedLow + loadBalancedHigh) / 2u;","    if (loadBalancedTileRowEnds[pivot] <= loadBalancedTileItemBegin + loadBalancedDiagonal - pivot - 1u) {","      loadBalancedLow = pivot + 1u;","      loadBalancedHigh = pivot;","  var loadBalancedRow = loadBalancedTileRowBegin + loadBalancedLow;","  let loadBalancedStartRow = loadBalancedRow;","  var loadBalancedItem = loadBalancedTileItemBegin + loadBalancedDiagonal - loadBalancedLow;","  let loadBalancedStepCount = min(","    4u,","    loadBalancedTileLength - loadBalancedDiagonal","  for (var walkStep = 0u; walkStep < 4u; walkStep = walkStep + 1u) {","    if (walkStep < loadBalancedStepCount) {","      if (loadBalancedItem < loadBalancedTileRowEnds[loadBalancedRow - loadBalancedTileRowBegin]) {","        let loadBalancedSlot = loadBalancedItemBase + loadBalancedItem;","        loadBalancedRunning = loadBalancedRunning +","          getLoadBalancedContribution(loadBalancedRow, loadBalancedSlot, loadBalancedLane);","        loadBalancedItem = loadBalancedItem + 1u;","      } else {","        if (loadBalancedHasEmitted) {","            loadBalancedOutput[loadBalancedOutputOffset + (loadBalancedRow * LOAD_BALANCED_LANE_COUNT + loadBalancedLane) * 2u + 0u] = loadBalancedRunning[0];","      loadBalancedOutput[loadBalancedOutputOffset + (loadBalancedRow * LOAD_BALANCED_LANE_COUNT + loadBalancedLane) * 2u + 1u] = loadBalancedRunning[1];","          } else {","            loadBalancedFirstValue = loadBalancedRunning;","            loadBalancedHasEmitted = true;","          }","          loadBalancedRunning = vec2<u32>();","        loadBalancedRow = loadBalancedRow + 1u;","      }","  // Inclusive segmented scan of the thread runs, keyed by row (rows never decrease by thread).","  loadBalancedCarryRows[localInvocationIndex] = loadBalancedRow;","  loadBalancedCarryValues[localInvocationIndex] = loadBalancedRunning;","  for (var stride = 1u; stride < 256u; stride = stride * 2u) {","    var previousRow = 0xffffffffu;","    var previousValue = vec2<u32>();","    if (localInvocationIndex >= stride) {","      previousRow = loadBalancedCarryRows[localInvocationIndex - stride];","      previousValue = loadBalancedCarryValues[localInvocationIndex - stride];","    workgroupBarrier();","    if (previousRow == loadBalancedCarryRows[localInvocationIndex]) {","      loadBalancedCarryValues[localInvocationIndex] =","        previousValue + loadBalancedCarryValues[localInvocationIndex];","  if (loadBalancedIsActive) {","    if (loadBalancedHasEmitted) {","      // Thread t starts in the row where thread t - 1 stopped; its scan holds the earlier runs.","      var carryIn = vec2<u32>();","      if (localInvocationIndex > 0u &&","          loadBalancedCarryRows[localInvocationIndex - 1u] == loadBalancedStartRow) {","        carryIn = loadBalancedCarryValues[localInvocationIndex - 1u];","      let rowValue = carryIn + loadBalancedFirstValue;","      loadBalancedOutp