cell < CELLS) {","        atomicAdd(&counts[countsOffset + cell], value);","        ","@group(0) @binding(0) var<storage, read_write> loadBalancedCarries: array<u32>;","  let loadBalancedLane = index / LOAD_BALANCED_TILES_PER_LANE;","  let tile = index % LOAD_BALANCED_TILES_PER_LANE;","  let row = loadBalancedCarries[loadBalancedCarriesOffset + index * 3u];","  if (row >= LOAD_BALANCED_ROW_COUNT) {","  // Only the first tile of a run of tiles carrying the same row adds the run, in tile order.","  if (tile > 0u && loadBalancedCarries[loadBalancedCarriesOffset + (index - 1u) * 3u] == row) {","  var sum = vec2<u32>(loadBalancedCarries[loadBalancedCarriesOffset + index * 3u + 1u], loadBalancedCarries[loadBalancedCarriesOffset + index * 3u + 2u]);","  let laneEnd = (loadBalancedLane + 1u) * LOAD_BALANCED_TILES_PER_LANE;","  var next = index + 1u;","    if (next >= laneEnd ||","        loadBalancedCarries[loadBalancedCarriesOffset + next * 3u] != row) {","      break;","    sum = sum + vec2<u32>(loadBalancedCarries[loadBalancedCarriesOffset + next * 3u + 1u], loadBalancedCarries[loadBalancedCarriesOffset + next * 3u + 2u]);","    next = next + 1u;","  loadBalancedOutput[loadBalancedOutputOffset + (row * LOAD_BALANCED_LANE_COUNT + loadBalancedLane) * 2u + 0u] += sum[0];","      loadBalancedOutput[loadBalancedOutputOffset + (row * LOAD_BALANCED_LANE_COUNT + loadBalancedLane) * 2u + 1u] += sum[1];","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const probabilitiesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> probabilities: array<f32>;","  _ = &probabilities;","  var total = 0u;","  for (var to = 0u; to < CLASSES; to++) {","    total += counts[countsOffset + index * CLASSES + to];","    probabilities[probabilitiesOffset + index * CLASSES + to] = select(0.0, f32(counts[countsOffset + index * CLASSES + to]) / f32(total), total > 0u);","const totalsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> totals: array<u32>;","const mobilityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> mobility: array<f32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn getRankMobilityMean(displacement: u32, population: u32) -> f32 {","  if (population < 2u) { return getNaN(); }","  if (displacement == 0u) { return 0.0; }","  var significand = displacement / population;","  var remainder = displacement % population;","  var exponent = 150u;","  while (significand < 0x800000u) {","    remainder *= 2u;","    significand = significand * 2u + remainder / population;","    remainder %= population;","    exponent -= 1u;","  let doubledRemainder = remainder * 2u;","  if (doubledRemainder > population ||","      (doubledRemainder == population && (significand & 1u) != 0u)) {","    significand += 1u;","  if (significand == 0x1000000u) { significand >>= 1u; exponent += 1u; }","  return bitcast<f32>((exponent << 23u) | (significand & 0x7fffffu));","  _ = &totals;","  _ = &mobility;","  let population = totals[totalsOffset + index * 2u + 1u];","mobility[mobilityOffset + index] = getRankMobilityMean(totals[totalsOffset + index * 2u], population);"],"strings":["GPURankMarkov","rank-markov-occupants","read_write","statistics-output-1","compute","statistics-output-3","gpu-spatial-analysis-rank-markov-snapshot-tap","rank-markov-complete-cases","rank-markov-mobility-offsets","rank-markov-mobility-totals","buffer","logical","read","rank-markov-mobility-reduce","rank-markov-mobility-reduce-tile-carries","rank-markov-rank","statistics-input-0","rank-markov-transitions-count","GPUTransitionMatrix","rank-markov-mobility","rank-markov-mobility-reduce-fixup","statistics-output-2","statistics-output-4","imported","rank-markov-complete","rank-markov-transitions-normalize","transient","rank-markov-clear-occupants","rank-markov-exclude-incomplete","rank-markov-transitions-clear","classes","counts","ranks","valid