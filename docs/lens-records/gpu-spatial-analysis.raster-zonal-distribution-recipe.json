eturn p >= 0.0 && p <= 1.0;","fn getOrderStatisticKey(value: f32) -> u32 {","  var bits = bitcast<u32>(value);","// Identity the compiler cannot fold: the bit operation on a runtime zero stops multiply-add","// fusion, so every f32 step rounds exactly like a Math.fround mirror.","fn roundOrderStatisticStep(value: f32, zero: u32) -> f32 {","  return bitcast<f32>(bitcast<u32>(value) | zero);","fn interpolateOrderStatistic(low: f32, high: f32, fraction: f32, zero: u32) -> f32 {","  if (fraction == 0.0 || low == high) {","    return low;","  let difference = roundOrderStatisticStep(high - low, zero);","  if ((bitcast<u32>(difference) & 0x7f800000u) != 0x7f800000u) {","    return low + roundOrderStatisticStep(difference * fraction, zero);","  // high - low overflowed; a convex combination of two finite values cannot.","  return roundOrderStatisticStep(low * (1.0 - fraction), zero) +","    roundOrderStatisticStep(high * fraction, zero);","fn getOrderStatisticMidpoint(low: f32, high: f32, zero: u32) -> f32 {","  if (low == high) {","  let sum = roundOrderStatisticStep(low + high, zero);","  if ((bitcast<u32>(sum) & 0x7f800000u) != 0x7f800000u) {","    return sum * 0.5;","  return roundOrderStatisticStep(low * 0.5, zero) + roundOrderStatisticStep(high * 0.5, zero);","fn getQuantile(begin: u32, count: u32, p: f32) -> f32 {","  if (count == 0u || !isOrderStatisticProbability(p)) {","    return getNaN();","  // Counts stay below 2^31, so this is a runtime zero that blocks multiply-add fusion.","  let zero = count >> 31u;","  let h = roundOrderStatisticStep(f32(count - 1u) * p, zero);","  let floorH = floor(h);","  let lowIndex = min(u32(floorH), count - 1u);","  let low = decodeOrderedKey(sortedKeys[sortedKeysOffset + begin + lowIndex]);","  if (lowIndex + 1u >= count) {","  let high = decodeOrderedKey(sortedKeys[sortedKeysOffset + begin + lowIndex + 1u]);","  return interpolateOrderStatistic(low, high, h - floorH, zero);","  _ = &sortedKeys;","  _ = &mediansOut;","  var begin