g(4) var<storage, read_write> startFlags: array<u32>;","const LINE_COUNT: u32 = 223u;","const ROW_COUNT: u32 = 513u;","const NO_LINE: u32 = 0xffffffffu;","fn findLine(row: u32) -> u32 {","  var low = 0u;","  var high = LINE_COUNT + 1u;","  while (low < high) {","    let middle = (low + high) / 2u;","    if (lineOffsets[lineOffsetsOffset + middle] <= row) {","      low = middle + 1u;","    } else {","      high = middle;","    }","  }","  if (low == 0u || low > LINE_COUNT) {","    return NO_LINE;","  return low - 1u;","}","fn getPosition(row: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","fn getClip(row: u32) -> vec3<f32> {","  let line = findLine(row);","  if (line == NO_LINE || row + 1u >= min(lineOffsets[lineOffsetsOffset + line + 1u], ROW_COUNT)) {","    return vec3<f32>(0.0);","  let a = getPosition(row);","  let d = getPosition(row + 1u) - a;","  let lower = vec2<f32>(parameters[parametersOffset], parameters[parametersOffset + 1u]);","  let upper = vec2<f32>(parameters[parametersOffset + 2u], parameters[parametersOffset + 3u]);","  var t0 = 0.0;","  var t1 = 1.0;","  var p = array<f32, 4>(-d.x, d.x, -d.y, d.y);","  var q = array<f32, 4>(a.x - lower.x, upper.x - a.x, a.y - lower.y, upper.y - a.y);","  for (var side = 0u; side < 4u; side++) {","    if (p[side] == 0.0) {","      if (q[side] < 0.0) {","        return vec3<f32>(0.0);","      }","      let r = q[side] / p[side];","      if (p[side] < 0.0) {","        if (r > t1) {","          return vec3<f32>(0.0);","        }","        t0 = max(t0, r);","      } else {","        if (r < t0) {","        t1 = min(t1, r);","  // A single touching point is not a segment, except a genuinely zero-length input segment.","  if (t1 < t0 || (t1 == t0 && (d.x != 0.0 || d.y != 0.0))) {","  return vec3<f32>(t0, t1, 1.0);","fn getLineStart(row: u32) -> u32 {","  return lineOffsets[lineOffsetsOffset + findLine(row)];","fn isContinuation(row: u32, clip: vec3<f32>) -> bool {","  if (clip.z == 0.0 || row == 0u || row <= getLineStart(row)) {","    return false;","  let previous = getClip(row - 1u);","  return previous.z != 0.0 && previous.y == 1.0 && clip.x == 0.0;","fn getClippedStart(row: u32, clip: vec3<f32>) -> vec2<f32> {","  return select(a + (getPosition(row + 1u) - a) * clip.x, a, clip.x == 0.0);","fn getClippedEnd(row: u32, clip: vec3<f32>) -> vec2<f32> {","  let b = getPosition(row + 1u);","  return select(a + (b - a) * clip.y, b, clip.y == 1.0);","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &lineOffsets;","  _ = &parameters;","  _ = &counts;","  _ = &startFlags;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let clip = getClip(index);","  let continues = isContinuation(index, clip);","  counts[countsOffset + index] = select(0u, select(2u, 1u, continues), clip.z != 0.0);","  startFlags[startFlagsOffset + index] = select(0u, 1u, clip.z != 0.0 && !continues);","const startsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> starts: array<u32>;","const lineIndicesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> lineIndices: array<u32>;","const outPositionsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> outPositions: array<f32>;","const outLineOffsetsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> outLineOffsets: array<u32>;","const outSourceLineIndicesOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> outSourceLineIndices: array<u32>;","const CAPACITY: u32 = 580u;","const LINE_CAPACITY: u32 = 290u;","fn writeVertex(slot: u32, p: vec2<f32>) {","  if (slot < CAPACITY) {","    outPositions[outPositionsOffset + 2u * slot] = p.x;","    outPositions[outPositionsOffset + 2u * slot + 1u] = p.y;","  _ = &starts;","  _ = &lineIndices;","  _ = &outPositions;","  _ = &outLineOffsets;","  _ = &outSourceLineIndices;","  if (clip.z == 0.0) {","  var slot = starts[startsOffset + index];","  if (!continues) {","    let lineIndex = lineIndices[lineIndicesOffset + index];","    if (lineIndex < LINE_CAPACITY) {","      outLineOffsets[outLineOffsetsOffset + lineIndex] = min(slot, CAPACITY);","      outSourceLineIndices[outSourceLineIndicesOffset + lineIndex] = findLine(index);","    writeVertex(slot, getClippedStart(index, clip));","    slot += 1u;","  writeVertex(slot, getClippedEnd(index, clip));","@group(0) @binding(0) var<storage, read> starts: array<u32>;","@group(0) @binding(1) var<storage, read> counts: array<u32>;","@group(0) @binding(2) var<storage, read> lineIndices: array<u32>;","@group(0) @binding(3) var<storage, read> startFlags: array<u32>;","const totalsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> totals: array<u32>;","const overflowOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> overflowOut: array<u32>;","@compute @workgroup_size(32)","  _ = &totals;","  _ = &overflowOut;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  let vertexTotal = starts[startsOffset + 512u] + counts[countsOffset + 512u];","  let lineTotal = lineIndices[lineIndicesOffset + 512u] + startFlags[startFlagsOffset + 512u];","  let lineClamped = min(lineTotal, 290u);","  totals[totalsOffset] = min(vertexTotal, 580u);","  totals[totalsOffset + 1u] = lineClamped;","  totals[totalsOffset + 2u] = vertexTotal;","  totals[totalsOffset + 3u] = lineTotal;","  overflowOut[overflowOutOffset] = select(0u, 1u, vertexTotal > 580u || lineTotal > 290u);","@group(0) @binding(0) var<storage, read> totals: array<u32>;","@group(0) @binding(1) var<storage, read_write> lineOffsets: array<u32>;","const countOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> countOut: array<u32>;","const vertexCountOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> vertexCountOut: array<u32>;","const sourceLineIndicesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> sourceLineIndices: array<u32>;","  _ = &countOut;","  _ = &vertexCountOut;","  _ = &sourceLineIndices;","  if (index == 0u) {","    countOut[countOutOffset] = totals[totalsOffset + 1u];","    vertexCountOut[vertexCountOutOffset] = totals[totalsOffset + 0u];","  if (index >= totals[totalsOffset + 1u]) {","    lineOffsets[lineOffsetsOffset + index] = totals[totalsOffset];","    if (index < 290u) {","      sourceLineIndices[sourceLineIndicesOffset + index] = 4294967295u;"],"strings":["buffer","gpu-spatial-analysis-rectangle-clip-snapshot-tap","rectangle-clip-publish","read","GPUScan","rectangle-clip-line-tail","read_write","rectangle-clip-count","rectangle-clip-emit","rectangle-clip-line-indices","rectangle-clip-starts","sourceLineIndices","transient","clippedOffsets","compute","lineOffsets","rectangle-clip-counts","rectangle-clip-start-flags","GPURectangleClip","positions","imported","parameters","rectangle-clip-line-scan-level-0-add-offsets","rectangle-clip-line-scan-level-0-scan","rectangle-clip-totals","rectangle-clip-vertex-scan-level-0-add-offsets","rectangle-clip-vertex-scan-level-0-scan","clipped","count","overflow","rectangle-clip-line-scan-level-1-scan","rectangle-clip-vertex-scan-level-1-scan","vertexCount","rectangle-clip-line-scan-level-0-block-offsets","rectangle-clip-line-scan-level-0-block-sums","rectangle-clip-vertex-scan-level-0-block-offsets","rectangle-clip-vertex-scan-level-0-block-sums","subgroups","counts","lineIndices","startFlags","starts","totals"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","