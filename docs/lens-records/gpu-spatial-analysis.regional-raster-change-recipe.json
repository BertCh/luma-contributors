ound.","fn isObservationValid(cell: u32, slice: u32) -> bool {","  return true;","// The sample at (cell, slice, band) is missing: not finite, or its observation is invalid.","fn isMissingAt(cell: u32, slice: u32, value: f32) -> bool {","  return isMissingSample(value) || !isObservationValid(cell, slice);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &slices;","  _ = &params;","  _ = &differenceOut;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let cell = index / BAND_COUNT;","  let band = index % BAND_COUNT;","  differenceOut[differenceOutOffset + index] = quietNan();","  ","  let beforeSlice = params[paramsOffset];","  let afterSlice = params[paramsOffset + 1u];","  let epsilon = params[paramsOffset + 2u];","  if (!(beforeSlice >= 0.0 && beforeSlice < f32(SLICE_COUNT) && afterSlice >= 0.0 && afterSlice < f32(SLICE_COUNT))) {","  let before = slices[slicesOffset + (cell * SLICE_COUNT + u32(beforeSlice)) * BAND_COUNT + band];","  let after = slices[slicesOffset + (cell * SLICE_COUNT + u32(afterSlice)) * BAND_COUNT + band];","  if (isMissingAt(cell, u32(beforeSlice), before) || isMissingAt(cell, u32(afterSlice), after)) {","  differenceOut[differenceOutOffset + index] = after - before;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","  _ = &fillTarget;","  fillTarget[fillTargetOffset + index] = 0u;","const valueCountsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> valueCounts: array<u32>;","  _ = &valueCounts;","  valueCounts[valueCountsOffset + index] = 0u;","const differenceOffset: