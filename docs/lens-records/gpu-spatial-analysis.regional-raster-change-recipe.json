,"    let zone = zones[zonesOffset + cell];","    if (zone >= CAPACITY || zone == IGNORED) {","      if (zone != IGNORED) {","        atomicStore(&overflowFlag[overflowFlagOffset], 1u);","      }","      continue;","    ","    let value = values[valuesOffset + cell];","    if (validity[validityOffset + cell] != 0u && isFiniteValue(value)) {","      atomicAdd(&local_valueCounts[zone], 1u);","      ","    let partial_valueCounts = atomicLoad(&local_valueCounts[slot]);","    if (partial_valueCounts != 0u) {","      atomicAdd(&valueCounts[valueCountsOffset + slot], partial_valueCounts);","const valueMaskOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> valueMask: array<u32>;","@group(0) @binding(4) var<storage, read_write> sortRows: array<u32>;","@group(0) @binding(5) var<storage, read_write> contributions: array<f32>;","@group(0) @binding(6) var<storage, read_write> overflowFlag: array<atomic<u32>>;","  _ = &valueMask;","  valueMask[valueMaskOffset + index] = select(0u, 1u, isValid);","  if (zone >= CAPACITY && zone != IGNORED) {","    atomicStore(&overflowFlag[overflowFlagOffset], 1u);","const pointFeatureRowsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> pointFeatureRows: array<u32>;","const sortKeysOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> sortKeys: array<u32>;","const sortIndicesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> sortIndices: array<u32>;","const FEATURE_COUNT: u32 = 2u;","  _ = &pointFeatureRows;","  _ = &sortKeys;","  _ = &sortIndices;","  sortKeys[sortKeysOffset + index] = min(pointFeatureRows[pointFeatureRowsOffset + index], FEATURE_COUNT);","  sortIndices[sortIndicesOffset + index] = index;","@group(0) @binding(0) var<storage, read> source: array<u32>;","@group(0) @binding(1) var<storage, read_write> destination: array<u32>;","enable subgroups;","requires subgroup_id;","override LOGICAL_LENGTH: u32;","override KEYS_OFFSET: u32;","override VALUES_OFFSET: u32;","override OUTPU