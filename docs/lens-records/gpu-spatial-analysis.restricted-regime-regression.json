egression-compiled","resource":"statistics-output-9","afterNode":"restricted-regime-regression-stability","role":"output"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const predictorsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> predictors: array<f32>;","const responseOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> response: array<f32>;","const regimesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> regimes: array<u32>;","const maskOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> mask: array<u32>;","const coefficientsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> coefficients: array<f32>;","const covarianceOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> covariance: array<f32>;","const chowOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> chow: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> status: array<u32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","const OFFSETS = array<u32, 2>(0u, 2u);","const COMMON = array<bool, 2>(false, true);","fn included(row: u32) -> bool { if (regimes[regimesOffset + row] >= 2u || mask[maskOffset + row] == 0u || !isFiniteBits(response[responseOffset + row])) { return false; }","for (var column = 0u; column < 1u; column++) { if (!isFiniteBits(predictors[predictorsOffset + row * 1u + column])) { return false; } } return true; }","fn rawValue(row: u32, column: u32) -> f32 { if (column == 0u) { return 1.0; } return predictors[predictorsOffset + row * 1u + column - 1u]; }","fn choleskyFactor_3(a: ptr<function, array<f32, 9>>) -> bool {","  for (var column = 0u; column < 3u; column++) {","    var diagonal = (*a)[column * 3u + column];","    for (var k = 0u; k < column; k++) {","      let value = (*a)[column * 3u + k];","      diagonal = diagonal - value * value;","    }","    if (!(diagonal > 0.0) || diagonal > 3.0e38) {","      return false;","    let pivot = sqrt(diagonal);","    (*a)[column * 3u + column] = pivot;","    for (var row = column + 1u; row < 3u; row++) {","      var value = (*a)[row * 3u + column];","      for (var k = 0u; k < column; k++) {","        value = value - (*a)[row * 3u + k] * (*a)[column * 3u + k];","      }","      (*a)[row * 3u + column] = value / pivot;","  }","  return true;","fn choleskySolve_3(a: ptr<function, array<f32, 9>>, b: ptr<function, array<f32, 3>>) {","  for (var row = 0u; row < 3u; row++) {","    var value = (*b)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*a)[row * 3u + k] * (*b)[k];","    (*b)[row] = value / (*a)[row * 3u + row];","  for (var offset = 0u; offset < 3u; offset++) {","    let row = 2u - offset;","    for (var k = row + 1u; k < 3u; k++) {","      value = value - (*a)[k * 3u + row] * (*b)[k];","fn choleskyInverseDiagonal_3(a: ptr<function, array<f32, 9>>, column: u32) -> f32 {","  var unit: array<f32, 3>;","    unit[row] = select(0.0, 1.0, row == column);","  choleskySolve_3(a, &unit);","  return unit[column];","fn choleskyFactor_4(a: ptr<function, array<f32, 16>>) -> bool {","  for (var column = 0u; column < 4u; column++) {","    var diagonal = (*a)[column * 4u + column];","      let value = (*a)[column * 4u + k];","    (*a)[column * 4u + column] = pivot;","    for (var row = column + 1u; row < 4u; row++) {","      var value = (*a)[row * 4u + column];","        value = value - (*a)[row * 4u + k] * (*a)[column * 4u + k];","      (*a)[row * 4u + column] = value / pivot;","fn choleskySolve_4(a: ptr<function, array<f32, 16>>, b: ptr<function, array<f32, 4>>) {","  for (var row = 0u; row < 4u; row++) {","      value = value - (*a)[row * 4u + k] * (*b)[k];","    (*b)[row] = value / (*a)[row * 4u + row];","  for (var offset = 0u; offset < 4u; offset++) {","    let row = 3u - offset;","    for (var k = row + 1u; k < 4u; k++) {","      value = value - (*a)[k * 4u + row] * (*b)[k];","fn choleskyInverseDiagonal_4(a: ptr<function, array<f32, 16>>, column: u32) -> f32 {","  var unit: array<f32, 4>;","  choleskySolve_4(a, &unit);","fn design_restricted(row: u32) -> array<f32, 3> { var values: array<f32, 3>; let regime = regimes[regimesOffset + row];","for (var column = 0u; column < 2u; column++) { let destination = OFFSETS[column] + select(regime, 0u, COMMON[column]); values[destination] = rawValue(row, column); } return values; }","fn fit_restricted(estimate: ptr<function, array<f32, 3>>, inverse: ptr<function, array<f32, 9>>, residualSquares: ptr<function, f32>) -> bool {","var normal: array<f32, 9>; var right: array<f32, 3>;","for (var row = 0u; row < 24u; row++) { if (!included(row)) { continue; } let values = design_restricted(row); for (var first = 0u; first < 3u; first++) { right[first] += values[first] * response[responseOffset + row]; for (var second = 0u; second < 3u; second++) { normal[first * 3u + second] += values[first] * values[second]; } } }","var scales: array<f32, 3>;","for (var column = 0u; column < 3u; column++) { let diagonal = normal[column * 4u]; if (!(diagonal > 0.0) || !isFiniteBits(diagonal)) { return false; } scales[column] = inverseSqrt(diagonal); right[column] *= scales[column]; }","for (var first = 0u; first < 3u; first++) { for (var second = 0u; second < 3u; second++) { normal[first * 3u + second] *= scales[first] * scales[second]; } }","if (!choleskyFactor_3(&normal)) { return false; } choleskySolve_3(&normal, &right);","for (var column = 0u; column < 3u; column++) { (*estimate)[column] = right[column] * scales[column]; var unit: array<f32, 3>; unit[column] = scales[column]; choleskySolve_3(&normal, &unit); for (var row = 0u; row < 3u; row++) { (*inverse)[row * 3u + column] = unit[row] * scales[row]; } }","var squares = 0.0; for (var row = 0u; row < 24u; row++) { if (!included(row)) { continue; } let values = design_restricted(row); var residual = response[responseOffset + row]; for (var column = 0u; column < 3u; column++) { residual -= values[column] * (*estimate)[column]; } squares += residual * residual; }","*residualSquares = squares; return isFiniteBits(squares);","fn design_unrestricted(row: u32) -> array<f32, 4> { var values: array<f32, 4>; let regime = regimes[regimesOffset + row];","for (var column = 0u; column < 2u; column++) { let destination = column * 2u + regime; values[destination] = rawValue(row, column); } return values; }","fn fit_unrestricted(estimate: ptr<function, array<f32, 4>>, inverse: ptr<function, array<f32, 16>>, residualSquares: ptr<function, f32>) -> bool {","var normal: array<f32, 16>; var right: array<f32, 4>;","for (var row = 0u; row < 24u; row++) { if (!included(row)) { continue; } let values = design_unrestricted(row); for (var first = 0u; first < 4u; first++) { right[first] += values[first] * response[responseOffset + row]; for (var second = 0u; second < 4u; second++) { normal[first * 4u + second] += values[first] * values[second]; } } }","var scales: array<f32, 4>;","for (var column = 0u; column < 4u; column++) { let diagonal = normal[column * 5u]; if (!(diagonal > 0.0) || !isFiniteBits(diagonal)) { return false; } scales[column] = inverseSqrt(diagonal); right[column] *= scales[column]; }","for (var first = 0u; first < 4u; first++) { for (var second = 0u; second < 4u; second++) { normal[first * 4u + second] *= scales[first] * scales[second]; } }","if (!choleskyFactor_4(&normal)) { return false; } choleskySolve_4(&normal, &right);","for (var column = 0u; column < 4u; column++) { (*estimate)[column] = right[column] * scales[column]; var unit: array<f32, 4>; unit[column] = scales[column]; choleskySolve_4(&normal, &unit); for (var row = 0u; row < 4u; row++) { (*inverse)[row * 4u + column] = unit[row] * scales[row]; } }","var squares = 0.0; for (var row = 0u; row < 24u; row++) { if (!included(row)) { continue; } let values = design_unrestricted(row); var residual = response[responseOffset + row]; for (var column = 0u; column < 4u; column++) { residual -= values[column] * (*estimate)[column]; } squares += residual * residual; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &predictors;","  _ = &response;","  _ = &regimes;","  _ = &mask;","  _ = &coefficients;","  _ = &covariance;","  _ = &chow;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  status[statusOffset] = 1u;","for (var slot = 0u; slot < 3u; slot++) { coefficients[coefficientsOffset + slot] = getNaN(); }","for (var slot = 0u; slot < 9u; slot++) { covariance[covarianceOffset + slot] = getNaN(); }","for (var slot = 0u; slot < 3u; slot++) { chow[chowOffset + slot] = getNaN(); }","var count = 0u; for (var row = 0u; row < 24u; row++) { count += select(0u,1u,included(row)); } if (count <= 4u) { return; }","var estimate: array<f32, 3>; var inverse: array<f32, 9>; var squares = 0.0;","if (!fit_restricted(&estimate,&inverse,&squares)) { status[statusOffset] = 2u; return; }","let variance = squares / f32(count - 3u);","for (var slot = 0u; slot < 3u; slot++) { coefficients[coefficientsOffset + slot] = estimate[slot]; }","for (var slot = 0u; slot < 9u; slot++) { covariance[covarianceOffset + slot] = inverse[slot] * variance; }","var fullEstimate: array<f32, 4>; var fullInverse: array<f32, 16>; var fullSquares = 0.0;","if (!fit_unrestricted(&fullEstimate,&fullInverse,&fullSquares)) { status[statusOffset] = 3u; return; }","chow[chowOffset + 1u] = 1.0; chow[chowOffset + 2u] = f32(count - 4u);","if (fullSquares > 0.0) { chow[chowOffset] = max(0.0, squares-fullSquares) / 1.0 / (fullSquares/f32(count-4u)); }","status[statusOffset] = 0u;","@group(0) @binding(4) var<storage, read> coefficients: array<f32>;","const fittedOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> fitted: array<f32>;","  _ = &fitted;","  var prediction = getNaN(); if (included(index)) { prediction = 0.0; let regime = regimes[regimesOffset+index]; for (var column=0u; column<2u; column++) { let coefficient = OFFSETS[column]+select(regime,0u,COMMON[column]); prediction += rawValue(index,column)*coefficients[coefficientsOffset+coefficient]; } } fitted[fittedOffset+index]=prediction;","@group(0) @binding(0) var<storage, read> coefficients: array<f32>;","@group(0) @binding(1) var<storage, read> covariance: array<f32>;","@group(0) @binding(2) var<storage, read> status: array<u32>;","const stabilityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> stability: array<f32>;","fn isNanBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u;","fn getLogGammaValue(z: f32) -> f32 {","  var shifted = z;","  var product = 1.0;","  for (var step = 0u; step < 8u; step++) {","    if (shifted >= 8.0) {","      break;","    product = product * shifted;","    shifted = shifted + 1.0;","  let inverse = 1.0 / shifted;","  let inverseSquared = inverse * inverse;","  let series = inverse * (1.0 / 12.0 - inverseSquared * (1.0 / 360.0 - inverseSquared * (1.0 / 1260.0)));","  return (shifted - 0.5) * log(shifted) - shifted + 0.9189385332 + series - log(product);","// Standard normal survival function via the Numerical Recipes erfc fit (relative error under 1.2e-7).","fn getNormalSurvivalValue(z: f32) -> f32 {","  let magnitude = abs(z) * 0.7071067811865476;","  let t = 1.0 / (1.0 + 0.5 * magnitude);","  let r = t * exp(-magnitude * magnitude - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 +","    t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 +","    t * (-0.82215223 + t * 0.17087277)))))))));","  return 0.5 * select(2.0 - r, r, z >= 0.0);","fn getChiSquareSurvivalValue(value: f32, degreesOfFreedom: f32) -> f32 {","  if (isNanBits(value) || !(degreesOfFreedom > 0.0)) {","    return getNaN();","  if (!(value > 0.0)) {","    return 1.0;","  let a = degreesOfFreedom * 0.5;","  let x = value * 0.5;","  if (a > 1000.0) {","    // Wilson-Hilferty: (X / dof)^(1/3) is approximately normal with mean 1 - 2 / (9 dof).","    let variance = 2.0 / (9.0 * degreesOfFreedom);","    let z = (pow(value / degreesOfFreedom, 1.0 / 3.0) - (1.0 - variance)) / sqrt(variance);","    return getNormalSurvivalValue(z);","  let logPrefactor = -x + a * log(x) - getLogGammaValue(a);","  if (x < a + 1.0) {","    var term = 1.0 / a;","    var sum = term;","    for (var iteration = 1u; iteration <= 500u; iteration++) {","      term = term * x / (a + f32(iteration));","      sum = sum + term;","      if (term < sum * 1.0e-7) {","        break;","    return clamp(1.0 - sum * exp(logPrefactor), 0.0, 1.0);","  let tiny = 1.0e-30;","  var b = x + 1.0 - a;","  var c = 1.0 / tiny;","  var d = 1.0 / b;","  var h = d;","  for (var iteration = 1u; iteration <= 500u; iteration++) {","    let stepIndex = f32(iteration);","    let an = -stepIndex * (stepIndex - a);","    b = b + 2.0;","    d = an * d + b;","    if (abs(d) < tiny) {","      d = tiny;","    c = b + an / c;","    if (abs(c) < tiny) {","      c = tiny;","    d = 1.0 / d;","    let delta = d * c;","    h = h * delta;","    if (abs(delta - 1.0) < 2.0e-7) {","  return clamp(exp(logPrefactor) * h, 0.0, 1.0);","fn choleskyFactor_1(a: ptr<function, array<f32, 1>>) -> bool {","  for (var column = 0u; column < 1u; column++) {","    var diagonal = (*a)[column * 1u + column];","      let value = (*a)[column * 1u + k];","    (*a)[column * 1u + column] = pivot;","    for (var row = column + 1u; row < 1u; row++) {","      var value = (*a)[row * 1u + column];","        value = value - (*a)[row * 1u + k] * (*a)[column * 1u + k];","      (*a)[row * 1u + column] = value / pivot;","fn choleskySolve_1(a: ptr<function, array<f32, 1>>, b: ptr<function, array<f32, 1>>) {","  for (var row = 0u; row < 1u; row++) {","      value = value - (*a)[row * 1u + k] * (*b)[k];","    (*b)[row] = value / (*a)[row * 1u + row];","  for (var offset = 0u; offset < 1u; offset++) {","    let row = 0u - offset;","    for (var k = row + 1u; k < 1u; k++) {","      value = value - (*a)[k * 1u + row] * (*b)[k];","fn choleskyInverseDiagonal_1(a: ptr<function, array<f32, 1>>, column: u32) -> f32 {","  var unit: array<f32, 1>;","  choleskySolve_1(a, &unit);","const COLUMNS = array<u32, 1>(0u);","const OFFSETS = array<u32, 1>(1u);","const BASES = array<u32, 1>(0u);","  _ = &stability;","  stability[stabilityOffset + index * 3u] = getNaN(); stability[stabilityOffset + index * 3u + 1u] = 0.0; stability[stabilityOffset + index * 3u + 2u] = getNaN();","if (status[statusOffset] != 0u) { return; }","var selected: array<u32, 1>; var count = 0u;","for (var contrast = 0u; contrast < 1u; contrast++) { if (index == 2u || COLUMNS[contrast] == index) { selected[count] = contrast; count++; } }","if (count == 0u) { return; }","var normal: array<f32, 1>; var right: array<f32, 1>; var difference: array<f32, 1>;","for (var first = 0u; first < 1u; first++) { normal[first * 2u] = 1.0; }","for (var first = 0u; first < count; first++) { let positive = OFFSETS[selected[first]]; let negative = BASES[selected[first]]; difference[first] = coefficients[coefficientsOffset + positive] - coefficients[coefficientsOffset + negative]; right[first] = difference[first];","for (var second = 0u; second < count; second++) { let otherPositive = OFFSETS[selected[second]]; let otherNegative = BASES[selected[second]];","normal[first * 1u + second] = covariance[covarianceOffset + positive * 3u + otherPositive] - covariance[covarianceOffset + positive * 3u + otherNegative] - covariance[covarianceOffset + negative * 3u + otherPositive] + covariance[covarianceOffset + negative * 3u + otherNegative]; } }","if (!choleskyFactor_1(&normal)) { return; } choleskySolve_1(&normal, &right);","var statistic = 0.0; for (var contrast = 0u; contrast < count; contrast++) { statistic += difference[contrast] * right[contrast]; }","statistic = max(0.0, statistic); stability[stabilityOffset + index * 3u] = statistic; stability[stabilityOffset + index * 3u + 1u] = f32(count); stability[stabilityOffset + index * 3u + 2u] = getChiSquareSurvivalValue(statistic, f32(count));"],"strings":["restricted-regime-regression-fit","buffer","imported","read","restricted-regime-regression-stability","statistics-output-4","restricted-regime-regression-predict","statistics-output-5","statistics-output-9","GPURestrictedRegimeRegression","read_write","statistics-input-0","statistics-input-1","statistics-input-2","statistics-input-3","statistics-output-6","statistics-output-7","statistics-output-8","coefficients","compute","restricted-regime-regression","covariance","mask","predictors","regimes","response","status"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership"],["id","kind","bytes","ownership","firstNode","lastNode"]],"lists":[["~:2","~i","~5","~3","f32",0,3],["~:2","~m","~e","~3","u32",0,24],["~:2","~n","~b","~3","f32",0,24],["~:2","~o","~d","~3","u32",0,24],["~:2","~p","~c","~3","f32",0,24]]}}
