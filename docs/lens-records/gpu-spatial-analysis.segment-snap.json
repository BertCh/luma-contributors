m;","  sharedMaxima[localInvocationIndex] = localMaximum;","  workgroupBarrier();","  for (var stride = 128u; stride > 0u; stride = stride >> 1u) {","    if (localInvocationIndex < stride) {","      sharedMinima[localInvocationIndex] = min(sharedMinima[localInvocationIndex], sharedMinima[localInvocationIndex + stride]);","      sharedMaxima[localInvocationIndex] = max(sharedMaxima[localInvocationIndex], sharedMaxima[localInvocationIndex + stride]);","    workgroupBarrier();","  if (localInvocationIndex == 0u) {","    let minimum = sharedMinima[0];","    let maximum = sharedMaxima[0];","    let hasValid = minimum.x <= maximum.x && minimum.y <= maximum.y;","    boundsOut[boundsOutOffset] = select(0.0, minimum.x, hasValid);","    boundsOut[boundsOutOffset + 1u] = select(0.0, minimum.y, hasValid);","    boundsOut[boundsOutOffset + 2u] = select(0.0, maximum.x, hasValid);","    boundsOut[boundsOutOffset + 3u] = select(0.0, maximum.y, hasValid);","const boundsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> bounds: array<f32>;","const normalizedOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> normalized: array<f32>;","@group(0) @binding(3) var<storage, read_write> candidates: array<atomic<u32>>;","fn getScaledQuotient(value: f32, first: f32, second: f32, power: i32) -> f32 {","  if (value == 0.0) { return value; }","  let numerator = frexp(value);","  let firstDivisor = frexp(first);","  let secondDivisor = frexp(second);","  let quotient = frexp(numerator.fract / (firstDivisor.fract * secondDivisor.fract));","  return ldexp(quotient.fract,","    numerator.exp - firstDivisor.exp - secondDivisor.exp + power + quotient.exp);","fn normalizeCoordinate(value: f32, minimum: f32, extent: f32) -> f32 {","  if (extent < 1.175494351e-38) { return 0.5; }","  // A conservative query expansion can overflow even though all caller coordinates are finite.","  // Never pass infinity into the finite-input exponent-scaled quotient helper.","  if ((bitcast<u32>(value) & 0x7f800000u) == 0x7f800000u) { return select(0.0, 1.0, value > 0.0); }","  return clamp(getScaledQuotient(value * 0.5 - minimum, extent, 1.0, 0), 0.0, 1.0);","fn normalizePoint(value: vec2f) -> vec2f {","  let minimum = vec2f(bounds[boundsOffset], bounds[boundsOffset + 1u]) * 0.5;","  let maximum = vec2f(bounds[boundsOffset + 2u], bounds[boundsOffset + 3u]) * 0.5;","  let extent = maximum - minimum;","  return vec2f(normalizeCoordinate(value.x, minimum.x, extent.x), normalizeCoordinate(value.y, minimum.y, extent.y));","fn finitePoint(value: vec2f) -> bool { return all((bitcast<vec2u>(value) & vec2u(0x7f800000u)) != vec2u(0x7f800000u)); }","  _ = &bounds;","  _ = &normalized;","  let value = vec2f(references[referencesOffset + index * 2u], references[referencesOffset + index * 2u + 1u]);","      if (!finitePoint(value)) { atomicOr(&candidates[candidatesOffset], 1u); }","      let mapped = select(vec2f(-1.0), normalizePoint(value), finitePoint(value));","      normalized[normalizedOffset + index * 2u] = mapped.x;","      normalized[normalizedOffset + index * 2u + 1u] = mapped.y;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const lineOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> lineOffsets: array<u32>;","@group(0) @binding(2) var<storage, read> bounds: array<f32>;","const cellOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> cellOffsets: array<u32>;","const objectIdsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> objectIds: array<u32>;","@group(0) @binding(5) var<storage, read_write> candidates: array<u32>;","const CANDIDATE_CAPACITY: u32 = 1024u;","const GRID_WIDTH: u32 = 256u;","const TOLERANCE: f32 = 0.20000000298023224;","  _ = &positions;","  _ = &lineOffsets;","  _ = &cellOffsets;","  _ = &objectIds;","  if (index >= candidates[candidatesOffset + 2u]) { return; }","      let record = candidatesOffset + 3u + index * (CANDIDATE_CAPACITY + 2u);","      let rowCount = (arrayLength(&positions) - positionsOffset) / 2u;","      let first = min(lineOffsets[lineOffsetsOffset + candidates[candidatesOffset + 1u] + index], rowCount);","      let last = min(lineOffsets[lineOffsetsOffset + candidates[candidatesOffset + 1u] + index + 1u], rowCount);","      var minimum = vec2f(1.0); var maximum = vec2f(0.0);","      for (var row = first; row < last; row++) {","        let value = vec2f(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]);","        // An invalid line cannot be snapped. Do not report candidate capacity loss for it.","        if (!finitePoint(value)) { candidates[record] = 0u; candidates[record + 1u] = 0u; return; }","        // Endpoints may move by tolerance before insertion, so the conservative radius is twice","        // tolerance. Add in half units to avoid overflowing the literal or multiplication.","        // Cover f32 rounding in snapping and convex interpolation too. Otherwise a reference","        // one ulp outside a very narrow line box can pass the exact kernel's rounded predicate.","        let roundingMargin = max(abs(value), vec2f(TOLERANCE)) * 9.5367431640625e-7 + vec2f(1.175494351e-38);","        let low = normalizePoint(value - vec2f(TOLERANCE) - vec2f(TOLERANCE) - roundingMargin);","        let high = normalizePoint(value + vec2f(TOLERANCE) + vec2f(TOLERANCE) + roundingMargin);","        minimum = min(minimum, low); maximum = max(maximum, high);","        if (!finitePoint(low) || !finitePoint(high)) { minimum = vec2f(0.0); maximum = vec2f(1.0); }","      }","      let lowerCell = vec2u(max(vec2f(0.0), floor(minimum * f32(GRID_WIDTH)) - vec2f(1.0)));","      let upperCell = vec2u(min(vec2f(f32(GRID_WIDTH - 1u)), floor(maximum * f32(GRID_WIDTH)) + vec2f(1.0)));","      var required = 0u;","      if (last > first) {","        for (var vertical = lowerCell.y; vertical <= upperCell.y; vertical++) {","          for (var horizontal = lowerCell.x; horizontal <= upperCell.x; horizontal++) {","            let cell = vertical * GRID_WIDTH + horizontal;","            let start = cellOffsets[cellOffsetsOffset + cell];","            let end = cellOffsets[cellOffsetsOffset + cell + 1u];","            let available = min(end - start, CANDIDATE_CAPACITY - min(required, CANDIDATE_CAPACITY));","            for (var slot = 0u; slot < available; slot++) {","              candidates[record + 2u + required + slot] = objectIds[objectIdsOffset + start + slot];","            }","            required += min(end - start, 0xffffffffu - required);","          }","        }","      candidates[record] = required;","      candidates[record + 1u] = select(0u, 1u, required > CANDIDATE_CAPACITY);","@group(0) @binding(1) var<storage, read_write> candidates: array<u32>;","fn referencePoint(row: u32) -> vec2f { return vec2f(references[referencesOffset + row * 2u], references[referencesOffset + row * 2u + 1u]); }","let record = candidatesOffset + 3u + index * (CANDIDATE_CAPACITY + 2u);","if (candidates[candidatesOffset] != 0u || candidates[record + 1u] != 0u) { return; }","let required = candidates[record];","var written = 0u;","for (var slot = 0u; slot < required; slot++) {","  let row = candidates[record + 2u + slot];","  let point = referencePoint(row);","  var duplicate = false;","  for (var other = 0u; other < required; other++) {","    let earlierRow = candidates[record + 2u + other];","    if (earlierRow < row && all(referencePoint(earlierRow) == point)) { duplicate = true; break; }","  // Compaction only overwrites an earlier slot. Every coordinate's minimum source row remains","  // in the prefix or the unread suffix, so duplicate decisions retain the original row tie break.","  if (!duplicate) { candidates[record + 2u + written] = row; written++; }","candidates[record] = written;","@group(0) @binding(2) var<storage, read> references: array<f32>;","@group(0) @binding(3) var<storage, read> candidates: array<u32>;","const outPositionsOffset: u32 = 