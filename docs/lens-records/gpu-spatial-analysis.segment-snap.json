:"gpu-spatial-analysis-segment-snap-snapshots-validity-0","name":"validity","iteration":0,"elementType":"u32","values":"b64:AAAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-segment-snap-compiled","resource":"validity","meaning":"gpu-spatial-analysis-segment-snap-snapshot-tap","role":"output"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const lineOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> lineOffsets: array<u32>;","const referencesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> references: array<f32>;","const outPositionsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> outPositions: array<f32>;","const sourceEdgesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> sourceEdges: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> counts: array<u32>;","const validityOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> validity: array<u32>;","const CAPACITY: u32 = 6u;","const REFERENCE_COUNT: u32 = 2u;","const TOLERANCE: f32 = 0.20000000298023224;","fn point(row: u32) -> vec2f { return vec2f(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]); }","fn reference(vertex: u32) -> vec2f { return vec2f(references[referencesOffset + vertex * 2u], references[referencesOffset + vertex * 2u + 1u]); }","fn finitePoint(value: vec2f) -> bool { return all((bitcast<vec2u>(value) & vec2u(0x7f800000u)) != vec2u(0x7f800000u)); }","fn snapPoint(value: vec2f) -> vec2f {","  var result = value; var minimum = TOLERANCE; var found = false;","  for (var candidate = 0u; candidate < REFERENCE_COUNT; candidate++) {","    let distance = length(reference(candidate) - value);","    if (distance <= TOLERANCE && (!found || distance < minimum)) { result = reference(candidate); minimum = distance; found = true; }","  }","  return result;","}","fn writeVertex(line: u32, slot: u32, value: vec2f, edge: u32) {","  if (slot >= CAPACITY) { return; }","  let destination = line * CAPACITY + slot;","  outPositions[outPositionsOffset + destination * 2u] = value.x;","  outPositions[outPositionsOffset + destination * 2u + 1u] = value.y;","  sourceEdges[sourceEdgesOffset + destination] = edge;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &lineOffsets;","  _ = &references;","  _ = &outPositions;","  _ = &sourceEdges;","  _ = &counts;","  _ = &validity;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let first = min(lineOffsets[lineOffsetsOffset + index], 2u);","let last = min(lineOffsets[lineOffsetsOffset + index + 1u], 2u);","var required = 0u;","var invalid = false;","for (var candidate = 0u; candidate < REFERENCE_COUNT; candidate++) { invalid = invalid || !finitePoint(reference(candidate)); }","for (var vertex = first; vertex < last; vertex++) { invalid = invalid || !finitePoint(point(vertex)); }","if (!invalid && last > first) {","  var start = snapPoint(point(first));","  writeVertex(index, required, start, first); required++;","  for (var vertex = first; vertex + 1u < last; vertex++) {","    let end = snapPoint(point(vertex + 1u));","    let edge = end - start; let denominator = dot(edge, edge);","    var previousFraction = 0.0; var previousReference = 0xffffffffu;","    var previousPoint = start;","    if (denominator > 0.0) {","      for (var inserted = 0u; inserted < REFERENCE_COUNT; inserted++) {","        var winner = 0xffffffffu; var winnerFraction = 2.0;","        for (var candidate = 0u; candidate < REFERENCE_COUNT; candidate++) {","          let current = reference(candidate);","          var duplicate = false;","          for (var earlier = 0u; earlier < candidate; earlier++) {","            if (all(reference(earlier) == current)) { duplicate = true; break; }","          }","          if (duplicate) { continue; }","          let fraction = dot(current - start, edge) / denominator;","          if (fraction <= 0.0 || fraction >= 1.0 || length(current - (start + fraction * edge)) > TOLERANCE) { continue; }","          if (fraction < previousFraction || (fraction == previousFraction && candidate <= previousReference)) { continue; }","          if (fraction < winnerFraction || (fraction == winnerFraction && candidate < winner)) { winner = candidate; winnerFraction = fraction; }","        }","        if (winner == 0xffffffffu) { break; }","        let current = reference(winner);","        if (any(current != previousPoint)) { writeVertex(index, required, current, vertex); required++; previousPoint = current; }","        previousFraction = winnerFraction; previousReference = winner;","      }","    }","    if (any(end != previousPoint)) { writeVertex(index, required, end, vertex); required++; }","    start = end;","counts[countsOffset + index * 4u] = min(required, CAPACITY);","counts[countsOffset + index * 4u + 1u] = required;","counts[countsOffset + index * 4u + 2u] = select(0u, 1u, required > CAPACITY);","counts[countsOffset + index * 4u + 3u] = select(0u, 1u, invalid);","validity[validityOffset + index] = select(0u, 1u, required == 1u) | select(0u, 2u, invalid) | select(0u, 4u, required > CAPACITY);"],"strings":["gpu-spatial-analysis-segment-snap-snapshot-tap","segment-snap-insert","buffer","counts","imported","validity","snapped-positions","source-edges","positions","references","line-offsets","read_write","read