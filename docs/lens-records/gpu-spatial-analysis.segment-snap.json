}","  let destination = line * CAPACITY + slot;","  outPositions[outPositionsOffset + destination * 2u] = value.x;","  outPositions[outPositionsOffset + destination * 2u + 1u] = value.y;","  sourceEdges[sourceEdgesOffset + destination] = edge;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &lineOffsets;","  _ = &references;","  _ = &outPositions;","  _ = &sourceEdges;","  _ = &counts;","  _ = &validity;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let first = min(lineOffsets[lineOffsetsOffset + index], 2u);","let last = min(lineOffsets[lineOffsetsOffset + index + 1u], 2u);","var required = 0u;","var invalid = false;","for (var candidate = 0u; candidate < REFERENCE_COUNT; candidate++) { invalid = invalid || !finitePoint(reference(candidate)); }","for (var vertex = first; vertex < last; vertex++) { invalid = invalid || !finitePoint(point(vertex)); }","if (!invalid && last > first) {","  var start = snapPoint(point(first));","  writeVertex(index, required, start, first); required++;","  for (var vertex = first; vertex + 1u < last; vertex++) {","    let end = snapPoint(point(vertex + 1u));","    let edge = end - start; let denominator = dot(edge, edge);","    var previousFraction = 0.0; var previousReference = 0xffffffffu;","    var previousPoint = start;","    if (denominator > 0.0) {","      for (var inserted = 0u; inserted < REFERENCE_COUNT; inserted++) {","        var winner = 0xffffffffu; var winnerFraction = 2.0;","        for (var candidate = 0u; candidate < REFERENCE_COUNT; candidate++) {","          let current = reference(candidate);","          var duplicate = false;","          for (var earlier = 0u; earlier < candidate; earlier++) {","            if (all(reference(earlier) == current)) { duplicate = true; break; }","          }","          if (duplicate) { continue; }","          let fraction = dot(current - start, edge) / denominator;","          if (fraction <= 0.0 || fraction >= 1.0 || length(current - (start + fraction * edge)) > TOLERANCE) { continue; }","          if (fraction < previousFraction || (fraction == previousFraction && candidate <= previousReference)) { continue; }","          if (fraction < winnerFraction || (fraction == winnerFraction && candidate < winner)) { winner = candidate; winnerFraction = fraction; }","        }","        if (winner == 0xffffffffu) { break; }","        let current = reference(winner);","        if (any(current != previousPoint)) { writeVertex(index, required, current, vertex); required++; previousPoint = current; }","        previousFraction = winnerFraction; previousReference = winner;","      }","    }","    if (any(end != previousPoint)) { writeVertex(index, required, end, vertex); required++; }","    start = end;","counts[countsOffset + index * 4u] = min(required, CAPACITY);","counts[countsOffset + index * 4u + 1u] = required;","counts[countsOffset + index * 4u + 2u] = select(0u, 1u, required > CAPACITY);","counts[countsOffset + index * 4u + 3u] = select(0u, 1u, invalid);","validity[validityOffset + index] = select(0u, 1u, required == 1u) | select(0u, 2u, invalid) | select(0u, 4u, required > CAPACITY);"],"strings":["segment-snap-insert","buffer","imported","counts","validity","positions","read_write","references","snapped-positions","source-edges","line-offsets","read","GPUSegmentSnap"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroup