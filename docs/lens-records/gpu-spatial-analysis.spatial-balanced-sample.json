= keyIn;","  for (var roundIndex = 0u; roundIndex < 9u; roundIndex = roundIndex + 1u) {","    counter = philoxRound(counter, key);","    key = key + vec2<u32>(2654435769u, 3144134277u);","  }","  return philoxRound(counter, key);","fn philoxUnitFloat(word: u32) -> f32 {","  return f32(word >> 8u) * (1.0 / 16777216.0);","fn random(counter: vec4<u32>) -> u32 { return philox4x32(counter, vec2<u32>(7u, 1396855632u)).x; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &codes;","  _ = &validity;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let point = vec2<f32>(positions[positionsOffset + 2u * index], positions[positionsOffset + 2u * index + 1u]);","  let minimum = vec2<f32>(0f, 0f);","  let maximum = vec2<f32>(1f, 1f);","  let valid = isFiniteFloat(point.x) && isFiniteFloat(point.y) && all(point >= minimum) && all(point <= maximum) && (stratum(index) == 0u);","  validity[validityOffset + index] = select(0u, 1u, valid);","  var code = 0u;","  if (valid) {","    let normalizationScale = vec2<f32>(1f, 1f);","    let coordinate = vec2<u32>(clamp((point * normalizationScale - minimum * normalizationScale) / (maximum * normalizationScale - minimum * normalizationScale), vec2<f32>(0.0), vec2<f32>(1.0)) * 65535.0);","    var prefix = 0u;","    for (var level = 0u; level < 16u; level++) {","      let shift = 15u - level;","      let child = ((coordinate.x >> shift) & 1u) | (((coordinate.y >> shift) & 1u) << 1u);","      let rotation = random(vec4<u32>(prefix, (stratum(index) << 4u) | level, 0u, 0u)) & 3u;","      code = (code << 2u) | ((child + rotation) & 3u);","      prefix = (prefix << 2u) | child;","    }","  codes[codesOffset + index] = code;","@group(0) @binding(0) var<storage, read> codes: array<u32>;","const ranksOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> ranks: array<u32>;","fn ticket(row: u32) -> u32 { return 1u; }","  _ = &ranks;","  var rank = 0u;","  let code = codes[codesOffset + index];","  for (var other = 0u; other < 4u; other++) {","    let otherCode = codes[codesOffset + other];","    if (stratum(other) == stratum(index) && (otherCode < code || (otherCode == code && other < index))) { rank = min(16777217u, rank + min(ticket(other), 16777217u)); }","  ranks[ranksOffset + index] = rank;","@group(0) @binding(0) var<storage, read> ranks: array<u32>;","@group(0) @binding(1) var<storage, read> validity: array<u32>;","const selectedOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> selected: array<u32>;","const probabilitiesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> probabilities: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","  _ = &selected;","  _ = &probabilities;","  _ = &status;","  var frameCount = 0u;","  var ticketTotal = 0u;","  var maximumTicket = 0u;","  var valid = true;","  for (var row = 0u; row < 4u; row++) {","    valid = valid && validity[validityOffset + row] == 1u;","    if (stratum(row) == 0u) {","      frameCount++;","      let value = ticket(row);","      valid = valid && value > 0u && value <= 16777216u - min(ticketTotal, 16777216u);","      ticketTotal = min(16777217u, ticketTotal + min(value, 16777217u));","      maximumTicket = max(maximumTicket, value);","  valid = valid && frameCount >= 2u;","  let drawLimit = frameCount;","  var shift = 0u;","  var found = false;","    let threshold = (0u - drawLimit) % drawLimit;","    for (var attempt = 0u; attempt < 128u; attempt++) {","      let draw = random(vec4<u32>(0u, 0x80000000u | attempt, 0u, 0u));","      if (draw >= threshold) { shift = draw % drawLimit; found = true; break; }","  for (var sample = 0u; sample < 2u; sample++) {","    let slot = 0u + sample;","    selected[selectedOffset + slot] = 0xffffffffu;","    probabilities[probabilitiesOffset + slot] = bitcast<f32>(0x7fc00000u | (index & 0u));","    if (!valid || !found) { continue; }","    let targetRank = (shift + sample * frameCount / 2u) % frameCount;","    for (var row = 0u; row < 4u; row++) {","      let first = ranks[ranksOffset + row];","      if (stratum(row) == 0u && first <= targetRank && targetRank < first + ticket(row)) {","        selected[selectedOffset + slot] = row;","        probabilities[probabilitiesOffset + slot] = 2.0 / f32(frameCount);","      }","  status[statusOffset + 0u] = select(0u, 2u, valid && found);","  status[statusOffset + 1u] = select(1u, select(2u, 0u, found), valid);","@group(0) @binding(0) var<storage, read> selected: array<u32>;","@group(0) @binding(1) var<storage, read> probabilities: array<f32>;","const frameIdsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> frameIds: array<u32>;","const idsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> ids: array<u32>;","const inclusionOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> inclusion: array<f32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> weights: array<f32>;","  _ = &frameIds;","  _ = &ids;","  _ = &inclusion;","  _ = &weights;","  let row = selected[selectedOffset + index];","  var frameId = 0xffffffffu;","  if (row != 0xffffffffu) { frameId = frameIds[frameIdsOffset + row]; }","  let probability = probabilities[probabilitiesOffset + index];","  ids[idsOffset + index] = frameId;","  inclusion[inclusionOffset + index] = probability;","  weights[weightsOffset + index] = 1.0 / probability;"],"strings":["spatial-balanced-sample-publish","spatial-balanced-sample-select-0","buffer","read_write","GPUSpatialBalancedSample","spatial-balanced-sampl