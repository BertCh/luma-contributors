ion-compiled","resource":"statistics-output-6","afterNode":"spatial-cross-validation-counts","role":"output"},{"id":"gpu-spatial-analysis-spatial-cross-validation-snapshots-status-0","name":"status","iteration":0,"elementType":"u32","values":"b64:AAAAAAAAAAAAAAAA","provenance":"gpu-readback","graph":"gpu-spatial-analysis-spatial-cross-validation-compiled","resource":"statistics-output-7","afterNode":"spatial-cross-validation-counts","role":"output"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const blocksOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> blocks: array<u32>;","const maskOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> mask: array<u32>;","const foldsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> folds: array<u32>;","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","fn hashUint32(value: u32) -> u32 {","  var x = value;","  x = x ^ (x >> 16u);","  x = x * 0x7feb352du;","  x = x ^ (x >> 15u);","  x = x * 0x846ca68bu;","  return x;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &blocks;","  _ = &mask;","  _ = &folds;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let position = vec2<f32>(positions[positionsOffset + index * 2u], positions[positionsOffset + index * 2u + 1u]);","var fold = 0xffffffffu;","if (isFiniteBits(position.x) && isFiniteBits(position.y) && mask[maskOffset + index] != 0u) {","  let key = hashUint32(blocks[blocksOffset + index] ^ 17u);","  fold = key % 3u;","folds[foldsOffset + index] = fold;","@group(0) @binding(1) var<storage, read> folds: array<u32>;","const trainingOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> training: array<u32>;","const testingOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> testing: array<u32>;","@compute @workgroup_size(128)","  _ = &training;","  _ = &testing;","  if (workgroupIndex >= 33554432u) { return; }","  let index = workgroupIndex * 128u + localInvocationIndex;","  let fold = index / 24u;","let row = index % 24u;","let assigned = folds[foldsOffset + row];","let test = assigned == fold;","var train = assigned < 3u && !test;","if (train) {","  let position = vec2<f32>(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]);","  for (var other = 0u; other < 24u; other++) {","    if (folds[foldsOffset + other] == fold) {","      let difference = position - vec2<f32>(positions[positionsOffset + other * 2u], positions[positionsOffset + other * 2u + 1u]);","      if (dot(difference, difference) <= 0.0625) { train = false; break; }","    }","training[trainingOffset + index] = select(0u, 1u, train);","testing[testingOffset + index] = select(0u, 1u, test);","@group(0) @binding(0) var<storage, read> folds: array<u32>;","@group(0) @binding(1) var<storage, read> training: array<u32>;","@group(0) @binding(2) var<storage, read> testing: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> counts: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","  _ = &counts;","  _ = &status;","  var train = 0u; var test = 0u; var valid = 0u;","for (var row = 0u; row < 24u; row++) {"," train += training[trainingOffset + index * 24u + row]; test += testing[testingOffset + index * 24u + row]; valid += select(0u, 1u, folds[foldsOffset + row] < 3u);","counts[countsOffset + 3u * index] = train;","counts[countsOffset + 3u * index + 1u] = test;","counts[countsOffset + 3u * index + 2u] = valid - train - test;","status[statusOffset + index] = select(0u, 1u, train == 0u) | select(0u, 2u, test == 0u);"],"strings":["spatial-cross-validation-counts","buffer","imported","spatial-cross-validation-assign","statistics-output-3","read","spatial-cross-validation-masks","statistics-output-4","statistics-output-5","GPUSpatialCrossValidation","read_write","statistics-input-0","statistics-output-6","statistics-output-7","compute","folds","spatial-cross-validation","statistics-input-1","statistics-input-2","counts","positions","testing","training"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership"],["id","kind","bytes","ownership","firstNode","lastNode"]],"lists":[["~:2","~f","~4","~5","u32",0,24],["~:2","~k","~b","~5","f32",0,24]]}}
