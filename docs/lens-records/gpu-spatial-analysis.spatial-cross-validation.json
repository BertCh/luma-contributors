CH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const maskOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> mask: array<u32>;","const blocksOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> blocks: array<u32>;","const blockOrderOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> blockOrder: array<u32>;","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","}","fn isUsableRow(row: u32) -> bool {","  return isFiniteBits(positions[positionsOffset + row * 2u]) &&","    isFiniteBits(positions[positionsOffset + row * 2u + 1u]) && mask[maskOffset + row] != 0u;","fn philoxMulHiLo(a: u32, b: u32) -> vec2<u32> {","  let aLow = a & 0xffffu;","  let aHigh = a >> 16u;","  let bLow = b & 0xffffu;","  let bHigh = b >> 16u;","  let lowLow = aLow * bLow;","  let highLow = aHigh * bLow;","  let lowHigh = aLow * bHigh;","  let highHigh = aHigh * bHigh;","  let middle = (lowLow >> 16u) + (highLow & 0xffffu) + (lowHigh & 0xffffu);","  let high = highHigh + (highLow >> 16u) + (lowHigh >> 16u) + (middle >> 16u);","  return vec2<u32>(high, a * b);","fn philoxRound(counter: vec4<u32>, key: vec2<u32>) -> vec4<u32> {","  let product0 = philoxMulHiLo(3528531795u, counter.x);","  let product1 = philoxMulHiLo(3449720151u, counter.z);","  return vec4<u32>(","    product1.x ^ counter.y ^ key.x,","    product1.y,","    product0.x ^ counter.w ^ key.y,","    product0.y","  );","fn philox4x32(counterIn: vec4<u32>, keyIn: vec2<u32>) -> vec4<u32> {","  var counter = counterIn;","  var key = keyIn;","  for (var roundIndex = 0u; roundIndex < 9u; roundIndex = roundIndex + 1u) {","    counter = philoxRound(counter, key);","    key = key + vec2<u32>(2654435769u, 3144134277u);","  }","  return philoxRound(counter, key);","fn philoxUnitFloat(word: u32) -> f32 {","  return f32(word >> 8u) * (1.0 / 16777216.0);","// Uniform in the open interval (0, 1), for log() and inverse-CDF draws. The top 23 bits plus one","// half are exact in f32, so the result lies in [2^-24, 1 - 2^-24] and neither end is reachable.","// (The 24-bit form (f32(word >> 8u) + 0.5) / 16777216.0 rounds to exactly 1.0 for the largest word.)","fn philoxOpenUnitFloat(word: u32) -> f32 {","  return (f32(word >> 9u) + 0.5) * (1.0 / 8388608.0);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &mask;","  _ = &blocks;","  _ = &blockOrder;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var key = 0u;","var representative = 0u;","if (isUsableRow(index)) {","  let blockId = blocks[blocksOffset + index];","  let random = philox4x32(vec4<u32>(blockId, 0u, 0u, 0u), vec2<u32>(17u, 1179601988u));","  key = random.x;","  representative = 1u;","  for (var other = 0u; other < index; other++) {","    if (blocks[blocksOffset + other] == blockId && isUsableRow(other)) { representative = 0u; break; }","blockOrder[blockOrderOffset + 2u * index] = key;","blockOrder[blockOrderOffset + 2u * index + 1u] = representative;","@group(0) @binding(3) var<storage, read> blockOrder: array<u32>;","const foldsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> folds: array<u32>;","  _ = &folds;","  var fold = 0xffffffffu;","  let key = blockOrder[blockOrderOffset + 2u * index];","  // Rank of this block among the blocks that hold a usable row, by (key, block id).","  var rank = 0u;","  for (var other = 0u; other < 24u; other++) {","    if (blockOrder[blockOrderOffset + 2u * other + 1u] != 0u) {","      let otherKey = blockOrder[blockOrderOffset + 2u * other];","      if (otherKey < key || (otherKey == key && blocks[blocksOffset + other] < blockId)) { rank++; }","    }","  fold = rank % 3u;","folds[foldsOffset + index] = fold;","@group(0) @binding(1) var<storage, read> folds: array<u32>;","const trainingOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> training: array<u32>;","const testingOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> testing: array<u32>;","const VALIDATION_CONFIGURED_RADIUS_SQUARED: array<u32, 36> = array<u32, 36>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 64u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);","fn validationSameCoordinate(first: f32, second: f32) -> bool {","  let firstBits = bitcast<u32>(first); let secondBits = bitcast<u32>(second);","  return firstBits == secondBits || ((firstBits | secondBits) & 0x7fffffffu) == 0u;","fn validationMagnitude(bits: u32) -> array<u32, 18> {","  var words: array<u32, 18>;","  let exponent = (bits >> 23u) & 255u;","  let mantissa = (bits & 0x7fffffu) | select(0u, 0x800000u, exponent != 0u);","  let shift = select(0u, exponent - 1u, exponent != 0u);","  for (var bit = 0u; bit < 24u; bit++) {","    let destination = shift + bit;","    words[destination / 16u] |= ((mantissa >> bit) & 1u) << (destination % 16u);","  return words;","fn validationDifference(first: f32, second: f32) -> array<u32, 18> {","  let firstBits = bitcast<u32>(first);","  let secondBits = bitcast<u32>(second);","  let firstMagnitude = firstBits & 0x7fffffffu;","  let secondMagnitude = secondBits & 0x7fffffffu;","  let larger = validationMagnitude(max(firstMagnitude, secondMagnitude));","  let smaller = validationMagnitude(min(firstMagnitude, secondMagnitude));","  let add = ((firstBits ^ secondBits) & 0x80000000u) != 0u;","  var difference: array<u32, 18>;","  var carry = 0u;","  for (var limb = 0u; limb < 18u; limb++) {","    if (add) {","      let total = larger[limb] + smaller[limb] + carry;","      difference[limb] = total & 65535u;","      carry = total >> 16u;","    } else {","      let subtrahend = smaller[limb] + carry;","      difference[limb] = (larger[limb] - subtrahend) & 65535u;","      carry = u32(larger[limb] < subtrahend);","  return difference;","fn validationSquare(value: array<u32, 18>) -> array<u32, 36> {","  var result: array<u32, 36>;","  for (var first = 0u; first < 18u; first++) {","    var carry = 0u;","    for (var second = 0u; second < 18u; second++) {","      let product = value[first] * value[second];","      let low = (product & 65535u) + result[first + second] + (carry & 65535u);","      result[first + second] = low & 65535u;","      carry = (product >> 16u) + (carry >> 16u) + (low >> 16u);","    result[first + 18u] = carry;","  return result;","fn isWithinValidationRadius(first: vec2<f32>, second: vec2<f32>, adaptiveRadius: f32) -> bool {","  ","  let radius = max(adaptiveRadius, 0.25f);","  let difference = first - second;","  let squared = dot(difference, difference);","  let threshold = radius * radius;","  // Only use normal, finite arithmetic here. The integer fallback also covers zero, overflow","  // and subnormal products. The margin covers both subtractions, products and the addition.","  let squaredBits = bitcast<u32>(squared);","  let thresholdBits = bitcast<u32>(threshold);","  let horizontalSafe = validationSameCoordinate(first.x, second.x) || (bitcast<u32>(difference.x) & 0x7fffffffu) >= 0x20000000u;","  let verticalSafe = validationSameCoordinate(first.y, second.y) || (bitcast<u32>(difference.y) & 0x7fffffffu) >= 0x20000000u;","  if (horizontalSafe && verticalSafe && squaredBits >= 0x00800000u && squaredBits < 0x7f800000u &&","      thresholdBits >= 0x00800000u && thresholdBits < 0x7f800000u) {","    if (squared < threshold * 0.9999990463256836) { return true; }","    if (squared > threshold * 1.0000009536743164) { return false; }","  let horizontal = validationSquare(validationDifference(first.x, second.x));","  let vertical = validationSquare(validationDifference(first.y, second.y));","  var limit = validationSquare(validationMagnitude(bitcast<u32>(adaptiveRadius) & 0x7fffffffu));","  for (var remaining = 36u; remaining > 0u; remaining--) {","    let limb = remaining - 1u;","    if (limit[limb] != VALIDATION_CONFIGURED_RADIUS_SQUARED[limb]) {","      if (limit[limb] < VALIDATION_CONFIGURED_RADIUS_SQUARED[limb]) {","        for (var copy = 0u; copy < 36u; copy++) { limit[copy] = VALIDATION_CONFIGURED_RADIUS_SQUARED[copy]; }","      }","      break;","  var total: array<u32, 36>;","  for (var limb = 0u; limb < 36u; limb++) {","    let sum = horizontal[limb] + vertical[limb] + carry;","    total[limb] = sum & 65535u;","    carry = sum >> 16u;","    if (total[limb] != limit[limb]) { return total[limb] < limit[limb]; }","  return true;","fn validationDistanceSquare(first: vec2<f32>, second: vec2<f32>) -> array<u32, 36> {","  var result: array<u32, 36>; var carry = 0u;","    let total = horizontal[limb] + vertical[limb] + carry;","    result[limb] = total & 65535u; carry = total >> 16u;","fn isWithinValidationNeighbor(point: vec2<f32>, center: vec2<f32>, neighbor: vec2<f32>) -> bool {","  if (validationSameCoordinate(point.x, neighbor.x) && validationSameCoordinate(point.y, neighbor.y)) { return true; }","  let squared = validationDistanceSquare(point, center);","  let limit = validationDistanceSquare(neighbor, center);","    if (squared[limb] != limit[limb]) { return squared[limb] < limit[limb]; }","fn isValidationNeighborCloser(point: vec2<f32>, center: vec2<f32>, neighbor: vec2<f32>) -> bool {","  let first=distance(point,center);let second=distance(neighbor,center);","  if(first>1e-18 && second>1e-18 && first<1e18 && second<1e18){","    if(first<second*(1.0-0.000001)){return true;}","    if(first>second*(1.0+0.000001)){return false;}","  let squared=validationDistanceSquare(point,center);","  let limit=validationDistanceSquare(neighbor,center);","  for(var remaining=36u;remaining>0u;remaining--){","    let limb=remaining-1u;","    if(squared[limb]!=limit[limb]){return squared[limb]<limit[limb];}","  return false;","@compute @workgroup_size(128)","  _ = &training;","  _ = &testing;","  if (workgroupIndex >= 33554432u) { return; }","  let index = workgroupIndex * 128u + localInvocationIndex;","  let fold = index / 24u;","let row = index % 24u;","let assigned = folds[foldsOffset + row];","let test = assigned == fold;","var train = assigned < 3u && !test;","if (train) {","  let position = vec2<f32>(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]);","    if (folds[foldsOffset + other] == fold) {","      let otherPosition = vec2<f32>(positions[positionsOffset + other * 2u], positions[positionsOffset + other * 2u + 1u]);","      if (isWithinValidationRadius(position, otherPosition, 0.0)) { train = false; break; }","      ","training[trainingOffset + index] = select(0u, 1u, train);","testing[testingOffset + index] = select(0u, 1u, test);","@group(0) @binding(0) var<storage, read> folds: array<u32>;","@group(0) @binding(1) var<storage, read> training: array<u32>;","@group(0) @binding(2) var<storage, read> testing: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> counts: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","  _ = &counts;","  _ = &status;","  var train = 0u; var test = 0u; var valid = 0u;","for (var row = 0u; row < 24u; row++) {"," train += training[trainingOffset + index * 24u + row]; test += testing[testingOffset + index * 24u + row]; valid += select(0u, 1u, folds[foldsOffset + row] < 3u);","counts[countsOffset + 3u * index] = train;","counts[countsOffset + 3u * index + 1u] = test;","counts[countsOffset + 3u * index + 2u] = valid - train - test;","status[statusOffset + index] = select(0u, 1u, train == 0u) | select(0u, 2u, test == 0u);"],"strings":["gpu-spatial-analysis-spatial-cross-validation-snapshot-tap"