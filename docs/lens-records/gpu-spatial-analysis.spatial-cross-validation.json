u32) -> bool {","  return isFiniteBits(positions[positionsOffset + row * 2u]) &&","    isFiniteBits(positions[positionsOffset + row * 2u + 1u]) && mask[maskOffset + row] != 0u;","fn philoxMulHiLo(a: u32, b: u32) -> vec2<u32> {","  let aLow = a & 0xffffu;","  let aHigh = a >> 16u;","  let bLow = b & 0xffffu;","  let bHigh = b >> 16u;","  let lowLow = aLow * bLow;","  let highLow = aHigh * bLow;","  let lowHigh = aLow * bHigh;","  let highHigh = aHigh * bHigh;","  let middle = (lowLow >> 16u) + (highLow & 0xffffu) + (lowHigh & 0xffffu);","  let high = highHigh + (highLow >> 16u) + (lowHigh >> 16u) + (middle >> 16u);","  return vec2<u32>(high, a * b);","fn philoxRound(counter: vec4<u32>, key: vec2<u32>) -> vec4<u32> {","  let product0 = philoxMulHiLo(3528531795u, counter.x);","  let product1 = philoxMulHiLo(3449720151u, counter.z);","  return vec4<u32>(","    product1.x ^ counter.y ^ key.x,","    product1.y,","    product0.x ^ counter.w ^ key.y,","    product0.y","  );","fn philox4x32(counterIn: vec4<u32>, keyIn: vec2<u32>) -> vec4<u32> {","  var counter = counterIn;","  var key = keyIn;","  for (var roundIndex = 0u; roundIndex < 9u; roundIndex = roundIndex + 1u) {","    counter = philoxRound(counter, key);","    key = key + vec2<u32>(2654435769u, 3144134277u);","  }","  return philoxRound(counter, key);","fn philoxUnitFloat(word: u32) -> f32 {","  return f32(word >> 8u) * (1.0 / 16777216.0);","// Uniform in the open interval (0, 1), for log() and inverse-CDF draws. The top 23 bits plus one","// half are exact in f32, so the result lies in [2^-24, 1 - 2^-24] and neither end is reachable.","// (The 24-bit form (f32(word >> 8u) + 0.5) / 16777216.0 rounds to exactly 1.0 for the largest word.)","fn philoxOpenUnitFloat(word: u32) -> f32 {","  return (f32(word >> 9u) + 0.5) * (1.0 / 8388608.0);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &mask;","  _ = &blocks;","  _ = &blockOrder;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var key = 0u;","var representative = 0u;","if (isUsableRow(index)) {","  let blockId = blocks[blocksOffset + index];","  let random = philox4x32(vec4<u32>(blockId, 0u, 0u, 0u), vec2<u32>(17u, 1179601988u));","  key = random.x;","  representative = 1u;","  for (var other = 0u; other < index; other++) {","    if (blocks[blocksOffset + other] == blockId && isUsableRow(other)) { representative = 0u; break; }","blockOrder[blockOrderOffset + 2u * index] = key;","blockOrder[blockOrderOffset + 2u * index + 1u] = representative;","@group(0) @binding(3) var<storage, read> blockOrder: array<u32>;","const foldsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> folds: array<u32>;","  _ = &folds;","  var fold = 0xffffffffu;","  let key = blockOrder[blockOrderOffset + 2u * index];","  // Rank of this block among the blocks that hold a usable row, by (key, block id).","  var rank = 0u;","  for (var other = 0u; other < 24u; other++) {","    if (blockOrder[blockOrderOffset + 2u * other + 1u] != 0u) {","      let otherKey = blockOrder[blockOrderOffset + 2u * other];","      if (otherKey < key || (otherKey == key && blocks[blocksOffset + other] < blockId)) { rank++; }","    }","  fold = rank % 3u;","folds[foldsOffset + index] = fold;","@group(0) @binding(1) var<storage, read> folds: array<u32>;","const trainingOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> training: array<u32>;","const testingOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> testing: array<u32>;","@compute @workgroup_size(128)","  _ = &training;","  _ = &testing;","  if (workgroupIndex >= 33554432u) { return; }","  let index = workgroupIndex * 128u + localInvocationIndex;","  let fold = index / 24u;","let row = index % 24u;","let assigned = folds[foldsOffset + row];","let test = assigned == fold;","var train = assigned < 3u && !test;","if (train) {","  let position = vec2<f32>(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]);","    if (folds[foldsOffset + other] == fold) {","      let difference = position - vec2<f32>(positions[positionsOffset + other * 2u], positions[positionsOffset + other * 2u + 1u]);","      if (dot(difference, difference) <= 0.0625) { train = false; break; }","training[trainingOffset + index] = select(0u, 1u, train);","testing[testingOffset + index] = select(0u, 1u, test);","@group(0) @binding(0) var<storage, read> folds: array<u32>;","@group(0) @binding(1) var<storage, read> training: array<u32>;","@group(0) @binding(2) var<storage, read> testing: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> counts: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","  _ = &counts;","  _ = &status;","  var train = 0u; var test = 0u; var valid = 0u;","for (var row = 0u; row < 24u; row++) {"," train += training[trainingOffset + index * 24u + row]; test += testing[testingOffset + index * 24u + row]; valid += select(0u, 1u, folds[foldsOffset + row] < 3u);","counts[countsOffset + 3u * index] = train;","counts[countsOffset + 3u * index + 1u] = test;","counts[countsOffset + 3u * index + 2u] = valid - train - test;","status[statusOffset + index] = select(0u, 1u, train == 0u) | select(0u, 2u, test == 0u);"],"strings":["gpu-spatial-analysis-spatial-cross-validation-snapshot-tap","spatial-cross-validation-block-order","read","statistics-output-3","buffer","logical","spatial-cross-validation-counts","spatial-cross-validation-masks","statistics-output-4","statistics-output-5","GPUSpatialCrossValidation","imported","spat