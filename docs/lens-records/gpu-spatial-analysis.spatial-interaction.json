erride WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const coefficientsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> coefficients: array<f32>;","const bracketOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> bracket: array<f32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &coefficients;","  _ = &bracket;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let lower = -1.0; let upper = 1.0; bracket[bracketOffset] = lower; bracket[bracketOffset + 1u] = upper; coefficients[coefficientsOffset] = lower + 0.3819660112501051 * (upper - lower); coefficients[coefficientsOffset + 1u] = lower + 0.6180339887498949 * (upper - lower);","}","const originsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> origins: array<u32>;","const destinationsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> destinations: array<u32>;","const flowsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> flows: array<f32>;","const covariateOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> covariate: array<f32>;","const pairStateOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> pairState: array<u32>;","const predictionsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> predictions: array<f32>;","const diagnosticsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> diagnostics: array<f32>;","const coefficientValuesOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read> coefficientValues: array<f32>;","fn getScaledQuotient(value: f32, first: f32, second: f32, power: i32) -> f32 {","  if (value == 0.0) { return value; }","  let numerator = frexp(value);","  let firstDivisor = frexp(first);","  let secondDivisor = frexp(second);","  let quotient = frexp(numerator.fract / (firstDivisor.fract * secondDivisor.fract));","  return ldexp(quotient.fract,","    numerator.exp - firstDivisor.exp - secondDivisor.exp + power + quotient.exp);","fn getBalancedPrediction(prediction: f32, total: f32, sum: f32) -> f32 {","  if (!(sum > 0.0) || !(prediction > 0.0) || !(total > 0.0)) { return 0.0; }","  if (prediction == sum) { return total; }","  let predictionParts = frexp(prediction);","  let totalParts = frexp(total);","  let sumParts = frexp(sum);","  // Each fraction is in [0.5, 1), so this intermediate stays in [0.25, 2).","  let productParts = frexp(getScaledQuotient(predictionParts.fract * totalParts.fract, sumParts.fract, 1.0, 0));","  let exponent = predictionParts.exp + totalParts.exp - sumParts.exp + productParts.exp;","  // ldexp requires an exponent <= 128. Only an unrepresentable final result overflows.","  if (exponent > 128) { var overflowBits = 0x7f800000u; return bitcast<f32>(overflowBits); }","  if (exponent < -149) { return 0.0; }","  return ldexp(productParts.fract, exponent);","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","const COEFFICIENTS = array<f32, 2>(-1.0, 1.0);","  _ = &origins;","  _ = &destinations;","  _ = &flows;","  _ = &covariate;","  _ = &pairState;","  _ = &predictions;","  _ = &diagnostics;","  _ = &coefficientValues;","  var originTotals: array<f32, 4>; var destinationTotals: array<f32, 6>; var observed = 0.0; var largest = -3.402823e38; var smallest = 3.402823e38; var invalid = false;","for (var pair = 0u; pair < 24u; pair++) {"," let state = pairState[pairStateOffset + pair]; let flow = flows[flowsOffset + pair]; let origin = origins[originsOffset + pair]; let destination = destinations[destinationsOffset + pair];"," predictions[predictionsOffset + index * 24u + pair] = getNaN();"," if (state == 2u) { continue; } if (state > 2u || origin >= 4u || destination >= 6u || !isFiniteBits(flow) || flow < 0.0 || (state == 0u && flow != 0.0)) { invalid = true; continue; }"," if (state == 0u) { continue; } let exponent = coefficientValues[coefficientValuesOffset + index] * covariate[covariateOffset + pair]; if (!isFiniteBits(exponent)) { invalid = true; continue; }"," largest = max(largest, exponent); smallest = min(smallest, exponent); observed += flow; originTotals[origin] += flow; destinationTotals[destination] += flow;","invalid = invalid || !isFiniteBits(observed);","var code = select(0u, 2u, invalid); if (!(observed > 0.0)) { code = select(1u, 2u, invalid); }","if (code != 0u) { diagnostics[diagnosticsOffset + index * 4u] = getNaN(); diagnostics[diagnosticsOffset + index * 4u + 1u] = getNaN(); diagnostics[diagnosticsOffset + index * 4u + 2u] = 0.0; diagnostics[diagnosticsOffset + index * 4u + 3u] = f32(code + 1u); return; }","if (largest - smallest > 80.0) { diagnostics[diagnosticsOffset + index * 4u] = getNaN(); diagnostics[diagnosticsOffset + index * 4u + 1u] = getNaN(); diagnostics[diagnosticsOffset + index * 4u + 2u] = 0.0; diagnostics[diagnosticsOffset + index * 4u + 3u] = 4.0; return; }","// Each candidate invocation owns one disjoint storage slice; no pair-sized private array.","for (var pair = 0u; pair < 24u; pair++) { if (pairState[pairStateOffset + pair] == 0u) { predictions[predictionsOffset + index * 24u + pair] = 0.0; } }","var sum = 0.0;","for (var pair = 0u; pair < 24u; pair++) { if (pairState[pairStateOffset + pair] == 1u) { predictions[predictionsOffset + index * 24u + pair] = exp(coefficientValues[coefficientValuesOffset + index] * covariate[covariateOffset + pair] - largest); sum += predictions[predictionsOffset + index * 24u + pair]; } }","var error = 0.0; var iterations = 0u; var converged = false;","for (var iteration = 0u; iteration < 256u; iteration++) {","var sums: array<f32, 4>; for (var pair = 0u; pair < 24u; pair++) { if (pairState[pairStateOffset + pair] == 1u) { sums[origins[originsOffset + pair]] += predictions[predictionsOffset + index * 24u + pair]; } }","for (var pair = 0u; pair < 24u; pair++) { if (pairState[pairStateOffset + pair] == 1u) { let origin = origins[originsOffset + pair]; predictions[predictionsOffset + index * 24u + pair] = getBalancedPrediction(predictions[predictionsOffset + index * 24u + pair], originTotals[origin], sums[origin]); } }","var destinationSums: array<f32, 6>; for (var pair = 0u; pair < 24u; pair++) { if (pairState[pairStateOffset + pair] == 1u) { destinationSums[destinations[destinationsOffset + pair]] += predictions[predictionsOffset + index * 24u + pair]; } }","for (var pair = 0u; pair < 24u; pair++) { if (pairState[pairStateOffset + pair] == 1u) { let destination = destinations[destinationsOffset + pair]; predictions[predictionsOffset + index * 24u + pair] = getBalancedPrediction(predictions[predictionsOffset + index * 24u + pair], destinationTotals[destination], destinationSums[destination]); } }","var fittedOrigins: array<f32, 4>; var fittedDestinations: array<f32, 6>;","for (var pair = 0u; pair < 24u; pair++) { if (pairState[pairStateOffset + pair] == 1u) { fittedOrigins[origins[originsOffset + pair]] += predictions[predictionsOffset + index * 24u + pair]; fittedDestinations[destinations[destinationsOffset + pair]] += predictions[predictionsOffset + index * 24u + pair]; } }","error = 0.0;","for (var origin = 0u; origin < 4u; origin++) { error = max(error, abs(fittedOrigins[origin] - originTotals[origin]) / max(1.0, originTotals[origin])); }","for (var destination = 0u; destination < 6u; destination++) { error = max(error, abs(fittedDestinations[destination] - destinationTotals[destination]) / max(1.0, destinationTotals[destination])); }","iterations++; if (error <= 0.000009999999747378752) { converged = true; break; }","var deviance = 0.0;","for (var pair = 0u; pair < 24u; pair++) { let state = pairState[pairStateOffset + pair];","if (state == 2u) { continue; }","if (state == 1u) { let flow = flows[flowsOffset + pair]; let prediction = predictions[predictionsOffset + index * 24u + pair]; if (!isFiniteBits(prediction) || prediction < 0.0 || (flow > 0.0 && !(prediction > 0.0))) { converged = false; }","var term = prediction; if (flow > 0.0) { term = flow * (log(flow) - log(prediction)) - flow + prediction; } deviance += 2.0 * term; }","diagnostics[diagnosticsOffset + index * 4u] = max(0.0, deviance);","diagnostics[diagnosticsOffset + index * 4u + 1u] = error;","diagnostics[diagnosticsOffset + index * 4u + 2u] = f32(iterations);","diagnostics[diagnosticsOffset + index * 4u + 3u] = select(1.0, 0.0, converged && isFiniteBits(deviance));","const candidatesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> candidates: array<f32>;","  _ = &candidates;","  var lower = bracket[bracketOffset]; var upper = bracket[bracketOffset + 1u]; if (upper - lower <= 0.000009999999747378752) { return; }","let firstValid = candidates[candidatesOffset + 3u] == 0.0; let secondValid = candidates[candidatesOffset + 7u] == 0.0; if (!firstValid && !secondValid) { return; }","if (firstValid && (!secondValid || candidates[candidatesOffset] <= candidates[candidatesOffset + 4u])) { upper = coefficients[coefficientsOffset + 1u]; } else { lower = coefficients[coefficientsOffset]; }","bracket[bracketOffset] = lower; bracket[bracketOffset + 1u] = upper; coefficients[coefficientsOffset] = lower + 0.3819660112501051 * (upper - lower); coefficients[coefficientsOffset + 1u] = lower + 0.6180339887498949 * (upper - lower);","@group(0) @binding(0) var<storage, read> predictions: array<f32>;","@group(0) @binding(1) var<storage, read> diagnostics: array<f32>;","const outputOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> output: arra