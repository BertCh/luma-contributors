 calibration[calibrationOffset + 2u] = upper - lower; calibration[calibrationOffset + 3u] = select(0.0, 1.0, converged);","const idsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> ids: array<u32>;","@group(0) @binding(1) var<storage, read> flows: array<f32>;","@group(0) @binding(2) var<storage, read> predictions: array<f32>;","@group(0) @binding(3) var<storage, read> pairState: array<u32>;","const residualsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> residuals: array<f32>;","@group(0) @binding(5) var<storage, read> status: array<u32>;","  _ = &ids;","  _ = &residuals;","  var residual = 0.0; for (var pair = 0u; pair < 24u; pair++) { if (ids[idsOffset + pair] == index && pairState[pairStateOffset + pair] == 1u) { residual += flows[flowsOffset + pair] - predictions[predictionsOffset + pair]; } }","residuals[residualsOffset + index] = select(getNaN(), residual, status[statusOffset] == 0u);"],"strings":["spatial-interaction-coefficient-values","statistics-output-8","read","GPUSpatialInteraction","read_write","spatial-interaction-bracket","spatial-interaction-candidate-predictions","statistics-input-2","statistics-input-4","compute","statistics-input-0","statistics-input-1","statistics-input-3","predictions","flows","pairState","bracket","coefficientValues","diagnostics","coefficients","covariate","destinations","doubly","origins","wgsl:04412a1b","candidates","golden-section-profile","wgsl:3c3def6f","gpu-spatial-analysis-spatial-interaction-snapshot-tap","statistics-output-7","buffer","logical","spatial-interaction-select","spatial-interaction-profile-0","imported","statistics-output-5","spatial-interaction-calibration-status","spatial-interaction-profile-1","spatial-interaction-profile-10","spatial-interaction-profile-11","spatial-interaction-profile-12","spatial-interaction-profile-13","spatial-interaction-profile-14","spatial-interaction-profile-15","spatial-interaction-profile-16","spatial-interaction-profile-17","spatial-interactio