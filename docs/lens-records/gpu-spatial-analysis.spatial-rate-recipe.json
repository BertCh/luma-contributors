populations: array<f32>;","const spatialRatesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> spatialRates: array<f32>;","const ROWS: u32 = 3u;","const CAPACITY: u32 = 4u;","fn isFiniteFloat(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// A runtime operand keeps the quiet-NaN bit pattern out of constant evaluation.","fn getQuietNaN(seed: u32) -> f32 { return bitcast<f32>(0x7fc00000u | (seed & 0u)); }","// Two-sided normal p-value erfc(|z| / sqrt(2)) through the shared erfcValue (Numerical Recipes","// erfcc Chebyshev fit, fractional error below 1.2e-7), so tiny p-values keep relative accuracy.","fn erfcValue(x: f32) -> f32 {","  let z = abs(x);","  let t = 1.0 / (1.0 + 0.5 * z);","  let r = t * exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 +","    t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 +","    t * (-0.82215223 + t * 0.17087277)))))))));","  return select(2.0 - r, r, x >= 0.0);","}","// Floor of every analytic (normal) p-value: the smallest normal f32. f32 exp underflows beyond","// |z| of about 13, where erfc would read exactly 0; a floor keeps such p-values positive, so they","// stay ordered against larger ones in a multiple-testing correction and safe under log(). One","// rule for the global, local, hot-spot and emerging-hot-spot statistics.","const ANALYTIC_P_VALUE_FLOOR: f32 = 1.17549435e-38;","fn getTwoSidedPValue(z: f32) -> f32 {","  return clamp(erfcValue(abs(z) * 0.70710678118654752), ANALYTIC_P_VALUE_FLOOR, 1.0);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &offsets;","  _ = &neighbors;","  _ = &weights;","  _ = &events;","  _ = &populations;","  _ = &spatialRates;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let nan = getQuietNaN(index);","  if (!(isFiniteFloat(events[eventsOffset + index]) && isFiniteFloat(populations[populationsOffset + index]) && populations[populationsOffset + index] > 0.0)) {","    spatialRates[spatialRatesOffset + index] = nan;","  var eventSum = events[eventsOffset + index];","  var populationSum = populations[populationsOffset + index];","  var count = 1.0;","  {","    let activeRow = index;","    let activeBegin = min(offsets[offsetsOffset + activeRow], CAPACITY);","    let activeEnd = min(offsets[offsetsOffset + activeRow + 1u], CAPACITY);","    for (var slot = activeBegin; slot < activeEnd; slot++) {","      let neighbor = neighbors[neighborsOffset + slot];","      if (neighbor >= ROWS || neighbor == activeRow) {","        continue;","      }","      let weight = weights[weightsOffset + slot];","      if (!(weight > 0.0) || !((isFiniteFloat(events[eventsOffset + neighbor]) && isFiniteFloat(populations[populationsOffset + neighbor]) && populations[populationsOffset + neighbor] > 0.0))) {","      eventSum += events[eventsOffset + neighbor];","      populationSum += populations[populationsOffset + neighbor];","      count += 1.0;","    }","  let priorMean = eventSum / populationSum;","  let ownDeviation = events[eventsOffset + index] / populations[populationsOffset + index] - priorMean;","  var deviationSum = populations[populationsOffset + index] * ownDeviation * ownDeviation;","      let b = populations[populationsOffset + neighbor];","      let deviation = events[eventsOffset + neighbor] / b - priorMean;","      deviationSum += b * deviation * deviation;","  let spatialRate = priorMean;","  let priorVariance = max(deviationSum / populationSum - priorMean / (populationSum / count), 0.0);","  let ownPopulation = populations[populationsOffset + index];","  let ownRate = events[eventsOffset + index] / ownPopulation;","  let denominator = priorVariance + priorMean / ownPopulation;","  let weight = select(0.0, priorVariance / denominator, denominator > 0.0);","  let smoothed = weight * ownRate + (1.0 - weight) * priorMean;","  spatialRates[spatialRatesOffset + index] = spatialRate;","const ratesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> rates: array<f32>;","@group(0) @binding(1) var<storage, read> events: array<f32>;","@group(0) @binding(2) var<storage, read> populations: array<f32>;","@group(0) @binding(3) var<storage, read> offsets: array<u32>;","@group(0) @binding(4) var<storage, read> neighbors: array<u32>;","const outputOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> output: array<f32>;","  _ = &rates;","  _ = &output;","  var hasNeighbor = false;","  for (var slot = offsets[offsetsOffset + index]; slot < offsets[offsetsOffset + index + 1u] && !hasNeighbor; slot++) {","    let neighbor = neighbors[neighborsOffset + slot];","    if (neighbor < 3u && neighbor != index) {","      hasNeighbor = isFiniteFloat(events[eventsOffset + neighbor]) && isFiniteFloat(populations[populationsOffset + neighbor]) && populations[populationsOffset + neighbor] > 0.0;","  output[outputOffset + index] = select(getQuietNaN(index), rates[ratesOffset + index] * 1000.0, hasNeighbor);"],"strings":["read","spatial-rate-smooth","events","populations","spatial-rate-finish","buffer","neighbors","offsets","rates","spatial-rate-pooled","gpu-spatial-analysis-spatial-rate-recipe-snapshot-tap","imported","weights","GPUSpatialEmpiricalBayesRates","addSpatialRateRecipe","compute","read_write"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffse