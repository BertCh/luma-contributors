}","fn subtractUint64(left: vec2<u32>, right: vec2<u32>) -> vec2<u32> {","  return vec2<u32>(left.x - right.x - select(0u, 1u, left.y < right.y), left.y - right.y);","fn negateInt64(value: vec2<u32>) -> vec2<u32> {","  return subtractUint64(vec2<u32>(0u, 0u), value);","fn compareUint64(left: vec2<u32>, right: vec2<u32>) -> i32 {","  if (left.x != right.x) {","    return select(-1i, 1i, left.x > right.x);","  }","  if (left.y != right.y) {","    return select(-1i, 1i, left.y > right.y);","  return 0i;","fn isLessUint64(left: vec2<u32>, right: vec2<u32>) -> bool {","  return left.x < right.x || (left.x == right.x && left.y < right.y);","fn isLessOrEqualUint64(left: vec2<u32>, right: vec2<u32>) -> bool {","  return left.x < right.x || (left.x == right.x && left.y <= right.y);","// Signed order: flipping the sign bit of the high words makes them compare as unsigned.","fn compareInt64(left: vec2<u32>, right: vec2<u32>) -> i32 {","  return compareUint64(vec2<u32>(left.x ^ 0x80000000u, left.y), vec2<u32>(right.x ^ 0x80000000u, right.y));","fn shiftLeftUint64(value: vec2<u32>, bits: u32) -> vec2<u32> {","  if (bits == 0u) {","    return value;","  if (bits >= 64u) {","    return vec2<u32>(0u, 0u);","  if (bits >= 32u) {","    return vec2<u32>(value.y << (bits - 32u), 0u);","  return vec2<u32>((value.x << bits) | (value.y >> (32u - bits)), value.y << bits);","fn shiftRightUint64(value: vec2<u32>, bits: u32) -> vec2<u32> {","    return vec2<u32>(0u, value.x >> (bits - 32u));","  return vec2<u32>(value.x >> bits, (value.y >> bits) | (value.x << (32u - bits)));","// Exact 32 x 32 -> 64 bit product from 16-bit limbs; no partial sum exceeds 2^32.","fn multiplyUint32Wide(left: u32, right: u32) -> vec2<u32> {","  let leftLow = left & 0xffffu;","  let leftHigh = left >> 16u;","  let rightLow = right & 0xffffu;","  let rightHigh = right >> 16u;","  let lowLow = leftLow * rightLow;","  let lowHigh = leftLow * rightHigh;","  let highLow = leftHigh * rightLow;","  let middle = (lowLow >> 16u) + (lowHigh & 0xffffu) + (highLow & 0xffffu);","  return vec2<u32>(","    leftHigh * rightHigh + (lowHigh >> 16u) + (highLow >> 16u) + (middle >> 16u),","    (lowLow & 0xffffu) | (middle << 16u)","  );","fn multiplyUint64ByUint32(left: vec2<u32>, right: u32) -> vec2<u32> {","  let wide = multiplyUint32Wide(left.y, right);","  return vec2<u32>(wide.x + left.x * right, wide.y);","fn multiplyUint64(left: vec2<u32>, right: vec2<u32>) -> vec2<u32> {","  let wide = multiplyUint32Wide(left.y, right.y);","  return vec2<u32>(wide.x + left.y * right.x + left.x * right.y, wide.y);","struct Uint64Division {","  quotient: vec2<u32>,","  remainder: u32,","// Restoring division one bit at a time. The running remainder stays below the divisor, so after a","// shift it is below 2^33; the bit shifted out of the u32 is carried in overflowBit.","fn divideUint64ByUint32(value: vec2<u32>, divisor: u32) -> Uint64Division {","  if (divisor == 0u) {","    return Uint64Division(vec2<u32>(0xffffffffu, 0xffffffffu), 0u);","  var quotient = vec2<u32>(0u, 0u);","  var remainder = 0u;","  for (var bit = 0u; bit < 64u; bit++) {","    let position = 63u - bit;","    let word = select(value.y, value.x, position >= 32u);","    let incoming = (word >> (position & 31u)) & 1u;","    let overflowBit = remainder >> 31u;","    remainder = (remainder << 1u) | incoming;","    if (overflowBit != 0u || remainder >= divisor) {","      remainder = remainder - divisor;","      if (position >= 32u) {","        quotient.x = quotient.x | (1u << (position - 32u));","      } else {","        quotient.y = quotient.y | (1u << position);","      }","    }","  return Uint64Division(quotient, remainder);","fn uint64ToFloat(value: vec2<u32>) -> f32 {","  return f32(value.x) * 4294967296.0 + f32(value.y);","fn int64ToFloat(value: vec2<u32>) -> f32 {","  if ((value.x & 0x80000000u) != 0u) {","    return -uint64ToFloat(negateInt64(value));","  return uint64ToFloat(value);","fn roundSpatialCountValue(magnitude: vec2<u32>, exponentScale: i32, negative: u32, sticky: bool) -> f32 {","  let bitLength = select(32u - countLeadingZeros(magnitude.y), 64u - countLeadingZeros(magnitude.x), magnitude.x != 0u);","  if (bitLength == 0u) { return bitcast<f32>(negative); }","  let subnormal = exponentScale + i32(bitLength) - 1i < -126i;","  let shift = select(i32(bitLength) - 24i, -149i - exponentScale, subnormal);","  if (shift >= 64i) { return bitcast<f32>(negative); }","  var rounded = 0u;","  if (shift <= 0i) {","    rounded = shiftLeftUint64(magnitude, u32(-shift)).y;","  } else {","    let quotient = shiftRightUint64(magnitude, u32(shift));","    let discarded = subtractUint64(magnitude, shiftLeftUint64(quotient, u32(shift)));","    let halfway = shiftLeftUint64(vec2<u32>(0u, 1u), u32(shift - 1i));","    let comparison = compareUint64(discarded, halfway);","    rounded = quotient.y + u32(comparison > 0i || (comparison == 0i && (sticky || (quotient.y & 1u) != 0u)));","  if (subnormal) { return bitcast<f32>(negative | rounded); }","  var exponent = exponentScale + shift + 150i;","  if (rounded >= 0x1000000u) { rounded = rounded >> 1u; exponent++; }","  if (exponent >= 255i) { return bitcast<f32>(negative | 0x7f800000u); }","  return bitcast<f32>(negative | (u32(exponent) << 23u) | (rounded & 0x7fffffu));","fn divideBySpatialCount(value: f32, count: u32) -> f32 {","  if (count <= 16777216u) { return value / f32(count); }","  let bits = bitcast<u32>(value);","  let exponent = (bits >> 23u) & 255u;","  let significand = (bits & 0x7fffffu) | select(0u, 0x800000u, exponent != 0u);","  if (exponent == 255u || significand == 0u) { return value; }","  let division = divideUint64ByUint32(vec2<u32>(significand, 0u), count);","  var quotient = division.quotient;","  // With no discarded integer bits, the division remainder supplies the rounding decision.","  if (quotient.x == 0u && quotient.y < 0x1000000u && exponent > 32u) {","    let complement = count - division.remainder;","    quotient.y += u32(division.remainder > complement ||","      (division.remainder == complement && (quotient.y & 1u) != 0u));","  return roundSpatialCountValue(quotient, i32(max(exponent, 1u)) - 182i,","    bits & 0x80000000u, division.remainder != 0u && !(quotient.y <= 0x1000000u && exponent > 32u));","fn multiplyBySpatialCount(value: f32, count: u32) -> f32 {","  if (count <= 16777216u) { return value * f32(count); }","  return roundSpatialCountValue(multiplyUint32Wide(significand, count), i32(max(exponent, 1u)) - 150i,","    bits & 0x80000000u, false);","fn divideSpatialCountByValue(count: u32, value: f32) -> f32 {","  if (count <= 16777216u) { return f32(count) / value; }","  let fraction = bits & 0x7fffffu;","  let negative = bits & 0x80000000u;","  if (exponent == 255u) { return select(bitcast<f32>(negative), value, fraction != 0u); }","  let significand = fraction | select(0u, 0x800000u, exponent != 0u);","  if (significand == 0u) { return bitcast<f32>(negative | 0x7f800000u); }","  let division = divideUint64ByUint32(vec2<u32>(count, 0u), significand);","  return roundSpatialCountValue(division.quotient, 118i - i32(max(exponent, 1u)),","    negative, division.remainder != 0u);","fn divideSpatialCounts(numerator: u32, denominator: u32) -> f32 {","  if (numerator <= 16777216u && denominator <= 16777216u) { return f32(numerator) / f32(denominator); }","  if (numerator == 0u) { return 0.0; }","  let shift = 31u + countLeadingZeros(numerator);","  let division = divideUint64ByUint32(shiftLeftUint64(vec2<u32>(0u, numerator), shift), denominator);","  return roundSpatialCountValue(division.quotient, -i32(shift), 0u, division.remainder != 0u);","// A runtime operand keeps the quiet-NaN bit pattern out of constant evaluation.","fn getQuietNaN(seed: u32) -> f32 { return bitcast<f32>(0x7fc00000u | (seed & 0u)); }","// Two-sided normal p-value erfc(|z| / sqrt(2)) through the shared erfcValue (Numerical Recipes","// erfcc Chebyshev fit, fractional error below 1.2e-7), so tiny p-values keep relative accuracy.","fn erfcValue(x: f32) -> f32 {","  let z = abs(x);","  let t = 1.0 / (1.0 + 0.5 * z);","  let r = t * exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 +","    t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 +","    t * (-0.82215223 + t * 0.17087277)))))))));","  return select(2.0 - r, r, x >= 0.0);","// Floor of every analytic (normal) p-value: the smallest normal f32. f32 exp underflows beyond","// |z| of about 13, where erfc would read exactly 0; a floor keeps such p-values positive, so they","// stay ordered against larger ones in a multiple-testing correction and safe under log(). One","// rule for the global, local, hot-spot and emerging-hot-spot statistics.","const ANALYTIC_P_VALUE_FLOOR: f32 = 1.17549435e-38;","fn getTwoSidedPValue(z: f32) -> f32 {","  return clamp(erfcValue(abs(z) * 0.70710678118654752), ANALYTIC_P_VALUE_FLOOR, 1.0);","@compute @workgroup_size(256)","fn main(@builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(num_workgroups) workgroupCount: vec3<u32>,","  @builtin(local_invocation_index) localInvocationIndex: u32) {","  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= getChunkParameter(1u)) { return; }","  offsetsOffset = getChunkParameter(4u);","  neighborsOffset = getChunkParameter(5u);","  weightsOffset = getChunkParameter(6u);","  eventsOffset = getChunkParameter(7u);","  populationsOffset = getChunkParameter(8u);","  spatialRatesOffset = getChunkParameter(9u);","  CAPACITY = arrayLength(&neighbors) - neighborsOffset;","  WEIGHTS_ROW_START = getChunkParameter(36u);","  { let index = index + getChunkParameter(0u);","  let nan = getQuietNaN(index);","  if (!(isFiniteFloat(events[eventsOffset + index]) && isFiniteFloat(populations[populationsOffset + index]) && populations[populationsOffset + index] > 0.0)) {","    spatialRates[spatialRatesOffset + index] = nan;","    return;","  var eventSum = events[eventsOffset + index];","  var populationSum = populations[populationsOffset + index];","  var count = 1u;","  {","    let activeRow = index;","    let activeBegin = min(offsets[offsetsOffset + activeRow - (WEIGHTS_ROW_START)], CAPACITY);","    let activeEnd = min(offsets[offsetsOffset + activeRow - (WEIGHTS_ROW_START) + 1u], CAPACITY);","    for (var slot = activeBegin; slot < activeEnd; slot++) {","      let neighbor = neighbors[neighborsOffset + slot];","      if (neighbor >= ROWS || neighbor == activeRow) {","        continue;","      let weight = weights[weightsOffset + slot];","      if (!(weight > 0.0) || !((isFiniteFloat(events[eventsOffset + neighbor]) && isFiniteFloat(populations[populationsOffset + neighbor]) && populations[populationsOffset + neighbor] > 0.0))) {","      eventSum += events[eventsOffset + neighbor];","      populationSum += populations[populationsOffset + neighbor];","      count++;","  let priorMean = eventSum / populationSum;","  let ownDeviation = events[eventsOffset + index] / populations[populationsOffset + index] - priorMean;","  var deviationSum = populations[populationsOffset + index] * ownDeviation * ownDeviation;","      let b = populations[populationsOffset + neighbor];","      let deviation = events[eventsOffset + neighbor] / b - priorMean;","      deviationSum += b * deviation * deviation;","  let spatialRate = priorMean;","  let priorVariance = max(deviationSum / populationSum - priorMean / (divideBySpatialCount(populationSum, count)), 0.0);","  let ownPopulation = populations[populationsOffset + index];","  let ownRate = events[eventsOffset + index] / ownPopulation;","  let denominator = priorVariance + priorMean / ownPopulation;","  let weight = select(0.0, priorVariance / denominator, denominator > 0.0);","  let smoothed = weight * ownRate + (1.0 - weight) * priorMean;","  spatialRates[spatialRatesOffset + index] = spatialRate;","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const ratesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> rates: array<f32>;","const eventsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> events: array<f32>;","const populationsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> populations: array<f32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> offsets: array<u32>;","const neighborsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> neighbors: array<u32>;","const outputOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> output: array<f32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &rates;","  _ = &events;","  _ = &populations;","  _ = &offsets;","  _ = &neighbors;","  _ = &output;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","  var hasNeighbor = false;","  for (var slot = offsets[offsetsOffset + index]; slot < offsets[offsetsOffset + index + 1u] && !hasNeighbor; slot++) {","    let neighbor = neighbors[neighborsOffset + slot];","    if (neighbor < 3u && neighbor != index) {","      hasNeighbor = isFiniteFloat(events[eventsOffset + neighbor]) && isFiniteFloat(populations[populationsOffset + neighbor]) && populations[populationsOffset + neighbor] > 0.0;","  output[outputOffset + index] = select(getQuietNaN(index), rates[ratesOffset + index] * 1000.0, hasNeighbor);"],"strings":["read","spatial-rate-smooth","events","populations","spatial-rate-finish","buffer","logical","neighbors","offsets","rates