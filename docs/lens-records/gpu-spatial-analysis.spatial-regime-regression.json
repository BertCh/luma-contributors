ATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const predictorsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> predictors: array<f32>;","const responseOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> response: array<f32>;","const regimesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> regimes: array<u32>;","const coefficientsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> coefficients: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> counts: array<u32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteBits(x: f32) -> bool {","  return (bitcast<u32>(x) & 0x7f800000u) != 0x7f800000u;","fn included(row: u32) -> bool {","  ","  if (!isFiniteBits(response[responseOffset + row]) || regimes[regimesOffset + row] >= 3u) { return false; }","  for (var column = 0u; column < 1u; column++) { if (!isFiniteBits(predictors[predictorsOffset + row * 1u + column])) { return false; } }","  return true;","fn choleskyFactor_1(a: ptr<function, array<f32, 1>>) -> bool {","  for (var column = 0u; column < 1u; column++) {","    var diagonal = (*a)[column * 1u + column];","    for (var k = 0u; k < column; k++) {","      let value = (*a)[column * 1u + k];","      diagonal = diagonal - value * value;","    }","    if (!(diagonal > 0.0) || diagonal > 3.0e38) {","      return false;","    let pivot = sqrt(diagonal);","    (*a)[column * 1u + column] = pivot;","    for (var row = column + 1u; row < 1u; row++) {","      var value = (*a)[row * 1u + column];","      for (var k = 0u; k < column; k++) {","        value = value - (*a)[row * 1u + k] * (*a)[column * 1u + k];","      }","      (*a)[row * 1u + column] = value / pivot;","  }","fn choleskySolve_1(a: ptr<function, array<f32, 1>>, b: ptr<function, array<f32, 1>>) {","  for (var row = 0u; row < 1u; row++) {","    var value = (*b)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*a)[row * 1u + k] * (*b)[k];","    (*b)[row] = value / (*a)[row * 1u + row];","  for (var offset = 0u; offset < 1u; offset++) {","    let row = 0u - offset;","    for (var k = row + 1u; k < 1u; k++) {","      value = value - (*a)[k * 1u + row] * (*b)[k];","fn choleskyInverseDiagonal_1(a: ptr<function, array<f32, 1>>, column: u32) -> f32 {","  var unit: array<f32, 1>;","    unit[row] = select(0.0, 1.0, row == column);","  choleskySolve_1(a, &unit);","  return unit[column];","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &predictors;","  _ = &response;","  _ = &regimes;","  _ = &coefficients;","  _ = &status;","  _ = &counts;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var means: array<f32, 1>; var responseMean = 0.0; var count = 0u;","for (var row = 0u; row < 6u; row++) {","  if (!included(row) || regimes[regimesOffset + row] != index) { continue; }","  count++; responseMean += (response[responseOffset + row] - responseMean) / f32(count);","  for (var column = 0u; column < 1u; column++) { means[column] += (predictors[predictorsOffset + row * 1u + column] - means[column]) / f32(count); }","counts[countsOffset + index] = count;","for (var column = 0u; column < 2u; column++) { coefficients[coefficientsOffset + index * 2u + column] = getNaN(); }","status[statusOffset + index] = 1u; if (count <= 1u) { return; }","var matrix: array<f32, 1>; var right: array<f32, 1>;","    let value = predictors[predictorsOffset + row * 1u + column] - means[column];","    right[column] += value * (response[responseOffset + row] - responseMean);","    for (var other = 0u; other <= column; other++) { matrix[column * 1u + other] += value * (predictors[predictorsOffset + row * 1u + other] - means[other]); }","status[statusOffset + index] = 2u; if (!choleskyFactor_1(&matrix)) { return; }","choleskySolve_1(&matrix, &right); var intercept = responseMean;","for (var column = 0u; column < 1u; column++) { if (!isFiniteBits(right[column])) { return; } intercept -= means[column] * right[column]; }","if (!isFiniteBits(intercept)) { return; }","coefficients[coefficientsOffset + index * 2u] = intercept;","for (var column = 0u; column < 1u; column++) { coefficients[coefficientsOffset + index * 2u + column + 1u] = right[column]; }","status[statusOffset + index] = 0u;","@group(0) @binding(3) var<storage, read> coefficients: array<f32>;","const fittedOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> fitted: array<f32>;","  _ = &fitted;","  var value = getNaN();","if (included(index)) { let base = coefficientsOffset + regimes[regimesOffset + index] * 2u; value = coefficients[base];","  for (var column = 0u; column < 1u; column++) { value += predictors[predictorsOffset + index * 1u + column] * coefficients[base + column + 1u]; }","fitted[fittedOffset + index] = value;"],"strings":["spatial-regime-regression-fit","buffer","imported","spatial-regime-regression-predict","output-6","read","input-3","input-4","input-5","GPUSpatialRegimeRegression","output-7","output-8","output-9","read_write","coefficients","compute","predictors","regimes","response","spatial-regime-regression"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["wor