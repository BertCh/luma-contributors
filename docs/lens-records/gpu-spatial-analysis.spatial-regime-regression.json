olumn++) {","    let total = reduceWorkgroup(localInvocationIndex, sums[column]);","    if (localInvocationIndex == 0u) {","      regimeMeans[column] = select(0.0, origins[column] + total / max(count, 1.0), end > begin);","  var means: array<f32, 2>;","    means[column] = regimeMeans[column];","  var products: array<f32, 3>;","  var centered: array<f32, 2>;","  var deviationSums: array<f32, 2>;","  // The first segment starts at sorted row 0, so this buffer word is a zero the compiler cannot","  // know. It fixes each deviation as written: summed as (sum of values) - count * mean, the","  // deviation sums and the centered products would lose everything below a float32 step.","      centered[column] = getRoundedDifference(getValue(row, column), means[column], runtimeZero);","      deviationSums[column] = deviationSums[column] + centered[column];","    var moment = 0u;","    for (var first = 0u; first < D; first++) {","      for (var second = first; second < D; second++) {","        products[moment] = products[moment] + centered[first] * centered[second];","        moment = moment + 1u;","      }","  let base = momentsOffset + min(regime, REGIME_COUNT - 1u) * STRIDE;","  if (isInRange && localInvocationIndex == 0u) {","      moments[base + column] = means[column];","  for (var moment = 0u; moment < MOMENT_COUNT; moment++) {","    let total = reduceWorkgroup(localInvocationIndex, products[moment]);","    if (isInRange && localInvocationIndex == 0u) {","      moments[base + D + moment] = total;","    let total = reduceWorkgroup(localInvocationIndex, deviationSums[column]);","      moments[base + D + MOMENT_COUNT + column] = total;","@group(0) @binding(0) var<storage, read> segmentOffsets: array<u32>;","@group(0) @binding(1) var<storage, read> moments: array<f32>;","const coefficientsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> coefficients: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> status: array<u32>;","const countsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> counts: array<u32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","struct DenseCholesky_1 {","  scale: array<f32, 1>,","  size: u32,","  status: u32,","  smallestPivotRatio: f32,","fn factorDenseCholesky_1(","  matrix: ptr<function, array<f32, 1>>,","  equilibrate: bool,","  minimumPivotRatio: f32",") -> DenseCholesky_1 {","  var result: DenseCholesky_1;","  result.size = min(size, 1u);","  result.status = 0u;","  result.smallestPivotRatio = 1.0;","  let count = result.size;","  for (var row = 0u; row < count; row++) {","    for (var column = 0u; column <= row; column++) {","      if (!isFiniteValue((*matrix)[row * 1u + column])) {","        result.status = 1u;","        return result;","  for (var column = 0u; column < count; column++) {","    let diagonal = (*matrix)[column * 1u + column];","    if (!(diagonal > 0.0)) {","      result.status = 2u;","      return result;","    result.scale[column] = select(1.0, 1.0 / sqrt(diagonal), equilibrate);","  if (equilibrate) {","    for (var row = 0u; row < count; row++) {","      for (var column = 0u; column <= row; column++) {","        (*matrix)[row * 1u + column] = (*matrix)[row * 1u + column] * result.scale[row] * result.scale[column];","    let original = (*matrix)[column * 1u + column];","    var diagonal = original;","    for (var k = 0u; k < column; k++) {","      let value = (*matrix)[column * 1u + k];","      diagonal = diagonal - value * value;","    if (!isFiniteValue(diagonal)) {","      result.status = 1u;","    if (!(diagonal > 0.0) || !(original > 0.0)) {","      result.smallestPivotRatio = 0.0;","    result.smallestPivotRatio = min(result.smallestPivotRatio, diagonal / original);","    let pivot = sqrt(diagonal);","    (*matrix)[column * 1u + column] = pivot;","    for (var row = column + 1u; row < count; row++) {","      var value = (*matrix)[row * 1u + column];","      for (var k = 0u; k < column; k++) {","        value = value - (*matrix)[row * 1u + k] * (*matrix)[column * 1u + k];","      (*matrix)[row * 1u + column] = value / pivot;","  if (result.smallestPivotRatio < minimumPivotRatio) {","    result.status = 3u;","  return result;","fn solveDenseCholesky_1(","  factorization: ptr<function, DenseCholesky_1>,","  vector: ptr<function, array<f32, 1>>",") -> bool {","  let count = (*factorization).size;","    (*vector)[row] = (*vector)[row] * (*factorization).scale[row];","    var value = (*vector)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*matrix)[row * 1u + k] * (*vector)[k];","    (*vector)[row] = value / (*matrix)[row * 1u + row];","  for (var offset = 0u; offset < count; offset++) {","    let row = count - 1u - offset;","    for (var k = row + 1u; k < count; k++) {","      value = value - (*matrix)[k * 1u + row] * (*vector)[k];","  var finite = true;","    finite = finite && isFiniteValue((*vector)[row]);","  return finite;","fn getDenseCholeskyInverseDiagonal_1(","  column: u32",") -> f32 {","  var unit: array<f32, 1>;","  unit[column] = 1.0;","  solveDenseCholesky_1(matrix, factorization, &unit);","  return unit[column];","fn invertDenseCholesky_1(","  inverse: ptr<function, array<f32, 1>>","    var unit: array<f32, 1>;","    unit[column] = 1.0;","    finite = solveDenseCholesky_1(matrix, factorization, &unit) && finite;","      (*inverse)[row * 1u + column] = unit[row];","fn getDenseCholeskyLogDeterminant_1(","  factorization: ptr<function, DenseCholesky_1>","  var total = 0.0;","  for (var row = 0u; row < (*factorization).size; row++) {","    total = total + 2.0 * (log((*matrix)[row * 1u + row]) - log((*factorization).scale[row]));","fn choleskyFactor_1(a: ptr<function, array<f32, 1>>) -> bool {","  return factorDenseCholesky_1(a, 1u, false, 0.0).status == 0u;","// The factorization record of a successful unequilibrated factor: unit scale, full size.","fn getCholeskyFactorization_1() -> DenseCholesky_1 {","  return DenseCholesky_1(array<f32, 1>(1.0), 1u, 0u, 1.0);","fn choleskySolve_1(a: ptr<function, array<f32, 1>>, b: ptr<function, array<f32, 1>>) {","  var factorization = getCholeskyFactorization_1();","  solveDenseCholesky_1(a, &factorization, b);","fn choleskyInverseDiagonal_1(a: ptr<function, array<f32, 1>>, column: u32) -> f32 {","  return getDenseCholeskyInverseDiagonal_1(a, &factorization, column);","fn choleskyFactorLimited_1(a: ptr<function, array<f32, 1>>) -> bool {","  var diagonal: array<f32, 1>;","    diagonal[column] = (*a)[column * 1u + column];","  if (!choleskyFactor_1(a)) {","    return false;","    if (!((*a)[column * 1u + column] >= 0.001 * sqrt(diagonal[column]))) {","      return false;","  return true;","fn momentAt(base: u32, first: u32, second: u32, count: u32) -> f32 {","  let low = min(first, second);","  let high = max(first, second);","  let deviations = base + 5u;","  // Fix the quotient before multiplying: the product of two deviation sums can overflow","  // even when the corrected moment fits in f32. The first segment offset is a runtime zero.","  let secondCorrection = getRoundedDifference(moments[deviations + second] / max(f32(count), 1.0), 0.0, segmentOffsets[segmentOffsetsOffset]);","  return moments[base + D + low * (2u * D - low + 1u) / 2u + (high - low)]","    - moments[deviations + first] * secondCorrection;","  _ = &coefficients;","  _ = &status;","  _ = &counts;","  let count = segmentOffsets[segmentOffsetsOffset + index + 1u] - segmentOffsets[segmentOffsetsOffset + index];","let base = momentsOffset + index * 7u;","counts[countsOffset + index] = count;","for (var column = 0u; column < 2u; column++) { coefficients[coefficientsOffset + index * 2u + column] = getNaN(); }","status[statusOffset + index] = 1u; if (count <= 1u) { return; }","var matrix: array<f32, 1>; var right: array<f32, 1>;","for (var column = 0u; column < 1u; column++) {","  right[column] = momentAt(base, column, 1u, count);","  for (var other = 0u; other <= column; other++) { matrix[column * 1u + other] = momentAt(base, column, other, count); }","let responseMean = moments[base + 1u];","status[statusOffset + index] = 2u; if (!choleskyFactorLimited_1(&matrix)) { return; }","choleskySolve_1(&matrix, &right);","let deviations = base + 5u;","var intercept = responseMean;","var correction = moments[deviations + 1u] / f32(count);","let runtimeZero = segmentOffsets[segmentOffsetsOffset];","  if (!isFiniteBits(right[column])) { return; }","  intercept = getRoundedDifference(intercept, moments[base + column] * right[column], runtimeZero);","  correction -= right[column] * (moments[deviations + column] / f32(count));","intercept += correction;","if (!isFiniteBits(intercept)) { return; }","coefficients[coefficientsOffset + index * 2u] = intercept;","for (var column = 0u; column < 1u; column++) { coefficients[coefficientsOffset + index * 2u + column + 1u] = right[column]; }","status[statusOffset + index] = 0u;","@group(0) @binding(3) var<storage, read> coefficients: array<f32>;","@group(0) @binding(4) var<storage, read> moments: array<f32>;","@group(0) @binding(5) var<storage, read> segmentOffsets: array<u32>;","const fittedOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> fitted: array<f32>;","fn included(row: u32) -> bool {","  if (!isFiniteBits(response[responseOffset + row]) || regimes[regimesOffset + row] >= 3u) { return false; }","  for (var column = 0u; column < 1u; column++) { if (!isFiniteBits(predictors[predictorsOffset + row * 1u + column])) { return false; } }","fn getCenteredRegressionPrediction(","  responseMean: f32, centeredContribution: f32, meanCorrection: f32, runtimeZero: u32","  let correctedContribution = getRoundedDifference(centeredContribution + meanCorrection, 0.0, runtimeZero);","  return responseMean + correctedContribution;","  _ = &fitted;","  var value = getNaN();","if (included(index)) {","  let regime = regimes[regimesOffset + index];","  let base = coefficientsOffset + regime * 2u;","  if (!isFiniteBits(coefficients[base])) { fitted[fittedOffset + index] = value; return; }","  let momentBase = momentsOffset + regime * 7u;","  let deviations = momentBase + 5u;","  let count = f32(segmentOffsets[segmentOffsetsOffset + regime + 1u] - segmentOffsets[segmentOffsetsOffset + regime]);","  var correction = moments[deviations + 1u] / count;","    correction -= coefficients[base + column + 1u] * moments[deviations + column] / count;","  // The first sorted segment starts at zero; reading it keeps differences rounded on Metal.","  var centeredContribution = 0.0;","  centeredContribution += (coefficients[base + column + 1u]) * getRoundedDifference(predictors[predictorsOffset + index * 1u + column], moments[momentBase + column], segmentOffsets[segmentOffsetsOffset]);","  value = getCenteredRegressionPrediction(moments[momentBase + 1u], centeredContribution, correction, segmentOffsets[segmentOffsetsOffset]);","fitted[fittedOffset + index] = value;"],"strings":["spatial-regime-regression-regime-offsets","spatial-regime-regression-regime-moments","read","spatial-regime-regression-regime-keys","buffer","logical","spatial-regime-regression-predict","spatial-regime-regression-fit","GPUSpatialRegimeRegression","gpu-spatial-analysis-spatial-regime-regression-snapshot-tap","spatial-regime-regression-regime-sort-bitonic-local","output-6","read_write","imported","input-3","input-4","compute","output-7","output-8","output-9","spatial-regime-regression-regime-rows","transient","input-5","spatial-regime-regression-sorted-regime-keys","spatial-regime-regression-sorted-regime-rows","segmentOffsets","moments","predictors","response","coefficients","regimes"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","