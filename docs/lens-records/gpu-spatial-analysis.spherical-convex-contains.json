"    return;","  }","  let queryOffset = queriesOffset + index * 3u; let point = vec3f(queries[queryOffset], queries[queryOffset + 1u], queries[queryOffset + 2u]);","let polygon = polygonIndices[polygonIndicesOffset + index]; var failure = 0u; var inside = true; var boundary = false;","if (!containsUnit(point) || polygon >= 1u) { failure = 1u; }","if (failure == 0u) {","  let begin = offsets[offsetsOffset + polygon]; let end = offsets[offsetsOffset + polygon + 1u];","  if (begin > end || end > 3u || end - begin < 3u || end - begin > 32u) { failure = 1u; }","  if (failure == 0u) {","    var center = vec3f(0.0);","    for (var vertex = begin; vertex < end; vertex++) { let position = containsPosition(vertex); if (!containsUnit(position)) { failure = 1u; } center += position; }","    if (length(center) < CONTAINS_TOLERANCE) { failure = 1u; } else { center = normalize(center); }","    for (var edge = begin; edge < end && failure == 0u; edge++) {","      let first = containsPosition(edge); let second = containsPosition(select(edge + 1u, begin, edge + 1u == end));","      let crossing = cross(first, second);","      if (length(crossing) <= CONTAINS_TOLERANCE || dot(center, first) <= CONTAINS_TOLERANCE) { failure = 1u; break; }","      let normal = normalize(crossing);","      if (dot(normal, center) <= CONTAINS_TOLERANCE) { failure = 1u; break; }","      for (var vertex = begin; vertex < end; vertex++) { if (dot(normal, containsPosition(vertex)) < -CONTAINS_TOLERANCE) { failure = 1u; } }","      let side = dot(normal, point); inside = inside && side >= -CONTAINS_TOLERANCE; boundary = boundary || abs(side) <= CONTAINS_TOLERANCE;","    }","}","boundary = boundary && inside;","var accepted = inside;","if (boundary) { accepted = true; if (failure == 0u) { failure = 2u; } }","contains[containsOffset + index] = select(0u, 1u, accepted && failure != 1u); status[statusOffset + index] = failure;"],"strings":["gpu-spatial-analysis-spherical-convex-contains-snapshot-tap","spherical-c