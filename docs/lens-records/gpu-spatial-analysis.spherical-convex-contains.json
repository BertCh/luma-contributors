TCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","const queriesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> queries: array<f32>;","const polygonIndicesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> polygonIndices: array<u32>;","const containsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> contains: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","const CONTAINS_TOLERANCE: f32 = 0.000001;","fn containsPosition(row: u32) -> vec3f { let offset = positionsOffset + row * 3u; return vec3f(positions[offset], positions[offset + 1u], positions[offset + 2u]); }","fn containsUnit(point: vec3f) -> bool { let squared = dot(point, point); return (bitcast<u32>(squared) & 0x7f800000u) != 0x7f800000u && abs(squared - 1.0) <= 1e-4; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &offsets;","  _ = &queries;","  _ = &polygonIndices;","  _ = &contains;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let queryOffset = queriesOffset + index * 3u; let point = vec3f(queries[queryOffset], queries[queryOffset + 1u], queries[queryOffset + 2u]);","let polygon = polygonIndices[polygonIndicesOffset + index]; var failure = 0u; var inside = true; var boundary = false;","if (!containsUnit(point) || polygon >= 1u) { failure = 1u; }","if (failure == 0u) {","  let begin = offsets[offsetsOffset + polygon]; let end = offsets[offsetsOffset + polygon + 1u];","  if (begin > end || end > 3u || end - begin < 3u || end - begin > 32u) { failure = 1u; }","  if (failure == 0u) {","    var center = vec3f(0.0);","    for (var vertex = begin; vertex < end; vertex++) { let position = containsPosition(vertex); if (!containsUnit(position)) { failure = 1u; } center += position; }","    if (length(center) < CONTAINS_TOLERANCE) { failure = 1u; } else { center = normalize(center); }","    for (var edge = begin; edge < end && failure == 0u; edge++) {","      let first = containsPosition(edge); let second = containsPosition(select(edge + 1u, begin, edge + 1u == end));","      let crossing = cross(first, second);","      if (length(crossing) <= CONTAINS_TOLERANCE || dot(center, first) <= CONTAINS_TOLERANCE) { failure = 1u; break; }","      let normal = normalize(crossing);","      if (dot(normal, center) <= CONTAINS_TOLERANCE) { failure = 1u; break; }","      for (var vertex = begin; vertex < end; vertex++) { if (dot(normal, containsPosition(vertex)) < -CONTAINS_TOLERANCE) { failure = 1u; } }","      let side = dot(normal, point); inside = inside && side >= -CONTAINS_TOLERANCE; boundary = boundary || abs(side) <= CONTAINS_TOLERANCE;","    }","}","boundary = boundary && inside;","var accepted = inside;","if (boundary) { accepted = true; if (failure == 0u) { failure = 2u; } }","contains[containsOffset + index] = select(0u, 1u, accepted && failure != 1u); status[statusOffset + index] = failure;"],"strings":["spherical-convex-contains","buffer","imported","contains","status","polygonIndices","queries","read","octantVertices","polygonOffsets","GPUSphericalConvexContains","read_write"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"]