atial-analysis-spherical-polygon-contains-compiled","resource":"status","meaning":"gpu-spatial-analysis-spherical-polygon-contains-snapshot-tap","role":"output","valueCount":3}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const ringOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> ringOffsets: array<u32>;","const ringCentersOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> ringCenters: array<f32>;","const ringFailuresOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> ringFailures: array<atomic<u32>>;","const POLYGON_TOLERANCE: f32 = 9.999999974752427e-7;","fn polygonPosition(row: u32) -> vec3f { let base = positionsOffset + row * 3u; return vec3f(positions[base], positions[base + 1u], positions[base + 2u]); }","fn sphericalRingProjectedDelta(point:vec3f,anchor:vec3f,pole:vec3f)->vec3f {","  // Subtract the packed vectors first (exact for nearby f32 components), before projection.","  let difference=point-anchor;","  let correction=dot(pole,difference)/dot(pole,anchor);","  return (difference-anchor*correction)/dot(pole,point);","}","fn sphericalRingSignedArea(begin:u32,end:u32,pole:vec3f)->f32 {","  let anchor=polygonPosition(begin);var area=0.0;","  if(dot(pole,anchor)<=0.0){return 0.0;}","  for(var vertex=begin+1u;vertex+1u<end;vertex++) {","    let first=polygonPosition(vertex);let second=polygonPosition(vertex+1u);","    if(dot(pole,first)>0.0&&dot(pole,second)>0.0) {","      let firstDelta=sphericalRingProjectedDelta(first,anchor,pole);","      let secondDelta=sphericalRingProjectedDelta(second,anchor,pole);","      area+=dot(pole,cross(firstDelta,secondDelta));","    }","  }","  return area;","fn polygonUnit(point: vec3f) -> bool { let squared = dot(point, point); return (bitcast<u32>(squared) & 0x7f800000u) != 0x7f800000u && abs(squared - 1.0) <= 1e-4; }","fn polygonEdgeNormal(first: vec3f, second: vec3f) -> vec3f {","  let firstDirection = normalize(first);","  let secondDirection = normalize(second);","  // Form a small difference before the cross product to retain tiny off-axis arcs.","  let difference = secondDirection - select(-firstDirection, firstDirection, dot(firstDirection, secondDirection) >= 0.0);","  return cross(firstDirection, difference);","fn polygonOnArc(first: vec3f, second: vec3f, point: vec3f, margin: f32) -> bool {","  let pointDirection = normalize(point);","  // Endpoint chord distance can be exactly zero while the incident plane residual","  // rounds above the angular band. Accept the finite endpoint caps first.","  if (min(distance(firstDirection, pointDirection), distance(secondDirection, pointDirection)) <= 2.0 * sin(margin * 0.5)) { return true; }","  let normal = normalize(polygonEdgeNormal(first, second));","  // The projection belongs to the finite minor arc only when both sides are","  // nonnegative. Expanding both side tests by margin aliases a short arc's antipode.","  let firstSide = dot(cross(firstDirection, pointDirection), normal);","  let secondSide = dot(cross(pointDirection, secondDirection), normal);","  if (firstSide >= 0.0 && secondSide >= 0.0) {","    return abs(dot(normal, pointDirection)) <= sin(margin);","  return false;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &ringOffsets;","  _ = &ringCenters;","  _ = &ringFailures;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  if (index >= 1u) { return; }","let begin = ringOffsets[ringOffsetsOffset + index]; let end = ringOffsets[ringOffsetsOffset + index + 1u];","var failure = 0u; var center = vec3f(0.0);","if (begin > end || end > 3u || end - begin < 3u) { failure = 1u; }","else {","  for (var vertex = begin; vertex < end; vertex++) { let value = polygonPosition(vertex); if (!polygonUnit(value)) { failure = 1u; } center += value; }","  // The supplied ring represents its smaller region; complement is explicit at polygon level.","  ","  if (length(center) <= POLYGON_TOLERANCE) { failure = 1u; } else { center = normalize(center); }","// Local projected differences retain small off-axis ring area without O(1) cancellation.","var signedArea = 0.0;","if (failure == 0u) {","  signedArea = sphericalRingSignedArea(begin, end, center);","let clockwise = select(0u, 2u, signedArea < 0.0);","ringCenters[ringCentersOffset + index * 3u] = center.x; ringCenters[ringCentersOffset + index * 3u + 1u] = center.y; ringCenters[ringCentersOffset + index * 3u + 2u] = center.z;","// Bit 0: failure. Bit 1: clockwise about the pole.","atomicStore(&ringFailures[ringFailuresOffset + index], failure | clockwise);","@group(0) @binding(2) var<storage, read> ringCenters: array<f32>;","  if (index >= 3u || 1u == 0u) { return; }","// Locate the ring that owns this vertex by binary search over the ring offsets.","var low = 0u; var high = 1u;","for (var step = 0u; step < 32u && low + 1u < high; step++) {","  let middle = (low + high) / 2u;","  if (ringOffsets[ringOffsetsOffset + middle] <= index) { low = middle; } else { high = middle; }","let ring = low;","let begin = ringOffsets[ringOffsetsOffset + ring]; let end = ringOffsets[ringOffsetsOffset + ring + 1u];","if (index < begin || index >= end || (atomicLoad(&ringFailures[ringFailuresOffset + ring]) & 1u) != 0u) { return; }","let center = vec3f(ringCenters[ringCentersOffset + ring * 3u], ringCenters[ringCentersOffset + ring * 3u + 1u], ringCenters[ringCentersOffset + ring * 3u + 2u]);","let edge = index;","let next = select(edge + 1u, begin, edge + 1u == end);","let first = polygonPosition(edge); let second = polygonPosition(next);","let normal = polygonEdgeNormal(first, second);","var failure = 0u;","if (length(normal) <= POLYGON_TOLERANCE || dot(center, first) <= POLYGON_TOLERANCE) { failure = 1u; }","// Reject crossing/touching nonadjacent arcs instead of assigning an invalid ring a fill.","for (var other = begin; other < end && failure == 0u; other++) {","  let otherNext = select(other + 1u, begin, other + 1u == end);","  if (other == edge || other == next || otherNext == edge) { continue; }","  let third = polygonPosition(other); let fourth = polygonPosition(otherNext);","  let crossing = cross(normal, polygonEdgeNormal(third, fourth));","  if (length(crossing) > POLYGON_TOLERANCE * POLYGON_TOLERANCE) {","    let intersection = normalize(crossing);","    if ((polygonOnArc(first, second, intersection, POLYGON_TOLERANCE) && polygonOnArc(third, fourth, intersection, POLYGON_TOLERANCE)) || (polygonOnArc(first, second, -intersection, POLYGON_TOLERANCE) && polygonOnArc(third, fourth, -intersection, POLYGON_TOLERANCE))) { failure = 1u; }","  } else if (polygonOnArc(first, second, third, POLYGON_TOLERANCE) || polygonOnArc(first, second, fourth, POLYGON_TOLERANCE)) { failure = 1u; }","// Bit 1 holds the ring orientation; only bit 0 marks a failure.","if (failure != 0u) { atomicOr(&ringFailures[ringFailuresOffset + ring], 1u); }","const polygonOffsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> polygonOffsets: array<u32>;","const queriesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> queries: array<f32>;","const polygonIndicesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> polygonIndices: array<u32>;","const containsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> contains: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","@group(0) @binding(7) var<storage, read> ringFailures: array<u32>;","  _ = &polygonOffsets;","  _ = &queries;","  _ = &polygonIndices;","  _ = &contains;","  _ = &status;","  let queryOffset = queriesOffset + index * 3u;","let queryPoint = vec3f(queries[queryOffset], queries[queryOffset + 1u], queries[queryOffset + 2u]);","var point = queryPoint;","let polygon = polygonIndices[polygonIndicesOffset + index];","var failure = 0u; var inside = false; var boundary = false;","if (!polygonUnit(point) || polygon >= 1u) { failure = 1u; }","  point = normalize(point);","  let firstRing = polygonOffsets[polygonOffsetsOffset + polygon]; let lastRing = polygonOffsets[polygonOffsetsOffset + polygon + 1u];","  if (firstRing > lastRing || lastRing >= 2u) { failure = 1u; }","  for (var ring = firstRing; ring < lastRing && failure == 0u; ring++) {","    // Ring validity (range, unit vectors, hemisphere, arc crossings) is precomputed per ring.","    // Bit 0: the ring failed validation. Bit 1: the ring is clockwise about its pole.","    let ringFlags = ringFailures[ringFailuresOffset + ring];","    if ((ringFlags & 1u) != 0u) { failure = 1u; break; }","    let begin = ringOffsets[ringOffsetsOffset + ring]; let end = ringOffsets[ringOffsetsOffset + ring + 1u];","    var winding = 0.0; var ringBoundary = false;","    for (var edge = begin; edge < end; edge++) {","      let next = select(edge + 1u, begin, edge + 1u == end);","      let first = polygonPosition(edge); let second = polygonPosition(next);","      // Boundary directions must be normalized once, just like the packed endpoints.","      ringBoundary = ringBoundary || polygonOnArc(first, second, queryPoint, POLYGON_TOLERANCE);","      // Use small differences near either the query or its antipode before tangent projection.","      // Direct dot(first,second)-dot(point,first)*dot(point,second) loses tiny off-axis angles.","      let firstDifference = first - select(-point, point, dot(point, first) >= 0.0);","      let secondDifference = second - select(-point, point, dot(point, second) >= 0.0);","      let firstTangent = cross(point, firstDifference); let secondTangent = cross(point, secondDifference);","      let numerator = dot(point, cross(firstTangent, secondTangent)); let denominator = dot(firstTangent, secondTangent);","      // Only the zero tangent pair has no angle; a fixed cutoff drops valid tiny rings.","      if (abs(numerator) + abs(denominator) > 0.0) { winding += atan2(numerator, denominator); }","    // A counterclockwise ring winds 2 pi around its region (and -2 pi around the antipodal mirror","    // image of it); a clockwise ring the opposite, so its winding is negated first.","    let orientedWinding = select(winding, -winding, (ringFlags & 2u) != 0u);","    let ringInside = orientedWinding > 3.141592653589793;","    if (ring == firstRing) { inside = ringInside; } else { inside = inside && !ringInside; }","    boundary = boundary || ringBoundary;","var accepted = inside;","if (boundary && failure == 0u) { failure = 2u; accepted = true; }","contains[containsOffset + index] = select(0u, 1u, accepted && failure != 1u);","status[statusOffset + index] = failure;"],"strings":["gpu-spatial-analysis-spherical-polygon-contains-snapshot-tap","read","ringOffsets","spherical-polygon-contains","spherical-polygon-contains-ring-failures","buffer","logical","spherical-polygon-contains-ring-center","vertices","contains","imported","spherical-polygon-contains-ring-centers","status","GPUSphericalPolygonContains","spherical-polygon-contains-ring-edges","polygonIndices","polygonOffsets","queries","read_write","compute","positions","ringFailures","atomic<u32>","ringCenters","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access"