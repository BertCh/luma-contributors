ingFailures: array<atomic<u32>>;","const POLYGON_TOLERANCE: f32 = 9.999999974752427e-7;","fn polygonPosition(row: u32) -> vec3f { let base = positionsOffset + row * 3u; return vec3f(positions[base], positions[base + 1u], positions[base + 2u]); }","fn polygonUnit(point: vec3f) -> bool { let squared = dot(point, point); return (bitcast<u32>(squared) & 0x7f800000u) != 0x7f800000u && abs(squared - 1.0) <= 1e-4; }","fn polygonOnArc(first: vec3f, second: vec3f, point: vec3f, margin: f32) -> bool {","  let normal = normalize(cross(first, second));","  return abs(dot(normal, point)) <= margin && dot(cross(first, point), normal) >= -margin && dot(cross(point, second), normal) >= -margin;","}","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &ringOffsets;","  _ = &ringCenters;","  _ = &ringFailures;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  if (index >= 1u) { return; }","let begin = ringOffsets[ringOffsetsOffset + index]; let end = ringOffsets[ringOffsetsOffset + index + 1u];","var failure = 0u; var center = vec3f(0.0);","if (begin > end || end > 3u || end - begin < 3u) { failure = 1u; }","else {","  for (var vertex = begin; vertex < end; vertex++) { let value = polygonPosition(vertex); if (!polygonUnit(value)) { failure = 1u; } center += value; }","  // The supplied ring represents its smaller region; complement is explicit at polygon level.","  ","  if (length(center) <= POLYGON_TOLERANCE) { failure = 1u; } else { center = normalize(center); }","ringCenters[ringCentersOffset + index * 3u] = center.x; ringCenters[ringCentersOffset + index * 3u + 1u] = center.y; ringCenters[ringCentersOffset + index * 3u + 2u] = center.z;","atomicStore(&ringFailures[ringFailuresOffset + index], failure);","@group(0) @binding(2) var<storage, read> ringCenters: array<f32>;","  if (index >= 3u || 1u == 0u) { return; }","// Locate the ring that owns this vertex by binary search over the ring offsets.","var low = 0u; var high = 1u;","for (var step = 0u; step < 32u && low + 1u < high; step++) {","  let middle = (low + high) / 2u;","  if (ringOffsets[ringOffsetsOffset + middle] <= index) { low = middle; } else { high = middle; }","let ring = low;","let begin = ringOffsets[ringOffsetsOffset + ring]; let end = ringOffsets[ringOffsetsOffset + ring + 1u];","if (index < begin || index >= end || atomicLoad(&ringFailures[ringFailuresOffset + ring]) != 0u) { return; }","let center = vec3f(ringCenters[ringCentersOffset + ring * 3u], ringCenters[ringCentersOffset + ring * 3u + 1u], ringCenters[ringCentersOffset + ring * 3u + 2u]);","let edge = index;","let next = select(edge + 1u, begin, edge + 1u == end);","let first = polygonPosition(edge); let second = polygonPosition(next);","let normal = cross(first, second);","var failure = 0u;","if (length(normal) <= POLYGON_TOLERANCE || dot(center, first) <= POLYGON_TOLERANCE) { failure = 1u; }","// Reject crossing/touching nonadjacent arcs instead of assigning an invalid ring a fill.","for (var other = begin; other < end && failure == 0u; other++) {","  let otherNext = select(other + 1u, begin, other + 1u == end);","  if (other == edge || other == next || otherNext == edge) { continue; }","  let third = polygonPosition(other); let fourth = polygonPosition(otherNext);","  let crossing = cross(normal, cross(third, fourth));","  if (length(crossing) > POLYGON_TOLERANCE * POLYGON_TOLERANCE) {","    let intersection = normalize(crossing);","    if ((polygonOnArc(first, second, intersection, POLYGON_TOLERANCE) && polygonOnArc(third, fourth, intersection, POLYGON_TOLERANCE)) || (polygonOnArc(first, second, -intersection, POLYGON_TOLERANCE) && polygonOnArc(third, fourth, -intersection, POLYGON_TOLERANCE))) { failure = 1u; }","  } else if (polygonOnArc(first, second, third, POLYGON_TOLERANCE) || polygonOnArc(first, second, fourth, POLYGON_TOLERANCE)) { failure = 1u; }","if (failure != 0u) { atomicMax(&ringFailures[ringFailuresOffset + ring], 1u); }","const polygonOffsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> polygonOffsets: array<u32>;","const queriesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> queries: array<f32>;","const polygonIndicesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> polygonIndices: array<u32>;","const containsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> contains: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","@group(0) @binding(7) var<storage, read> ringFailures: array<u32>;","  _ = &polygonOffsets;","  _ = &queries;","  _ = &polygonIndices;","  _ = &contains;","  _ = &status;","  let queryOffset = queriesOffset + index * 3u;","let point = vec3f(queries[queryOffset], queries[queryOffset + 1u], queries[queryOffset + 2u]);","let polygon = polygonIndices[polygonIndicesOffset + index];","var failure = 0u; var inside = false; var boundary = false;","if (!polygonUnit(point) || polygon >= 1u) { failure = 1u; }","if (failure == 0u) {","  let firstRing = polygonOffsets[polygonOffsetsOffset + polygon]; let lastRing = polygonOffsets[polygonOffsetsOffset + polygon + 1u];","  if (firstRing > lastRing || lastRing >= 2u) { failure = 1u; }","  for (var ring = firstRing; ring < lastRing && failure == 0u; ring++) {","    // Ring validity (range, unit vectors, hemisphere, arc crossings) is precomputed per ring.","    if (ringFailures[ringFailuresOffset + ring] != 0u) { failure = 1u; break; }","    let begin = ringOffsets[ringOffsetsOffset + ring]; let end = ringOffsets[ringOffsetsOffset + ring + 1u];","    var winding = 0.0; var ringBoundary = false;","    for (var edge = begin; edge < end; edge++) {","      let next = select(edge + 1u, begin, edge + 1u == end);","      let first = polygonPosition(edge); let second = polygonPosition(next);","      let normal = cross(first, second);","      ringBoundary = ringBoundary || polygonOnArc(first, second, point, POLYGON_TOLERANCE);","      let numerator = dot(point, normal); let denominator = dot(first, second) - dot(point, first) * dot(point, second);","      if (abs(numerator) + abs(denominator) > 1e-12) { winding += atan2(numerator, denominator); }","    }","    let ringInside = winding > 3.141592653589793;","    if (ring == firstRing) { inside = ringInside; } else { inside = inside && !ringInside; }","    boundary = boundary || ringBoundary;","var accepted = inside;","if (boundary && failure == 0u) { failure = 2u; accepted = true; }","contains[containsOffset + index] = select(0u, 1u, accepted && failure != 1u);","status[statusOffset + index] = failure;"],"strings":["spherical-polygon-contains","read","spherical-polygon-contains-ring-failures","ringOffsets","buffer","spherical-polygon-contains-ring-center","imported","spherical-polygon-contains-ring-centers","vertices","GPUSphericalPolygonContains","spherical-polygon-contains-ring-edges","contains","read_write","status","polygonIndices","polygonOffsets","queries","compute","positions","ringFailures","atomic<u32>","ringCenters","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocati