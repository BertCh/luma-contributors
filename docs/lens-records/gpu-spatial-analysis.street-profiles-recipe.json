 = 0u;","@group(0) @binding(1) var<storage, read> normals: array<f32>;","@group(0) @binding(2) var<storage, read> segments: array<f32>;","const rayHitsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> rayHits: array<f32>;","const validityOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> validity: array<u32>;","fn readSegment(row:u32)->vec4<f32>{let base=segmentsOffset+row*4u;return vec4<f32>(segments[base],segments[base+1u],segments[base+2u],segments[base+3u]);}","fn crossVectors(first:vec2<f32>,second:vec2<f32>)->f32{return first.x*second.y-first.y*second.x;}","// The offset from the segment start is formed first, so the result does not lose digits to the","// magnitude of the coordinates.","fn distanceToSegment(position:vec2<f32>,segment:vec4<f32>)->f32{"," let direction=segment.zw-segment.xy;let offset=position-segment.xy;let squared=dot(direction,direction);var fraction=0.0;"," if(squared>0.0){fraction=clamp(dot(offset,direction)/squared,0.0,1.0);}"," return length(offset-fraction*direction);","// Returns (candidate distance along the ray, 1.0 when the segment blocks the ray, else 0.0).","fn getSegmentCandidate(origin:vec2<f32>,direction:vec2<f32>,maximum:f32,segmentIndex:u32)->vec2<f32>{"," let segment=readSegment(segmentIndex);let edge=segment.zw-segment.xy;let displacement=segment.xy-origin;let denominator=crossVectors(direction,edge);var candidate=maximum;var intersects=false;"," if(distanceToSegment(origin,segment)<=9.999999974752427e-7){candidate=0.0;intersects=true;}"," else if(abs(denominator)>9.999999974752427e-7){","  let rayDistance=crossVectors(displacement,edge)/denominator;let fraction=crossVectors(displacement,direction)/denominator;","  if(rayDistance>=0.0&&fraction>=0.0&&fraction<=1.0){candidate=rayDistance;intersects=true;}"," }else if(abs(crossVectors(displacement,direction))<=9.999999974752427e-7){","  let first=dot(displacement,direction);let second=dot(segment.zw-origin,direction);","  if(max(first,second)>=0.0){candidate=max(0.0,min(first,second));intersects=true;}"," }"," return vec2<f32>(candidate,f32(intersects));","fn castRay(origin:vec2<f32>,direction:vec2<f32>,maximum:f32)->vec2<f32>{"," var nearest=maximum;var hit=-1.0;"," for(var segmentIndex=0u;segmentIndex<2u;segmentIndex++){","  let blocked=getSegmentCandidate(origin,direction,maximum,segmentIndex);","  if(blocked.y>0.0&&blocked.x<=nearest&&(blocked.x<nearest||hit<0.0)){nearest=blocked.x;hit=f32(segmentIndex);}"," return vec2<f32>(nearest,hit);","  _ = &positions;","  _ = &normals;","  _ = &rayHits;","  _ = &validity;","  let origin=vec2<f32>(positions[positionsOffset+2u*index],positions[positionsOffset+2u*index+1u]);","let normal=vec2<f32>(normals[normalsOffset+2u*index],normals[normalsOffset+2u*index+1u]);","let inputValid=isFiniteValue(origin.x)&&isFiniteValue(origin.y)&&isFiniteValue(normal.x)&&isFiniteValue(normal.y)&&isFiniteValue(length(normal))&&length(normal)>0.0;","let missing=bitcast<f32>(0x7fc00000u | (index & 0u));","for(var side=0u;side<2u;side++){","  var hit=vec2<f32>(missing,-1.0);","  if(inputValid){hit=castRay(origin,normalize(normal)*select(1.0,-1.0,side==1u),10);}","  rayHits[rayHitsOffset+4u*index+side]=hit.x;","  rayHits[rayHitsOffset+4u*index+2u+side]=hit.y;","validity[validityOffset+index]=select(8u,0u,inputValid);","const nonFiniteCountOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> nonFiniteCount: array<u32>;","const badOwnerCountOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> badOwnerCount: array<u32>;","@group(0) @binding(2) var<storage, read> owners: array<u32>;","const heightsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> heights: array<f32>;","@group(0) @binding(4) var<storage, read> rayHits: array<f32>;","const profilesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> profiles: array<f32>;","const buildingsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> buildings: array<u32>;","@group(0) @binding(7)