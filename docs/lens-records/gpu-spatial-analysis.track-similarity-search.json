vec2<u32>((lower & 0xffffffu) | (upper << 24u), upper >> 8u);","fn withinRadius(firstPoint: vec2<f32>, secondPoint: vec2<f32>, radius: f32) -> bool {","  if (radius < 0.0 || (bitcast<u32>(radius) & 0x7f800000u) == 0x7f800000u ||","      (bitcast<u32>(firstPoint.x) & 0x7f800000u) == 0x7f800000u || (bitcast<u32>(firstPoint.y) & 0x7f800000u) == 0x7f800000u ||","      (bitcast<u32>(secondPoint.x) & 0x7f800000u) == 0x7f800000u || (bitcast<u32>(secondPoint.y) & 0x7f800000u) == 0x7f800000u) { return false; }","  let offset = abs(firstPoint-secondPoint);","  let exponent = clamp(i32((bitcast<u32>(radius) >> 23u) & 255u)-127, -126, 126);","  let scale = bitcast<f32>(u32(127-exponent) << 23u);","  let normalized = offset*scale; let normalizedRadius = radius*scale;","  let difference = dot(normalized,normalized)-normalizedRadius*normalizedRadius;","  // Tiny-radius subtraction can flush to zero; compare original bits in that range.","  if ((bitcast<u32>(radius) & 0x7f800000u) > 0x00800000u && abs(difference)>0.00001) {","    return difference<0.0;","  }","  var positive: array<u32,18>; var negative: array<u32,18>;","  let firstTerms=array<f32,7>(firstPoint.x,secondPoint.x,firstPoint.x,firstPoint.y,secondPoint.y,firstPoint.y,radius);","  let secondTerms=array<f32,7>(firstPoint.x,secondPoint.x,secondPoint.x,firstPoint.y,secondPoint.y,secondPoint.y,radius);","  for(var term=0u;term<7u;term++) {","  let firstBits = bitcast<u32>(firstTerms[term]); let secondBits = bitcast<u32>(secondTerms[term]);","  let firstMagnitude = firstBits & 0x7fffffffu; let secondMagnitude = secondBits & 0x7fffffffu;","  if (firstMagnitude == 0u || secondMagnitude == 0u) { continue; }","  let firstBiased = firstMagnitude >> 23u; let secondBiased = secondMagnitude >> 23u;","  let firstSignificand = (firstMagnitude & 0x7fffffu) | select(0u, 0x800000u, firstBiased != 0u);","  let secondSignificand = (secondMagnitude & 0x7fffffu) | select(0u, 0x800000u, secondBiased != 0u);","  let firstExponent = select(-149, i32(firstBiased) - 150, firstBiased != 0u);","  let secondExponent = select(-149, i32(secondBiased) - 150, secondBiased != 0u);","  let product = locationMultiply(firstSignificand, secondSignificand);","  let shift = u32(firstExponent + secondExponent + 298) + select(0u, 1u, term == 2u || term == 5u);","  let firstWord = shift / 32u; let bitShift = shift % 32u;","  var pieces: array<u32, 3>;","  pieces[0] = product.x; pieces[1] = product.y;","  if (bitShift != 0u) {","    pieces[0] = product.x << bitShift;","    pieces[1] = (product.y << bitShift) | (product.x >> (32u-bitShift));","    pieces[2] = product.y >> (32u-bitShift);","  let isNegative = (((firstBits ^ secondBits) >> 31u) != 0u) != (term == 2u || term == 5u || term == 6u);","  var carry = 0u;","  for (var word = firstWord; word < 18u; word++) {","    var piece = 0u;","    if (word-firstWord < 3u) { piece = pieces[word-firstWord]; }","    var before = positive[word];","    if (isNegative) { before = negative[word]; }","    let added = before + piece; let total = added + carry;","    carry = select(0u, 1u, added < before || total < added);","    if (isNegative) { negative[word] = total; } else { positive[word] = total; }","  for (var remaining=18u; remaining>0u; remaining--) {","    let word=remaining-1u;","    if (positive[word] != negative[word]) { return positive[word]<negative[word]; }","  return true;","fn pointWithin(a: vec2f, b: vec2f, radius: f32) -> bool {","  return withinRadius(a, b, radius);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positionsA;","  _ = &offsetsA;","  _ = &positionsB;","  _ = &offsetsB;","  _ = &pairA;","  _ = &pairB;","  _ = &bounds;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var nanBits = 0x7fc00000u; bounds[boundsOffset + index] = bitcast<f32>(nanBits);","let first = pairA[pairAOffset + index]; let second = pairB[pairBOffset + index];","if (first >= 1u || second >= 2u) { return; }","let startA = offsetsA[offsetsAOffset + first]; let endA = offsetsA[offsetsAOffset + first + 1u]; let startB = offsetsB[offsetsBOffset + second]; let endB = offsetsB[offsetsBOffset + second + 1u];","if (startA >= endA || endA > 2u || startB >= endB || endB > 4u) { return; }","for (var row = startA; row < endA; row++) { let position = loadA(row); if (!finite(position.x) || !finite(position.y) ) { return; } }","for (var row = startB; row < endB; row++) { let position = loadB(row); if (!finite(position.x) || !finite(position.y) ) { return; } }","let startDifference = loadA(startA) - loadB(startB); let endDifference = loadA(endA - 1u) - loadB(endB - 1u);","bounds[boundsOffset + index] = max(scaledNorm(startDifference), scaledNorm(endDifference));","@group(0) @binding(0) var<storage, read> bounds: array<f32>;","const thresholdOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> threshold: array<f32>;","@group(0) @binding(2) var<storage, read> pairA: array<u32>;","@group(0) @binding(3) var<storage, read> pairB: array<u32>;","const flagsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> flags: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","  _ = &threshold;","  _ = &flags;","  _ = &status;","  let bound = bounds[boundsOffset + index]; let limit = threshold[thresholdOffset];","let valid = (bitcast<u32>(bound) & 0x7f800000u) != 0x7f800000u && (bitcast<u32>(limit) & 0x7f800000u) != 0x7f800000u && limit >= 0.0;","// The small conservative margin retains threshold-neighbor pairs under f32 roundoff.","let pruned = valid && bound > limit + max(bound, 1.0) * 0.000001;","status[statusOffset + index] = select(select(0u, 1u, pruned), 2u, !valid);","flags[flagsOffset + index] = select(0u, 1u, valid && !pruned);","const filteredAOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> filteredA: array<u32>;","const filteredBOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> filteredB: array<u32>;","const ranksOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> ranks: array<u32>;","@group(0) @binding(3) var<storage, read> flags: array<u32>;","const summaryOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> summary: array<u32>;","  _ = &filteredA;","  _ = &filteredB;","  _ = &ranks;","  _ = &summary;","  if (index < 2u) { filteredA[filteredAOffset + index] = 0xffffffffu; filteredB[filteredBOffset + index] = 0xffffffffu; }","if (index == 0u) {","  let count = ranks[ranksOffset + 1u] + flags[flagsOffset + 1u];","  summary[summaryOffset] = count; summary[summaryOffset + 1u] = min(count, 2u); summary[summaryOffset + 2u] = count - min(count, 2u);","@group(0) @binding(0) var<storage, read> ranks: array<u32>;","@group(0) @binding(1) var<storage, read_write> status: array<u32>;","@group(0) @binding(4) var<storage, read_write> filteredA: array<u32>;","@group(0) @binding(5) var<storage, read_write> filteredB: array<u32>;","  if (status[statusOffset + index] != 0u) { return; } let rank = ranks[ranksOffset + index];","if (rank >= 2u) { status[statusOffset + index] = 8u; return; }","filteredA[filteredAOffset + rank] = pairA[pairAOffset + index]; filteredB[filteredBOffset + rank] = pairB[pairBOffset + index];","@group(0) @binding(0) var<storage, read> pairA: array<u32>;","@group(0) @binding(1) var<storage, read> pairB: array<u32>;","@group(0) @binding(2) var<storage, read> offsetsA: array<u32>;","@group(0) @binding(4) var<storage, read> positionsA: array<f32>;","@group(0) @binding(5) var<storage, read> positionsB: array<f32>;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","const PAIR_COUNT: u32 = 2u;","const TRACK_COUNT_A: u32 = 1u;","const TRACK_COUNT_B: u32 = 2u;","const FRECHET_CAP: u32 = 8u;","const DENSIFY: u32 = 1u;","const MAXIMUM_DENSIFIED_VERTICES: u32 = 4294967295u;","const STATUS_EMPTY: u32 = 1u;","const STATUS_TOO_LONG: u32 = 2u;","const STATUS_INVALID: u32 = 12u;","  let a = pairA[pairAOffset + index];","  let b = pairB[pairBOffset + index];","  var flags = 0u;","  ","  if (a >= TRACK_COUNT_A || b >= TRACK_COUNT_B) {","    flags = 4u;","  } else if (flags == 0u) {","    let startA = offsetsA[offsetsAOffset + a];","    let endA = offsetsA[offsetsAOffset + a + 1u];","    let startB = offsetsB[offsetsBOffset + b];","    let endB = offsetsB[offsetsBOffset + b + 1u];","    let countA = endA - min(startA, endA);","    let countB = endB - min(startB, endB);","    if (startA > endA || startB > endB || endA > 2u || endB > 4u) {","      flags = 4u;","    } else if (countA == 0u || countB == 0u) {","      flags = STATUS_EMPTY;","    } else if (true && max(countA - 1u, countB - 1u) > (MAXIMUM_DENSIFIED_VERTICES - 1u) / DENSIFY) {","      // A densified vertex count must fit uint32 before any distance kernel uses it.","    } else if (true && min(countA - 1u, countB - 1u) > (FRECHET_CAP - 1u) / DENSIFY) {","      flags = STATUS_TOO_LONG;","    }","  if ((flags & 5u) == 0u) {","    let aStart = offsetsA[offsetsAOffset + a]; let aEnd = offsetsA[offsetsAOffset + a + 1u];","    let bStart = offsetsB[offsetsBOffset + b]; let bEnd = offsetsB[offsetsBOffset + b + 1u];","    for (var row = aStart; row < aEnd; row++) {","      let x = positionsA[positionsAOffset + row * 2u]; let y = positionsA[positionsAOffset + row * 2u + 1u];","      if ((bitcast<u32>(x) & 0x7f800000u) == 0x7f800000u || (bitcast<u32>(y) & 0x7f800000u) == 0x7f800000u ) { flags = flags | 8u; }","    for (var row = bStart; row < bEnd; row++) {","      let x = positionsB[positionsBOffset + row * 2u]; let y = positionsB[positionsBOffset + row * 2u + 1u];","  if ((flags & 8u) != 0u) { flags = 8u; }","  status[statusOffset + index] = flags;","@group(0) @binding(2) var<storage, read> positionsA: array<f32>;","@group(0) @binding(3) var<storage, read> offsetsA: array<u32>;","@group(0) @binding(4) var<storage, read> positionsB: array<f32>;","@group(0) @binding(5) var<storage, read> offsetsB: array<u32>;","@group(0) @binding(6) var<storage, read> status: array<u32>;","const distancesOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> distances: array<f32>;","const WORKGROUP_SIZE: u32 = 256u;","const LANES: u32 = 256u;","const BAND_RADIUS: u32 = 4294967295u;","const NO_BAND: u32 = 4294967295u;","var<workgroup> olderDiagonal: array<f32, 256>;","var<workgroup> previousDiagonal: array<f32, 256>;","var<workgroup> boundaryRow: array<f32, 8>;","var<workgroup> sharedLongCount: u32;","var<workgroup> sharedShortCount: u32;","fn coupledMetric(swapped: bool, startA: u32, countA: u32, startB: u32, countB: u32, rowLong: u32, rowShort: u32) -> f32 {","  if (swapped) {","    return pointMetric(densifiedPointB(startB, countB, rowLong), densifiedPointA(startA, countA, rowShort));","  return pointMetric(densifiedPointA(startA, countA, rowLong), densifiedPointB(startB, countB, rowShort));","fn coupledWithin(swapped: bool, startA: u32, countA: u32, startB: u32, countB: u32, rowLong: u32, rowShort: u32, radius: f32) -> bool {","  if (swapped) { return pointWithin(densifiedPointB(startB, countB, rowLong), densifiedPointA(startA, countA, rowShort), radius); }","  return pointWithin(densifiedPointA(startA, countA, rowLong), densifiedPointB(startB, countB, rowShort), radius);","// Sakoe-Chiba band of tslearn's sakoe_chiba_mask(sz1, sz2, radius), written in long/short roles","// (tslearn's two branches are the same rule with the roles swapped): long index l is in the band","// of short index s when s - radius <= l <= s + (longCount - shortCount) + radius.","fn isInBand(rowLong: u32, rowShort: u32, longCount: u32, shortCount: u32) -> bool {","  if (BAND_RADIUS == NO_BAND) {","    return true;","  return rowLong + BAND_RADIUS >= rowShort && rowLong <= rowShort + (longCount - shortCount) + BAND_RADIUS;","fn loadA(row: u32) -> vec2<f32> {","  return vec2<f32>(positionsA[positionsAOffset + row * 2u], positionsA[positionsAOffset + row * 2u + 1u]);","fn loadB(row: u32) -> vec2<f32> {","  return vec2<f32>(positionsB[positionsBOffset + row * 2u], positionsB[positionsBOffset + row * 2u + 1u]);","fn segmentEndA(row:u32)->vec2f{return loadA(row+1u);}","fn segmentEndB(row:u32)->vec2f{return loadB(row+1u);}","fn densifiedCount(count: u32) -> u32 {","  return select(0u, (count - 1u) * DENSIFY + 1u, count > 0u);","fn densifiedPointA(start: u32, count: u32, k: u32) -> vec2<f32> {","  let segment = k / DENSIFY;","  let subStep = k - segment * DENSIFY;","  if (subStep == 0u || segment + 1u >= count) { return loadA(start + min(segment, count - 1u)); }","  return interpolatePoint(loadA(start + segment), segmentEndA(start + segment), f32(subStep) / f32(DENSIFY));","fn densifiedPointB(start: u32, count: u32, k: u32) -> vec2<f32> {","  if (subStep == 0u || segment + 1u >= count) { return loadB(start + min(segment, count - 1u)); }","  return interpolatePoint(loadB(start + segment), segmentEndB(start + segment), f32(subStep) / f32(DENSIFY));","fn pointMetric(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let offset = abs(a - b);","  let scale = max(offset.x, offset.y);","fn finishMetric(value: f32) -> f32 {","  return value;","fn interpolatePoint(from0: vec2<f32>, to0: vec2<f32>, fraction: f32) -> vec2<f32> {","  return from0 + (to0 - from0) * fraction;","fn pointSegmentMetric(point: vec2<f32>, from0: vec2<f32>, to0: vec2<f32>) -> f32 {","  let edge = to0 - from0;","  let scale = max(abs(edge.x), abs(edge.y));","  var t = 0.0;","  if (scale > 0.0) {","    let normalizedEdge = edge / scale;","    t = clamp(dot((point - from0) / scale, normalizedEdge) / dot(normalizedEdge, normalizedEdge), 0.0, 1.0);","  let offset = point - (from0 + edge * t);","  return pointMetric(offset, vec2f(0.0));","@compute @workgroup_size(256)","  _ = &distances;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let pair = index / WORKGROUP_SIZE;","  let lane = localInvocationIndex;","  let flags = status[statusOffset + min(pair, PAIR_COUNT - 1u)];","  let skipped = pair >= PAIR_COUNT || (flags & (STATUS_EMPTY | STATUS_INVALID | STATUS_TOO_LONG)) != 0u;","  var startA = 0u;","  var countA = 0u;","  var startB = 0u;","  var countB = 0u;","  if (!skipped) {","    let a = pairA[pairAOffset + pair];","    let b = pairB[pairBOffset + pair];","    startA = offsetsA[offsetsAOffset + a];","    countA = offsetsA[offsetsAOffset + a + 1u] - startA;","    startB = offsetsB[offsetsBOffset + b];","    countB = offsetsB[offsetsBOffset + b + 1u] - startB;","  // A runtime expression keeps the quiet-NaN bit pattern out of const evaluation.","  let notANumber = bitcast<f32>(0x7fc00000u | (index & 0u));","  let infinity = 3.402823466e+38;","  let denseA = densifiedCount(countA);","  let denseB = densifiedCount(countB);","  let swapped = denseB > denseA;","  if (lane == 0u) {","    sharedLongCount = max(denseA, denseB);","    sharedShortCount = min(denseA, denseB);","  // Barrier-bearing loops need bounds the compiler can prove uniform across the workgroup.","  let longCount = workgroupUniformLoad(&sharedLongCount);","  let shortCount = workgroupUniformLoad(&sharedShortCount);","  let stripCount = (longCount + LANES - 1u) / LANES;","  var finalValue = infinity;","  for (var strip = 0u; strip < stripCount; strip++) {","    let firstRow = strip * LANES;","    let rows = min(LANES, longCount - firstRow);","    let diagonalCount = rows + shortCount - 1u;","    olderDiagonal[lane] = infinity;","    previousDiagonal[lane] = infinity;","    workgroupBarrier();","    for (var diagonal = 0u; diagonal < diagonalCount; diagonal++) {","      var value = infinity;","      var column = 0u;","      let isActive = lane < rows && diagonal >= lane && diagonal - lane < shortCount;","      if (isActive) {","        column = diagonal - lane;","        let rowLong = firstRow + lane;","        if (isInBand(rowLong, column, longCount, shortCount)) {","          let cost = finishMetric(coupledMetric(swapped, startA, countA, startB, countB, rowLong, column));","          var up = infinity;","          var upLeft = infinity;","          var left = infinity;","          if (lane > 0u) {","            up = previousDiagonal[lane - 1u];","            upLeft = olderDiagonal[lane - 1u];","          } else if (strip > 0u) {","            up = boundaryRow[column];","            if (column > 0u) { upLeft = boundaryRow[column - 1u]; }","          }","          if (column > 0u) { left = previousDiagonal[lane]; }","          let best = min(min(up, upLeft), left);","          if (rowLong == 0u && column == 0u) {","            value = cost;","          } else if (best < infinity) {","            value = min(best + cost, infinity);","        }","        if (rowLong == longCount - 1u && column == shortCount - 1u) { finalValue = value; }","      }","      workgroupBarrier();","      olderDiagonal[lane] = previousDiagonal[lane];","      previousDiagonal[lane] = value;","      if (isActive && lane == LANES - 1u) { boundaryRow[column] = value; }","  if (!skipped && longCount > 0u && lane == (longCount - 1u) % LANES) {","    distances[distancesOffset + pair] = finalValue;","  } else if (skipped && lane == 0u && pair < PAIR_COUNT) {","    distances[distancesOffset + pair] = notANumber;","const distanceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> distance: array<f32>;","const compactValueOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> compactValue: array<f32>;","@group(0) @binding(3) var<storage, read> threshold: array<f32>;","const programStatusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> programStatus: array<u32>;","const matchedOffset: u32 = 0u;","@group(0) @binding(6