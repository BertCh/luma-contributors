ance","meaning":"Exact evaluated DTW distance; NaN for pruned pairs","role":"output","keySpace":"entry"},{"id":"gpu-spatial-analysis-track-similarity-search-snapshots-lowerBound-0","name":"lowerBound","iteration":0,"elementType":"f32","values":"b64:AAAAAAAAIEE=","provenance":"gpu-readback","graph":"gpu-spatial-analysis-track-similarity-search-compiled","resource":"lowerBound","meaning":"Admissible maximum endpoint distance","role":"output","keySpace":"entry"},{"id":"gpu-spatial-analysis-track-similarity-search-snapshots-matched-0","name":"matched","iteration":0,"elementType":"u32","values":"b64:AQAAAAAAAAA=","provenance":"gpu-readback","graph":"gpu-spatial-analysis-track-similarity-search-compiled","resource":"matched","meaning":"Inclusive threshold membership","role":"output","keySpace":"entry"},{"id":"gpu-spatial-analysis-track-similarity-search-snapshots-status-0","name":"status","iteration":0,"elementType":"u32","values":"same:snapshots.5","provenance":"gpu-readback","graph":"gpu-spatial-analysis-track-similarity-search-compiled","resource":"status","meaning":"Evaluated=0; safely pruned=1","role":"output","keySpace":"entry"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsAOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positionsA: array<f32>;","const offsetsAOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> offsetsA: array<u32>;","const positionsBOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> positionsB: array<f32>;","const offsetsBOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> offsetsB: array<u32>;","const pairAOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> pairA: array<u32>;","const pairBOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read> pairB: array<u32>;","const boundsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> bounds: array<f32>;","fn finite(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn loadA(row: u32) -> vec2<f32> { return vec2<f32>(positionsA[positionsAOffset + 2u * row], positionsA[positionsAOffset + 2u * row + 1u]); }","fn loadB(row: u32) -> vec2<f32> { return vec2<f32>(positionsB[positionsBOffset + 2u * row], positionsB[positionsBOffset + 2u * row + 1u]); }","// Euclidean distance from a point to an axis-aligned box. The polyline of a track lies inside the","// box of its vertices, so this never exceeds the distance from the point to the polyline.","fn boxDistance(point: vec2<f32>, lower: vec2<f32>, upper: vec2<f32>) -> f32 {","  return length(max(max(lower - point, point - upper), vec2<f32>(0.0)));","}","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positionsA;","  _ = &offsetsA;","  _ = &positionsB;","  _ = &offsetsB;","  _ = &pairA;","  _ = &pairB;","  _ = &bounds;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var nanBits = 0x7fc00000u; bounds[boundsOffset + index] = bitcast<f32>(nanBits);","let first = pairA[pairAOffset + index]; let second = pairB[pairBOffset + index];","if (first >= 1u || second >= 2u) { return; }","let startA = offsetsA[offsetsAOffset + first]; let endA = offsetsA[offsetsAOffset + first + 1u]; let startB = offsetsB[offsetsBOffset + second]; let endB = offsetsB[offsetsBOffset + second + 1u];","if (startA >= endA || endA > 2u || startB >= endB || endB > 4u) { return; }","for (var row = startA; row < endA; row++) { let position = loadA(row); if (!finite(position.x) || !finite(position.y)) { return; } }","for (var row = startB; row < endB; row++) { let position = loadB(row); if (!finite(position.x) || !finite(position.y)) { return; } }","let startDifference = loadA(startA) - loadB(startB); let endDifference = loadA(endA - 1u) - loadB(endB - 1u);","bounds[boundsOffset + index] = max(sqrt(dot(startDifference, startDifference)), sqrt(dot(endDifference, endDifference)));","@group(0) @binding(0) var<storage, read> bounds: array<f32>;","const thresholdOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> threshold: array<f32>;","@group(0) @binding(2) var<storage, read> pairA: array<u32>;","@group(0) @binding(3) var<storage, read> pairB: array<u32>;","const flagsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> flags: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","  _ = &threshold;","  _ = &flags;","  _ = &status;","  let bound = bounds[boundsOffset + index]; let limit = threshold[thresholdOffset];","let valid = (bitcast<u32>(bound) & 0x7f800000u) != 0x7f800000u && (bitcast<u32>(limit) & 0x7f800000u) != 0x7f800000u && limit >= 0.0;","// The small conservative margin retains threshold-neighbor pairs under f32 roundoff.","let pruned = valid && bound > limit + max(bound, 1.0) * 0.000001;","status[statusOffset + index] = select(select(0u, 1u, pruned), 2u, !valid);","flags[flagsOffset + index] = select(0u, 1u, valid && !pruned);","const filteredAOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> filteredA: array<u32>;","const filteredBOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> filteredB: array<u32>;","const ranksOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> ranks: array<u32>;","@group(0) @binding(3) var<storage, read> flags: array<u32>;","const summaryOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> summary: array<u32>;","  _ = &filteredA;","  _ = &filteredB;","  _ = &ranks;","  _ = &summary;","  if (index < 2u) { filteredA[filteredAOffset + index] = 0xffffffffu; filteredB[filteredBOffset + index] = 0xffffffffu; }","if (index == 0u) {","  let count = ranks[ranksOffset + 1u] + flags[flagsOffset + 1u];","  summary[summaryOffset] = count; summary[summaryOffset + 1u] = min(count, 2u); summary[summaryOffset + 2u] = count - min(count, 2u);","@group(0) @binding(0) var<storage, read> ranks: array<u32>;","@group(0) @binding(1) var<storage, read_write> status: array<u32>;","@group(0) @binding(4) var<storage, read_write> filteredA: array<u32>;","@group(0) @binding(5) var<storage, read_write> filteredB: array<u32>;","  if (status[statusOffset + index] != 0u) { return; } let rank = ranks[ranksOffset + index];","if (rank >= 2u) { status[statusOffset + index] = 8u; return; }","filteredA[filteredAOffset + rank] = pairA[pairAOffset + index]; filteredB[filteredBOffset + rank] = pairB[pairBOffset + index];","@group(0) @binding(0) var<storage, read> pairA: array<u32>;","@group(0) @binding(1) var<storage, read> pairB: array<u32>;","@group(0) @binding(2) var<storage, read> offsetsA: array<u32>;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","const PAIR_COUNT: u32 = 2u;","const TRACK_COUNT_A: u32 = 1u;","const TRACK_COUNT_B: u32 = 2u;","const FRECHET_CAP: u32 = 8u;","const DENSIFY: u32 = 1u;","const MAXIMUM_DENSIFIED_VERTICES: u32 = 4294967295u;","const STATUS_EMPTY: u32 = 1u;","const STATUS_TOO_LONG: u32 = 2u;","const STATUS_INVALID: u32 = 4u;","  let a = pairA[pairAOffset + index];","  let b = pairB[pairBOffset + index];","  var flags = 0u;","  ","  if (a >= TRACK_COUNT_A || b >= TRACK_COUNT_B) {","    flags = STATUS_INVALID;","  } else if (flags == 0u) {","    let startA = offsetsA[offsetsAOffset + a];","    let endA = offsetsA[offsetsAOffset + a + 1u];","    let startB = offsetsB[offsetsBOffset + b];","    let endB = offsetsB[offsetsBOffset + b + 1u];","    let countA = endA - min(startA, endA);","    let countB = endB - min(startB, endB);","    if (startA > endA || startB > endB || endA > 2u || endB > 4u) {","      flags = STATUS_INVALID;","    } else if (countA == 0u || countB == 0u) {","      flags = STATUS_EMPTY;","    } else if (true && max(countA - 1u, countB - 1u) > (MAXIMUM_DENSIFIED_VERTICES - 1u) / DENSIFY) {","      // A densified vertex count must fit uint32 before any distance kernel uses it.","    } else if (true && min(countA - 1u, countB - 1u) > (FRECHET_CAP - 1u) / DENSIFY) {","      flags = STATUS_TOO_LONG;","    }","  status[statusOffset + index] = flags;","@group(0) @binding(2) var<storage, read> positionsA: array<f32>;","@group(0) @binding(3) var<storage, read> offsetsA: array<u32>;","@group(0) @binding(4) var<storage, read> positionsB: array<f32>;","@group(0) @binding(5) var<storage, read> offsetsB: array<u32>;","@group(0) @binding(6) var<storage, read> status: array<u32>;","const distancesOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> distances: array<f32>;","const WORKGROUP_SIZE: u32 = 256u;","const LANES: u32 = 256u;","const BAND_RADIUS: u32 = 4294967295u;","const NO_BAND: u32 = 4294967295u;","var<workgroup> olderDiagonal: array<f32, 256>;","var<workgroup> previousDiagonal: array<f32, 256>;","var<workgroup> boundaryRow: array<f32, 8>;","var<workgroup> sharedLongCount: u32;","var<workgroup> sharedShortCount: u32;","fn coupledMetric(swapped: bool, startA: u32, countA: u32, startB: u32, countB: u32, rowLong: u32, rowShort: u32) -> f32 {","  if (swapped) {","    return pointMetric(densifiedPointB(startB, countB, rowLong), densifiedPointA(startA, countA, rowShort));","  return pointMetric(densifiedPointA(startA, countA, rowLong), densifiedPointB(startB, countB, rowShort));","// Sakoe-Chiba band of tslearn's sakoe_chiba_mask(sz1, sz2, radius), written in long/short roles","// (tslearn's two branches are the same rule with the roles swapped): long index l is in the band","// of short index s when s - radius <= l <= s + (longCount - shortCount) + radius.","fn isInBand(rowLong: u32, rowShort: u32, longCount: u32, shortCount: u32) -> bool {","  if (BAND_RADIUS == NO_BAND) {","    return true;","  return rowLong + BAND_RADIUS >= rowShort && rowLong <= rowShort + (longCount - shortCount) + BAND_RADIUS;","fn loadA(row: u32) -> vec2<f32> {","  return vec2<f32>(positionsA[positionsAOffset + row * 2u], positionsA[positionsAOffset + row * 2u + 1u]);","fn loadB(row: u32) -> vec2<f32> {","  return vec2<f32>(positionsB[positionsBOffset + row * 2u], positionsB[positionsBOffset + row * 2u + 1u]);","fn densifiedCount(count: u32) -> u32 {","  return select(0u, (count - 1u) * DENSIFY + 1u, count > 0u);","fn densifiedPointA(start: u32, count: u32, k: u32) -> vec2<f32> {","  let segment = k / DENSIFY;","  let subStep = k - segment * DENSIFY;","  if (subStep == 0u || segment + 1u >= count) { return loadA(start + min(segment, count - 1u)); }","  return interpolatePoint(loadA(start + segment), loadA(start + segment + 1u), f32(subStep) / f32(DENSIFY));","fn densifiedPointB(start: u32, count: u32, k: u32) -> vec2<f32> {","  if (subStep == 0u || segment + 1u >= count) { return loadB(start + min(segment, count - 1u)); }","  return interpolatePoint(loadB(start + segment), loadB(start + segment + 1u), f32(subStep) / f32(DENSIFY));","fn pointMetric(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let offset = a - b;","  return dot(offset, offset);","fn finishMetric(value: f32) -> f32 {","  return sqrt(value);","fn interpolatePoint(from0: vec2<f32>, to0: vec2<f32>, fraction: f32) -> vec2<f32> {","  return from0 + (to0 - from0) * fraction;","fn pointSegmentMetric(point: vec2<f32>, from0: vec2<f32>, to0: vec2<f32>) -> f32 {","  let edge = to0 - from0;","  let lengthSquared = dot(edge, edge);","  var t = 0.0;","  if (lengthSquared > 0.0) { t = clamp(dot(point - from0, edge) / lengthSquared, 0.0, 1.0); }","  let offset = point - (from0 + edge * t);","@compute @workgroup_size(256)","  _ = &distances;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let pair = index / WORKGROUP_SIZE;","  let lane = localInvocationIndex;","  let flags = status[statusOffset + min(pair, PAIR_COUNT - 1u)];","  let skipped = pair >= PAIR_COUNT || (flags & (STATUS_EMPTY | STATUS_INVALID | STATUS_TOO_LONG)) != 0u;","  var startA = 0u;","  var countA = 0u;","  var startB = 0u;","  var countB = 0u;","  if (!skipped) {","    let a = pairA[pairAOffset + pair];","    let b = pairB[pairBOffset + pair];","    startA = offsetsA[offsetsAOffset + a];","    countA = offsetsA[offsetsAOffset + a + 1u] - startA;","    startB = offsetsB[offsetsBOffset + b];","    countB = offsetsB[offsetsBOffset + b + 1u] - startB;","  // A runtime expression keeps the quiet-NaN bit pattern out of const evaluation.","  let notANumber = bitcast<f32>(0x7fc00000u | (index & 0u));","  let infinity = 3.402823466e+38;","  let denseA = densifiedCount(countA);","  let denseB = densifiedCount(countB);","  let swapped = denseB > denseA;","  if (lane == 0u) {","    sharedLongCount = max(denseA, denseB);","    sharedShortCount = min(denseA, denseB);","  // Barrier-bearing loops need bounds the compiler can prove uniform across the workgroup.","  let longCount = workgroupUniformLoad(&sharedLongCount);","  let shortCount = workgroupUniformLoad(&sharedShortCount);","  let stripCount = (longCount + LANES - 1u) / LANES;","  var finalValue = infinity;","  for (var strip = 0u; strip < stripCount; strip++) {","    let firstRow = strip * LANES;","    let rows = min(LANES, longCount - firstRow);","    let diagonalCount = rows + shortCount - 1u;","    olderDiagonal[lane] = infinity;","    previousDiagonal[lane] = infinity;","    workgroupBarrier();","    for (var diagonal = 0u; diagonal < diagonalCount; diagonal++) {","      var value = infinity;","      var column = 0u;","      let isActive = lane < rows && diagonal >= lane && diagonal - lane < shortCount;","      if (isActive) {","        column = diagonal - lane;","        let rowLong = firstRow + lane;","        if (isInBand(rowLong, column, longCount, shortCount)) {","          let cost = finishMetric(coupledMetric(swapped, startA, countA, startB, countB, rowLong, column));","          var up = infinity;","          var upLeft = infinity;","          var left = infinity;","          if (lane > 0u) {","            up = previousDiagonal[lane - 1u];","            upLeft = olderDiagonal[lane - 1u];","          } else if (strip > 0u) {","            up = boundaryRow[column];","            if (column > 0u) { upLeft = boundaryRow[column - 1u]; }","          }","          if (column > 0u) { left = previousDiagonal[lane]; }","          let best = min(min(up, upLeft), left);","          if (rowLong == 0u && column == 0u) {","            value = cost;","          } else if (best < infinity) {","            value = min(best + cost, infinity);","        }","        if (rowLong == longCount - 1u && column == shortCount - 1u) { finalValue = value; }","      }","      workgroupBarrier();","      olderDiagonal[lane] = previousDiagonal[lane];","      previousDiagonal[lane] = value;","      if (isActive && lane == LANES - 1u) { boundaryRow[column] = value; }","  if (!skipped && longCount > 0u && lane == (longCount - 1u) % LANES) {","    distances[distancesOffset + pair] = finalValue;","  } else if (skipped && lane == 0u && pair < PAIR_COUNT) {","    distances[distancesOffset + pair] = notANumber;","const distanceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> distance: array<f32>;","const compactValueOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> compactValue: array<f32>;","@group(0) @binding(3) var<storage, read> threshold: array<f32>;","const programStatusOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> programStatus: array<u32>;","const matchedOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> matched: array<u32>;","  _ = &distance;","  _ = &compactValue;","  _ = &programStatus;","  _ = &matched;","  var nanBits = 0x7fc00000u; distance[distanceOffset + index] = bitcast<f32>(nanBits);","if (status[statusOffset + index] == 0u) { let rank = ranks[ranksOffset + index];","  distance[distanceOffset + index] = compactValue[compactValueOffset + rank];","  if ((programStatus[programStatusOffset + rank] & 0xffffffffu) != 0u) { status[statusOffset + index] = select(2u, 4u, (programStatus[programStatusOffset + rank] & 2u) != 0u); }","matched[matchedOffset + index] = select(0u, 1u, status[statusOffset + index] == 0u && distance[distanceOffset + index] <= threshold[thresholdOffset]);"],"strings":["read","status","buffer","logical","gpu-spatial-analysis-track-similarity-search-snapshot-tap","read_write","track-similarity-search-filtered-a","track-similarity-search-filtered-b","track-similarity-search-finish","pairA","pairB","offsetsA","offsetsB","track-similarity-search-bound","track-similarity-search-clear-survivors","track-similarity-search-compact","track-similarity-search-ranks","transient","GPUTrackSimilaritySearch","track-similarity-search-program-status","lowerBound","track-similarity-search-flags","track-similarity-search-metric-dynamic-time-warping","track-similarity-search-prune","compute","positionsA","positionsB","threshold","distance","imported","matched","track-similarity-search-compact-value","track-similarity-search-metric-status","track-similarity-search-survivor-scan-level-0-scan","GPUTrackSimilarity","track-similarity-search-survivor-summary","ranks","GPUScan","bounds","filteredA","filteredB","flags"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLe