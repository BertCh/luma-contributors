 partials[lane] = min(partials[lane], partials[lane + stride]); }","          workgroupBarrier();","        }","        worst = max(worst, partials[0]);","      }","    } else {","      let chunk = (pointCount + WORKGROUP_SIZE - 1u) / WORKGROUP_SIZE;","      let chunkStart = min(lane * chunk, pointCount);","      let chunkEnd = min(chunkStart + chunk, pointCount);","      var hint = 0u;","      for (var i = chunkStart; i < chunkEnd; i++) {","        let nearest = distanceToPolylineB(densifiedPointA(startA, countA, i), startB, countB, worst, &hint);","        worst = max(worst, nearest);","    let pointCount = uniformDenseB;","        let point = densifiedPointB(startB, countB, i);","        partials[lane] = cooperativeDistanceToPolylineA(point, startA, countA, lane);","        let nearest = distanceToPolylineA(densifiedPointB(startB, countB, i), startA, countA, worst, &hint);","  partials[lane] = worst;","  for (var stride = WORKGROUP_SIZE / 2u; stride > 0u; stride = stride / 2u) {","    if (lane < stride) { partials[lane] = max(partials[lane], partials[lane + stride]); }","    workgroupBarrier();","  if (lane == 0u && pair < PAIR_COUNT) {","    distances[distancesOffset + pair] = select(finishMetric(partials[0]), notANumber, skipped);","  var farthest = 0.0;","  // Lanes stride over the longer track and scan the shorter one, so a short track next to a long","  // one does not leave most lanes idle. The maximum is order independent.","  if (countA >= countB) {","    for (var i = lane; i < countA; i += WORKGROUP_SIZE) {","      let point = loadA(startA + i);","      for (var j = 0u; j < countB; j++) {","        farthest = max(farthest, pointMetric(point, loadB(startB + j)));","  } else {","    for (var j = lane; j < countB; j += WORKGROUP_SIZE) {","      let point = loadB(startB + j);","      for (var i = 0u; i < countA; i++) {","        farthest = max(farthest, pointMetric(point, loadA(startA + i)));","  partials[lane] = farthest;","const WORKGROUP_SIZE: u32 = 256u;","const LANES: u32 = 256u;","var<workgroup> olderDiagonal: array<f32, 256>;","var<workgroup> previousDiagonal: array<f32, 256>;","var<workgroup> boundaryRow: array<f32, 512>;","var<workgroup> sharedLongCount: u32;","var<workgroup> sharedShortCount: u32;","// Metric value between densified vertex rowLong of the longer track and rowShort of the other.","fn coupledSquared(swapped: bool, startA: u32, countA: u32, startB: u32, countB: u32, rowLong: u32, rowShort: u32) -> f32 {","  if (swapped) {","    return pointMetric(densifiedPointB(startB, countB, rowLong), densifiedPointA(startA, countA, rowShort));","  return pointMetric(densifiedPointA(startA, countA, rowLong), densifiedPointB(startB, countB, rowShort));","@compute @workgroup_size(256)","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let skipped = pair >= PAIR_COUNT || (flags & (STATUS_EMPTY | STATUS_INVALID | STATUS_TOO_LONG)) != 0u;","  let infinity = 3.402823466e+38;","  let swapped = denseB > denseA;","    sharedLongCount = max(denseA, denseB);","    sharedShortCount = min(denseA, denseB);","  // Barrier-bearing loops need bounds the compiler can prove uniform across the workgroup.","  let longCount = workgroupUniformLoad(&sharedLongCount);","  let shortCount = workgroupUniformLoad(&sharedShortCount);","  var finalValue = infinity;","  let stripCount = (longCount + LANES - 1u) / LANES;","  for (var strip = 0u; strip < stripCount; strip++) {","    let firstRow = strip * LANES;","    let rows = min(LANES, longCount - firstRow);","    let diagonalCount = rows + shortCount - 1u;","    olderDiagonal[lane] = infinity;","    previousDiagonal[lane] = infinity;","    for (var diagonal = 0u; diagonal < diagonalCount; diagonal++) {","      var value = infinity;","      var column = 0u;","      let isActive = lane < rows && diagonal >= lane && diagonal - lane < shortCount;","      if (isActive) {","        column = diagonal - lane;","        let cost = coupledSquared(swapped, startA, countA, startB, countB, firstRow + lane, column);","        let hasUp = lane > 0u || strip > 0u;","        let hasLeft = column > 0u;","        var up = infinity;","        var upLeft = infinity;","        var left = infinity;","        if (lane > 0u) {","          up = previousDiagonal[lane - 1u];","          upLeft = olderDiagonal[lane - 1u];","        } else if (strip > 0u) {","          up = boundaryRow[column];","          if (hasLeft) { upLeft = boundaryRow[column - 1u]; }","        if (hasLeft) { left = previousDiagonal[lane]; }","        if (!hasUp && !hasLeft) {","          value = cost;","        } else if (!hasUp) {","          value = max(left, cost);","        } else if (!hasLeft) {","          value = max(up, cost);","        } else {","          value = max(min(min(up, upLeft), left), cost);","        if (firstRow + lane == longCount - 1u && column == shortCount - 1u) { finalValue = value; }","      workgroupBarrier();","      olderDiagonal[lane] = previousDiagonal[lane];","      previousDiagonal[lane] = value;","      if (isActive && lane == LANES - 1u) { boundaryRow[column] = value; }","  if (!skipped && longCount > 0u && lane == (longCount - 1u) % LANES) {","    distances[distancesOffset + pair] = finishMetric(finalValue);","  } else if (skipped && lane == 0u && pair < PAIR_COUNT) {","    distances[distancesOffset + pair] = notANumber;"],"strings":["read","pairStatus","pairA","pairB","positions","trackOffsets","gpu-spatial-analysis-track-similarity-snapshot-tap","track-similarity-status","GPUTrackSimilarity","buffer","logical","frechet","hausdorff","track-similarity-frechet","maximumDistance","status","track-similarity-hausdorff","track-similarity-max-distance","compute","imported","offsetsA","offsetsB","positionsA","positionsB","read_write","transient","distances"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bin