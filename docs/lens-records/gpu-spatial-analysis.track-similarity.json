st fit uint32 before any distance kernel uses it.","    } else if (true && min(countA - 1u, countB - 1u) > (FRECHET_CAP - 1u) / DENSIFY) {","      flags = STATUS_TOO_LONG;","    }","  status[statusOffset + index] = flags;","}","const positionsAOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> positionsA: array<f32>;","@group(0) @binding(3) var<storage, read> offsetsA: array<u32>;","const positionsBOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> positionsB: array<f32>;","@group(0) @binding(5) var<storage, read> offsetsB: array<u32>;","@group(0) @binding(6) var<storage, read> status: array<u32>;","const distancesOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> distances: array<f32>;","const WORKGROUP_SIZE: u32 = 64u;","var<workgroup> partials: array<f32, 64>;","var<workgroup> sharedDenseA: u32;","var<workgroup> sharedDenseB: u32;","fn loadA(row: u32) -> vec2<f32> {","  return vec2<f32>(positionsA[positionsAOffset + row * 2u], positionsA[positionsAOffset + row * 2u + 1u]);","fn loadB(row: u32) -> vec2<f32> {","  return vec2<f32>(positionsB[positionsBOffset + row * 2u], positionsB[positionsBOffset + row * 2u + 1u]);","fn densifiedCount(count: u32) -> u32 {","  return select(0u, (count - 1u) * DENSIFY + 1u, count > 0u);","fn densifiedPointA(start: u32, count: u32, k: u32) -> vec2<f32> {","  let segment = k / DENSIFY;","  let subStep = k - segment * DENSIFY;","  if (subStep == 0u || segment + 1u >= count) { return loadA(start + min(segment, count - 1u)); }","  return interpolatePoint(loadA(start + segment), loadA(start + segment + 1u), f32(subStep) / f32(DENSIFY));","fn densifiedPointB(start: u32, count: u32, k: u32) -> vec2<f32> {","  if (subStep == 0u || segment + 1u >= count) { return loadB(start + min(segment, count - 1u)); }","  return interpolatePoint(loadB(start + segment), loadB(start + segment + 1u), f32(subStep) / f32(DENSIFY));","fn pointMetric(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let offset = a - b;","  return dot(offset, offset);","fn finishMetric(value: f32) -> f32 {","  return sqrt(value);","fn interpolatePoint(from0: vec2<f32>, to0: vec2<f32>, fraction: f32) -> vec2<f32> {","  return from0 + (to0 - from0) * fraction;","fn pointSegmentMetric(point: vec2<f32>, from0: vec2<f32>, to0: vec2<f32>) -> f32 {","  let edge = to0 - from0;","  let lengthSquared = dot(edge, edge);","  var t = 0.0;","  if (lengthSquared > 0.0) { t = clamp(dot(point - from0, edge) / lengthSquared, 0.0, 1.0); }","  let offset = point - (from0 + edge * t);","// Metric value (squared distance, or the context's length unit on the sphere) from a point to polyline A; may stop early once it is at most worst.","fn distanceToPolylineA(point: vec2<f32>, start: u32, count: u32, worst: f32, hint: ptr<function, u32>) -> f32 {","  if (count == 1u) {","    return pointMetric(point, loadA(start));","  let segments = count - 1u;","  var nearest = 3.402823466e+38;","  var first = *hint;","  if (first >= segments) { first = 0u; }","  for (var step = 0u; step < segments; step++) {","    var j = first + step;","    if (j >= segments) { j -= segments; }","    let squared = pointSegmentMetric(point, loadA(start + j), loadA(start + j + 1u));","    if (squared < nearest) {","      nearest = squared;","      *hint = j;","      if (nearest <= worst) { break; }","  return nearest;","// Cooperative minimum over the segments of polyline A: every lane takes a stride of segments.","fn cooperativeDistanceToPolylineA(point: vec2<f32>, start: u32, count: u32, lane: u32) -> f32 {","  for (var j = lane; j + 1u < count; j += WORKGROUP_SIZE) {","    nearest = min(nearest, pointSegmentMetric(point, loadA(start + j), loadA(start + j + 1u)));","// Metric value (squared distance, or the context's length unit on the sphere) from a point to polyline B; may stop early once it is at most worst.","fn distanceToPolylineB(point: vec2<f32>, start: u32, count: u32, worst: f32, hint: ptr<function, u32>) -> f32 {","    return pointMetric(point, loadB(start));","    let squared = pointSegmentMetric(point, loadB(start + j), loadB(start + j + 1u));","// Cooperative minimum over the segments of polyline B: every lane takes a stride of segments.","fn cooperativeDistanceToPolylineB(point: vec2<f32>, start: u32, count: u32, lane: u32) -> f32 {","    nearest = min(nearest, pointSegmentMetric(point, loadB(start + j), loadB(start + j + 1u)));","@compute @workgroup_size(64)","  _ = &positionsA;","  _ = &positionsB;","  _ = &distances;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  let pair = index / WORKGROUP_SIZE;","  let lane = localInvocationIndex;","  let flags = status[statusOffset + min(pair, PAIR_COUNT - 1u)];","  let skipped = pair >= PAIR_COUNT || (flags & (STATUS_EMPTY | STATUS_INVALID)) != 0u;","  var startA = 0u;","  var countA = 0u;","  var startB = 0u;","  var countB = 0u;","  if (!skipped) {","    let a = pairA[pairAOffset + pair];","    let b = pairB[pairBOffset + pair];","    startA = offsetsA[offsetsAOffset + a];","    countA = offsetsA[offsetsAOffset + a + 1u] - startA;","    startB = offsetsB[offsetsBOffset + b];","    countB = offsetsB[offsetsBOffset + b + 1u] - startB;","  // A runtime expression keeps the quiet-NaN bit pattern out of const evaluation.","  let notANumber = bitcast<f32>(0x7fc00000u | (index & 0u));","  var worst = 0.0;","  let denseA = densifiedCount(countA);","  let denseB = densifiedCount(countB);","  if (lane == 0u) {","    sharedDenseA = denseA;","    sharedDenseB = denseB;","  workgroupBarrier();","  let uniformDenseA = workgroupUniformLoad(&sharedDenseA);","  let uniformDenseB = workgroupUniformLoad(&sharedDenseB);","  {","    let pointCount = uniformDenseA;","    if (pointCount * 8u <= WORKGROUP_SIZE) {","      for (var i = 0u; i < pointCount; i++) {","        let point = densifiedPointA(startA, countA, i);","        partials[lane] = cooperativeDistanceToPolylineB(point, startB, countB, lane);","        workgroupBarrier();","        for (var stride = WORKGROUP_SIZE / 2u; stride > 0u; stride = stride / 2u) {","          if (lane < stride) { partials[lane] = min(partials[lane], partials[lane + stride]); }","          workgroupBarrier();","        }","        worst = max(worst, partials[0]);","      }","    } else {","      let chunk = (pointCount + WORKGROUP_SIZE - 1u) / WORKGROUP_SIZE;","      let chunkStart = min(lane * chunk, pointCount);","      let chunkEnd = min(chunkStart + chunk, pointCount);","      var hint = 0u;","      for (var i = chunkStart; i < chunkEnd; i++) {","        let nearest = distanceToPolylineB(densifiedPointA(startA, countA, i), startB, countB, worst, &hint);","        worst = max(worst, nearest);","    let pointCount = uniformDenseB;","        let point = densifiedPointB(startB, countB, i);","        partials[lane] = cooperativeDistanceToPolylineA(point, startA, countA, lane);","        let nearest = distanceToPolylineA(densifiedPointB(startB, countB, i), startA, countA, worst, &hint);","  partials[lane] = worst;","  for (var stride = WORKGROUP_SIZE / 2u; stride > 0u; stride = stride / 2u) {","    if (lane < stride) { partials[lane] = max(partials[lane], partials[lane + stride]); }","    workgroupBarrier();","  if (lane == 0u && pair < PAIR_COUNT) {","    distances[distancesOffset + pair] = select(finishMetric(partials[0]), notANumber, skipped);","  var farthest = 0.0;","  // Lanes stride over the longer track and scan the shorter one, so a short track next to a long","  // one does not leave most lanes idle. The maximum is order independent.","  if (countA >= countB) {","    for (var i = lane; i < countA; i += WORKGROUP_SIZE) {","      let point = loadA(startA + i);","      for (var j = 0u; j < countB; j++) {","        farthest = max(farthest, pointMetric(point, loadB(startB + j)));","  } else {","    for (var j = lane; j < countB; j += WORKGROUP_SIZE) {","      let point = loadB(startB + j);","      for (var i = 0u; i < countA; i++) {","        farthest = max(farthest, pointMetric(point, loadA(startA + i)));","  partials[lane] = farthest;","const WORKGROUP_SIZE: u32 = 256u;","const LANES: u32 = 256u;","var<workgroup> olderDiagonal: array<f32, 256>;","var<workgroup> previousDiagonal: array<f32, 256>;","var<workgroup> boundaryRow: array<f32, 512>;","var<workgroup> sharedLongCount: u32;","var<workgroup> sharedShortCount: u32;","// Metric value between densified vertex rowLong of the longer track and rowShort of the other.","fn coupledSquared(swapped: bool, startA: u32, countA: u32, startB: u32, countB: u32, rowLong: u32, rowShort: u32) -> f32 {","  if (swapped) {","    return pointMetric(densifiedPointB(startB, countB, rowLong), densifiedPointA(startA, countA, rowShort));","  return pointMetric(densifiedPointA(startA, countA, rowLong), densifiedPointB(startB, countB, rowShort));","@compute @workgroup_size(256)","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let skipped = pair >= PAIR_COUNT || (flags & (STATUS_EMPTY | STATUS_INVALID | STATUS_TOO_LONG)) != 0u;","  let infinity = 3.402823466e+38;","  let swapped = denseB > denseA;","    sharedLongCount = max(denseA, denseB);","    sharedShortCount = min(denseA, denseB);","  // Barrier-bearing loops need bounds the compiler can prove uniform across the workgroup.","  let longCount = workgroupUniformLoad(&sharedLongCount);","  let shortCount = workgroupUniformLoad(&sharedShortCount);","  var finalValue = infinity;","  let stripCount = (longCount + LANES - 1u) / LANES;","  for (var strip = 0u; strip < stripCount; strip++) {","    let firstRow = strip * LANES;","    let rows = min(LANES, longCount - firstRow);","    let diagonalCount = rows + shortCount - 1u;","    olderDiagonal[lane] = infinity;","    previousDiagonal[lane] = infinity;","    for (var diagonal = 0u; diagonal < diagonalCount; diagonal++) {","      var value = infinity;","      var column = 0u;","      let isActive = lane < rows && diagonal >= lane && diagonal - lane < shortCount;","      if (isActive) {","        column = diagonal - lane;","        let cost = coupledSquared(swapped, startA, countA, startB, countB, firstRow + lane, column);","        let hasUp = lane > 0u || strip > 0u;","        let hasLeft = column > 0u;","        var up = infinity;","        var upLeft = infinity;","        var left = infinity;","        if (lane > 0u) {","          up = previousDiagonal[lane - 1u];","          upLeft = olderDiagonal[lane - 1u];","        } else if (strip > 0u) {","          up = boundaryRow[column];","          if (hasLeft) { upLeft = boundaryRow[column - 1u]; }","        if (hasLeft) { left = previousDiagonal[lane]; }","        if (!hasUp && !hasLeft) {","          value = cost;","        } else if (!hasUp) {","          value = max(left, cost);","        } else if (!hasLeft) {","          value = max(up, cost);","        } else {","          value = max(min(min(up, upLeft), left), cost);","        if (firstRow + lane == longCount - 1u && column == shortCount - 1u) { finalValue = value; }","      workgroupBarrier();","      olderDiagonal[lane] = previousDiagonal[lane];","      previousDiagonal[lane] = value;","      if (isActive && lane == LANES - 1u) { boundaryRow[column] = value; }","  if (!skipped && longCount > 0u && lane == (longCount - 1u) % LANES) {","    distances[distancesOffset + pair] = finishMetric(finalValue);","  } else if (skipped && lane == 0u && pair < PAIR_COUNT) {","    distances[distancesOffset + pair] = notANumber;"],"strings":["read","pairStatus","pairA","pairB","trackOffsets","gpu-spatial-analysis-track-similarity-snapshot-tap","positions","track-similarity-status","GPUTrackSimilarity","buffer","logical","frechet","hausdorff","track-similarity-frechet","maximumDistance","track-similarity-hausdorff","status","track-similarity-max-distance","compute","imported","offsetsA","offsetsB","read_write","transient","distances","positionsA","positionsB"],"shapes":[["id","form","domain",