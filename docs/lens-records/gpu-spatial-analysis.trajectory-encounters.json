dexSpace":"1d"}],"relations":[]},"refs":{"formulas":[{"id":"s3.trajectory-encounters","derivation":"curated","tex":"\\term{count}{C}=|\\term{hits}{H}|,\\quad \\term{minimum}{d_{\\min}}=\\min_{\\term{index}{k}\\in\\term{hits}{H}}\\term{distances}{d_k},\\quad \\term{first}{k_0}=\\min\\term{hits}{H}","ascii":"For each emitted track pair, H is the nonempty set of shared clock buckets whose valid samples are within min(distance, maximumDistance). bucketCounts=|H|; minimumDistances=min over H of d[k]; firstBuckets=min H. Distances are Euclidean or great-circle. These are discrete hits only, and scratch overflow may make H incomplete.","symbols":[{"id":"count","role":"output","binding":"wgsl:bucketCounts"},{"id":"minimum","role":"output","binding":"wgsl:minimumDistances"},{"id":"first","role":"output","binding":"wgsl:firstBuckets"},{"id":"hits","role":"input","label":"Sorted bucket run for one pair","binding":"wgsl:sortedBuckets"},{"id":"distances","role":"input","binding":"wgsl:sortedDistances"},{"id":"index","role":"index"}]}],"sources":[{"id":"wgsl:ad05a94e","language":"wgsl","moduleId":"GPUTrajectoryResample/clock","hash":"ad05a94e","bodyHash":"6b967824","entryPoint":"main","textLines":[[0,16],0,[16,3],0,0,[19,2],18,0,[21,2],18,0,0,[23,2],18,0,[25,2],18,0,0,[27,2],18,0,[29,4],18,0,[33,2],18,[35,2],18,0,[37,53],84,78,[90,13],77,103,78,[104,4],107,55,[108,4],55,[112,2],58,58,[114,2],18]},{"id":"wgsl:32d74ec0","language":"wgsl","moduleId":"GPUTrajectoryEncounters/clear","hash":"32d74ec0","bodyHash":"50e88f8d","entryPoint":"main","textLines":[[0,4],[116,2],0,0,118,[38,4],119,[47,4],[120,2],[53,3],122,18]},{"id":"wgsl:e11ee449","language":"wgsl","moduleId":"GPUTrajectoryEncounters/positions","hash":"e11ee449","bodyHash":"c51e0dc8","entryPoint":"main","textLines":[[0,4],12,123,4,124,0,[125,11],0,[37,5],46,42,[47,9],[136,4],58,58,[140,3],18]},{"id":"wgsl:3b6de711","language":"wgsl","moduleId":"GPUTrajectoryEncounters/scan","hash":"3b6de711","bodyHash":"60041aec","entryPoint":