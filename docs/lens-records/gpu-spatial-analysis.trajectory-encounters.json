elementType":"u32","values":"b64:AAAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-encounters-compiled","resource":"pairOverflow","meaning":"gpu-spatial-analysis-trajectory-encounters-snapshot-tap","role":"intermediate"},{"id":"gpu-spatial-analysis-trajectory-encounters-snapshots-candidateOverflow-0","name":"candidateOverflow","iteration":0,"elementType":"u32","values":"same:snapshots.6","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-encounters-compiled","resource":"candidateOverflow","meaning":"gpu-spatial-analysis-trajectory-encounters-snapshot-tap","role":"intermediate"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const trackOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> trackOffsets: array<u32>;","const timestampsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> timestamps: array<f32>;","const clockParametersOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> clockParameters: array<f32>;","const samplesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> samples: array<f32>;","const ROW_COUNT: u32 = 771u;","const SAMPLE_COUNT: u32 = 120u;","fn getRowTimeDifference(a: u32, b: u32) -> f32 {","  return timestamps[timestampsOffset + a] - timestamps[timestampsOffset + b];","}","fn getClockOffset(firstRow: u32) -> f32 {","  return clockParameters[clockParametersOffset] - timestamps[timestampsOffset + firstRow];","fn getClockStep() -> f32 {","  return clockParameters[clockParametersOffset + 1u];","fn interpolatePosition(a: vec2<f32>, b: vec2<f32>, fraction: f32) -> vec2<f32> {","  return select(a + (b - a) * fraction, b, fraction >= 1.0);","fn getSegmentLength(a: vec2<f32>, b: vec2<f32>) -> f32 {","  return length(b - a);","fn guardedAtan2(y: f32, x: f32) -> f32 {","  return select(atan2(y, x), sign(y) * 1.5707963267948966, x == 0.0);","fn getSegmentHeading(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let delta = b - a;","  // delta.x is -0.0 for a due north or south step from x = +0 to x = -0.","  return select(0.0, guardedAtan2(delta.y, delta.x), delta.x != 0.0 || delta.y != 0.0);","fn getProgress(row: u32, firstRow: u32) -> f32 {","  return getRowTimeDifference(row, firstRow);","fn getPosition(row: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &trackOffsets;","  _ = &timestamps;","  _ = &clockParameters;","  _ = &samples;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let track = index / SAMPLE_COUNT;","  let sampleIndex = index - track * SAMPLE_COUNT;","  ","  let trackStart = min(trackOffsets[trackOffsetsOffset + track], ROW_COUNT);","  let trackEnd = clamp(trackOffsets[trackOffsetsOffset + track + 1u], trackStart, ROW_COUNT);","  var position = vec2<f32>(0.0, 0.0);","  var elevation = 0.0;","  var time = 0.0;","  let clockStep = getClockStep();","  var isAbsent = trackEnd <= trackStart;","  if (trackEnd > trackStart) {","    let lastRow = trackEnd - 1u;","    let total = getProgress(lastRow, trackStart);","    var targetProgress = 0.0;","    targetProgress = getClockOffset(trackStart) + f32(sampleIndex) * clockStep;","    isAbsent = !(targetProgress >= 0.0 && targetProgress <= total);","    if (false) {","      targetProgress = select(","        total * (f32(sampleIndex) / f32(SAMPLE_COUNT - 1u)),","        total,","        sampleIndex == SAMPLE_COUNT - 1u","      );","    }","    var low = trackStart + 1u;","    var high = trackEnd;","    loop {","      if (low >= high) {","        break;","      }","      let middle = (low + high) / 2u;","      if (getProgress(middle, trackStart) > targetProgress) {","        high = middle;","      } else {","        low = middle + 1u;","    // Past the last row: the end of the last segment, so a great-circle track keeps its longitude","    // continuous across the antimeridian (planar: exactly the last row).","    var row0 = select(lastRow, lastRow - 1u, lastRow > trackStart);","    var row1 = lastRow;","    var fraction = 1.0;","    if (low < trackEnd) {","      row0 = low - 1u;","      row1 = low;","      let startProgress = getProgress(row0, trackStart);","      fraction = clamp(","        (targetProgress - startProgress) / (getProgress(row1, trackStart) - startProgress),","        0.0,","        1.0","      ","    let startPosition = getPosition(row0);","    let endPosition = getPosition(row1);","    position = interpolatePosition(startPosition, endPosition, fraction);","    ","  if (isAbsent) {","    // A runtime expression keeps the quiet-NaN bit pattern out of const evaluation.","    position = vec2<f32>(bitcast<f32>(0x7fc00000u | (index & 0u)));","    elevation = position.x;","  samples[samplesOffset + 2u * index] = position.x;","  samples[samplesOffset + 2u * index + 1u] = position.y;","  _ = elevation;","  _ = time;","const stateOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> state: array<u32>;","@compute @workgroup_size(32)","  _ = &state;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  state[stateOffset] = 0u;","@group(0) @binding(0) var<storage, read> samples: array<f32>;","@group(0) @binding(1) var<storage, read_write> positions: array<f32>;","const TRACK_COUNT: u32 = 12u;","const BUCKET_COUNT: u32 = 120u;","const HIT_CAPACITY: u32 = 65536u;","const PAIR_CAPACITY: u32 = 66u;","const COLUMNS: u32 = 32u;","const ROWS: u32 = 42u;","const MINIMUM_X: f32 = 7750.0;","const MINIMUM_Y: f32 = 6750.0;","const MAXIMUM_X: f32 = 15750.0;","const MAXIMUM_Y: f32 = 17250.0;","const CELL_SIZE: f32 = 250.0;","  let track = index / BUCKET_COUNT;","  let bucket = index % BUCKET_COUNT;","  var x = samples[samplesOffset + index * 2u];","  var y = samples[samplesOffset + index * 2u + 1u];","  positions[positionsOffset + index * 3u] = x;","  positions[positionsOffset + index * 3u + 1u] = y;","  positions[positionsOffset + index * 3u + 2u] = f32(bucket) + 0.5;","const cellOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> cellOffsets: array<u32>;","const objectIdsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> objectIds: array<u32>;","const distanceOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> distance: array<f32>;","@group(0) @binding(4) var<storage, read_write> state: array<atomic<u32>>;","const hitPairsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> hitPairs: array<u32>;","const hitBucketsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> hitBuckets: array<u32>;","const hitDistancesOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> hitDistances: array<f32>;","// The maximum is a sentinel: counts beyond uint32 must not wrap back into an output prefix.","const TRAJECTORY_COUNT_MAXIMUM: u32 = 0xffffffffu;","fn reserveTrajectoryCount() -> u32 {","  var currentCount = atomicLoad(&state[stateOffset]);","  loop {","    if (currentCount == TRAJECTORY_COUNT_MAXIMUM) { return currentCount; }","    let comparison = atomicCompareExchangeWeak(&state[stateOffset], currentCount, currentCount + 1u);","    if (comparison.exchanged) { return currentCount; }","    currentCount = comparison.old_value;","const FLOAT32_MAXIMUM: f32 = 3.402823466e+38;","const NO_FEATURE: u32 = 0xffffffffu;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// Same rule as the GPUGridIndex build, so a point and its query agree on the cell. luma.gl does not","// export the rule; encounter-grid-coordinate-pin.node.spec.ts compares this text with the published","// kernel, so keep the two identical.","fn getCoordinate(value: f32, minimum: f32, maximum: f32, size: u32) -> u32 {","  if (maximum == minimum || value == minimum) { return 0u; }","  if (value == maximum) { return size - 1u; }","  if (minimum < 0.0 && maximum > 0.0) {","    let scale = max(abs(minimum), abs(maximum));","    let scaledValue = value / scale;","    let scaledMinimum = minimum / scale;","    let scaledMaximum = maximum / scale;","    return min(u32((scaledValue - scaledMinimum) / (scaledMaximum - scaledMinimum) * f32(size)), size - 1u);","  return min(u32((value - minimum) / (maximum - minimum) * f32(size)), size - 1u);","  _ = &cellOffsets;","  _ = &objectIds;","  _ = &distance;","  _ = &hitPairs;","  _ = &hitBuckets;","  _ = &hitDistances;","  let x = positions[positionsOffset + index * 3u];","  let y = positions[positionsOffset + index * 3u + 1u];","  if (!isFiniteValue(x) || !isFiniteValue(y)) { return; }","  if (x < MINIMUM_X || x > MAXIMUM_X || y < MINIMUM_Y || y > MAXIMUM_Y) { return; }","  let searchDistance = distance[distanceOffset];","  if (!(searchDistance >= 0.0)) { return; }","  let limit = min(searchDistance, CELL_SIZE);","  let column = getCoordinate(x, MINIMUM_X, MAXIMUM_X, COLUMNS);","  let row = getCoordinate(y, MINIMUM_Y, MAXIMUM_Y, ROWS);","  // Half-shell traversal: the own cell plus the four forward neighbours (east, and the three","  // cells of the next row at columns -1, 0, +1). Every unordered pair of adjacent cells is visited","  // from exactly one side, so each pair is tested once instead of twice. Inside the own cell the","  // higher track is the partner. A track has one sample per bucket, so another cell never holds","  // the same track.","  for (var shell = 0u; shell < 5u; shell++) {","    var neighborColumn = column;","    var neighborRow = row;","    if (shell == 1u) { neighborColumn = column + 1u; }","    else if (shell == 2u) { neighborColumn = column - 1u; neighborRow = row + 1u; }","    else if (shell == 3u) { neighborRow = row + 1u; }","    else if (shell == 4u) { neighborColumn = column + 1u; neighborRow = row + 1u; }","    // Unsigned wrap of column - 1u at column 0 gives a value above COLUMNS, rejected here.","    if (neighborColumn >= COLUMNS || neighborRow >= ROWS) { continue; }","    let cell = (bucket * ROWS + neighborRow) * COLUMNS + neighborColumn;","    let cellBegin = cellOffsets[cellOffsetsOffset + cell];","    let cellEnd = cellOffsets[cellOffsetsOffset + cell + 1u];","    for (var entry = cellBegin; entry < cellEnd; entry++) {","      let other = objectIds[objectIdsOffset + entry];","      let otherTrack = other / BUCKET_COUNT;","      if (shell == 0u && otherTrack <= track) { continue; }","      let offset = vec2f(","        positions[positionsOffset + other * 3u] - x,","        positions[positionsOffset + other * 3u + 1u] - y","      let separation = length(offset);","      if (separation <= limit) {","        let slot = reserveTrajectoryCount();","        if (slot < HIT_CAPACITY) {","          hitPairs[hitPairsOffset + slot * 2u] = min(track, otherTrack);","          hitPairs[hitPairsOffset + slot * 2u + 1u] = max(track, otherTrack);","          hitBuckets[hitBucketsOffset + slot] = bucket;","          hitDistances[hitDistancesOffset + slot] = separation;","        }","@group(0) @binding(0) var<storage, read> state: array<u32>;","@group(0) @binding(1) var<storage, read> hitPairs: array<u32>;","@group(0) @binding(2) var<storage, read> hitBuckets: array<u32>;","const identityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> identity: array<u32>;","const keysOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> keys: array<u32>;","const PARTNER_SHIFT: u32 = 7u;","const TRACK_SHIFT: u32 = 11u;","  _ = &identity;","  _ = &keys;","  let activeCount = min(state[stateOffset], HIT_CAPACITY);","  identity[identityOffset + index] = index;","  var key = TRACK_COUNT << TRACK_SHIFT;","  if (index < activeCount) {","    key = (hitPairs[hitPairsOffset + index * 2u] << TRACK_SHIFT)","      | (hitPairs[hitPairsOffset + index * 2u + 1u] << PARTNER_SHIFT)","      | hitBuckets[hitBucketsOffset + index];","  keys[keysOffset + index] = key;","const flagOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> flag: array<u32>;","  _ = &flag;","  flag[flagOffset] = select(0u, 1u, state[stateOffset] > HIT_CAPACITY);","const hitOverflowOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> hitOverflow: array<u32>;","const gridOverflowOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> gridOverflow: array<u32>;","const candidateOverflowOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> candidateOverflow: array<u32>;","  _ = &hitOverflow;","  _ = &gridOverflow;","  _ = &candidateOverflow;","  candidateOverflow[candidateOverflowOffset] =","  select(0u, 1u, hitOverflow[hitOverflowOffset] != 0u || gridOverflow[gridOverflowOffset] != 0u);","const orderOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> order: array<u32>;","const sortedKeysOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> sortedKeys: array<u32>;","@group(0) @binding(3) var<storage, read> hitDistances: array<f32>;","const sortedTracksOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> sortedTracks: array<u32>;","const sortedPartnersOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> sortedPartners: array<u32>;","const sortedBucketsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> sortedBuckets: array<u32>;","const sortedDistancesOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> sortedDistances: array<f32>;","const BUCKET_MASK: u32 = 127u;","const PARTNER_MASK: u32 = 15u;","  _ = &order;","  _ = &sortedKeys;","  _ = &sortedTracks;","  _ = &sortedPartners;","  _ = &sortedBuckets;","  _ = &sortedDistances;","  if (index >= min(state[stateOffset], HIT_CAPACITY)) {","    sortedTracks[sortedTracksOffset + index] = 0xffffffffu;","    sortedPartners[sortedPartnersOffset + index] = 0xffffffffu;","    sortedBuckets[sortedBucketsOffset + index] = 0xffffffffu;","    sortedDistances[sortedDistancesOffset + index] = 0.0;","  let key = sortedKeys[sortedKeysOffset + index];","  sortedTracks[sortedTracksOffset + index] = key >> TRACK_SHIFT;","  sortedPartners[sortedPartnersOffset + index] = (key >> PARTNER_SHIFT) & PARTNER_MASK;","  sortedBuckets[sortedBucketsOffset + index] = key & BUCKET_MASK;","  sortedDistances[sortedDistancesOffset + index] = hitDistances[hitDistancesOffset + order[orderOffset + index]];","@group(0) @binding(1) var<storage, read> sortedTracks: array<u32>;","@group(0) @binding(2) var<storage, read> sortedPartners: array<u32>;","const flagsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> flags: array<u32>;","const rowIdsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> rowIds: array<u32>;","  _ = &flags;","  _ = &rowIds;","  rowIds[rowIdsOffset + index] = index;","  var isStart = index < min(state[stateOffset], HIT_CAPACITY);","  if (isStart && index > 0u) {","    isStart = sortedTracks[sortedTracksOffset + index] != sortedTracks[sortedTracksOffset + index - 1u]","      || sortedPartners[sortedPartnersOffset + index] != sortedPartners[sortedPartnersOffset + index - 1u];","  flags[flagsOffset + index] = select(0u, 1u, isStart);","const runStartsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> runStarts: array<u32>;","const runCountOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> runCount: array<u32>;","@group(0) @binding(2) var<storage, read> sortedTracks: array<u32>;","@group(0) @binding(3) var<storage, read> sortedPartners: array<u32>;","const idsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> ids: array<u32>;","const partnersOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> partners: array<u32>;","@compute @workgroup_size(128)","  _ = &runStarts;","  _ = &runCount;","  _ = &ids;","  _ = &partners;","  if (workgroupIndex >= 33554432u) { return; }","  let index = workgroupIndex * 128u + localInvocationIndex;","  let isLive = index < min(runCount[runCountOffset], PAIR_CAPACITY);","  let start = select(0u, runStarts[runStartsOffset + index], isLive);","  ids[idsOffset + index] = select(0xffffffffu, sortedTracks[sortedTracksOffset + start], isLive);","  partners[partnersOffset + index] = select(0xffffffffu, sortedPartners[sortedPartnersOffset + start], isLive);","@group(0) @binding(1) var<storage, read> runStarts: array<u32>;","@group(0) @binding(2) var<storage, read> runCount: array<u32>;","@group(0) @binding(3) var<storage, read> sortedBuckets: array<u32>;","@group(0) @binding(4) var<storage, read> sortedDistances: array<f32>;","const firstBucketsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> firstBuckets: array<u32>;","const minimumDistancesOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> minimumDistances: array<f32>;","const bucketCountsOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> bucketCounts: array<u32>;","  _ = &firstBuckets;","  _ = &minimumDistances;","  _ = &bucketCounts;","  let hitTotal = min(state[stateOffset], HIT_CAPACITY);","  var end = start;","  if (isLive) {","    end = hitTotal;","    // Run boundaries belong to the complete hit scratch, even when output pairs are truncated.","    if (index + 1u < runCount[runCountOffset]) { end = runStarts[runStartsOffset + index + 1u]; }","  // Hits of one pair are in bucket order, so the run start is the first encounter.","  var minimumDistance = sortedDistances[sortedDistancesOffset + start];","  for (var hit = start + 1u; hit < end; hit++) {","    minimumDistance = min(minimumDistance, sortedDistances[sortedDistancesOffset + hit]);","  firstBuckets[firstBucketsOffset + index] = select(0xffffffffu, sortedBuckets[sortedBucketsOffset + start], isLive);","  minimumDistances[minimumDistancesOffset + index] = select(0.0, minimumDistance, isLive);","  bucketCounts[bucketCountsOffset + index] = select(0u, end - start, isLive);","const totalInOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> totalIn: array<u32>;","const countOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> countOut: array<u32>;","const overflowOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> overflowOut: array<u32>;","override CAPACITY: u32;","  _ = &totalIn;","  _ = &countOut;","  _ = &overflowOut;","  let total = totalIn[totalInOffset];","  let count = min(total, CAPACITY);","  if (index == 0u) {","    countOut[countOutOffset] = count;","    overflowOut[overflowOutOffset] = select(0u, 1u, total > CAPACITY);"],"strings":["buffer","compute","GPUScan","logical","read","lower-bound","unknown","transient","read_write","trajectory-encounters-state","GPUTrajectoryEncounters","trajectory-encounters-scan","trajectory-encounters-composite-keys","trajectory-encounters-positions","trajectory-encounters-sorted-hits","gpu-spatial-analysis-trajectory-encounters-snapshot-tap","trajectory-encounters-run-flags","trajectory-encounters-reduce-statistics","trajectory-encounters-cell-offsets","trajectory-encounters-composite-sort-radix-digit-8-scatter","trajectory-encounters-composite-sort-radix-digit-0-scatter","trajectory-encounters-composite-sort-radix-digit-12-scatter","trajectory-encounters-composite-sort-radix-digit-4-scatter","trajectory-encounters-runs-scatter","trajectory-encounters-composite-sort-radix-scratch-keys","subgroups","trajectory-encounters-composite-sorted-keys","trajectory-encounters-reduce-identity","trajectory-resample-samples","trajectory-encounters-run-count","trajectory-encounters-c