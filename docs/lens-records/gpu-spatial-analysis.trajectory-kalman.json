f (index >= INVOCATION_COUNT) {","    return;","  }","  var value = 0.0;","if (index < 4u) { value = inputParameters[inputParametersOffset + index]; }","metadata[metadataOffset + index] = value;","}","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const originsOffset: u32 = 4u;","@group(0) @binding(1) var<storage, read_write> origins: array<f32>;","const timesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> times: array<f32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> offsets: array<u32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> parameters: array<f32>;","const stateOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> state: array<f32>;","const covarianceOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> covariance: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> status: array<u32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","const OBSERVATION_COUNT: u32 = 2u;","fn finite(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn transition(delta: f32) -> mat2x2<f32> { return mat2x2<f32>(1.0, 0.0, delta, 1.0); }","fn processCovariance(delta: f32, noise: f32) -> mat2x2<f32> {","  return mat2x2<f32>(delta * delta * delta / 3.0, delta * delta / 2.0, delta * delta / 2.0, delta) * noise;","fn unpackCovariance(packed: vec4<f32>) -> mat2x2<f32> { return mat2x2<f32>(packed.xy, packed.zw); }","fn packCovariance(matrix: mat2x2<f32>) -> vec4<f32> { return vec4<f32>(matrix[0][0], (matrix[0][1] + matrix[1][0]) * 0.5, (matrix[0][1] + matrix[1][0]) * 0.5, matrix[1][1]); }","fn isRowTimeFinite(row: u32) -> bool { return finite(times[timesOffset + row]); }","fn rowElapsed(row: u32, previous: u32) -> f32 { return times[timesOffset + row] - times[timesOffset + previous]; }","fn getAdditionRoundingError(first: f32, second: f32, sum: f32) -> f32 {","  let firstBits = bitcast<u32>(first);","  let secondBits = bitcast<u32>(second);","  let sumBits = bitcast<u32>(sum);","  let firstMagnitude = firstBits & 0x7fffffffu;","  let secondMagnitude = secondBits & 0x7fffffffu;","  let sumMagnitude = sumBits & 0x7fffffffu;","  // A zero operand makes the addition exact; an infinity or a NaN has no rounding error to report.","  if (firstMagnitude == 0u || secondMagnitude == 0u ||","      max(max(firstMagnitude, secondMagnitude), sumMagnitude) >= 0x7f800000u) {","    return 0.0;","  let firstIsLarger = firstMagnitude >= secondMagnitude;","  let largerBits = select(secondBits, firstBits, firstIsLarger);","  let smallerBits = select(firstBits, secondBits, firstIsLarger);","  let largerMagnitude = largerBits & 0x7fffffffu;","  let smallerMagnitude = smallerBits & 0x7fffffffu;","  // Biased exponents (1 for subnormals) and 24-bit significands: |value| = significand * 2^(exponent - 150).","  let largerExponent = max(largerMagnitude >> 23u, 1u);","  let smallerExponent = max(smallerMagnitude >> 23u, 1u);","  let sumExponent = max(sumMagnitude >> 23u, 1u);","  // Below 2^-103 the error would be subnormal, where ldexp is not dependable: report none.","  if (smallerExponent < 24u) {","  let gap = largerExponent - smallerExponent;","  if (gap > 25u) {","    // The smaller operand is below a quarter of the larger one's last place: the sum is the larger","    // operand and the whole smaller operand is the error.","    if (sumBits == largerBits) {","      return bitcast<f32>(smallerBits);","    }","  // The sum's last place, as a left shift from the smaller operand's last place. A rounded sum has","  // the larger operand's exponent, the next one (a carry) or the one below (a borrow). Anything","  // lower is a cancellation, which is exact, and so is a sum whose last place is finer than the","  // smaller operand's.","  if (sumMagnitude == 0u || sumExponent + 1u < largerExponent || sumExponent > largerExponent + 1u ||","      sumExponent < smallerExponent) {","  let sumShift = sumExponent - smallerExponent;","  let largerSignificand = (largerMagnitude & 0x7fffffu) | select(0u, 0x800000u, largerMagnitude >= 0x800000u);","  let smallerSignificand = (smallerMagnitude & 0x7fffffu) | select(0u, 0x800000u, smallerMagnitude >= 0x800000u);","  let sumSignificand = (sumMagnitude & 0x7fffffu) | select(0u, 0x800000u, sumMagnitude >= 0x800000u);","  // Signed integers in units of the smaller operand's last place, modulo 2^32. Each term can pass","  // 2^32, but their combination is at most 2^25 in magnitude, so the wrapped result is exact.","  let largerUnits = largerSignificand << gap;","  let sumUnits = sumSignificand << sumShift;","  let signedLarger = select(largerUnits, 0u - largerUnits, (largerBits & 0x80000000u) != 0u);","  let signedSmaller = select(smallerSignificand, 0u - smallerSignificand, (smallerBits & 0x80000000u) != 0u);","  let signedSum = select(sumUnits, 0u - sumUnits, (sumBits & 0x80000000u) != 0u);","  let errorUnits = bitcast<i32>(signedLarger + signedSmaller - signedSum);","  // The rounding error of an addition is an f32, so the conversion and the scaling are exact.","  return ldexp(f32(errorUnits), i32(smallerExponent) - 150);","fn getMultiplicationRoundingError(first: f32, second: f32, product: f32) -> f32 {","  let productBits = bitcast<u32>(product);","  // Biased exponents: |value| = significand * 2^(exponent - 150) for a normal value.","  let firstExponent = (firstBits >> 23u) & 0xffu;","  let secondExponent = (secondBits >> 23u) & 0xffu;","  let productExponent = (productBits >> 23u) & 0xffu;","  if (firstExponent == 0u || secondExponent == 0u || productExponent == 0u ||","      firstExponent == 255u || secondExponent == 255u || productExponent == 255u) {","  // The exact product is exactSignificand * 2^(firstExponent + secondExponent - 300), with a","  // significand of 47 or 48 bits. The error is scaled by one ldexp whose exponent is kept at","  // -126 or above, where ldexp is dependable: operands whose binary exponents sum to less than","  // -80 report no error (every product below 2^-80, and those below 2^-79 whose significands","  // multiply to 2 or more).","  let exponentSum = firstExponent + secondExponent;","  if (exponentSum < 174u) {","  let firstSignificand = (firstBits & 0x7fffffu) | 0x800000u;","  let secondSignificand = (secondBits & 0x7fffffu) | 0x800000u;","  // 48-bit product of the two 24-bit significands, as two 24-bit limbs.","  let firstHigh = firstSignificand >> 12u;","  let firstLow = firstSignificand & 0xfffu;","  let secondHigh = secondSignificand >> 12u;","  let secondLow = secondSignificand & 0xfffu;","  let middle = firstHigh * secondLow + firstLow * secondHigh;","  let lowSum = firstLow * secondLow + ((middle & 0xfffu) << 12u);","  let exactLow = lowSum & 0xffffffu;","  let exactHigh = firstHigh * secondHigh + (middle >> 12u) + (lowSum >> 24u);","  // The significand of the rounded product sits 23, 24 or 25 bits above the last place of the","  // exact product (25 when the rounding carried into the next binade).","  let shift = productExponent + 150u - exponentSum;","  if (shift < 23u || shift > 25u) {","  let productSignificand = (productBits & 0x7fffffu) | 0x800000u;","  var roundedHigh = productSignificand;","  var roundedLow = 0u;","  if (shift == 23u) {","    roundedHigh = productSignificand >> 1u;","    roundedLow = (productSignificand & 1u) << 23u;","  } else if (shift == 25u) {","    roundedHigh = productSignificand << 1u;","  // Exact as an integer. Its conversion to f32 is exact for a correctly rounded product (at","  // most 2^24 units); for a product one or two steps off it can need 25 bits and is rounded.","  let errorUnits = (i32(exactHigh) - i32(roundedHigh)) * 16777216 + (i32(exactLow) - i32(roundedLow));","  let magnitude = ldexp(f32(errorUnits), i32(exponentSum) - 300);","  // The exact product has the sign of the operands' signs combined; so has its error's scale.","  return select(magnitude, -magnitude, ((firstBits ^ secondBits) & 0x80000000u) != 0u);","struct KalmanPosition { high: vec2<f32>, low: vec2<f32> }","fn kalmanAdditionError(first: vec2<f32>, second: vec2<f32>, sum: vec2<f32>) -> vec2<f32> {","  return vec2<f32>(getAdditionRoundingError(first.x, second.x, sum.x), getAdditionRoundingError(first.y, second.y, sum.y));","fn kalmanPositionNormalize(high: vec2<f32>, low: vec2<f32>) -> KalmanPosition {","  let sum = high + low;","  return KalmanPosition(sum, kalmanAdditionError(high, low, sum));","fn kalmanPositionAdd(first: KalmanPosition, second: KalmanPosition) -> KalmanPosition {","  let high = first.high + second.high;","  let low = (first.low + second.low) + kalmanAdditionError(first.high, second.high, high);","  return kalmanPositionNormalize(high, low);","fn kalmanPositionSubtract(first: KalmanPosition, second: KalmanPosition) -> KalmanPosition {","  return kalmanPositionAdd(first, KalmanPosition(-second.high, -second.low));","fn kalmanPositionProduct(first: vec2<f32>, second: vec2<f32>) -> KalmanPosition {","  let high = first * second;","  return KalmanPosition(high, vec2<f32>(getMultiplicationRoundingError(first.x, second.x, high.x), getMultiplicationRoundingError(first.y, second.y, high.y)));","fn kalmanPositionScale(position: KalmanPosition, scale: vec2<f32>) -> KalmanPosition {","  return kalmanPositionAdd(kalmanPositionProduct(position.high, scale), kalmanPositionProduct(position.low, scale));","fn kalmanPositionMultiply(matrix: mat2x2<f32>, position: KalmanPosition) -> KalmanPosition {","  return kalmanPositionAdd(kalmanPositionScale(KalmanPosition(vec2<f32>(position.high.x), vec2<f32>(position.low.x)), matrix[0]), kalmanPositionScale(KalmanPosition(vec2<f32>(position.high.y), vec2<f32>(position.low.y)), matrix[1]));","fn kalmanPositionAdvance(position: KalmanPosition, velocity: vec2<f32>, delta: f32) -> KalmanPosition {","  return kalmanPositionAdd(position, kalmanPositionProduct(velocity, vec2<f32>(delta)));","fn kalmanPositionValue(position: KalmanPosition) -> vec2<f32> { return position.high + position.low; }","fn loadState(row: u32) -> vec4<f32> { let offset = stateOffset + 4u * row; return vec4<f32>(state[offset], state[offset + 1u], state[offset + 2u], state[offset + 3u]); }","fn storeState(row: u32, value: vec4<f32>) { let offset = stateOffset + 4u * row; state[offset] = value.x; state[offset + 1u] = value.y; state[offset + 2u] = value.z; state[offset + 3u] = value.w; }","fn loadCovariance(row: u32) -> vec4<f32> { let offset = covarianceOffset + 4u * row; return vec4<f32>(covariance[offset], covariance[offset + 1u], covariance[offset + 2u], covariance[offset + 3u]); }","fn storeCovariance(row: u32, value: vec4<f32>) { let offset = covarianceOffset + 4u * row; covariance[offset] = value.x; covariance[offset + 1u] = value.y; covariance[offset + 2u] = value.z; covariance[offset + 3u] = value.w; }","  _ = &positions;","  _ = &origins;","  _ = &times;","  _ = &offsets;","  _ = &parameters;","  _ = &state;","  _ = &covariance;","  _ = &status;","  let start = min(offsets[offsetsOffset + index], OBSERVATION_COUNT);","let end = min(offsets[offsetsOffset + index + 1u], OBSERVATION_COUNT);","let noise = parameters[parametersOffset];","let measurementVariance = parameters[parametersOffset + 1u];","let velocityVariance = parameters[parametersOffset + 2u];","let maximumGap = select(parameters[parametersOffset + 3u], 3.402823466e+38, parameters[parametersOffset + 3u] == 0.0);","let parametersValid = finite(noise) && noise >= 0.0 && finite(measurementVariance) && measurementVariance > 0.0 && finite(velocityVariance) && velocityVariance >= 0.0 && maximumGap > 0.0;","let invalidValue = getNaN();","var initialized = false;","var estimate = vec4<f32>(0.0);","var origin = vec2<f32>(0.0);","var uncertainty = mat2x2<f32>();","var previousObservation = start;","for (var observation = start; observation < end; observation++) {","  origins[originsOffset + 4u * observation] = 0.0;","  origins[originsOffset + 4u * observation + 1u] = 0.0;","  let position = vec2<f32>(positions[positionsOffset + 2u * observation], positions[positionsOffset + 2u * observation + 1u]);","  let measured = finite(position.x) && finite(position.y);","  let elapsed = rowElapsed(observation, previousObservation);","  let delta = elapsed;","  var flags = 0u;","  storeState(observation, vec4<f32>(invalidValue));","  storeCovariance(observation, vec4<f32>(invalidValue));","  if (!parametersValid || !isRowTimeFinite(observation) || (initialized && elapsed < 0.0)) {","    status[statusOffset + observation] = 4u;","    initialized = false;","    continue;","  if (initialized && elapsed > maximumGap) { initialized = false; }","  if (!initialized) {","    if (!measured) { status[statusOffset + observation] = 6u; continue; }","    origin = position;","    estimate = vec4<f32>(0.0);","    uncertainty = mat2x2<f32>(measurementVariance, 0.0, 0.0, velocityVariance);","    initialized = true;","    flags = 1u;","  } else {","    let prediction = transition(delta);","    let predictedPosition = kalmanPositionAdvance(KalmanPosition(origin, estimate.xy), estimate.zw, delta);","    origin = predictedPosition.high;","    estimate = vec4<f32>(predictedPosition.low, estimate.zw);","    uncertainty = prediction * uncertainty * transpose(prediction) + processCovariance(delta, noise);","    if (measured) {","      let innovationVariance = uncertainty[0][0] + measurementVariance;","      if (!finite(innovationVariance) || !(innovationVariance > 0.0)) { status[statusOffset + observation] = 4u; initialized = false; continue; }","      let gain = vec2<f32>(uncertainty[0][0], uncertainty[0][1]) / innovationVariance;","      let residual = kalmanPositionSubtract(KalmanPosition(position, vec2<f32>(0.0)), KalmanPosition(origin, estimate.xy));","      let updatedPosition = kalmanPositionAdd(KalmanPosition(origin, estimate.xy), kalmanPositionScale(residual, vec2<f32>(gain.x)));","      estimate = vec4<f32>(updatedPosition.low, estimate.zw + kalmanPositionValue(kalmanPositionScale(residual, vec2<f32>(gain.y))));","      origin = updatedPosition.high;","      // Joseph form preserves positive semidefiniteness under f32 rounding.","      let correction = mat2x2<f32>(1.0 - gain.x, -gain.y, 0.0, 1.0);","      uncertainty = correction * uncertainty * transpose(correction) + mat2x2<f32>(gain * gain.x, gain * gain.y) * measurementVariance;","    } else { flags = 2u; }","  previousObservation = observation;","  let packed = packCovariance(uncertainty);","  let absolutePosition = estimate.xy + origin;","  if (!finite(absolutePosition.x) || !finite(absolutePosition.y) || !finite(estimate.x) || !finite(estimate.y) || !finite(estimate.z) || !finite(estimate.w) || !finite(packed.x) || !finite(packed.y) || !finite(packed.w)) {","    status[statusOffset + observation] = 4u; initialized = false; continue;","  storeState(observation, estimate);","  origins[originsOffset + 4u * observation] = origin.x;","  origins[originsOffset + 4u * observation + 1u] = origin.y;","  storeCovariance(observation, packed);","  status[statusOffset + observation] = flags;","@group(0) @binding(0) var<storage, read> times: array<f32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","@group(0) @binding(2) var<storage, read_write> parameters: array<f32>;","@group(0) @binding(3) var<storage, read> state: array<f32>;","@group(0) @binding(4) var<storage, read> covariance: array<f32>;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","const smoothedStateOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> smoothedState: array<f32>;","const smoothedCovarianceOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> smoothedCovariance: array<f32>;","fn rowOrigin(row: u32) -> vec2<f32> { let base = parametersOffset + 4u + 4u * row; return vec2<f32>(parameters[base], parameters[base + 1u]); }","fn rowSmoothedOrigin(row: u32) -> vec2<f32> { let base = parametersOffset + 4u + 4u * row + 2u; return vec2<f32>(parameters[base], parameters[base + 1u]); }","fn storeSmoothedOrigin(row: u32, origin: vec2<f32>) { let base = parametersOffset + 4u + 4u * row + 2u; parameters[base] = origin.x; parameters[base + 1u] = origin.y; }fn loadState(row: u32) -> vec4<f32> { let offset = stateOffset + 4u * row; return vec4<f32>(state[offset], state[offset + 1u], state[offset + 2u], state[offset + 3u]); }","fn loadSmoothedState(row: u32) -> vec4<f32> { let offset = smoothedStateOffset + 4u * row; return vec4<f32>(smoothedState[offset], smoothedState[offset + 1u], smoothedState[offset + 2u], smoothedState[offset + 3u]); }","fn storeSmoothedState(row: u32, value: vec4<f32>) { let offset = smoothedStateOffset + 4u * row; smoothedState[offset] = value.x; smoothedState[offset + 1u] = value.y; smoothedState[offset + 2u] = value.z; smoothedState[offset + 3u] = value.w; }","fn loadSmoothedCovariance(row: u32) -> vec4<f32> { let offset = smoothedCovarianceOffset + 4u * row; return vec4<f32>(smoothedCovariance[offset], smoothedCovariance[offset + 1u], smoothedCovariance[offset + 2u], smoothedCovariance[offset + 3u]); }","fn storeSmoothedCovariance(row: u32, value: vec4<f32>) { let offset = smoothedCovarianceOffset + 4u * row; smoothedCovariance[offset] = value.x; smoothedCovariance[offset + 1u] = value.y; smoothedCovariance[offset + 2u] = value.z; smoothedCovariance[offset + 3u] = value.w; }","  _ = &smoothedState;","  _ = &smoothedCovariance;","var observation = end;","loop {","  if (observation <= start) { break; }","  observation--;","  let estimate = loadState(observation);","  let uncertainty = unpackCovariance(loadCovariance(observation));","  storeSmoothedState(observation, estimate);","  storeSmoothedOrigin(observation, rowOrigin(observation));","  storeSmoothedCovariance(observation, packCovariance(uncertainty));","  if (observation + 1u >= end || (status[statusOffset + observation] & 4u) != 0u || (status[statusOffset + observation + 1u] & 5u) != 0u) { continue; }","  let elapsed = rowElapsed(observation + 1u, observation);","  let prediction = transition(delta);","  let predictedCovariance = prediction * uncertainty * transpose(prediction) + processCovariance(delta, noise);","  let determinant = predictedCovariance[0][0] * predictedCovariance[1][1] - predictedCovariance[0][1] * predictedCovariance[1][0];","  // Singular deterministic velocity covariance has no inverse; its forward estimate remains valid.","  if (!(determinant > 0.0) || !finite(determinant)) { status[statusOffset + observation] |= 8u; continue; }","  let inverse = mat2x2<f32>(predictedCovariance[1][1], -predictedCovariance[0][1], -predictedCovariance[1][0], predictedCovariance[0][0]) * (1.0 / determinant);","  let gain = uncertainty * transpose(prediction) * inverse;","  let nextEstimate = loadSmoothedState(observation + 1u);","  let residualPosition = kalmanPositionSubtract(KalmanPosition(rowSmoothedOrigin(observation + 1u), nextEstimate.xy), kalmanPositionAdvance(KalmanPosition(rowOrigin(observation), estimate.xy), estimate.zw, delta));","  let residualVelocity = nextEstimate.zw - estimate.zw;","  let positionCorrection = kalmanPositionAdd(kalmanPositionScale(residualPosition, vec2<f32>(gain[0][0])), kalmanPositionProduct(residualVelocity, vec2<f32>(gain[1][0])));","  let correctedPosition = kalmanPositionAdd(KalmanPosition(rowOrigin(observation), estimate.xy), positionCorrection);","  let velocityCorrection = kalmanPositionAdd(kalmanPositionScale(residualPosition, vec2<f32>(gain[0][1])), kalmanPositionProduct(residualVelocity, vec2<f32>(gain[1][1])));","  let correctedState = vec4<f32>(correctedPosition.low, estimate.zw + kalmanPositionValue(velocityCorrection));","  let nextCovariance = unpackCovariance(loadSmoothedCovariance(observation + 1u));","  let correctedCovariance = packCovariance(uncertainty + gain * (nextCovariance - predictedCovariance) * transpose(gain));","  let absolutePosition = kalmanPositionValue(correctedPosition);","  if (!finite(absolutePosition.x) || !finite(absolutePosition.y) || !finite(correctedState.x) || !finite(correctedState.y) || !finite(correctedState.z) || !finite(correctedState.w) ||","      !finite(correctedCovariance.x) || !finite(correctedCovariance.y) || !finite(correctedCovariance.z) || !finite(correctedCovariance.w)) {","    status[statusOffset + observation] |= 8u;","  storeSmoothedState(observation, correctedState);","  storeSmoothedOrigin(observation, correctedPosition.high);","  storeSmoothedCovariance(observation, correctedCovariance);","@group(0) @binding(0) var<storage, read> origins: array<f32>;","@group(0) @binding(1) var<storage, read_write> state: array<f32>;","@group(0) @binding(2) var<storage, read_write> smoothedState: array<f32>;","  let origin = vec2<f32>(origins[originsOffset + 4u * index], origins[originsOffset + 4u * index + 1u]);","state[stateOffset + 4u * index] += origin.x;","state[stateOffset + 4u * index + 1u] += origin.y;","smoothedState[smoothedStateOffset + 4u * index] += origins[originsOffset + 4u * index + 2u];","smoothedState[smoothedStateOffset + 4u * index + 1u] += origins[originsOffset + 4u * index + 3u];"],"strings":["gpu-spatial-analysis-trajectory-kalman-snapshot-tap","trajectory-kalman-filter","trajectory-kalman-local-metadata","filteredState","trajectory-kalman-smooth","smoothedState","status","read_write","buffer","logical","read","filteredCovariance","trajectory-kalman-publish-absolute","GPUTrajectoryKalman","offsets","parameters","times","smoothedCovariance","transient","positions","trajectory-kalman-initialize-local-metadata","compute","imported","state","covariance","origins"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X