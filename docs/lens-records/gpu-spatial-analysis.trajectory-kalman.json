PwAAAAA=","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-kalman-compiled","resource":"smoothedState","meaning":"Backward RTS estimate using both observations","components":4,"role":"output","keySpace":"entry"},{"id":"gpu-spatial-analysis-trajectory-kalman-snapshots-smoothedCovariance-0","name":"smoothedCovariance","iteration":0,"elementType":"f32","values":"b64:q6oqP6qqqr6qqqq+q6oqP6uqKj+rqqo+q6qqPquqKj8=","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-kalman-compiled","resource":"smoothedCovariance","meaning":"Backward RTS position/velocity covariance matrix","components":4,"role":"output","keySpace":"entry"},{"id":"gpu-spatial-analysis-trajectory-kalman-snapshots-status-0","name":"status","iteration":0,"elementType":"u32","values":"b64:AQAAAAAAAAA=","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-kalman-compiled","resource":"status","meaning":"Reset, prediction-only, invalid and singular-smoothing bits","role":"output","keySpace":"entry"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const timesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> times: array<f32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> parameters: array<f32>;","const stateOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> state: array<f32>;","const covarianceOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> covariance: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","const OBSERVATION_COUNT: u32 = 2u;","fn finite(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn transition(delta: f32) -> mat2x2<f32> { return mat2x2<f32>(1.0, 0.0, delta, 1.0); }","fn processCovariance(delta: f32, noise: f32) -> mat2x2<f32> {","  return mat2x2<f32>(delta * delta * delta / 3.0, delta * delta / 2.0, delta * delta / 2.0, delta) * noise;","fn unpackCovariance(packed: vec4<f32>) -> mat2x2<f32> { return mat2x2<f32>(packed.xy, packed.zw); }","fn packCovariance(matrix: mat2x2<f32>) -> vec4<f32> { return vec4<f32>(matrix[0][0], (matrix[0][1] + matrix[1][0]) * 0.5, (matrix[0][1] + matrix[1][0]) * 0.5, matrix[1][1]); }","fn isRowTimeFinite(row: u32) -> bool { return finite(times[timesOffset + row]); }","fn rowElapsed(row: u32, previous: u32) -> f32 { return times[timesOffset + row] - times[timesOffset + previous]; }fn loadState(row: u32) -> vec4<f32> { let offset = stateOffset + 4u * row; return vec4<f32>(state[offset], state[offset + 1u], state[offset + 2u], state[offset + 3u]); }","fn storeState(row: u32, value: vec4<f32>) { let offset = stateOffset + 4u * row; state[offset] = value.x; state[offset + 1u] = value.y; state[offset + 2u] = value.z; state[offset + 3u] = value.w; }","fn loadCovariance(row: u32) -> vec4<f32> { let offset = covarianceOffset + 4u * row; return vec4<f32>(covariance[offset], covariance[offset + 1u], covariance[offset + 2u], covariance[offset + 3u]); }","fn storeCovariance(row: u32, value: vec4<f32>) { let offset = covarianceOffset + 4u * row; covariance[offset] = value.x; covariance[offset + 1u] = value.y; covariance[offset + 2u] = value.z; covariance[offset + 3u] = value.w; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &times;","  _ = &offsets;","  _ = &parameters;","  _ = &state;","  _ = &covariance;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let start = min(offsets[offsetsOffset + index], OBSERVATION_COUNT);","let end = min(offsets[offsetsOffset + index + 1u], OBSERVATION_COUNT);","let noise = parameters[parametersOffset];","let measurementVariance = parameters[parametersOffset + 1u];","let velocityVariance = parameters[parametersOffset + 2u];","let maximumGap = select(parameters[parametersOffset + 3u], 3.402823466e+38, parameters[parametersOffset + 3u] == 0.0);","let parametersValid = finite(noise) && noise >= 0.0 && finite(measurementVariance) && measurementVariance > 0.0 && finite(velocityVariance) && velocityVariance >= 0.0 && maximumGap > 0.0;","let invalidValue = getNaN();","var initialized = false;","var estimate = vec4<f32>(0.0);","var uncertainty = mat2x2<f32>();","var previousObservation = start;","for (var observation = start; observation < end; observation++) {","  let position = vec2<f32>(positions[positionsOffset + 2u * observation], positions[positionsOffset + 2u * observation + 1u]);","  let measured = finite(position.x) && finite(position.y);","  let elapsed = rowElapsed(observation, previousObservation);","  let delta = elapsed;","  var flags = 0u;","  storeState(observation, vec4<f32>(invalidValue));","  storeCovariance(observation, vec4<f32>(invalidValue));","  if (!parametersValid || !isRowTimeFinite(observation) || (initialized && elapsed < 0.0)) {","    status[statusOffset + observation] = 4u;","    initialized = false;","    continue;","  if (initialized && elapsed > maximumGap) { initialized = false; }","  if (!initialized) {","    if (!measured) { status[statusOffset + observation] = 6u; continue; }","    estimate = vec4<f32>(position, 0.0, 0.0);","    uncertainty = mat2x2<f32>(measurementVariance, 0.0, 0.0, velocityVariance);","    initialized = true;","    flags = 1u;","  } else {","    let prediction = transition(delta);","    estimate = vec4<f32>(estimate.xy + delta * estimate.zw, estimate.zw);","    uncertainty = prediction * uncertainty * transpose(prediction) + processCovariance(delta, noise);","    if (measured) {","      let innovationVariance = uncertainty[0][0] + measurementVariance;","      if (!finite(innovationVariance) || !(innovationVariance > 0.0)) { status[statusOffset + observation] = 4u; initialized = false; continue; }","      let gain = vec2<f32>(uncertainty[0][0], uncertainty[0][1]) / innovationVariance;","      let residual = position - estimate.xy;","      estimate = vec4<f32>(estimate.xy + gain.x * residual, estimate.zw + gain.y * residual);","      // Joseph form preserves positive semidefiniteness under f32 rounding.","      let correction = mat2x2<f32>(1.0 - gain.x, -gain.y, 0.0, 1.0);","      uncertainty = correction * uncertainty * transpose(correction) + mat2x2<f32>(gain * gain.x, gain * gain.y) * measurementVariance;","    } else { flags = 2u; }","  previousObservation = observation;","  let packed = packCovariance(uncertainty);","  if (!finite(estimate.x) || !finite(estimate.y) || !finite(estimate.z) || !finite(estimate.w) || !finite(packed.x) || !finite(packed.y) || !finite(packed.w)) {","    status[statusOffset + observation] = 4u; initialized = false; continue;","  storeState(observation, estimate);","  storeCovariance(observation, packed);","  status[statusOffset + observation] = flags;","@group(0) @binding(0) var<storage, read> times: array<f32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","@group(0) @binding(3) var<storage, read> state: array<f32>;","@group(0) @binding(4) var<storage, read> covariance: array<f32>;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","const smoothedStateOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> smoothedState: array<f32>;","const smoothedCovarianceOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> smoothedCovariance: array<f32>;","fn loadSmoothedState(row: u32) -> vec4<f32> { let offset = smoothedStateOffset + 4u * row; return vec4<f32>(smoothedState[offset], smoothedState[offset + 1u], smoothedState[offset + 2u], smoothedState[offset + 3u]); }","fn storeSmoothedState(row: u32, value: vec4<f32>) { let offset = smoothedStateOffset + 4u * row; smoothedState[offset] = value.x; smoothedState[offset + 1u] = value.y; smoothedState[offset + 2u] = value.z; smoothedState[offset + 3u] = value.w; }","fn loadSmoothedCovariance(row: u32) -> vec4<f32> { let offset = smoothedCovarianceOffset + 4u * row; return vec4<f32>(smoothedCovariance[offset], smoothedCovariance[offset + 1u], smoothedCovariance[offset + 2u], smoothedCovariance[offset + 3u]); }","fn storeSmoothedCovariance(row: u32, value: vec4<f32>) { let offset = smoothedCovarianceOffset + 4u * row; smoothedCovariance[offset] = value.x; smoothedCovariance[offset + 1u] = value.y; smoothedCovariance[offset + 2u] = value.z; smoothedCovariance[offset + 3u] = value.w; }","  _ = &smoothedState;","  _ = &smoothedCovariance;","var observation = end;","loop {","  if (observation <= start) { break; }","  observation--;","  let estimate = loadState(observation);","  let uncertainty = unpackCovariance(loadCovariance(observation));","  storeSmoothedState(observation, estimate);","  storeSmoothedCovariance(observation, packCovariance(uncertainty));","  if (observation + 1u >= end || (status[statusOffset + observation] & 4u) != 0u || (status[statusOffset + observation + 1u] & 5u) != 0u) { continue; }","  let elapsed = rowElapsed(observation + 1u, observation);","  let prediction = transition(delta);","  let predictedCovariance = prediction * uncertainty * transpose(prediction) + processCovariance(delta, noise);","  let determinant = predictedCovariance[0][0] * predictedCovariance[1][1] - predictedCovariance[0][1] * predictedCovariance[1][0];","  // Singular deterministic velocity covariance has no inverse; its forward estimate remains valid.","  if (!(determinant > 0.0) || !finite(determinant)) { status[statusOffset + observation] |= 8u; continue; }","  let inverse = mat2x2<f32>(predictedCovariance[1][1], -predictedCovariance[0][1], -predictedCovariance[1][0], predictedCovariance[0][0]) * (1.0 / determinant);","  let gain = uncertainty * transpose(prediction) * inverse;","  let nextEstimate = loadSmoothedState(observation + 1u);","  let residual = nextEstimate - vec4<f32>(estimate.xy + delta * estimate.zw, estimate.zw);","  let correctionX = gain * vec2<f32>(residual.x, residual.z);","  let correctionY = gain * vec2<f32>(residual.y, residual.w);","  storeSmoothedState(observation, estimate + vec4<f32>(correctionX.x, correctionY.x, correctionX.y, correctionY.y));","  let nextCovariance = unpackCovariance(loadSmoothedCovariance(observation + 1u));","  storeSmoothedCovariance(observation, packCovariance(uncertainty + gain * (nextCovariance - predictedCovariance) * transpose(gain)));"],"strings":["gpu-spatial-analysis-trajectory-kalman-snapshot-tap","trajectory-kalman-filter","status","trajectory-kalman-smooth","buffer","filteredCovariance","filteredState","logical","read","offsets","parameters","times","smoothedCovariance","smoothedState","read_write","positions","transient","GPUTrajectoryKalman","imported","compute","covariance","state"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWork