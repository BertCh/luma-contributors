st BRACKET_STRIDE: u32 = 5u;","const NO_ROW: u32 = 0xffffffffu;","const STATUS_EMPTY: u32 = 0u;","const STATUS_ACTIVE: u32 = 1u;","const STATUS_BEFORE_START: u32 = 2u;","const STATUS_AFTER_END: u32 = 3u;","const STATUS_GAP: u32 = 4u;","fn getRowTimeDifference(a: u32, b: u32) -> f32 {","  return timestamps[timestampsOffset + a] - timestamps[timestampsOffset + b];","}","fn getPlayheadMaxGap() -> f32 {","  return parameters[parametersOffset + 1u];","fn isRowAfterPlayhead(row: u32) -> bool {","  return timestamps[timestampsOffset + row] > parameters[parametersOffset];","fn isRowBeforePlayhead(row: u32) -> bool {","  return timestamps[timestampsOffset + row] < parameters[parametersOffset];","fn getPlayheadElapsed(row: u32) -> f32 {","  return parameters[parametersOffset] - timestamps[timestampsOffset + row];","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &timestamps;","  _ = &trackOffsets;","  _ = &parameters;","  _ = &bracket;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let track = index;","  ","  let trackStart = min(trackOffsets[trackOffsetsOffset + track], ROW_COUNT);","  let trackEnd = clamp(trackOffsets[trackOffsetsOffset + track + 1u], trackStart, ROW_COUNT);","  var status = STATUS_EMPTY;","  var segmentRow = NO_ROW;","  var nextRow = NO_ROW;","  var fraction = 0.0;","  var duration = 0.0;","  if (trackEnd > trackStart) {","    let lastRow = trackEnd - 1u;","    let lastSegmentRow = select(trackStart, lastRow - 1u, lastRow > trackStart);","    if (isRowAfterPlayhead(trackStart)) {","      status = STATUS_BEFORE_START;","      segmentRow = trackStart;","      nextRow = min(trackStart + 1u, lastRow);","    } else if (isRowBeforePlayhead(lastRow)) {","      status = STATUS_AFTER_END;","      segmentRow = lastSegmentRow;","      nextRow = lastRow;","      fraction = 1.0;","    } else {","      // t[trackStart] <= playhead <= t[lastRow]: first row in (trackStart, trackEnd) after it.","      var low = trackStart + 1u;","      var high = trackEnd;","      loop {","        if (low >= high) {","          break;","        }","        let middle = (low + high) / 2u;","        if (isRowAfterPlayhead(middle)) {","          high = middle;","        } else {","          low = middle + 1u;","      }","      status = STATUS_ACTIVE;","      if (low == trackEnd) {","        // The playhead equals the last sample time.","        segmentRow = lastSegmentRow;","        nextRow = lastRow;","        fraction = 1.0;","      } else {","        // t[low - 1] <= playhead < t[low], so the interval is strictly positive.","        segmentRow = low - 1u;","        nextRow = low;","        let interval = getRowTimeDifference(nextRow, segmentRow);","        fraction = clamp(getPlayheadElapsed(segmentRow) / interval, 0.0, 1.0);","        let maxGap = getPlayheadMaxGap();","        if (maxGap > 0.0 && interval > maxGap && isRowBeforePlayhead(segmentRow)) {","          status = STATUS_GAP;","          fraction = 0.0;","    }","    duration = getRowTimeDifference(nextRow, segmentRow);","  let base = bracketOffset + BRACKET_STRIDE * track;","  bracket[base] = segmentRow;","  bracket[base + 1u] = nextRow;","  bracket[base + 2u] = status;","  bracket[base + 3u] = bitcast<u32>(fraction);","  bracket[base + 4u] = bitcast<u32>(duration);","@group(0) @binding(0) var<storage, read> bracket: array<u32>;","const positionsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> positions: array<f32>;","const currentPositionsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> currentPositions: array<f32>;","const headingsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> headings: array<f32>;","const speedsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> speeds: array<f32>;","fn interpolatePosition(a: vec2<f32>, b: vec2<f32>, fraction: f32) -> vec2<f32> {","  return select(a + (b - a) * fraction, b, fraction >= 1.0);","fn getSegmentLength(a: vec2<f32>, b: vec2<f32>) -> f32 {","  return length(b - a);","fn getSegmentHeading(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let delta = b - a;","  return select(0.0, atan2(delta.y, delta.x), delta.x != 0.0 || delta.y != 0.0);","fn getPosition(row: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","  _ = &positions;","  _ = &currentPositions;","  _ = &headings;","  _ = &speeds;","  let base = bracketOffset + BRACKET_STRIDE * index;","  let segmentRow = bracket[base];","  let nextRow = bracket[base + 1u];","  let status = bracket[base + 2u];","  let fraction = bitcast<f32>(bracket[base + 3u]);","  let duration = bitcast<f32>(bracket[base + 4u]);","  var position = vec2<f32>(0.0, 0.0);","  var elevation = 0.0;","  var heading = 0.0;","  var speed = 0.0;","  if (status != STATUS_EMPTY) {","    let startPosition = getPosition(segmentRow);","    let endPosition = getPosition(nextRow);","    position = interpolatePosition(startPosition, endPosition, fraction);","    ","    heading = getSegmentHeading(startPosition, endPosition);","    if (status == STATUS_ACTIVE && duration > 0.0) {","      speed = getSegmentLength(startPosition, endPosition) / duration;","  currentPositions[currentPositionsOffset + 2u * index] = position.x;","  currentPositions[currentPositionsOffset + 2u * index + 1u] = position.y;","  headings[headingsOffset + index] = heading;","  speeds[speedsOffset + index] = speed;","  _ = elevation;","const statusOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> status: array<u32>;","const segmentRowsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> segmentRows: array<u32>;","const segmentFractionsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> segmentFractions: array<f32>;","const activeFlagsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> activeFlags: array<u32>;","const trackIndicesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> trackIndices: array<u32>;","  _ = &status;","  _ = &segmentRows;","  _ = &segmentFractions;","  _ = &activeFlags;","  _ = &trackIndices;","  let trackSegmentRow = bracket[base];","  let trackStatus = bracket[base + 2u];","  let trackFraction = bitcast<f32>(bracket[base + 3u]);","  _ = trackSegmentRow;","  _ = trackFraction;","  _ = trackStatus;","  status[statusOffset + index] = trackStatus;","  segmentRows[segmentRowsOffset + index] = trackSegmentRow;","  segmentFractions[segmentFractionsOffset + index] = trackFraction;","  activeFlags[activeFlagsOffset + index] = select(0u, 1u, trackStatus == STATUS_ACTIVE);","  trackIndices[trackIndicesOffset + index] = index;","enable subgroups;","requires subgroup_id;","override ELEMENT_COUNT: u32;","override BLOCK_COUNT: u32;","override INPUT_OFFSET: u32;","override FLAGS_OFFSET: u32;","override OUTPUT_OFFSET: u32;","override COUNT_OFFSET: u32;","override DISPATCH_X: u32;","override DISPATCH_Y: u32;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read> flags: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputCount: array<u32>;","var<workgroup> subgroupTotals: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  let firstRow = workgroupIndex * 1024u + lane * 4u;","  var rowFlags: array<u32, 4>;","  var rowValues: array<u32, 4>;","  var rowCount = 0u;","  for (var item = 0u; item < 4u; item++) {","    if (firstRow + item < ELEMENT_COUNT) {","      let flag = min(flags[FLAGS_OFFSET + firstRow + item], 1u);","      rowFlags[item] = flag;","      rowCount += flag;","      if (flag != 0u) { rowValues[item] = inputValues[INPUT_OFFSET + firstRow + item]; }","  let subgroupPrefix = subgroupExclusiveAdd(rowCount);","  let subgroupTotal = subgroupAdd(rowCount);","  if (subgroupInvocationId == 0u) { subgroupTotals[subgroupId] = subgroupTotal; }","  workgroupBarrier();","  if (lane == 0u) {","    var runningTotal = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < 256u / subgroupSize; subgroupIndex++) {","      let total = subgroupTotals[subgroupIndex];","      subgroupTotals[subgroupIndex] = runningTotal;","      runningTotal += total;","    outputCount[COUNT_OFFSET] = runningTotal;","  let rowPrefix = subgroupTotals[subgroupId] + subgroupPrefix;","  var outputIndex = rowPrefix;","    if (rowFlags[item] != 0u) {","      outputValues[OUTPUT_OFFSET + outputIndex] = rowValues[item];","      outputIndex += 1u;","const totalInOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> totalIn: array<u32>;","const compactInOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> compactIn: array<u32>;","const idsOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> idsOut: array<u32>;","const countOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> countOut: array<u32>;","const overflowOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> overflowOut: array<u32>;","override CAPACITY: u32;","override COPY_ROW_COUNT: u32;","  _ = &totalIn;","  _ = &compactIn;","  _ = &idsOut;","  _ = &countOut;","  _ = &overflowOut;","  let total = totalIn[totalInOffset];","  let count = min(total, CAPACITY);","  if (index < COPY_ROW_COUNT && index < count) {","    idsOut[idsOutOffset + index] = compactIn[compactInOffset + index];","  if (index == 0u) {","    countOut[countOutOffset] = count;","    overflowOut[overflowOutOffset] = select(0u, 1u, total > CAPACITY);"],"strings":["trajectory-playhead-bracket","buffer","trajectory-playhead-columns","transient","read_write","trajectory-playhead-publish","trajectory-playhead-geometry","read","trajectory-playhead-active-scatter","GPUTrajectoryPlayhead","trajectory-playhead-active-track-flags","trajectory-playhead-track-indices","trajectory-playhead-active-ids","trajectory-playhead-active-total","compute","currentPositions","headings","segmentFractions","segmentRows","speeds","trajectory-playhead","activeTrackCount","activeTrackIds","activeTrackOverflow","bracket","imported","parameters","positions","timestamps","trackOffsets","trackStatus","GPUCompaction","transient-buffer-0","transient-buffer-7","transient-buffer-8","write"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","formula","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode","retained"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"],["retained"]],"lists":[["~:3",[1,1,1],12,false],["~:2","~o","~0","~7","u32",0,60]]}}
