ayhead-snapshots-segmentFractions-0","name":"segmentFractions","iteration":0,"elementType":"f32","values":"b64:MzMzPxZfcT80M3M/AAAAABhddD/saHM/AAAAAFZVVT89z3M+AAAAAKuqej/FTuw+","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-playhead-compiled","resource":"segmentFractions","meaning":"interpolation fraction inside the bracketing segment","role":"intermediate","keySpace":"track"},{"id":"gpu-spatial-analysis-trajectory-playhead-snapshots-activeTrackIds-0","name":"activeTrackIds","iteration":0,"elementType":"u32","values":"b64:AAAAAAEAAAACAAAABAAAAAUAAAAHAAAACAAAAAoAAAALAAAAAAAAAAEAAAABAAAA","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-playhead-compiled","resource":"activeTrackIds","meaning":"active track indices in ascending order; rows past the count are unused","role":"intermediate"},{"id":"gpu-spatial-analysis-trajectory-playhead-snapshots-activeTrackCount-0","name":"activeTrackCount","iteration":0,"elementType":"u32","values":"b64:CQAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-playhead-compiled","resource":"activeTrackCount","meaning":"gpu-spatial-analysis-trajectory-playhead-snapshot-tap","role":"intermediate"},{"id":"gpu-spatial-analysis-trajectory-playhead-snapshots-activeTrackOverflow-0","name":"activeTrackOverflow","iteration":0,"elementType":"u32","values":"b64:AAAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-playhead-compiled","resource":"activeTrackOverflow","meaning":"gpu-spatial-analysis-trajectory-playhead-snapshot-tap","role":"intermediate"},{"id":"gpu-spatial-analysis-trajectory-playhead-snapshots-currentPositions-0","name":"currentPositions","iteration":0,"elementType":"f32","values":"b64:cfMlRiQ+RkY3bC9GVtMRRpJ+NkZFnCRGSIgjRimpZkZsLFRGPtVkRkeoYEaYfHxGzdpuRgCmg0Yu5UZGI6ZRRnEqW0ZVZ35GrtEsRlx6dkbsai1GyDBiRoPWDkYm8T9G","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-playhead-compiled","resource":"currentPositions","meaning":"position of each track at 3600 s after 14:00Z (clamped outside its range)","components":2,"role":"output","geometry":{"kind":"points","coordinateModel":"projected","unit":"m","valuesCapture":"trackStatus"},"keySpace":"track"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const timestampsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> timestamps: array<f32>;","const trackOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> trackOffsets: array<u32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","const bracketOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> bracket: array<u32>;","const ROW_COUNT: u32 = 771u;","const BRACKET_STRIDE: u32 = 5u;","const NO_ROW: u32 = 0xffffffffu;","const STATUS_EMPTY: u32 = 0u;","const STATUS_ACTIVE: u32 = 1u;","const STATUS_BEFORE_START: u32 = 2u;","const STATUS_AFTER_END: u32 = 3u;","const STATUS_GAP: u32 = 4u;","fn getRowTimeDifference(a: u32, b: u32) -> f32 {","  return timestamps[timestampsOffset + a] - timestamps[timestampsOffset + b];","}","fn getPlayheadMaxGap() -> f32 {","  return parameters[parametersOffset + 1u];","fn isRowAfterPlayhead(row: u32) -> bool {","  return timestamps[timestampsOffset + row] > parameters[parametersOffset];","fn isRowBeforePlayhead(row: u32) -> bool {","  return timestamps[timestampsOffset + row] < parameters[parametersOffset];","fn getPlayheadElapsed(row: u32) -> f32 {","  return parameters[parametersOffset] - timestamps[timestampsOffset + row];","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &timestamps;","  _ = &trackOffsets;","  _ = &parameters;","  _ = &bracket;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let track = index;","  ","  let trackStart = min(trackOffsets[trackOffsetsOffset + track], ROW_COUNT);","  let trackEnd = clamp(trackOffsets[trackOffsetsOffset + track + 1u], trackStart, ROW_COUNT);","  var status = STATUS_EMPTY;","  var segmentRow = NO_ROW;","  var nextRow = NO_ROW;","  var fraction = 0.0;","  var duration = 0.0;","  if (trackEnd > trackStart) {","    let lastRow = trackEnd - 1u;","    let lastSegmentRow = select(trackStart, lastRow - 1u, lastRow > trackStart);","    if (isRowAfterPlayhead(trackStart)) {","      status = STATUS_BEFORE_START;","      segmentRow = trackStart;","      nextRow = min(trackStart + 1u, lastRow);","    } else if (isRowBeforePlayhead(lastRow)) {","      status = STATUS_AFTER_END;","      segmentRow = lastSegmentRow;","      nextRow = lastRow;","      fraction = 1.0;","    } else {","      // t[trackStart] <= playhead <= t[lastRow]: first row in (trackStart, trackEnd) after it.","      var low = trackStart + 1u;","      var high = trackEnd;","      loop {","        if (low >= high) {","          break;","        }","        let middle = (low + high) / 2u;","        if (isRowAfterPlayhead(middle)) {","          high = middle;","        } else {","          low = middle + 1u;","      }","      status = STATUS_ACTIVE;","      if (low == trackEnd) {","        // The playhead equals the last sample time.","        segmentRow = lastSegmentRow;","        nextRow = lastRow;","        fraction = 1.0;","      } else {","        // t[low - 1] <= playhead < t[low], so the interval is strictly positive.","        segmentRow = low - 1u;","        nextRow = low;","        let interval = getRowTimeDifference(nextRow, segmentRow);","        fraction = clamp(getPlayheadElapsed(segmentRow) / interval, 0.0, 1.0);","        let maxGap = getPlayheadMaxGap();","        if (maxGap > 0.0 && interval > maxGap && isRowBeforePlayhead(segmentRow)) {","          status = STATUS_GAP;","          fraction = 0.0;","    }","    duration = getRowTimeDifference(nextRow, segmentRow);","  let base = bracketOffset + BRACKET_STRIDE * track;","  bracket[base] = segmentRow;","  bracket[base + 1u] = nextRow;","  bracket[base + 2u] = status;","  bracket[base + 3u] = bitcast<u32>(fraction);","  bracket[base + 4u] = bitcast<u32>(duration);","@group(0) @binding(0) var<storage, read> bracket: array<u32>;","const positionsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> positions: array<f32>;","const currentPositionsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> currentPositions: array<f32>;","const headingsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> headings: array<f32>;","const speedsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> speeds: array<f32>;","fn interpolatePosition(a: vec2<f32>, b: vec2<f32>, fraction: f32) -> vec2<f32> {","  return select(a + (b - a) * fraction, b, fraction >= 1.0);","fn getSegmentLength(a: vec2<f32>, b: vec2<f32>) -> f32 {","  return length(b - a);","fn guardedAtan2(y: f32, x: f32) -> f32 {","  return select(atan2(y, x), sign(y) * 1.5707963267948966, x == 0.0);","fn getSegmentHeading(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let delta = b - a;","  // delta.x is -0.0 for a due north or south step from x = +0 to x = -0.","  return select(0.0, guardedAtan2(delta.y, delta.x), delta.x != 0.0 || delta.y != 0.0);","fn getPosition(row: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","  _ = &positions;","  _ = &currentPositions;","  _ = &headings;","  _ = &speeds;","  let base = bracketOffset + BRACKET_STRIDE * index;","  let segmentRow = bracket[base];","  let nextRow = bracket[base + 1u];","  let status = bracket[base + 2u];","  let fraction = bitcast<f32>(bracket[base + 3u]);","  let duration = bitcast<f32>(bracket[base + 4u]);","  var position = vec2<f32>(0.0, 0.0);","  var elevation = 0.0;","  var heading = 0.0;","  var speed = 0.0;","  if (status != STATUS_EMPTY) {","    let startPosition = getPosition(segmentRow);","    let endPosition = getPosition(nextRow);","    position = interpolatePosition(startPosition, endPosition, fraction);","    ","    heading = getSegmentHeading(startPosition, endPosition);","    if (status == STATUS_ACTIVE && duration > 0.0) {","      speed = getSegmentLength(startPosition, endPosition) / duration;","  currentPositions[currentPositionsOffset + 2u * index] = position.x;","  currentPositions[currentPositionsOffset + 2u * index + 1u] = position.y;","  headings[headingsOffset + index] = heading;","  speeds[speedsOffset + index] = speed;","  _ = elevation;","const statusOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> status: array<u32>;","const segmentRowsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> segmentRows: array<u32>;","const segmentFractionsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> segmentFractions: array<f32>;","const activeFlagsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> activeFlags: array<u32>;","const trackIndicesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> trackIndices: array<u32>;","  _ = &status;","  _ = &segmentRows;","  _ = &segmentFractions;","  _ = &activeFlags;","  _ = &trackIndices;","  let trackSegmentRow = bracket[base];","  let trackStatus = bracket[base + 2u];","  let trackFraction = bitcast<f32>(bracket[base + 3u]);","  _ = trackSegmentRow;","  _ = trackFraction;","  _ = trackStatus;","  status[statusOffset + index] = trackStatus;","  segmentRows[segmentRowsOffset + index] = trackSegmentRow;","  segmentFractions[segmentFractionsOffset + index] = trackFraction;","  activeFlags[activeFlagsOffset + index] = select(0u, 1u, track