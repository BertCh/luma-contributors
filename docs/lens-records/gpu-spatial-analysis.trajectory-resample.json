"m","offsetsCapture":"trackOffsets"},"keySpace":"fix"},{"id":"gpu-spatial-analysis-trajectory-resample-snapshots-trackOffsets-0","name":"trackOffsets","iteration":0,"elementType":"u32","values":"b64:AAAAAEEAAACFAAAAvAAAAPUAAAA3AQAAdAEAALgBAAAFAgAATAIAAIQCAADJAgAAAwMAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-resample-compiled","resource":"trackOffsets","meaning":"gpu-spatial-analysis-trajectory-resample-snapshot-tap","role":"intermediate"},{"id":"gpu-spatial-analysis-trajectory-resample-snapshots-sampleOffsets-0","name":"sampleOffsets","iteration":0,"elementType":"u32","values":"b64:AAAAABAAAAAgAAAAMAAAAEAAAABQAAAAYAAAAHAAAACAAAAAkAAAAKAAAACwAAAAwAAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-resample-compiled","resource":"sampleOffsets","meaning":"gpu-spatial-analysis-trajectory-resample-snapshot-tap","role":"intermediate"},{"id":"gpu-spatial-analysis-trajectory-resample-snapshots-sampleTimes-0","name":"sampleTimes","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-resample-compiled","resource":"sampleTimes","meaning":"sample time in s since the track start; row = track * 16 + sample","role":"intermediate","keySpace":"sample"},{"id":"gpu-spatial-analysis-trajectory-resample-snapshots-samples-0","name":"samples","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-trajectory-resample-compiled","resource":"samples","meaning":"GPU-written samples, 16 per track in track order","components":2,"role":"output","geometry":{"kind":"lines","coordinateModel":"projected","unit":"m","offsetsCapture":"sampleOffsets"},"keySpace":"sample"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const trackOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> trackOffsets: array<u32>;","const cumulativeLengthsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> cumulativeLengths: array<f32>;","const ROW_COUNT: u32 = 771u;","fn getAdditionRoundingError(first: f32, second: f32, sum: f32) -> f32 {","  let firstBits = bitcast<u32>(first);","  let secondBits = bitcast<u32>(second);","  let sumBits = bitcast<u32>(sum);","  let firstMagnitude = firstBits & 0x7fffffffu;","  let secondMagnitude = secondBits & 0x7fffffffu;","  let sumMagnitude = sumBits & 0x7fffffffu;","  // A zero operand makes the addition exact; an infinity or a NaN has no rounding error to report.","  if (firstMagnitude == 0u || secondMagnitude == 0u ||","      max(max(firstMagnitude, secondMagnitude), sumMagnitude) >= 0x7f800000u) {","    return 0.0;","  }","  let firstIsLarger = firstMagnitude >= secondMagnitude;","  let largerBits = select(secondBits, firstBits, firstIsLarger);","  let smallerBits = select(firstBits, secondBits, firstIsLarger);","  let largerMagnitude = largerBits & 0x7fffffffu;","  let smallerMagnitude = smallerBits & 0x7fffffffu;","  // Biased exponents (1 for subnormals) and 24-bit significands: |value| = significand * 2^(exponent - 150).","  let largerExponent = max(largerMagnitude >> 23u, 1u);","  let smallerExponent = max(smallerMagnitude >> 23u, 1u);","  let sumExponent = max(sumMagnitude >> 23u, 1u);","  // Below 2^-103 the error would be subnormal, where ldexp is not dependable: report none.","  if (smallerExponent < 24u) {","  let gap = largerExponent - smallerExponent;","  if (gap > 25u) {","    // The smaller operand is below a quarter of the larger one's last place: the sum is the larger","    // operand and the whole smaller operand is the error.","    if (sumBits == largerBits) {","      return bitcast<f32>(smallerBits);","    }","  // The sum's last place, as a left shift from the smaller operand's last place. A rounded sum has","  // the larger operand's exponent, the next one (a carry) or the one below (a borrow). Anything","  // lower is a cancellation, which is exact, and so is a sum whose last place is finer than the","  // smaller operand's.","  if (sumMagnitude == 0u || sumExponent + 1u < largerExponent || sumExponent > largerExponent + 1u ||","      sumExponent < smallerExponent) {","  let sumShift = sumExponent - smallerExponent;","  let largerSignificand = (largerMagnitude & 0x7fffffu) | select(0u, 0x800000u, largerMagnitude >= 0x800000u);","  let smallerSignificand = (smallerMagnitude & 0x7fffffu) | select(0u, 0x800000u, smallerMagnitude >= 0x800000u);","  let sumSignificand = (sumMagnitude & 0x7fffffu) | select(0u, 0x800000u, sumMagnitude >= 0x800000u);","  // Signed integers in units of the smaller operand's last place, modulo 2^32. Each term can pass","  // 2^32, but their combination is at most 2^25 in magnitude, so the wrapped result is exact.","  let largerUnits = largerSignificand << gap;","  let sumUnits = sumSignificand << sumShift;","  let signedLarger = select(largerUnits, 0u - largerUnits, (largerBits & 0x80000000u) != 0u);","  let signedSmaller = select(smallerSignificand, 0u - smallerSignificand, (smallerBits & 0x80000000u) != 0u);","  let signedSum = select(sumUnits, 0u - sumUnits, (sumBits & 0x80000000u) != 0u);","  let errorUnits = bitcast<i32>(signedLarger + signedSmaller - signedSum);","  // The rounding error of an addition is an f32, so the conversion and the scaling are exact.","  return ldexp(f32(errorUnits), i32(smallerExponent) - 150);","}","fn interpolatePosition(a: vec2<f32>, b: vec2<f32>, fraction: f32) -> vec2<f32> {","  return select(a + (b - a) * fraction, b, fraction >= 1.0);","fn getSegmentLength(a: vec2<f32>, b: vec2<f32>) -> f32 {","  return length(b - a);","fn guardedAtan2(y: f32, x: f32) -> f32 {","  return select(atan2(y, x), sign(y) * 1.5707963267948966, x == 0.0);","fn getSegmentHeading(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let delta = b - a;","  // delta.x is -0.0 for a due north or south step from x = +0 to x = -0.","  return select(0.0, guardedAtan2(delta.y, delta.x), delta.x != 0.0 || delta.y != 0.0);","fn getPosition(row: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &trackOffsets;","  _ = &cumulativeLengths;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let track = index;","  ","  let trackStart = min(trackOffsets[trackOffsetsOffset + track], ROW_COUNT);","  let trackEnd = clamp(trackOffsets[trackOffsetsOffset + track + 1u], trackStart, ROW_COUNT);","  if (trackEnd > trackStart) {","    // Neumaier-compensated running sum, as the line family's prefix (line-segmentize-kernels.ts):","    // a plain f32 sum of 86,400 equal steps of 13.9 ends 1,051 short of 1,200,960. The correction","    // is read off the integer significands; the float form is removed by fast-math compilers.","    var sum = 0.0;","    var compensation = 0.0;","    cumulativeLengths[cumulativeLengthsOffset + trackStart] = 0.0;","    for (var row = trackStart + 1u; row < trackEnd; row++) {","      let segmentLength = getSegmentLength(getPosition(row - 1u), getPosition(row));","      let nextSum = sum + segmentLength;","      compensation = compensation + getAdditionRoundingError(sum, segmentLength, nextSum);","      sum = nextSum;","      cumulativeLengths[cumulativeLengthsOffset + row] = sum + compensation;","const timestampsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> timestamps: array<f32>;","@group(0) @binding(3) var<storage, read> cumulativeLengths: array<f32>;","const samplesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> samples: array<f32>;","const sampleTimesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> sampleTimes: array<f32>;","const SAMPLE_COUNT: u32 = 16u;","fn getRowTimeDifference(a: u32, b: u32) -> f32 {","  return timestamps[timestampsOffset + a] - timestamps[timestampsOffset + b];","fn getProgress(row: u32, firstRow: u32) -> f32 {","  _ = firstRow;","  return cumulativeLengths[cumulativeLengthsOffset + row];","@compute @workgroup_size(256)","  _ = &timestamps;","  _ = &samples;","  _ = &sampleTimes;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let track = index / SAMPLE_COUNT;","  let sampleIndex = index - track * SAMPLE_COUNT;","  var position = vec2<f32>(0.0, 0.0);","  var elevation = 0.0;","  var time = 0.0;","    let lastRow = trackEnd - 1u;","    let total = getProgress(lastRow, trackStart);","    var targetProgress = 0.0;","    ","    if (SAMPLE_COUNT > 1u) {","      targetProgress = select(","        total * (f32(sampleIndex) / f32(SAMPLE_COUNT - 1u)),","        total,","        sampleIndex == SAMPLE_COUNT - 1u","      );","    var low = trackStart + 1u;","    var high = trackEnd;","    loop {","      if (low >= high) {","        break;","      }","      let middle = (low + high) / 2u;","      if (getProgress(middle, trackStart) > targetProgress) {","        high = middle;","      } else {","        low = middle + 1u;","    // Past the last row: the end of the last segment, so a great-circle track keeps its longitude","    // continuous across the antimeridian (planar: exactly the last row).","    var row0 = select(lastRow, lastRow - 1u, lastRow > trackStart);","    var row1 = lastRow;","    var fraction = 1.0;","    if (low < trackEnd) {","      row0 = low - 1u;","      row1 = low;","      let startProgress = getProgress(row0, trackStart);","      fraction = clamp(","        (targetProgress - startProgress) / (getProgress(row1, trackStart) - startProgress),","        0.0,","        1.0","      ","    let startPosition = getPosition(row0);","    let endPosition = getPosition(row1);","    position = interpolatePosition(startPosition, endPosition, fraction);","    let startTime = getRowTimeDifference(row0, trackStart);","    let endTime = getRowTimeDifference(row1, trackStart);","    time = select(startTime + (endTime - startTime) * fraction, endTime, fraction >= 1.0);","  samples[samplesOffset + 2u * index] = position.x;","  samples[samplesOffset + 2u * index + 1u] = position.y;","  sampleTimes[sampleTimesOffset + index] = time;","  _ = elevation;","  _ = time;"],"strings":["gpu-spatial-analysis-trajectory-resample-snapshot-tap","trajectory-resample-samples","positions","trackOffsets","buffer","sampleTimes","samples","trajectory-resample-cumulative-lengths","logical","read","trajectory-resample-arc-length","GPUTrajectoryResample","timestamps","imported","read_write","transient","arc-length","compute","cumulativeLengths","sampleOffsets"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","bytesKind","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:3","~2","~2","~9","f32",0,771],["~:3","~3","~3","~9","u32",0,13]]}}
