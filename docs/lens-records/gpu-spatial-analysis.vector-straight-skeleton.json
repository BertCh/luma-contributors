put(base,vertex,field,bitcast<u32>(value)); }","fn point(row: u32) -> vec2f { return vec2f(positions[positionsOffset + row * 2u], positions[positionsOffset + row * 2u + 1u]); }","fn cross(left:vec2f,right:vec2f)->f32 { return left.x*right.y-left.y*right.x; }","fn normal(base:u32,edge:u32)->vec2f { return vec2f(scalar(base,edge,11u),scalar(base,edge,12u)); }","fn at(base:u32,vertex:u32,time:f32)->vec2f { return vec2f(scalar(base,vertex,0u),scalar(base,vertex,1u))+time*vec2f(scalar(base,vertex,2u),scalar(base,vertex,3u)); }","fn initialize(base:u32,vertex:u32,left:u32,right:u32,previous:u32,next:u32,origin:vec2f,time:f32) {","  put(base,vertex,4u,left); put(base,vertex,5u,right); put(base,vertex,6u,previous); put(base,vertex,7u,next); put(base,vertex,8u,1u);","  put(base,vertex,15u,0xffffffffu); put(base,vertex,16u,0xffffffffu); put(base,vertex,17u,0u);","  store(base,vertex,9u,origin.x); store(base,vertex,10u,origin.y);","  let first=normal(base,left); let second=normal(base,right); let determinant=cross(first,second);","  var start=origin; var velocity=vec2f(0.0);","  if (abs(determinant)>1e-7) {","    let firstConstant=scalar(base,left,13u); let secondConstant=scalar(base,right,13u);","    start=vec2f(firstConstant*second.y-first.y*secondConstant,first.x*secondConstant-firstConstant*second.x)/determinant;","    velocity=vec2f(second.y-first.y,first.x-second.x)/determinant;","  }","  else if(dot(first,second)>0.999999) { velocity=first; start=origin-time*velocity; }","  store(base,vertex,0u,start.x); store(base,vertex,1u,start.y); store(base,vertex,2u,velocity.x); store(base,vertex,3u,velocity.y);","}","fn emit(polygon:u32,base:u32,vertex:u32,end:vec2f,required:u32)->u32 {","  let start=vec2f(scalar(base,vertex,9u),scalar(base,vertex,10u));","  if (distance(start,end)<=TOLERANCE) { return required; }","  if (required<32u) {","    let slot=polygon*32u+required;","    segments[segmentsOffset+slot*4u]=start.x; segments[segmentsOffset+slot*4u+1u]=start.y; segments[segmentsOffset+slot*4u+2u]=end.x; segments[segmentsOffset+slot*4u+3u]=end.y;","    sources[sourcesOffset+slot*2u]=readWord(base,readWord(base,vertex,4u),14u); sources[sourcesOffset+slot*2u+1u]=readWord(base,readWord(base,vertex,5u),14u);","  return required+1u;","fn snapshot(polygon:u32,base:u32,count:u32,time:f32)->u32 {","  var activeCount=0u;","  for(var vertex=0u;vertex<count;vertex++) { if(readWord(base,vertex,8u)!=0u) {","    let location=at(base,vertex,time); let slot=polygon*SLOTS+vertex;","    offsets[offsetsOffset+slot*2u]=location.x; offsets[offsetsOffset+slot*2u+1u]=location.y;","    put(base,vertex,15u,readWord(base,vertex,6u)); put(base,vertex,16u,readWord(base,vertex,7u)); activeCount++;","  } }","  return activeCount;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &rings;","  _ = &polygons;","  _ = &workspace;","  _ = &segments;","  _ = &sources;","  _ = &offsets;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let base=index * 761u;","var count=0u; var flags=0u; var required=0u;","let firstRing=polygons[polygonsOffset+index]; let lastRing=polygons[polygonsOffset+index+1u];","for(var ring=firstRing;ring<lastRing;ring++) {","  let first=rings[ringsOffset+ring]; var last=rings[ringsOffset+ring+1u];","  if(last>first && all(point(first)==point(last-1u))) { last--; }","  if(last-first<3u) { flags|=1u; continue; }","  var area=0.0; for(var vertex=first;vertex<last;vertex++) { let next=select(vertex+1u,first,vertex+1u==last); area+=cross(point(vertex),point(next)); }","  let reverse=select((area < 0.0), (area > 0.0), (ring > firstRing));","  let ringStart=count;","  for(var ordinal=0u;ordinal<last-first;ordinal++) {","    let vertex=first+select(ordinal,last-first-1u-ordinal,reverse);","    let before=first+(vertex-first+last-first-1u)%(last-first); let after=first+(vertex-first+1u)%(last-first);","    if(all(point(vertex)==point(before)) || all(point(vertex)==point(after))) { flags|=1u; continue; }","    if(count>=8u) { flags|=1u; break; }","    let location=point(vertex); if(any((bitcast<vec2u>(location)&vec2u(0x7f800000u))==vec2u(0x7f800000u))) { flags|=1u; }","    store(base,count,9u,location.x); store(base,count,10u,location.y); put(base,count,14u,vertex); count++;","  if(count-ringStart<3u) { flags|=1u; continue; }","  for(var vertex=ringStart;vertex<count;vertex++) {","    let next=select(vertex+1u,ringStart,vertex+1u==count); let previous=select(vertex-1u,count-1u,vertex==ringStart);","    let start=vec2f(scalar(base,vertex,9u),scalar(base,vertex,10u)); let finish=vec2f(scalar(base,next,9u),scalar(base,next,10u)); let edge=finish-start;","    let inward=vec2f(-edge.y,edge.x)/length(edge); store(base,vertex,11u,inward.x); store(base,vertex,12u,inward.y); store(base,vertex,13u,dot(inward,start)); put(base,vertex,6u,previous); put(base,vertex,7u,next);","for(var vertex=0u;vertex<count;vertex++) { initialize(base,vertex,readWord(base,vertex,6u),vertex,readWord(base,vertex,6u),readWord(base,vertex,7u),vec2f(scalar(base,vertex,9u),scalar(base,vertex,10u)),0.0); }","var time=0.0; var offsetCount=0u; var captured=false; var eventCount=0u;","loop {","  if(flags!=0u) { break; }","  // Preserve ascending slot order while skipping every historical inactive vertex in searches.","  var firstActive=count;","  for(var remaining=count;remaining>0u;remaining--) { let vertex=remaining-1u; if(readWord(base,vertex,8u)!=0u) { put(base,vertex,18u,firstActive); firstActive=vertex; } }","  // A terminal two-vertex component is a ridge, including simultaneous opposing edge collapses.","  for(var vertex=firstActive;vertex<count;vertex=readWord(base,vertex,18u)) { if(readWord(base,vertex,8u)!=0u) {","    let next=readWord(base,vertex,7u);","    if(next==vertex) { put(base,vertex,8u,0u); }","    else if(readWord(base,next,7u)==vertex) {","      required=emit(index,base,vertex,vec2f(scalar(base,next,9u),scalar(base,next,10u)),required); put(base,vertex,8u,0u); put(base,next,8u,0u);","    }","  // Simultaneous parallel collisions leave zero-area wavefront components. Their","  // elementary undirected edges are terminal ridges; collinear vertices split them.","  let visitGeneration=eventCount+1u;","  for(var root=firstActive;root<count;root=readWord(base,root,18u)) { if(readWord(base,root,8u)==0u || readWord(base,root,17u)==visitGeneration) { continue; }","    var vertex=root; var twiceArea=0.0; var areaMagnitude=0.0; var perimeter=0.0; var traversed=0u;","    loop { let next=readWord(base,vertex,7u); let start=at(base,vertex,time); let finish=at(base,next,time); let areaTerm=cross(start,finish); twiceArea+=areaTerm; areaMagnitude+=abs(areaTerm); perimeter+=distance(start,finish); put(base,vertex,17u,visitGeneration); vertex=next; traversed++; if(vertex==root || traversed>count) { break; } }","    if(traversed>count) { flags|=8u; break; }","    if(abs(twiceArea)>TOLERANCE*(1.0+perimeter)) {","      // Every rotated sum uses the same terms. A conservative rounding envelope preserves","      // the original per-root checks when their order could change the tolerance decision.","      let roundingEnvelope=8.0*f32(traversed)*1.1920928955078125e-7*(areaMagnitude+TOLERANCE*(1.0+perimeter));","      if (!(abs(twiceArea)>TOLERANCE*(1.0+perimeter)+roundingEnvelope)) {","        vertex=root; loop { put(base,vertex,17u,0u); vertex=readWord(base,vertex,7u); if(vertex==root) { break; } }","      }","      continue;","    vertex=root;","    loop { required=emit(index,base,vertex,at(base,vertex,time),required); vertex=readWord(base,vertex,7u); if(vertex==root) { break; } }","    loop {","      let next=readWord(base,vertex,7u); let start=at(base,vertex,time); let finish=at(base,next,time); let direction=finish-start; let lengthSquared=dot(direction,direction); var keep=lengthSquared>TOLERANCE*TOLERANCE;","      var other=root;","      loop {","        let otherNext=readWord(base,other,7u); let otherStart=at(base,other,time); let otherFinish=at(base,otherNext,time);","        let fraction=dot(otherStart-start,direction)/max(lengthSquared,1e-30);","        if(fraction>TOLERANCE && fraction<1.0-TOLERANCE && abs(cross(otherStart-start,direction))<=TOLERANCE*sqrt(lengthSquared)) { keep=false; }","        if(other<vertex && ((distance(start,otherStart)<=TOLERANCE && distance(finish,otherFinish)<=TOLERANCE) || (distance(start,otherFinish)<=TOLERANCE && distance(finish,otherStart)<=TOLERANCE))) { keep=false; }","        other=otherNext; if(other==root) { break; }","      if(keep) { store(base,vertex,9u,start.x); store(base,vertex,10u,start.y); required=emit(index,base,vertex,finish,required); }","      vertex=next; if(vertex==root) { break; }","    vertex=root; loop { put(base,vertex,8u,0u); vertex=readWord(base,vertex,7u); if(vertex==root) { break; } }","  var activeCount=0u; for(var vertex=firstActive;vertex<count;vertex=readWord(base,vertex,18u)) { activeCount+=readWord(base,vertex,8u); }","  if(activeCount==0u) { break; }","  var eventTime=3.0e38; var eventVertex=0xffffffffu; var eventEdge=0xffffffffu; var split=false;","  for(var vertex=firstActive;vertex<count;vertex=readWord(base,vertex,18u)) { if(readWord(base,vertex,8u)==0u) { continue; }","    let next=readWord(base,vertex,7u); let delta=at(base,next,0.0)-at(base,vertex,0.0);","    let velocity=vec2f(scalar(base,next,2u)-scalar(base,vertex,2u),scalar(base,next,3u)-scalar(base,vertex,3u)); let denominator=dot(velocity,velocity);","    if(denominator>1e-12) {","      let candidate=-dot(delta,velocity)/denominator;","      if(candidate>=time-TOLERANCE && candidate<eventTime && length(delta+candidate*