ion-segment.xy;let squared=dot(direction,direction);var fraction=0.0;"," if(squared>0.0){fraction=clamp(dot(offset,direction)/squared,0.0,1.0);}"," return length(offset-fraction*direction);","}","// Returns (candidate distance along the ray, 1.0 when the segment blocks the ray, else 0.0).","fn getSegmentCandidate(origin:vec2<f32>,direction:vec2<f32>,maximum:f32,segmentIndex:u32)->vec2<f32>{"," let segment=readSegment(segmentIndex);let edge=segment.zw-segment.xy;let displacement=segment.xy-origin;let denominator=crossVectors(direction,edge);var candidate=maximum;var intersects=false;"," if(distanceToSegment(origin,segment)<=9.999999974752427e-7){candidate=0.0;intersects=true;}"," else if(abs(denominator)>9.999999974752427e-7){","  let rayDistance=crossVectors(displacement,edge)/denominator;let fraction=crossVectors(displacement,direction)/denominator;","  if(rayDistance>=0.0&&fraction>=0.0&&fraction<=1.0){candidate=rayDistance;intersects=true;}"," }else if(abs(crossVectors(displacement,direction))<=9.999999974752427e-7){","  let first=dot(displacement,direction);let second=dot(segment.zw-origin,direction);","  if(max(first,second)>=0.0){candidate=max(0.0,min(first,second));intersects=true;}"," }"," return vec2<f32>(candidate,f32(intersects));","fn castRay(origin:vec2<f32>,direction:vec2<f32>,maximum:f32)->vec2<f32>{"," var nearest=maximum;var hit=-1.0;"," for(var segmentIndex=0u;segmentIndex<1u;segmentIndex++){","  let blocked=getSegmentCandidate(origin,direction,maximum,segmentIndex);","  if(blocked.y>0.0&&blocked.x<=nearest&&(blocked.x<nearest||hit<0.0)){nearest=blocked.x;hit=f32(segmentIndex);}"," return vec2<f32>(nearest,hit);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &segments;","  _ = &classifications;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let point=vec2<f32>(positions[positionsOffset+2u*index],positions[positionsOffset+2u*index+1u]);","var valid=isFiniteValue(point.x)&&isFiniteValue(point.y);","var boundary=false;","var winding=0;","for(var segmentIndex=0u;segmentIndex<1u;segmentIndex++){","  let segment=readSegment(segmentIndex);","  valid=valid&&isFiniteValue(segment.x)&&isFiniteValue(segment.y)&&isFiniteValue(segment.z)&&isFiniteValue(segment.w);","  boundary=boundary||distanceToSegment(point,segment)<=0.000001;","  let cross=crossVectors(segment.zw-segment.xy,point-segment.xy);","  if(segment.y<=point.y&&segment.w>point.y&&cross>0.0){winding++;}","  if(segment.y>point.y&&segment.w<=point.y&&cross<0.0){winding--;}","let inside=(abs(winding)%2)==1;","let allowed=true;","classifications[classificationsOffset+index]=select(select(select(1u,0u,allowed),2u,boundary),3u,!valid);","const coordinate0Offset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> coordinate0: array<f32>;","const coordinate1Offset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> coordinate1: array<f32>;","const coordinate2Offset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> coordinate2: array<f32>;","const coordinate3Offset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> coordinate3: array<f32>;","  _ = &coordinate0;","  _ = &coordinate1;","  _ = &coordinate2;","  _ = &coordinate3;","  let horizontal=positions[positionsOffset+2u*index];","let vertical=positions[positionsOffset+2u*index+1u];","let valid=isFiniteValue(horizontal)&&isFiniteValue(vertical);","coordinate0[coordinate0Offset+index]=select(3.402823e38,horizontal,valid);","coordinate1[coordinate1Offset+index]=select(3.402823e38,vertical,valid);","coordinate2[coordinate2Offset+index]=select(-3.402823e38,horizonta