crossVectors(displacement,edge)/denominator;let fraction=crossVectors(displacement,direction)/denominator;","  if(rayDistance>=0.0&&fraction>=0.0&&fraction<=1.0){candidate=rayDistance;intersects=true;}"," }else if(abs(crossVectors(displacement,direction))<=9.999999974752427e-7){","  let first=dot(displacement,direction);let second=dot(segment.zw-origin,direction);","  if(max(first,second)>=0.0){candidate=max(0.0,min(first,second));intersects=true;}"," }"," return vec2<f32>(candidate,f32(intersects));","fn castRay(origin:vec2<f32>,direction:vec2<f32>,maximum:f32)->vec2<f32>{"," var nearest=maximum;var hit=-1.0;"," for(var segmentIndex=0u;segmentIndex<1u;segmentIndex++){","  let blocked=getSegmentCandidate(origin,direction,maximum,segmentIndex);","  if(blocked.y>0.0&&blocked.x<=nearest&&(blocked.x<nearest||hit<0.0)){nearest=blocked.x;hit=f32(segmentIndex);}"," return vec2<f32>(nearest,hit);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &segments;","  _ = &classifications;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let point=vec2<f32>(positions[positionsOffset+2u*index],positions[positionsOffset+2u*index+1u]);","var valid=isFiniteValue(point.x)&&isFiniteValue(point.y);","var boundary=false;","var winding=0;","for(var segmentIndex=0u;segmentIndex<1u;segmentIndex++){","  let segment=readSegment(segmentIndex);","  valid=valid&&isFiniteValue(segment.x)&&isFiniteValue(segment.y)&&isFiniteValue(segment.z)&&isFiniteValue(segment.w);","  boundary=boundary||distanceToSegment(point,segment)<=0.000001;","  let cross=crossVectors(segment.zw-segment.xy,point-segment.xy);","  if(segment.y<=point.y&&segment.w>point.y&&cross>0.0){winding++;}","  if(segment.y>point.y&&segment.w<=point.y&&cross<0.0){winding--;}","let inside=(abs(winding)%2)==1;","let allowed=true;","classifications[classificationsOffset+index]=select(select(select(1u,0u,allowed),2u,boundary),3u,!valid);","@group(0) @binding(0) var<storage, read> classifications: array<u32>;","@group(0) @binding(1) var<storage, read> positions: array<f32>;","@group(0) @binding(2) var<storage, read> segments: array<f32>;","const outputOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> output: array<u32>;","  _ = &output;","  let first=index/3u;","let second=index%3u;","let origin=vec2<f32>(positions[positionsOffset+2u*first],positions[positionsOffset+2u*first+1u]);","let destination=vec2<f32>(positions[positionsOffset+2u*second],positions[positionsOffset+2u*second+1u]);","let displacement=destination-origin;","let distance=length(displacement);","let valid=classifications[classificationsOffset+first]==0u&&classifications[classificationsOffset+second]==0u&&isFiniteValue(origin.x)&&isFiniteValue(origin.y)&&isFiniteValue(destination.x)&&isFiniteValue(destination.y);","var visible=false;","if(valid&&first!=second&&distance>0.000001&&distance<=1.1){","  let hit=castRay(origin,displacement/distance,distance);","  visible=hit.y<0.0;","output[outputOffset+index]=select(u32(visible),0xffffffffu,!valid);","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<u32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<u32>;","  _ = &source;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index];","const adjacencyOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> adjacency: array<u32>;","const pairIdsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> pairIds: array<u32>;","const pairFlagsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> pairFlags: array<u32>;","  _ = &adjacency;","  _ = &pairIds;","  _ = &pairFlags;","  pairIds[pairIdsOffset+index]=index;","pairFlags[pairFlagsOffset+index]=u32(index/3u<index%3u&&adjacency[adjacencyOffset+index]==1u);","const invalidFlagsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> invalidFlags: array<u32>;","  _ = &invalidFlags;","  invalidFlags[invalidFlagsOffset+index]=u32(adjacency[adjacencyOffset+index*3u+index]==0xffffffffu);","const compactPairsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> compactPairs: array<u32>;","const requiredCountOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> requiredCount: array<u32>;","const edgesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> edges: array<u32>;","  _ = &compactPairs;","  _ = &requiredCount;","  _ = &edges;","  let stored=index<requiredCount[requiredCountOffset];","let pair=compactPairs[compactPairsOffset+min(index,8u)];","edges[edgesOffset+index*2u]=select(0xffffffffu,pair/3u,stored);","edges[edgesOffset+index*2u+1u]=select(0xffffffffu,pair%3u,stored);","@group(0) @binding(0) var<storage, read> requiredCount: array<u32>;","const invalidCountOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> invalidCount: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> status: array<u32>;","  _ = &invalidCount;","  _ = &status;","  let required=requiredCount[requiredCountOffset];","status[statusOffset]=min(required,1u);","status[statusOffset+1u]=required;","status[statusOffset+2u]=u32(required>1u);","status[statusOffset+3u]=invalidCount[invalidCountOffset];","@group(0) @binding(1) var<storage, read> status: array<u32>;","const maximumDepthOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> maximumDepth: array<f32>;","const metricsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> metrics: array<f32>;","const contributionsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> contributions: array<f32>;","@compute @workgroup_size(2)","  _ = &maximumDepth;","  _ = &metrics;","  _ = &contributions;","  if (workgroupIndex >= 2147483648u) { return; }","  let index = workgroupIndex * 2u + localInvocationIndex;","  var distances:array<i32,3>;var paths:array<f32,3>;var dependency:array<f32,3>;var queue:array<u32,3>;","for(var vertex=0u;vertex<3u;vertex++){distances[vertex]=-1;}","queue[0u]=index;distances[index]=0;paths[index]=1.0;var head=0u;var tail=1u;var degree=0.0;var distanceSum=0.0;","for(var vertex=0u;vertex<3u;vertex++){degree+=f32(adjacency[adjacencyOffset+index*3u+vertex]==1u);}","loop{if(head>=tail){break;}let vertex=queue[head];head++;","for(var neighbor=0u;neighbor<3u;neighbor++){if(adjacency[adjacencyOffset+vertex*3u+neighbor]!=1u){continue;}","if(distances[neighbor]<0){distances[neighbor]=distances[vertex]+1;queue[tail]=neighbor;tail++;distanceSum+=f32(distances[neighbor]);}","if(distances[neighbor]==distances[vertex]+1){paths[neighbor]+=paths[vertex];}","}}","var reverse=tail;loop{if(reverse==0u){break;}reverse--;let vertex=queue[reverse];for(var predecessor=0u;predecessor<3u;predecessor++){if(adjacency[adjacencyOffset+predecessor*3u+vertex]==1u&&distances[predecessor]==distances[vertex] - 1){dependency[predecessor]+=paths[predecessor]/paths[vertex]*(1.0+dependency[vertex]);}}}","var maximum=0.0;for(var vertex=0u;vertex<3u;vertex++){maximum=max(maximum,f32(distances[vertex]));}maximumDepth[maximumDepthOffset+index]=maximum;","// Contract: one invalid viewpoint (status word 3) invalidates the summary metrics of every viewpoint.","let valid=status[statusOffset+3u]==0u;let missing=bitcast<f32>(0x7fc00000u | (index & 0u));","metrics[metricsOffset+4u*index]=select(missing,degree,valid);metrics[metricsOffset+4u*index+1u]=select(missing,f32(tail - 1u),valid);metrics[metricsOffset+4u*index+2u]=select(missing,distanceSum,valid);metrics[metricsOffset+4u*index+3u]=select(missing,f32(tail - 1u)/distanceSum,valid&&distanceSum>0.0);","for(var vertex=0u;vertex<3u;vertex++){contributions[contributionsOffset+index*3u+vertex]=select(missing,select(dependency[vertex],0.0,vertex==index),valid);}","@group(0) @binding(0) var<storage, read> contributions: array<f32>;","@group(0) @binding(1) var<storage, read_write> output: array<f32>;","  var total=0.0;for(var source=0u;source<3u;source++){total+=contributions[contributionsOffset+source*3u+index];}output[outputOffset+index]=0.5*total;","@group(0) @binding(0) var<storage, read> source: array<f32>;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","@group(0) @binding(0) var<storage, read> maximumDepth: array<f32>;","const extendedOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> extended: array<f32>;","@group(0) @binding(2) var<storage, read> metrics: array<f32>;","const choiceOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> choice: array<f32>;","const integrationOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> integration: array<f32>;","const normalizedOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> normalized: array<f32>;","  _ = &extended;","  _ = &choice;","  _ = &integration;","  _ = &normalized;","  let reachable=metrics[metricsOffset+4u*index+1u];let total=metrics[metricsOffset+4u*index+2u];let size=reachable+1.0;","let missing=bitcast<f32>(0x7fc00000u | (index & 0u));var mean=missing;var asymmetry=missing;var real=missing;var hillier=missing;","if(reachable>0.0){mean=total/reachable;}","if(size>2.0){asymmetry=2.0*(mean-1.0)/(size-2.0);let normalization=2.0*(size*(log2((size+2.0)/3.0)-1.0)+1.0)/((size-1.0)*(size-2.0));real=asymmetry/normalization;hillier=1.0/real;}","integration[integrationOffset+4u*index]=mean;integration[integrationOffset+4u*index+1u]=asymmetry;integration[integrationOffset+4u*index+2u]=real;integration[integrationOffset+4u*index+3u]=hillier;","let maximum=maximumDepth[maximumDepthOffset+index];var pyramid=missing;var teklenburg=missing;var penn=missing;","if(size>2.0&&mean>1.0){let normalization=2.0*(size-log2(size)-1.0)/((size-1.0)*(size-2.0));pyramid=normalization/asymmetry;if(total-size+1.0>1.0){teklenburg=log(0.5*(size-2.0))/log(total-size+1.0);}let radius=min(maximum,size-1.0);let greatest=radius*(size-0.5*(radius+1.0));let least=size-1.0;if(greatest>least){penn=(greatest-total)/(greatest-least);}}","extended[extendedOffset+4u*index]=pyramid;extended[extendedOffset+4u*index+1u]=teklenburg;extended[extendedOffset+4u*index+2u]=penn;extended[extendedOffset+4u*index+3u]=select(missing,maximum,reachable>=0.0);","normalized[normalizedOffset+index]=select(missing,2.0*choice[choiceOffset+index]/f32(2),3>2);"],"strings":["buffer","read","compute","read_write","gpu-spatial-analysis-visibility-graph-recipe-snapshot-tap","lens-output-copy","visibility-graph","transient","visibility-graph-choice","visibility-graph-adjacency","visibility-graph-pair-flags","imported","visibility-graph-edges","visibility-graph-compact-pairs-scatter","visibility-graph-normalized-analysis","visibility-graph-hop-analysis","visibility-graph-invalid-flags","visibility-graph-metrics","visibility-graph-status","visibility-graph-viewpoint-classifications","destination","source","visibility-graph-compact","visibility-graph-required-count","visibility-graph-visibility","visibility-graph-choice-contributions","visibility-graph-classify-viewpoints","visibility-graph-extended-integration","visibility-graph-integration","visibility-graph-maximum-depth","visibility-graph-normalized-choice","urban-ecology-capture-10","urban-ecology-capture-12","urban-ecology-capture-14","urban-ecology-capture-16","urban-ecology-capture-18","urban-ecology-capture-2","urban-ecology-capture-4","urban-ecology-capture-6","urban-ecology-capture-8","urban-ecology-copy-11","urban-ecology-copy-13","urban-ecology-copy-15","urban-ecology-copy-17","urban-ecology-copy-19","urban-ecology-copy-5","urban-ecology-copy-9","urban-ecology-observers