,"  let key = vec2u(0u, sortedLow[sortedLowOffset + index]);","  let isValid = !isInvalidKey(key);","  var isHead = isValid;","  if (isValid && index > 0u) {","    isHead = any(key != vec2u(0u, sortedLow[sortedLowOffset + index - 1u]));","  heads[headsOffset + index] = select(0u, 1u, isHead);","  let isLastValid = isValid && (index + 1u == ROW_COUNT || isInvalidKey(vec2u(0u, sortedLow[sortedLowOffset + index + 1u])));","  if (isLastValid) {","    validCount[validCountOffset] = index + 1u;","  } else if (index == 0u && !isValid) {","    validCount[validCountOffset] = 0u;","@group(0) @binding(1) var<storage, read> validCount: array<u32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> offsets: array<u32>;","const groupTotalOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> groupTotal: array<u32>;","  _ = &offsets;","  _ = &groupTotal;","  var low = 0u;","  var high = validCount[validCountOffset];","  while (low < high) {","    let middle = (low + high) / 2u;","    if (sortedLow[sortedLowOffset + middle] < index) {","      low = middle + 1u;","    } else {","      high = middle;","    }","  offsets[offsetsOffset + index] = low;","  if (index == 0u) {","    groupTotal[groupTotalOffset] = 4u;","const positionGroupsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> positionGroups: array<u32>;","  _ = &positionGroups;","  positionGroups[positionGroupsOffset + index] =","    select(0xffffffffu, sortedLow[sortedLowOffset + index], index < validCount[validCountOffset]);","const indicesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> indices: array<u32>;","const sourceOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> source: array<u32>;","const gatheredOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> gathered: array<u32>;","  _ = &indices;","  _ = &source;","  _ = &gathered;","  gathered[gatheredOffset + index] = source[sourceOffset + indices[indicesOffset + index]];","const permutationOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> permutation: array<u32>;","@group(0) @binding(1) var<storage, read> positionGroups: array<u32>;","const rowGroupsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> rowGroups: array<u32>;","  _ = &permutation;","  _ = &rowGroups;","  rowGroups[rowGroupsOffset + permutation[permutationOffset + index]] =","    positionGroups[positionGroupsOffset + index];","@group(0) @binding(0) var<storage, read> offsets: array<u32>;","const keysOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> keysOut: array<u32>;","const countsOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> countsOut: array<u32>;","  _ = &keysOut;","  _ = &countsOut;","  keysOut[keysOutOffset + index] = index;","  countsOut[countsOutOffset + index] = offsets[offsetsOffset + index + 1u] - offsets[offsetsOffset + index];","const totalInOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> totalIn: array<u32>;","const countOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> countOut: array<u32>;","const overflowOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> overflowOut: array<u32>;","const totalOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> totalOut: array<u32>;","override CAPACITY: u32;","  _ = &totalIn;","  _ = &countOut;","  _ = &overflowOut;","  _ = &totalOut;","  let total = totalIn[totalInOffset];","  let count = min(total, CAPACITY);","    countOut[countOutOffset] = count;","    overflowOut[overflowOutOffset] = select(0u, 1u, total > CAPACITY);","    totalOut[totalOutOffset] = total;","@group(0) @binding(0) var<storage, read> rowGroups: array<u32>;","@group(0) @binding(1) var<storage, read> valueBits: array<u32>;","@group(0) @binding(2) var<storage, read_write> finiteCounts: array<atomic<u32>>;","const SUM_SCALE: f32 = 65536.0;","const MAXIMUM_SCALED_VALUE: f32 = 4611685743549481000.0;","// Not dggs_u64_add and friends: pulling in the dggs module costs compile time (see cell-keys.ts).","fn cellAddI64(left: vec2u, right: vec2u) -> vec2u {","  let low = left.y + right.y;","  return vec2u(left.x + right.x + select(0u, 1u, low < left.y), low);","fn cellNegateI64(value: vec2u) -> vec2u {","  let low = ~value.y + 1u;","  return vec2u(~value.x + select(0u, 1u, low == 0u), low);","/** roundHalfEven(value * SUM_SCALE), saturated, as a two's-complement 64-bit integer. */","fn cellScaleValue(value: f32) -> vec2u {","  let scaled = clamp(round(value * SUM_SCALE), -MAXIMUM_SCALED_VALUE, MAXIMUM_SCALED_VALUE);","  let magnitude = abs(scaled);","  let highFloat = floor(magnitude * 2.3283064365386963e-10);","  let lowFloat = magnitude - highFloat * 4294967296.0;","  let result = vec2u(u32(highFloat), u32(lowFloat));","  return select(result, cellNegateI64(result), scaled < 0.0);","fn cellI64ToF32(value: vec2u) -> f32 {","  let isNegative = (value.x & 0x80000000u) != 0u;","  let magnitude = select(value, cellNegateI64(value), isNegative);","  let result = f32(magnitude.x) * 4294967296.0 + f32(magnitude.y);","  return select(result, -result, isNegative);","const GROUP_CAPACITY: u32 = 4u;","var<workgroup> localCounts: array<atomic<u32>, 4>;","@compute @workgroup_size(256)","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  for (var slot = localInvocationIndex; slot < GROUP_CAPACITY; slot += 256u) {","    atomicStore(&localCounts[slot], 0u);","  workgroupBarrier();","  if (index < INVOCATION_COUNT) {","    let group = rowGroups[rowGroupsOffset + index];","    let bits = valueBits[valueBitsOffset + index];","    if (group != 4294967295u && isFiniteBits(bits)) {","      atomicAdd(&localCounts[group], 1u);","      ","    let count = atomicLoad(&localCounts[slot]);","    if (count != 0u) {","      atomicAdd(&finiteCounts[finiteCountsOffset + slot], count);","@group(0) @binding(0) var<storage, read> source: array<u32>;","const destinationOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> destination: array<u32>;","  _ = &destination;","  destination[destinationOffset + index] = source[sourceOffset + index];","@group(0) @binding(0) var<storage, read> finiteCounts: array<u32>;","@group(0) @binding(1) var<storage, read_write> countsOut: array<u32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn getOrderedKey(x: f32) -> u32 {","  let bits = bitcast<u32>(x);","fn decodeOrderedKey(key: u32) -> f32 {","  return bitcast<f32>(select(~key, key ^ 0x80000000u, (key & 0x80000000u) != 0u));","  let count = finiteCounts[finiteCountsOffset + index];","  countsOut[countsOutOffset + index] = count;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","const sortedKeysOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> sortedKeys: array<u32>;","const mediansOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> mediansOut: array<f32>;","fn isOrderStatisticProbability(p: f32) -> bool {","  // Ordered comparisons with NaN are false, but a compiler may fold them; test the bits.","  let bits = bitcast<u32>(p);","  if ((bits & 0x7f800000u) == 0x7f800000u) {","    return false;","  return p >= 0.0 && p <= 1.0;","fn getOrderStatisticKey(value: f32) -> u32 {","  var bits = bitcast<u32>(value);","// Identity the compiler cannot fold: the bit operation on a runtime zero stops multiply-add","// fusion, so every f32 step rounds exactly like a Math.fround mirror.","fn roundOrderStatisticStep(value: f32, zero: u32) -> f32 {","  return bitcast<f32>(bitcast<u32>(value) | zero);","fn interpolateOrderStatistic(low: f32, high: f32, fraction: f32, zero: u32) -> f32 {","  if (fraction == 0.0 || low == high) {","    return low;","  let difference = roundOrderStatisticStep(high - low, zero);","  if ((bitcast<u32>(difference) & 0x7f800000u) != 0x7f800000u) {","    return low + roundOrderStatisticStep(difference * fraction, zero);","  // high - low overflowed; a convex combination of two finite values cannot.","  return roundOrderStatisticStep(low * (1.0 - fraction), zero) +","    roundOrderStatisticStep(high * fraction, zero);","fn getOrderStatisticMidpoint(low: f32, high: f32, zero: u32) -> f32 {","  if (low == high) {","  let sum = roundOrderStatisticStep(low + high, zero);","  if ((bitcast<u32>(sum) & 0x7f800000u) != 0x7f800000u) {","    return sum * 0.5;","  return roundOrderStatisticStep(low * 0.5, zero) + roundOrderStatisticStep(high * 0.5, zero);","fn getQuantile(begin: u32, count: u32, p: f32) -> f32 {","  if (count == 0u || !isOrderStatisticProbability(p)) {","    return getNaN();","  // Counts stay below 2^31, so this is a runtime zero that blocks multiply-add fusion.","  let zero = count >> 31u;","  let h = roundOrderStatisticStep(f32(count - 1u) * p, zero);","  let floorH = floor(h);","  let lowIndex = min(u32(floorH), count - 1u);","  let low = decodeOrderedKey(sortedKeys[sortedKeysOffset + begin + lowIndex]);","  if (lowIndex + 1u >= count) {","  let high = decodeOrderedKey(sortedKeys[sortedKeysOffset + begin + lowIndex + 1u]);","  return interpolateOrderStatistic(low, high, h - floorH, zero);","  _ = &sortedKeys;","  _ = &mediansOut;","  var begin = 0u;","  if (count > 0u) {","    begin = offsets[offsetsOffset + index];","  mediansOut[mediansOutOffset + index] = getQuantile(begin, count, 0.5);","const fractionsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> fractions: array<f32>;","const percentilesOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> percentilesOut: array<f32>;","const PERCENTILE_COUNT: u32 = 5u;","  _ = &fractions;","  _ = &percentilesOut;","  let group = index / PERCENTILE_COUNT;","  let count = finiteCounts[finiteCountsOffset + group];","    begin = offsets[offsetsOffset + group];","  percentilesOut[percentilesOutOffset + index] =","    getQuantile(begin, count, fractions[fractionsOffset + index % PERCENTILE_COUNT]);","@group(0) @binding(0) var<storage, read> sortedKeys: array<u32>;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","@group(0) @binding(3) var<storage, read_write> heads: array<u32>;","  let group = positionGroups[positionGroupsOffset + index];","  let key = sortedKeys[sortedKeysOffset + index];","  var isHead = group != 0xffffffffu && key != 0xffffffffu;","  if (isHead && index != offsets[offsetsOffset + group]) {","    isHead = key != sortedKeys[sortedKeysOffset + index - 1u];","@group(0) @binding(0) var<storage, read> source: array<f32>;","@group(0) @binding(1) var<storage, read_write> destination: array<f32>;","@group(0) @binding(0) var<storage, read> heads: array<u32>;","const runIndicesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> runIndices: array<u32>;","const runStartsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> runStarts: array<u32>;","  _ = &runIndices;","  _ = &runStarts;","  if (heads[headsOffset + index] != 0u) {","    runStarts[runStartsOffset + runIndices[runIndicesOffset + index]] = index;","@group(0) @binding(2) var<storage, read> runStarts: array<u32>;","@group(0) @binding(3) var<storage, read> positionGroups: array<u32>;","@group(0) @binding(4) var<storage, read> offsets: array<u32>;","@group(0) @binding(5) var<storage, read> finiteCounts: array<u32>;","@group(0) @binding(6) var<storage, read_write> maximumLengths: array<atomic<u32>>;","@group(0) @binding(7) var<storage, read_write> uniqueCounts: array<atomic<u32>>;","  if (heads[headsOffset + index] == 0u) {","  let run = runIndices[runIndicesOffset + index];","  let totalRuns = runIndices[runIndicesOffset + ROW_COUNT - 1u] + heads[headsOffset + ROW_COUNT - 1u];","  var nextStart = ROW_COUNT;","  if (run + 1u < totalRuns) {","    nextStart = runStarts[runStartsOffset + run + 1u];","  let runEnd = min(nextStart, offsets[offsetsOffset + group] + finiteCounts[finiteCountsOffset + group]);","  let runLength = runEnd - index;","  atomicMax(&maximumLengths[maximumLengthsOffset + group], runLength);","  atomicAdd(&uniqueCounts[uniqueCountsOffset + group], 1u);","@group(0) @binding(7) var<storage, read_write> modeRuns: array<atomic<u32>>;","  if (runLength == atomicLoad(&maximumLengths[maximumLengthsOffset + group])) {","    atomicMin(&modeRuns[modeRunsOffset + group], run);","@group(0) @binding(0) var<storage, read> uniqueCounts: array<u32>;","const uniqueOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> uniqueOut: array<u32>;","  _ = &uniqueOut;","  uniqueOut[uniqueOutOffset + index] = uniqueCounts[uniqueCountsOffset + index];","@group(0) @binding(1) var<storage, read> modeRuns: array<u32>;","@group(0) @binding(3) var<storage, read> sortedKeys: array<u32>;","const modesOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> modesOut: array<f32>;","  _ = &modesOut;","  var mode = getNaN();","  if (finiteCounts[finiteCountsOffset + index] > 0u) {","    mode = decodeOrderedKey(","      sortedKeys[sortedKeysOffset + runStarts[runStartsOffset + modeRuns[modeRunsOffset + index]]]","    );","  modesOut[modesOutOffset + index] = mode;"],"strings":["read","GPUGroupStatistics","buffer","read_write","compute","transient","zonal-distribution-recipe-statistics-c0-mode-runs","zonal-distribution-recipe-statistics-c0-finite-counts","zonal-distribution-recipe-statistics-c0-run-heads","zonal-distribution-recipe-statistics-offsets","zonal-distribution-recipe-statistics-c0-run-starts","zonal-distribution-recipe-statistics-c0-value-bits","gpu-spatial-analysis-zonal-distribution-recipe-snapshot-tap","zonal-distribution-recipe-statistics-c0-sorted-keys","zonal-distribution-recipe-statistics-position-groups","zonal-distribution-recipe-statistics-c0-value-keys","lens-output-copy","zonal-distribution-recipe-statistics-row-groups","zonal-distribution-recipe-statistics-c0-accumulate","zonal-distribution-recipe-statistics-dense-offsets","imported","zonal-dist