e-peaks-compiled","resource":"profileRefinedValue","meaning":"parabola-refined peak elevation (m)","role":"intermediate","keySpace":"profile-samples","geometry":{"kind":"raster","shape":[64,1],"coordinateModel":"unknown"}},{"id":"gpu-terrain-profile-peaks-snapshots-profilePeakMask-0","name":"profilePeakMask","iteration":0,"elementType":"u32","values":"rle:AAAAAAAAAAAAAAAAAAAAAAAAAAABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABAAAA,*30:00000000,AQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAQAAAAAAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==","provenance":"gpu-readback","graph":"gpu-terrain-profile-peaks-compiled","resource":"profilePeakMask","meaning":"kept peak mask (1 on a kept peak)","role":"intermediate","keySpace":"profile-samples","geometry":{"kind":"raster","shape":[64,1],"coordinateModel":"unknown"}},{"id":"gpu-terrain-profile-peaks-snapshots-profilePeaksConverged-0","name":"profilePeaksConverged","iteration":0,"elementType":"u32","values":"b64:AQAAAA==","provenance":"gpu-readback","graph":"gpu-terrain-profile-peaks-compiled","resource":"profilePeaksConverged","meaning":"converged: profile-peaks-nms","role":"intermediate"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const sampleValuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> sampleValues: array<f32>;","const profileOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> profileOffsets: array<u32>;","const settingsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> settings: array<f32>;","const candidateProminenceOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> candidateProminence: array<f32>;","const candidateDeltaOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> candidateDelta: array<f32>;","const candidateValueOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> candidateValue: array<f32>;","const candidateStateOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> candidateState: array<u32>;","const SAMPLE_COUNT: u32 = 64u;","const PROFILE_COUNT: u32 = 1u;","const WRAP: bool = false;","// Returns [start, end) of the profile owning `sample`, or [0, 0) when it belongs to none.","fn findProfile(sample: u32) -> vec2<u32> {","  var low = 0u;","  var high = PROFILE_COUNT;","  for (var step = 0u; step < 32u && low < high; step++) {","    let middle = low + (high - low) / 2u;","    if (profileOffsets[profileOffsetsOffset + middle + 1u] > sample) {","      high = middle;","    } else {","      low = middle + 1u;","    }","  }","  if (low >= PROFILE_COUNT) { return vec2<u32>(0u, 0u); }","  let start = profileOffsets[profileOffsetsOffset + low];","  let end = min(profileOffsets[profileOffsetsOffset + low + 1u], SAMPLE_COUNT);","  if (start > sample || sample >= end) { return vec2<u32>(0u, 0u); }","  return vec2<u32>(start, end);","}","// Local index of the neighbour `delta` samples away, or -1 when it is outside a non-wrapped profile.","fn neighborLocal(local: u32, delta: i32, count: u32) -> i32 {","  let position = i32(local) + delta;","  let signedCount = i32(count);","  if (WRAP) { return ((position % signedCount) + signedCount) % signedCount; }","  if (position < 0 || position >= signedCount) { return -1; }","  return position;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","const WINDOW: u32 = 8u;","const MIN_SIDE: u32 = 4u;","const STATE_INERT: u32 = 0u;","const STATE_UNDECIDED: u32 = 1u;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn isGap(sample: u32) -> bool {","  ","  return !isFiniteValue(sampleValues[sampleValuesOffset + sample]);","fn writeInert(sample: u32) {","  candidateProminence[candidateProminenceOffset + sample] = getNaN();","  candidateDelta[candidateDeltaOffset + sample] = 0.0;","  candidateValue[candidateValueOffset + sample] = getNaN();","  candidateState[candidateStateOffset + sample] = STATE_INERT;","struct Side {","  lowest: f32,","  valid: u32,","// Walks away from a candidate; the first higher sample is counted as valid but not as lowest.","fn walkSide(start: u32, count: u32, local: u32, peak: f32, direction: i32) -> Side {","  var side = Side(peak, 0u);","  var limit = WINDOW;","  if (WRAP) { limit = min(WINDOW, count - 1u); }","  for (var step = 1u; step <= limit; step++) {","    let neighbor = neighborLocal(local, direction * i32(step), count);","    if (neighbor < 0) { break; }","    let sample = start + u32(neighbor);","    if (isGap(sample)) { break; }","    side.valid = side.valid + 1u;","    let other = sampleValues[sampleValuesOffset + sample];","    if (other > peak) { break; }","    if (other < side.lowest) { side.lowest = other; }","  return side;","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &sampleValues;","  _ = &profileOffsets;","  _ = &settings;","  _ = &candidateProminence;","  _ = &candidateDelta;","  _ = &candidateValue;","  _ = &candidateState;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let range = findProfile(index);","  let count = range.y - range.x;","  if (count == 0u) { writeInert(index); return; }","  let start = range.x;","  let local = index - start;","  if (!WRAP && (local < 1u || local + 1u >= count)) { writeInert(index); return; }","  if (isGap(index)) { writeInert(index); return; }","  let peak = sampleValues[sampleValuesOffset + index];","  for (var offset = -2; offset <= 2; offset++) {","    if (offset == 0) { continue; }","    let neighbor = neighborLocal(local, offset, count);","    if (neighbor < 0) { continue; }","    if (sample == index || isGap(sample)) { continue; }","    if (other > peak || (offset < 0 && other == peak)) { writeInert(index); return; }","  let left = walkSide(start, count, local, peak, -1);","  let right = walkSide(start, count, local, peak, 1);","  if (left.valid < MIN_SIDE || right.valid < MIN_SIDE) { writeInert(index); return; }","  let prominence = peak - max(left.lowest, right.lowest);","  if (prominence < settings[settingsOffset]) { writeInert(index); return; }","  var delta = 0.0;","  var refined = peak;","  let previous = start + u32(neighborLocal(local, -1, count));","  let next = start + u32(neighborLocal(local, 1, count));","  if (!isGap(previous) && !isGap(next)) {","    let a = sampleValues[sampleValuesOffset + previous];","    let c = sampleValues[sampleValuesOffset + next];","    let denominator = a - 2.0 * peak + c;","    if (denominator < 0.0) {","      delta = clamp(0.5 * (a - c) / denominator, -0.5, 0.5);","      refined = peak - 0.25 * (a - c) * delta;","  candidateProminence[candidateProminenceOffset + index] = prominence;","  candidateDelta[candidateDeltaOffset + index] = delta;","  candidateValue[candidateValueOffset + index] = refined;","  candidateState[candidateStateOffset + index] = STATE_UNDECIDED;","const statusOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> status: array<u32>;","const dispatchOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> dispatch: array<u32>;","@compute @workgroup_size(32)","  _ = &status;","  _ = &dispatch;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  status[statusOffset + 0u] = 0u;","  status[statusOffset + 1u] = 1u;","  status[statusOffset + 2u] = 0u;","  status[statusOffset + 3u] = 0u;","  dispatch[dispatchOffset + 0u] = 1u;","  dispatch[dispatchOffset + 1u] = 1u;","  dispatch[dispatchOffset + 2u] = 1u;","const slotTableOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> slotTable: array<u32>;","  _ = &slotTable;","  slotTable[slotTableOffset + index * 64u] = index;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","  _ = &fillTarget;","  fillTarget[fillTargetOffset + index] = 1u;","@group(0) @binding(0) var<storage, read> profileOffsets: array<u32>;","@group(0) @binding(1) var<storage, read> candidateProminence: array<f32>;","@group(0) @binding(2) var<storage, read> candidateDelta: array<f32>;","@group(0) @binding(3) var<storage, read_write> candidateState: array<atomic<u32>>;","@group(0) @binding(4) var<storage, read_write> status: array<atomic<u32>>;","const roundSlotOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read> roundSlot: array<u32>;","const NMS_RADIUS: f32 = 2.0;","const SCAN_RADIUS: u32 = 3u;","const STATE_KEPT: u32 = 2u;","const STATE_SUPPRESSED: u32 = 3u;","  _ = &roundSlot;","  if (atomicLoad(&candidateState[candidateStateOffset + index]) != STATE_UNDECIDED) { return; }","  let prominenceSelf = candidateProminence[candidateProminenceOffset + index];","  let deltaSelf = candidateDelta[candidateDeltaOffset + index];","  var undecided = false;","  for (var step = 1u; step <= SCAN_RADIUS; step++) {","    for (var side = 0; side < 2; side++) {","      let direction = select(-1, 1, side == 1);","      let neighbor = neighborLocal(local, direction * i32(step), count);","      if (neighbor < 0 || u32(neighbor) == local) { continue; }","      let sample = start + u32(neighbor);","      let state = atomicLoad(&candidateState[candidateStateOffset + sample]);","      if (state != STATE_UNDECIDED && state != STATE_KEPT) { continue; }","      let prominenceOther = candidateProminence[candidateProminenceOffset + sample];","      let higher = prominenceOther > prominenceSelf ||","        (prominenceOther == prominenceSelf && u32(neighbor) < local);","      if (!higher) { continue; }","      var distance = abs(f32(neighbor - i32(local)) +","        (candidateDelta[candidateDeltaOffset + sample] - deltaSelf));","      if (WRAP) { distance = min(distance, f32(count) - distance); }","      if (distance > NMS_RADIUS) { continue; }","      if (state == STATE_KEPT) {","        atomicStore(&candidateState[candidateStateOffset + index], STATE_SUPPRESSED);","        atomicOr(&status[statusOffset], 1u << roundSlot[roundSlotOffset]);","        return;","      }","      undecided = true;","  if (!undecided) {","    atomicStore(&candidateState[candidateStateOffset + index], STATE_KEPT);","    atomicOr(&status[statusOffset], 1u << roundSlot[roundSlotOffset]);","const groupSizeOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> groupSize: array<u32>;","  _ = &groupSize;","  if (status[statusOffset + 1u] == 0u) { return; }","  let changedBits = status[statusOffset + 0u];","  let size = groupSize[groupSizeOffset];","  var executed = size;","  var converged = false;","  for (var round = 0u; round < size; round++) {","    if (((changedBits >> round) & 1u) == 0u) {","      executed = round + 1u;","      converged = true;","      break;","  let iterationCount = status[statusOffset + 2u] + executed;","  status[statusOffset + 2u] = iterationCount;","  if (converged) {","    status[statusOffset + 1u] = 0u;","    status[statusOffset + 3u] = 1u;","    dispatch[dispatchOffset + 0u] = 0u;","  if (iterationCount >= 16u) {","@group(0) @binding(0) var<storage, read> candidateState: array<u32>;","const convergedOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> convergedOut: array<atomic<u32>>;","  _ = &convergedOut;","  if (candidateState[candidateStateOffset + index] == 1u) {","    atomicStore(&convergedOut[convergedOutOffset], 0u);","const prominenceOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> prominenceOut: array<f32>;","@group(0) @binding(3) var<storage, read> candidateValue: array<f32>;","const refinedValueOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> refinedValueOut: array<f32>;","const peakMaskOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> peakMaskOut: array<u32>;","fn getInfinity() -> f32 {","  var bits = 0x7f800000u;","  _ = &prominenceOut;","  _ = &refinedValueOut;","  _ = &peakMaskOut;","  let state = candidateState[candidateStateOffset + index];","  let kept = state == 2u;","  let unresolved = state == 1u;","  prominenceOut[prominenceOutOffset + index] = select(select(getNaN(), candidateProminence[candidateProminenceOffset + index], kept), getInfinity(), unresolved);","  refinedValueOut[refinedValueOutOffset + index] = select(select(getNaN(), candidateValue[candidateValueOffset + index], kept), getInfinity(), unresolved);","  peakMaskOut[peakMaskOutOffset + index] = select(select(0u, 1u, kept), 4294967295u, unresolved);","@group(0) @binding(1) var<storage, read> candidateDelta: array<f32>;","@group(0) @binding(2) var<storage, read> candidateState: array<u32>;","const refinedIndexOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> refinedIndexOut: array<f32>;","  _ = &refinedIndexOut;","  if (state != 2u) {","    refinedIndexOut[refinedIndexOutOffset + index] =","      select(getNaN(), getInfinity(), state == 1u);","  let count = f32(range.y - range.x);","  var refined = f32(index - range.x) + candidateDelta[candidateDeltaOffset + index];","  if (WRAP) {","    if (refined < 0.0) { refined = refined + count; }","    if (refined >= count) { refined = refined - count; }","  refinedIndexOut[refinedIndexOutOffset + index] = refined;"],"strings":["profile-peaks-nms-dispatch","profile-peaks-nms-status","read","profile-peaks-candidate-state","profile-peaks-nms-gate-slots","profile-peaks-candidate-delta","profile-peaks-candidate-prominence","profileOffsets","GPUProfilePeaks","read_write","profile-peaks-candidates","atomic<u32>","compute","profile-peaks-nms-gate-slots