 STATE_KEPT);","    atomicOr(&status[statusOffset], 1u << roundSlot[roundSlotOffset]);","const groupSizeOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> groupSize: array<u32>;","  _ = &groupSize;","  if (status[statusOffset + 1u] == 0u) { return; }","  let changedBits = status[statusOffset + 0u];","  let size = groupSize[groupSizeOffset];","  var executed = size;","  var converged = false;","  for (var round = 0u; round < size; round++) {","    if (((changedBits >> round) & 1u) == 0u) {","      executed = round + 1u;","      converged = true;","      break;","  let iterationCount = status[statusOffset + 2u] + executed;","  status[statusOffset + 2u] = iterationCount;","  if (converged) {","    status[statusOffset + 1u] = 0u;","    status[statusOffset + 3u] = 1u;","    dispatch[dispatchOffset + 0u] = 0u;","  if (iterationCount >= 16u) {","@group(0) @binding(0) var<storage, read> candidateState: array<u32>;","const convergedOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> convergedOut: array<atomic<u32>>;","  _ = &convergedOut;","  if (candidateState[candidateStateOffset + index] == 1u) {","    atomicStore(&convergedOut[convergedOutOffset], 0u);","const prominenceOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> prominenceOut: array<f32>;","@group(0) @binding(3) var<storage, read> candidateValue: array<f32>;","const refinedValueOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> refinedValueOut: array<f32>;","const peakMaskOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> peakMaskOut: array<u32>;","fn getInfinity() -> f32 {","  var bits = 0x7f800000u;","  _ = &prominenceOut;","  _ = &refinedValueOut;","  _ = &peakMaskOut;","  let state = candidateState[candidateStateOffset + index];","  let kept = state == 2u;","  let unresolved = state == 1u;","  prominenceOut[prominenceOutOffset + index] = select(select(getNaN(), candidateProminence[candidateProminenceOffset + index], kept), getInfinity(), unresolved);","  refinedValueOut[refinedValueOutOffset + index] = select(select(getNaN(), candidateValue[candidateValueOffset + index], kept), getInfinity(), unresolved);","  peakMaskOut[peakMaskOutOffset + index] = select(select(0u, 1u, kept), 4294967295u, unresolved);","@group(0) @binding(1) var<storage, read> candidateDelta: array<f32>;","@group(0) @binding(2) var<storage, read> candidateState: array<u32>;","const refinedIndexOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> refinedIndexOut: array<f32>;","  _ = &refinedIndexOut;","  if (state != 2u) {","    refinedIndexOut[refinedIndexOutOffset + index] =","      select(getNaN(), getInfinity(), state == 1u);","  let count = f32(range.y - range.x);","  var refined = f32(index - range.x) + candidateDelta[candidateDeltaOffset + index];","  if (WRAP) {","    if (refined < 0.0) { refined = refined + count; }","    if (refined >= count) { refined = refined - count; }","  refinedIndexOut[refinedIndexOutOffset + index] = refined;"],"strings":["profile-peaks-nms-dispatch","profile-peaks-nms-status","read","profile-peaks-candidate-state","profile-peaks-nms-gate-slots","profile-peaks-candidate-delta","profile-peaks-candidate-prominence","profileOffsets","GPUProfilePeaks","read_write","profile-peaks-candidates","atomic<u32>","compute","profile-peaks-nms-gate-slots-write","status","candidateState","candidateDelta","candidateProminence","indirect","roundSlot","suppression","wgsl:3c5b4bdb","buffer","logical","profile-peaks-nms-gate-0","profile-peaks-nms-gate-4","profile-peaks-nms-gate-8","gpu-terrain-profile-peaks-snapshot-tap","profile-peaks-nms-15","profile-peaks-outputs","profile-peaks-nms-gate-12","profile-peaks-nms-0","profile-peaks-nms-1","profile-peaks-nms-10","profile-peaks-nms-11","profile-peaks-nms-12","profile-peaks-nms-13","profile-peaks-nms-14","profile-peaks-nms-2","profile-peaks-nms-3","profile-peaks-nms-4","profile-peaks-nms-5","profile-peaks-nms-6","profile-peaks-nms-7","profile