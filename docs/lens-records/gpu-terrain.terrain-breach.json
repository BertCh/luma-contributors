 0u;","@group(0) @binding(3) var<storage, read_write> paths: array<u32>;","const lengthsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> lengths: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> status: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","// A direction word outside the contributor's encoding: nonzero and without a receiver.","const INVALID_DIRECTION_CODE: u32 = 0x100u;","fn getFlowDirectionCode(word: u32) -> u32 { return word; }","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  }","  return u32(row) * GRID_WIDTH + u32(column);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn infinity() -> f32 { var bits = 0x7f800000u; return bitcast<f32>(bits); }","fn searchIndex(cell: u32, origin: vec2<u32>) -> u32 {"," let column = cell % GRID_WIDTH; let row = cell / GRID_WIDTH;"," if (column < origin.x || row < origin.y || column >= origin.x + 3u || row >= origin.y + 3u) { return NO_CELL; }"," return (row - origin.y) * 3u + column - origin.x;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &elevation;","  _ = &pits;","  _ = &scratch;","  _ = &paths;","  _ = &lengths;","  _ = &status;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let pit = pits[pitsOffset + index];","let pathOffset = pathsOffset + index * 3u;","lengths[lengthsOffset + index] = 0u; status[statusOffset + index] = 0u;","for (var step = 0u; step <= 2u; step++) { paths[pathOffset + step] = NO_CELL; }","if (pit >= 9u) { return; }","let base = elevation[elevationOffset + pit];","if (!isFiniteValue(base) || !(base - 0.5 < base)) { return; }","let origin = vec2<u32>(u32(clamp(i32(pit % GRID_WIDTH) - 2, 0, 0)), u32(clamp(i32(pit / GRID_WIDTH) - 2, 0, 0)));","let workOffset = scratchOffset + index * 54u;","for (var entry = 0u; entry < 27u; entry++) { scratch[workOffset + entry * 2u] = 0x7f800000u; scratch[workOffset + entry * 2u + 1u] = NO_CELL; }","scratch[workOffset + searchIndex(pit, origin) * 2u] = bitcast<u32>(0.0);","var bestCost = infinity(); var bestCell = NO_CELL; var bestStep = 0u;","for (var step = 1u; step <= 2u; step++) {"," let level = base - f32(step) * 0.5;"," for (var localCell = 0u; localCell < 9u; localCell++) {","  let cell = (origin.y + localCell / 3u) * GRID_WIDTH + origin.x + localCell % 3u;","  let original = elevation[elevationOffset + cell];","  let cut = max(original - level, 0.0);","  if (!isFiniteValue(original) || cut > 4.0) { continue; }","  var predecessor = NO_CELL; var cost = infinity();","  for (var direction = 0u; direction < 8u; direction++) {","   let neighbor = getFlowReceiver(cell, 1u << direction); if (neighbor == NO_CELL) { continue; }","   let localNeighbor = searchIndex(neighbor, origin); if (localNeighbor == NO_CELL) { continue; }","   let candidate = bitcast<f32>(scratch[workOffset + ((step - 1u) * 9u + localNeighbor) * 2u]) + cut;","   if (candidate < cost || (candidate == cost && neighbor < predecessor)) { cost = candidate; predecessor = neighbor; }","  scratch[workOffset + (step * 9u + localCell) * 2u] = bitcast<u32>(cost);","  scratch[workOffset + (step * 9u + localCell) * 2u + 1u] = predecessor;","  if (original <= level && cost < bestCost) { bestCost = cost; bestCell = cell; bestStep = step; }"," }","if (bestCell == NO_CELL) { status[statusOffset + index] = 2u; return; }","var current = bestCell;","for (var step = bestStep; step > 0u; step--) {"," paths[pathOffset + step] = current;"," current = scratch[workOffset + (step * 9u + searchIndex(current, origin)) * 2u + 1u];","paths[pathOffset] = pit; lengths[lengthsOffset + index] = bestStep + 1u; status[statusOffset + index] = 1u;","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const editsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> edits: array<u32>;","  _ = &source;","  _ = &edits;","  let bits = bitcast<u32>(source[sourceOffset + index]); edits[editsOffset + index] = select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","const countedOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> counted: array<u32>;","  _ = &counted;","  counted[countedOffset] = 0u;","@group(0) @binding(1) var<storage, read> paths: array<u32>;","@group(0) @binding(2) var<storage, read> lengths: array<u32>;","@group(0) @binding(3) var<storage, read_write> edits: array<atomic<u32>>;","  let pitIndex = index / 3u; let step = index % 3u;","if (step == 0u || step >= lengths[lengthsOffset + pitIndex]) { return; }","let start = paths[pathsOffset + pitIndex * 3u];","let cell = paths[pathsOffset + index];","let value = source[sourceOffset + start] - f32(step) * 0.5;","let bits = bitcast<u32>(value);","atomicMin(&edits[editsOffset + cell], select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u));","@group(0) @binding(1) var<storage, read> edits: array<u32>;","@group(0) @binding(2) var<storage, read_write> elevation: array<f32>;","const depthOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> depth: array<f32>;","const maskOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> mask: array<u32>;","  _ = &depth;","  _ = &mask;","  let original = source[sourceOffset + index]; var edited = original; var flags = 0u;","if (isFiniteValue(original)) {"," let key = edits[editsOffset + index];"," edited = bitcast<f32>(select(~key, key ^ 0x80000000u, (key & 0x80000000u) != 0u));"," if (edited < original) { flags |= 1u; }"," ","elevation[elevationOffset + index] = edited; depth[depthOffset + index] = original - edited; mask[maskOffset + index] = flags;","@group(0) @binding(1) var<storage, read> mask: array<u32>;","@group(0) @binding(2) var<storage, read> paths: array<u32>;","@group(0) @binding(3) var<storage, read> lengths: array<u32>;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","  if (status[statusOffset + index] != 1u) { return; }","let pathLength = lengths[lengthsOffset + index];","for (var step = 1u; step < pathLength; step++) {"," let previous = paths[pathsOffset + index * 3u + step - 1u];"," let current = paths[pathsOffset + index * 3u + step];"," let previousElevation = elevation[elevationOffset + previous];"," let currentElevation = elevation[elevationOffset + current];"," if (((mask[maskOffset + previous] | mask[maskOffset + current]) & 4u) != 0u || !isFiniteValue(previousElevation) || !isFiniteValue(currentElevation) || !(currentElevation < previousElevation)) { status[statusOffset + index] = 2u; }","const countValuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> countValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> counted: array<atomic<u32>>;","var<workgroup> workgroupCount: atomic<u32>;","@compute @workgroup_size(256)","  _ = &countValues;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  if (localInvocationIndex == 0u) { atomicStore(&workgroupCount, 0u); }","  workgroupBarrier();","  if (index < INVOCATION_COUNT) {","    let value = countValues[countValuesOffset + index];","    if (value != 1u) { atomicAdd(&workgroupCount, 1u); }","  if (localInvocationIndex == 0u) {","    let total = atomicLoad(&workgroupCount);","    if (total != 0u) { atomicAdd(&counted[countedOffset], total); }"],"strings":["terrain-breach-search","gpu-terrain-terrain-breach-snapshot-tap","GPUTerrainBreach","elevation","pitStatus","read","pathCells","pathLengths","read_write","terrain-breach-apply","buffer","terrain-breach-edits","unresolvedCount","editedElevation","imported","modificationMask","terrain-breach-verify-paths","compute","cutDepth","terrain-breach-edit-proposals","terrain-breach-status-count","pitCells","terrain-breach-edit-initialize","terrain-breach-status-count-clear","edits","lengths","paths","source","atomic<u32>","counted","mask","status","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTran