pe":"u32","values":"b64:AwAAAA==","provenance":"gpu-readback","graph":"gpu-terrain-terrain-breach-compiled","resource":"pathLengths","meaning":"Number of cells in each selected path","role":"intermediate"},{"id":"gpu-terrain-terrain-breach-snapshots-pitStatus-0","name":"pitStatus","iteration":0,"elementType":"u32","values":"b64:AQAAAA==","provenance":"gpu-readback","graph":"gpu-terrain-terrain-breach-compiled","resource":"pitStatus","meaning":"Resolved versus exhausted pit search","role":"intermediate"},{"id":"gpu-terrain-terrain-breach-snapshots-unresolvedCount-0","name":"unresolvedCount","iteration":0,"elementType":"u32","values":"same:snapshots.1","provenance":"gpu-readback","graph":"gpu-terrain-terrain-breach-compiled","resource":"unresolvedCount","meaning":"Number of unresolved pit searches","role":"intermediate"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const elevationOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> elevation: array<f32>;","const pitsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> pits: array<u32>;","const scratchOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> scratch: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","// A direction word outside the contributor's encoding: nonzero and without a receiver.","const INVALID_DIRECTION_CODE: u32 = 0x100u;","fn getFlowDirectionCode(word: u32) -> u32 { return word; }","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  }","  return u32(row) * GRID_WIDTH + u32(column);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn infinity() -> f32 { var bits = 0x7f800000u; return bitcast<f32>(bits); }","fn searchOrigin(pit: u32) -> vec2<u32> {"," let column = pit % GRID_WIDTH; let row = pit / GRID_WIDTH;"," return min(vec2<u32>(select(0u, column - 2u, column >= 2u), select(0u, row - 2u, row >= 2u)), vec2<u32>(0u, 0u));","fn searchCell(localCell: u32, origin: vec2<u32>) -> u32 {"," return (origin.y + localCell / 3u) * GRID_WIDTH + origin.x + localCell % 3u;","fn searchIndex(cell: u32, origin: vec2<u32>) -> u32 {"," let column = cell % GRID_WIDTH; let row = cell / GRID_WIDTH;"," if (column < origin.x || row < origin.y || column >= origin.x + 3u || row >= origin.y + 3u) { return NO_CELL; }"," return (row - origin.y) * 3u + column - origin.x;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &elevation;","  _ = &pits;","  _ = &scratch;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let pitIndex = index / 27u;","let slot = index % 27u;","let pit = pits[pitsOffset + pitIndex];","var cost = 0x7f800000u;","if (pit < 9u && slot < 9u) {"," let base = elevation[elevationOffset + pit];"," if (isFiniteValue(base) && base - 0.5 < base && searchCell(slot, searchOrigin(pit)) == pit) { cost = 0u; }","scratch[scratchOffset + index * 2u] = cost;","scratch[scratchOffset + index * 2u + 1u] = NO_CELL;","const pathsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> paths: array<u32>;","  _ = &paths;","  paths[pathsOffset + index] = NO_CELL;","const winnersOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> winners: array<u32>;","const stateOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> state: array<u32>;","const lengthsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> lengths: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> status: array<u32>;","  _ = &winners;","  _ = &state;","  _ = &lengths;","  _ = &status;","  winners[winnersOffset + index * 2u] = 0x7f800000u;","winners[winnersOffset + index * 2u + 1u] = NO_CELL;","lengths[lengthsOffset + index] = 0u; status[statusOffset + index] = 0u;","if (index == 0u) { state[stateOffset] = 1u; state[stateOffset + 1u] = 0u; }","const sourceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> source: array<f32>;","const editsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> edits: array<u32>;","  _ = &source;","  _ = &edits;","  let bits = bitcast<u32>(source[sourceOffset + index]); edits[editsOffset + index] = select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","const countedOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> counted: array<u32>;","  _ = &counted;","  counted[countedOffset] = 0u;","@group(0) @binding(0) var<storage, read_write> state: array<u32>;","const dispatchOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> dispatch: array<u32>;","  _ = &dispatch;","  if (state[stateOffset] != 0u) { dispatch[dispatchOffset + 0u] = 1u;","  dispatch[dispatchOffset + 1u] = 1u;","  dispatch[dispatchOffset + 2u] = 1u; } else { dispatch[dispatchOffset + 0u] = 0u; }","state[stateOffset] = 0u; state[stateOffset + 1u]++;","@group(0) @binding(3) var<storage, read_write> state: array<atomic<u32>>;","  let pitIndex = index / 9u; let localCell = index % 9u;","if (pit >= 9u) { return; }","let base = elevation[elevationOffset + pit];","if (!isFiniteValue(base) || !(base - 0.5 < base)) { return; }","let step = atomicLoad(&state[stateOffset + 1u]);","let origin = searchOrigin(pit); let cell = searchCell(localCell, origin);","let original = elevation[elevationOffset + cell];","let cut = max(original - (base - f32(step) * 0.5), 0.0);","if (!isFiniteValue(original) || cut > 4.0) { return; }","let workOffset = scratchOffset + pitIndex * 54u;","var predecessor = NO_CELL; var cost = infinity();","for (var direction = 0u; direction < 8u; direction++) {"," let neighbor = getFlowReceiver(cell, 1u << direction); if (neighbor == NO_CELL) { continue; }"," let localNeighbor = searchIndex(neighbor, origin); if (localNeighbor == NO_CELL) { continue; }"," let candidate = bitcast<f32>(scratch[workOffset + ((step - 1u) * 9u + localNeighbor) * 2u]) + cut;"," if (candidate < cost || (candidate == cost && neighbor < predecessor)) { cost = candidate; predecessor = neighbor; }","// Costs are nonnegative; clear the sign bit to canonicalize a possible negative zero.","scratch[workOffset + (step * 9u + localCell) * 2u] = bitcast<u32>(cost) & 0x7fffffffu;","scratch[workOffset + (step * 9u + localCell) * 2u + 1u] = predecessor;","if (isFiniteValue(cost)) { atomicOr(&state[stateOffset], 1u); }","@group(0) @binding(2) var<storage, read> scratch: array<u32>;","@group(0) @binding(3) var<storage, read_write> winners: array<atomic<u32>>;","let slot = index % 27u; let step = slot / 9u;","if (step == 0u) { return; }","let pit = pits[pitsOffset + pitIndex]; if (pit >= 9u) { return; }","let original = elevation[elevationOffset + searchCell(slot % 9u, searchOrigin(pit))];","let cost = scratch[scratchOffset + index * 2u];","if (!isFiniteValue(original) || original > base - f32(step) * 0.5 || cost >= 0x7f800000u) { return; }","atomicMin(&winners[winnersOffset + pitIndex * 2u], cost);","if (cost == atomicLoad(&winners[winnersOffset + pitIndex * 2u])) { atomicMin(&winners[winnersOffset + pitIndex * 2u + 1u], slot); }","@group(0) @binding(3) var<storage, read> winners: array<u32>;","@group(0) @binding(4) var<storage, read_write> paths: array<u32>;","@group(0) @binding(5) var<storage, read_write> lengths: array<u32>;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","  let pit = pits[pitsOffset + index]; if (pit >= 9u) { return; }","let slot = winners[winnersOffset + index * 2u + 1u];","if (slot == NO_CELL) { status[statusOffset + index] = 2u; return; }","let origin = searchOrigin(pit); let bestStep = slot / 9u;","var current = searchCell(slot % 9u, origin);","let pathOffset = pathsOffset + index * 3u;","let workOffset = scratchOffset + index * 54u;","// The only serial walk follows the selected path, bounded by maximumSteps and the node budget.","for (var step = bestStep; step > 0u; step--) {"," paths[pathOffset + step] = current;"," current = scratch[workOffset + (step * 9u + searchIndex(current, origin)) * 2u + 1u];","paths[pathOffset] = pit; lengths[lengthsOffset + index] = bestStep + 1u; status[statusOffset + index] = 1u;","@group(0) @binding(1) var<storage, read> paths: array<u32>;","@group(0) @binding(2) var<storage, read> lengths: array<u32>;","@group(0) @binding(3) var<storage, read_write> edits: array<atomic<u32>>;","  let pitIndex = index / 3u; let step = index % 3u;","if (step == 0u || step >= lengths[lengthsOffset + pitIndex]) { return; }","let start = paths[pathsOffset + pitIndex * 3u];","let cell = paths[pathsOffset + index];","let value = source[sourceOffset + start] - f32(step) * 0.5;","let bits = bitcast<u32>(value);","atomicMin(&edits[editsOffset + cell], select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u));","@group(0) @binding(1) var<storage, read> edits: array<u32>;","@group(0) @binding(2) var<storage, read_write> elevation: array<f32>;","const depthOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> depth: array<f32>;","const maskOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> mask: array<u32>;","  _ = &depth;","  _ = &mask;","  let original = source[sourceOffset + index]; var edited = original; var flags = 0u;","if (isFiniteValue(original)) {"," let key = edits[editsOffset + index];"," edited = bitcast<f32>(select(~key, key ^ 0x80000000u, (key & 0x80000000u) != 0u));"," if (edited < original) { flags |= 1u; }"," ","elevation[elevationOffset + index] = edited; depth[depthOffset + index] = original - edited; mask[maskOffset + index] = flags;","@group(0) @binding(1) var<storage, read> mask: array<u32>;","@group(0) @binding(2) var<storage, read> paths: array<u32>;","@group(0) @binding(3) var<storage, read> lengths: array<u32>;","@group(0) @binding(4) var<storage, read_write> status: array<u32>;","  if (status[statusOffset + index] != 1u) { return; }","let pathLength = lengths[lengthsOffset + index];","for (var step = 1u; step < pathLength; step++) {"," let previous = paths[pathsOffset + index * 3u + step - 1u];"," let current = paths[pathsOffset + index * 3u + step];"," let previousElevation = elevation[elevationOffset + previous];"," let currentElevation = elevation[elevationOffset + current];"," if (((mask[maskOffset + previous] | mask[maskOffset + current]) & 4u) != 0u || !isFiniteValue(previousElevation) || !isFiniteValue(currentElevation) || !(currentElevation < previousElevation)) { status[statusOffset + index] = 2u; }","const countValuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> countValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> counted: array<atomic<u32>>;","var<workgroup> workgroupCount: at