 pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn infinity() -> f32 { var bits = 0x7f800000u; return bitcast<f32>(bits); }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &elevation;","  _ = &basins;","  _ = &keys;","  _ = &cells;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let basin = basins[basinsOffset + index]; keys[keysOffset + index] = select(0xffffffffu, basin, basin < 2u && isFiniteValue(elevation[elevationOffset + index])); cells[cellsOffset + index] = index;","const rangesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> ranges: array<u32>;","  _ = &ranges;","  ranges[rangesOffset + index * 2u] = 0u; ranges[rangesOffset + index * 2u + 1u] = 0u;","const streamsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> streams: array<u32>;","const directionsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> directions: array<u32>;","const stateOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> state: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","// A direction word outside the contributor's encoding: nonzero and without a receiver.","const INVALID_DIRECTION_CODE: u32 = 0x100u;","fn getFlowDirectionCode(word: u32) -> u32 { return word; }","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  return u32(row) * GRID_WIDTH + u32(column);","fn getGroundEdgeLength(cell: u32, other: u32) -> f32 {"," let delta = vec2<f32>(f32(other % GRID_WIDTH) - f32(cell % GRID_WIDTH), f32(other / GRID_WIDTH) - f32(cell / GRID_WIDTH));"," return length(vec2<f32>(1.0 * delta.x + 0.0 * delta.y, 0.0 * delta.x + 1.0 * delta.y));","fn getGroundCellArea(cell: u32) -> f32 { return 1.0; }","fn edgeLength(cell: u32, receiver: u32) -> f32 { return getGroundEdgeLength(cell, receiver); }","fn isStreamWord(word: u32) -> bool { return word != 0u && word < UNRESOLVED_DIRECTION; }","fn getCellReceiver(cell: u32) -> u32 { return getFlowReceiver(cell, getFlowDirectionCode(directions[directionsOffset + cell])); }","// Length of the stream edge leaving 'cell', 0 when the cell or its receiver is not a stream cell.","fn getStreamEdgeLength(cell: u32) -> f32 {"," let receiver = getCellReceiver(cell);"," if (isStreamWord(streams[streamsOffset + cell]) && receiver != NO_CELL && isStreamWord(streams[streamsOffset + receiver]) && isFiniteValue(elevation[elevationOffset + receiver])) { return edgeLength(cell, receiver); }"," return 0.0;","  _ = &streams;","  _ = &directions;","  _ = &state;","  var parent = NO_CELL; var distance = 0.0; var steps = 0u; var result = 2u;","let code = getFlowDirectionCode(directions[directionsOffset + index]);","if (isFiniteValue(elevation[elevationOffset + index]) && isStreamWord(streams[streamsOffset + index])) {"," if (code == 0u) { result = 1u; } else {","  