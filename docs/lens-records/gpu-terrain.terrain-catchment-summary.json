  let basin = basins[basinsOffset + index]; keys[keysOffset + index] = select(0xffffffffu, basin, basin < 2u && finite(elevation[elevationOffset + index])); cells[cellsOffset + index] = index;","}","const rangesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> ranges: array<u32>;","  _ = &ranges;","  ranges[rangesOffset + index * 2u] = 0u; ranges[rangesOffset + index * 2u + 1u] = 0u;","const streamsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> streams: array<u32>;","const directionsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> directions: array<u32>;","const stateOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> state: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  return u32(row) * GRID_WIDTH + u32(column);","fn edgeLength(cell: u32, receiver: u32) -> f32 {"," let delta = vec2<f32>(f32(receiver % GRID_WIDTH) - f32(cell % GRID_WIDTH), f32(receiver / GRID_WIDTH) - f32(cell / GRID_WIDTH));"," return length(vec2<f32>(1.0 * delta.x + 0.0 * delta.y, 0.0 * delta.x + 1.0 * delta.y));","  _ = &streams;","  _ = &directions;","  _ = &state;","  var parent = NO_CELL; var distance = 0.0; var steps = 0u; var result = 2u;","let code = directions[directionsOffset + index];","if (finite(elevation[elevationOffset + index]) && streams[streamsOffset + index] == 1u) {"," if (code == 0u) { result = 1u; } else {","  let receiver = getFlowReceiver(index, code);","  if (receiver != NO_CELL && finite(elevation[elevationOffset + receiver]) && streams[streamsOffset + receiver] <= 1u) {","   if (streams[streamsOffset + receiver] == 0u) { result = 1u; }","   else { parent = receiver; distance = edgeLength(index, receiver); steps = 1u; }"," }","state[stateOffset + index * 4u] = parent; state[stateOffset + index * 4u + 1u] = bitcast<u32>(distance);","state[stateOffset + index * 4u + 2u] = steps; state[stateOffset + index * 4u + 3u] = result;","enable subgroups;","requires subgroup_id;","override LOGICAL_LENGTH: u32;","override KEYS_OFFSET: u32;","override VALUES_OFFSET: u32;","override OUTPUT_KEYS_OFFSET: u32;","override OUTPUT_VALUES_OFFSET: u32;","@group(0) @binding(0) var<storage, read> keys: array<u32>;","@group(0) @binding(1) var<storage, read> values: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputKeys: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","const INVALID_INDEX: u32 = 4294967295u;","const PADDED_LENGTH: u32 = 16u;","var<workgroup> indices: array<u32, 16>;","var<workgroup> cachedKeys: array<u32, 16>;","fn comes_before(leftIndex: u32, rightIndex: u32) -> bool {","  let leftValid = leftIndex != INVALID_INDEX && leftIndex < LOGICAL_LENGTH;","  let rightValid = rightIndex != INVALID_INDEX && rightIndex < LOGICAL_LENGTH;","  if (leftValid != rightValid) { return leftValid; }","  if (!leftValid) { return false; }","  let leftKey = cachedKeys[leftIndex];","  let rightKey = cachedKeys[rightIndex];","  if (leftKey == rightKey) { return leftIndex < rightIndex; }","  return leftKey < rightKey;","@compute @workgroup_size(16) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @