 % 32u)) & 1u;","fn hasFixedPointBitsBelow(value: vec3<u32>, count: u32) -> bool {","  let word = count / 32u;","  var found = (words[word] & ((1u << (count % 32u)) - 1u)) != 0u;","  if (word > 0u) { found = found || words[0] != 0u; }","  if (word > 1u) { found = found || words[1] != 0u; }","  return found;","fn quantizeFixedPoint(value: f32, unitExponent: i32) -> vec3<u32> {","  let bits = bitcast<u32>(value);","  let exponentBits = (bits >> 23u) & 0xffu;","  if (exponentBits == 0xffu) { return vec3<u32>(0u); }","  var significand = bits & 0x7fffffu;","  var exponent = -149;","  if (exponentBits != 0u) {","    significand = significand | 0x800000u;","    exponent = i32(exponentBits) - 150;","  // value = significand * 2^exponent; the term in units is significand * 2^shift.","  let shift = exponent - unitExponent;","  var magnitude = vec3<u32>(0u);","  if (shift >= 0) {","    // The scale bounds shift by 71 - h; the clamp only keeps a misused scale memory-safe.","    magnitude = shiftFixedPointLeft(significand, u32(min(shift, 71)));","  } else if (shift >= -24) {","    let right = u32(-shift);","    var quotient = significand >> right;","    let remainder = significand & ((1u << right) - 1u);","    let half = 1u << (right - 1u);","    if (remainder > half || (remainder == half && (quotient & 1u) != 0u)) {","      quotient = quotient + 1u;","    }","    magnitude = vec3<u32>(quotient, 0u, 0u);","  return select(magnitude, negateFixedPoint(magnitude), (bits >> 31u) != 0u);","fn getFixedPointFloat(value: vec3<u32>, unitExponent: i32) -> f32 {","  let negative = (value.z >> 31u) != 0u;","  let magnitude = select(value, negateFixedPoint(value), negative);","  var leading = 0u;","  if (magnitude.z != 0u) {","    leading = 64u + firstLeadingBit(magnitude.z);","  } else if (magnitude.y != 0u) {","    leading = 32u + firstLeadingBit(magnitude.y);","  } else if (magnitude.x != 0u) {","    leading = firstLeadingBit(magnitude.x);","  } else {","    return 0.0;","  var significa