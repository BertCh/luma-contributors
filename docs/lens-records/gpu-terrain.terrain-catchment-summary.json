AAIA/AAAAAAAAgEAAAAAAAAAAQAAAEEEAAIA/AACAPwAAAEEAAIA/AAAAAAAA4EAAAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-catchment-summary-compiled","resource":"profiles","meaning":"Downstream distance, elevation and outgoing gradient per stream cell","role":"output","components":3,"keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-catchment-summary-snapshots-profileStatus-0","name":"profileStatus","iteration":0,"elementType":"u32","values":"same:snapshots.2","provenance":"gpu-readback","graph":"gpu-terrain-terrain-catchment-summary-compiled","resource":"profileStatus","meaning":"Resolved versus truncated stream profiles","role":"intermediate","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const elevationOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> elevation: array<f32>;","const basinsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> basins: array<u32>;","const keysOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> keys: array<u32>;","const cellsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> cells: array<u32>;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn infinity() -> f32 { var bits = 0x7f800000u; return bitcast<f32>(bits); }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &elevation;","  _ = &basins;","  _ = &keys;","  _ = &cells;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let basin = basins[basinsOffset + index]; keys[keysOffset + index] = select(2u, basin, basin < 2u && isFiniteValue(elevation[elevationOffset + index])); cells[cellsOffset + index] = index;","const metadataOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> metadata: array<u32>;","const sumsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> sums: array<u32>;","const histogramOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> histogram: array<u32>;","  _ = &metadata;","  _ = &sums;","  _ = &histogram;","  if (index < 10u) { metadata[metadataOffset + index] = select(0u, 0xffffffffu, index % 5u == 0u); }","if (index < 18u) { sums[sumsOffset + index] = 0u; }","if (index < 12u) { histogram[histogramOffset + index] = 0u; }","const streamsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> streams: array<u32>;","const directionsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> directions: array<u32>;","const stateOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> state: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","// A direction word outside the contributor's encoding: nonzero and without a receiver.","const INVALID_DIRECTION_CODE: u32 = 0x100u;","fn getFlowDirectionCode(word: u32) -> u32 { return word; }","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  return u32(row) * GRID_WIDTH + u32(column);","fn getTerrainCoordinateDifference(first: u32, second: u32) -> f32 {"," return select(-f32(second - first), f32(first - second), first >= second);","fn getGroundEdgeLength(cell: u32, other: u32) -> f32 {"," let delta = vec2<f32>(getTerrainCoordinateDifference(other % GRID_WIDTH, cell % GRID_WIDTH), getTerrainCoordinateDifference(other / GRID_WIDTH, cell / GRID_WIDTH));"," return length(vec2<f32>(1.0 * delta.x + 0.0 * delta.y, 0.0 * delta.x + 1.0 * delta.y));","fn getGroundCellArea(cell: u32) -> f32 { return 1.0; }","fn edgeLength(cell: u32, receiver: u32) -> f32 { return getGroundEdgeLength(cell, receiver); }","fn isStreamWord(word: u32) -> bool { return word != 0u && word < UNRESOLVED_DIRECTION; }","fn getCellReceiver(cell: u32) -> u32 { return getFlowReceiver(cell, getFlowDirectionCode(directions[directionsOffset + cell])); }","// Length of the stream edge leaving 'cell', 0 when the cell or its receiver is not a stream cell.","fn getStreamEdgeLength(cell: u32) -> f32 {"," let receiver = getCellReceiver(cell);"," if (isStreamWord(streams[streamsOffset + cell]) && receiver != NO_CELL && isStreamWord(streams[streamsOffset + receiver]) && isFiniteValue(elevation[elevationOffset + receiver])) { return edgeLength(cell, receiver); }"," return 0.0;","  _ = &streams;","  _ = &directions;","  _ = &state;","  var parent = NO_CELL; var distance = 0.0; var steps = 0u; var result = 2u;","let code = getFlowDirectionCode(directions[directionsOffset + index]);","if (isFiniteValue(elevation[elevationOffset + index]) && isStreamWord(streams[streamsOffset + index])) {"," if (code == 0u) { result = 1u; } else {","  let receiver = getFlowReceiver(index, code);","  if (receiver != NO_CELL && isFiniteValue(elevation[elevationOffset + receiver]) && streams[streamsOffset + receiver] < UNRESOLVED_DIRECTION) {","   if (streams[streamsOffset + receiver] == 0u) { result = 1u; }","   else { parent = receiver; distance = edgeLength(index, receiver); steps = 1u; }"," }","state[stateOffset + index * 4u] = parent; state[stateOffset + index * 4u + 1u] = bitcast<u32>(distance);","state[stateOffset + index * 4u + 2u] = steps; state[stateOffset + index * 4u + 3u] = result;","const previousOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> previous: array<u32>;","const nextOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> next: array<u32>;","  _ = &previous;","  _ = &next;","  let offset = previousOffset + index * 4u; let destination = nextOffset + index * 4u;","for (var component = 0u; component < 4u; component++) { next[destination + component] = previous[offset + component]; }","let parent = previous[offset];","if (parent != 0xffffffffu) {"," let ancestor = previousOffset + parent * 4u;"," next[destination] = previous[ancestor];"," next[destination + 1u] = bitcast<u32>(bitcast<f32>(previous[offset + 1u]) + bitcast<f32>(previous[ancestor + 1u]));"," next[destination + 2u] = min(9u, previous[offset + 2u] + previous[ancestor + 2u]);"," next[destination + 3u] = previous[ancestor + 3u];","const sortedKeysOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> sortedKeys: array<u32>;","const segmentOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> segmentOffsets: array<u32>;","fn lowerBoundSortedKeys(first: u32, last: u32, key: u32) -> u32 {","  var low = first;","  var high = max(first, last);","  while (low < high) {","    let middle = low + (high - low) / 2u;","    let value = sortedKeys[sortedKeysOffset + middle];","    if (value < key) {","      low = middle + 1u;","    } else {","      high = middle;","    }","  return low;","fn upperBoundSortedKeys(first: u32, last: u32, key: u32) -> u32 {","    if (value <= key) {","  _ = &sortedKeys;","  _ = &segmentOffsets;","  segmentOffsets[segmentOffsetsOffset + index] = lowerBoundSortedKeys(0u, 9u, index);","const orderOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> order: array<u32>;","@group(0) @binding(5) var<storage, read_write> metadata: array<atomic<u32>>;","fn getFixedPointExponentBits(value: f32) -> u32 {","  let magnitudeBits = bitcast<u32>(value) & 0x7fffffffu;","  if (magnitudeBits == 0u || magnitudeBits >= 0x7f800000u) { return 0u; }","  return max(magnitudeBits >> 23u, 1u);","fn getFixedPointUnitExponent(maximumExponentBits: u32, headroomBits: u32) -> i32 {","  // A term with biased exponent E is below 2^(E - 126) = 2^(E - 127 + 1); 95 - h bits remain.","  return i32(max(maximumExponentBits, 1u)) - 127 + 1 + i32(headroomBits) - 95;","fn addFixedPoint(a: vec3<u32>, b: vec3<u32>) -> vec3<u32> {","  let low = a.x + b.x;","  let lowCarry = select(0u, 1u, low < a.x);","  let middlePartial = a.y + b.y;","  let middleCarry = select(0u, 1u, middlePartial < a.y);","  let middle = middlePartial + lowCarry;","  let middleRoundCarry = select(0u, 1u, middle < middlePartial);","  return vec3<u32>(low, middle, a.z + b.z + middleCarry + middleRoundCarry);","fn negateFixedPoint(value: vec3<u32>) -> vec3<u32> {","  return addFixedPoint(~value, vec3<u32>(1u, 0u, 0u));","fn shiftFixedPointLeft(value: u32, shift: u32) -> vec3<u32> {","  var words = array<u32, 4>(0u, 0u, 0u, 0u);","  let word = shift / 32u;","  let bit = shift % 32u;","  words[word] = value << bit;","  // (value >> 1) >> (31 - bit) is value >> (32 - bit) without a shift by 32 when bit is 0.","  words[word + 1u] = (value >> 1u) >> (31u - bit);","  return vec3<u32>(words[0], words[1], words[2]);","fn shiftFixedPointRight(value: vec3<u32>, shift: u32) -> u32 {","  var words = array<u32, 4>(value.x, value.y, value.z, 0u);","  return (words[word] >> bit) | ((words[word + 1u] << 1u) << (31u - bit));","fn getFixedPointBit(value: vec3<u32>, position: u32) -> u32 {","  var words = array<u32, 3>(value.x, value.y, value.z);","  return (words[position / 32u] >> (position % 32u)) & 1u;","fn hasFixedPointBitsBelow(value: vec3<u32>, count: u32) -> bool {","  let word = count / 32u;","  var found = (words[word] & ((1u << (count % 32u)) - 1u)) != 0u;","  if (word > 0u) { found = found || words[0] != 0u; }","  if (word > 1u) { found = found || words[1] != 0u; }","  return found;","fn quantizeFixedPoint(value: f32, unitExponent: i32) -> vec3<u32> {","  let bits = bitcast<u32>(value);","  let exponentBits = (bits >> 23u) & 0xffu;","  if (exponentBits == 0xffu) { return vec3<u32>(0u); }","  var significand = bits & 0x7fffffu;","  var exponent = -149;","  if (exponentBits != 0u) {","    significand = significand | 0x800000u;","    exponent = i32(exponentBits) - 150;","  // value = significand * 2^exponent; the term in units is significand * 2^shift.","  let shift = exponent - unitExponent;","  var magnitude = vec3<u32>(0u);","  if (shift >= 0) {","    // The scale bounds shift by 71 - h; the clamp only keeps a misused scale memory-safe.","    magnitude = shiftFixedPointLeft(significand, u32(min(shift, 71)));","  } else if (shift >= -24) {","    let right = u32(-shift);","    var quotient = significand >> right;","    let remainder = significand & ((1u << right) - 1u);","    let half = 1u << (right - 1u);","    if (remainder > half || (remainder == half && (quotient & 1u) != 0u)) {","      quotient = quotient + 1u;","    magnitude = vec3<u32>(quotient, 0u, 0u);","  return select(magnitude, negateFixedPoint(magnitude), (bits >> 31u) != 0u);","fn getFixedPointFloat(value: vec3<u32>, unitExponent: i32) -> f32 {","  let negative = (value.z >> 31u) != 0u;","  let magnitude = select(value, negateFixedPoint(value), negative);","  var leading = 0u;","  if (magnitude.z != 0u) {","    leading = 64u + firstLeadingBit(magnitude.z);","  } else if (magnitude.y != 0u) {","    leading = 32u + firstLeadingBit(magnitude.y);","  } else if (magnitude.x != 0u) {","    leading = firstLeadingBit(magnitude.x);","  } else {","    return 0.0;","  var significand = magnitude.x;","  var exponent = unitExponent;","  if (leading >= 24u) {","    let shift = leading - 23u;","    significand = shiftFixedPointRight(magnitude, shift);","    let roundBit = getFixedPointBit(magnitude, shift - 1u);","    if (roundBit != 0u && (hasFixedPointBitsBelow(magnitude, shift - 1u) || (significand & 1u) != 0u)) {","      significand = significand + 1u;","    exponent = unitExponent + i32(shift);","  // significand <= 2^24, so f32(significand) is exact and the value is significand * 2^exponent.","  var infinityBits = 0x7f800000u;","  var result = bitcast<f32>(infinityBits);","  if (exponent < 104 || (exponent == 104 && significand < 0x1000000u)) {","    // Two steps keep the ldexp exponent in range for normal results below 2^-103.","    let leadingExponent = i32(firstLeadingBit(significand));","    result = ldexp(ldexp(f32(significand), -leadingExponent), exponent + leadingExponent);","  return select(result, -result, negative);","fn getElevationKey(value: f32) -> u32 {"," let bits = bitcast<u32>(select(value, 0.0, value == 0.0));"," return select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);","fn getElevationFromKey(key: u32) -> f32 {"," return bitcast<f32>(select(~key, key ^ 0x80000000u, (key & 0x80000000u) != 0u));","fn publishMetadata(basin: u32, lower: u32, upper: u32, exponents: vec3<u32>) {"," if (basin >= 2u) { return; }"," let offset = metadataOffset + basin * 5u;"," atomicMin(&metadata[offset], lower); atomicMax(&metadata[offset + 1u], upper);"," atomicMax(&metadata[offset + 2u], exponents.x); atomicMax(&metadata[offset + 3u], exponents.y); atomicMax(&metadata[offset + 4u], exponents.z);","  _ = &order;","  var basin = 2u; var lower = 0xffffffffu; var upper = 0u; var exponents = vec3<u32>(0u);","for (var local = 0u; local < 256u; local++) {"," let entry = index * 256u + local; if (entry >= 9u) { break; }"," let cell = order[orderOffset + entry]; let nextBasin = basins[basinsOffset + cell]; let value = elevation[elevationOffset + cell];"," if (nextBasin >= 2u || !isFiniteValue(value)) { break; }"," if (nextBasin != basin) { publishMetadata(basin, lower, upper, exponents); basin = nextBasin; lower = 0xffffffffu; upper = 0u; exponents = vec3<u32>(0u); }"," let key = getElevationKey(value); lower = min(lower, key); upper = max(upper, key);"," exponents = max(exponents, vec3<u32>(getFixedPointExponentBits(value), 0u, getFixedPointExponentBits(getStreamEdgeLength(cell))));","publishMetadata(basin, lower, upper, exponents);","@group(0) @binding(5) var<storage, read> metadata: array<u32>;","@group(0) @binding(6) var<storage, read_write> sums: array<atomic<u32>>;","@group(0) @binding(7) var<storage, read_write> histogram: array<atomic<u32>>;","fn addFixedPointToSums(cell: u32, value: vec3<u32>) {","  let base = sumsOffset + cell * 3u;","  var lowCarry = 0u;","  if (value.x != 0u) {","    let oldLow = atomicAdd(&sums[base], value.x);","    lowCarry = select(0u, 1u, oldLow + value.x < oldLow);","  let middleAddend = value.y + lowCarry;","  var middleCarry = select(0u, 1u, middleAddend < value.y);","  if (middleAddend != 0u) {","    let oldMiddle = atomicAdd(&sums[base + 1u], middleAddend);","    middleCarry = middleCarry + select(0u, 1u, oldMiddle + middleAddend < oldMiddle);","  let highAddend = value.z + middleCarry;","  if (highAddend != 0u) {","    atomicAdd(&sums[base + 2u], highAddend);","fn addFixedPointToHistogram(cell: u32, value: vec3<u32>) {","  let base = histogramOffset + cell * 3u;","    let oldLow = atomicAdd(&histogram[base], value.x);","    let oldMiddle = atomicAdd(&histogram[base + 1u], middleAddend);","    atomicAdd(&histogram[base + 2u], highAddend);","fn publishSums(basin: u32, lane: u32, elevationSum: vec3<u32>, areaSum: vec3<u32>, lengthSum: vec3<u32>, belowCount: u32) {"," if (lane == 0u) { addFixedPointToSums(basin * 3u, elevationSum); addFixedPointToSums(basin * 3u + 1u, areaSum); addFixedPointToSums(basin * 3u + 2u, lengthSum); }"," else { atomicAdd(&histogram[histogramOffset + (basin * 2u + lane - 1u) * 3u], belowCount); }","  let tile = index / 3u; let lane = index % 3u;","var basin = 2u; var elevationSum = vec3<u32>(0u); var areaSum = vec3<u32>(0u); var lengthSum = vec3<u32>(0u); var belowCount = 0u;"," let entry = tile * 256u + local; if (entry >= 9u) { break; }"," if (nextBasin != basin) { publishSums(basin, lane, elevationSum, areaSum, lengthSum, belowCount); basin = nextBasin; elevationSum = vec3<u32>(0u); areaSum = vec3<u32>(0u); lengthSum = vec3<u32>(0u); belowCount = 0u; }"," let areaUnit = getFixedPointUnitExponent(metadata[offset + 3u], 4u);"," if (lane == 0u) {","  elevationSum = addFixedPoint(elevationSum, quantizeFixedPoint(value, getFixedPointUnitExponent(metadata[offset + 2u], 4u)));","  ","  lengthSum = addFixedPoint(lengthSum, quantizeFixedPoint(getStreamEdgeLength(cell), getFixedPointUnitExponent(metadata[offset + 4u], 4u)));"," } else {","  let lower = getElevationFromKey(metadata[offset]); let upper = getElevationFromKey(metadata[offset + 1u]);","  let threshold = lower + (upper - lower) * f32(lane) / 2.0;","  if (value <= threshold || lane == 2u) { belowCount++; }","publishSums(basin, lane, elevationSum, areaSum, lengthSum, belowCount);","@group(0) @binding(0) var<storage, read> metadata: array<u32>;","@group(0) @binding(1) var<storage, read> sums: array<u32>;","const rangesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> ranges: array<u32>;","const statisticsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> statistics: array<f32>;","fn loadSum(slot: u32, exponent: u32) -> f32 {"," let offset = sumsOffset + slot * 3u;"," return getFixedPointFloat(vec3<u32>(sums[offset], sums[offset + 1u], sums[offset + 2u]), getFixedPointUnitExponent(exponent, 4u));","  _ = &ranges;","  _ = &statistics;","  let sampleCount = ranges[rangesOffset + index + 1u] - ranges[rangesOffset + index];","let offset = metadataOffset + index * 5u;","let sum = loadSum(index * 3u, metadata[offset + 2u]);","let streamLength = loadSum(index * 3u + 2u, metadata[offset + 4u]);","let area = f32(sampleCount) * 1.0;","let destination = statisticsOffset + index * 6u;","statistics[destination] = area; statistics[destination + 1u] = select(getNaN(), sum / f32(max(sampleCount, 1u)), sampleCount > 0u);","statistics[destination + 2u] = select(getNaN(), getElevationFromKey(metadata[offset]), sampleCount > 0u);","statistics[destination + 3u] = select(getNaN(), getElevationFromKey(metadata[offset + 1u]), sampleCount > 0u);","statistics[destination + 4u] = streamLength; statistics[destination + 5u] = select(getNaN(), streamLength / max(area, 1e-30), area > 0.0);","@group(0) @binding(1) var<storage, read> histogram: array<u32>;","const hypsometryOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> hypsometry: array<f32>;","  _ = &hypsometry;","  let offset = histogramOffset + index * 3u;","hypsometry[hypsometryOffset + index] = f32(histogram[offset]) * 1.0;","@group(0) @binding(4) var<storage, read> state: array<u32>;","const profilesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> profiles: array<f32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","  _ = &profiles;","  _ = &status;","  let center = elevation[elevationOffset + index]; let offset = stateOffset + index * 4u;","let distance = bitcast<f32>(state[offset + 1u]); var gradient = 0.0;","var result = select(2u, 1u, state[offset] == NO_CELL && state[offset + 3u] == 1u && state[offset + 2u] < 9u && isFiniteValue(distance));","if (!isFiniteValue(center) || basins[basinsOffset + index] >= 2u || !isStreamWord(streams[streamsOffset + index])) { result = select(0u, 2u, streams[streamsOffset + index] >= UNRESOLVED_DIRECTION); }","let receiver = getCellReceiver(index);","if (receiver != NO_CELL && isStreamWord(streams[streamsOffset + receiver])) { gradient = (center - elevation[elevationOffset + receiver]) / edgeLength(index, receiver); }","status[statusOffset + index] = result;","profiles[profilesOffset + index * 3u] = select(getNaN(), distance, result == 1u);","profiles[profilesOffset + index * 3u + 1u] = center;","profiles[profilesOffset + index * 3u + 2u] = select(getNaN(), gradient, result == 1u);"],"strings":["read","GPUTerrainCatchmentSummary","terrain-catchment-summary-profiles-0","buffer","logical","read_write","elevation","terrain-catchment-summary-basin-metadata","terrain-catchment-summary-profiles-1","compute","gpu-terrain-terrain-catchment-summary-snapshot-tap","streams","terrain-catchment-summary-ranges","basinIds","terrain-catchment-summary-basin-sort-bitonic-local","terrain-catchment-summary-basin-sums","terrain-catchment-summary-histogram-sums","flowDirections","transient","terrain-catchment-summary-statistics","terrain-catchment-summary-sum-tiles","imported","terrain-catchment-summary-basin-keys","terrain-catchment-summary-hypsometry","terrain-catchment-summary-order","terrain-catchment-summary-profile-jump-1","terrain-catchment-summary-profiles","terrain-catchment-summary-reduction-clear","hypsometry","profiles","statistics","terrain-catchment-summary-metadata-tiles","terrain-catchment-summary-profile-jump-0","terrain-catchment-summary-profile-jump-2","terrain-catchment-summary-profile-jump-3","terrain-catchment-summary-profile-seeds","profileStatus","terrain-catchment-summary-cells","terrain-catchment-summary-keys","basins","metadata","terrain-catchment-summary-sorted-keys","directions","next","previous","wgsl:37e56a04","atomic<u32>","histogram","sums","order","state"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","