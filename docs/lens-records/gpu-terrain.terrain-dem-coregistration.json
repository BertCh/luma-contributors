AAAABAAAAAQAAAAEAAAABAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-dem-coregistration-compiled","resource":"validity","afterNode":"terrain-dem-coregistration-volume","role":"intermediate","meaning":"Valid uncertainty-aware DEM differences","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-dem-coregistration-snapshots-volume-0","name":"volume","iteration":0,"elementType":"f32","values":"b64:AADKQmmKz0AAABBB","provenance":"gpu-readback","graph":"gpu-terrain-terrain-dem-coregistration-compiled","resource":"volume","afterNode":"terrain-dem-coregistration-volume","role":"output","meaning":"Integrated elevation change, standard deviation and valid area"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const varianceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> variance: array<f32>;","const deviationsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> deviations: array<f32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &variance;","  _ = &deviations;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  deviations[deviationsOffset + index] = sqrt(variance[varianceOffset + index]);","}","const referenceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> reference: array<f32>;","const movingOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> moving: array<f32>;","const stableOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> stable: array<u32>;","const keysOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> keys: array<u32>;","const cellsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> cells: array<u32>;","fn finite(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn missing() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","fn infinity() -> f32 { var bits = 0x7f800000u; return bitcast<f32>(bits); }","fn residual(cell: u32) -> f32 { return moving[movingOffset + cell] - reference[referenceOffset + cell]; }","fn usable(cell: u32) -> bool { return stable[stableOffset + cell] != 0u && finite(residual(cell)); }","fn correlation(first: u32, second: u32) -> f32 {"," let delta = vec2<f32>(f32(first % 3u) - f32(second % 3u), f32(first / 3u) - f32(second / 3u));"," return exp(-length(vec2<f32>(1.0 * delta.x + 0.0 * delta.y, 0.0 * delta.x + 1.0 * delta.y)) / 2.0);","  _ = &reference;","  _ = &moving;","  _ = &stable;","  _ = &keys;","  _ = &cells;","  let value = residual(index);","let bits = bitcast<u32>(select(value, 0.0, value == 0.0));","keys[keysOffset + index] = select(0xffffffffu, select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u), usable(index));","cells[cellsOffset + index] = index;","@group(0) @binding(3) var<storage, read> variance: array<f32>;","@group(0) @binding(4) var<storage, read> deviations: array<f32>;","const covarianceOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> covariance: array<f32>;","  _ = &covariance;","  var stableCovariance = 0.0; var measurementCovariance = 0.0;","let firstVariance = variance[varianceOffset + index];","let valid = finite(residual(index)) && finite(firstVariance) && firstVariance >= 0.0;","for (var second = 0u; second < 9u; second++) {"," let secondVariance = variance[varianceOffset + second];"," let weight = correlation(index, second);"," if (usable(index) && usable(second)) { stableCovariance += weight; }"," if (valid && finite(residual(second)) && finite(secondVariance) && secondVariance >= 0.0) { measurementCovariance += deviations[deviationsOffset + index] * deviations[deviationsOffset + second] * weight; }","covariance[covarianceOffset + index * 2u] = stableCovariance;","covariance[covarianceOffset + index * 2u + 1u] = measurementCovariance;","enable subgroups;","requires subgroup_id;","override LOGICAL_LENGTH: u32;","override KEYS_OFFSET: u32;","override VALUES_OFFSET: u32;","override OUTPUT_KEYS_OFFSET: u32;","override OUTPUT_VALUES_OFFSET: u32;","@group(0) @binding(0) var<storage, read> keys: array<u32>;","@group(0) @binding(1) var<storage, read> values: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputKeys: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","const INVALID_INDEX: u32 = 4294967295u;","const PADDED_LENGTH: u32 = 16u;","var<workgroup> indices: array<u32, 16>;","var<workgroup> cachedKeys: array<u32, 16>;","fn comes_before(leftIndex: u32, rightIndex: u32) -> bool {","  let leftValid = leftIndex != INVALID_INDEX && leftIndex < LOGICAL_LENGTH;","  let rightValid = rightIndex != INVALID_INDEX && rightIndex < LOGICAL_LENGTH;","  if (leftValid != rightValid) { return leftValid; }","  if (!leftValid) { return false; }","  let leftKey = cachedKeys[leftIndex];","  let rightKey = cachedKeys[rightIndex];","  if (leftKey == rightKey) { return leftIndex < rightIndex; }","  return leftKey < rightKey;","@compute @workgroup_size(16) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  var currentIndex = select(INVALID_INDEX, lane, lane < LOGICAL_LENGTH);","  if (lane < LOGICAL_LENGTH) {","    cachedKeys[lane] = keys[KEYS_OFFSET + lane];","  } else {","    cachedKeys[lane] = 0u;","  workgroupBarrier();","  for (var blockWidth = 2u; blockWidth <= PADDED_LENGTH; blockWidth <<= 1u) {","    for (var compareStride = blockWidth >> 1u; compareStride > 0u; compareStride >>= 1u) {","      var partnerIndex = INVALID_INDEX;","      if (compareStride < subgroupSize) {","        partnerIndex = subgroupShuffleXor(currentIndex, compareStride);","      } else {","        indices[lane] = currentIndex;","        workgroupBarrier();","        partnerIndex = indices[lane ^ compareStride];","      }","      let lowerLane = (lane & compareStride) == 0u;","      let leftIndex = select(partnerIndex, currentIndex, lowerLane);","      let rightIndex = select(currentIndex, partnerIndex, lowerLane);","      let ascending = (lane & blockWidth) == 0u;","      let shouldSwap = select(","        comes_before(leftIndex, rightIndex),","        comes_before(rightIndex, leftIndex),","        ascending","      );","      let sortedLeft = select(leftIndex, rightIndex, shouldSwap);","      let sortedRight = select(rightIndex, leftIndex, shouldSwap);","      currentIndex = select(sortedRight, sortedLeft, lowerLane);","      if (compareStride >= subgroupSize) {","    }","    outputKeys[OUTPUT_KEYS_OFFSET + lane] = cachedKeys[currentIndex];","    outputValues[OUTPUT_VALUES_OFFSET + lane] = values[VALUES_OFFSET + currentIndex];","const orderOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> order: array<u32>;","const covarianceRowsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> covarianceRows: array<f32>;","const fitOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> fit: array<f32>;","  _ = &order;","  _ = &covarianceRows;","  _ = &fit;","  var sampleCount = 0u; var covariance = 0.0;","for (var cell = 0u; cell < 9u; cell++) { sampleCount += u32(usable(cell)); covariance += covarianceRows[covarianceRowsOffset + cell * 2u]; }","let samples = f32(sampleCount);","var median = missing();","if (sampleCount > 0u) {"," let lower = order[orderOffset + (sampleCount - 1u) / 2u]; let upper = order[orderOff