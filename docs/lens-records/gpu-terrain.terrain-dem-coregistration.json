ze":1,"unit":"m"}},{"id":"gpu-terrain-terrain-dem-coregistration-snapshots-fit-0","name":"fit","iteration":0,"elementType":"f32","values":"b64:AAAAQAAAAAAAAIBAAAAAAA==","provenance":"gpu-readback","graph":"gpu-terrain-terrain-dem-coregistration-compiled","resource":"fit","meaning":"Median shift, residual NMAD, stable count and bias standard error","role":"output"},{"id":"gpu-terrain-terrain-dem-coregistration-snapshots-differences-0","name":"differences","iteration":0,"elementType":"f32","values":"b64:AAAAAAAAgD8AAAAAAACAPwAAAAAAAIA/AADEQgAAgD8AAEBAAACAPwAAAAAAAIA/AAAAAAAAgD8AAAAAAACAPwAAAAAAAIA/","provenance":"gpu-readback","graph":"gpu-terrain-terrain-dem-coregistration-compiled","resource":"differences","meaning":"Corrected difference and modeled standard deviation per cell","role":"output","components":2,"keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-dem-coregistration-snapshots-validity-0","name":"validity","iteration":0,"elementType":"u32","values":"b64:AQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAAEAAAABAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-dem-coregistration-compiled","resource":"validity","meaning":"Valid uncertainty-aware DEM differences","role":"intermediate","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-dem-coregistration-snapshots-volume-0","name":"volume","iteration":0,"elementType":"f32","values":"b64:AADKQmmKz0AAABBB","provenance":"gpu-readback","graph":"gpu-terrain-terrain-dem-coregistration-compiled","resource":"volume","meaning":"Integrated elevation change, standard deviation and valid area","role":"output"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const varianceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> variance: array<f32>;","const deviationsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> deviations: array<f32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &variance;","  _ = &deviations;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  deviations[deviationsOffset + index] = sqrt(variance[varianceOffset + index]);","}","const referenceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> reference: array<f32>;","const movingOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> moving: array<f32>;","const stableOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> stable: array<u32>;","const usableFlagsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> usableFlags: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","// A direction word outside the contributor's encoding: nonzero and without a receiver.","const INVALID_DIRECTION_CODE: u32 = 0x100u;","fn getFlowDirectionCode(word: u32) -> u32 { return word; }","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  return u32(row) * GRID_WIDTH + u32(column);","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","fn infinity() -> f32 { var bits = 0x7f800000u; return bitcast<f32>(bits); }","fn getGroundEdgeLength(cell: u32, other: u32) -> f32 {"," let delta = vec2<f32>(f32(other % GRID_WIDTH) - f32(cell % GRID_WIDTH), f32(other / GRID_WIDTH) - f32(cell / GRID_WIDTH));"," return length(vec2<f32>(1.0 * delta.x + 0.0 * delta.y, 0.0 * delta.x + 1.0 * delta.y));","fn getGroundCellArea(cell: u32) -> f32 { return 1.0; }","fn residual(cell: u32) -> f32 { return moving[movingOffset + cell] - reference[referenceOffset + cell]; }","fn usable(cell: u32) -> bool { return stable[stableOffset + cell] != 0u && isFiniteValue(residual(cell)); }","fn correlation(first: u32, second: u32) -> f32 {"," return exp(-getGroundEdgeLength(first, second) / 2.0);","  _ = &reference;","  _ = &moving;","  _ = &stable;","  _ = &usableFlags;","  usableFlags[usableFlagsOffset + index] = u32(usable(index));","const keysOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> keys: array<u32>;","const cellsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> cells: array<u32>;","  _ = &keys;","  _ = &cells;","  let value = residual(index);","let bits = bitcast<u32>(select(value, 0.0, value == 0.0));","keys[keysOffset + index] = select(0xffffffffu, select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u), usable(index));","cells[cellsOffset + index] = index;","@group(0) @binding(3) var<storage, read> variance: array<f32>;","@group(0) @binding(4) var<storage, read> deviations: array<f32>;","const stableRowsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> stableRows: array<f32>;","const measurementRowsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> measurementRows: array<f32>;","  _ = &stableRows;","  _ = &measurementRows;","  var stableCovariance = 0.0; var measurementCovariance = 0.0;","let firstVariance = variance[varianceOffset + index];","let valid = isFiniteValue(residual(index)) && isFiniteValue(firstVariance) && firstVariance >= 0.0;","for (var second = 0u; second < 9u; second++) {"," let secondVariance = variance[varianceOffset + second];"," let weight = correlation(index, second);"," if (usable(index) && usable(second)) { stableCovariance += weight; }"," if (valid && isFiniteValue(residual(second)) && isFiniteValue(secondVariance) && secondVariance >= 0.0) { measurementCovariance += deviations[deviationsOffset + index] * deviations[deviationsOffset + second] * weight; }","stableRows[stableRowsOffset + index] = stableCovariance;","measurementRows[measurementRowsOffset + index] = measurementCovariance;","const orderOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> order: array<u32>;","const usableCountOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> usableCount: array<u32>;","const stableTotalOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read> stableTotal: array<f32>;","const fitOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> fit: array<f32>;","  _ = &order;","  _ = &usableCount;","  _ = &stableTotal;","  _ = &fit;","  let sampleCount = usableCount[usableCountOffset]; let covariance = stableTotal[stableTotalOffset];","let samples = f32(sampleCount);","var median = getNaN();","if (sampleCount > 0u) {"," let lower = order[orderOffset + (sampleCount - 1u) / 2u]; let upper = order[orderOffset + sampleCount / 2u];"," median = (residual(lower) + residual(upper)) * 0.5;","fit[fitOffset] = median; fit[fitOffset + 1u] = getNaN(); fit[fitOffset + 2u] = samples; fit[fitOffset + 3u] = getNaN();","@group(0) @binding(3) var<storage, read> fit: array<f32>;","@group(0) @binding(4) var<storage, read_write> keys: array<u32>;","@group(0) @binding(5) var<storage, read_write> cells: array<u32>;","  let value = abs(residual(index) - fit[fitOffset]);"," median = (abs(residual(lower) - fit[fitOffset]) + abs(residual(upper) - fit[fitOffset])) * 0.5;","let deviation = median * 1.4826022;","fit[fitOffset + 1u] = deviation;","fit[fitOffset + 3u] = select(getNaN(), 1.2533141 * deviation * sqrt(covariance) / max(samples, 1.0), samples >= 2.0);","@group(0) @binding(4) var<storage, read> fit: array<f32>;","const differencesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> differences: array<f32>;","const validityOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> validity: array<u32>;","  _ = &differences;","  _ = &validity;","  let difference = residual(index) - fit[fitOffset];","let cellVariance = variance[varianceOffset + index];","let biasError = fit[fitOffset + 3u];","let valid = isFiniteValue(difference) && isFiniteValue(cellVariance) && cellVariance >= 0.0 && isFiniteValue(biasError);","validity[validityOffset + index] = u32(valid);","differences[differencesOffset + index * 2u] = select(getNaN(), difference, valid);","differences[differencesOffset + index * 2u + 1u] = select(getNaN(), sqrt(max(cellVariance, 0.0) + biasError * biasError), valid);","@group(0) @binding(0) var<storage, read> differences: array<f32>;","@group(0) @binding(1) var<storage, read> validity: array<u32>;","const changeValuesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> changeValues: array<f32>;","const areaValuesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> areaValues: array<f32>;","  _ = &changeValues;","  _ = &areaValues;","  let valid = validity[validityOffset + index] != 0u;","let cellArea = 1.0;","changeValues[changeValuesOffset + index] = select(0.0, differences[differencesOffset + index * 2u] * cellArea, valid);","areaValues[areaValuesOffset + index] = select(0.0, cellArea, valid);","@group(0) @binding(0) var<storage, read> fit: array<f32>;","const validCountOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> validCount: array<u32>;","const changeTotalOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> changeTotal: array<f32>;","const measurementTotalOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> measurementTotal: array<f32>;","const volumeOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> volume: array<f32>;","  _ = &validCount;","  _ = &changeTotal;","  _ = &measurementTotal;","  _ = &volume;","  let samples = validCount[validCountOffset];","let covariance = measurementTotal[measurementTotalOffset];","let validArea = f32(samples) * 1.0; let change = changeTotal[changeTotalOffset] * 1.0;","let deviation = sqrt(covariance + f32(samples) * f32(samples) * biasError * biasError) * 1.0;","volume[volumeOffset] = select(getNaN(), change, samples > 0u);","volume[volumeOffset + 1u] = select(getNaN(), deviation, samples > 0u);","volume[volumeOffset + 2u] = validArea;"],"strings":["read","buffer","moving","reference","compute","GPUTerrainDEMCoregistration","stableMask","read_write","validity","gpu-terrain-terrain-dem-coregistration-snapshot-tap","imported","transient","terrain-dem-coregistration-cells","terrain-dem-coregistration-deviation-median","terrain-dem-coregistration-keys","terrain-dem-coregistration-usable","terrain-dem-coregistration-standard-deviations","differences","terrain-dem-coregistration-apply","terrain-dem-coregistration-bias-sort-bitonic-local","terrain-dem-coregistration-deviation-sort-bitonic-local","terrain-dem-coregistration-sorted-cells","terrain-dem-coregistration-volume","terrain-dem-coregistration-deviation-rank","terrain-dem-coregistration-bias-median","differenceVariance","terrain-dem-coregistration-bias-rank","terrain-dem-coregistration-covar