CATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let value = elevation[elevationOffset + index];","let bits = bitcast<u32>(select(value, 0.0, value == 0.0));","keys[keysOffset + index] = select(0xffffffffu, select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u), isFiniteValue(value));","cells[cellsOffset + index] = index;","const outletsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> outlets: array<u32>;","const labelsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> labels: array<u32>;","const treeOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> tree: array<u32>;","const levelsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> levels: array<f32>;","const ownershipOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> ownership: array<u32>;","const statusOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> status: array<u32>;","const orderOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read> order: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","// A direction word outside the contributor's encoding: nonzero and without a receiver.","const INVALID_DIRECTION_CODE: u32 = 0x100u;","fn getFlowDirectionCode(word: u32) -> u32 { return word; }","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  return u32(row) * GRID_WIDTH + u32(column);","  _ = &outlets;","  _ = &labels;","  _ = &tree;","  _ = &levels;","  _ = &ownership;","  _ = &status;","  _ = &order;","  for (var cell = 0u; cell < 9u; cell++) { labels[labelsOffset + cell] = NO_CELL; ownership[ownershipOffset + cell] = NO_CELL; }","var nodeCount = 0u;","for (var iteration = 0u; iteration < 9u; iteration++) {"," let selected = order[orderOffset + iteration];"," let selectedHeight = elevation[elevationOffset + selected];"," if (!isFiniteValue(selectedHeight)) { break; }"," var neighbors: array<u32, 8>; var neighborCount = 0u;"," for (var direction = 0u; direction < 8u; direction++) {","  let cell = getFlowReceiver(selected, 1u << direction); if (cell == NO_CELL) { continue; }","  var label = labels[labelsOffset + cell]; if (label == NO_CELL) { continue; }","  // Disjoint-set links can be compressed independently of historical hierarchy parents.","  var root = label;","  while (labels[labelsOffset + 9u + root] != root) { root = labels[labelsOffset + 9u + root]; }","  while (label != root) { let next = labels[labelsOffset + 9u + label]; labels[labelsOffset + 9u + label] = root; label = next; }","  labels[labelsOffset + cell] = root; label = root;","  var found = false; for (var entry = 0u; entry < neighborCount; entry++) { found = found || neighbors[entry] == label; }","  if (!found) { neighbors[neighborCount] = label; neighborCount++; }"," }"," var destination = NO_CELL;"," if (neighborCount == 1u) { destination = neighbors[0]; } else {","  destination = nodeCount; nodeCount++; labels[labelsOffset + 9u + destination] = destination;","  tree[treeOffset + destination * 4u] = NO_CELL;","  tree[treeOffset + destination * 4u + 1u] = selected;","  tree[treeOffset + destination * 4u + 2u] = NO_CELL;","  tree[treeOffset + destination * 4u + 3u] = 1u;","  levels[levelsOffset + destination * 2u] = selectedHeight;","  levels[levelsOffset + destination * 2u + 1u] = infinity();","  for (var entry = 0u; entry < neighborCount; entry++) {","   let child = neighbors[entry]; labels[labelsOffset + 9u + child] = destination;","   tree[treeOffset + child * 4u] = destination; levels[levelsOffset + child * 2u + 1u] = selectedHeight;","   let childPit = tree[treeOffset + child * 4u + 1u]; let currentPit = tree[treeOffset + destination * 4u + 1u];","   if (elevation[elevationOffset + childPit] < elevation[elevationOffset + currentPit] || (elevation[elevationOffset + childPit] == elevation[elevationOffset + currentPit] && childPit < currentPit)) { tree[treeOffset + destination * 4u + 1u] = childPit; }","   tree[treeOffset + destination * 4u + 2u] = min(tree[treeOffset + destination * 4u + 2u], tree[treeOffset + child * 4u + 2u]);"," labels[labelsOffset + selected] = destination; ownership[ownershipOffset + selected] = destination;"," if (outlets[outletsOffset + selected] != 0u) { tree[treeOffset + destination * 4u + 2u] = min(tree[treeOffset + destination * 4u + 2u], selected); }","status[statusOffset] = min(nodeCount, 3u); status[statusOffset + 1u] = nodeCount; status[statusOffset + 2u] = u32(nodeCount > 3u);","@group(0) @binding(0) var<storage, read> tree: array<u32>;","const sourceLevelsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> sourceLevels: array<f32>;","@group(0) @binding(2) var<storage, read> status: array<u32>;","const nodesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> nodes: array<u32>;","  _ = &sourceLevels;","  _ = &nodes;","  let valid = status[statusOffset + 2u] == 0u && index < status[statusOffset];","for (var component = 0u; component < 4u; component++) { nodes[nodesOffset + index * 4u + component] = 0xffffffffu; }","levels[levelsOffset + index * 2u] = getNaN(); levels[levelsOffset + index * 2u + 1u] = getNaN();","nodes[nodesOffset + index * 4u + 3u] = 0u;","if (valid) {"," for (var component = 0u; component < 4u; component++) { nodes[nodesOffset + index * 4u + component] = tree[treeOffset + index * 4u + component]; }"," levels[levelsOffset + index * 2u] = sourceLevels[sourceLevelsOffset + index * 2u]; levels[levelsOffset + index * 2u + 1u] = sourceLevels[sourceLevelsOffset + index * 2u + 1u];","@group(0) @binding(1) var<storage, read> ownership: array<u32>;","@group(0) @binding(2) var<storage, read> nodes: array<u32>;","const stagesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> stages: array<f32>;","@group(0) @binding(4) var<storage, read> status: array<u32>;","const curvesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> curves: array<u32>;","const sumsMiddleOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> sumsMiddle: array<u32>;","const sumsHighOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> sumsHigh: array<u32>;","// Areas and volumes are fixed-point sums (fixed-point-accumulator.ts): integer additions in a","// unit set by the largest term of the stage, so no float32 partial sum rounds per cell and the","// compiler has no float identity to fold. A compensated float sum kept its correction in one","// float32 word, which itself rounds once a node holds a few hundred thousand cells.","// 'curves' is the float32 output bound as u32: it holds the low word of each sum until the value","// is decoded, then the bits of the float32 result.","fn getFixedPointExponentBits(value: f32) -> u32 {","  let magnitudeBits = bitcast<u32>(value) & 0x7fffffffu;","  if (magnitudeBits == 0u || magnitudeBits >= 0x7f800000u) { return 0u; }","  return max(magnitudeBits >> 23u, 1u);","fn getFixedPointUnitExponent(maximumExponentBits: u32, headroomBits: u32) -> i32 {","  // A term with biased exponent E is below 2^(E - 126) = 2^(E - 127 + 1); 95 - h bits remain.","  return i32(max(maximumExponentBits, 1u)) - 127 + 1 + i32(headroomBits) - 95;","fn addFixedPoint(a: vec3<u32>, b: vec3<u32>) -> vec3<u32> {","  let low = a.x + b.x;","  let lowCarry = select(0u, 1u, low < a.x);","  let middlePartial = a.y + b.y;","  let middleCarry = select(0u, 1u, middlePartial < a.y);","  let middle = middlePartial + lowCarry;","  let middleRoundCarry = select(0u, 1u, middle < middlePartial);","  return vec3<u32>(low, middle, a.z + b.z + middleCarry + middleRoundCarry);","fn negateFixedPoint(value: vec3<u32>) -> vec3<u32> {","  return addFixedPoint(~value, vec3<u32>(1u, 0u, 0u));","fn shiftFixedPointLeft(value: u32, shift: u32) -> vec3<u32> {","  var words = array<u32, 4>(0u, 0u, 0u, 0u);","  let word = shift / 32u;","  let bit = shift % 32u;","  words[word] = value << bit;","  // (value >> 1) >> (31 - bit) is value >> (32 - bit) without a shift by 32 when bit is 0.","  words[word + 1u] = (value >> 1u) >> (31u - bit);","  return vec3<u32>(words[0], words[1], words[2]);","fn shiftFixedPointRight(value: vec3<u32>, shift: u32) -> u32 {","  var words = array<u32, 4>(value.x, value.y, value.z, 0u);","  return (words[word] >> bit) | ((words[word + 1u] << 1u) << (31u - bit));","fn getFixedPointBit(value: vec3<u32>, position: u32) -> u32 {","  var words = array<u32, 3>(value.x, value.y, value.z);","  return (words[position / 32u] >> (position % 32u)) & 1u;","fn hasFixedPointBitsBelow(value: vec3<u32>, count: u32) -> bool {","  let word = count / 32u;","  var found = (words[word] & ((1u << (count % 32u)) - 1u)) != 0u;","  if (word > 0u) { found = found || words[0] != 0u; }","  if (word > 1u) { found = found || words[1] != 0u; }","  return found;","fn quantizeFixedPoint(value: f32, unitExponent: i32) -> vec3<u32> {","  let bits = bitcast<u32>(value);","  let exponentBits = (bits >> 23u) & 0xffu;","  if (exponentBits == 0xffu) { return vec3<u32>(0u); }","  var significand = bits & 0x7fffffu;","  var exponent = -149;","  if (exponentBits != 0u) {","    significand = significand | 0x800000u;","    exponent = i32(exponentBits) - 150;","  // value = significand * 2^exponent; the term in units is significand * 2^shift.","  let shift = exponent - unitExponent;","  var magnitude = vec3<u32>(0u);","  if (shift >= 0) {","    // The scale bounds shift by 71 - h; the clamp only keeps a misused scale memory-safe.","    magnitude = shiftFixedPointLeft(significand, u32(min(shift, 71)));","  } else if (shift >= -24) {","    let right = u32(-shift);","    var quotient = significand >> right;","    let remainder = significand & ((1u << right) - 1u);","    let half = 1u << (right - 1u);","    if (remainder > half || (remainder == half && (quotient & 1u) != 0u)) {","      quotient = quotient + 1u;","    }","    magnitude = vec3<u32>(quotient, 0u, 0u);","  return select(magnitude, negateFixedPoint(magnitude), (bits >> 31u) != 0u);","fn getFixedPointFloat(value: vec3<u32>, unitExponent: i32) -> f32 {","  let negative = (value.z >> 31u) != 0u;","  let magnitude = select(value, negateFixedPoint(value), negative);","  var leading = 0u;","  if (magnitude.z != 0u) {","    leading = 64u + firstLeadingBit(magnitude.z);","  } else if (magnitude.y != 0u) {","    leading = 32u + firstLeadingBit(magnitude.y);","  } else if (magnitude.x != 0u) {","    leading = firstLeadingBit(magnitude.x);","  } else {","    return 0.0;","  var significand = magnitude.x;","  var exponent = unitExponent;","  if (leading >= 24u) {","    let shift = leading - 23u;","    significand = shiftFixedPointRight(magnitude, shift);","    let roundBit = getFixedPointBit(magnitude, shift - 1u);","    if (roundBit != 0u && (hasFixedPointBitsBelow(magnitude, shift - 1u) || (significand & 1u) != 0u)) {","      significand = significand + 1u;","    exponent = unitExponent + i32(shift);","  // significand <= 2^24, so f32(significand) is exact and the value is significand * 2^exponent.","  var infinityBits = 0x7f800000u;","  var result = bitcast<f32>(infinityBits);","  if (exponent < 104 || (exponent == 104 && significand < 0x1000000u)) {","    // Two steps keep the ldexp exponent in range for normal results below 2^-103.","    let leadingExponent = i32(firstLeadingBit(significand));","    result = ldexp(ldexp(f32(significand), -leadingExponent), exponent + leadingExponent);","  return select(result, -result, negative);","const MISSING_BITS: u32 = 0x7fc00000u;","fn loadCurveSum(slot: u32) -> vec3<u32> {"," return vec3<u32>(curves[curvesOffset + slot], sumsMiddle[sumsMiddleOffset + slot], sumsHigh[sumsHighOffset + slot]);","fn addCurveSum(slot: u32, value: vec3<u32>) {"," let next = addFixedPoint(loadCurveSum(slot), value);"," curves[curvesOffset + slot] = next.x; sumsMiddle[sumsMiddleOffset + slot] = next.y; sumsHigh[sumsHighOffset + slot] = next.z;","  _ = &stages;","  _ = &curves;","  _ = &sumsMiddle;","  _ = &sumsHigh;","  let stage = stages[stagesOffset + index];","let valid = status[statusOffset + 2u] == 0u && isFiniteValue(stage);","let nodeCount = status[statusOffset];","for (var node = 0u; node < 3u; node++) {"," let slot = (node * 2u + index) * 2u;"," // A zero sum for the nodes that exist, NaN for the others and for an invalid hierarchy or stage."," let initial = select(MISSING_BITS, 0u, valid && node < nodeCount);"," for (var component = 0u; component < 2u; component++) {","  curves[curvesOffset + slot + component] = initial;","  sumsMiddle[sumsMiddleOffset + slot + component] = 0u;","  sumsHigh[sumsHighOffset + slot + component] = 0u;","if (!valid) { return; }","let uniformCellArea = 1.0;","// The largest area and volume term of this stage set the two fixed-point units.","var areaExponent = 0u; var volumeExponent = 0u;","for (var cell = 0u; cell < 9u; cell++) {"," let cellArea = uniformCellArea;"," let depth = stage - elevation[elevationOffset + cell];"," if (ownership[ownershipOffset + cell] < nodeCount && depth >= 0.0) {","  areaExponent = max(areaExponent, getFixedPointExponentBits(cellArea));","  volumeExponent = max(volumeExponent, getFixedPointExponentBits(depth * cellArea));","let areaUnit = getFixedPointUnitExponent(areaExponent, 4u);","let volumeUnit = getFixedPointUnitExponent(volumeExponent, 4u);"," let owner = ownership[ownershipOffset + cell];"," if (owner < nodeCount && depth >= 0.0) {","  let slot = (owner * 2u + index) * 2u;","  addCurveSum(slot, quantizeFixedPoint(cellArea, areaUnit));","  addCurveSum(slot + 1u, quantizeFixedPoint(depth * cellArea, volumeUnit));","// Parents are created after their children. Each exclusive cell contribution moves once per edge,","// as an exact integer. A node is decoded once every child has been added to it and it has been","// added to its parent: decoding replaces its low word by the float32 bits.","for (var node = 0u; node < nodeCount; node++) {"," let areaSum = loadCurveSum(slot);"," let volumeSum = loadCurveSum(slot + 1u);"," let parent = nodes[nodesOffset + node * 4u];"," if (parent < nodeCount) {","  let destination = (parent * 2u + index) * 2u;","  addCurveSum(destination, areaSum);","  addCurveSum(destination + 1u, volumeSum);"," curves[curvesOffset + slot] = bitcast<u32>(getFixedPointFloat(areaSum, areaUnit));"," curves[curvesOffset + slot + 1u] = bitcast<u32>(getFixedPointFloat(volumeSum, volumeUnit));"],"strings":["terrain-depression-hierarchy-build","buffer","gpu-terrain-terrain-depression-hierarchy-snapshot-tap","status","read","read_write","terrain-depression-hierarchy-curves","terrain-depression-hierarchy-publish","elevation","nodes","terrain-depression-hierarchy-order-bitonic-local","GPUTerrainDepressionHierarchy","cellNodes","imported","levels","transient","curves","terrain-depression-hierarchy-levels","terrain-depression-hierarchy-order-keys","terrain-depression-hierarchy-tree","terrain-depression-hierarchy-cells","terrain-depression-hierarchy-keys","compute","outlets","stages","terrain-depression-hierarchy-sorted-cells","terrain-depression-hierarchy-curve-sums-high","terrain-depression-hierarchy-curve-sums-middle","terrain-depression-hierarchy-labels","ownership","terrain-depression-hierarchy-sorted-keys","tree"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","reads","writes","attrs"],["from","to","kind","resource"],["id","kind","firstNode","lastNode","bytes","ownership"],["logicalTransientBufferCount","physicalTransientBufferCount","logicalTransientBytes","physicalTransientBytes","reusedTransientBytes","logicalTransientTextureCount","physicalTransientTextureCount","reusedTransientTextureBytes"]],"lists":[["~:3","~8","~8","~4","f32",0,9],["~:3","~3","~3","~4","u32",0,3],["~l","~k"]]}}
