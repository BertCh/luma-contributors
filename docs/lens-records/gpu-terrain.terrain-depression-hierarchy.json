,"const sourceLevelsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> sourceLevels: array<f32>;","@group(0) @binding(2) var<storage, read> status: array<u32>;","const nodesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> nodes: array<u32>;","  _ = &sourceLevels;","  _ = &nodes;","  let valid = status[statusOffset + 2u] == 0u && index < status[statusOffset];","for (var component = 0u; component < 4u; component++) { nodes[nodesOffset + index * 4u + component] = 0xffffffffu; }","levels[levelsOffset + index * 2u] = missing(); levels[levelsOffset + index * 2u + 1u] = missing();","nodes[nodesOffset + index * 4u + 3u] = 0u;","if (valid) {"," for (var component = 0u; component < 4u; component++) { nodes[nodesOffset + index * 4u + component] = tree[treeOffset + index * 4u + component]; }"," levels[levelsOffset + index * 2u] = sourceLevels[sourceLevelsOffset + index * 2u]; levels[levelsOffset + index * 2u + 1u] = sourceLevels[sourceLevelsOffset + index * 2u + 1u];","@group(0) @binding(1) var<storage, read> ownership: array<u32>;","@group(0) @binding(2) var<storage, read> nodes: array<u32>;","const stagesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> stages: array<f32>;","@group(0) @binding(4) var<storage, read> status: array<u32>;","const curvesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> curves: array<f32>;","const compensationOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> compensation: array<f32>;","// Recover positive-addition rounding error through integer significands. Unlike a floating","// two-sum transform, shader fast-math cannot algebraically eliminate this correction.","fn positiveAdditionError(first: f32, second: f32, sum: f32) -> f32 {"," if (first == 0.0 || second == 0.0 || !finite(sum)) { return 0.0; }"," let firstBits = bitcast<u32>(first); let secondBits = bitcast<u32>(second);"," let larger = max(firstBits, secondBits); let smaller = min(firstBits, secondBits);"," let largerExponent = max((larger >> 23u) & 255u, 1u);"," let smallerExponent = max((smaller >> 23u) & 255u, 1u);"," let largerMantissa = (larger & 0x7fffffu) | select(0u, 0x800000u, (larger & 0x7f800000u) != 0u);"," let smallerMantissa = (smaller & 0x7fffffu) | select(0u, 0x800000u, (smaller & 0x7f800000u) != 0u);"," let gap = largerExponent - smallerExponent;"," var aligned = 0u; var remainder = smallerMantissa;"," if (gap < 32u) { aligned = smallerMantissa >> gap; remainder = smallerMantissa & ((1u << gap) - 1u); }"," let sumBits = bitcast<u32>(sum); let sumExponent = max((sumBits >> 23u) & 255u, 1u);"," let sumMantissa = (sumBits & 0x7fffffu) | select(0u, 0x800000u, (sumBits & 0x7f800000u) != 0u);"," let difference = i32(largerMantissa + aligned) - i32(sumMantissa << (sumExponent - largerExponent));"," return f32(difference) * exp2(f32(i32(largerExponent) - 150)) + f32(remainder) * exp2(f32(i32(smallerExponent) - 150));","fn addCurve(offset: u32, area: f32, volume: f32) {"," let additions = vec2<f32>(area, volume);"," for (var component = 0u; component < 2u; component++) {","  let current = curves[curvesOffset + offset + component];","  let next = current + additions[component];","  compensation[compensationOffset + offset + component] += positiveAdditionError(current, additions[component], next);","  curves[curvesOffset + offset + component] = next;","  _ = &stages;","  _ = &curves;","  _ = &compensation;","  let stage = stages[stagesOffset + index];","let valid = status[statusOffset + 2u] == 0u && finite(stage);","let nodeCount = status[statusOffset];","for (var node = 0u; node < 3u; node++) {"," let offset = curvesOffset + (node * 2u + index) * 2u;"," curves[offset] = select(missing(), 0.0, valid && node < nodeCount);"," curves[offset + 1u] = select(missing(), 0.0, valid && node < nodeCount);"," compensation[compensationOffset + (node * 2u + index) * 2u] = 0.0;"," compensation[compensationOffset + (node * 2u + index) * 2u + 1u] = 0.0;","if (!valid) { return; }","let cellArea = 1.0;","for (var cell = 0u; cell < 9u; cell++) {"," let owner = ownership[ownershipOffset + cell];"," let depth = stage - elevation[elevationOffset + cell];"," if (owner < nodeCount && depth >= 0.0) {","  let offset = curvesOffset + (owner * 2u + index) * 2u;","  addCurve(offset - curvesOffset, cellArea, depth * cellArea);","// Parents are created after their children. Each exclusive cell contribution moves once per edge.","for (var node = 0u; node < nodeCount; node++) {"," let localOffset = (node * 2u + index) * 2u;"," curves[curvesOffset + localOffset] += compensation[compensationOffset + localOffset];"," curves[curvesOffset + localOffset + 1u] += compensation[compensationOffset + localOffset + 1u];"," let parent = nodes[nodesOffset + node * 4u];"," if (parent < nodeCount) {","  let source = curvesOffset + (node * 2u + index) * 2u;","  let destination = curvesOffset + (parent * 2u + index) * 2u;","  addCurve(destination - curvesOffset, curves[source], curves[source + 1u]);"],"strings":["terrain-depression-hierarchy-build","buffer","terrain-depression-hierarchy-curves","read","status","read_write","terrain-depression-hierarchy-publish","elevation","GPUTerrainDepressionHierarchy","nodes","terrain-depression-hierarchy-order-bitonic-local","imported","transient","cellNodes","terrain-depression-hierarchy-cells","terrain-depression-hierarchy-keys","terrain-depression-hierarchy-levels","terrain-depression-hierarchy-order-keys","terrain-depression-hierarchy-tree","levels","terrain-depression-hierarchy-sorted-cells","compute","curves","terrain-depression-hierarchy","outlets","stages","terrain-depression-hierarchy-curve-compensation","terrain-depression-hierarchy-labels","bitonic-local","terrain-depression-hierarchy-sorted-keys","transient-buffer-0","GPUSort","keys","ownership","transient-buffer-1","transient-buffer-2","tree","write"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","b