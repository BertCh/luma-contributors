coalesced":true,"timestamped":false,"taps":0,"lensTwin":true},"nodes":{}}],"captures":{"schema":"luma.computation-captures/1","runId":"run-f09b3c34","snapshots":[{"id":"gpu-terrain-terrain-flow-distance-snapshots-input-0","name":"input","iteration":0,"elementType":"f32","values":"b64:AAAQQQAAAEEAAOBAAADAQAAAwH8AAIBAAABAQAAAAEAAAIA/","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"input","afterNode":"terrain-flow-distance","role":"input","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-flow-distance-snapshots-flowDirections-0","name":"flowDirections","iteration":0,"elementType":"u32","values":"b64:AQAAAAEAAAAAAAAAAQAAAAEAAAAAAAAAAQAAAAEAAAAAAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"flowDirections","afterNode":"terrain-flow-distance","role":"input","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-flow-distance-snapshots-streams-0","name":"streams","iteration":0,"elementType":"u32","values":"b64:AQAAAAEAAAABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"streams","afterNode":"terrain-flow-distance","role":"input","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-flow-distance-snapshots-values-0","name":"values","iteration":0,"elementType":"f32","values":"b64:AAAAAAAAAAAAAAAAAAAAQAAAgD8AAAAAAAAAQAAAgD8AAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"values","afterNode":"terrain-flow-distance","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-flow-distance-snapshots-validity-0","name":"validity","iteration":0,"elementType":"u32","values":"b64:AQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAAEAAAABAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"validity","afterNode":"terrain-flow-distance","role":"intermediate","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-flow-distance-snapshots-terminalCells-0","name":"terminalCells","iteration":0,"elementType":"u32","values":"b64:AAAAAAEAAAACAAAABQAAAAUAAAAFAAAACAAAAAgAAAAIAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"terminalCells","afterNode":"terrain-flow-distance","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const directionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> directions: array<u32>;","const streamsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> streams: array<u32>;","const distanceOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> distance: array<f32>;","const validityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> validity: array<u32>;","const terminalCellsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> terminalCells: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  }","  return u32(row) * GRID_WIDTH + u32(column);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &directions;","  _ = &streams;","  _ = &distance;","  _ = &validity;","  _ = &terminalCells;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  var current = index; var total = 0.0; var terminal = UNRESOLVED_DIRECTION; var valid = false;","if (directions[directionsOffset+index] == NO_CELL) { terminal = NO_CELL; } else {"," for (var step = 0u; step < 9u; step++) {","  let code = directions[directionsOffset+current];","  if (code != 0u && getFlowReceiver(current, code) == NO_CELL) { break; }","  if (streams[streamsOffset+current] == NO_CELL || streams[streamsOffset+current] == UNRESOLVED_DIRECTION) { break; } if (streams[streamsOffset+current] != 0u) { terminal = current; valid = true; break; }","  let receiver = getFlowReceiver(current,code);","  if (receiver == NO_CELL) { terminal = current; valid = true; break; }","  let delta = vec2<f32>(f32(receiver % GRID_WIDTH) - f32(current % GRID_WIDTH), f32(receiver / GRID_WIDTH) - f32(current / GRID_WIDTH));","  let cost = length(vec2<f32>(1 * delta.x + 0 * delta.y, 0 * delta.x + 1 * delta.y));","  if (!isFiniteValue(cost) || cost < 0.0) { break; }","  total += cost; current = receiver;"," }","if (!isFiniteValue(total) && terminal != NO_CELL) { terminal = UNRESOLVED_DIRECTION; }","valid = valid && isFiniteValue(total);","distance[distanceOffset+index] = select(bitcast<f32>(0x7fc00000u | (index & 0u)), total, valid);","validity[validityOffset+index] = u32(valid); terminalCells[terminalCellsOffset+index] = terminal;"],"strings":["terrain-flow-distance","buffer","imported","terminalCells","validity","streams","values","GPUTerrainFlowDistance","flowDirections","read_write","read"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","kind","bytes","ownership"],["id","kind","bytes","ownership","firstNode","lastNode"]],"lists":[]}}
