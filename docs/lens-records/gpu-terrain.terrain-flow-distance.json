AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"streams","meaning":"gpu-terrain-terrain-flow-distance-snapshot-tap","role":"input","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"m","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":9},{"id":"gpu-terrain-terrain-flow-distance-snapshots-values-0","name":"values","iteration":0,"elementType":"f32","values":"b64:AAAAAAAAAAAAAAAAAAAAQAAAgD8AAAAAAAAAQAAAgD8AAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"values","meaning":"gpu-terrain-terrain-flow-distance-snapshot-tap","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"m","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":9},{"id":"gpu-terrain-terrain-flow-distance-snapshots-validity-0","name":"validity","iteration":0,"elementType":"u32","values":"b64:AQAAAAEAAAABAAAAAQAAAAEAAAABAAAAAQAAAAEAAAABAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"validity","meaning":"gpu-terrain-terrain-flow-distance-snapshot-tap","role":"intermediate","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"m","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":9},{"id":"gpu-terrain-terrain-flow-distance-snapshots-terminalCells-0","name":"terminalCells","iteration":0,"elementType":"u32","values":"b64:AAAAAAEAAAACAAAABQAAAAUAAAAFAAAACAAAAAgAAAAIAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"terminalCells","meaning":"gpu-terrain-terrain-flow-distance-snapshot-tap","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"affine":[1,0,0,0,1,0],"pixelInterpretation":"area","coordinateModel":"projected","unit":"m","cellSize":1,"rowDirection":"north","origin":[0,0]},"valueCount":9}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const directionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> directions: array<u32>;","const streamsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> streams: array<u32>;","const stateOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> state: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","// A direction word outside the contributor's encoding: nonzero and without a receiver.","const INVALID_DIRECTION_CODE: u32 = 0x100u;","fn getFlowDirectionCode(word: u32) -> u32 { return word; }","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  }","  return u32(row) * GRID_WIDTH + u32(column);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn getTerrainCoordinateDifference(first: u32, second: u32) -> f32 {"," return select(-f32(second - first), f32(first - second), first >= second);","fn getGroundEdgeLength(cell: u32, other: u32) -> f32 {"," let delta = vec2<f32>(getTerrainCoordinateDifference(other % GRID_WIDTH, cell % GRID_WIDTH), getTerrainCoordinateDifference(other / GRID_WIDTH, cell / GRID_WIDTH));"," return length(vec2<f32>(1.0 * delta.x + 0.0 * delta.y, 0.0 * delta.x + 1.0 * delta.y));","fn getGroundCellArea(cell: u32) -> f32 { return 1.0; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &directions;","  _ = &streams;","  _ = &state;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let code = getFlowDirectionCode(directions[directionsOffset+index]);","let receiver = getFlowReceiver(index, code);","var kind = 0u; var cost = 0.0;","if (code != 0u && receiver == NO_CELL) { kind = 2u; } else {"," let stream = streams[streamsOffset+index]; if (stream == NO_CELL || stream == UNRESOLVED_DIRECTION) { kind = 2u; } else if (stream != 0u) { kind = 1u; }"," if (kind == 0u && receiver == NO_CELL) { kind = 1u; }"," if (kind == 0u) {","  cost = getGroundEdgeLength(index, receiver);","  if (!isFiniteValue(cost) || cost < 0.0) { kind = 2u; cost = 0.0; }"," }","let offset = stateOffset + index * 4u;","state[offset] = select(NO_CELL, receiver, kind == 0u);","state[offset + 1u] = bitcast<u32>(cost);","state[offset + 2u] = 1u;","state[offset + 3u] = select(UNRESOLVED_DIRECTION, index, kind == 1u);","const statusOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> status: array<u32>;","const dispatchOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> dispatch: array<u32>;","  _ = &status;","  _ = &dis