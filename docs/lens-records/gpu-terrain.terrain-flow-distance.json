stance-snapshot-tap","role":"intermediate","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-flow-distance-snapshots-terminalCells-0","name":"terminalCells","iteration":0,"elementType":"u32","values":"b64:AAAAAAEAAAACAAAABQAAAAUAAAAFAAAACAAAAAgAAAAIAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-distance-compiled","resource":"terminalCells","meaning":"gpu-terrain-terrain-flow-distance-snapshot-tap","role":"output","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const directionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> directions: array<u32>;","const streamsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> streams: array<u32>;","const stateOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> state: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const NO_CELL: u32 = 0xffffffffu;","// GPU_TERRAIN_FLOW_UNRESOLVED: a valid cell whose direction is unknown. It has no receiver but is","// not a terminal cell, so consumers must not read it as an outlet or a sink.","const UNRESOLVED_DIRECTION: u32 = 0xfffffffeu;","// A direction word outside the contributor's encoding: nonzero and without a receiver.","const INVALID_DIRECTION_CODE: u32 = 0x100u;","fn getFlowDirectionCode(word: u32) -> u32 { return word; }","fn getFlowReceiver(cell: u32, code: u32) -> u32 {","  if (code == 0u || code > 128u || (code & (code - 1u)) != 0u) { return NO_CELL; }","  var columnOffsets = array<i32, 8>(1, 1, 0, -1, -1, -1, 0, 1);","  var rowOffsets = array<i32, 8>(0, 1, 1, 1, 0, -1, -1, -1);","  let direction = firstTrailingBit(code);","  let column = i32(cell % GRID_WIDTH) + columnOffsets[direction];","  let row = i32(cell / GRID_WIDTH) + rowOffsets[direction];","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return NO_CELL;","  }","  return u32(row) * GRID_WIDTH + u32(column);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn getGroundEdgeLength(cell: u32, other: u32) -> f32 {"," let delta = vec2<f32>(f32(other % GRID_WIDTH) - f32(cell % GRID_WIDTH), f32(other / GRID_WIDTH) - f32(cell / GRID_WIDTH));"," return length(vec2<f32>(1.0 * delta.x + 0.0 * delta.y, 0.0 * delta.x + 1.0 * delta.y));","fn getGroundCellArea(cell: u32) -> f32 { return 1.0; }","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &directions;","  _ = &streams;","  _ = &state;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let code = getFlowDirectionCode(directions[directionsOffset+index]);","let receiver = getFlowReceiver(index, code);","var kind = 0u; var cost = 0.0;","if (code != 0u && receiver == NO_CELL) { kind = 2u; } else {"," let stream = streams[streamsOffset+index]; if (stream == NO_CELL || stream == UNRESOLVED_DIRECTION) { kind = 2u; } else if (stream != 0u) { kind = 1u; }"," if (kind == 0u && receiver == NO_CELL) { kind = 1u; }"," if (kind == 0u) {","  cost = getGroundEdgeLength(index, receiver);","  if (!isFiniteValue(cost) || cost < 0.0) { kind = 2u; cost = 0.0; }"," }","let offset = stateOffset + index * 4u;","state[offset] = select(NO_CELL, receiver, kind == 0u);","state[offset + 1u] = bitcast<u32>(cost);","state[offset + 2u] = 1u;","state[offset + 3u] = select(UNRESOLVED_DIRECTION, index, kind == 1u);","const statusOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> status: array<u32>;","const dispatchOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> dispatch: array<u32>;","  _ = &status;","  _ = &dispatch;","  status[statusOffset + 0u] = 0u;","  status[statusOffset + 1u] = 1u;","  status[statusOffset + 2u] = 0u;","  status[statusOffset + 3u] = 0u;","  dispatch[dispatchOffset + 0u] = 1u;","  dispatch[dispatchOffset + 1u] = 1u;","  dispatch[dispatchOffset + 2u] = 1u;","const slotTableOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> slotTable: array<u32>;","  _ = &slotTable;","  slotTable[slotTableOffset + index * 64u] = index;","const previousOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> previous: array<u32>;","const nextOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> next: array<u32>;","@group(0) @binding(2) var<storage, read_write> status: array<atomic<u32>>;","const roundSlotOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> roundSlot: array<u32>;","  _ = &previous;","  _ = &next;","  _ = &roundSlot;","  let offset = previousOffset + index * 4u; let destination = nextOffset + index * 4u;","for (var component = 0u; component < 4u; component++) { next[destination + component] = previous[offset + component]; }","let parent = previous[offset];","if (parent != NO_CELL) {"," let ancestor = previousOffset + parent * 4u;"," next[destination] = previous[ancestor];"," next[destination + 1u] = bitcast<u32>(bitcast<f32>(previous[offset + 1u]) + bitcast<f32>(previous[ancestor + 1u]));"," next[destination + 2u] = min(10u, previous[offset + 2u] + previous[ancestor + 2u]);"," next[destination + 3u] = previous[ancestor + 3u];"," atomicOr(&status[statusOffset], 1u << roundSlot[roundSlotOffset]);","const groupSizeOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> groupSize: array<u32>;","  _ = &groupSize;","  if (status[statusOffset + 1u] == 0u) { return; }","  let changedBits = status[statusOffset + 0u];","  let size = groupSize[groupSizeOffset];","  var executed = size;","  var converged = false;","  for (var round = 0u; round < size; round++) {","    if (((changedBits >> round) & 1u) == 0u) {","      executed = round + 1u;","      converged = true;","      break;","    }","  let iterationCount = status[statusOffset + 2u] + executed;","  status[statusOffset + 2u] = iterationCount;","  if (converged) {","    status[statusOffset + 1u] = 0u;","    status[statusOffset + 3u] = 1u;","    dispatch[dispatchOffset + 0u] = 0u;","  if (iterationCount >= 4u) {","@group(0) @binding(1) var<storage, read> state: array<u32>;","const distanceOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> distance: array<f32>;","const validityOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> validity: array<u32>;","const terminalCellsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> terminalCells: array<u32>;","  _ = &distance;","  _ = &validity;","  _ = &terminalCells;","  let offset = stateOffset + index * 4u;","let total = bitcast<f32>(state[offset + 1u]);","var terminal = state[offset + 3u];","let startsInvalid = directions[directionsOffset+index] == NO_CELL;","let valid = !startsInvalid && state[offset] == NO_CELL && terminal != UNRESOLVED_DIRECTION && state[offset + 2u] <= 9u && isFiniteValue(total);","terminal = select(select(UNRESOLVED_DIRECTION, NO_CELL, startsInvalid), terminal, valid);","distance[distanceOffset+index] = select(bitcast<f32>(0x7fc00000u | (index & 0u)), total, valid);","validity[validityOffset+index] = u32(valid); terminalCells[terminalCellsOffset+index] = terminal;","@group(0) @binding(0) var<storage, read> status: array<u32>;","const convergedOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> converged: array<u32>;","  _ = &converged;","  converged[convergedOffset] = status[statusOffset + 3u];","  "],"strings":["terrain-flow-distance-