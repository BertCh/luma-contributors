:"u32","values":"b64:BAAAAAQAAAAEAAAABAAAAAQAAAAEAAAAAQAAAAEAAAAAAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-fractions-compiled","resource":"flowDirections","afterNode":"terrain-flow-fractions-publish","role":"input","keySpace":"cells","geometry":{"kind":"raster","shape":[3,3],"coordinateModel":"projected","cellSize":1,"unit":"m"}},{"id":"gpu-terrain-terrain-flow-fractions-snapshots-fractions-0","name":"fractions","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-fractions-compiled","resource":"fractions","afterNode":"terrain-flow-fractions-publish","role":"output","meaning":"Eight outgoing MFD fractions per terrain cell","components":8},{"id":"gpu-terrain-terrain-flow-fractions-snapshots-edgeLengths-0","name":"edgeLengths","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-terrain-terrain-flow-fractions-compiled","resource":"edgeLengths","afterNode":"terrain-flow-fractions-publish","role":"output","meaning":"Ground length for each directed neighbor edge (m)","components":8}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const directionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> directions: array<u32>;","const settingsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> settings: array<f32>;","const receiversOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> receivers: array<u32>;","const GRID_WIDTH: u32 = 3u;","const GRID_HEIGHT: u32 = 3u;","const GRID_NONE: u32 = 0xffffffffu;","// Bit tests: shader compilers may fold 'value != value' away under fast-math assumptions.","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn isNaNValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7fffffffu) > 0x7f800000u; }","fn getInfinity() -> f32 { var bits = 0x7f800000u; return bitcast<f32>(bits); }","fn getQuietNaN() -> f32 { var bits = 0x7fc00000u; return bitcast<f32>(bits); }","// Offsets are packed as two-bit (offset + 1) fields so no dynamically indexed private array is needed.","fn getD8ColumnOffset(direction: u32) -> i32 {","  return i32((0x901au >> ((direction & 7u) * 2u)) & 3u) - 1;","}","fn getD8RowOffset(direction: u32) -> i32 {","  return i32((0x1a9u >> ((direction & 7u) * 2u)) & 3u) - 1;","fn getD8Code(direction: u32) -> u32 { return 1u << direction; }","// Returns the neighboring cell index in one D8 direction, or GRID_NONE outside the grid.","fn getD8Neighbor(cell: u32, direction: u32) -> u32 {","  let column = i32(cell % GRID_WIDTH) + getD8ColumnOffset(direction);","  let row = i32(cell / GRID_WIDTH) + getD8RowOffset(direction);","  if (column < 0 || row < 0 || column >= i32(GRID_WIDTH) || row >= i32(GRID_HEIGHT)) {","    return GRID_NONE;","  }","  return u32(row) * GRID_WIDTH + u32(column);","// Ground meters per cell at a continuous row coordinate (row index + 0.5 is a cell center).","fn getGroundCellSizeAtRowCoordinate(rowCoordinate: f32) -> vec2<f32> {","  let cellSize = vec2<f32>(settings[settingsOffset], settings[settingsOffset + 1u]);","  return cellSize;","// Ground length of one D8 move from centerRow, measured at the midpoint row (symmetric).","fn getD8Distance(direction: u32, centerRow: u32) -> f32 {","  let rowOffset = getD8RowOffset(direction);","  let neighborRow = i32(centerRow) + rowOffset;","  let ground = getGroundCellSizeAtRowCoordinate((f32(centerRow) + f32(neighborRow) + 1.0) * 0.5);","  if (rowOffset == 0) { return ground.x; }","  if (getD8ColumnOffset(direction) == 0) { return ground.y; }","  return sqrt(ground.x * ground.x + ground.y * ground.y);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &directions;","  _ = &settings;","  _ = &receivers;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let code = directions[directionsOffset + index]; var receiver = GRID_NONE;","if (code >= 1u && code <= 128u && (code & (code - 1u)) == 0u) { receiver = getD8Neighbor(index, firstTrailingBit(code)); }","receivers[receiversOffset + index] = receiver;","const surfaceOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> surface: array<f32>;","@group(0) @binding(1) var<storage, read> receivers: array<u32>;","@group(0) @binding(2) var<storage, read> settings: array<f32>;","const routingOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> routing: array<u32>;","const ROUTING_INVALID: u32 = 0xffffffffu;","// Fraction of 'cell' flow that goes to the neighbor in 'direction' when no lower neighbor exists.","fn getFallbackFraction(cell: u32, direction: u32) -> f32 {","  let receiver = receivers[receiversOffset + cell];","  return select(0.0, 1.0, receiver != GRID_NONE && receiver == getD8Neighbor(cell, direction));","fn getFlowExponent() -> f32 {","  let exponent = settings[settingsOffset + 6u];","  return select(1.1, exponent, isFiniteValue(exponent) && exponent > 0.0);","// Slope (Freeman) or slope times contour length (Quinn) of one lower neighbor.","fn getMultipleFlowScore(drop: f32, direction: u32, row: u32) -> f32 {","  let tangent = drop / getD8Distance(direction, row);","  return tangent;","// Writes the cell's MFD routing record: [largest score bits (-1 = no lower neighbor), weight total","// bits], or ROUTING_INVALID for an invalid cell.","fn computeRouting(cell: u32) {","  let center = surface[surfaceOffset + cell];","  if (!isFiniteValue(center)) {","    routing[routingOffset + 2u * cell] = ROUTING_INVALID;","    routing[routingOffset + 2u * cell + 1u] = 0u;","  let row = cell / GRID_WIDTH;","  var hasLower = false;","  var maximumScore = 0.0;","  for (var other = 0u; other < 8u; other++) {","    let neighbor = getD8Neighbor(cell, other);","    if (neighbor == GRID_NONE) { continue; }","    let drop = center - surface[surfaceOffset + neighbor];","    if (isFiniteValue(drop) && drop > 0.0) {","      hasLower = true;","      maximumScore = max(maximumScore, getMultipleFlowScore(drop, other, row));","    }","  if (!hasLower) {","    routing[routingOffset + 2u * cell] = bitcast<u32>(-1.0);","  var total = 0.0;","    total = total + getMultipleFlowWeight(cell, center, other, maximumScore);","  routing[routingOffset + 2u * cell] = bitcast<u32>(maximumScore);","  routing[routingOffset + 2u * cell + 1u] = bitcast<u32>(total);","// Unnormalized weight of the move from 'cell' toward 'direction'; 0 unless that neighbor is lower.","fn getMultipleFlowWeight(cell: u32, center: f32, direction: u32, maximumScore: f32) -> f32 {","  let neighbor = getD8Neighbor(cell, direction);","  if (neighbor == GRID_NONE) { return 0.0; }","  let drop = center - surface[surfaceOffset + neighbor];","  if (!(isFiniteValue(drop) && drop > 0.0)) { return 0.0; }","  let score = getMultipleFlowScore(drop, direction, cell / GRID_WIDTH);","  let ratio = select(1.0, score / maximumScore, maximumScore > 0.0);","  return select(0.0, pow(ratio, getFlowExponent()), ratio > 0.0);","fn getFlowFraction(cell: u32, direction: u32) -> f32 {","  let code = routing[routingOffset + 2u * cell];","  if (code == ROUTING_INVALID) { return 0.0; }","  let maximumScore = bitcast<f32>(code);","  if (maximumScore < 0.0) { return getFallbackFraction(cell, direction); }","  let total = bitcast<f32>(routing[routingOffset + 2u * cell + 1u]);","  let weight = getMultipleFlowWeight(cell, surface[surfaceOffset + cell], direction, maximumScore);","  return select(0.0, weight / total, total > 0.0);","  _ = &surface;","  _ = &routing;","  computeRouting(index);","@group(0) @binding(3) var<storage, read> routing: array<u32>;","@group(0) @binding(4) var<storage, read> directions: array<u32>;","const fractionsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> fractions: array<f32>;","const lengthsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> lengths: array<f32>;","  _ = &fractions;","  _ = &lengths;","  let code = directions[directionsOffset + index];","let valid = isFiniteValue(surface[surfaceOffset + index]) && (code == 0u || (code <= 128u && (code & (code - 1u)) == 0u && receivers[receiversOffset + index] != GRID_NONE));","for (var direction = 0u; direction < 8u; direction++) {"," fractions[fractionsOffset + index * 8u + direction] = select(getQuietNaN(), getFlowFraction(index, direction), valid);"," lengths[lengthsOffset + index * 8u + direction] = getD8Distance(direction, index / GRID_WIDTH);"],"strings":["terrain-flow-fractions-receivers","terrain-flow-fractions-publish","read","GPUTerrainFlowFractions","buffer","parameters","terrain-flow-fractions-routing","terrain-flow-fractions-prepare","elevation","flowDirections","fractions","imported","edgeLengths","read_write","compute","receivers","settings","terrain-flow-fractions","directions","routing","surface","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[["~:2","~g","~5","~2","f32",0,8],["~:3",[1,1,1],9,false],["~:2","~f","~0","~2","u32",0,9],["~:2","~i","~