64u;","const BLOCK_SIZE: u32 = 2u;","const FOOTPRINT_EXTRA: u32 = 0u;","const LEVEL_WIDTH: u32 = 32u;","const LEVEL_OFFSET: u32 = 0u;","const EMPTY_MAXIMUM: f32 = -3.4028234663852886e+38;","const EMPTY_MINIMUM: f32 = 3.4028234663852886e+38;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","  _ = &values;","  _ = &validity;","  _ = &maximumLevels;","  let cellColumn = index % LEVEL_WIDTH;","  let cellRow = index / LEVEL_WIDTH;","  let x0 = cellColumn * BLOCK_SIZE;","  let y0 = cellRow * BLOCK_SIZE;","  let x1 = min(x0 + BLOCK_SIZE + FOOTPRINT_EXTRA, WIDTH);","  let y1 = min(y0 + BLOCK_SIZE + FOOTPRINT_EXTRA, HEIGHT);","  var maximumValue = EMPTY_MAXIMUM;","  var minimumValue = EMPTY_MINIMUM;","  for (var y = y0; y < y1; y++) {","    for (var x = x0; x < x1; x++) {","      let pixel = y * WIDTH + x;","      if (validity[validityOffset + pixel] != 0u) {","        let value = values[valuesOffset + pixel];","        if (isFiniteValue(value)) {","          if (value > maximumValue) { maximumValue = value; }","          if (value < minimumValue) { minimumValue = value; }","        }","      }","    }","  maximumLevels[maximumLevelsOffset + LEVEL_OFFSET + index] = maximumValue;","  ","const elevationValuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> elevationValues: array<f32>;","const elevationValidityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> elevationValidity: array<u32>;","const settingsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> settings: array<f32>;","const pyramidOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> pyramid: array<f32>;","const maskValuesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> maskValues: array<u32>;","const dropValuesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> dropValues: array<f32>;","const MAXIMUM_RADIUS_PIXELS: i32 = 8;","const REJECT_INCOMPLETE: bool = true;","const NO_INDEX: u32 = 0xffffffffu;","const FLOAT_MAXIMUM: f32 = 3.4028234663852886e38;","const STACK_SIZE: u32 = 22u;","const PI: f32 = 3.141592653589793;","const NAN_BITS: u32 = 0x7fc00000u;","const INFINITY_BITS: u32 = 0x7f800000u;","// WGSL rejects constant-evaluated NaN and infinity; a runtime zero (seed & 0u) defers evaluation.","fn getQuietNaN(seed: u32) -> f32 { return bitcast<f32>(0x7fc00000u | (seed & 0u)); }","fn getInfinity(seed: u32) -> f32 { return bitcast<f32>(INFINITY_BITS | (seed & 0u)); }","fn getGroundCellSize(row: u32) -> vec2<f32> {","  let cellSize = vec2<f32>(settings[settingsOffset + 2u], settings[settingsOffset + 3u]);","  return cellSize;","fn isInDisc(pixel: vec2<i32>, centre: vec2<f32>, cell: vec2<f32>, radiusSquared: f32) -> bool {","  let scaledX = (f32(pixel.x) - centre.x) * cell.x;","  let scaledY = (f32(pixel.y) - centre.y) * cell.y;","  return scaledX * scaledX + scaledY * scaledY <= radiusSquared;","fn isOnDiscRing(pixel: vec2<i32>, centre: vec2<f32>, cell: vec2<f32>, radiusSquared: f32) -> bool {","  for (var neighborY = -1; neighborY <= 1; neighborY++) {","    for (var neighborX = -1; neighborX <= 1; neighborX++) {","      if ((neighborX != 0 || neighborY != 0) &&","          !isInDisc(pixel + vec2<i32>(neighborX, neighborY), centre, cell, radiusSquared)) {","        return true;","  return false;","fn getMaximumRadius(cell: vec2<f32>) -> f32 {","  return min(f32(MAXIMUM_RADIUS_PIXELS) * cell.x, f32(MAXIMUM_RADIUS_PIXELS) * cell.y);","fn isRadiusClamped(requested: f32, cell: vec2<f32>) -> bool {","  return requested > getMaximumRadius(cell);","fn getEffectiveRadius(requested: f32, cell: vec2<f32>) -> f32 {","  return min(requested, getMaximumRadius(cell));","fn getDiscExtent(radius: f32, cellSize: f32) -> i32 {","  return min(i32(floor(radius / cellSize + 0.5)) + 1, MAXIMUM_RADIUS_PIXELS);","fn isOffsetInDisc(dx: i32, dy: i32, cell: vec2<f32>, radiusSquared: f32) -> bool {","  return isInDisc(vec2<i32>(dx, dy), vec2<f32>(0.0, 0.0), cell, radiusSquared);","fn getDiscRowHalfWidth(dy: i32, cell: vec2<f32>, radiusSquared: f32) -> i32 {","  let scaledY = f32(dy) * cell.y;","  let remaining = max(radiusSquared - scaledY * scaledY, 0.0);","  var halfWidth = clamp(i32(floor(sqrt(remaining) / cell.x)), 0, MAXIMUM_RADIUS_PIXELS + 1);","  while (halfWidth > 0 && !isOffsetInDisc(halfWidth, dy, cell, radiusSquared)) { halfWidth--; }","  while (halfWidth <= MAXIMUM_RADIUS_PIXELS && isOffsetInDisc(halfWidth + 1, dy, cell, radiusSquared)) { halfWidth++; }","  if (!isOffsetInDisc(halfWidth, dy, cell, radiusSquared)) { return -1; }","  return halfWidth;","fn getDiscColumnHalfHeight(cell: vec2<f32>, radiusSquared: f32) -> i32 {","  var halfHeight = clamp(i32(floor(sqrt(radiusSquared) / cell.y)), 0, MAXIMUM_RADIUS_PIXELS + 1);","  while (halfHeight > 0 && !isOffsetInDisc(0, halfHeight, cell, radiusSquared)) { halfHeight--; }","  while (halfHeight <= MAXIMUM_RADIUS_PIXELS && isOffsetInDisc(0, halfHeight + 1, cell, radiusSquared)) { halfHeight++; }","  return halfHeight;","const PYRAMID_LEVEL_COUNT: u32 = 6u;","const PYRAMID_EMPTY_MAXIMUM: f32 = -3.4028234663852886e+38;","const PYRAMID_EMPTY_MINIMUM: f32 = 3.4028234663852886e+38;","const PYRAMID_MINIMUM_OFFSET: u32 = 1365u;","const PYRAMID_BLOCK_SIZES = array<u32, 6>(2u, 4u, 8u, 16u, 32u, 64u);","const PYRAMID_LEVEL_WIDTHS = array<u32, 6>(32u, 16u, 8u, 4u, 2u, 1u);","const PYRAMID_LEVEL_OFFSETS = array<u32, 6>(0u, 1024u, 1280u, 1344u, 1360u, 1364u);","fn pyramidLevelBlockSize(level: u32) -> u32 {","  return PYRAMID_BLOCK_SIZES[level];","fn pyramidLevelIndex(level: u32, column: u32, row: u32) -> u32 {","  let blockSize = PYRAMID_BLOCK_SIZES[level];","  return PYRAMID_LEVEL_OFFSETS[level] + (row / blockSize) * PYRAMID_LEVEL_WIDTHS[level] + column / blockSize;","var<private> summitDrop: f32;","var<private> stackLevel: array<u32, 22>;","var<private> stackColumn: array<u32, 22>;","var<private> stackRow: array<u32, 22>;","// Whether a pixel of height `other` beats the centre: >= where it has the smaller index, else >.","fn beatsCentre(other: f32, ownHeight: f32, hasSmallerIndex: bool) -> bool {","  return select((other > ownHeight), (other >= ownHeight), hasSmallerIndex);","// Returns true when no disc pixel of rows [rowLow, rowHigh] beats the centre pixel.","fn isHalfDiscDominated(column: i32, row: i32, rowLow: i32, rowHigh: i32, ownHeight: f32,","    hasSmallerIndex: bool, exact: bool, cell: vec2<f32>, radiusSquared: f32) -> bool {","  if (rowLow > rowHigh) { return true; }","  var depth = 1u;","  stackLevel[0] = 5u;","  stackColumn[0] = 0u;","  stackRow[0] = 0u;","  loop {","    if (depth == 0u) { break; }","    depth--;","    let level = stackLevel[depth];","    let cellColumn = i32(stackColumn[depth]);","    let cellRow = i32(stackRow[depth]);","    let blockSize = i32(pyramidLevelBlockSize(level));","    let x0 = cellColumn * blockSize;","    let y0 = cellRow * blockSize;","    let x1 = min(x0 + blockSize, i32(WIDTH)) - 1;","    let y1 = min(y0 + blockSize, i32(HEIGHT)) - 1;","    let ya = max(y0, rowLow);","    let yb = min(y1, rowHigh);","    if (ya > yb) { continue; }","    let dxLow = x0 - column;","    let dxHigh = x1 - column;","    let dyLow = ya - row;","    let dyHigh = yb - row;","    // Block pixel nearest the centre: disjoint from the disc when it is outside.","    var nearX = 0;","    if (dxLow > 0) { nearX = dxLow; } else if (dxHigh < 0) { nearX = dxHigh; }","    var nearY = 0;","    if (dyLow > 0) { nearY = dyLow; } else if (dyHigh < 0) { nearY = dyHigh; }","    if (!isOffsetInDisc(nearX, nearY, cell, radiusSquared)) { continue; }","    let farX = max(abs(dxLow), abs(dxHigh));","    let farY = max(abs(dyLow), abs(dyHigh));","    if (!exact && ya == y0 && yb == y1 && isOffsetInDisc(farX, farY, cell, radiusSquared)) {","      let blockMaximum = pyramid[pyramidOffset + pyramidLevelIndex(level, u32(x0), u32(y0))];","      if (beatsCentre(blockMaximum, ownHeight, hasSmallerIndex)) { return false; }","      continue;","    if (level == 0u) {","      for (var y = ya; y <= yb; y++) {","        for (var x = x0; x <= x1; x++) {","          if (!isOffsetInDisc(x - column, y - row, cell, radiusSquared)) { continue; }","          let pixelIndex = u32(y) * WIDTH + u32(x);","          if (elevationValidity[elevationValidityOffset + pixelIndex] == 0u) {","            if (REJECT_INCOMPLETE) { return false; }","            continue;","          }","          if (beatsCentre(elevationValues[elevationValuesOffset + pixelIndex], ownHeight, hasSmallerIndex)) {","            return false;","    let childSize = i32(pyramidLevelBlockSize(level - 1u));","    for (var child = 0; child < 4; child++) {","      let childColumn = 2 * cellColumn + (child & 1);","      let childRow = 2 * cellRow + (child >> 1);","      if (childColumn * childSize >= i32(WIDTH) || childRow * childSize >= i32(HEIGHT)) { continue; }","      stackLevel[depth] = level - 1u;","      stackColumn[depth] = u32(childColumn);","      stackRow[depth] = u32(childRow);","      depth++;","  return true;","// Returns whether the pixel is a summit and leaves its drop in summitDrop.","fn evaluateSummit(column: i32, row: i32, index: u32) -> bool {","  let cell = getGroundCellSize(u32(row));","  if (!(isFiniteValue(cell.x) && isFiniteValue(cell.y) && cell.x > 0.0 && cell.y > 0.0)) {","    return false;","  let requested = settings[settingsOffset];","  let minimumDrop = settings[settingsOffset + 1u];","  if (!(isFiniteValue(requested) && requested > 0.0)) { return false; }","  if (elevationValidity[elevationValidityOffset + index] == 0u) { return false; }","  let radius = getEffectiveRadius(requested, cell);","  let radiusSquared = radius * radius;","  let centre = vec2<f32>(f32(column), f32(row));","  let ownHeight = elevationValues[elevationValuesOffset + index];","  // Cheap rejection first: almost every pixel has a higher disc pixel among its 8 neighbors, so the","  // search below only runs for 3x3 local maxima. Every rejection here would also be reached by","  // the full search (higher pixel, or an incomplete neighborhood under 'reject'), so results match.","  for (var nearY = -1; nearY <= 1; nearY++) {","    for (var nearX = -1; nearX <= 1; nearX++) {","      let nearPixel = vec2<i32>(column + nearX, row + nearY);","      if ((nearX == 0 && nearY == 0) || !isInDisc(nearPixel, centre, cell, radiusSquared)) { continue; }","      if (nearPixel.x < 0 || nearPixel.y < 0 || nearPixel.x >= i32(WIDTH) || nearPixel.y >= i32(HEIGHT)) { continue; }","      let nearIndex = u32(nearPixel.y) * WIDTH + u32(nearPixel.x);","      if (elevationValidity[elevationValidityOffset + nearIndex] == 0u) { continue; }","      let nearHeight = elevationValues[elevationValuesOffset + nearIndex];","      if (nearHeight > ownHeight || (nearHeight == ownHeight && nearIndex < index)) { return false; }","  let ownRowHalfWidth = getDiscRowHalfWidth(0, cell, radiusSquared);","  let columnHalfHeight = getDiscColumnHalfHeight(cell, radiusSquared);","  // The widest row is dy = 0 and the tallest column is dx = 0, so these decide grid containment.","  if (REJECT_INCOMPLETE &&","      (column - ownRowHalfWidth < 0 || column + ownRowHalfWidth >= i32(WIDTH) ||","       row - columnHalfHeight < 0 || row + columnHalfHeight >= i32(HEIGHT))) {","  // Heights of FLT_MAX collide with the empty/invalid sentinels of block maxima.","  let exact = abs(ownHeight) >= FLOAT_MAXIMUM;","  // Own row: every |dx| <= ownRowHalfWidth is in the disc.","  for (var offsetX = -ownRowHalfWidth; offsetX <= ownRowHalfWidth; offsetX++) {","    let pixelColumn = column + offsetX;","    if (offsetX == 0 || pixelColumn < 0 || pixelColumn >= i32(WIDTH)) { continue; }","    let neighborIndex = index + u32(offsetX) ;","    if (elevationValidity[elevationValidityOffset + neighborIndex] == 0u) {","      if (REJECT_INCOMPLETE) { return false; }","    if (beatsCentre(elevationValues[elevationValuesOffset + neighborIndex], ownHeight, offsetX < 0)) {","      return false;","  let lastRow = i32(HEIGHT) - 1;","  if (!isHalfDiscDominated(column, row, max(row - columnHalfHeight, 0), row - 1, ownHeight, true, exact, cell, radiusSquared) ||","      !isHalfDiscDominated(column, row, row + 1, min(row + columnHalfHeight, lastRow), ownHeight, false, exact, cell, radiusSquared)) {","  var ringHeight = 0.0;","  var hasRing = false;","  var previousHalfWidth = -1;","  var currentHalfWidth = getDiscRowHalfWidth(-columnHalfHeight, cell, radiusSquared);","  for (var offsetY = -columnHalfHeight; offsetY <= columnHalfHeight; offsetY++) {","    var nextHalfWidth = -1;","    if (offsetY < columnHalfHeight) { nextHalfWidth = getDiscRowHalfWidth(offsetY + 1, cell, radiusSquared); }","    let pixelRow = row + offsetY;","    if (pixelRow >= 0 && pixelRow <= lastRow) {","      let interiorHalfWidth = min(previousHalfWidth, min(currentHalfWidth, nextHalfWidth));","      // Interior pixels (all eight neighbors in the disc) have |dx| <= interiorHalfWidth - 1.","      let hasInterior = interiorHalfWidth > 0;","      for (var run = 0; run < 2; run++) {","        if (run == 1 && !hasInterior) { break; }","        var runStart = -currentHalfWidth;","        var runEnd = currentHalfWidth;","        if (hasInterior) {","          if (run == 0) { runEnd = -interiorHalfWidth; } else { runStart = interiorHalfWidth; }","        for (var offsetX = runStart; offsetX <= runEnd; offsetX++) {","          let pixelColumn = column + offsetX;","          if ((offsetX == 0 && offsetY == 0) || pixelColumn < 0 || pixelColumn >= i32(WIDTH)) { continue; }","          let neighborIndex = u32(pixelRow) * WIDTH + u32(pixelColumn);","          if (elevationValidity[elevationValidityOffset + neighborIndex] == 0u) { continue; }","          let neighborHeight = elevationValues[elevationValuesOffset + neighborIndex];","          if (!hasRing || neighborHeight > ringHeight) {","            ringHeight = neighborHeight;","            hasRing = true;","    previousHalfWidth = currentHalfWidth;","    currentHalfWidth = nextHalfWidth;","  if (hasRing) {","    let dropValue = ownHeight - ringHeight;","    if (dropValue < minimumDrop) { return false; }","    summitDrop = dropValue;","  } else {","    summitDrop = getInfinity(index);","  _ = &elevationValues;","  _ = &elevationValidity;","  _ = &settings;","  _ = &pyramid;","  _ = &maskValues;","  _ = &dropValues;","  let column = i32(index % WIDTH);","  let row = i32(index / WIDTH);","  summitDrop = getQuietNaN(index);","  let isSummit = evaluateSummit(column, row, index);","  maskValues[maskValuesOffset + index] = select(0u, 1u, isSummit);","  dropValues[dropValuesOffset + index] = select(getQuietNaN(index), summitDrop, isSummit);"],"strings":["terrain-summits-summits","terrain-summits-pyramid-maximum","buffer","terrain-summits-elevation","logical","read","terrain-summits-elevation-validity","terrain-summits-elevation-values","terrain-summits-pyramid-input","terrain-summits-pyramid-level-0","gpu-terrain-terrain-summits-snapshot-tap","terrain-summits-pyramid-validity","terrain-summits-pyramid-values","GPURasterExtremaPyramid","compute","summitMask","summitsDrop","terrain-summits-pyramid-fused-parameters","terrain-summits-pyramid-levels-5-5","read_write","terrain-summits-pyramid-fused-parameters-upload","terrain-summits-pyramid-levels-1-4","transient","GPUTerrainSummits","imported","summits-parameters","copy","lower-bound","unknown"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","reads","writes","attrs"],[],["id","label","namespace","kind","op","source","workgroupSize","constants","bindings","dispatch","reads","writes","workload","attrs"],["INVOCATION_COUNT","WGSL_KERNEL_DISPATCH_X","WGSL_KERNEL_DISPATCH_Y"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind","o