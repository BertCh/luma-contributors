height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const offsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; offsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const neighborsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; neighbors: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const degreesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; degrees: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const NODE_COUNT: u32 = 1199u;\n</span><span class=\"lens-source-line\" data-line=\"12\">const SLOT_CAPACITY: u32 = 2810u;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"14\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"15\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"16\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"17\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"18\">) {\n</span><span class=\"lens-source-line\" data-line=\"19\">  _ = &amp;offsets;\n</span><span class=\"lens-source-line\" data-line=\"20\">  _ = &amp;neighbors;\n</span><span class=\"lens-source-line\" data-line=\"21\">  _ = &amp;degrees;\n</span><span class=\"lens-source-line\" data-line=\"22\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"23\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"24\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"25\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"26\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"27\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"28\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"29\">    return;\n</span><span class=\"lens-source-line\" data-line=\"30\">  }\n</span><span class=\"lens-source-line\" data-line=\"31\">  let firstSlot = min(offsets[offsetsOffset + index], SLOT_CAPACITY);\n</span><span class=\"lens-source-line\" data-line=\"32\">  let endSlot = min(offsets[offsetsOffset + index + 1u], SLOT_CAPACITY);\n</span><span class=\"lens-source-line\" data-line=\"33\">  var liveCount = 0u;\n</span><span class=\"lens-source-line\" data-line=\"34\">  for (var slot = firstSlot; slot &lt; endSlot; slot++) {\n</span><span class=\"lens-source-line\" data-line=\"35\">    liveCount += select(0u, 1u, neighbors[neighborsOffset + slot] &lt; NODE_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"36\">  }\n</span><span class=\"lens-source-line\" data-line=\"37\">  degrees[degreesOffset + index] = liveCount;\n</span><span class=\"lens-source-line\" data-line=\"38\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>offsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"gpu-network.network-analytics-columns-offsets\">gpu-network.network-analytics-columns-offsets</td><td>read</td><td>u32</td></tr><tr><td>neighbors<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"gpu-network.network-analytics-columns-neighbors\">gpu-network.network-analytics-columns-neighbors</td><td>read</td><td>u32</td></tr><tr><td>degrees<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"degree\">degree</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUNetworkAnalyticsColumns/degree · main · 941d2159</figcaption></figure></section>",
