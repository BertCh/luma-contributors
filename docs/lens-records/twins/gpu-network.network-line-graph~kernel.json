    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>network-line-graph-edge-vectors · 5×1×1 workgroups × 256×1×1 lanes = 1280 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-network-network-line-graph-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect><rect x=\"21\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"1\"></rect><rect x=\"41\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"2\"></rect><rect x=\"61\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"3\"></rect><rect x=\"81\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"4\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-network-network-line-graph-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const offsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; offsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const neighborsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; neighbors: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const nodePositionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; nodePositions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const edgeVectorsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; edgeVectors: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const NODE_COUNT: u32 = 1199u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const EDGE_COUNT: u32 = 2810u;\n</span><span class=\"lens-source-line\" data-line=\"15\">\n</span><span class=\"lens-source-line\" data-line=\"16\">const GEODESIC_PI: f32 = 3.14159265358979;\n</span><span class=\"lens-source-line\" data-line=\"17\">const GEODESIC_DEGREES_TO_RADIANS: f32 = 0.0174532925199433;\n</span><span class=\"lens-source-line\" data-line=\"18\">const GEODESIC_RADIANS_TO_DEGREES: f32 = 57.2957795130823;\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">fn geodesicWrapLongitudeDelta(delta: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"21\">  return delta - 360.0 * round(delta / 360.0);\n</span><span class=\"lens-source-line\" data-line=\"22\">}\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line\" data-line=\"24\">// Subtract near the shared antimeridian before forming the small angular separation.\n</span><span class=\"lens-source-line\" data-line=\"25\">// Wrapping (destination - source) afterward cannot recover bits lost by that large subtraction:\n</span><span class=\"lens-source-line\" data-line=\"26\">// 179.341 -&gt; -179.877 loses about 1.6 meters on the OpenFlights sphere fixture.\n</span><span class=\"lens-source-line\" data-line=\"27\">fn geodesicLongitudeDelta(source: f32, destination: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"28\">  // WGSL permits floating-point reassociation: the two seam-relative subtractions below\n</span><span class=\"lens-source-line\" data-line=\"29\">  // can become (destination - source) - 2 * halfTurn, restoring the cancellation.\n</span><span class=\"lens-source-line\" data-line=\"30\">  // For opposite seam quadrants, every f32 endpoint is exactly a multiple of 2^-17\n</span><span class=\"lens-source-line\" data-line=\"31\">  // degrees (the smallest ulp on [90, 180]). Scale by that power of two and wrap in\n</span><span class=\"lens-source-line\" data-line=\"32\">  // i32: magnitudes stay below 2^26, with no quantization or integer overflow. Only\n</span><span class=\"lens-source-line\" data-line=\"33\">  // the final, small difference is converted back to f32, so reassociation cannot\n</span><span class=\"lens-source-line\" data-line=\"34\">  // reintroduce a large floating-point subtraction.\n</span><span class=\"lens-source-line\" data-line=\"35\">  if (abs(source) &gt; 90.0 &amp;&amp; abs(source) &lt;= 180.0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"36\">      abs(destination) &gt; 90.0 &amp;&amp; abs(destination) &lt;= 180.0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"37\">      ((source &lt; 0.0) != (destination &lt; 0.0))) {\n</span><span class=\"lens-source-line\" data-line=\"38\">    let sourceUnits = i32(source * 131072.0);\n</span><span class=\"lens-source-line\" data-line=\"39\">    let destinationUnits = i32(destination * 131072.0);\n</span><span class=\"lens-source-line\" data-line=\"40\">    let turnUnits = select(-47185920, 47185920, source &gt; 0.0);\n</span><span class=\"lens-source-line\" data-line=\"41\">    return f32(destinationUnits - sourceUnits + turnUnits) * 0.00000762939453125;\n</span><span class=\"lens-source-line\" data-line=\"42\">  }\n</span><span class=\"lens-source-line\" data-line=\"43\">  let halfTurn = 180.0 * round((destination - source) / 360.0);\n</span><span class=\"lens-source-line\" data-line=\"44\">  return (destination - halfTurn) - (source + halfTurn);\n</span><span class=\"lens-source-line\" data-line=\"45\">}\n</span><span class=\"lens-source-line\" data-line=\"46\">\n</span><span class=\"lens-source-line\" data-line=\"47\">// cos(latitude) as sin(colatitude): 90 - |lat| is exact in f32, so the cosine keeps its relative\n</span><span class=\"lens-source-line\" data-line=\"48\">// precision near the poles where cos(lat * pi / 180) would not.\n</span><span class=\"lens-source-line\" data-line=\"49\">fn geodesicCosLatitude(latitudeDegrees: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"50\">  return sin((90.0 - abs(latitudeDegrees)) * GEODESIC_DEGREES_TO_RADIANS);\n</span><span class=\"lens-source-line\" data-line=\"51\">}\n</span><span class=\"lens-source-line\" data-line=\"52\">\n</span><span class=\"lens-source-line\" data-line=\"53\">fn geodesicUnitVector(lngLat: vec2&lt;f32&gt;) -&gt; vec3&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"54\">  let lambda = lngLat.x * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"55\">  let phi = lngLat.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"56\">  let cosPhi = geodesicCosLatitude(lngLat.y);\n</span><span class=\"lens-source-line\" data-line=\"57\">  return vec3&lt;f32&gt;(cosPhi * cos(lambda), cosPhi * sin(lambda), sin(phi));\n</span><span class=\"lens-source-line\" data-line=\"58\">}\n</span><span class=\"lens-source-line\" data-line=\"59\">\n</span><span class=\"lens-source-line\" data-line=\"60\">fn geodesicFromUnitVector(vector: vec3&lt;f32&gt;) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"61\">  let horizontal = sqrt(vector.x * vector.x + vector.y * vector.y);\n</span><span class=\"lens-source-line\" data-line=\"62\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"63\">    atan2(vector.y, vector.x) * GEODESIC_RADIANS_TO_DEGREES,\n</span><span class=\"lens-source-line\" data-line=\"64\">    atan2(vector.z, horizontal) * GEODESIC_RADIANS_TO_DEGREES\n</span><span class=\"lens-source-line\" data-line=\"65\">  );\n</span><span class=\"lens-source-line\" data-line=\"66\">}\n</span><span class=\"lens-source-line\" data-line=\"67\">\n</span><span class=\"lens-source-line\" data-line=\"68\">fn geodesicHaversineTerm(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"69\">  let deltaPhi = (b.y - a.y) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"70\">  let deltaLambda = geodesicLongitudeDelta(a.x, b.x) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"71\">  let sinHalfPhi = sin(0.5 * deltaPhi);\n</span><span class=\"lens-source-line\" data-line=\"72\">  let sinHalfLambda = sin(0.5 * deltaLambda);\n</span><span class=\"lens-source-line\" data-line=\"73\">  let term = sinHalfPhi * sinHalfPhi +\n</span><span class=\"lens-source-line\" data-line=\"74\">    geodesicCosLatitude(a.y) * geodesicCosLatitude(b.y) *\n</span><span class=\"lens-source-line\" data-line=\"75\">    sinHalfLambda * sinHalfLambda;\n</span><span class=\"lens-source-line\" data-line=\"76\">  return clamp(term, 0.0, 1.0);\n</span><span class=\"lens-source-line\" data-line=\"77\">}\n</span><span class=\"lens-source-line\" data-line=\"78\">\n</span><span class=\"lens-source-line\" data-line=\"79\">fn geodesicCentralAngle(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"80\">  // Vincenty&#39;s special case for the sphere: well conditioned from a millimeter to antipodal,\n</span><span class=\"lens-source-line\" data-line=\"81\">  // unlike the haversine form whose sqrt(1 - h) loses precision near antipodes.\n</span><span class=\"lens-source-line\" data-line=\"82\">  let phi1 = a.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"83\">  let phi2 = b.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"84\">  let deltaPhi = (b.y - a.y) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"85\">  let deltaLambda = geodesicLongitudeDelta(a.x, b.x) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"86\">  let sinPhi1 = sin(phi1);\n</span><span class=\"lens-source-line\" data-line=\"87\">  let cosPhi1 = geodesicCosLatitude(a.y);\n</span><span class=\"lens-source-line\" data-line=\"88\">  let cosPhi2 = geodesicCosLatitude(b.y);\n</span><span class=\"lens-source-line\" data-line=\"89\">  let sinHalfLambda = sin(0.5 * deltaLambda);\n</span><span class=\"lens-source-line\" data-line=\"90\">  let halfVersine = 2.0 * sinHalfLambda * sinHalfLambda;\n</span><span class=\"lens-source-line\" data-line=\"91\">  let east = cosPhi2 * sin(deltaLambda);\n</span><span class=\"lens-source-line\" data-line=\"92\">  let north = sin(deltaPhi) + sinPhi1 * cosPhi2 * halfVersine;\n</span><span class=\"lens-source-line\" data-line=\"93\">  let up = sinPhi1 * sin(phi2) + cosPhi1 * cosPhi2 * (1.0 - halfVersine);\n</span><span class=\"lens-source-line\" data-line=\"94\">  return atan2(sqrt(east * east + north * north), up);\n</span><span class=\"lens-source-line\" data-line=\"95\">}\n</span><span class=\"lens-source-line\" data-line=\"96\">\n</span><span class=\"lens-source-line\" data-line=\"97\">fn geodesicInitialBearingDegrees(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"98\">  let phi1 = a.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"99\">  let phi2 = b.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"100\">  let deltaPhi = (b.y - a.y) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"101\">  let deltaLambda = geodesicLongitudeDelta(a.x, b.x) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"102\">  let sinHalfLambda = sin(0.5 * deltaLambda);\n</span><span class=\"lens-source-line\" data-line=\"103\">  let cosPhi2 = geodesicCosLatitude(b.y);\n</span><span class=\"lens-source-line\" data-line=\"104\">  let y = sin(deltaLambda) * cosPhi2;\n</span><span class=\"lens-source-line\" data-line=\"105\">  // cos(phi1) sin(phi2) - sin(phi1) cos(phi2) cos(deltaLambda), without cancellation.\n</span><span class=\"lens-source-line\" data-line=\"106\">  let x = sin(deltaPhi) + 2.0 * sin(phi1) * cosPhi2 * sinHalfLambda * sinHalfLambda;\n</span><span class=\"lens-source-line\" data-line=\"107\">  // Coincident points have no azimuth. Pin the conventional zero bearing instead of\n</span><span class=\"lens-source-line\" data-line=\"108\">  // evaluating atan2(0, 0), whose result is unbounded by WGSL (and can be NaN).\n</span><span class=\"lens-source-line\" data-line=\"109\">  if (x == 0.0 &amp;&amp; y == 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"110\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"111\">  }\n</span><span class=\"lens-source-line\" data-line=\"112\">  return atan2(y, x) * GEODESIC_RADIANS_TO_DEGREES;\n</span><span class=\"lens-source-line\" data-line=\"113\">}\n</span><span class=\"lens-source-line\" data-line=\"114\">\n</span><span class=\"lens-source-line\" data-line=\"115\">fn geodesicDestination(origin: vec2&lt;f32&gt;, bearingDegrees: f32, angle: f32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"116\">  let phi1 = origin.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"117\">  let theta = bearingDegrees * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"118\">  let sinPhi1 = sin(phi1);\n</span><span class=\"lens-source-line\" data-line=\"119\">  let cosPhi1 = geodesicCosLatitude(origin.y);\n</span><span class=\"lens-source-line\" data-line=\"120\">  let sinHalfAngle = sin(0.5 * angle);\n</span><span class=\"lens-source-line\" data-line=\"121\">  // sin(phi2) - sin(phi1), from the half-angle form so short moves keep their precision.\n</span><span class=\"lens-source-line\" data-line=\"122\">  let sinDelta = -2.0 * sinPhi1 * sinHalfAngle * sinHalfAngle + cosPhi1 * sin(angle) * cos(theta);\n</span><span class=\"lens-source-line\" data-line=\"123\">  let sinPhi2 = clamp(sinPhi1 + sinDelta, -1.0, 1.0);\n</span><span class=\"lens-source-line\" data-line=\"124\">  let roughPhi2 = asin(sinPhi2);\n</span><span class=\"lens-source-line\" data-line=\"125\">  // sin(phi2) - sin(phi1) = 2 cos((phi1 + phi2) / 2) sin((phi2 - phi1) / 2); the midpoint cosine\n</span><span class=\"lens-source-line\" data-line=\"126\">  // is insensitive to the rough phi2, so the latitude change is recovered to relative precision.\n</span><span class=\"lens-source-line\" data-line=\"127\">  let midpointCosine = cos(0.5 * (phi1 + roughPhi2));\n</span><span class=\"lens-source-line\" data-line=\"128\">  var deltaPhi = roughPhi2 - phi1;\n</span><span class=\"lens-source-line\" data-line=\"129\">  if (abs(midpointCosine) &gt; 1e-3) {\n</span><span class=\"lens-source-line\" data-line=\"130\">    deltaPhi = 2.0 * asin(clamp(sinDelta / (2.0 * midpointCosine), -1.0, 1.0));\n</span><span class=\"lens-source-line\" data-line=\"131\">  }\n</span><span class=\"lens-source-line\" data-line=\"132\">  let deltaLambda = atan2(\n</span><span class=\"lens-source-line\" data-line=\"133\">    sin(theta) * sin(angle) * cosPhi1,\n</span><span class=\"lens-source-line\" data-line=\"134\">    cos(angle) - sinPhi1 * sinPhi2\n</span><span class=\"lens-source-line\" data-line=\"135\">  );\n</span><span class=\"lens-source-line\" data-line=\"136\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"137\">    origin.x + deltaLambda * GEODESIC_RADIANS_TO_DEGREES,\n</span><span class=\"lens-source-line\" data-line=\"138\">    origin.y + deltaPhi * GEODESIC_RADIANS_TO_DEGREES\n</span><span class=\"lens-source-line\" data-line=\"139\">  );\n</span><span class=\"lens-source-line\" data-line=\"140\">}\n</span><span class=\"lens-source-line\" data-line=\"141\">\n</span><span class=\"lens-source-line\" data-line=\"142\">fn geodesicInterpolate(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;, angle: f32, fraction: f32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"143\">  let unitA = geodesicUnitVector(a);\n</span><span class=\"lens-source-line\" data-line=\"144\">  let unitB = geodesicUnitVector(b);\n</span><span class=\"lens-source-line\" data-line=\"145\">  var vector: vec3&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"146\">  if (angle &lt; 1e-6) {\n</span><span class=\"lens-source-line\" data-line=\"147\">    vector = normalize(mix(unitA, unitB, fraction));\n</span><span class=\"lens-source-line\" data-line=\"148\">  } else {\n</span><span class=\"lens-source-line\" data-line=\"149\">    let sinAngle = sin(angle);\n</span><span class=\"lens-source-line\" data-line=\"150\">    vector = unitA * (sin((1.0 - fraction) * angle) / sinAngle) +\n</span><span class=\"lens-source-line\" data-line=\"151\">      unitB * (sin(fraction * angle) / sinAngle);\n</span><span class=\"lens-source-line\" data-line=\"152\">  }\n</span><span class=\"lens-source-line\" data-line=\"153\">  let lngLat = geodesicFromUnitVector(vector);\n</span><span class=\"lens-source-line\" data-line=\"154\">  // Keep longitudes continuous with the start point (unwrapped across the antimeridian).\n</span><span class=\"lens-source-line\" data-line=\"155\">  return vec2&lt;f32&gt;(a.x + geodesicWrapLongitudeDelta(lngLat.x - a.x), lngLat.y);\n</span><span class=\"lens-source-line\" data-line=\"156\">}\n</span><span class=\"lens-source-line\" data-line=\"157\">\n</span><span class=\"lens-source-line\" data-line=\"158\">fn geodesicSinLatitudeDelta(latitudeDegrees: f32, originLatitudeDegrees: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"159\">  let halfSum = 0.5 * (latitudeDegrees + originLatitudeDegrees) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"160\">  let halfDifference = 0.5 * (latitudeDegrees - originLatitudeDegrees) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"161\">  return 2.0 * cos(halfSum) * sin(halfDifference);\n</span><span class=\"lens-source-line\" data-line=\"162\">}\n</span><span class=\"lens-source-line\" data-line=\"163\">\n</span><span class=\"lens-source-line\" data-line=\"164\">fn geodesicHaversineDistance(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;, radius: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"165\">  return radius * geodesicCentralAngle(a, b);\n</span><span class=\"lens-source-line\" data-line=\"166\">}\n</span><span class=\"lens-source-line\" data-line=\"167\">\n</span><span class=\"lens-source-line\" data-line=\"168\">// Offset of position from origin in the local equirectangular frame at origin, in degrees of\n</span><span class=\"lens-source-line\" data-line=\"169\">// latitude (east offsets scaled by cos(latitude of origin), longitudes wrapped at +-180).\n</span><span class=\"lens-source-line\" data-line=\"170\">fn geodesicLocalOffset(origin: vec2&lt;f32&gt;, position: vec2&lt;f32&gt;) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"171\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"172\">    geodesicLongitudeDelta(origin.x, position.x) * geodesicCosLatitude(origin.y),\n</span><span class=\"lens-source-line\" data-line=\"173\">    position.y - origin.y\n</span><span class=\"lens-source-line\" data-line=\"174\">  );\n</span><span class=\"lens-source-line\" data-line=\"175\">}\n</span><span class=\"lens-source-line\" data-line=\"176\">\n</span><span class=\"lens-source-line\" data-line=\"177\">// Fraction in [0, 1] of the point of segment start-end closest to point, in the local\n</span><span class=\"lens-source-line\" data-line=\"178\">// equirectangular frame at point: exact to first order for segments of road length.\n</span><span class=\"lens-source-line\" data-line=\"179\">fn geodesicSegmentFraction(point: vec2&lt;f32&gt;, start: vec2&lt;f32&gt;, end: vec2&lt;f32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"180\">  // Pin coincident endpoints before projection: contracting a scaled offset subtraction\n</span><span class=\"lens-source-line\" data-line=\"181\">  // into an FMA can leave a nonzero residual even when both endpoints are identical.\n</span><span class=\"lens-source-line\" data-line=\"182\">  if (all(start == end)) {\n</span><span class=\"lens-source-line\" data-line=\"183\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"184\">  }\n</span><span class=\"lens-source-line\" data-line=\"185\">  let startOffset = geodesicLocalOffset(point, start);\n</span><span class=\"lens-source-line\" data-line=\"186\">  let segment = geodesicLocalOffset(point, end) - startOffset;\n</span><span class=\"lens-source-line\" data-line=\"187\">  let denominator = dot(segment, segment);\n</span><span class=\"lens-source-line\" data-line=\"188\">  if (denominator &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"189\">    return clamp(-dot(startOffset, segment) / denominator, 0.0, 1.0);\n</span><span class=\"lens-source-line\" data-line=\"190\">  }\n</span><span class=\"lens-source-line\" data-line=\"191\">  return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"192\">}\n</span><span class=\"lens-source-line\" data-line=\"193\">\n</span><span class=\"lens-source-line\" data-line=\"194\">// Great-circle distance (units of radius) from point to the position at fraction along the\n</span><span class=\"lens-source-line\" data-line=\"195\">// segment, built from coordinate differences so short distances keep their precision near +-180.\n</span><span class=\"lens-source-line\" data-line=\"196\">fn geodesicSegmentDistance(\n</span><span class=\"lens-source-line\" data-line=\"197\">  point: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"198\">  start: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"199\">  end: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"200\">  fraction: f32,\n