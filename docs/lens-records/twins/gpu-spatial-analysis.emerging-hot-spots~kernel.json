    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>emerging-hot-spots-block-sums · 1×1×1 workgroups × 256×1×1 lanes = 256 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-spatial-analysis-emerging-hot-spots-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-spatial-analysis-emerging-hot-spots-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const valuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; values: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const sumPartialsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; sumPartials: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const countPartialsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; countPartials: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">\n</span><span class=\"lens-source-line\" data-line=\"12\">const GRID_WIDTH: u32 = 14u;\n</span><span class=\"lens-source-line\" data-line=\"13\">const GRID_HEIGHT: u32 = 16u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const CELL_COUNT: u32 = 224u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const SLICE_COUNT: u32 = 12u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const BIN_COUNT: u32 = 2688u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const BIN_BLOCK: u32 = 4096u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const MAXIMUM_RADIUS: f32 = 2.0;\n</span><span class=\"lens-source-line\" data-line=\"19\">const SELF_WEIGHT: f32 = 1.0;\n</span><span class=\"lens-source-line\" data-line=\"20\">\n</span><span class=\"lens-source-line\" data-line=\"21\">\n</span><span class=\"lens-source-line\" data-line=\"22\">fn isFiniteFloat(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line\" data-line=\"24\">\n</span><span class=\"lens-source-line\" data-line=\"25\">\n</span><span class=\"lens-source-line\" data-line=\"26\">fn addUint64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"27\">  let low = left.y + right.y;\n</span><span class=\"lens-source-line\" data-line=\"28\">  return vec2&lt;u32&gt;(left.x + right.x + select(0u, 1u, low &lt; left.y), low);\n</span><span class=\"lens-source-line\" data-line=\"29\">}\n</span><span class=\"lens-source-line\" data-line=\"30\">\n</span><span class=\"lens-source-line\" data-line=\"31\">fn subtractUint64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"32\">  return vec2&lt;u32&gt;(left.x - right.x - select(0u, 1u, left.y &lt; right.y), left.y - right.y);\n</span><span class=\"lens-source-line\" data-line=\"33\">}\n</span><span class=\"lens-source-line\" data-line=\"34\">\n</span><span class=\"lens-source-line\" data-line=\"35\">fn negateInt64(value: vec2&lt;u32&gt;) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"36\">  return subtractUint64(vec2&lt;u32&gt;(0u, 0u), value);\n</span><span class=\"lens-source-line\" data-line=\"37\">}\n</span><span class=\"lens-source-line\" data-line=\"38\">\n</span><span class=\"lens-source-line\" data-line=\"39\">fn compareUint64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; i32 {\n</span><span class=\"lens-source-line\" data-line=\"40\">  if (left.x != right.x) {\n</span><span class=\"lens-source-line\" data-line=\"41\">    return select(-1i, 1i, left.x &gt; right.x);\n</span><span class=\"lens-source-line\" data-line=\"42\">  }\n</span><span class=\"lens-source-line\" data-line=\"43\">  if (left.y != right.y) {\n</span><span class=\"lens-source-line\" data-line=\"44\">    return select(-1i, 1i, left.y &gt; right.y);\n</span><span class=\"lens-source-line\" data-line=\"45\">  }\n</span><span class=\"lens-source-line\" data-line=\"46\">  return 0i;\n</span><span class=\"lens-source-line\" data-line=\"47\">}\n</span><span class=\"lens-source-line\" data-line=\"48\">\n</span><span class=\"lens-source-line\" data-line=\"49\">fn isLessUint64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"50\">  return left.x &lt; right.x || (left.x == right.x &amp;&amp; left.y &lt; right.y);\n</span><span class=\"lens-source-line\" data-line=\"51\">}\n</span><span class=\"lens-source-line\" data-line=\"52\">\n</span><span class=\"lens-source-line\" data-line=\"53\">fn isLessOrEqualUint64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"54\">  return left.x &lt; right.x || (left.x == right.x &amp;&amp; left.y &lt;= right.y);\n</span><span class=\"lens-source-line\" data-line=\"55\">}\n</span><span class=\"lens-source-line\" data-line=\"56\">\n</span><span class=\"lens-source-line\" data-line=\"57\">// Signed order: flipping the sign bit of the high words makes them compare as unsigned.\n</span><span class=\"lens-source-line\" data-line=\"58\">fn compareInt64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; i32 {\n</span><span class=\"lens-source-line\" data-line=\"59\">  return compareUint64(vec2&lt;u32&gt;(left.x ^ 0x80000000u, left.y), vec2&lt;u32&gt;(right.x ^ 0x80000000u, right.y));\n</span><span class=\"lens-source-line\" data-line=\"60\">}\n</span><span class=\"lens-source-line\" data-line=\"61\">\n</span><span class=\"lens-source-line\" data-line=\"62\">fn shiftLeftUint64(value: vec2&lt;u32&gt;, bits: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"63\">  if (bits == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"64\">    return value;\n</span><span class=\"lens-source-line\" data-line=\"65\">  }\n</span><span class=\"lens-source-line\" data-line=\"66\">  if (bits &gt;= 64u) {\n</span><span class=\"lens-source-line\" data-line=\"67\">    return vec2&lt;u32&gt;(0u, 0u);\n</span><span class=\"lens-source-line\" data-line=\"68\">  }\n</span><span class=\"lens-source-line\" data-line=\"69\">  if (bits &gt;= 32u) {\n</span><span class=\"lens-source-line\" data-line=\"70\">    return vec2&lt;u32&gt;(value.y &lt;&lt; (bits - 32u), 0u);\n</span><span class=\"lens-source-line\" data-line=\"71\">  }\n</span><span class=\"lens-source-line\" data-line=\"72\">  return vec2&lt;u32&gt;((value.x &lt;&lt; bits) | (value.y &gt;&gt; (32u - bits)), value.y &lt;&lt; bits);\n</span><span class=\"lens-source-line\" data-line=\"73\">}\n</span><span class=\"lens-source-line\" data-line=\"74\">\n</span><span class=\"lens-source-line\" data-line=\"75\">fn shiftRightUint64(value: vec2&lt;u32&gt;, bits: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"76\">  if (bits == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"77\">    return value;\n</span><span class=\"lens-source-line\" data-line=\"78\">  }\n</span><span class=\"lens-source-line\" data-line=\"79\">  if (bits &gt;= 64u) {\n</span><span class=\"lens-source-line\" data-line=\"80\">    return vec2&lt;u32&gt;(0u, 0u);\n</span><span class=\"lens-source-line\" data-line=\"81\">  }\n</span><span class=\"lens-source-line\" data-line=\"82\">  if (bits &gt;= 32u) {\n</span><span class=\"lens-source-line\" data-line=\"83\">    return vec2&lt;u32&gt;(0u, value.x &gt;&gt; (bits - 32u));\n</span><span class=\"lens-source-line\" data-line=\"84\">  }\n</span><span class=\"lens-source-line\" data-line=\"85\">  return vec2&lt;u32&gt;(value.x &gt;&gt; bits, (value.y &gt;&gt; bits) | (value.x &lt;&lt; (32u - bits)));\n</span><span class=\"lens-source-line\" data-line=\"86\">}\n</span><span class=\"lens-source-line\" data-line=\"87\">\n</span><span class=\"lens-source-line\" data-line=\"88\">// Exact 32 x 32 -&gt; 64 bit product from 16-bit limbs; no partial sum exceeds 2^32.\n</span><span class=\"lens-source-line\" data-line=\"89\">fn multiplyUint32Wide(left: u32, right: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"90\">  let leftLow = left &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"91\">  let leftHigh = left &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"92\">  let rightLow = right &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"93\">  let rightHigh = right &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"94\">  let lowLow = leftLow * rightLow;\n</span><span class=\"lens-source-line\" data-line=\"95\">  let lowHigh = leftLow * rightHigh;\n</span><span class=\"lens-source-line\" data-line=\"96\">  let highLow = leftHigh * rightLow;\n</span><span class=\"lens-source-line\" data-line=\"97\">  let middle = (lowLow &gt;&gt; 16u) + (lowHigh &amp; 0xffffu) + (highLow &amp; 0xffffu);\n</span><span class=\"lens-source-line\" data-line=\"98\">  return vec2&lt;u32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"99\">    leftHigh * rightHigh + (lowHigh &gt;&gt; 16u) + (highLow &gt;&gt; 16u) + (middle &gt;&gt; 16u),\n</span><span class=\"lens-source-line\" data-line=\"100\">    (lowLow &amp; 0xffffu) | (middle &lt;&lt; 16u)\n</span><span class=\"lens-source-line\" data-line=\"101\">  );\n</span><span class=\"lens-source-line\" data-line=\"102\">}\n</span><span class=\"lens-source-line\" data-line=\"103\">\n</span><span class=\"lens-source-line\" data-line=\"104\">fn multiplyUint64ByUint32(left: vec2&lt;u32&gt;, right: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"105\">  let wide = multiplyUint32Wide(left.y, right);\n</span><span class=\"lens-source-line\" data-line=\"106\">  return vec2&lt;u32&gt;(wide.x + left.x * right, wide.y);\n</span><span class=\"lens-source-line\" data-line=\"107\">}\n</span><span class=\"lens-source-line\" data-line=\"108\">\n</span><span class=\"lens-source-line\" data-line=\"109\">fn multiplyUint64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"110\">  let wide = multiplyUint32Wide(left.y, right.y);\n</span><span class=\"lens-source-line\" data-line=\"111\">  return vec2&lt;u32&gt;(wide.x + left.y * right.x + left.x * right.y, wide.y);\n</span><span class=\"lens-source-line\" data-line=\"112\">}\n</span><span class=\"lens-source-line\" data-line=\"113\">\n</span><span class=\"lens-source-line\" data-line=\"114\">struct Uint64Division {\n</span><span class=\"lens-source-line\" data-line=\"115\">  quotient: vec2&lt;u32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"116\">  remainder: u32,\n</span><span class=\"lens-source-line\" data-line=\"117\">}\n</span><span class=\"lens-source-line\" data-line=\"118\">\n</span><span class=\"lens-source-line\" data-line=\"119\">// Restoring division one bit at a time. The running remainder stays below the divisor, so after a\n</span><span class=\"lens-source-line\" data-line=\"120\">// shift it is below 2^33; the bit shifted out of the u32 is carried in overflowBit.\n</span><span class=\"lens-source-line\" data-line=\"121\">fn divideUint64ByUint32(value: vec2&lt;u32&gt;, divisor: u32) -&gt; Uint64Division {\n</span><span class=\"lens-source-line\" data-line=\"122\">  if (divisor == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"123\">    return Uint64Division(vec2&lt;u32&gt;(0xffffffffu, 0xffffffffu), 0u);\n</span><span class=\"lens-source-line\" data-line=\"124\">  }\n</span><span class=\"lens-source-line\" data-line=\"125\">  var quotient = vec2&lt;u32&gt;(0u, 0u);\n</span><span class=\"lens-source-line\" data-line=\"126\">  var remainder = 0u;\n</span><span class=\"lens-source-line\" data-line=\"127\">  for (var bit = 0u; bit &lt; 64u; bit++) {\n</span><span class=\"lens-source-line\" data-line=\"128\">    let position = 63u - bit;\n</span><span class=\"lens-source-line\" data-line=\"129\">    let word = select(value.y, value.x, position &gt;= 32u);\n</span><span class=\"lens-source-line\" data-line=\"130\">    let incoming = (word &gt;&gt; (position &amp; 31u)) &amp; 1u;\n</span><span class=\"lens-source-line\" data-line=\"131\">    let overflowBit = remainder &gt;&gt; 31u;\n</span><span class=\"lens-source-line\" data-line=\"132\">    remainder = (remainder &lt;&lt; 1u) | incoming;\n</span><span class=\"lens-source-line\" data-line=\"133\">    if (overflowBit != 0u || remainder &gt;= divisor) {\n</span><span class=\"lens-source-line\" data-line=\"134\">      remainder = remainder - divisor;\n</span><span class=\"lens-source-line\" data-line=\"135\">      if (position &gt;= 32u) {\n</span><span class=\"lens-source-line\" data-line=\"136\">        quotient.x = quotient.x | (1u &lt;&lt; (position - 32u));\n</span><span class=\"lens-source-line\" data-line=\"137\">      } else {\n</span><span class=\"lens-source-line\" data-line=\"138\">        quotient.y = quotient.y | (1u &lt;&lt; position);\n</span><span class=\"lens-source-line\" data-line=\"139\">      }\n</span><span class=\"lens-source-line\" data-line=\"140\">    }\n</span><span class=\"lens-source-line\" data-line=\"141\">  }\n</span><span class=\"lens-source-line\" data-line=\"142\">  return Uint64Division(quotient, remainder);\n</span><span class=\"lens-source-line\" data-line=\"143\">}\n</span><span class=\"lens-source-line\" data-line=\"144\">\n</span><span class=\"lens-source-line\" data-line=\"145\">fn uint64ToFloat(value: vec2&lt;u32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"146\">  return f32(value.x) * 4294967296.0 + f32(value.y);\n</span><span class=\"lens-source-line\" data-line=\"147\">}\n</span><span class=\"lens-source-line\" data-line=\"148\">\n</span><span class=\"lens-source-line\" data-line=\"149\">fn int64ToFloat(value: vec2&lt;u32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"150\">  if ((value.x &amp; 0x80000000u) != 0u) {\n</span><span class=\"lens-source-line\" data-line=\"151\">    return -uint64ToFloat(negateInt64(value));\n</span><span class=\"lens-source-line\" data-line=\"152\">  }\n</span><span class=\"lens-source-line\" data-line=\"153\">  return uint64ToFloat(value);\n</span><span class=\"lens-source-line\" data-line=\"154\">}\n</span><span class=\"lens-source-line\" data-line=\"155\">\n</span><span class=\"lens-source-line\" data-line=\"156\">\n</span><span class=\"lens-source-line\" data-line=\"157\">fn roundSpatialCountValue(magnitude: vec2&lt;u32&gt;, exponentScale: i32, negative: u32, sticky: bool) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"158\">  let bitLength = select(32u - countLeadingZeros(magnitude.y), 64u - countLeadingZeros(magnitude.x), magnitude.x != 0u);\n</span><span class=\"lens-source-line\" data-line=\"159\">  if (bitLength == 0u) { return bitcast&lt;f32&gt;(negative); }\n</span><span class=\"lens-source-line\" data-line=\"160\">  let subnormal = exponentScale + i32(bitLength) - 1i &lt; -126i;\n</span><span class=\"lens-source-line\" data-line=\"161\">  let shift = select(i32(bitLength) - 24i, -149i - exponentScale, subnormal);\n</span><span class=\"lens-source-line\" data-line=\"162\">  if (shift &gt;= 64i) { return bitcast&lt;f32&gt;(negative); }\n</span><span class=\"lens-source-line\" data-line=\"163\">  var rounded = 0u;\n</span><span class=\"lens-source-line\" data-line=\"164\">  if (shift &lt;= 0i) {\n</span><span class=\"lens-source-line\" data-line=\"165\">    rounded = shiftLeftUint64(magnitude, u32(-shift)).y;\n</span><span class=\"lens-source-line\" data-line=\"166\">  } else {\n</span><span class=\"lens-source-line\" data-line=\"167\">    let quotient = shiftRightUint64(magnitude, u32(shift));\n</span><span class=\"lens-source-line\" data-line=\"168\">    let discarded = subtractUint64(magnitude, shiftLeftUint64(quotient, u32(shift)));