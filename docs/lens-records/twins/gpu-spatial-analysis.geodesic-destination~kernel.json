x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><rect x=\"402\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 10</title></rect><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><rect x=\"442\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 11</title></rect><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><rect x=\"482\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 12</title></rect><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><rect x=\"522\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 13</title></rect><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><rect x=\"562\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 14</title></rect><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"15\"><rect x=\"602\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 15</title></rect><text x=\"605\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">15</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"16\"><rect x=\"642\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 16</title></rect><text x=\"645\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">16</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"17\"><rect x=\"682\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 17</title></rect><text x=\"685\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">17</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"18\"><rect x=\"722\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 18</title></rect><text x=\"725\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">18</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"19\"><rect x=\"762\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 19</title></rect><text x=\"765\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">19</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"20\"><rect x=\"802\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 20</title></rect><text x=\"805\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">20</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"21\"><rect x=\"842\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 21</title></rect><text x=\"845\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">21</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"22\"><rect x=\"882\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 22</title></rect><text x=\"885\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">22</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"23\"><rect x=\"922\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 23</title></rect><text x=\"925\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">23</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"24\"><rect x=\"962\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-geodesic-destination-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"965\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">24</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"25\"><rect x=\"1002\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-geodesic-destination-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1005\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">25</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"26\"><rect x=\"1042\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-geodesic-destination-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1045\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">26</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"27\"><rect x=\"1082\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-geodesic-destination-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1085\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">27</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"28\"><rect x=\"1122\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-geodesic-destination-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">28</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"29\"><rect x=\"1162\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-geodesic-destination-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">29</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"30\"><rect x=\"1202\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-geodesic-destination-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">30</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"31\"><rect x=\"1242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-geodesic-destination-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">31</text></g></svg><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const originsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; origins: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const bearingsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; bearings: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const distancesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; distances: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const destinationsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; destinations: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const finalBearingsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; finalBearings: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const convergedOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; converged: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line\" data-line=\"19\">fn geodesicAtan2(y: f32, x: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"20\">  return select(atan2(y, x), sign(y) * 1.5707963267948966, x == 0.0);\n</span><span class=\"lens-source-line\" data-line=\"21\">}\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">const GEODESIC_PI: f32 = 3.14159265358979;\n</span><span class=\"lens-source-line\" data-line=\"24\">// Component reconstruction avoids polar and long-path cancellation; these boundaries\n</span><span class=\"lens-source-line\" data-line=\"25\">// retain the established short-path arithmetic and are covered by the PROJ regressions.\n</span><span class=\"lens-source-line\" data-line=\"26\">const GEODESIC_DIRECT_COMPONENT_ANGLE: f32 = 0.25 * GEODESIC_PI;\n</span><span class=\"lens-source-line\" data-line=\"27\">const GEODESIC_DIRECT_POLAR_LATITUDE: f32 = 80.0;\n</span><span class=\"lens-source-line\" data-line=\"28\">const GEODESIC_DIRECT_POLAR_SINE: f32 = 0.984807753012208; // sin(80 degrees)\n</span><span class=\"lens-source-line\" data-line=\"29\">const GEODESIC_DEGREES_TO_RADIANS: f32 = 0.0174532925199433;\n</span><span class=\"lens-source-line\" data-line=\"30\">const GEODESIC_RADIANS_TO_DEGREES: f32 = 57.2957795130823;\n</span><span class=\"lens-source-line\" data-line=\"31\">// Haversine terms remain well conditioned below a 90-degree separation. Compare local snap\n</span><span class=\"lens-source-line\" data-line=\"32\">// candidates in that common representation, before asin/atan2 rounding can reverse a near tie.\n</span><span class=\"lens-source-line\" data-line=\"33\">const GEODESIC_LOCAL_COMPARISON_MAXIMUM_TERM: f32 = 0.5;\n</span><span class=\"lens-source-line\" data-line=\"34\">\n</span><span class=\"lens-source-line\" data-line=\"35\">fn geodesicWrapLongitudeDelta(delta: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"36\">  return delta - 360.0 * round(delta / 360.0);\n</span><span class=\"lens-source-line\" data-line=\"37\">}\n</span><span class=\"lens-source-line\" data-line=\"38\">\n</span><span class=\"lens-source-line\" data-line=\"39\">// Subtract near the shared antimeridian before forming the small angular separation.\n</span><span class=\"lens-source-line\" data-line=\"40\">// Wrapping (destination - source) afterward cannot recover bits lost by that large subtraction:\n</span><span class=\"lens-source-line\" data-line=\"41\">// 179.341 -&gt; -179.877 loses about 1.6 meters on the OpenFlights sphere fixture.\n</span><span class=\"lens-source-line\" data-line=\"42\">fn geodesicLongitudeDelta(source: f32, destination: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"43\">  // WGSL permits floating-point reassociation: the two seam-relative subtractions below\n</span><span class=\"lens-source-line\" data-line=\"44\">  // can become (destination - source) - 2 * halfTurn, restoring the cancellation.\n</span><span class=\"lens-source-line\" data-line=\"45\">  // For opposite seam quadrants, every f32 endpoint is exactly a multiple of 2^-17\n</span><span class=\"lens-source-line\" data-line=\"46\">  // degrees (the smallest ulp on [90, 180]). Scale by that power of two and wrap in\n</span><span class=\"lens-source-line\" data-line=\"47\">  // i32: magnitudes stay below 2^26, with no quantization or integer overflow. Only\n</span><span class=\"lens-source-line\" data-line=\"48\">  // the final, small difference is converted back to f32, so reassociation cannot\n</span><span class=\"lens-source-line\" data-line=\"49\">  // reintroduce a large floating-point subtraction.\n</span><span class=\"lens-source-line\" data-line=\"50\">  if (abs(source) &gt; 90.0 &amp;&amp; abs(source) &lt;= 180.0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"51\">      abs(destination) &gt; 90.0 &amp;&amp; abs(destination) &lt;= 180.0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"52\">      ((source &lt; 0.0) != (destination &lt; 0.0))) {\n</span><span class=\"lens-source-line\" data-line=\"53\">    let sourceUnits = i32(source * 131072.0);\n</span><span class=\"lens-source-line\" data-line=\"54\">    let destinationUnits = i32(destination * 131072.0);\n</span><span class=\"lens-source-line\" data-line=\"55\">    let turnUnits = select(-47185920, 47185920, source &gt; 0.0);\n</span><span class=\"lens-source-line\" data-line=\"56\">    return f32(destinationUnits - sourceUnits + turnUnits) * 0.00000762939453125;\n</span><span class=\"lens-source-line\" data-line=\"57\">  }\n</span><span class=\"lens-source-line\" data-line=\"58\">  let halfTurn = 180.0 * round((destination - source) / 360.0);\n</span><span class=\"lens-source-line\" data-line=\"59\">  return (destination - halfTurn) - (source + halfTurn);\n</span><span class=\"lens-source-line\" data-line=\"60\">}\n</span><span class=\"lens-source-line\" data-line=\"61\">\n</span><span class=\"lens-source-line\" data-line=\"62\">// cos(latitude) as sin(colatitude): 90 - |lat| is exact in f32, so the cosine keeps its relative\n</span><span class=\"lens-source-line\" data-line=\"63\">// precision near the poles where cos(lat * pi / 180) would not.\n</span><span class=\"lens-source-line\" data-line=\"64\">fn geodesicCosLatitude(latitudeDegrees: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"65\">  return sin((90.0 - abs(latitudeDegrees)) * GEODESIC_DEGREES_TO_RADIANS);\n</span><span class=\"lens-source-line\" data-line=\"66\">}\n</span><span class=\"lens-source-line\" data-line=\"67\">\n</span><span class=\"lens-source-line\" data-line=\"68\">fn geodesicUnitVector(lngLat: vec2&lt;f32&gt;) -&gt; vec3&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"69\">  let lambda = lngLat.x * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"70\">  let phi = lngLat.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"71\">  let cosPhi = geodesicCosLatitude(lngLat.y);\n</span><span class=\"lens-source-line\" data-line=\"72\">  return vec3&lt;f32&gt;(cosPhi * cos(lambda), cosPhi * sin(lambda), sin(phi));\n</span><span class=\"lens-source-line\" data-line=\"73\">}\n</span><span class=\"lens-source-line\" data-line=\"74\">\n</span><span class=\"lens-source-line\" data-line=\"75\">fn geodesicFromUnitVector(vector: vec3&lt;f32&gt;) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"76\">  let horizontal = sqrt(vector.x * vector.x + vector.y * vector.y);\n</span><span class=\"lens-source-line\" data-line=\"77\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"78\">    geodesicAtan2(vector.y, vector.x) * GEODESIC_RADIANS_TO_DEGREES,\n</span><span class=\"lens-source-line\" data-line=\"79\">    geodesicAtan2(vector.z, horizontal) * GEODESIC_RADIANS_TO_DEGREES\n</span><span class=\"lens-source-line\" data-line=\"80\">  );\n</span><span class=\"lens-source-line\" data-line=\"81\">}\n</span><span class=\"lens-source-line\" data-line=\"82\">\n</span><span class=\"lens-source-line\" data-line=\"83\">fn geodesicHaversineTerm(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"84\">  let deltaPhi = (b.y - a.y) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"85\">  let deltaLambda = geodesicLongitudeDelta(a.x, b.x) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"86\">  let sinHalfPhi = sin(0.5 * deltaPhi);\n</span><span class=\"lens-source-line\" data-line=\"87\">  let sinHalfLambda = sin(0.5 * deltaLambda);\n</span><span class=\"lens-source-line\" data-line=\"88\">  let term = sinHalfPhi * sinHalfPhi +\n</span><span class=\"lens-source-line\" data-line=\"89\">    geodesicCosLatitude(a.y) * geodesicCosLatitude(b.y) *\n</span><span class=\"lens-source-line\" data-line=\"90\">    sinHalfLambda * sinHalfLambda;\n</span><span class=\"lens-source-line\" data-line=\"91\">  return clamp(term, 0.0, 1.0);\n</span><span class=\"lens-source-line\" data-line=\"92\">}\n</span><span class=\"lens-source-line\" data-line=\"93\">\n</span><span class=\"lens-source-line\" data-line=\"94\">// East, north and up components of b in the local frame at a. Near an antipode,\n</span><span class=\"lens-source-line\" data-line=\"95\">// use the latitude sum and longitude supplement to avoid subtracting order-one terms.\n</span><span class=\"lens-source-line\" data-line=\"96\">fn geodesicBearingComponents(origin: vec2&lt;f32&gt;, targetPosition: vec2&lt;f32&gt;) -&gt; vec3&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"97\">  if (origin.y == targetPosition.y &amp;&amp; (geodesicLongitudeDelta(origin.x, targetPosition.x) == 0.0 || abs(origin.y) == 90.0)) {\n</span><span class=\"lens-source-line\" data-line=\"98\">    return vec3&lt;f32&gt;(0.0, 0.0, 1.0);\n</span><span class=\"lens-source-line\" data-line=\"99\">  }\n</span><span class=\"lens-source-line\" data-line=\"100\">  let latitudeRadians = origin.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"101\">  let targetLatitudeRadians = targetPosition.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"102\">  let longitudeDeltaDegrees = geodesicLongitudeDelta(origin.x, targetPosition.x);\n</span><span class=\"lens-source-line\" data-line=\"103\">  let longitudeDeltaRadians = longitudeDeltaDegrees * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"104\">  let originCosine = geodesicCosLatitude(origin.y);\n</span><span class=\"lens-source-line\" data-line=\"105\">  let targetCosine = geodesicCosLatitude(targetPosition.y);\n</span><span class=\"lens-source-line\" data-line=\"106\">  let halfSineLongitude = sin(0.5 * longitudeDeltaRadians);\n</span><span class=\"lens-source-line\" data-line=\"107\">  let halfVersine = 2.0 * halfSineLongitude * halfSineLongitude;\n</span><span class=\"lens-source-line\" data-line=\"108\">  var east = targetCosine * sin(longitudeDeltaRadians);\n</span><span class=\"lens-source-line\" data-line=\"109\">  var north = sin((targetPosition.y - origin.y) * GEODESIC_DEGREES_TO_RADIANS) +\n</span><span class=\"lens-source-line\" data-line=\"110\">    sin(latitudeRadians) * targetCosine * halfVersine;\n</span><span class=\"lens-source-line\" data-line=\"111\">  var longitudeCosine = 1.0 - halfVersine;\n</span><span class=\"lens-source-line\" data-line=\"112\">  // A small longitude supplement does not imply a near antipode: two points at\n</span><span class=\"lens-source-line\" data-line=\"113\">  // the same pole can have opposite longitudes. Their latitude sum is near 180\n</span><span class=\"lens-source-line\" data-line=\"114\">  // degrees, where taking its sine loses the colatitude&#39;s relative precision.\n</span><span class=\"lens-source-line\" data-line=\"115\">  if (abs(longitudeDeltaDegrees) &gt; 90.0 &amp;&amp; origin.y * targetPosition.y &lt;= 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"116\">    let supplement = (180.0 - abs(longitudeDeltaDegrees)) * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"117\">    let halfSine = sin(0.5 * supplement);\n</span><span class=\"lens-source-line\" data-line=\"118\">    east = targetCosine * sign(longitudeDeltaDegrees) * sin(supplement);\n</span><span class=\"lens-source-line\" data-line=\"119\">    north = sin((origin.y + targetPosition.y) * GEODESIC_DEGREES_TO_RADIANS) -\n</span><span class=\"lens-source-line\" data-line=\"120\">      2.0 * sin(latitudeRadians) * targetCosine * halfSine * halfSine;\n</span><span class=\"lens-source-line\" data-line=\"121\">    longitudeCosine = 2.0 * halfSine * halfSine - 1.0;\n</span><span class=\"lens-source-line\" data-line=\"122\">  }\n</span><span class=\"lens-source-line\" data-line=\"123\">  let vertical = sin(latitudeRadians) * sin(targetLatitudeRadians) + originCosine * targetCosine * longitudeCosine;\n</span><span class=\"lens-source-line\" data-line=\"124\">  return vec3&lt;f32&gt;(east, north, vertical);\n</span><span class=\"lens-source-line\" data-line=\"125\">}\n</span><span class=\"lens-source-line\" data-line=\"126\">\n</span><span class=\"lens-source-line\" data-line=\"127\">fn geodesicCentralAngle(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"128\">  let components = geodesicBearingComponents(a, b);\n</span><span class=\"lens-source-line\" data-line=\"129\">  return geodesicAtan2(sqrt(components.x * components.x + components.y * components.y), components.z);\n</span><span class=\"lens-source-line\" data-line=\"130\">}\n</span><span class=\"lens-source-line\" data-line=\"131\">\n</span><span class=\"lens-source-line\" data-line=\"132\">fn geodesicInitialBearingDegrees(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"133\">  let components = geodesicBearingComponents(a, b);\n</span><span class=\"lens-source-line\" data-line=\"134\">  return geodesicAtan2(components.x, components.y) * GEODESIC_RADIANS_TO_DEGREES;\n</span><span class=\"lens-source-line\" data-line=\"135\">}\n</span><span class=\"lens-source-line\" data-line=\"136\">\n</span><span class=\"lens-source-line\" data-line=\"137\">fn geodesicDestination(origin: vec2&lt;f32&gt;, bearingDegrees: f32, angle: f32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"138\">  if (angle == 0.0) { return origin; }\n</span><span class=\"lens-source-line\" data-line=\"139\">  let phi1 = origin.y * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"140\">  let theta = bearingDegrees * GEODESIC_DEGREES_TO_RADIANS;\n</span><span class=\"lens-source-line\" data-line=\"141\">  let sinPhi1 = sin(phi1);\n</span><span class=\"lens-source-line\" data-line=\"142\">  let cosPhi1 = geodesicCosLatitude(origin.y);\n</span><span class=\"lens-source-line\" data-line=\"143\">  let sinHalfAngle = sin(0.5 * angle);\n</span><span class=\"lens-source-line\" data-line=\"144\">  // sin(phi2) - sin(phi1), from the half-angle form so short moves keep their precision.\n</span><span class=\"lens-source-line\" data-line=\"145\">  let sinDelta = -2.0 * sinPhi1 * sinHalfAngle * sinHalfAngle + cosPhi1 * sin(angle) * cos(theta);\n</span><span class=\"lens-source-line\" data-line=\"146\">  let sinPhi2 = clamp(sinPhi1 + sinDelta, -1.0, 1.0);\n</span><span class=\"lens-source-line\" data-line=\"147\">  // The half-angle change below preserves ordinary short moves. At a polar\n</span><span class=\"lens-source-line\" data-line=\"148\">  // origin or arrival (within 10 degrees of a pole), use components instead of asin.\n</span><span class=\"lens-source-line\" data-line=\"149\">  // Long paths also cancel in sinPhi1 + sinDelta and in the longitude denominator.\n</span><span class=\"lens-source-line\" data-line=\"150\">  // Preserve the established half-angle change only for short ordinary paths.\n</span><span class=\"lens-source-line\" data-line=\"151\">  if (abs(angle) &gt;= GEODESIC_DIRECT_COMPONENT_ANGLE || abs(origin.y) &gt;= GEODESIC_DIRECT_POLAR_LATITUDE || abs(sinPhi2) &gt;= GEODESIC_DIRECT_POLAR_SINE) {\n</span><span class=\"lens-source-line\" data-line=\"152\">    let east = sin(theta) * sin(angle);\n</span><span class=\"lens-source-line\" data-line=\"153\">    let north = cosPhi1 * cos(angle) - sinPhi1 * sin(angle) * cos(theta);\n</span><span class=\"lens-source-line\" data-line=\"154\">    let vertical = sinPhi1 * cos(angle) + cosPhi1 * sin(angle) * cos(theta);\n</span><span class=\"lens-source-line\" data-line=\"155\">    let horizontal = sqrt(east * east + north * north);\n</span><span class=\"lens-source-line\" data-line=\"156\">    // Above 45 degrees, recover the latitude from the colatitude: atan2(vertical, horizontal)\n</span><span class=\"lens-source-line\" data-line=\"157\">    // returns a value near pi/2 whose absolute error (about a meter in f32) would swamp short\n</span><span class=\"lens-source-line\" data-line=\"158\">    // polar moves, while the colatitude keeps the horizontal component&#39;s relative precision.\n</span><span class=\"lens-source-line\" data-line=\"159\">    var latitudeDegrees = geodesicAtan2(vertical, horizontal) * GEODESIC_RADIANS_TO_DEGREES;\n</span><span class=\"lens-source-line\" data-line=\"160\">    if (abs(vertical) &gt; horizontal) {\n</span><span class=\"lens-source-line\" data-line=\"161\">      latitudeDegrees = sign(vertical) * (90.0 - geodesicAtan2(horizontal, abs(vertical)) * GEODESIC_RADIANS_TO_DEGREES);\n</span><span class=\"lens-source-line\" data-line=\"162\">    }\n</span><span class=\"lens-source-line\" data-line=\"163\">    // A short move from a polar origin still takes the half-angle latitude change, added in\n</span><span class=\"lens-source-line\" data-line=\"164\">    // degrees: converting a polar latitude to f32 radians alone costs about 0.4 m, which the\n</span><span class=\"lens-source-line\" data-line=\"165\">    // component form inherits. The midpoint cosine guard hands the last 0.06 degrees to the\n</span><span class=\"lens-source-line\" data-line=\"166\">    // colatitude.\n</span><span class=\"lens-source-line\" data-line=\"167\">    if (abs(angle) &lt; GEODESIC_DIRECT_COMPONENT_ANGLE) {\n</span><span class=\"lens-source-line\" data-line=\"168\">      let midpointCosine = cos(0.5 * (phi1 + asin(sinPhi2)));\n</span><span class=\"lens-source-line\" data-line=\"169\">      if (abs(midpointCosine) &gt; 1e-3) {\n</span><span class=\"lens-source-line\" data-line=\"170\">        latitudeDegrees = origin.y + 2.0 * asin(clamp(sinDelta / (2.0 * midpointCosine), -1.0, 1.0)) * GEODESIC_RADIANS_TO_DEGREES;\n</span><span class=\"lens-source-line\" data-line=\"171\">      }\n</span><span class=\"lens-source-line\" data-line=\"172\">    }\n</span><span class=\"lens-source-line\" data-line=\"173\">    return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"174\">      origin.x + geodesicAtan2(east, north) * GEODESIC_RADIANS_TO_DEGREES,\n</span><span class=\"lens-source-line\" data-line=\"175\">      latitudeDegrees\n</span><span class=\"lens-source-line\" data-line=\"176\">    );\n</span><span class=\"lens-source-line\" data-line=\"177\">  }\n</span><span class=\"lens-source-line\" data-line=\"178\">  let roughPhi2 = asin(sinPhi2);\n</span><span class=\"lens-source-line\" data-line=\"179\">  // sin(phi2) - sin(phi1) = 2 cos((phi1 + phi2) / 2) sin((phi2 - phi1) / 2); the midpoint cosine\n</span><span class=\"lens-source-line\" data-line=\"180\">  // is insensitive to the rough phi2, so the latitude change is recovered to relative precision.\n</span><span class=\"lens-source-line\" data-line=\"181\">  let midpointCosine = cos(0.5 * (phi1 + roughPhi2));\n</span><span class=\"lens-source-line\" data-line=\"182\">  var deltaPhi = roughPhi2 - phi1;\n</span><span class=\"lens-source-line\" data-line=\"183\">  if (abs(midpointCosine) &gt; 1e-3) {\n</span><span class=\"lens-source-line\" data-line=\"184\">    deltaPhi = 2.0 * asin(clamp(sinDelta / (2.0 * midpointCosine), -1.0, 1.0));\n</span><span class=\"lens-source-line\" data-line=\"185\">  }\n</span><span class=\"lens-source-line\" data-line=\"186\">  let deltaLambda = geodesicAtan2(\n</span><span class=\"lens-source-line\" data-line=\"187\">    sin(theta) * sin(angle) * cosPhi1,\n</span><span class=\"lens-source-line\" data-line=\"188\">    cos(angle) - sinPhi1 * sinPhi2\n</span><span class=\"lens-source-line\" data-line=\"189\">  );\n</span><span class=\"lens-source-line\" data-line=\"190\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"191\">    origin.x + deltaLambda * GEODESIC_RADIANS_TO_DEGREES,\n</span><span class=\"lens-source-line\" data-line=\"192\">    origin.y + deltaPhi * GEODESIC_RADIANS_TO_DEGREES\n</span><span class=\"lens-source-line\" data-line=\"193\">  );\n</span><span class=\"lens-source-line\" data-line=\"194\">}\n</span><span class=\"lens-source-line\" data-line=\"195\">\n</span><span class=\"lens-source-line\" data-line=\"196\">fn geodesicInterpolate(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;, angle: f32, fraction: f32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"197\">  // Endpoints are known even when the interior path is nonunique or ill-conditioned.\n</span><span class=\"lens-source-line\" data-line=\"198\">  if (fraction == 0.0) { return a; }\n</span><span class=\"lens-source-line\" data-line=\"199\">  if (fraction == 1.0) {\n</span><span class=\"lens-source-line\" data-line=\"200\">    if (abs(b.x - a.x) &lt;= 180.0) { return b; }\n</span></code></pre><p>399 source lines omitted</p><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>origins<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"origins\">origins</td><td>read</td><td>f32</td></tr><tr><td>bearings<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"bearings\">bearings</td><td>read</td><td>f32</td></tr><tr><td>distances<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"distances\">distances</td><td>read</td><td>f32</td></tr><tr><td>destinations<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"destinations\">destinations</td><td>read_write</td><td>f32</td></tr><tr><td>finalBearings<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"finalBearings\">finalBearings</td><td>read_write</td><td>f32</td></tr><tr><td>converged<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=