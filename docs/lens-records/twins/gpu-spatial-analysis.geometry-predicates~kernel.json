    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>geometry-predicates-num-coordinates · 1×1×1 workgroups × 128×1×1 lanes = 128 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-spatial-analysis-geometry-predicates-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 128\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-spatial-analysis-geometry-predicates-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"128\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"4\" data-sampling=\"nearest\" href=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAECAMAAADYmc3mAAAABlBMVEVfZnLZ2dmiVvOOAAAAj0lEQVR4AQGEAHv/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAeMAG/rm4dUAAAAASUVORK5CYII=\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>128 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const gPositionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; gPositions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const gFeatureOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; gFeatureOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const gPolygonOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; gPolygonOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const gRingOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; gRingOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const outputOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; output: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">\n</span><span class=\"lens-source-line\" data-line=\"16\">fn isNaNBits(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"17\">fn canonicalBits(value: f32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"18\">  let bits = bitcast&lt;u32&gt;(value);\n</span><span class=\"lens-source-line\" data-line=\"19\">  return select(bits, 0u, (bits &amp; 0x7fffffffu) == 0u);\n</span><span class=\"lens-source-line\" data-line=\"20\">}\n</span><span class=\"lens-source-line\" data-line=\"21\">fn samePoint(first: vec2f, second: vec2f) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"22\">  return canonicalBits(first.x) == canonicalBits(second.x) &amp;&amp; canonicalBits(first.y) == canonicalBits(second.y);\n</span><span class=\"lens-source-line\" data-line=\"23\">}\n</span><span class=\"lens-source-line\" data-line=\"24\">fn identicalValue(first: f32, second: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"25\">  return canonicalBits(first) == canonicalBits(second) || (isNaNBits(first) &amp;&amp; isNaNBits(second));\n</span><span class=\"lens-source-line\" data-line=\"26\">}\n</span><span class=\"lens-source-line\" data-line=\"27\">fn identicalPosition(first: vec2f, second: vec2f) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"28\">  return identicalValue(first.x, second.x) &amp;&amp; identicalValue(first.y, second.y);\n</span><span class=\"lens-source-line\" data-line=\"29\">}\n</span><span class=\"lens-source-line\" data-line=\"30\">\n</span><span class=\"lens-source-line\" data-line=\"31\">fn equalityMultiply24(first: u32, second: u32) -&gt; vec2u {\n</span><span class=\"lens-source-line\" data-line=\"32\">  let firstHigh = first &gt;&gt; 12u;\n</span><span class=\"lens-source-line\" data-line=\"33\">  let firstLow = first &amp; 0xfffu;\n</span><span class=\"lens-source-line\" data-line=\"34\">  let secondHigh = second &gt;&gt; 12u;\n</span><span class=\"lens-source-line\" data-line=\"35\">  let secondLow = second &amp; 0xfffu;\n</span><span class=\"lens-source-line\" data-line=\"36\">  let highProduct = firstHigh * secondHigh;\n</span><span class=\"lens-source-line\" data-line=\"37\">  let middle = firstHigh * secondLow + firstLow * secondHigh;\n</span><span class=\"lens-source-line\" data-line=\"38\">  let lowProduct = firstLow * secondLow;\n</span><span class=\"lens-source-line\" data-line=\"39\">  let partial = lowProduct + ((middle &amp; 0xfffffu) &lt;&lt; 12u);\n</span><span class=\"lens-source-line\" data-line=\"40\">  let carryOne = select(0u, 1u, partial &lt; lowProduct);\n</span><span class=\"lens-source-line\" data-line=\"41\">  let low = partial + (highProduct &lt;&lt; 24u);\n</span><span class=\"lens-source-line\" data-line=\"42\">  let carryTwo = select(0u, 1u, low &lt; partial);\n</span><span class=\"lens-source-line\" data-line=\"43\">  return vec2u(low, (highProduct &gt;&gt; 8u) + (middle &gt;&gt; 20u) + carryOne + carryTwo);\n</span><span class=\"lens-source-line\" data-line=\"44\">}\n</span><span class=\"lens-source-line\" data-line=\"45\">\n</span><span class=\"lens-source-line\" data-line=\"46\">// Adds (high * 2^32 + low) * 2^shift to a 576-bit little-endian accumulator. high &lt; 2^16.\n</span><span class=\"lens-source-line\" data-line=\"47\">fn equalityAccumulateShifted(accumulator: ptr&lt;function, array&lt;u32, 18&gt;&gt;, low: u32, high: u32, shift: u32) {\n</span><span class=\"lens-source-line\" data-line=\"48\">  let firstWord = shift / 32u;\n</span><span class=\"lens-source-line\" data-line=\"49\">  let bit = shift % 32u;\n</span><span class=\"lens-source-line\" data-line=\"50\">  var word0 = low &lt;&lt; bit;\n</span><span class=\"lens-source-line\" data-line=\"51\">  var word1 = high &lt;&lt; bit;\n</span><span class=\"lens-source-line\" data-line=\"52\">  var word2 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"53\">  if (bit &gt; 0u) {\n</span><span class=\"lens-source-line\" data-line=\"54\">    word1 = word1 | (low &gt;&gt; (32u - bit));\n</span><span class=\"lens-source-line\" data-line=\"55\">    word2 = high &gt;&gt; (32u - bit);\n</span><span class=\"lens-source-line\" data-line=\"56\">  }\n</span><span class=\"lens-source-line\" data-line=\"57\">  var carry = 0u;\n</span><span class=\"lens-source-line\" data-line=\"58\">  for (var slot = firstWord; slot &lt; 18u; slot++) {\n</span><span class=\"lens-source-line\" data-line=\"59\">    let relative = slot - firstWord;\n</span><span class=\"lens-source-line\" data-line=\"60\">    var addend = 0u;\n</span><span class=\"lens-source-line\" data-line=\"61\">    if (relative == 0u) { addend = word0; } else if (relative == 1u) { addend = word1; } else if (relative == 2u) { addend = word2; } else if (carry == 0u) { break; }\n</span><span class=\"lens-source-line\" data-line=\"62\">    let partial = (*accumulator)[slot] + addend;\n</span><span class=\"lens-source-line\" data-line=\"63\">    let carryOne = select(0u, 1u, partial &lt; addend);\n</span><span class=\"lens-source-line\" data-line=\"64\">    let total = partial + carry;\n</span><span class=\"lens-source-line\" data-line=\"65\">    let carryTwo = select(0u, 1u, total &lt; partial);\n</span><span class=\"lens-source-line\" data-line=\"66\">    (*accumulator)[slot] = total;\n</span><span class=\"lens-source-line\" data-line=\"67\">    carry = carryOne | carryTwo;\n</span><span class=\"lens-source-line\" data-line=\"68\">  }\n</span><span class=\"lens-source-line\" data-line=\"69\">}\n</span><span class=\"lens-source-line\" data-line=\"70\">\n</span><span class=\"lens-source-line\" data-line=\"71\">\n</span><span class=\"lens-source-line\" data-line=\"72\">fn equalityNormalOrZero(bits:u32)-&gt;bool {\n</span><span class=\"lens-source-line\" data-line=\"73\"> let magnitude=bits&amp;0x7fffffffu;\n</span><span class=\"lens-source-line\" data-line=\"74\"> return magnitude==0u || (magnitude&gt;=0x00800000u &amp;&amp; magnitude&lt;0x7f800000u);\n</span><span class=\"lens-source-line\" data-line=\"75\">}\n</span><span class=\"lens-source-line\" data-line=\"76\">fn equalityStableDelta(first:u32,second:u32,difference:u32)-&gt;bool {\n</span><span class=\"lens-source-line\" data-line=\"77\"> // A zero arithmetic difference is reliable only when the stored values really coincide.\n</span><span class=\"lens-source-line\" data-line=\"78\"> return first==second || ((first&amp;0x7fffffffu)==0u &amp;&amp; (second&amp;0x7fffffffu)==0u) ||\n</span><span class=\"lens-source-line\" data-line=\"79\">   ((difference&amp;0x7fffffffu)&gt;=0x00800000u &amp;&amp; (difference&amp;0x7fffffffu)&lt;0x7f800000u);\n</span><span class=\"lens-source-line\" data-line=\"80\">}\n</span><span class=\"lens-source-line\" data-line=\"81\">fn geometryWithinTolerance(first:vec2f,second:vec2f,tolerance:f32)-&gt;bool {\n</span><span class=\"lens-source-line\" data-line=\"82\"> let words=vec4u(bitcast&lt;vec2u&gt;(first),bitcast&lt;vec2u&gt;(second));\n</span><span class=\"lens-source-line\" data-line=\"83\"> if(any((words&amp;vec4u(0x7f800000u))==vec4u(0x7f800000u))) {return false;}\n</span><span class=\"lens-source-line\" data-line=\"84\"> let toleranceBits=bitcast&lt;u32&gt;(tolerance);\n</span><span class=\"lens-source-line\" data-line=\"85\"> if((toleranceBits&amp;0x7fffffffu)&gt;0x7f800000u || ((toleranceBits&amp;0x80000000u)!=0u &amp;&amp; (toleranceBits&amp;0x7fffffffu)!=0u)) {return false;}\n</span><span class=\"lens-source-line\" data-line=\"86\"> if(toleranceBits==0x7f800000u) {return true;}\n</span><span class=\"lens-source-line\" data-line=\"87\"> // Normal deltas whose reciprocal remains normal admit a broad float filter. Leave a generous\n</span><span class=\"lens-source-line\" data-line=\"88\"> // absolute margin in normalized units for reciprocal division and reassociation.\n</span><span class=\"lens-source-line\" data-line=\"89\"> // Zero, subnormal, very large and overflowing deltas reach the integer certificate.\n</span><span class=\"lens-source-line\" data-line=\"90\"> let delta=first-second;let scale=max(abs(delta.x),abs(delta.y));\n</span><span class=\"lens-source-line\" data-line=\"91\"> let scaleExponent=(bitcast&lt;u32&gt;(scale)&gt;&gt;23u)&amp;255u;\n</span><span class=\"lens-source-line\" data-line=\"92\"> let safeOperands=equalityNormalOrZero(words.x) &amp;&amp; equalityNormalOrZero(words.y) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"93\">   equalityNormalOrZero(words.z) &amp;&amp; equalityNormalOrZero(words.w) &amp;&amp; equalityNormalOrZero(toleranceBits);\n</span><span class=\"lens-source-line\" data-line=\"94\"> let safeDeltas=equalityStableDelta(words.x,words.z,bitcast&lt;u32&gt;(delta.x)) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"95\">   equalityStableDelta(words.y,words.w,bitcast&lt;u32&gt;(delta.y));\n</span><span class=\"lens-source-line\" data-line=\"96\"> if(safeOperands &amp;&amp; safeDeltas &amp;&amp; scaleExponent&gt;0u &amp;&amp; scaleExponent&lt;253u) {\n</span><span class=\"lens-source-line\" data-line=\"97\">   let normalized=delta/scale;\n</span><span class=\"lens-source-line\" data-line=\"98\">   let length=sqrt(dot(normalized,normalized));let relativeTolerance=tolerance/scale;\n</span><span class=\"lens-source-line\" data-line=\"99\">   if(length&lt;relativeTolerance-0.00001) {return true;}\n</span><span class=\"lens-source-line\" data-line=\"100\">   if(length&gt;relativeTolerance+0.00001) {return false;}\n</span><span class=\"lens-source-line\" data-line=\"101\"> }\n</span><span class=\"lens-source-line\" data-line=\"102\"> // (ax-bx)^2 + (ay-by)^2 - tolerance^2. Cross products have an extra factor two.\n</span><span class=\"lens-source-line\" data-line=\"103\"> let firstBits=array&lt;u32,7&gt;(words.x,words.z,words.x,words.y,words.w,words.y,toleranceBits);\n</span><span class=\"lens-source-line\" data-line=\"104\"> let secondBits=array&lt;u32,7&gt;(words.x,words.z,words.z,words.y,words.w,words.w,toleranceBits);\n</span><span class=\"lens-source-line\" data-line=\"105\"> var positive:array&lt;u32,18&gt;;var negative:array&lt;u32,18&gt;;\n</span><span class=\"lens-source-line\" data-line=\"106\"> for(var term=0u;term&lt;7u;term++) {\n</span><span class=\"lens-source-line\" data-line=\"107\">   let left=firstBits[term];let right=secondBits[term];\n</span><span class=\"lens-source-line\" data-line=\"108\">   let leftMagnitude=left&amp;0x7fffffffu;let rightMagnitude=right&amp;0x7fffffffu;\n</span><span class=\"lens-source-line\" data-line=\"109\">   if(leftMagnitude==0u || rightMagnitude==0u) {continue;}\n</span><span class=\"lens-source-line\" data-line=\"110\">   let leftExponent=leftMagnitude&gt;&gt;23u;let rightExponent=rightMagnitude&gt;&gt;23u;\n</span><span class=\"lens-source-line\" data-line=\"111\">   let leftSignificand=select((leftMagnitude&amp;0x7fffffu)|0x800000u,leftMagnitude,leftExponent==0u);\n</span><span class=\"lens-source-line\" data-line=\"112\">   let rightSignificand=select((rightMagnitude&amp;0x7fffffu)|0x800000u,rightMagnitude,rightExponent==0u);\n</span><span class=\"lens-source-line\" data-line=\"113\">   let product=equalityMultiply24(leftSignificand,rightSignificand);\n</span><span class=\"lens-source-line\" data-line=\"114\">   let cross=term==2u || term==5u;\n</span><span class=\"lens-source-line\" data-line=\"115\">   let exponent=select(i32(leftExponent)-150,-149,leftExponent==0u)+select(i32(rightExponent)-150,-149,rightExponent==0u)+select(0,1,cross);\n</span><span class=\"lens-source-line\" data-line=\"116\">   let isNegative=(((left^right)&gt;&gt;31u)!=0u) != (cross || term==6u);\n</span><span class=\"lens-source-line\" data-line=\"117\">   if(isNegative) {equalityAccumulateShifted(&amp;negative,product.x,product.y,u32(exponent+298));}\n</span><span class=\"lens-source-line\" data-line=\"118\">   else {equalityAccumulateShifted(&amp;positive,product.x,product.y,u32(exponent+298));}\n</span><span class=\"lens-source-line\" data-line=\"119\"> }\n</span><span class=\"lens-source-line\" data-line=\"120\"> for(var slot=18u;slot&gt;0u;slot--) {\n</span><span class=\"lens-source-line\" data-line=\"121\">   if(positive[slot-1u]!=negative[slot-1u]) {return positive[slot-1u]&lt;negative[slot-1u];}\n</span><span class=\"lens-source-line\" data-line=\"122\"> }\n</span><span class=\"lens-source-line\" data-line=\"123\"> return true;\n</span><span class=\"lens-source-line\" data-line=\"124\">}\n</span><span class=\"lens-source-line\" data-line=\"125\">fn withinTolerance(first:vec2f,second:vec2f,tolerance:f32)-&gt;bool {\n</span><span class=\"lens-source-line\" data-line=\"126\"> return geometryWithinTolerance(first,second,tolerance);\n</span><span class=\"lens-source-line\" data-line=\"127\">}\n</span><span class=\"lens-source-line\" data-line=\"128\">\n</span><span class=\"lens-source-line\" data-line=\"129\">const g_FEATURE_COUNT: u32 = 102u;\n</span><span class=\"lens-source-line\" data-line=\"130\">const g_VERTEX_COUNT: u32 = 1431u;\n</span><span class=\"lens-source-line\" data-line=\"131\">fn gVertex(vertex: u32) -&gt; vec2f {\n</span><span class=\"lens-source-line\" data-line=\"132\">  return vec2f(gPositions[gPositionsOffset + vertex * 2u], gPositions[gPositionsOffset + vertex * 2u + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"133\">}\n</span><span class=\"lens-source-line\" data-line=\"134\">const g_POLYGON_COUNT: u32 = 102u;\n</span><span class=\"lens-source-line\" data-line=\"135\">const g_RING_COUNT: u32 = 102u;\n</span><span class=\"lens-source-line\" data-line=\"136\">fn gVertexStart(feature: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"137\">  let polygon = gFeatureOffsets[gFeatureOffsetsOffset + feature];\n</span><span class=\"lens-source-line\" data-line=\"138\">  let ring = gPolygonOffsets[gPolygonOffsetsOffset + polygon];\n</span><span class=\"lens-source-line\" data-line=\"139\">  return min(gRingOffsets[gRingOffsetsOffset + ring], g_VERTEX_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"140\">}\n</span><span class=\"lens-source-line\" data-line=\"141\">fn gLastRing(count: u32, value: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"142\">  if (count == 0u || gRingOffsets[gRingOffsetsOffset] &gt; value) { return 0u; }\n</span><span class=\"lens-source-line\" data-line=\"143\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"144\">  var high = count;\n</span><span class=\"lens-source-line\" data-line=\"145\">  while (high - low &gt; 1u) {\n</span><span class=\"lens-source-line\" data-line=\"146\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"147\">    if (gRingOffsets[gRingOffsetsOffset + middle] &lt;= value) { low = middle; } else { high = middle; }\n</span><span class=\"lens-source-line\" data-line=\"148\">  }\n</span><span class=\"lens-source-line\" data-line=\"149\">  return low;\n</span><span class=\"lens-source-line\" data-line=\"150\">}\n</span><span class=\"lens-source-line\" data-line=\"151\">fn gLastPolygon(count: u32, value: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"152\">  if (count == 0u || gPolygonOffsets[gPolygonOffsetsOffset] &gt; value) { return 0u; }\n</span><span class=\"lens-source-line\" data-line=\"153\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"154\">  var high = count;\n</span><span class=\"lens-source-line\" data-line=\"155\">  while (high - low &gt; 1u) {\n</span><span class=\"lens-source-line\" data-line=\"156\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"157\">    if (gPolygonOffsets[gPolygonOffsetsOffset + middle] &lt;= value) { low = middle; } else { high = middle; }\n</span><span class=\"lens-source-line\" data-line=\"158\">  }\n</span><span class=\"lens-source-line\" data-line=\"159\">  return low;\n</span><span class=\"lens-source-line\" data-line=\"160\">}\n</span><span class=\"lens-source-line\" data-line=\"161\">fn gLastFeature(count: u32, value: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" d