    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>line-density-count · 3×1×1 workgroups × 256×1×1 lanes = 768 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-spatial-analysis-line-density-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect><rect x=\"21\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"1\"></rect><rect x=\"41\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"2\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-spatial-analysis-line-density-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const lineOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; lineOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const parametersOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; parameters: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const countsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; counts: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">const LINE_COUNT: u32 = 223u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const ROW_COUNT: u32 = 513u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const COLUMNS: i32 = 15;\n</span><span class=\"lens-source-line\" data-line=\"17\">const ROWS: i32 = 13;\n</span><span class=\"lens-source-line\" data-line=\"18\">const CAPACITY: u32 = 2052u;\n</span><span class=\"lens-source-line\" data-line=\"19\">const RADIUS: f32 = 1.0;\n</span><span class=\"lens-source-line\" data-line=\"20\">const INFINITE: f32 = 3.0e38;\n</span><span class=\"lens-source-line\" data-line=\"21\">const EMITS_PIECES: bool = false;\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line\" data-line=\"24\">const NO_LINE: u32 = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"25\">\n</span><span class=\"lens-source-line\" data-line=\"26\">fn findLine(row: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"27\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"28\">  var high = LINE_COUNT + 1u;\n</span><span class=\"lens-source-line\" data-line=\"29\">  while (low &lt; high) {\n</span><span class=\"lens-source-line\" data-line=\"30\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"31\">    if (lineOffsets[lineOffsetsOffset + middle] &lt;= row) {\n</span><span class=\"lens-source-line\" data-line=\"32\">      low = middle + 1u;\n</span><span class=\"lens-source-line\" data-line=\"33\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"34\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"35\">    }\n</span><span class=\"lens-source-line\" data-line=\"36\">  }\n</span><span class=\"lens-source-line\" data-line=\"37\">  if (low == 0u || low &gt; LINE_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"38\">    return NO_LINE;\n</span><span class=\"lens-source-line\" data-line=\"39\">  }\n</span><span class=\"lens-source-line\" data-line=\"40\">  return low - 1u;\n</span><span class=\"lens-source-line\" data-line=\"41\">}\n</span><span class=\"lens-source-line\" data-line=\"42\">\n</span><span class=\"lens-source-line\" data-line=\"43\">\n</span><span class=\"lens-source-line\" data-line=\"44\">// Sign of value - origin - boundary * step, from the original float32 bits. Cell indices\n</span><span class=\"lens-source-line\" data-line=\"45\">// are below 2^24. Ten uint32 limbs cover all finite float32 values times those indices\n</span><span class=\"lens-source-line\" data-line=\"46\">// in units of 2^-149 (at most 302 bits), including subnormals on flush-to-zero devices.\n</span><span class=\"lens-source-line\" data-line=\"47\">fn compareGridBoundary(value: f32, origin: f32, step: f32, boundary: u32) -&gt; i32 {\n</span><span class=\"lens-source-line\" data-line=\"48\">  var operands = array&lt;u32, 3&gt;(bitcast&lt;u32&gt;(value), bitcast&lt;u32&gt;(origin) ^ 0x80000000u, bitcast&lt;u32&gt;(step) ^ 0x80000000u);\n</span><span class=\"lens-source-line\" data-line=\"49\">  var positive: array&lt;u32, 10&gt;;\n</span><span class=\"lens-source-line\" data-line=\"50\">  var negative: array&lt;u32, 10&gt;;\n</span><span class=\"lens-source-line\" data-line=\"51\">  for (var term = 0u; term &lt; 3u; term++) {\n</span><span class=\"lens-source-line\" data-line=\"52\">    let bits = operands[term];\n</span><span class=\"lens-source-line\" data-line=\"53\">    let exponentBits = (bits &gt;&gt; 23u) &amp; 255u;\n</span><span class=\"lens-source-line\" data-line=\"54\">    let significand = select((bits &amp; 0x7fffffu) | 0x800000u, bits &amp; 0x7fffffu, exponentBits == 0u);\n</span><span class=\"lens-source-line\" data-line=\"55\">    let multiplier = select(1u, boundary, term == 2u);\n</span><span class=\"lens-source-line\" data-line=\"56\">    let lowProduct = (significand &amp; 65535u) * (multiplier &amp; 65535u);\n</span><span class=\"lens-source-line\" data-line=\"57\">    let middle = (significand &gt;&gt; 16u) * (multiplier &amp; 65535u) + (significand &amp; 65535u) * (multiplier &gt;&gt; 16u);\n</span><span class=\"lens-source-line\" data-line=\"58\">    let low = lowProduct + (middle &lt;&lt; 16u);\n</span><span class=\"lens-source-line\" data-line=\"59\">    let high = (significand &gt;&gt; 16u) * (multiplier &gt;&gt; 16u) + (middle &gt;&gt; 16u) + u32(low &lt; lowProduct);\n</span><span class=\"lens-source-line\" data-line=\"60\">    let shift = select(exponentBits - 1u, 0u, exponentBits == 0u);\n</span><span class=\"lens-source-line\" data-line=\"61\">    let firstWord = shift / 32u;\n</span><span class=\"lens-source-line\" data-line=\"62\">    let bit = shift % 32u;\n</span><span class=\"lens-source-line\" data-line=\"63\">    var words = array&lt;u32, 3&gt;(low &lt;&lt; bit, high &lt;&lt; bit, 0u);\n</span><span class=\"lens-source-line\" data-line=\"64\">    if (bit &gt; 0u) {\n</span><span class=\"lens-source-line\" data-line=\"65\">      words[1] |= low &gt;&gt; (32u - bit);\n</span><span class=\"lens-source-line\" data-line=\"66\">      words[2] = high &gt;&gt; (32u - bit);\n</span><span class=\"lens-source-line\" data-line=\"67\">    }\n</span><span class=\"lens-source-line\" data-line=\"68\">    var carry = 0u;\n</span><span class=\"lens-source-line\" data-line=\"69\">    for (var slot = firstWord; slot &lt; 10u; slot++) {\n</span><span class=\"lens-source-line\" data-line=\"70\">      let relative = slot - firstWord;\n</span><span class=\"lens-source-line\" data-line=\"71\">      var addend = 0u;\n</span><span class=\"lens-source-line\" data-line=\"72\">      if (relative &lt; 3u) { addend = words[relative]; }\n</span><span class=\"lens-source-line\" data-line=\"73\">      else if (carry == 0u) { break; }\n</span><span class=\"lens-source-line\" data-line=\"74\">      var previous = positive[slot];\n</span><span class=\"lens-source-line\" data-line=\"75\">      if ((bits &gt;&gt; 31u) != 0u) { previous = negative[slot]; }\n</span><span class=\"lens-source-line\" data-line=\"76\">      let partial = previous + addend;\n</span><span class=\"lens-source-line\" data-line=\"77\">      let total = partial + carry;\n</span><span class=\"lens-source-line\" data-line=\"78\">      carry = u32(partial &lt; previous || total &lt; partial);\n</span><span class=\"lens-source-line\" data-line=\"79\">      if ((bits &gt;&gt; 31u) != 0u) { negative[slot] = total; }\n</span><span class=\"lens-source-line\" data-line=\"80\">      else { positive[slot] = total; }\n</span><span class=\"lens-source-line\" data-line=\"81\">    }\n</span><span class=\"lens-source-line\" data-line=\"82\">  }\n</span><span class=\"lens-source-line\" data-line=\"83\">  for (var slot = 10u; slot &gt; 0u; slot--) {\n</span><span class=\"lens-source-line\" data-line=\"84\">    if (positive[slot - 1u] != negative[slot - 1u]) {\n</span><span class=\"lens-source-line\" data-line=\"85\">      return select(-1, 1, positive[slot - 1u] &gt; negative[slot - 1u]);\n</span><span class=\"lens-source-line\" data-line=\"86\">    }\n</span><span class=\"lens-source-line\" data-line=\"87\">  }\n</span><span class=\"lens-source-line\" data-line=\"88\">  return 0;\n</span><span class=\"lens-source-line\" data-line=\"89\">}\n</span><span class=\"lens-source-line\" data-line=\"90\">\n</span><span class=\"lens-source-line\" data-line=\"91\">fn getStoredCoordinateCell(value: f32, origin: f32, step: f32, count: i32, approximate: f32) -&gt; i32 {\n</span><span class=\"lens-source-line\" data-line=\"92\">  let candidate = clamp(i32(floor(approximate)), 0, count - 1);\n</span><span class=\"lens-source-line\" data-line=\"93\">  // The ordinary path needs two certificates. If rounding crossed either boundary, find\n</span><span class=\"lens-source-line\" data-line=\"94\">  // the exact floor by an integer binary search (at most 24 comparisons for this route).\n</span><span class=\"lens-source-line\" data-line=\"95\">  if (compareGridBoundary(value, origin, step, u32(candidate)) &gt;= 0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"96\">      compareGridBoundary(value, origin, step, u32(candidate + 1)) &lt; 0) { return candidate; }\n</span><span class=\"lens-source-line\" data-line=\"97\">  var lower = 0;\n</span><span class=\"lens-source-line\" data-line=\"98\">  var upper = count;\n</span><span class=\"lens-source-line\" data-line=\"99\">  loop {\n</span><span class=\"lens-source-line\" data-line=\"100\">    if (upper - lower &lt;= 1) { break; }\n</span><span class=\"lens-source-line\" data-line=\"101\">    let middle = lower + (upper - lower) / 2;\n</span><span class=\"lens-source-line\" data-line=\"102\">    if (compareGridBoundary(value, origin, step, u32(middle)) &gt;= 0) { lower = middle; }\n</span><span class=\"lens-source-line\" data-line=\"103\">    else { upper = middle; }\n</span><span class=\"lens-source-line\" data-line=\"104\">  }\n</span><span class=\"lens-source-line\" data-line=\"105\">  return lower;\n</span><span class=\"lens-source-line\" data-line=\"106\">}\n</span><span class=\"lens-source-line\" data-line=\"107\">\n</span><span class=\"lens-source-line\" data-line=\"108\">\n</span><span class=\"lens-source-line\" data-line=\"109\">fn getPosition(row: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"110\">  return vec2&lt;f32&gt;(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"111\">}\n</span><span class=\"lens-source-line\" data-line=\"112\">\n</span><span class=\"lens-source-line\" data-line=\"113\">fn getPieceLength(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;, t0: f32, t1: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"114\">  return (t1 - t0) * length(b - a);\n</span><span class=\"lens-source-line\" data-line=\"115\">}\n</span><span class=\"lens-source-line\" data-line=\"116\">\n</span><span class=\"lens-source-line\" data-line=\"117\">fn walkSegment(row: u32, slot: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"118\">  let line = findLine(row);\n</span><span class=\"lens-source-line\" data-line=\"119\">  if (line == NO_LINE) {\n</span><span class=\"lens-source-line\" data-line=\"120\">    return 0u;\n</span><span class=\"lens-source-line\" data-line=\"121\">  }\n</span><span class=\"lens-source-line\" data-line=\"122\">  if (row + 1u &gt;= min(lineOffsets[lineOffsetsOffset + line + 1u], ROW_COUNT)) {\n</span><span class=\"lens-source-line\" data-line=\"123\">    return 0u;\n</span><span class=\"lens-source-line\" data-line=\"124\">  }\n</span><span class=\"lens-source-line\" data-line=\"125\">  let origin = vec2&lt;f32&gt;(parameters[parametersOffset], parameters[parametersOffset + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"126\">  let cellSize = vec2&lt;f32&gt;(parameters[parametersOffset + 2u], parameters[parametersOffset + 3u]);\n</span><span class=\"lens-source-line\" data-line=\"127\">  let a = getPosition(row);\n</span><span class=\"lens-source-line\" data-line=\"128\">  let b = getPosition(row + 1u);\n</span><span class=\"lens-source-line\" data-line=\"129\">  let ua = (a - origin) / cellSize;\n</span><span class=\"lens-source-line\" data-line=\"130\">  let delta = (b - origin) / cellSize - ua;\n</span><span class=\"lens-source-line\" data-line=\"131\">  // Liang-Barsky against [0, COLUMNS] x [0, ROWS].\n</span><span class=\"lens-source-line\" data-line=\"132\">  var t0 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"133\">  var t1 = 1.0;\n</span><span class=\"lens-source-line\" data-line=\"134\">  var p = array&lt;f32, 4&gt;(-delta.x, delta.x, -delta.y, delta.y);\n</span><span class=\"lens-source-line\" data-line=\"135\">  var q = array&lt;f32, 4&gt;(ua.x, f32(COLUMNS) - ua.x, ua.y, f32(ROWS) - ua.y);\n</span><span class=\"lens-source-line\" data-line=\"136\">  for (var side = 0u; side &lt; 4u; side++) {\n</span><span class=\"lens-source-line\" data-line=\"137\">    if (p[side] == 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"138\">      if (q[side] &lt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"139\">        return 0u;\n</span><span class=\"lens-source-line\" data-line=\"140\">      }\n</span><span class=\"lens-source-line\" data-line=\"141\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"142\">      let r = q[side] / p[side];\n</span><span class=\"lens-source-line\" data-line=\"143\">      if (p[side] &lt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"144\">        if (r &gt; t1) {\n</span><span class=\"lens-source-line\" data-line=\"145\">          return 0u;\n</span><span class=\"lens-source-line\" data-line=\"146\">        }\n</span><span class=\"lens-source-line\" data-line=\"147\">        t0 = max(t0, r);\n</span><span class=\"lens-source-line\" data-line=\"148\">      } else {\n</span><span class=\"lens-source-line\" data-line=\"149\">        if (r &lt; t0) {\n</span><span class=\"lens-source-line\" data-line=\"150\">          return 0u;\n</span><span class=\"lens-source-line\" data-line=\"151\">        }\n</span><span class=\"lens-source-line\" data-line=\"152\">        t1 = min(t1, r);\n</span><span class=\"lens-source-line\" data-line=\"153\">      }\n</span><span class=\"lens-source-line\" data-line=\"154\">    }\n</span><span class=\"lens-source-line\" data-line=\"155\">  }\n</span><span class=\"lens-source-line\" data-line=\"156\">  if (t1 &lt;= t0) {\n</span><span class=\"lens-source-line\" data-line=\"157\">    return 0u;\n</span><span class=\"lens-source-line\" data-line=\"158\">  }\n</span><span class=\"lens-source-line\" data-line=\"159\">  let start = ua + delta * t0;\n</span><span class=\"lens-source-line\" data-line=\"160\">  let end = ua + delta * t1;\n</span><span class=\"lens-source-line\" data-line=\"161\">  var cx = clamp(i32(floor(start.x)), 0, COLUMNS - 1);\n</span><span class=\"lens-source-line\" data-line=\"162\">  var cy = clamp(i32(floor(start.y)), 0, ROWS - 1);\n</span><span class=\"lens-source-line\" data-line=\"163\">  var endX = clamp(i32(floor(end.x)), 0, COLUMNS - 1);\n</span><span class=\"lens-source-line\" data-line=\"164\">  var endY = clamp(i32(floor(end.y)), 0, ROWS - 1);\n</span><span class=\"lens-source-line\" data-line=\"165\">  // Unclipped endpoints and constant axes retain their original packed coordinates.\n</span><span class=\"lens-source-line\" data-line=\"166\">  // A quotient rounded just below an integer must not move a physical boundary south/west.\n</span><span class=\"lens-source-line\" data-line=\"167\">  if (t0 == 0.0 || bitcast&lt;u32&gt;(a.x) == bitcast&lt;u32&gt;(b.x)) {\n</span><span class=\"lens-source-line\" data-line=\"168\">    cx = getStoredCoordinateCell(a.x, origin.x, cellSize.x, COLUMNS, start.x);\n</span><span class=\"lens-source-line\" data-line=\"169\">  }\n</span><span class=\"lens-source-line\" data-line=\"170\">  if (t0 == 0.0 || bitcast&lt;u32&gt;(a.y) == bitcast&lt;u32&gt;(b.y)) {\n</span><span class=\"lens-source-line\" data-line=\"171\">    cy = getStoredCoordinateCell(a.y, origin.y, cellSize.y, ROWS, start.y);\n</span><span class=\"lens-source-line\" data-line=\"172\">  }\n</span><span class=\"lens-source-line\" data-line=\"173\">  if (t1 == 1.0 || bitcast&lt;u32&gt;(a.x) == bitcast&lt;u32&gt;(b.x)) {\n</span><span class=\"lens-source-line\" data-line=\"174\">    endX = getStoredCoordinateCell(b.x, origin.x, cellSize.x, COLUMNS, end.x);\n</span><span class=\"lens-source-line\" data-line=\"175\">  }\n</span><span class=\"lens-source-line\" data-line=\"176\">  if (t1 == 1.0 || bitcast&lt;u32&gt;(a.y) == bitcast&lt;u32&gt;(b.y)) {\n</span><span class=\"lens-source-line\" data-line=\"177\">    endY = getStoredCoordinateCell(b.y, origin.y, cellSize.y, ROWS, end.y);\n</span><span class=\"lens-source-line\" data-line=\"178\">  }\n</span><span class=\"lens-source-line\" data-line=\"179\">  var stepsX = u32(abs(endX - cx));\n</span><span class=\"lens-source-line\" data-line=\"180\">  var stepsY = u32(abs(endY - cy));\n</span><span class=\"lens-source-line\" data-line=\"181\">  let pieceCount = stepsX + stepsY + 1u;\n</span><span class=\"lens-source-line\" data-