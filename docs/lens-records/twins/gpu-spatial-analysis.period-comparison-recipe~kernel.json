    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>period-comparison-class-breaks-prepare · 1×1×1 workgroups × 256×1×1 lanes = 256 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-spatial-analysis-period-comparison-recipe-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-spatial-analysis-period-comparison-recipe-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line lens-source-line--binding\" data-line=\"1\">@group(0) @binding(0) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"2\">var&lt;private&gt; paramsOffset: u32;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"3\">@group(0) @binding(1) var&lt;storage, read_write&gt; state: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"4\">var&lt;private&gt; stateOffset: u32;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"5\">@group(0) @binding(2) var&lt;storage, read_write&gt; extremes: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"6\">var&lt;private&gt; extremesOffset: u32;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"7\">@group(0) @binding(3) var&lt;storage, read_write&gt; edgeState: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"8\">var&lt;private&gt; edgeStateOffset: u32;\n</span><span class=\"lens-source-line\" data-line=\"9\">struct GraphChunkGroupParameters { words: array&lt;vec4&lt;u32&gt;, 16&gt; }\n</span><span class=\"lens-source-line\" data-line=\"10\">@group(0) @binding(4) var&lt;uniform&gt; graphChunkGroupParameters: GraphChunkGroupParameters;\n</span><span class=\"lens-source-line\" data-line=\"11\">fn getChunkParameter(word: u32) -&gt; u32 { return graphChunkGroupParameters.words[word / 4u][word % 4u]; }\n</span><span class=\"lens-source-line\" data-line=\"12\">const COMPILED_METHODS: u32 = 128u;\n</span><span class=\"lens-source-line\" data-line=\"13\">const MAXIMUM_CLASS_COUNT: u32 = 5u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const QUANTILE_COUNT: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const HEADER: u32 = 8u;\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"16\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"17\">fn main(@builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"18\">  @builtin(num_workgroups) workgroupCount: vec3&lt;u32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"19\">  @builtin(local_invocation_index) localInvocationIndex: u32) {\n</span><span class=\"lens-source-line\" data-line=\"20\">  let workgroupIndex = (workgroupId.z * workgroupCount.y + workgroupId.y) * workgroupCount.x + workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"21\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"22\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"23\">  if (index &gt;= getChunkParameter(1u)) { return; }\n</span><span class=\"lens-source-line\" data-line=\"24\">  paramsOffset = getChunkParameter(4u);\n</span><span class=\"lens-source-line\" data-line=\"25\">  stateOffset = getChunkParameter(5u);\n</span><span class=\"lens-source-line\" data-line=\"26\">  extremesOffset = getChunkParameter(6u);\n</span><span class=\"lens-source-line\" data-line=\"27\">  edgeStateOffset = getChunkParameter(7u);\n</span><span class=\"lens-source-line\" data-line=\"28\">  let methodValue = params[paramsOffset];\n</span><span class=\"lens-source-line\" data-line=\"29\">  var method = 4294967295u;\n</span><span class=\"lens-source-line\" data-line=\"30\">  if (methodValue &gt;= 0.0 &amp;&amp; methodValue &lt; 32.0 &amp;&amp; floor(methodValue) == methodValue) {\n</span><span class=\"lens-source-line\" data-line=\"31\">    let code = u32(methodValue);\n</span><span class=\"lens-source-line\" data-line=\"32\">    if ((COMPILED_METHODS &amp; (1u &lt;&lt; code)) != 0u) {\n</span><span class=\"lens-source-line\" data-line=\"33\">      method = code;\n</span><span class=\"lens-source-line\" data-line=\"34\">    }\n</span><span class=\"lens-source-line\" data-line=\"35\">  }\n</span><span class=\"lens-source-line\" data-line=\"36\">  let classValue = params[paramsOffset + 1u];\n</span><span class=\"lens-source-line\" data-line=\"37\">  var classCount = 1u;\n</span><span class=\"lens-source-line\" data-line=\"38\">  if (classValue &gt;= 1.0) {\n</span><span class=\"lens-source-line\" data-line=\"39\">    classCount = u32(min(classValue, f32(MAXIMUM_CLASS_COUNT)));\n</span><span class=\"lens-source-line\" data-line=\"40\">  }\n</span><span class=\"lens-source-line\" data-line=\"41\">  if (method == 4u) {\n</span><span class=\"lens-source-line\" data-line=\"42\">    classCount = 6u;\n</span><span class=\"lens-source-line\" data-line=\"43\">  }\n</span><span class=\"lens-source-line\" data-line=\"44\">  state[stateOffset + 0u] = method;\n</span><span class=\"lens-source-line\" data-line=\"45\">  state[stateOffset + 1u] = classCount;\n</span><span class=\"lens-source-line\" data-line=\"46\">  state[stateOffset + 2u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"47\">  state[stateOffset + 3u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"48\">  state[stateOffset + 4u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"49\">  state[stateOffset + 5u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"50\">  extremes[extremesOffset + 0u] = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"51\">  extremes[extremesOffset + 1u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"52\">  extremes[extremesOffset + 2u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"53\">  extremes[extremesOffset + 3u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"54\">  edgeState[edgeStateOffset] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"55\">  \n</span><span class=\"lens-source-line\" data-line=\"56\">  \n</span><span class=\"lens-source-line\" data-line=\"57\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static me