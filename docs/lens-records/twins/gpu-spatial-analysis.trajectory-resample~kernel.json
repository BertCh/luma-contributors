ation guard</title></rect><text x=\"1005\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">25</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"26\"><rect x=\"1042\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-trajectory-resample-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1045\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">26</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"27\"><rect x=\"1082\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-trajectory-resample-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1085\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">27</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"28\"><rect x=\"1122\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-trajectory-resample-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">28</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"29\"><rect x=\"1162\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-trajectory-resample-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">29</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"30\"><rect x=\"1202\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-trajectory-resample-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">30</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"31\"><rect x=\"1242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-trajectory-resample-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">31</text></g></svg><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const trackOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; trackOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const cumulativeLengthsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; cumulativeLengths: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const ROW_COUNT: u32 = 771u;\n</span><span class=\"lens-source-line\" data-line=\"12\">\n</span><span class=\"lens-source-line\" data-line=\"13\">fn getAdditionRoundingError(first: f32, second: f32, sum: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"14\">  let firstBits = bitcast&lt;u32&gt;(first);\n</span><span class=\"lens-source-line\" data-line=\"15\">  let secondBits = bitcast&lt;u32&gt;(second);\n</span><span class=\"lens-source-line\" data-line=\"16\">  let sumBits = bitcast&lt;u32&gt;(sum);\n</span><span class=\"lens-source-line\" data-line=\"17\">  let firstMagnitude = firstBits &amp; 0x7fffffffu;\n</span><span class=\"lens-source-line\" data-line=\"18\">  let secondMagnitude = secondBits &amp; 0x7fffffffu;\n</span><span class=\"lens-source-line\" data-line=\"19\">  let sumMagnitude = sumBits &amp; 0x7fffffffu;\n</span><span class=\"lens-source-line\" data-line=\"20\">  // A zero operand makes the addition exact; an infinity or a NaN has no rounding error to report.\n</span><span class=\"lens-source-line\" data-line=\"21\">  if (firstMagnitude == 0u || secondMagnitude == 0u ||\n</span><span class=\"lens-source-line\" data-line=\"22\">      max(max(firstMagnitude, secondMagnitude), sumMagnitude) &gt;= 0x7f800000u) {\n</span><span class=\"lens-source-line\" data-line=\"23\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"24\">  }\n</span><span class=\"lens-source-line\" data-line=\"25\">  let firstIsLarger = firstMagnitude &gt;= secondMagnitude;\n</span><span class=\"lens-source-line\" data-line=\"26\">  let largerBits = select(secondBits, firstBits, firstIsLarger);\n</span><span class=\"lens-source-line\" data-line=\"27\">  let smallerBits = select(firstBits, secondBits, firstIsLarger);\n</span><span class=\"lens-source-line\" data-line=\"28\">  let largerMagnitude = largerBits &amp; 0x7fffffffu;\n</span><span class=\"lens-source-line\" data-line=\"29\">  let smallerMagnitude = smallerBits &amp; 0x7fffffffu;\n</span><span class=\"lens-source-line\" data-line=\"30\">  // Biased exponents (1 for subnormals) and 24-bit significands: |value| = significand * 2^(exponent - 150).\n</span><span class=\"lens-source-line\" data-line=\"31\">  let largerExponent = max(largerMagnitude &gt;&gt; 23u, 1u);\n</span><span class=\"lens-source-line\" data-line=\"32\">  let smallerExponent = max(smallerMagnitude &gt;&gt; 23u, 1u);\n</span><span class=\"lens-source-line\" data-line=\"33\">  let sumExponent = max(sumMagnitude &gt;&gt; 23u, 1u);\n</span><span class=\"lens-source-line\" data-line=\"34\">  // Below 2^-103 the error would be subnormal, where ldexp is not dependable: report none.\n</span><span class=\"lens-source-line\" data-line=\"35\">  if (smallerExponent &lt; 24u) {\n</span><span class=\"lens-source-line\" data-line=\"36\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"37\">  }\n</span><span class=\"lens-source-line\" data-line=\"38\">  let gap = largerExponent - smallerExponent;\n</span><span class=\"lens-source-line\" data-line=\"39\">  if (gap &gt; 25u) {\n</span><span class=\"lens-source-line\" data-line=\"40\">    // The smaller operand is below a quarter of the larger one&#39;s last place: the sum is the larger\n</span><span class=\"lens-source-line\" data-line=\"41\">    // operand and the whole smaller operand is the error.\n</span><span class=\"lens-source-line\" data-line=\"42\">    if (sumBits == largerBits) {\n</span><span class=\"lens-source-line\" data-line=\"43\">      return bitcast&lt;f32&gt;(smallerBits);\n</span><span class=\"lens-source-line\" data-line=\"44\">    }\n</span><span class=\"lens-source-line\" data-line=\"45\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"46\">  }\n</span><span class=\"lens-source-line\" data-line=\"47\">  // The sum&#39;s last place, as a left shift from the smaller operand&#39;s last place. A rounded sum has\n</span><span class=\"lens-source-line\" data-line=\"48\">  // the larger operand&#39;s exponent, the next one (a carry) or the one below (a borrow). Anything\n</span><span class=\"lens-source-line\" data-line=\"49\">  // lower is a cancellation, which is exact, and so is a sum whose last place is finer than the\n</span><span class=\"lens-source-line\" data-line=\"50\">  // smaller operand&#39;s.\n</span><span class=\"lens-source-line\" data-line=\"51\">  if (sumMagnitude == 0u || sumExponent + 1u &lt; largerExponent || sumExponent &gt; largerExponent + 1u ||\n</span><span class=\"lens-source-line\" data-line=\"52\">      sumExponent &lt; smallerExponent) {\n</span><span class=\"lens-source-line\" data-line=\"53\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"54\">  }\n</span><span class=\"lens-source-line\" data-line=\"55\">  let sumShift = sumExponent - smallerExponent;\n</span><span class=\"lens-source-line\" data-line=\"56\">  let largerSignificand = (largerMagnitude &amp; 0x7fffffu) | select(0u, 0x800000u, largerMagnitude &gt;= 0x800000u);\n</span><span class=\"lens-source-line\" data-line=\"57\">  let smallerSignificand = (smallerMagnitude &amp; 0x7fffffu) | select(0u, 0x800000u, smallerMagnitude &gt;= 0x800000u);\n</span><span class=\"lens-source-line\" data-line=\"58\">  let sumSignificand = (sumMagnitude &amp; 0x7fffffu) | select(0u, 0x800000u, sumMagnitude &gt;= 0x800000u);\n</span><span class=\"lens-source-line\" data-line=\"59\">  // Signed integers in units of the smaller operand&#39;s last place, modulo 2^32. Each term can pass\n</span><span class=\"lens-source-line\" data-line=\"60\">  // 2^32, but their combination is at most 2^25 in magnitude, so the wrapped result is exact.\n</span><span class=\"lens-source-line\" data-line=\"61\">  let largerUnits = largerSignificand &lt;&lt; gap;\n</span><span class=\"lens-source-line\" data-line=\"62\">  let sumUnits = sumSignificand &lt;&lt; sumShift;\n</span><span class=\"lens-source-line\" data-line=\"63\">  let signedLarger = select(largerUnits, 0u - largerUnits, (largerBits &amp; 0x80000000u) != 0u);\n</span><span class=\"lens-source-line\" data-line=\"64\">  let signedSmaller = select(smallerSignificand, 0u - smallerSignificand, (smallerBits &amp; 0x80000000u) != 0u);\n</span><span class=\"lens-source-line\" data-line=\"65\">  let signedSum = select(sumUnits, 0u - sumUnits, (sumBits &amp; 0x80000000u) != 0u);\n</span><span class=\"lens-source-line\" data-line=\"66\">  let errorUnits = bitcast&lt;i32&gt;(signedLarger + signedSmaller - signedSum);\n</span><span class=\"lens-source-line\" data-line=\"67\">  // The rounding error of an addition is an f32, so the conversion and the scaling are exact.\n</span><span class=\"lens-source-line\" data-line=\"68\">  return ldexp(f32(errorUnits), i32(smallerExponent) - 150);\n</span><span class=\"lens-source-line\" data-line=\"69\">}\n</span><span class=\"lens-source-line\" data-line=\"70\">\n</span><span class=\"lens-source-line\" data-line=\"71\">\n</span><span class=\"lens-source-line\" data-line=\"72\">fn interpolatePosition(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;, fraction: f32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"73\">  return select(a + (b - a) * fraction, b, fraction &gt;= 1.0);\n</span><span class=\"lens-source-line\" data-line=\"74\">}\n</span><span class=\"lens-source-line\" data-line=\"75\">\n</span><span class=\"lens-source-line\" data-line=\"76\">fn getSegmentLength(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"77\">  return length(b - a);\n</span><span class=\"lens-source-line\" data-line=\"78\">}\n</span><span class=\"lens-source-line\" data-line=\"79\">\n</span><span class=\"lens-source-line\" data-line=\"80\">\n</span><span class=\"lens-source-line\" data-line=\"81\">fn guardedAtan2(y: f32, x: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"82\">  return select(atan2(y, x), sign(y) * 1.5707963267948966, x == 0.0);\n</span><span class=\"lens-source-line\" data-line=\"83\">}\n</span><span class=\"lens-source-line\" data-line=\"84\">\n</span><span class=\"lens-source-line\" data-line=\"85\">fn getSegmentHeading(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; f32 {