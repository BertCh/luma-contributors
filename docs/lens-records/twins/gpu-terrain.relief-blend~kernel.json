ect><rect x=\"341\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"17\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-terrain-relief-blend-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const sourceValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; sourceValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const sourceValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; sourceValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const paddedValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; paddedValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const paddedValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; paddedValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const WIDTH_SIGNED: i32 = 64;\n</span><span class=\"lens-source-line\" data-line=\"14\">const HEIGHT_SIGNED: i32 = 64;\n</span><span class=\"lens-source-line\" data-line=\"15\">const PADDED_WIDTH: u32 = 66u;\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line\" data-line=\"17\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line\" data-line=\"19\">fn readGridSample(column: i32, row: i32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"20\">  let sampleIndex = u32(row * WIDTH_SIGNED + column);\n</span><span class=\"lens-source-line\" data-line=\"21\">  let value = sourceValues[sourceValuesOffset + sampleIndex];\n</span><span class=\"lens-source-line\" data-line=\"22\">  let isValid = sourceValidity[sourceValidityOffset + sampleIndex] != 0u &amp;&amp; isFiniteValue(value);\n</span><span class=\"lens-source-line\" data-line=\"23\">  return vec2&lt;f32&gt;(select(0.0, value, isValid), select(0.0, 1.0, isValid));\n</span><span class=\"lens-source-line\" data-line=\"24\">}\n</span><span class=\"lens-source-line\" data-line=\"25\">\n</span><span class=\"lens-source-line\" data-line=\"26\">// Value &#39;overshoot&#39; cells outside the edge sample a, from a and its inward neighbours b and c.\n</span><span class=\"lens-source-line\" data-line=\"27\">fn extrapolateOutside(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;, c: vec2&lt;f32&gt;, overshoot: f32, extent: i32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"28\">  if (a.y == 0.0 || extent &lt; 2) { return a; }\n</span><span class=\"lens-source-line\" data-line=\"29\">  if (b.y == 0.0) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"30\">  let firstDifference = a.x - b.x;\n</span><span class=\"lens-source-line\" data-line=\"31\">  if (extent &lt; 3 || c.y == 0.0) { return vec2&lt;f32&gt;(a.x + overshoot * firstDifference, 1.0); }\n</span><span class=\"lens-source-line\" data-line=\"32\">  let secondDifference = b.x - c.x;\n</span><span class=\"lens-source-line\" data-line=\"33\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"34\">    a.x + 0.5 * overshoot * (3.0 * firstDifference - secondDifference) +\n</span><span class=\"lens-source-line\" data-line=\"35\">      0.5 * overshoot * overshoot * (firstDifference - secondDifference),\n</span><span class=\"lens-source-line\" data-line=\"36\">    1.0\n</span><span class=\"lens-source-line\" data-line=\"37\">  );\n</span><span class=\"lens-source-line\" data-line=\"38\">}\n</span><span class=\"lens-source-line\" data-line=\"39\">// &#39;column&#39; is inside the grid; &#39;row&#39; may be outside.\n</span><span class=\"lens-source-line\" data-line=\"40\">fn readRowExtendedSample(column: i32, row: i32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"41\">  if (row &gt;= 0 &amp;&amp; row &lt; HEIGHT_SIGNED) { return readGridSample(column, row); }\n</span><span class=\"lens-source-line\" data-line=\"42\">  let isBefore = row &lt; 0;\n</span><span class=\"lens-source-line\" data-line=\"43\">  let edge = select(HEIGHT_SIGNED - 1, 0, isBefore);\n</span><span class=\"lens-source-line\" data-line=\"44\">  let inward = select(-1, 1, isBefore);\n</span><span class=\"lens-source-line\" data-line=\"45\">  let overshoot = f32(select(row - (HEIGHT_SIGNED - 1), -row, isBefore));\n</span><span class=\"lens-source-line\" data-line=\"46\">  return extrapolateOutside(\n</span><span class=\"lens-source-line\" data-line=\"47\">    readGridSample(column, edge),\n</span><span class=\"lens-source-line\" data-line=\"48\">    readGridSample(column, clamp(edge + inward, 0, HEIGHT_SIGNED - 1)),\n</span><span class=\"lens-source-line\" data-line=\"49\">    readGridSample(column, clamp(edge + 2 * inward, 0, HEIGHT_SIGNED - 1)),\n</span><span class=\"lens-source-line\" data-line=\"50\">    overshoot,\n</span><span class=\"lens-source-line\" data-line=\"51\">    HEIGHT_SIGNED\n</span><span class=\"lens-source-line\" data-line=\"52\">  );\n</span><span class=\"lens-source-line\" data-line=\"53\">}\n</span><span class=\"lens-source-line\" data-line=\"54\">fn readExtendedSample(column: i32, row: i32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"55\">  if (column &gt;= 0 &amp;&amp; column &lt; WIDTH_SIGNED) { return readRowExtendedSample(column, row); }\n</span><span class=\"lens-source-line\" data-line=\"56\">  let isBefore = column &lt; 0;\n</span><span class=\"lens-source-line\" data-line=\"57\">  let edge = select(WIDTH_SIGNED - 1, 0, isBefore);\n</span><span class=\"lens-source-line\" data-line=\"58\">  let inward = select(-1, 1, isBefore);\n</span><span class=\"lens-source-line\" data-line=\"59\">  let overshoot = f32(select(column - (WIDTH_SIGNED - 1), -column, isBefore));\n</span><span class=\"lens-source-line\" data-line=\"60\">  return extrapolateOutside(\n</span><span class=\"lens-source-line\" data-line=\"61\">    readRowExtendedSample(edge, row),\n</span><span class=\"lens-source-line\" data-line=\"62\">    readRowExtendedSample(clamp(edge + inward, 0, WIDTH_SIGNED - 1), row),\n</span><span class=\"lens-source-line\" data-line=\"63\">    readRowExtendedSample(clamp(edge + 2 * inward, 0, WIDTH_SIGNED - 1), row),\n</span><span class=\"lens-source-line\" data-line=\"64\">    overshoot,\n</span><span class=\"lens-source-line\" data-line=\"65\">    WIDTH_SIGNED\n</span><span class=\"lens-source-line\" data-line=\"66\">  );\n</span><span class=\"lens-source-line\" data-line=\"67\">}\n</span><span class=\"lens-source-line\" data-line=\"68\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"69\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"70\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"71\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"72\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"73\">) {\n</span><span class=\"lens-source-line\" data-line=\"74\">  _ = &amp;sourceValues;\n</span><span class=\"lens-source-line\" data-line=\"75\">  _ = &amp;sourceValidity;\n</span><span class=\"lens-source-line\" data-line=\"76\">  _ = &amp;paddedValues;\n</span><span class=\"lens-source-line\" data-line=\"77\">  _ = &amp;paddedValidity;\n</span><span class=\"lens-source-line\" data-line=\"78\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"79\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"80\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"81\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"82\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"83\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"84\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"85\">    return;\n</span><span class=\"lens-source-line\" data-line=\"86\">  }\n</span><span class=\"lens-source-line\" data-line=\"87\">  let paddedRow = i32(index / PADDED_WIDTH);\n</span><span class=\"lens-source-line\" data-line=\"88\">  let paddedColumn = i32(index % PADDED_WIDTH);\n</span><span class=\"lens-source-line\" data-line=\"89\">  let extended = readExtendedSample(paddedColumn - 1, paddedRow - 1);\n</span><span class=\"lens-source-line\" data-line=\"90\">  let isValid = extended.y != 0.0 &amp;&amp; isFiniteValue(extended.x);\n</span><span class=\"lens-source-line\" data-line=\"91\">  paddedValues[paddedValuesOffset + index] =\n</span><span class=\"lens-source-line\" data-line=\"92\">    select(bitcast&lt;f32&gt;(0x7fc00000u | (index &amp; 0u)), extended.x, isValid);\n</span><span class=\"lens-source-line\" data-line=\"93\">  paddedValidity[paddedValidityOffset + index] = select(0u, 1u, isValid);\n</span><span class=\"lens-source-line\" data-line=\"94\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>sourceValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-derivatives-elevation-values\">terrain-derivatives-elevation-values</td><td>read</td><td>f32</td></tr><tr><td>sourceValidity<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-derivatives-elevation-validity\">terrain-derivatives-elevation-validity</td><td>read</td><td>u32</td></tr><tr><td>paddedValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-derivatives-padded-values\">terrain-derivatives-padded-values</td><td>read_write</td><td>f32</td></tr><tr><td>paddedValidity<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-derivatives-padded-validity\">terrain-derivatives-padded-validity</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUTerrainDerivatives/one-sided-padding · main · 8d45ee58</figcaption></figure></section>",
