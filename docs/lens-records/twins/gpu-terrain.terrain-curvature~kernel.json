-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const elevationValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; elevationValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const elevationValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; elevationValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const settingsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; settings: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const output0Offset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; output0: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const output1Offset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; output1: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const HEIGHT: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const WIDTH_SIGNED: i32 = 64;\n</span><span class=\"lens-source-line\" data-line=\"18\">const HEIGHT_SIGNED: i32 = 64;\n</span><span class=\"lens-source-line\" data-line=\"19\">var&lt;private&gt; windowValid: bool;\n</span><span class=\"lens-source-line\" data-line=\"20\">var&lt;private&gt; ringValid: bool;\n</span><span class=\"lens-source-line\" data-line=\"21\">var&lt;private&gt; windowCentre: f32;\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"24\">\n</span><span class=\"lens-source-line\" data-line=\"25\">fn getGroundCellSize(row: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"26\">  let cellSize = vec2&lt;f32&gt;(settings[settingsOffset + 0u], settings[settingsOffset + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"27\">  return cellSize;\n</span><span class=\"lens-source-line\" data-line=\"28\">}\n</span><span class=\"lens-source-line\" data-line=\"29\">// In-grid elevation minus the window centre; .y is 1 when the sample is valid.\n</span><span class=\"lens-source-line\" data-line=\"30\">fn readGridSample(column: i32, row: i32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"31\">  let sampleIndex = u32(row * WIDTH_SIGNED + column);\n</span><span class=\"lens-source-line\" data-line=\"32\">  let value = elevationValues[elevationValuesOffset + sampleIndex];\n</span><span class=\"lens-source-line\" data-line=\"33\">  let isValid = elevationValidity[elevationValidityOffset + sampleIndex] != 0u &amp;&amp; isFiniteValue(value);\n</span><span class=\"lens-source-line\" data-line=\"34\">  return vec2&lt;f32&gt;(select(0.0, value - windowCentre, isValid), select(0.0, 1.0, isValid));\n</span><span class=\"lens-source-line\" data-line=\"35\">}\n</span><span class=\"lens-source-line\" data-line=\"36\">\n</span><span class=\"lens-source-line\" data-line=\"37\">// Value &#39;overshoot&#39; cells outside the edge sample a, from a and its inward neighbours b and c.\n</span><span class=\"lens-source-line\" data-line=\"38\">fn extrapolateOutside(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;, c: vec2&lt;f32&gt;, overshoot: f32, extent: i32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"39\">  if (a.y == 0.0 || extent &lt; 2) { return a; }\n</span><span class=\"lens-source-line\" data-line=\"40\">  if (b.y == 0.0) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"41\">  let firstDifference = a.x - b.x;\n</span><span class=\"lens-source-line\" data-line=\"42\">  if (extent &lt; 3 || c.y == 0.0) { return vec2&lt;f32&gt;(a.x + overshoot * firstDifference, 1.0); }\n</span><span class=\"lens-source-line\" data-line=\"43\">  let secondDifference = b.x - c.x;\n</span><span class=\"lens-source-line\" data-line=\"44\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"45\">    a.x + 0.5 * overshoot * (3.0 * firstDifference - secondDifference) +\n</span><span class=\"lens-source-line\" data-line=\"46\">      0.5 * overshoot * overshoot * (firstDifference - secondDifference),\n</span><span class=\"lens-source-line\" data-line=\"47\">    1.0\n</span><span class=\"lens-source-line\" data-line=\"48\">  );\n</span><span class=\"lens-source-line\" data-line=\"49\">}\n</span><span class=\"lens-source-line\" data-line=\"50\">// &#39;column&#39; is inside the grid; &#39;row&#39; may be outside.\n</span><span class=\"lens-source-line\" data-line=\"51\">fn readRowExtendedSample(column: i32, row: i32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"52\">  if (row &gt;= 0 &amp;&amp; row &lt; HEIGHT_SIGNED) { return readGridSample(column, row); }\n</span><span class=\"lens-source-line\" data-line=\"53\">  let isBefore = row &lt; 0;\n</span><span class=\"lens-source-line\" data-line=\"54\">  let edge = select(HEIGHT_SIGNED - 1, 0, isBefore);\n</span><span class=\"lens-source-line\" data-line=\"55\">  let inward = select(-1, 1, isBefore);\n</span><span class=\"lens-source-line\" data-line=\"56\">  let overshoot = f32(select(row - (HEIGHT_SIGNED - 1), -row, isBefore));\n</span><span class=\"lens-source-line\" data-line=\"57\">  return extrapolateOutside(\n</span><span class=\"lens-source-line\" data-line=\"58\">    readGridSample(column, edge),\n</span><span class=\"lens-source-line\" data-line=\"59\">    readGridSample(column, clamp(edge + inward, 0, HEIGHT_SIGNED - 1)),\n</span><span class=\"lens-source-line\" data-line=\"60\">    readGridSample(column, clamp(edge + 2 * inward, 0, HEIGHT_SIGNED - 1)),\n</span><span class=\"lens-source-line\" data-line=\"61\">    overshoot,\n</span><span class=\"lens-source-line\" data-line=\"62\">    HEIGHT_SIGNED\n</span><span class=\"lens-source-line\" data-line=\"63\">  );\n</span><span class=\"lens-source-line\" data-line=\"64\">}\n</span><span class=\"lens-source-line\" data-line=\"65\">fn readExtendedSample(column: i32, row: i32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"66\">  if (column &gt;= 0 &amp;&amp; column &lt; WIDTH_SIGNED) { return readRowExtendedSample(column, row); }\n</span><span class=\"lens-source-line\" data-line=\"67\">  let isBefore = column &lt; 0;\n</span><span class=\"lens-source-line\" data-line=\"68\">  let edge = select(WIDTH_SIGNED - 1, 0, isBefore);\n</span><span class=\"lens-source-line\" data-line=\"69\">  let inward = select(-1, 1, isBefore);\n</span><span class=\"lens-source-line\" data-line=\"70\">  let overshoot = f32(select(column - (WIDTH_SIGNED - 1), -column, isBefore));\n</span><span class=\"lens-source-line\" data-line=\"71\">  return extrapolateOutside(\n</span><span class=\"lens-source-line\" data-line=\"72\">    readRowExtendedSample(edge, row),\n</span><span class=\"lens-source-line\" data-line=\"73\">    readRowExtendedSample(clamp(edge + inward, 0, WIDTH_SIGNED - 1), row),\n</span><span class=\"lens-source-line\" data-line=\"74\">    readRowExtendedSample(clamp(edge + 2 * inward, 0, WIDTH_SIGNED - 1), row),\n</span><span class=\"lens-source-line\" data-line=\"75\">    overshoot,\n</span><span class=\"lens-source-line\" data-line=\"76\">    WIDTH_SIGNED\n</span><span class=\"lens-source-line\" data-line=\"77\">  );\n</span><span class=\"lens-source-line\" data-line=\"78\">}\n</span><span class=\"lens-source-line\" data-line=\"79\">// Elevation of an offset sample minus the centre elevation; flags the window invalid on failure.\n</span><span class=\"lens-source-line\" data-line=\"80\">fn readWindowDelta(column: u32, row: u32, dx: i32, dy: i32, centre: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"81\">  var sampleColumn = i32(column) + dx;\n</span><span class=\"lens-source-line\" data-line=\"82\">  var sampleRow = i32(row) + dy;\n</span><span class=\"lens-source-line\" data-line=\"83\">  if (sampleColumn &lt; 0 || sampleRow &lt; 0 || sampleColumn &gt;= WIDTH_SIGNED || sampleRow &gt;= HEIGHT_SIGNED) {\n</span><span class=\"lens-source-line\" data-line=\"84\">    // One-sided border: extrapolate the centre-relative surface past the edge.\n</span><span class=\"lens-source-line\" data-line=\"85\">    let extended = readExtendedSample(sampleColumn, sampleRow);\n</span><span class=\"lens-source-line\" data-line=\"86\">    if (extended.y == 0.0) { windowValid = false; }\n</span><span class=\"lens-source-line\" data-line=\"87\">    return extended.x;\n</span><span class=\"lens-source-line\" data-line=\"88\">  }\n</span><span class=\"lens-source-line\" data-line=\"89\">  let sampleIndex = u32(sampleRow) * WIDTH + u32(sampleColumn);\n</span><span class=\"lens-source-line\" data-line=\"90\">  let value = elevationValues[elevationValuesOffset + sampleIndex];\n</span><span class=\"lens-source-line\" data-line=\"91\">  if (elevationValidity[elevationValidityOffset + sampleIndex] == 0u || !isFiniteValue(value)) {\n</span><span class=\"lens-source-line\" data-line=\"92\">    windowValid = false;\n</span><span class=\"lens-source-line\" data-line=\"93\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"94\">  }\n</span><span class=\"lens-source-line\" data-line=\"95\">  return value - centre;\n</span><span class=\"lens-source-line\" data-line=\"96\">}\n</span><span class=\"lens-source-line\" data-line=\"97\">// Ring samples never clamp: any sample outside the raster or invalid invalidates the ring.\n</span><span class=\"lens-source-line\" data-line=\"98\">fn readRingDelta(column: u32, row: u32, dx: i32, dy: i32, centre: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"99\">  let sampleColumn = i32(column) + dx;\n</span><span class=\"lens-source-line\" data-line=\"100\">  let sampleRow = i32(row) + dy;\n</span><span class=\"lens-source-line\" data-line=\"101\">  if (sampleColumn &lt; 0 || sampleRow &lt; 0 || sampleColumn &gt;= WIDTH_SIGNED || sampleRow &gt;= HEIGHT_SIGNED) {\n</span><span class=\"lens-source-line\" data-line=\"102\">    ringValid = false;\n</span><span class=\"lens-source-line\" data-line=\"103\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"104\">  }\n</span><span class=\"lens-source-line\" data-line=\"105\">  let sampleIndex = u32(sampleRow) * WIDTH + u32(sampleColumn);\n</span><span class=\"lens-source-line\" data-line=\"106\">  let value = elevationValues[elevationValuesOffset + sampleIndex];\n</span><span class=\"lens-source-line\" data-line=\"107\">  if (elevationValidity[elevationValidityOffset + sampleIndex] == 0u || !isFiniteValue(value)) {\n</span><span class=\"lens-source-line\" data-line=\"108\">    ringValid = false;\n</span><span class=\"lens-source-line\" data-line=\"109\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"110\">  }\n</span><span class=\"lens-source-line\" data-line=\"111\">  return value - centre;\n</span><span class=\"lens-source-line\" data-line=\"112\">}\n</span><span class=\"lens-source-line\" data-line=\"113\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"114\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"115\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"116\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"117\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"118\">) {\n</span><span class=\"lens-source-line\" data-line=\"119\">  _ = &amp;elevationValues;\n</span><span class=\"lens-source-line\" data-line=\"120\">  _ = &amp;elevationValidity;\n</span><span class=\"lens-source-line\" data-line=\"121\">  _ = &amp;settings;\n</span><span class=\"lens-source-line\" data-line=\"122\">  _ = &amp;output0;\n</span><span class=\"lens-source-line\" data-line=\"123\">  _ = &amp;output1;\n</span><span class=\"lens-source-line\" data-line=\"124\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"125\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"126\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"127\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"128\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"129\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"130\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"131\">    return;\n</span><span class=\"lens-source-line\" data-line=\"132\">  }\n</span><span class=\"lens-source-line\" data-line=\"133\">  let row = index / WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"134\">  let column = index - row * WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"135\">  let centre = elevationValues[elevationValuesOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"136\">  let centreValid = elevationValidity[elevationValidityOffset + index] != 0u &amp;&amp; isFiniteValue(centre);\n</span><span class=\"lens-source-line\" data-line=\"137\">  let groundCell = getGroundCellSize(row);\n</span><span class=\"lens-source-line\" data-line=\"138\">  let wx = groundCell.x;\n</span><span class=\"lens-source-line\" data-line=\"139\">  let wy = groundCell.y;\n</span><span class=\"lens-source-line\" data-line=\"140\">  let zFactor = settings[settingsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"141\">  let cellsValid = wx &gt; 0.0 &amp;&amp; wy &gt; 0.0 &amp;&amp; isFiniteValue(wx) &amp;&amp; isFiniteValue(wy) &amp;&amp; isFiniteValue(zFactor);\n</span><span class=\"lens-source-line\" data-line=\"142\">  let cellMetres = sqrt(wx * wy);\n</span><span class=\"lens-source-line\" data-line=\"143\">  let invalidValue = bitcast&lt;f32&gt;(0x7fc00000u | (index &amp; 0u));\n</span><span class=\"lens-source-line\" data-line=\"144\">  win