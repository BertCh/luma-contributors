    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>terrain-line-of-sight-line-of-sight · 1×1×1 workgroups × 32×1×1 lanes = 32 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-terrain-terrain-line-of-sight-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 32\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><rect x=\"2\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 0</title></rect><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><rect x=\"42\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 1</title></rect><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><rect x=\"82\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 2</title></rect><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=