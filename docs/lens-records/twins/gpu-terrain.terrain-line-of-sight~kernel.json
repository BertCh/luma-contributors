></rect><text x=\"805\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">20</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"21\"><rect x=\"842\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"845\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">21</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"22\"><rect x=\"882\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"885\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">22</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"23\"><rect x=\"922\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"925\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">23</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"24\"><rect x=\"962\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"965\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">24</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"25\"><rect x=\"1002\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1005\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">25</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"26\"><rect x=\"1042\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1045\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">26</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"27\"><rect x=\"1082\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1085\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">27</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"28\"><rect x=\"1122\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">28</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"29\"><rect x=\"1162\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">29</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"30\"><rect x=\"1202\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">30</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"31\"><rect x=\"1242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">31</text></g></svg><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const elevationValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; elevationValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const elevationValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; elevationValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const settingsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; settings: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const pairsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; pairs: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const visibilityValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; visibilityValues: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const clearanceValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; clearanceValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const HEIGHT: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"19\">const HIDDEN: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"20\">const VISIBLE: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"21\">const OUT_OF_RANGE: u32 = 2u;\n</span><span class=\"lens-source-line\" data-line=\"22\">const NO_DATA: u32 = 3u;\n</span><span class=\"lens-source-line\" data-line=\"23\">const MARGINAL: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"24\">const MAXIMUM_FLOAT: f32 = 3.4028234663852886e38;\n</span><span class=\"lens-source-line\" data-line=\"25\">const SKIP_EPSILON: f32 = 0.00000762939453125;\n</span><span class=\"lens-source-line\" data-line=\"26\">\n</span><span class=\"lens-source-line\" data-line=\"27\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"28\">\n</span><span class=\"lens-source-line\" data-line=\"29\">\n</span><span class=\"lens-source-line\" data-line=\"30\">fn isValidPixel(column: u32, row: u32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"31\">  return elevationValidity[elevationValidityOffset + row * WIDTH + column] != 0u;\n</span><span class=\"lens-source-line\" data-line=\"32\">}\n</span><span class=\"lens-source-line\" data-line=\"33\">fn getElevation(column: u32, row: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"34\">  return elevationValues[elevationValuesOffset + row * WIDTH + column];\n</span><span class=\"lens-source-line\" data-line=\"35\">}\n</span><span class=\"lens-source-line\" data-line=\"36\">fn interpolateElevation(first: f32, second: f32, fraction: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"37\">  if (fraction == 0.0 || first == second) { return first; }\n</span><span class=\"lens-source-line\" data-line=\"38\">  if (fraction == 1.0) { return second; }\n</span><span class=\"lens-source-line\" data-line=\"39\">  return mix(first, second, fraction);\n</span><span class=\"lens-source-line\" data-line=\"40\">}\n</span><span class=\"lens-source-line\" data-line=\"41\">// Bilinear elevation at a clamped pixel-center position; only positive-weight corners participate.\n</span><span class=\"lens-source-line\" data-line=\"42\">fn sampleElevation(position: vec2&lt;f32&gt;) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"43\">  let maximum = vec2&lt;f32&gt;(f32(WIDTH - 1u), f32(HEIGHT - 1u));\n</span><span class=\"lens-source-line\" data-line=\"44\">  let clamped = clamp(position, vec2&lt;f32&gt;(0.0), maximum);\n</span><span class=\"lens-source-line\" data-line=\"45\">  let base = vec2&lt;u32&gt;(floor(clamped));\n</span><span class=\"lens-source-line\" data-line=\"46\">  let next = min(base + vec2&lt;u32&gt;(1u), vec2&lt;u32&gt;(WIDTH - 1u, HEIGHT - 1u));\n</span><span class=\"lens-source-line\" data-line=\"47\">  let fraction = clamped - floor(clamped);\n</span><span class=\"lens-source-line\" data-line=\"48\">  let weights = vec4&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"49\">    (1.0 - fraction.x) * (1.0 - fraction.y), fraction.x * (1.0 - fraction.y),\n</span><span class=\"lens-source-line\" data-line=\"50\">    (1.0 - fraction.x) * fraction.y, fraction.x * fraction.y\n</span><span class=\"lens-source-line\" data-line=\"51\">  );\n</span><span class=\"lens-source-line\" data-line=\"52\">  // Neutral finite values for unused corners keep interpolation free of 0 * NaN.\n</span><span class=\"lens-source-line\" data-line=\"53\">  var corner00 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"54\">  var corner10 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"55\">  var corner01 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"56\">  var corner11 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"57\">  if (weights.x &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"58\">    corner00 = getElevation(base.x, base.y);\n</span><span class=\"lens-source-line\" data-line=\"59\">    if (!isFiniteValue(corner00)) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"60\">  }\n</span><span class=\"lens-source-line\" data-line=\"61\">  if (weights.y &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"62\">    corner10 = getElevation(next.x, base.y);\n</span><span class=\"lens-source-line\" data-line=\"63\">    if (!isFiniteValue(corner10)) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"64\">  }\n</span><span class=\"lens-source-line\" data-line=\"65\">  if (weights.z &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"66\">    corner01 = getElevation(base.x, next.y);\n</span><span class=\"lens-source-line\" data-line=\"67\">    if (!isFiniteValue(corner01)) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"68\">  }\n</span><span class=\"lens-source-line\" data-line=\"69\">  if (weights.w &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"70\">    corner11 = getElevation(next.x, next.y);\n</span><span class=\"lens-source-line\" data-line=\"71\">    if (!isFiniteValue(corner11)) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"72\">  }\n</span><span class=\"lens-source-line\" data-line=\"73\">  let top = interpolateElevation(corner00, corner10, fraction.x);\n</span><span class=\"lens-source-line\" data-line=\"74\">  let bottom = interpolateElevation(corner01, corner11, fraction.x);\n</span><span class=\"lens-source-line\" data-line=\"75\">  return vec2&lt;f32&gt;(interpolateElevation(top, bottom, fraction.y), 1.0);\n</span><span class=\"lens-source-line\" data-line=\"76\">}\n</span><span class=\"lens-source-line\" data-line=\"77\">\n</span><span class=\"lens-source-line\" data-line=\"78\">// Integer endpoint coordinates retain exact lattice hits. Reduce k/n before multiplying so\n</span><span class=\"lens-source-line\" data-line=\"79\">// divisibility is decided in u32 arithmetic, without a rounded reciprocal or a wide product.\n</span><span class=\"lens-source-line\" data-line=\"80\">fn rayCoordinate(origin: f32, delta: f32, sampleIndex: u32, count: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"81\">  let magnitude = abs(delta);\n</span><span class=\"lens-source-line\" data-line=\"82\">  if (origin == floor(origin) &amp;&amp; magnitude == floor(magnitude)) {\n</span><span class=\"lens-source-line\" data-line=\"83\">    let integerDelta = u32(magnitude);\n</span><span class=\"lens-source-line\" data-line=\"84\">    if (integerDelta == 0u) { return origin; }\n</span><span class=\"lens-source-line\" data-line=\"85\">    var divisor = count;\n</span><span class=\"lens-source-line\" data-line=\"86\">    var multiplier = sampleIndex;\n</span><span class=\"lens-source-line\" data-line=\"87\">    if (integerDelta != count) {\n</span><span class=\"lens-source-line\" data-line=\"88\">      var first = count;\n</span><span class=\"lens-source-line\" data-line=\"89\">      var second = sampleIndex;\n</span><span class=\"lens-source-line\" data-line=\"90\">      // Euclid on u32 takes fewer than 48 remainder steps (consecutive Fibonacci worst case).\n</span><span class=\"lens-source-line\" data-line=\"91\">      for (var iteration = 0u; iteration &lt; 48u; iteration++) {\n</span><span class=\"lens-source-line\" data-line=\"92\">        if (second == 0u) { break; }\n</span><span class=\"lens-source-line\" data-line=\"93\">        let remainder = first % second;\n</span><span class=\"lens-source-line\" data-line=\"94\">        first = second;\n</span><span class=\"lens-source-line\" data-line=\"95\">        second = remainder;\n</span><span class=\"lens-source-line\" data-line=\"96\">      }\n</span><span class=\"lens-source-line\" data-line=\"97\">      divisor = count / first;\n</span><span class=\"lens-source-line\" data-line=\"98\">      multiplier = sampleIndex / first;\n</span><span class=\"lens-source-line\" data-line=\"99\">    }\n</span><span class=\"lens-source-line\" data-line=\"100\">    if (integerDelta % divisor == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"101\">      let offset = (integerDelta / divisor) * multiplier;\n</span><span class=\"lens-source-line\" data-line=\"102\">      if (delta &lt; 0.0) { return f32(u32(origin) - offset); }\n</span><span class=\"lens-source-line\" data-line=\"103\">      return f32(u32(origin) + offset);\n</span><span class=\"lens-source-line\" data-line=\"104\">    }\n</span><span class=\"lens-source-line\" data-line=\"105\">  }\n</span><span class=\"lens-source-line\" data-line=\"106\">  return origin + delta * (f32(sampleIndex) / f32(count));\n</span><span class=\"lens-source-line\" data-line=\"107\">}\n</span><span class=\"lens-source-line\" data-line=\"108\">fn rayPosition(observer: vec2&lt;f32&gt;, delta: vec2&lt;f32&gt;, sampleIndex: u32, count: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"109\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"110\">    rayCoordinate(observer.x, delta.x, sampleIndex, count),\n</span><span class=\"lens-source-line\" data-line=\"111\">    rayCoordinate(observer.y, delta.y, sampleIndex, count)\n</span><span class=\"lens-source-line\" data-line=\"112\">  );\n</span><span class=\"lens-source-line\" data-line=\"113\">}\n</span><span class=\"lens-source-line\" data-line=\"114\">fn rayDistance(targetDistance: f32, sampleIndex: u32, count: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"115\">  let fraction = f32(sampleIndex) / f32(count);\n</span><span class=\"lens-source-line\" data-line=\"116\">  return targetDistance * fraction;\n</span><span class=\"lens-source-line\" data-line=\"117\">}\n</span><span class=\"lens-source-line\" data-line=\"118\">struct SightLineResult {\n</span><span class=\"lens-source-line\" data-line=\"119\">  code: u32,\n</span><span class=\"lens-source-line\" data-line=\"120\">  clearance: f32\n</span><span class=\"lens-source-line\" data-line=\"121\">}\n</span><span class=\"lens-source-line\" data-line=\"122\">\n</span><span class=\"lens-source-line\" data-line=\"123\">// Observer and target are pixel-center positions; eye is the observer elevation (ground + height);\n</span><span class=\"lens-source-line\" data-line=\"124\">// targetTop is the target elevation (ground + height) before the curvature drop;\n</span><span class=\"lens-source-line\" data-line=\"125\">// tolerance is [toleranceMeters, tolerancePerKilometer, targetIgnoreDistance, targetIgnoreFraction].\n</span><span class=\"lens-source-line\" data-line=\"126\">fn traceSightLine(\n</span><span class=\"lens-source-line\" data-line=\"127\">  observer: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"128\">  targetPosition: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"129\">  eye: f32,\n</span><span class=\"lens-source-line\" data-line=\"130\">  targetTop: f32,\n</span><span class=\"lens-source-line\" data-line=\"131\">  cellSize: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"132\">  curvature: f32,\n</span><span class=\"lens-source-line\" data-line=\"133\">  maxDistance: f32,\n</span><span class=\"lens-source-line\" data-line=\"134\">  tolerance: vec4&lt;f32&gt;\n</span><span class=\"lens-source-line\" data-line=\"135\">) -&gt; SightLineResult {\n</span><span class=\"lens-source-line\" data-line=\"136\">  if (!isFiniteValue(eye) || !isFiniteValue(targetTop)) {\n</span><span class=\"lens-source-line\" data-line=\"137\">    return SightLineResult(NO_DATA, bitcast&lt;f32&gt;(0x7fc00000u | (bitcast&lt;u32&gt;(eye) &amp; 0u)));\n</span><span class=\"lens-source-line\" data-line=\"138\">  }\n</span><span class=\"lens-source-line\" data-line=\"139\">  let delta = targetPosition - observer;\n</span><span class=\"lens-source-line\" data-line=\"140\">  let targetDistance = length(delta * cellSize);\n</span><span class=\"lens-source-line\" data-line=\"141\">  if (maxDistance &gt; 0.0 &amp;&amp; targetDistance &gt; maxDistance) {\n</span><span class=\"lens-source-line\" data-line=\"142\">    return SightLineResult(OUT_OF_RANGE, 0.0);\n</span><span class=\"lens-source-line\" data-line=\"143\">  }\n</span><span class=\"lens-source-line\" data-line=\"144\">  if (targetDistance == 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"145\">    return SightLineResult(VISIBLE, MAXIMUM_FLOAT);\n</span><span class=\"lens-source-line\" data-line=\"146\">  }\n</span><span class=\"lens-source-line\" data-line=\"147\">  let targetElevation = targetTop - curvature * targetDistance * targetDistance;\n</span><span class=\"lens-source-line\" data-line=\"148\">  let targetSlope = (targetElevation - eye) / targetDistance;\n</span><span class=\"lens-source-line\" data-line=\"149\">  let band = (tolerance.x + tolerance.y * targetDistance / 1000.0) / targetDistance;\n</span><span class=\"lens-source-line\" data-line=\"150\">  let highLimit = targetSlope + band;\n</span><span class=\"lens-source-line\" data-line=\"151\">  let lowLimit = targetSlope - band;\n</span><span class=\"lens-source-line\" data-line=\"152\">  let stopDistance = targetDistance - max(tolerance.z, tolerance.w * targetDistance);\n</span><span class=\"lens-source-line\" data-line=\"153\">  let stepCount = u32(ceil(max(abs(delta.x), abs(delta.y))));\n</span><span class=\"lens-source-line\" data-line=\"154\">  var maxSlope = -MAXIMUM_FLOAT;\n</span><span class=\"lens-source-line\" data-line=\"155\">  var tested = false;\n</span><span class=\"lens-source-line\" data-line=\"156\">  var sampleIndex = 1u;\n</span><span class=\"lens-source-line\" data-line=\"157\">  var skipLevel = 0u;\n</span><span class=\"lens-source-line\" data-line=\"158\">  loop {\n</span><span class=\"lens-source-line\" data-line=\"159\">    if (sampleIndex &gt;= stepCount) { break; }\n</span><span class=\"lens-source-line\" data-line=\"160\">    if (rayDistance(targetDistance, sampleIndex, stepCount) &gt; stopDistance) { break; }\n</span><span class=\"lens-source-line\" data-line=\"161\">    let current = sampleIndex;\n</span><span class=\"lens-source-line\" data-line=\"162\">    sampleIndex = sampleIndex + 1u;\n</span><span class=\"lens-source-line\" data-line=\"163\">    let elevationSample = sampleElevation(rayPosition(observer, delta, current, stepCount));\n</span><span class=\"lens-source-line\" data-line=\"164\">    // Invalid samples never block.\n</span><span class=\"lens-source-line\" data-line=\"165\">    if (elevationSample.y == 0.0) { continue; }\n</span><span class=\"lens-source-line\" data-line=\"166\">    let sampleDistance = rayDistance(targetDistance, current, stepCount);\n</span><span class=\"lens-source-line\" data-line=\"167\">    let sampleSlope =\n</span><span class=\"lens-source-line\" data-line=\"168\">      (elevationSample.x - curvature * sampleDistance * sampleDistance - eye) / sampleDistance;\n</span><span class=\"lens-source-line\" data-line=\"169\">    tested = true;\n</span><span class=\"lens-source-line\" data-line=\"170\">    if (sampleSlope &gt; maxSlope) {\n</span><span class=\"lens-source-line\" data-line=\"171\">      maxSlope = sampleSlope;\n</span><span class=\"lens-source-line\" data-line=\"172\">    }\n</span><span class=\"lens-source-line\" data-line=\"173\">  }\n</span><span class=\"lens-source-line\" data-line=\"174\">  var code = MARGINAL;\n</span><span class=\"lens-source-line\" data-line=\"175\">  if (maxSlope &gt; highLimit) {\n</span><span class=\"lens-source-line\" data-line=\"176\">    code = HIDDEN;\n</span><span class=\"lens-source-line\" data-line=\"177\">  } else if (maxSlope &lt;= lowLimit) {\n</span><span class=\"lens-source-line\" data-line=\"178\">    code = VISIBLE;\n</span><span class=\"lens-source-line\" data-line=\"179\">  }\n</span><span class=\"lens-source-line\" data-line=\"180\">  return SightLineResult(code, select(MAXIMUM_FLOAT, (targetSlope - maxSlope) * targetDistance, tested));\n</span><span class=\"lens-source-line\" data-line=\"181\">}\n</span><span class=\"lens-source-line\" data-line=\"182\">fn isInsideGrid(position: vec2&lt;f32&gt;) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"183\">  return isFiniteValue(position.x) &amp;&amp; isFiniteValue(position.y) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"184\">    position.x &gt;= 0.0 &amp;&amp; position.y &gt;= 0.0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"185\">    position.x &lt;= f32(WIDTH - 1u) &amp;&amp; position.y &lt;= f32(HEIGHT - 1u);\n</span><span class=\"lens-source-line\" data-line=\"186\">}\n</span><span class=\"lens-source-line\" data-line=\"187\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"188\">@compute @workgroup_size(32)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"189\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"190\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"191\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"192\">) {\n</span><span class=\"lens-source-line\" data-line=\"193\">  _ = &amp;elevationValues;\n</span><sp