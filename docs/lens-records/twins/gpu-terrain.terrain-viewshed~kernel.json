    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>terrain-viewshed-viewshed · 16×1×1 workgroups × 256×1×1 lanes = 4096 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-terrain-terrain-viewshed-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect><rect x=\"21\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"1\"></rect><rect x=\"41\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"2\"></rect><rect x=\"61\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"3\"></rect><rect x=\"81\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"4\"></rect><rect x=\"101\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"5\"></rect><rect x=\"121\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"6\"></rect><rect x=\"141\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"7\"></rect><rect x=\"161\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"8\"></rect><rect x=\"181\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"9\"></rect><rect x=\"201\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"10\"></rect><rect x=\"221\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"11\"></rect><rect x=\"241\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"12\"></rect><rect x=\"261\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"13\"></rect><rect x=\"281\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"14\"></rect><rect x=\"301\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"15\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-terrain-terrain-viewshed-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const elevationValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; elevationValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const elevationValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; elevationValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const settingsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; settings: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const visibilityValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; visibilityValues: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const HEIGHT: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const HIDDEN: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const VISIBLE: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const OUT_OF_RANGE: u32 = 2u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const NO_DATA: u32 = 3u;\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"21\">\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">// Integer endpoint coordinates retain exact lattice hits. Reduce k/n before multiplying so\n</span><span class=\"lens-source-line\" data-line=\"24\">// divisibility is decided in u32 arithmetic, without a rounded reciprocal or a wide product.\n</span><span class=\"lens-source-line\" data-line=\"25\">fn rayCoordinate(origin: f32, delta: f32, sampleIndex: u32, count: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"26\">  let magnitude = abs(delta);\n</span><span class=\"lens-source-line\" data-line=\"27\">  if (origin == floor(origin) &amp;&amp; magnitude == floor(magnitude)) {\n</span><span class=\"lens-source-line\" data-line=\"28\">    let integerDelta = u32(magnitude);\n</span><span class=\"lens-source-line\" data-line=\"29\">    if (integerDelta == 0u) { return origin; }\n</span><span class=\"lens-source-line\" data-line=\"30\">    var divisor = count;\n</span><span class=\"lens-source-line\" data-line=\"31\">    var multiplier = sampleIndex;\n</span><span class=\"lens-source-line\" data-line=\"32\">    if (integerDelta != count) {\n</span><span class=\"lens-source-line\" data-line=\"33\">      var first = count;\n</span><span class=\"lens-source-line\" data-line=\"34\">      var second = sampleIndex;\n</span><span class=\"lens-source-line\" data-line=\"35\">      // Euclid on u32 takes fewer than 48 remainder steps (consecutive Fibonacci worst case).\n</span><span class=\"lens-source-line\" data-line=\"36\">      for (var iteration = 0u; iteration &lt; 48u; iteration++) {\n</span><span class=\"lens-source-line\" data-line=\"37\">        if (second == 0u) { break; }\n</span><span class=\"lens-source-line\" data-line=\"38\">        let remainder = first % second;\n</span><span class=\"lens-source-line\" data-line=\"39\">        first = second;\n</span><span class=\"lens-source-line\" data-line=\"40\">        second = remainder;\n</span><span class=\"lens-source-line\" data-line=\"41\">      }\n</span><span class=\"lens-source-line\" data-line=\"42\">      divisor = count / first;\n</span><span class=\"lens-source-line\" data-line=\"43\">      multiplier = sampleIndex / first;\n</span><span class=\"lens-source-line\" data-line=\"44\">    }\n</span><span class=\"lens-source-line\" data-line=\"45\">    if (integerDelta % divisor == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"46\">      let offset = (integerDelta / divisor) * multiplier;\n</span><span class=\"lens-source-line\" data-line=\"47\">      if (delta &lt; 0.0) { return f32(u32(origin) - offset); }\n</span><span class=\"lens-source-line\" data-line=\"48\">      return f32(u32(origin) + offset);\n</span><span class=\"lens-source-line\" data-line=\"49\">    }\n</span><span class=\"lens-source-line\" data-line=\"50\">  }\n</span><span class=\"lens-source-line\" data-line=\"51\">  return origin + delta * (f32(sampleIndex) / f32(count));\n</span><span class=\"lens-source-line\" data-line=\"52\">}\n</span><span class=\"lens-source-line\" data-line=\"53\">fn rayPosition(observer: vec2&lt;f32&gt;, delta: vec2&lt;f32&gt;, sampleIndex: u32, count: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"54\">  return vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"55\">    rayCoordinate(observer.x, delta.x, sampleIndex, count),\n</span><span class=\"lens-source-line\" data-line=\"56\">    rayCoordinate(observer.y, delta.y, sampleIndex, count)\n</span><span class=\"lens-source-line\" data-line=\"57\">  );\n</span><span class=\"lens-source-line\" data-line=\"58\">}\n</span><span class=\"lens-source-line\" data-line=\"59\">fn isValidPixel(column: u32, row: u32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"60\">  return elevationValidity[elevationValidityOffset + row * WIDTH + column] != 0u;\n</span><span class=\"lens-source-line\" data-line=\"61\">}\n</span><span class=\"lens-source-line\" data-line=\"62\">fn getElevation(column: u32, row: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"63\">  return elevationValues[elevationValuesOffset + row * WIDTH + column];\n</span><span class=\"lens-source-line\" data-line=\"64\">}\n</span><span class=\"lens-source-line\" data-line=\"65\">fn interpolateElevation(first: f32, second: f32, fraction: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"66\">  if (fraction == 0.0 || first == second) { return first; }\n</span><span class=\"lens-source-line\" data-line=\"67\">  if (fraction == 1.0) { return second; }\n</span><span class=\"lens-source-line\" data-line=\"68\">  return mix(first, second, fraction);\n</span><span class=\"lens-source-line\" data-line=\"69\">}\n</span><span class=\"lens-source-line\" data-line=\"70\">// Bilinear elevation at a clamped pixel-center position; only positive-weight corners participate.\n</span><span class=\"lens-source-line\" data-line=\"71\">fn sampleElevation(position: vec2&lt;f32&gt;) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"72\">  let maximum = vec2&lt;f32&gt;(f32(WIDTH - 1u), f32(HEIGHT - 1u));\n</span><span class=\"lens-source-line\" data-line=\"73\">  let clamped = clamp(position, vec2&lt;f32&gt;(0.0), maximum);\n</span><span class=\"lens-source-line\" data-line=\"74\">  let base = vec2&lt;u32&gt;(floor(clamped));\n</span><span class=\"lens-source-line\" data-line=\"75\">  let next = min(base + vec2&lt;u32&gt;(1u), vec2&lt;u32&gt;(WIDTH - 1u, HEIGHT - 1u));\n</span><span class=\"lens-source-line\" data-line=\"76\">  let fraction = clamped - floor(clamped);\n</span><span class=\"lens-source-line\" data-line=\"77\">  let weights = vec4&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"78\">    (1.0 - fraction.x) * (1.0 - fraction.y), fraction.x * (1.0 - fraction.y),\n</span><span class=\"lens-source-line\" data-line=\"79\">    (1.0 - fraction.x) * fraction.y, fraction.x * fraction.y\n</span><span class=\"lens-source-line\" data-line=\"80\">  );\n</span><span class=\"lens-source-line\" data-line=\"81\">  // Neutral finite values for unused corners keep interpolation free of 0 * NaN.\n</span><span class=\"lens-source-line\" data-line=\"82\">  var corner00 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"83\">  var corner10 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"84\">  var corner01 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"85\">  var corner11 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"86\">  if (weights.x &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"87\">    corner00 = getElevation(base.x, base.y);\n</span><span class=\"lens-source-line\" data-line=\"88\">    if (!isFiniteValue(corner00)) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"89\">  }\n</span><span class=\"lens-source-line\" data-line=\"90\">  if (weights.y &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"91\">    corner10 = getElevation(next.x, base.y);\n</span><span class=\"lens-source-line\" data-line=\"92\">    if (!isFiniteValue(corner10)) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"93\">  }\n</span><span class=\"lens-source-line\" data-line=\"94\">  if (weights.z &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"95\">    corner01 = getElevation(base.x, next.y);\n</span><span class=\"lens-source-line\" data-line=\"96\">    if (!isFiniteValue(corner01)) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"97\">  }\n</span><span class=\"lens-source-line\" data-line=\"98\">  if (weights.w &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"99\">    corner11 = getElevation(next.x, next.y);\n</span><span class=\"lens-source-line\" data-line=\"100\">    if (!isFiniteValue(corner11)) { return vec2&lt;f32&gt;(0.0, 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"101\">  }\n</span><span class=\"lens-source-line\" data-line=\"102\">  let top = interpolateElevation(corner00, corner10, fraction.x);\n</span><span class=\"lens-source-line\" data-line=\"103\">  let bottom = interpolateElevation(corner01, corner11, fraction.x);\n</span><span class=\"lens-source-line\" data-line=\"104\">  return vec2&lt;f32&gt;(interpolateElevation(top, bottom, fraction.y), 1.0);\n</span><span class=\"lens-source-line\" data-line=\"105\">}\n</span><span class=\"lens-source-line\" data-line=\"106\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"107\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"108\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"109\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"110\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"111\">) {\n</span><span class=\"lens-source-line\" data-line=\"112\">  _ = &amp;elevationValues;\n</span><span class=\"lens-source-line\" data-line=\"113\">  _ = &amp;elevationValidity;\n</span><span class=\"lens-source-line\" data-line=\"114\">  _ = &amp;settings;\n</span><span class=\"lens-source-line\" data-line=\"115\">  _ = &amp;visibilityValues;\n</span><span class=\"lens-source-line\" data-line=\"116\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"117\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"118\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"119\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"120\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"121\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"122\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"123\">    return;\n</span><span class=\"lens-source-line\" data-line=\"124\">  }\n</span><span class=\"lens-source-line\" data-line=\"125\">  let column = index % WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"126\">  let row = index / WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"127\">  let observer = vec2&lt;f32&gt;(settings[settingsOffset], settings[settingsOffset + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"128\">  let observerHeight = settings[settingsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"129\">  let targetHeight = settings[settingsOffset + 3u];\n</span><span class=\"lens-source-line\" data-line=\"130\">  let maxDistance = settings[settingsOffset + 4u];\n</span><span class=\"lens-source-line\" data-line=\"131\">  let cellSize = vec2&lt;f32&gt;(settings[settingsOffset + 5u], settings[settingsOffset + 6u]);\n</span><span class=\"lens-source-line\" data-line=\"132\">  let curvature = settings[settingsOffset + 7u];\n</span><span class=\"lens-source-line\" data-line=\"133\">  let observerInside = isFiniteValue(observer.x) &amp;&amp; isFiniteValue(observer.y) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"134\">    observer.x &gt;= 0.0 &amp;&amp; observer.y &gt;= 0.0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"135\">    observer.x &lt;= f32(WIDTH - 1u) &amp;&amp; observer.y &lt;= f32(HEIGHT - 1u);\n</span><span class=\"lens-source-line\" data-line=\"136\">  let observerSample = sampleElevation(select(vec2&lt;f32&gt;(0.0), observer, observerInside));\n</span><span class=\"lens-source-line\" data-line=\"137\">  if (!observerInside || !isFiniteValue(observerHeight) || !isFiniteValue(targetHeight) || observerSample.y == 0.0 || !isValidPixel(column, row)) {\n</span><span class=\"lens-source-line\" data-line=\"138\">    visibilityValues[visibilityValuesOffset + index] = NO_DATA;\n</span><span class=\"lens-source-line\" data-line=\"139\">    return;\n</span><span class=\"lens-source-line\" data-line=\"140\">  }\n</span><span class=\"lens-source-line\" data-line=\"141\">  let observerElevation = observerSample.x + observerHeight;\n</span><span class=\"lens-source-line\" data-line=\"142\">  let delta = vec2&lt;f32&gt;(f32(column), f32(row)) - observer;\n</span><span class=\"lens-source-line\" data-line=\"143\">  let targetDistance = length(delta * cellSize);\n</span><span class=\"lens-source-line\" data-line=\"144\">  if (maxDistance &gt; 0.0 &amp;&amp; targetDistance &gt; maxDistance) {\n</span><span class=\"lens-source-line\" data-line=\"145\">    visibilityValues[visibilityValuesOffset + index] = OUT_OF_RANGE;\n</span><span class=\"lens-source-line\" data-line=\"146\">    return;\n</span><span class=\"lens-source-line\" data-line=\"147\">  }\n</span><span class=\"lens-source-line\" data-line=\"148\">  if (targetDistance == 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"149\">    visibilityValues[visibilityValuesOffset + index] = VISIBLE;\n</span><span class=\"lens-source-line\" data-line=\"150\">    return;\n</span><span class=\"lens-source-line\" data-line=\"151\">  }\n</span><span class=\"lens-source-line\" data-line=\"152\">  let targetElevation = getElevation(column, row) + targetHeight -\n</span><span class=\"lens-source-line\" data-line=\"153\">    curvature * targetDistance * targetDistance;\n</span><span class=\"lens-source-line\" data-line=\"154\">  let targetSlope = (targetElevation - observerElevation) / targetDistance;\n</span><span class=\"lens-source-line\" data-line=\"155\">  let stepCount = u32(ceil(max(abs(delta.x), abs(delta.y))));\n</span><span class=\"lens-source-line\" data-line=\"156\">  var visible = true;\n</span><span class=\"lens-source-line\" data-line=\"157\">  for (var stepIndex = 1u; stepIndex &lt; stepCount; stepIndex++) {\n</span><span class=\"lens-source-line\" data-line=\"158\">    let fraction = f32(stepIndex) / f32(stepCount);\n</span><span class=\"lens-source-line\" data-line=\"159\">    let elevationSample = sampleElevation(rayPosition(observer, delta, stepIndex, stepCount));\n</span><span class=\"lens-source-line\" data-line=\"160\">    // Invalid samples never block.\n</span><span class=\"lens-source-line\" data-line=\"161\">    if (elevationSample.y == 0.0) { continue; }\n</span><span class=\"lens-source-line\" data-line=\"162\">    let sampleDistance = targetDistance * fraction;\n</span><span class=\"lens-source-line\" data-line=\"163\">    let sampleSlope =\n</span><span class=\"lens-source-line\" data-line=\"164\">      (elevationSample.x - curvature * sampleDistance * sampleDistance - observerElevation) / sampleDistance;\n</span><span class=\"lens-source-line\" data-line=\"165\">    // A