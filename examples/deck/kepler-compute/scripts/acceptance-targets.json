          "maxValue": 536870912,
          "unit": "bytes",
          "origin": "ratified",
          "note": "Ratified 2026-10-31: max(512 MiB registry default, 96 bytes per row); larger sizes need ?memoryBudgetMebibytes."
        },
        "warmUploadBytes": {
          "statistic": "value",
          "maxValue": 0,
          "unit": "bytes",
          "origin": "plan",
          "note": "Plan: zero full-dataset upload on warm filter/style interactions."
