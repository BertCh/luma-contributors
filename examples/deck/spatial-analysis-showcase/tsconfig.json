{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "@webgpu/types",
      "vite/client"
    ],
    "paths": {
      "@deck.gl/core": [
        "./node_modules/@deck.gl/core"
      ],
      "@deck.gl/layers": [
        "./node_modules/@deck.gl/layers"
      ]
    }
  },
  "include": [
    "."
  ]
}
