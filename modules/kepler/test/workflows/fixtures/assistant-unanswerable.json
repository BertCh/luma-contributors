    "id": "unprofiled-intermediate",
    "request": "Interpolate a filtered intermediate whose measurement and requirements have not been profiled.",
    "profile": "surface",
    "call": {
      "name": "defineWorkflow",
      "arguments": {
        "title": "Unprofiled interpolation",
        "steps": [
          {
            "id": "source",
            "operationId": "source-dataset",
            "parameters": {
              "dataset": "observations",
              "geometryMode": "geojson-field",
              "geometryField": "geometry"
            }
          },
          {
            "id": "filter",
            "operationId": "table-filter-rows",
            "inputs": {
              "rows": "source.data"
            },
            "parameters": {
              "expression": "measurement >= 1"
            }
          },
          {
            "id": "analysis",
            "operationId": "idw-grid",
            "inputs": {
              "points": "filter.filtered"
            },
            "parameters": {
              "valueProperty": "measurement"
            }
          }
        ]
      }
    },
    "requirement": "current profile.*intermediate"
  }
