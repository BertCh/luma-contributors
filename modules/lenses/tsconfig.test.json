      "@luma-contributors/analysis/gpu-spatial-analysis/ontology": [
        "../../modules/analysis/src/gpu-spatial-analysis/ontology/index.ts"
      ],
      "@luma-contributors/analysis/gpu-network": [
        "../../modules/analysis/src/gpu-network/index.ts"
      ],
      "@luma-contributors/analysis/gpu-terrain": [
        "../../modules/analysis/src/gpu-terrain/index.ts"
      ],
      "@luma-contributors/analysis/dataframe-analysis": [
        "../../modules/analysis/src/dataframe-analysis/index.ts"
      ],
      "@luma-contributors/analysis/raster-analysis": [
        "../../modules/analysis/src/raster-analysis/index.ts"
      ],
