    "@webgpu/types": "0.1.69",
    "apache-arrow": "^17.0.0",
    "d3-scale": "^4.0.2",
    "earcut": "^3.0.2",
    "esbuild": "^0.28.1",
    "h3-js": "^4.4.0",
    "markdown-it": "^14.1.0",
    "playwright": "1.62.1",
    "probe.gl": "^5.0.0",
    "semver": "^7.8.5",
    "ts-patch": "4.0.1",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "5.0.2",
    "wgsl_reflect": "1.2.3"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7",
