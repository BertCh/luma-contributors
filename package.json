{
  "name": "luma-contributors-monorepo",
  "description": "GPU analysis operations, computation lenses and kepler.gl adapters built on luma.gl",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "modules/*",
    "examples/deck/spatial-analysis-showcase",
    "examples/deck/spatial-analysis-explorer",
    "examples/deck/kepler-compute",
    "website"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build-release.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc -p tsconfig.check-src.json --noEmit",
    "lint": "biome check .",
    "lint-fix": "biome check --write .",
    "test": "yarn test-node && yarn test-headless",
    "test-node": "vitest run --project node",
    "test-headless": "vitest run --project headless",
    "test-browser": "vitest --project browser",
    "verify-package-exports": "node scripts/verify-package-exports.mjs",
    "check-packed-consumer": "node scripts/check-packed-consumer.mjs",
    "typecheck-tests": "node scripts/typecheck-tests.mjs",
    "test-benchmarks": "node scripts/test-benchmarks.mjs",
    "oracle-fixture": "node scripts/run-oracle-fixture.mjs",
    "check-upstream-first": "node scripts/check-upstream-first.mjs",
    "check-contributor-contract": "node scripts/check-contributor-contract.mjs",
    "typecheck-watch": "node scripts/typecheck-status.mjs --watch",
    "typecheck-status": "node scripts/typecheck-status.mjs",
    "website-dev": "yarn workspace @luma-contributors/website dev",
    "website-build": "yarn workspace @luma-contributors/website build",
    "website-deploy": "node website/scripts/deploy-pages.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@kepler.gl/constants": "3.3.0-alpha.18",
    "@kepler.gl/layers": "3.3.0-alpha.18",
    "@loaders.gl/core": "5.0.0-beta.8",
    "@loaders.gl/tables": "5.0.0-beta.8",
    "@luma.gl/core": "10.0.0-alpha.14",
    "@luma.gl/engine": "10.0.0-alpha.14",
    "@luma.gl/graph": "10.0.0-alpha.14",
    "@luma.gl/shaders": "10.0.0-alpha.14",
    "@math.gl/arrow": "5.0.0-beta.8",
    "@math.gl/core": "5.0.0-beta.8",
    "@math.gl/dggs": "5.0.0-beta.8",
    "@math.gl/geospatial": "5.0.0-beta.8",
    "@types/node": "22.15.2",
    "@vis.gl/dev-tools": "2.0.0-beta.3",
    "@vis.gl/ts-plugins": "2.0.0-beta.3",
    "@vitest/browser": "5.0.2",
