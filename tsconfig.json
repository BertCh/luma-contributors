{
  "compilerOptions": {
    "rootDir": ".",
    "types": [
      "@webgpu/types",
      "node"
    ],
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ES2025.Float16"
    ],
    "module": "ES2022",
    "jsx": "react",
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "paths": {
      "@luma-contributors/analysis": [
        "./modules/analysis/src/index.ts"
      ],
      "@luma-contributors/kepler": [
        "./modules/kepler/src/index.ts"
      ],
      "@luma-contributors/lenses": [
        "./modules/lenses/src/index.ts"
      ],
      "@luma-contributors/analysis/computation-record": ["./modules/analysis/src/computation-record/index.ts"],
      "@luma-contributors/analysis/gpu-spatial-analysis": ["./modules/analysis/src/gpu-spatial-analysis/index.ts"],
      "@luma-contributors/analysis/gpu-spatial-analysis/ontology": ["./modules/analysis/src/gpu-spatial-analysis/ontology/index.ts"],
      "@luma-contributors/analysis/gpu-network": ["./modules/analysis/src/gpu-network/index.ts"],
      "@luma-contributors/analysis/gpu-terrain": ["./modules/analysis/src/gpu-terrain/index.ts"],
      "@luma-contributors/analysis/dataframe-analysis": ["./modules/analysis/src/dataframe-analysis/index.ts"],
      "@luma-contributors/analysis/raster-analysis": ["./modules/analysis/src/raster-analysis/index.ts"],
      "@luma-contributors/analysis/pointcloud-analysis": ["./modules/analysis/src/pointcloud-analysis/index.ts"],
      "@luma-contributors/analysis/geospatial-analysis": ["./modules/analysis/src/geospatial-analysis/index.ts"],
      "@luma-contributors/analysis/analysis-core": ["./modules/analysis/src/analysis-core/index.ts"],
      "@luma-contributors/kepler/*": [
        "./modules/kepler/src/*"
      ],
      "@luma-contributors/lenses/*": [
        "./modules/lenses/src/*"
      ],
      "test/*": [
        "./test/*"
      ]
    },
    "plugins": [
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-append-extension",
        "extensions": [
          ".js",
          ".lens.js",
          ".example.js",
          ".run.js",
          ".scenarios.js"
        ],
        "after": true
      },
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-append-extension",
        "extensions": [
          ".js",
          ".lens.js",
          ".example.js",
          ".run.js",
          ".scenarios.js"
        ],
        "afterDeclarations": true
      }
    ]
  },
  "include": [
    "modules/*/src"
  ],
  "exclude": [
    "modules/**/dist",
    "node_modules"
  ]
}
